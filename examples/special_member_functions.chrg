
MyType: object {

    constructor: (  out self, in      other: MyType); // copy constructor
    constructor: (  out self, move    other: MyType); // move constructor
    constructor: (  out self, destroy other: MyType); // relocate constructor
    constructor: (inout self, in      other: MyType); // copy assignment
    constructor: (inout self, move    other: MyType); // move assignment
    constructor: (inout self, destroy other: MyType); // relocate assignment

    constructor: (out[_] self, by-reference other: MyType);

    // deduction rules:

    // by-reference
    //               r-value -> 'move'
    //   initialized l-value -> 'in'
    // uninitialized l-value -> error!

    // out[_]
    //               r-value -> error!
    //   initialized l-value -> 'inout'
    // uninitialized l-value -> 'out'

    // forward
    //               r-value -> 'copy'
    //   initialized l-value -> 'in'
    // uninitialized l-value -> error!
}

MyType: object {
    // let, var, inout, out
    // forward, assign
    constructor: (  out self, let other: MyType);
    constructor: (  out self, var other: MyType);
    constructor: (inout self, let other: MyType);
    constructor: (inout self, var other: MyType);

    constructor: (assign self, forward other: MyType);

    // assign
    //               r-value -> error!
    //   initialized l-value -> 'inout'
    // uninitialized l-value -> 'out'

    // forward
    //               r-value -> 'var'
    //   initialized l-value -> 'let'
    // uninitialized l-value -> error!
}
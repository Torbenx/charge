
object MyType {

    fn constructor(  out self, in  other: MyType); // copy constructor
    fn constructor(  out self, var other: MyType); // relocate constructor
    fn constructor(inout self, in  other: MyType); // copy assignment
    fn constructor(inout self, var other: MyType); // relocate assignment

    fn constructor(assign self, forward other: MyType);

    // deduction rules:

    // assign
    //               r-value -> error!
    //   initialized l-value -> 'inout'
    // uninitialized l-value -> 'out'

    // forward
    //               r-value -> 'var'
    //   initialized l-value -> 'in'
    // uninitialized l-value -> error!
}
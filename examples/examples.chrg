
// inheritance
struct Base1: { field1: int; }
struct Base2: { field2: int; }
struct Derived: {
    has Base1;
    has Base2;
    fn sum(self) => field1 + field2;
}

// traits
template(self_type: type)
trait MyTrait: {
    static open associated_type: type;

    static open associated_constant: int = 0;

    open fn someFunctionality(self: const);

    open fn someFuncWithDefault(self: const): { ... }
}
struct Foo: {
    trait impl MyTrait: {
        static associated_type: type = Foo;

        fn someFunctionality(self): { ... };

        // Use default someFuncWithDefault
    }
}
struct Bar: { }
for Bar trait impl MyTrait: {
    fn someFunctionality(self): { ... };
}
trait impl MyTrait{self_type = Bar}: {
    static associated_type: type = int;

    static associated_constant: int = 123;

    fn someFunctionality(self): { ... };

    fn someFuncWithDefault(self: const): {
        // Customize behavior ...

        // Then call the default impl
        MyTrait::someFuncWithDefault();
    }
}

// use traits
template(T ?impl(MyTrait): type)
fn useFunctionality(input: T): {
    input.someFunctionality();
}
// or shorter:
fn useFunctionality(input: ?impl(MyTrait)): {
    input.someFunctionality();
}

//
struct Shape: {
    has ClassRoot{self_type};
    virtual fn draw();
}
struct Rectangle: {
    has Shape: { fn draw(): { ... } }
}
struct Circle: {
    has Shape: { fn draw(): { ... } }
}
fn drawNonRectangles(shapes: Array{ptr{Shape}}): {
    for shape in shapes: {
        if !dynIs{Rectangle}(*shape):
            shape.draw();
    }
}

//
incomplete final(module) struct IPAddressBase: {
    has ClassRoot{self_type};
}
struct IPv4Address: {
    has IPAddressBase;
    address: FixedArray{uint8, 4};
}
struct IPv6Address: {
    has IPAddressBase;
    address: FixedArray{uint16, 8};
}
static IPAddress: type = union{IPAddressBase};
fn printAddress(address: IPAddress): {
    inspect *address: {
        match(v4: IPv4Address) dyn_is(v4):
            // print v4 address
        match(v6: IPv6Address) dyn_is(v6):
            // print v6 address
    }
}

//
struct Rect: {
    left: float;
    top: float;
    right: float;
    bottom: float;
    fn topLeft(self: shared) <=> Vec2(left, top);
    fn bottomLeft(self: shared) <=> Vec2(left, bottom);
    fn topRight(self: shared) <=> Vec2(right, top);
    fn bottomRight(self: shared) <=> Vec2(right, bottom);
}

//
fn getImpl(t: Type) -> Type: {
    return inspect t: {
        int => IntImpl;
        bool => BoolImpl;
        _ => DefaultImpl;
    }
}

//
incomplete struct Animal: { has ClassRoot{self_type}; }
incomplete struct Mammal: { has Animal; }
incomplete struct Reptile: { has Animal; }
incomplete struct Legs: { }
struct Whale: { has Mammal; }
struct Dog: { has Mammal; has Legs; }
struct Snake: { has Reptile; }
struct Turtle: { has Reptile; has Legs; }
fn test(a: Animal): {
    inspect a: {
        match(w: Whale) dyn_match(w): ... // matches 'Whale'
        match(m: Mammal) dyn_match(m): ... // matches none
        match(m: Mammal) dyn_is(m): ... // matches 'Dog' and 'Whale'
        match(l: Legs) dyn_is(l): ... // matches none
        match(l: Legs) dyn_has(l): ... // matches 'Dog' and 'Turtle'
    }
}

//
struct RGB: { r: int; g: int; b: int; }
struct HSV: { h: int; s: int; v: int; }
static Color: Type = Variant{RGB, HSV};
fn toString(color: Option{Color}) => inspect color: {
    match(r: int)
    Option(Color(RGB(r, 0, 0))) => format("[r={}]", r);

    match(r: int, g: int, b: int)
    Option(Color(RGB(r, g, b)))
        => format("[r={},g={},b={}]", r, g, b);

    match(h: int, s: int, v: int)
    Option(Color(HSV(h, s, v)))
        => format("[h={},s={},v={}]", h, s, v);

    Option() => "[]";
}

//
template(T ?impl(ops::div): type)
fn divide(left: T, right: T) => left / right;
fn test(): {
    let a = divide(1, 2); // => 0
    let b = divide{float}(1, 2); // => 0.5
}

//
template(T: Type)
struct Array: {
    trait impl ops::index{int}: {
        static result_type: type = T;

        fn index(self: unique, i: int) <=> ...;
    }
}
struct impl Array{bool} as BoolArray: {
    trait impl ops::index{int}: {
        static result_type: type = bool;

        fn index(self: unique, i: int) => getBit(i);
        fn index(self: unique, i: int) = (value: bool): {
            setBit(i, value);
        }
    }
}

//
struct RGB: { r: int; g: int; b: int; }

template(maybeColor: Option{RGB})
fn templateExample(): { }

template(color: RGB)
fn impl templateExample{Option(color)}(): { }

fn impl templateExampleWithValue{RGB(0, 0, 0)}(): { }

//
template(parameters: Array{TupleElement})
fn callFoo(arguments..: Tuple{ parameters}): {
    let newArguments = arguments.append("bar");
    foo(newArguments..);
}

// more impl
template(self_type)
trait MyTrait: { }

template(self_type)
fn myFunc(self): { }

struct Foo: {
    trait impl MyTrait: { }

    fn impl myFunc(self): { }
}
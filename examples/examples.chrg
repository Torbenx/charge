
// inheritance
struct Base1: { field1: int; }
struct Base2: { field2: int; }
struct Derived: {
    has Base1;
    has Base2;
    fn sum(self) => field1 + field2;
}

// traits
incomplete struct MyTrait: {
    incomplete fn someFunctionality(self);
}
struct Foo: {
    has MyTrait: {
        fn someFunctionality(self): { ... };
    }
}
struct Bar: { }
external Bar has MyTrait: {
    fn someFunctionality(self): { ... };
}

// use traits
template(T ?has(MyTrait): Type)
fn useFunctionality(input: T): {
    input.someFunctionality();
}
// or shorter:
fn useFunctionality(input: ?has(MyTrait)): {
    input.someFunctionality();
}

//
incomplete struct Shape: {
    has ClassRoot{Self};
    incomplete virtual fn draw();
}
struct Rectangle: {
    has Shape: { fn draw(): { ... } }
}
struct Circle: {
    has Shape: { fn draw(): { ... } }
}
fn drawNonRectangles(shapes: Array{ref{Shape}}): {
    for shape in shapes: {
        if !dynIs{Rectangle}(*shape):
            shape.draw();
    }
}

//
incomplete final(module) struct IPAddressBase: {
    has ClassRoot{Self};
}
struct IPv4Address: {
    has IPAddressBase;
    address: FixedArray{uint8, 4};
}
struct IPv6Address: {
    has IPAddressBase;
    address: FixedArray{uint16, 8};
}
static IPAddress: Type = Union{IPAddressBase};
fn printAddress(address: IPAddress): {
    match *address: {
        with(v4: IPv4Address) dyn_is(v4):
            // print v4 address
        with(v6: IPv6Address) dyn_is(v6):
            // print v6 address
    }
}

//
struct Rect: {
    left: float;
    top: float;
    right: float;
    bottom: float;
    fn topLeft(self&) <=> Vec2(left, top);
    fn bottomLeft(self&) <=> Vec2(left, bottom);
    fn topRight(self&) <=> Vec2(right, top);
    fn bottomRight(self&) <=> Vec2(right, bottom);
}

//
fn getImpl(t: Type) -> Type: {
    return match t: {
        int => IntImpl;
        bool => BoolImpl;
        _ => DefaultImpl;
    }
}

//
incomplete struct Animal: { has ClassRoot{Self}; }
incomplete struct Mammal: { has Animal; }
incomplete struct Reptile: { has Animal; }
incomplete struct Legs: { }
struct Whale: { has Mammal; }
struct Dog: { has Mammal; has Legs; }
struct Snake: { has Reptile; }
struct Turtle: { has Reptile; has Legs; }
fn test(a: Animal): {
    match a: {
        with(w: Whale) dyn_match(w): ... // matches 'Whale'
        with(m: Mammal) dyn_match(m): ... // matches none
        with(m: Mammal) dyn_is(m): ... // matches 'Dog' and 'Whale'
        with(l: Legs) dyn_is(l): ... // matches none
        with(l: Legs) dyn_has(l): ... // matches 'Dog' and 'Turtle'
    }
}

//
struct RGB: { r: int; g: int; b: int; }
struct HSV: { h: int; s: int; v: int; }
static Color: Type = Variant{RGB, HSV};
fn toString(color: Option{Color}) => match color: {
    with(r: int)
    Option(Color(RGB(r, 0, 0))) => format("[r={}]", r);

    with(r: int, g: int, b: int)
    Option(Color(RGB(r, g, b)))
        => format("[r={},g={},b={}]", r, g, b);

    with(h: int, s: int, v: int)
    Option(Color(HSV(h, s, v)))
        => format("[h={},s={},v={}]", h, s, v);

    Option() => "[]";
}

//
template(T ?has(ops::Div): Type)
fn divide(left: T, right: T) => left / right;
fn test(): {
    let a = divide(1, 2); // => 0
    let b = divide{float}(1, 2); // => 0.5
}

//
template(T: Type)
struct Array: {
    has Index{(int) -> T}: {
        fn index(i: int) <=> ...;
    }
}
special_case struct Array{bool} as BoolArray: {
    has Index{(int) -> bool}: {
        fn index(i: int) => getBit(i);
        fn index(i: int) = (value: bool): {
            setBit(i, value);
        }
    }
}

//
struct RGB: { r: int; g: int; b: int; }

template(maybeColor: Option{RGB})
fn templateExample(): { }

template(color: RGB)
special_case fn templateExample{Option(color)}
    as templateExampleWithValue(): { }

special_case fn templateExampleWithValue{RGB(0, 0, 0)}
    as templateExampleWithBlack(): { }

//
template(parameters: Array{TupleElement})
fn callFoo(arguments..: Tuple{ parameters}): {
    let newArguments = arguments.append("bar");
    foo(newArguments..);
}
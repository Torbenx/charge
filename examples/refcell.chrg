
template(T: type)
struct refcell: {

    struct unique_ref: {
        fn get(self: unique) -> unique[self] T: {
            intern .cell:
                return *.cell.target;
        }

        fn impl destroy_behavior(self: unique): {
            intern .cell:
                .cell.shared_refcount = 0;
        }

        base borrow_tracker;
        context cell: shared refcell{T};
    }

    struct shared_ref: {
        fn get(self: unique) -> shared[unique self] T: {
            return *.cell.target;
        }

        fn impl destroy_behavior(self: unique): {
            intern .cell:
                .cell.shared_refcount -= 1;
            if .cell.shared_refcount == 0: {
                prove .cell.target.shared_reference_count() == 0;
                prove !.cell.target.referenced();
            }
        }

        base borrow_tracker;
        context cell: shared refcell{T};
    }

    invariant: {
        if .shared_refcount == 0: {
            prove !.target.referenced();
            prove .unique_refs.empty();
            prove .shared_refs.empty();
        } elif .shared_refcount == INVALID_REFCOUNT: {
            prove .unique_refs.size() == 1;
            prove .shared_refs.empty();
            let r: const = .unique_refs.front();
            if !r.uniquely_borrowed():
                prove !.target.referenced();
        } else: {
            prove 0 < .shared_refcount < INVALID_REFCOUNT;
            prove !.target.uniquely_referenced();
            prove .unique_refs.empty();
            prove .shared_refs.size() == .shared_refcount;
            let activeBorrows = count_if(.shared_refs, fn(r: const) => r.uniquely_borrowed());
            prove .target.shared_reference_count() <= activeBorrows;
        }
    }

    fn unique_borrow(intern self: shared) -> unique_ref: {
        assert .shared_refcount == 0;
        .shared_refcount = INVALID_REFCOUNT;
        return unique_ref(cell: self);
    }

    fn shared_borrow(intern self: shared) -> shared_ref: {
        assert .shared_refcount < INVALID_REFCOUNT;
        .shared_refcount += 1;
        assert .shared_refcount < INVALID_REFCOUNT;
        return shared_ref(cell: self);
    }

    static INVALID_REFCOUNT: bits = numeric_limits<bits>::max();

    intern unique_refs: reverse_context{unique_ref};
    intern shared_refs: reverse_context{shared_ref};

    intern target: inline_storage{T};
    intern shared_refcount: bits = 0;
}
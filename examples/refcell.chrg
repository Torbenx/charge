
template(T: type)
struct refcell: {

    struct unique_ref: {
        invariant(cell: shared): {
            prove cell.shared_refcount == INVALID_REFCOUNT;
        }
        invariant(self: unique, cell: shared): {
            prove !std::referenced(cell.target);
        }

        fn get(self: unique) -> (r: unique T): {
            r = *cell.target;
            reference unique self with r;
        }

        has destroy_behavior: {
            fn destruct(self: unique, cell: shared): {
                cell.shared_refcount = 0;
            }
        }

        relationship cell: refcell{T};
    }

    struct shared_ref: {
        invariant(cell: shared): {
            prove cell.shared_refcount > 0 && cell.shared_refcount < INVALID_REFCOUNT;

            prove !std::uniquely_referenced(cell.target);
        }

        invariant(self: shared, cell: shared): {
            prove std::shared_reference_count(cell.target) < cell.shared_refcount;
        }

        fn get(self: shared, cell: shared) -> (r: shared T): {
            r = *cell.target;
            reference shared self with r;
        }

        has destroy_behavior: {
            fn destruct(self: unique, cell: shared): {
                cell.shared_refcount -= 1;
                if cell.shared_refcount == 0: {
                    prove std::shared_reference_count(cell.target) == 0;
                    prove !std::referenced(cell.target);
                }
            }
        }

        relationship cell: refcell{T};
    }

    invariant(self: shared): {
        if shared_refcount == 0: {
            prove !std::referenced(target);
        } elif shared_refcount < INVALID_REFCOUNT: {
            prove !std::uniqueley_referenced(target);
            prove std::shared_reference_count(target) <= shared_refcount;
        }
    }

    fn unique_borrow(self: shared) -> unique_ref: {
        assert shared_refcount == 0;
        shared_refcount = INVALID_REFCOUNT;
        return unique_ref(self);
    }

    fn shared_borrow(self: shared) -> shared_ref: {
        assert shared_refcount < INVALID_REFCOUNT;
        shared_refcount += 1;
        assert shared_refcount < INVALID_REFCOUNT;
        return shared_ref(self);
    }

    static INVALID_REFCOUNT: bits = numeric_limits<bits>::max();

    internal target: ptr{T};
    internal shared_refcount: bits = 0;
}
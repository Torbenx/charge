
template(T: type)
struct unique_ptr: {
    fn get_unique(self: unique) -> unique T: {
        let r: unique = *target;
        reference unique self with r;
        return r;
    }
    fn get_shared(self: shared) -> shared T: {
        let r: shared = *target;
        reference shared self with r;
        return r;
    }

    trait impl destroy_behavior: {
        fn destroy(self: unique): {
            delete_at(target);
        }
    }

    invariant(self: shared) {
        prove std::deletable(target); // implies initialized
        prove !std::uniquely_referenced(target);
    }
    invariant(self: unique) {
        prove !std::referenced(target);
    }

    internal target: ptr{T};
}
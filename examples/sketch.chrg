
template(T: Type)
struct Bar: {
    add: T = 0;
    vals: Array{T} = ( 1, 2, 3 );

    fn get(i: int) -> T: {
        return vals[i] + add;
    }
}
special_case struct Bar{int}: {
    add: int = -1;
    vals: Array{int} = ( -1, -2, -3 );

    fn get(i: int) => 0;
    fn get(i: int): { return 0; }
    fn get(i: int) -> int: { return 0; }
}

template(T: Type)
fn appendTo(v&: Array{T}, item: T): {
    v.append(item);
}

template(T: Type)
static sizeOf: int = sizeof(T);


with(cparams: Array{TupleElement}, cargs: Tuple{cparams}, params: Array{TupleElement}, RetT: Type)
template(f{cargs..}: (params..) -> RetT)
fn call(args..: Tuple{undeduced(params)}) -> RetT: {
    return f{cargs..}(args..);
}

template(T: Type, size: int)
fn test(defaultValue: T = (), table: FixedArray{T, size});
fn callTest(): {
    call{test}((), { 1, 2, 3 }); // -> call{test{T = int, size = 3}}
    call{test{T = int}}(table = ()); // -> call{test{T = int, size = 0}}
}

template(special: Type, base: Template)
fn isSpecializationOf() => false;
template(base: Template)
special_case fn isSpecializationOf{base{_..}, base}() => true;


template(x: int)
fn recurse();
template(x ?[# > 0]: int)
special_case fn recurse{x}(): {
    recurse{x - 1}();
}
special_case fn recurse{0}(): {
    // base case
}

template(x ?[# >= 0]: int)
special_case fn recurse{x} as recursePos(): {
    recurse{x - 1}();
}
special_case fn recursePos{0}(): {
    // base case
}

struct Int: {
    value: int = 0;

    has ConvertTo{int}: {
        fn convert(self) => value;
    }

    has Add{int}: {
        fn add(self, i: int) => Int(value + i);
    }
}
external int has ConvertTo{Int}: {
    fn convert(self) => Int(self);
}

fn bar(): {
    let lambda = (i: int) -> int: {
        let j: int = calc(i);
        return i == j * j;
    };
    let lambda = (i: int) => [let j: int = calc(i); i == j * j];

    let lambda = [let j: int = calc(#); # == j * j];
    lambda(1);

    mut i: int = 0;
    let withCapture = with(j: int = i) (k: int) => j + k;
}

struct vec3: {
    x: int = 0;
    y: int = 0;
    z: int = 0;

    fn lengthSq() -> int: { return x * x + y * y + z * z; }
}
fn get() -> vec3: {}
fn q(): {
    match(x, y, z)
    (x, y, z) = get();
    match(l, z, y)
    (l = #.lengthSq(), z = #.z, y = #.y) = get();
}

template(T: Type)
struct Array: {
    fn popBack(self&) -> T: {}
    fn truncate(self&, newSize: int): {}
}
fn foo(): {
    let arr: Array = ( 1, 2, 3 );
    match(back, arr2)
    ( back = #, arr2 = .self ) = arr.popBack();
    match(arr3)
    ( arr3 = .self ) = arr.truncate(3);

    mut mArr: Array = ( 4, 5, 6 );
    mArr.popBack();
    match(foo)
    ( foo = .self ) = [mArr].popBack();
}

struct Vec2: {
    m_x: float;
    m_y: float;

    fn x(self&) <=> m_x;
}
struct Range: {
    m_low: float;
    m_high: float;

    fn low(self&) <=> m_low;
    fn high(self&) <=> m_high;
}
struct Rect: {
    h: Range;
    v: Range;

    fn bottomLeft(self&) <=> Vec2(h.low(), v.low());
}
fn onlyX(v: Vec2) => v.x();
fn onlyX(v&: Vec2) = (x: float): { v.x() = x; }
fn onlyX(v&: Vec2) <=> v.x();

fn update(v&: float): { v = 2.0; }
fn callUpdate(r&: Rect): {
    update(r.bottomLeft().x());
}

template(T: Type)
struct Array: {
    has Index{(int) -> T}: {
        fn index(self&, i: int) <=> ...[i];
    }
}
special_case struct Array{bool} as BoolArray: {
    has Index{(int) -> bool}: {
        fn index(self, i: int) => getBit(i);
        fn index(self&, i: int) = (v: bool):
            setBit(i, v);
    }
}

match(T: Type)
template(C ?has(Index{(int) -> T}): Type)
fn withIndexType(c: C): {}
match(T: Type)
fn withIndexType(c: ?has(Index{(int) -> T})): {}
match(T: Type)
fn getFirst(arr: ?match(Array{T})) -> T: {
    return arr.first();
}


// Binary operators:
// +   ->   Add
// -   ->   Sub
// &   ->   BitAnd
// &&  ->   LogAnd
// ^   ->   BitXor
// |   ->   BitOr
// ||  ->   LogOr
// *   ->   Mul
// /   ->   Div
// %   ->   Rem
// <<  ->   Shl
// >>  ->   Shr

// Unary operators:
// !   ->   LogNot
// ~   ->   BitNot
//          PreInc
//          PreDec
// +   ->   Plus
// -   ->   Neg
//          PostInc
//          PostDec

// Other:
// []  ->   Index
// ()  ->   Invoke

enum Ordering: {
    Less;
    Equal;
    Greater;
}
compare (i: int) with (j: int) Ordering: {
    if i == j: return Ordering::Equal;
    if i < j: return Ordering::Less;
    return Ordering::Greater;
}


template(Anchor: Type)
struct ClassRoot: {
    m_class: Class{Anchor} = ();

    has AutoInitialize: {
        match(self_type: Type)
        fn init(self&): {
            m_class = Class{Anchor}::of(self_type);
        }
    }
    fn class(self): { return m_class; }
    has ConvertTo{Class{Anchor}}: {
        fn convert() => class();
    }
}
template(Anchor: Type)
struct Class: {
    fn of(T ?has{Anchor}: Type) -> Variant{Anchor}: {}
    fn type(self) -> Type: {}
}

incomplete final struct SliceResult: {
    has ClassRoot;
    struct Success: {
        has SliceResult;
        result: ExprResult;
    }
    struct NotFound: {
        has SliceResult;
    }
    struct Error: {
        has SliceResult;
    }
}
fn slice() -> Union{SliceResult}: {}
fn doSlice() -> Opt{ExprResult}: {
    return inspect *slice(): {
        match(s: SliceResult::Success) dyn_match s => s.result;
        _ => ();
    };

    let s = slice();
    if dynMatch{SliceResult::Success}(*s):
        return (*s, to SliceResult::Success).result;
    return ();
}
fn useSlice(): {
    let slice = doSlice(), else: return;
}

struct Root: {
    has ClassRoot;
}
struct DirectBase: {
    has Root;
}
struct Leaf: {
    has DirectBase;
    has OtherThing;
}
fn foo(r: Root): {
    return inspect r: {
        match(b: DirectBase) dyn_has b => // matches Leaf, DirectBase
        match(t: OtherThing) dyn_has t => // matches Leaf
        match(b: DirectBase) dyn_is b => // matches Leaf, DirectBase
        match(t: OtherThing) dyn_is t => // matches nothing
        match(b: DirectBase) dyn_match b => // matches DirectBase
        match(t: OtherThing) dyn_match t => // matches nothing

        match(b ?dynHas{DirectBase}) b => // matches Leaf, DirectBase
        match(t ?dynHas{OtherThing}) t => // matches Leaf
        match(b ?dynIs{DirectBase}) b => // matches Leaf, DirectBase
        match(t ?dynIs{OtherThing}) t => // matches nothing
        match(b ?dynMatch{DirectBase}) b => // matches DirectBase
        match(t ?dynMatch{OtherThing}) t => // matches nothing
    }
}

incomplete final(module) struct Expr: {
    has ClassRoot;
}
struct BinaryOperatorExpr: {
    op: BinaryOperator;
    left: id{Expr};
    right: id{Expr};
    has Expr;
}
fn dispatch(e: id{Expr}): {
    inspect *e: {
        match(e&: BinaryOperatorExpr) dyn_is e: {}

        match(left&: id{Expr}, right&: id{Expr})
        dyn_is BinaryOperatorExpr(BinaryOperator::Add, left, right): {}
    }

    if dynIs{BinaryOperatorExpr}(*e): {
        let boe& = *e, to BinaryOperatorExpr;
    }
}

incomplete struct View: {
    template(self_type: Type)
    static incomplete virtual CLASS_NAME: String = TypeInfo::get(self_type).name();

    has ClassRoot;
}
struct ImageView: {
    has View: {
        static CLASS_NAME: String = "Image";
    }
}

object Obj: {
    i: int = 0;
    fn get(self) => idof(i);
}
fn deref(firstArg: id{int}, secondArg: id{Obj}): {
    return *firstArg + *secondArg.get();
}


struct Trait: {
    static MyType: type where(t) has(Add)(t);

    relationship myT: MyType;
}
struct Impl: {
    static var myInt: int = 0;
    has Trait where MyType == int && myT is myInt;
}

template(T: type)
struct iterator: {
    relationship container: vector{T};
    index: int;
}
struct Bar: {
    storage: vector{int};

    splits_inline: vector{iterator{int} where container is storage};

    splits_invariant: vector{iterator{int}};
    invariant { for it in splits_invariant: prove it.container is storage; }

    end_inline: iterator{int} where container is storage;

    end_invariant: interator{int};
    invariant { prove end_invariant.container is storage; }
}

template(T: type where has(Add) && has(Sub))
fn foo(x: T)

fn refs1(unique ref u: T, shared ref s: T, const ref c: T): {
    unique ref uu: T = u;
    shared ref ss: T = s;
    const ref cc: T = c;
}

fn refs2(unique &u: T, shared &s: T, const &c: T): {
    unique &uu: T = u;
    shared &ss: T = s;
    const &cc: T = c;

    const{s, c}& sc: T = s;
    const&{s, c} sc: T = s;
}

fn refs3(unique u: T, shared s: T, const c: T): {
    unique uu: T = u;
    shared ss: T = s;
    const cc: T = c;

    const{s, c} sc: T = s;
}

fn refs4(u: unique T, s: shared T, c: const T): {
    uu: unique T = u;
    ss: shared T = s;
    cc: const T = c;

    sc: const{s, c} T = s;
}

fn refs5(ref u: unique T, ref s: shared T, ref c: const T): {
    ref uu: unique T = u;
    ref ss: shared T = s;
    ref cc: const T = c;

    ref sc: const{s, c} T = s;
}
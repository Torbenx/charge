
template(T: type)
fn test(x: T, i: int);

template(T: Type)
fn update(inout x: T) -> int: {
    // modify 'x' here...
    return 0;
}

template(T: Type)
fn call(var x: T): {
    // This does different things depending on whether 'T' is an object or value type.
    // If 'T' a object type the updated value will be passed to test,
    // and if 'T' a value type the non-update value gets passed.
    test(x, update(x));

    // Resolution: 'let' exlusive for value types, seperate 'in' passing style for both
    //             value and object types that is always a reference.
}
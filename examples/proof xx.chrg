
struct Node: {
    next: optional{id{Node}};
}
fn proof_termination(first: id{Node}): {
    var current = first;
    loop {
        if !current.next.has_value() {
            break;
        }
        let next = current.next.value();

        var check = first;
        loop {
            assert check != next;
            if check == current:
                break;

            proof check.next.has_value();
            check = check.next.value();
        }
        current = next;
    }
}

struct sequence: {
    sub_sequence: type;
    analysis in {
        if sub_sequence != self_type: {
            assert has(sequence)(sub_sequence);
            assert sub_sequence::sub_sequence == sub_sequence;
        }
    }
    analysis assert has(sequence)(sub_sequence);
}

/*

proof > runtime check > no op > assume

debug >= release
debug >= runtime check


statement       | debug         | release
----------------|---------------|---------------
check           | proof         | proof
check_or_assert | proof         | runtime check
debug check     | proof         | no op
check_or_assume | proof         | assume
assert          | runtime check | runtime check
debug assert    | runtime check | no op
assume          | runtime check | assume


environment     | debug         | release
----------------|---------------|---------------
check           | proof         | proof
check_or_assert | proof         | runtime check
debug check     | proof         | no op
check_or_assume | proof         | assume
<default>       | runtime check | runtime check
debug           | runtime check | no op
assume          | runtime check | assume

*/
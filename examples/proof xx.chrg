
struct Node: {
    next: optional{id{Node}};
}
fn prove_termination(first: id{Node}): {
    var current = first;
    loop {
        if !current.next.has_value(): {
            break;
        }
        let next = current.next.value();

        var check = first;
        loop {
            assert check != next;
            if check == current:
                break;

            prove check.next.has_value();
            check = check.next.value();
        }
        current = next;
    }
}

struct sequence: {
    sub_sequence: type;
    analysis in {
        if sub_sequence != self_type: {
            assert has(sequence)(sub_sequence);
            assert sub_sequence::sub_sequence == sub_sequence;
        }
    }
    analysis assert has(sequence)(sub_sequence);
}

/*

prove > runtime check > no op > assume

debug >= release
debug >= runtime check


statement       | debug         | release
----------------|---------------|---------------
check           | prove         | prove
check_or_assert | prove         | runtime check
debug check     | prove         | no op
check_or_assume | prove         | assume
assert          | runtime check | runtime check
debug assert    | runtime check | no op
assume          | runtime check | assume


environment     | debug         | release
----------------|---------------|---------------
check           | prove         | prove
check_or_assert | prove         | runtime check
debug check     | prove         | no op
check_or_assume | prove         | assume
<default>       | runtime check | runtime check
debug           | runtime check | no op
assume          | runtime check | assume

*/

fn test(control: vector{bool}, data: vector{int}): {
    var theData: ptr{int};
    for i in range(10): {
        if control[i]:
            theData = ptrto(data[i]);
    }

    data[11] = 123;
    *theData = 456;
    analysis assert data[11] == 123;
}

fn test(data: vector{pair{int, int}}, int increment, int special_index): {
    data[special_index].second = 0;
    for i in data.index_range():
        data[i].first += increment;
    analysis assert data[special_index].second == 0;
}

struct A: {
    i: int;
    j: int;
}
fn test(inout a: A): {
    a.i = 5;
    a.j = 6;
    analysis assert a.i == 5;
}
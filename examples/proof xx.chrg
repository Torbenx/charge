
fn test(x: int): {

    let lambda = (x: int, y: int): {
        guard (x > 0 && y > 0) || (x == 0 && y == 0) || (x < 0 && y < 0);

        proof(x * y >= 0);
    };
    proof(catch(_): { lambda(x, x); }).valid());

    proof(x * x >= 0);
}

fn test(x: int, y: int): {
    guard x > 0 && y > 0;

    proof(x * y > 0);
}

fn test(x: int, y: int, z: int): {
    guard x > 0 && z > y; // x > 0 && z - y > 0

    proof(x * z > x * y); // x * z - x * y > 0
}

fn test(x: int, y: int, a: int, b: int): {
    guard x < y && x > 0 && a + b > 0;

    proof(a * x < a * y); // b * y - b * x > 0

    proof(a * x + b * y > 0);
    // b * y - b * x > 0        b * y - b * x - 1 >= 0      b*y - b*x - 1 >= 0
    // a + b > 0                a + b - 1         >= 0      a*x + b*x - x >= 0, a*y + b*y - y >= 0
    // a * x + b * y <= 0       -a * x - b * y    >= 0      -a*x - b*y    >= 0
}

struct Node {
    next: optional<id<Node>>;
}
fn proof_termination(first: id<Node>) {
    var current = first;
    loop {
        if !current.next.has_value() {
            break;
        }
        let next = current.next.value();

        var check = first;
        loop {
            guard check != next;
            if check == current {
                break;
            }
            proof(check.next.has_value());
            check = check.next.value();
        }
        current = next;
    }
}
template(T: Type)
struct Bar: {
    add: T = 0;
    vals: Array{T} = ( 1, 2, 3 );

    fn get(i: int) -> T: {
        return vals[i] + add;
    }
}

template(T: Type)
fn appendTo(inout v: Array{T}, item: T): {
    v.append(item);
}

template(T: Type)
static sizeOf: int = sizeof(T);

template(T: Type, size: int)
fn test(defaultValue: T = (), table: FixedArray{T, size}): { }
fn callTest(): {
    call{test}((), ( 1, 2, 3 )); // -> call{test{T = int, size = 3}}
    call{test{T = int}}(table = ()); // -> call{test{T = int, size = 0}}
}

struct Int: {
    value: int = 0;

    has ConvertTo{int}: {
        fn convert(self) => value;
    }

    has Add{int}: {
        fn add(self, i: int) => Int(value + i);
    }
}

struct vec3: {
    x: int = 0;
    y: int = 0;
    z: int = 0;

    fn lengthSq() -> int: { return x * x + y * y + z * z; }
}
fn get() -> vec3: {}
fn q(): {
    (x, y, z) = get();
    (l = #.lengthSq(), z = #.z, y = #.y) = get();
}

template(T: Type)
struct Array: {
    fn popBack(inout self) -> T: {}
    fn truncate(inout self, newSize: int): {}
}
fn foo(): {
    let arr: Array = ( 1, 2, 3 );
    ( back = #, arr2 = self ) = arr.popBack();
    ( arr3 = self ) = arr.truncate(3);

    var mArr: Array = ( 4, 5, 6 );
    mArr.popBack();
    ( foo = self ) = mArr.popBack();
}

struct Vec2: {
    m_x: float;
    m_y: float;

    fn x(inout self) <=> m_x;
}
struct Range: {
    m_low: float;
    m_high: float;

    fn low(inout self) <=> m_low;
    fn high(inout self) <=> m_high;
}
struct Rect: {
    h: Range;
    v: Range;

    fn bottomLeft(inout self) <=> Vec2(h.low(), v.low());
}
fn onlyX(inout v: Vec2) <=> v.x();

fn update(inout v: float): { v = 2; }
fn callUpdate(inout r: Rect): {
    update(r.bottomLeft().x());
}

struct Ordering: {
    Less;
    Equal;
    Greater;
}

template(Anchor: Type)
struct ClassRoot: {
    m_class: Class{Anchor} = ();

    has AutoInitialize: {
        template(Self: Type)
        fn init(inout self): {
            m_class = Class{Anchor}::of(Self);
        }
    }
    fn class(self): { return m_class; }
    has ConvertTo{Class{Anchor}}: {
        fn convert() => class();
    }
}
template(Anchor: Type)
struct Class: {
    fn of(T: Type) -> Variant{Anchor}: {}
    fn type(self) -> Type: {}
}

struct SliceResult: {
    has ClassRoot;
    struct Success: {
        has SliceResult;
        result: ExprResult;
    }
    struct NotFound: {
        has SliceResult;
    }
    struct Error: {
        has SliceResult;
    }
}
fn slice() -> Union{SliceResult}: {}
fn doSlice() -> Opt{ExprResult}: {
    let s = slice();
    if dynMatch{SliceResult::Success}(*s):
        return (*s, SliceResult::Success).result;
    return ();
}
fn useSlice(): {
    let slice = doSlice(), else => false;
}

struct Root: {
    has ClassRoot;
}
struct DirectBase: {
    has Root;
}
struct Leaf: {
    has DirectBase;
    has OtherThing;
}

struct View: {
    template(Self: Type)
    static LASS_NAME: String = TypeInfo::get(Self).name();

    has ClassRoot;
}
struct ImageView: {
    has View: {
        static CLASS_NAME: String = 'I';
    }
}

object Obj: {
    i: int = 0;
    fn get(self) => idof(i);
}
fn deref(firstArg: id{int}, secondArg: id{Obj}): {
    return *firstArg + *secondArg.get();
}

// inheritance
struct Base1: { field1: int; }
struct Base2: { field2: int; }
struct Derived: {
    has Base1;
    has Base2;
    fn sum(self) => field1 + field2;
}

// traits
struct MyTrait: {
    fn someFunctionality(self): { }
}
struct Foo: {
    has MyTrait: {
        fn someFunctionality(self): { }
    }
}

// use traits
template(T: Type)
fn useFunctionality(input: T): {
    input.someFunctionality();
}
// or shorter:
fn useFunctionality2(input): {
    input.someFunctionality();
}

//
struct Shape: {
    has ClassRoot{Self};
    fn draw(): { }
}
struct Rectangle: {
    has Shape: { fn draw(): { } }
}
struct Circle: {
    has Shape: { fn draw(): { } }
}
fn drawNonRectangles(shapes: Array{ref{Shape}}): {
    if shape < shapes: {
        if !dynIs{Rectangle}(*shape):
            shape.draw();
    }
}

//
struct Rect2: {
    left: float;
    top: float;
    right: float;
    bottom: float;
    fn topLeft(inout self) <=> Vec2(left, top);
    fn bottomLeft(inout self) <=> Vec2(left, bottom);
    fn topRight(inout self) <=> Vec2(right, top);
    fn bottomRight(inout self) <=> Vec2(right, bottom);
}

//
struct Animal: { has ClassRoot{Self}; }
struct Mammal: { has Animal; }
struct Reptile: { has Animal; }
struct Legs: { }
struct Whale: { has Mammal; }
struct Dog: { has Mammal; has Legs; }
struct Snake: { has Reptile; }
struct Turtle: { has Reptile; has Legs; }

//
template(T: Type)
fn divide(left: T, right: T) => left / right;
fn test1(): {
    let a = divide(1, 2); // => 0
    let b = divide{float}(1, 2); // => 0.5
}

//
struct RGB: { r: int; g: int; b: int; }

template(maybeColor: Option{RGB})
fn templateExample(): { }

struct Token: {
    LeftParen; // (
    RightParen; // )
    LeftAngle; // [
    RightAngle; // ]
    LeftBrace; // {
    RightBrace; // }

    FirstBracket = LeftParen;
    LastBracket = RightBrace;

    // begin unary
    Exclaim; // !
    Tilde; // ~
    PlusPlus; // ++
    MinusMinus; // --
    // begin binary
    Plus; // +
    Minus; // -
    // end unary
    Amp; // &
    AmpAmp; // &&
    Hat; // ^
    Vert; // |
    VertVert; // ||
    Star; // *
    Slash; // /
    Percent; // %
    LessLess; // <<
    GreaterGreater; // >>
    ExclaimEqual; // !=
    EqualEqual; // ==
    Less; // <
    LessEqual; // <=
    Greater; // >
    GreaterEqual; // >=
    // end binary
    // begin assign
    PlusEqual; // +=
    MinusEqual; // -=
    AmpEqual; // &=
    AmpAmpEqual; // &&=
    HatEqual; // ^=
    VertEqual; // |=
    VertVertEqual; // ||=
    StarEqual; // *=
    SlashEqual; // /=
    PercentEqual; // %=
    LessLessEqual; // <<=
    GreaterGreaterEqual; // >>=
    // end assign

    FirstUnaryOp = Exclaim;
    FirstBinaryOp = Plus;
    LastUnaryOp = Minus;
    LastBinaryOp = GreaterEqual;
    FirstAssignOp = PlusEqual;
    LastAssignOp = GreaterGreaterEqual;

    Equal; // =
    Question; // ?
    Comma; // ,
    Point; // .
    PointPoint; // ..
    Colon; // :
    ColonColon; // ::
    SemiColon; // ;
    Word; // abc123

    IntegerLiteral;
    FirstLiteral = IntegerLiteral;
    LastLiteral = IntegerLiteral;

    EOF;
}

namespace lookup_table: {

struct Input: {
    firstChar: uint8;
    lastChar: uint8 = beginChar;
    bare: Token;
    repeat: Opt{Token} = ();
    equal: Opt{Token} = ();
    repeatEqual: Opt{Token} = ();
    bareAdvance: int = 1;
}

struct Output: {
    tok: Opt{Token} = ();
    advance: int = 0;
}

fn computeIndex(char: uint8, repeat: bool, equal: bool): {
    var output: int = char - 32;
    if repeat:
        output += 96;
    if equal:
        output += 96 * 2;
    return output;
}

fn makeTable(inputs: Array{Input}): {
    var output: Array{Output} = ();
    output.resize(96 * 4);

    if input < inputs: {
        if char < incRange(input.firstCahr, input.lastChar): {
            let bareOut: Output = (input.bare, input.bareAdvance);
            output[computeIndex(char, false, false)] = bareOut;

            let repeatOut = if input.repeat.hasValue() => Output(input.repeat.value(), 2), else => bareOut;
            output[computeIndex(char, true, false)] = repeatOut;
            output[computeIndex(char, false, true)] = if input.repeat.hasValue() => Output(input.equal.value(), 2), else => bareOut;
            output[computeIndex(char, true, true)] = if input.repeatEqual.hasValue() => Output(input.repeatEqual.value(), 3), else => repeatOut;
        }
    }

    return output;
}

static table = makeTable((
        ('(', bare = LeftParen),
        (')', bare = RightParen),
        ('[', bare = LeftAngle),
        (']', bare = RightAngle),
        ('{', bare = LeftBrace),
        ('}', bare = RightBrace),
        (';', bare = SemiColon),
        (',', bare = Colon),
        ('?', bare = Question),
        ('~', bare = Tilde),

        ('.', bare = Point, repeat = PointPoint),
        (':', bare = Colon, repeat = ColonColon),
        ('=', bare = Equal, repeat = EqualEqual),

        ('!', bare = Exclaim, equal = ExclaimEqual),
        ('^', bare = Hat, equal = HatEqual),
        ('*', bare = Star, equal = StarEqual),
        ('/', bare = Slash, equal = SlashEqual),
        ('%', bare = Percent, equal = PercentEqual),

        ('+', bare = Plus, repeat = PlusPlus, equal = PlusEqual),
        ('-', bare = Minus, repeat = MinusMinus, equal = MinusEqual),

        ('&', bare = Amp, repeat = AmpAmp, equal = AmpEqual, repeatEqual = AmpAmpEqual),
        ('|', bare = Vert, repeat = VertVert, equal = VertEqual, repeatEqual = VertVertEqual),
        ('<', bare = Less, repeat = LessLess, equal = LessEqual, repeatEqual = LessLessEqual),
        ('>', bare = Greater, repeat = GreaterGreater, equal = GreaterEqual, repeatEqual = GreaterGreaterEqual),

        ('0', '9', bare = IntegerLiteral, bareAdvance = 0),

        ('a', 'z', bare = Word),
        ('A', 'Z', bare = Word),
        ('_', bare = Word),
    ));
fn get(char: uint8, repeat: bool, equal: bool) => table[computeIndex(char, repeat, equal)];

}

struct SourcePos: {}

object Parser: {
    sourceOff: int = 0;
    source: SourceBuffer;

    tok: Token = Token::EOF;

    fn skipWhitespace(inout self): {
        if isWhitespace(source[sourceOff]):
            sourceOff += 1;
    }
    fn nextToken(inout self): {
        skipWhitespace();

        let head = source[sourceOff];

        let repeat = source[sourceOff + 1] == head;

        let equalOff = if repeat => 1, else => 2;
        let equal = source[equalOff] == '=';

        (tok, advance) = lookup_table::get(head, repeat, equal);

        sourceOff += advance;
    }
}
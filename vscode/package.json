{
  "name": "charge-lang",
  "displayName": "Charge Lang",
  "description": "Charge Language Extension",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.76.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension",
  "contributes": {
    "languages": [{
      "id": "charge",
      "aliases": ["Charge", "charge"],
      "extensions": [".chrg", ".charge"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "charge",
      "scopeName": "source.charge",
      "path": "./charge.tmLanguage.json"
    }]
  },
  "scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"lint": "eslint"
	},
  "dependencies": {
		"glob": "^11.0.0",
		"vscode-languageclient": "^9.0.1"
	},
  "devDependencies": {
    "@eslint/js": "^9.13.0",
		"@stylistic/eslint-plugin": "^2.9.0",
		"@types/mocha": "^10.0.6",
		"@types/node": "^22",
		"@types/vscode": "^1.100.0",
		"eslint": "^9.13.0",
		"mocha": "^10.3.0",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.39.0"
	}
}

{
  "name": "charge-lang",
  "displayName": "Charge Lang",
  "description": "Charge Language Extension",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.76.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [{
      "id": "charge",
      "aliases": ["Charge", "charge"],
      "extensions": [".chrg .charge"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "charge",
      "scopeName": "source.charge",
      "path": "./syntaxes/charge.tmLanguage.json"
    }]
  }
}

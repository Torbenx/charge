                body_b.velocity.x = body_b.velocity.x + friction_impulse.x * constraint.inverse_mass_b;
                body_b.velocity.y = body_b.velocity.y + friction_impulse.y * constraint.inverse_mass_b;
                body_b.angular_velocity = body_b.angular_velocity

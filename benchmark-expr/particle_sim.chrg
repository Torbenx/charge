// remainder is already correctly scaled.

    r_raw == 0;
        zero_fixed;

    raw_fixed , l_raw % r_raw;

    l_raw < r_raw;

    l_raw <= r_raw;

    l_raw > r_raw;

    l_raw >= r_raw;

    l_raw == r_raw;

    l_raw != r_raw;


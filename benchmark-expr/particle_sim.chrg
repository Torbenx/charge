    body.frame = make_transform(position, angle);
    body.gravity_scale = one_fixed();
    body.linear_damping = ratio(1, 100);
    body.angular_damping = ratio(5, 100);
    body.max_linear_speed = whole(200);
    body.max_angular_speed = whole(60);
    body.recompute_mass();
    body;

// Materials add componentwise, which is only used by make_body above to force
// a copy of the material without naming every field.

    make_material(l.density + r.density,
                         l.restitution + r.restitution,
                         l.static_friction + r.static_friction,
                         l.dynamic_friction + r.dynamic_friction);

    shape = shape_from_circle(make_circle(vec2_zero(), radius));
    world.add_body(make_body(BodyKind::Dynamic, shape, material, position, zero_fixed()));

    shape = shape_box(half_width, half_height);
    world.add_body(make_body(BodyKind::Dynamic, shape, material, position, angle));

    shape = shape_from_polygon(make_regular_polygon(sides, circumradius));
    world.add_body(make_body(BodyKind::Dynamic, shape, material, position, zero_fixed()));

    shape = shape_box(half_width, half_height);
    index = world.add_body(make_body(BodyKind::Static, shape, material_steel(), position, angle));
    body = world.bodies[index];
    body.never_sleeps = true;
    body.freeze();
    index;

    // A ground plane, a left wall and a right wall, sized to the world bounds.

    extent = world.bounds.half_extents();
    centre = world.bounds.centre();
    spawn_static_box(world,
                             make_vec2(centre.x, world.bounds.lower.y + thickness),
                             extent.x, thickness, zero_fixed());
    spawn_static_box(world,
                             make_vec2(world.bounds.lower.x + thickness, centre.y),
                             thickness, extent.y, zero_fixed());
    spawn_static_box(world,
                             make_vec2(world.bounds.upper.x - thickness, centre.y),
                             thickness, extent.y, zero_fixed());

// A pyramid of boxes, rows tall, resting on the ground. The classic stability
// test: if warm starting is broken this sinks, and if the position solver is
// too aggressive it explodes.

    spacing = half_size * 2 + raw_fixed(PENETRATION_SLOP_RAW);
    row = 0;
    row < rows;
        column = 0;
        column <= row;
            position = make_vec2(
                apex.x + spacing * column - spacing * row / 2,
                apex.y - spacing * row);
            spawn_box(world, position, half_size, half_size, zero_fixed(), material_wood());
            column += 1;

        row += 1;

        // A chain of boxes linked by revolute joints, hanging from a static anchor.

    anchor_index = spawn_static_box(world, anchor, half_length / 4, half_length / 4, zero_fixed());
    previous = anchor_index;
    index = 1;
    index <= links;
        position = make_vec2(anchor.x + half_length * 2 * index, anchor.y);
        current = spawn_box(world, position, half_length, half_length / 4,
                                zero_fixed(), material_wood());
        world.add_revolute_joint(make_revolute_joint(
            previous, current,
            make_vec2(half_length, zero_fixed()),
            make_vec2(-half_length, zero_fixed())));
        previous = current;
        index += 1;

// A wheel on a motorised revolute joint, which is the smallest interesting
// test of the motor path.

    hub = spawn_static_box(world, centre, radius / 8, radius / 8, zero_fixed());
    wheel = spawn_circle(world, centre, radius, material_rubber());
    world.add_revolute_joint(make_motorised_joint(
        hub, wheel, vec2_zero(), vec2_zero(), speed, whole(500)));
    wheel;

// A ragdoll-ish articulated figure: a torso with four limbs, each limb a box
// on a limited revolute joint.

    torso = spawn_box(world, origin, scale, scale * 2, zero_fixed(), material_wood());
    limb = 0;
    limb < 4;
        side = limb % 2;
        level = limb / 2;
        offset_x = -scale;
        side == 1;
            offset_x = scale;

        offset_y = scale - scale * 2 * level;
        position = make_vec2(origin.x + offset_x * 2, origin.y + offset_y);
        arm = spawn_box(world, position, scale, scale / 2, zero_fixed(), material_wood());
        joint = make_revolute_joint(torso, arm,
                                        make_vec2(raw_fixed(offset_x.raw), raw_fixed(offset_y.raw)),
                                        make_vec2(-offset_x, zero_fixed()));
        joint.limit_enabled = true;
        joint.lower_limit = -raw_fixed(FIXED_QUARTER_PI_RAW);
        joint.upper_limit = raw_fixed(FIXED_QUARTER_PI_RAW);
        world.add_revolute_joint(move(joint));
        limb += 1;

    torso;

// A Newton's cradle: five equal balls hung from five distance joints, just
// touching. Momentum should pass straight through the middle three.

    index = 0;
    index < count;
        offset_x = radius * 2 * index - radius * count;
        pivot = make_vec2(anchor.x + offset_x, anchor.y);
        hub = spawn_static_box(world, pivot, radius / 8, radius / 8, zero_fixed());
        ball = spawn_circle(world, make_vec2(pivot.x, pivot.y - cord_length),
                                radius, material_steel());
        body = world.bodies[ball];
        body.material.restitution = one_fixed();
        body.linear_damping = zero_fixed();
        body.angular_damping = zero_fixed();
        body.never_sleeps = true;
        world.add_distance_joint(make_distance_joint(hub, ball, vec2_zero(),
                                                             vec2_zero(), cord_length));
        index += 1;

// The full demo scene: a container, a pyramid, a chain, a wheel, a cradle,
// a hanging cloth and a rope.

    world = make_world();
    world.bounds = make_aabb(vec2_from_ints(-100, -10), vec2_from_ints(100, 120));
    world.grid.configure(whole(4), DEFAULT_BUCKET_COUNT);

    build_container(world, whole(2));
    build_pyramid(world, make_vec2(zero_fixed(), whole(40)), 8, one_fixed());
    build_chain(world, vec2_from_ints(-60, 100), 10, whole(2));
    build_motorised_wheel(world, vec2_from_ints(50, 30), whole(6), whole(3));
    build_newtons_cradle(world, vec2_from_ints(0, 110), 5, one_fixed(), whole(20));
    build_articulated_figure(world, vec2_from_ints(20, 60), one_fixed());

    build_cloth(world.particles, vec2_from_ints(-40, 110), 12, 10, one_fixed(), ratio(8, 10));
    build_rope(world.particles, vec2_from_ints(70, 110), 20, one_fixed(), ratio(9, 10));

    world;

// A minimal two-body scene, which is what the checks below actually run
// because a two-body result is one a reader can verify by hand.

    world = make_world();
    world.bounds = make_aabb(vec2_from_ints(-50, -5), vec2_from_ints(50, 50));
    spawn_static_box(world, vec2_from_ints(0, 0), whole(40), one_fixed(), zero_fixed());
    spawn_circle(world, vec2_from_ints(0, 20), one_fixed(), material_rubber());
    spawn_box(world, vec2_from_ints(10, 20), one_fixed(), one_fixed(),
                      zero_fixed(), material_wood());
    world;

// --- Invariant checks -----------------------------------------------------
//
// These are the properties the engine is supposed to have. They are written
// as `assert` where the claim is a runtime one about a particular scene, and
// as `prove` where the claim is meant to hold for every input the verifier
// can reach.
//
// A fixed-point solver is not exactly energy conserving. The three sources of
// loss and gain are:
//
//   * rounding in the multiply and divide, which is unbiased and so shows up
//     as noise rather than drift;
//   * restitution below one, which removes energy deliberately;
//   * position correction, which moves bodies without doing work and so can
//     add energy if it is too aggressive.
//
// So the checks are one-sided: energy may fall freely, but it must never rise
// by more than the tolerance below.

// Allowed energy gain per step, as a fraction of the starting energy:
// 0.02 * 65536 = 1310.

// Allowed momentum drift per step in absolute units.

// --- Scalar invariants ----------------------------------------------------

// The properties the fixed-point scalar itself has to have for anything above
// to be trustworthy.

    one = one_fixed();
    two = whole(2);
    half = half_fixed();

    // The scale constant is what every conversion is built on.
    FIXED_ONE == 65536;
    FIXED_HALF * 2 == FIXED_ONE;
    FIXED_FRACTION_MASK + 1 == FIXED_ONE;
    one.raw == FIXED_ONE;

    // Multiplication by one is the identity, and by two is a shift.
    (one * one).raw == FIXED_ONE;
    (two * half).raw == FIXED_ONE;
    one * two == two;

    // Negation is exact, so it is its own inverse with no rounding drift.
    (-(-one)).raw == one.raw;
    (-one) + one == zero_fixed();

    // Ordering agrees with the underlying integers.
    half < one;
    one <= one;
    two > one;
    one != two;

    // The reciprocal is accurate to within a couple of units in the last
    // place, which is all sixteen fractional bits can promise.
    inverse_two = two.reciprocal();
    (inverse_two - half).magnitude() <= raw_fixed(4);
    (two * inverse_two - one).magnitude() <= raw_fixed(8);

    // The square root of a perfect square is exact up to the same tolerance.
    four = whole(4);
    (four.square_root() - two).magnitude() <= raw_fixed(4);
    (whole(9).square_root() - whole(3)).magnitude() <= raw_fixed(4);
    whole(0).square_root().raw == 0;

    // Rounding never moves a value by as much as one whole unit.
    awkward = ratio(1, 3);
    (awkward * whole(3) - one).magnitude() < one;
    awkward.floor_int() == 0;
    (-awkward).floor_int() == -1;
    (-awkward).ceil_int() == 0;

// The trigonometric approximations have to satisfy the Pythagorean identity
// well enough that a rotation matrix stays close to orthonormal.

    one = one_fixed();
    // 0.01 * 65536 = 655, the accuracy the Bhaskara form promises.
    tolerance = raw_fixed(655);

    fixed_sin(zero_fixed()).magnitude() <= tolerance;
    (fixed_cos(zero_fixed()) - one).magnitude() <= tolerance;
    (fixed_sin(raw_fixed(FIXED_HALF_PI_RAW)) - one).magnitude() <= tolerance;
    fixed_cos(raw_fixed(FIXED_HALF_PI_RAW)).magnitude() <= tolerance;

    step = 0;
    step < 16;
        angle = tau_fixed() * step / 16;
        s = fixed_sin(angle);
        c = fixed_cos(angle);
        // sin^2 + cos^2 == 1, to within the approximation's own error.
        (s * s + c * c - one).magnitude() <= tolerance * 4;
        // A rotation matrix built from that pair has unit determinant.
        rotation = mat2_rotation(angle);
        (rotation.determinant() - one).magnitude() <= tolerance * 4;
        // Rotating a unit vector preserves its length.
        rotated = rotation * vec2_unit_x();
        (rotated.length() - one).magnitude() <= tolerance * 4;
        step += 1;

        // --- Vector and matrix invariants -----------------------------------------

    a = vec2_from_ints(3, 4);
    b = vec2_from_ints(-2, 5);
    tolerance = raw_fixed(655);

    // The 3-4-5 triangle, which the square root should get exactly right.
    (a.length() - whole(5)).magnitude() <= tolerance;
    a.length_squared().raw == whole(25).raw;

    // Commutativity of the dot product and anticommutativity of the cross.
    a.dot(b).raw == b.dot(a).raw;
    a.cross(b).raw == -b.cross(a).raw;
    a.cross(a) == zero_fixed();

    // The perpendicular really is perpendicular.
    a.dot(a.perpendicular()).raw == 0;
    a.perpendicular().perpendicular() == -a;

    // Addition is commutative and negation is its inverse.
    a + b == b + a;
    a + (-a) == vec2_zero();
    (a - b) + b == a;

    // Scaling distributes over addition.
    s = whole(3);
    (a + b) * s == a * s + b * s;

    // A normalised vector has unit length, and normalising twice changes
    // nothing beyond the rounding of the first pass.
    unit = a.normalised();
    (unit.length() - one_fixed()).magnitude() <= tolerance;
    (unit.normalised() - unit).manhattan_length() <= tolerance;

    // The componentwise operator agrees with doing it by hand.
    product = a % b;
    product.x.raw == (a.x * b.x).raw;
    product.y.raw == (a.y * b.y).raw;

    tolerance = raw_fixed(655);
    identity = mat2_identity();
    rotation = mat2_rotation(raw_fixed(FIXED_QUARTER_PI_RAW));
    v = vec2_from_ints(2, -7);

    identity.is_identity();
    identity * v == v;
    identity * identity == identity;

    // Transposing a rotation inverts it.
    round_trip = rotation.transposed() * (rotation * v);
    (round_trip - v).manhattan_length() <= tolerance * 4;

    // The inverse really is the inverse.
    inverse = rotation.inverted();
    recovered = inverse * (rotation * v);
    (recovered - v).manhattan_length() <= tolerance * 8;

    // Cramer's rule agrees with multiplying by the inverse.
    solved = rotation.solve(v);
    by_inverse = inverse * v;
    (solved - by_inverse).manhattan_length() <= tolerance * 8;

    // Matrix addition is componentwise and negation is its inverse.
    rotation + (-rotation) == mat2_zero();
    (rotation - rotation) == mat2_zero();

    // Composition is associative on rotations, which is what keeps a chain of
    // frames from drifting depending on how it is bracketed.
    other = mat2_rotation(raw_fixed(FIXED_HALF_PI_RAW));
    left = (rotation * other) * rotation;
    right = rotation * (other * rotation);
    (left.col_x - right.col_x).manhattan_length() <= tolerance * 8;
    (left.col_y - right.col_y).manhattan_length() <= tolerance * 8;

    // --- Geometry invariants --------------------------------------------------

    tolerance = raw_fixed(6553);
    box_shape = make_box_polygon(whole(2), whole(3));

    // A 4 by 6 box has area 24 and a centroid at its own origin.
    (box_shape.area() - whole(24)).magnitude() <= tolerance;
    box_shape.centroid().manhattan_length() <= tolerance;
    box_shape.is_convex();
    box_shape.vertices.size() == 4;
    box_shape.normals.size() == 4;

    // Every normal is a unit vector pointing away from the centre.
    index = 0;
    index < box_shape.normals.size();
        normal = box_shape.normals[index];
        (normal.length() - one_fixed()).magnitude() <= raw_fixed(655);
        midpoint = (box_shape.vertex(index) + box_shape.vertex(index + 1)) / 2;
        normal.dot(midpoint) > zero_fixed();
        index += 1;

    // A regular polygon of many sides approaches its circumscribed circle.
    ngon = make_regular_polygon(12, whole(5));
    ngon.is_convex();
    ngon.area() < pi_fixed() * whole(25);
    ngon.area() > pi_fixed() * whole(20);

    // A circle's inertia about its own centre is m r^2 / 2.
    disc = make_circle(vec2_zero(), whole(2));
    disc_inertia = disc.inertia_for_mass(whole(10));
    (disc_inertia - whole(20)).magnitude() <= whole(1);

    a = make_aabb(vec2_from_ints(0, 0), vec2_from_ints(10, 10));
    b = make_aabb(vec2_from_ints(5, 5), vec2_from_ints(15, 15));
    far = make_aabb(vec2_from_ints(100, 100), vec2_from_ints(110, 110));

    a.overlaps(b);
    b.overlaps(a);
    !a.overlaps(far);
    a.contains_point(vec2_from_ints(5, 5));
    !a.contains_point(vec2_from_ints(11, 5));

    // The union contains both operands and the intersection is contained by
    // both, which is the pair of properties the broad phase relies on.
    merged = a + b;
    merged.contains_box(a);
    merged.contains_box(b);
    overlap = a * b;
    a.contains_box(overlap);
    b.contains_box(overlap);

    // Expanding then translating commutes with translating then expanding.
    offset = vec2_from_ints(3, -4);
    a.expanded(one_fixed()).translated(offset) == a.translated(offset).expanded(one_fixed());

    // Area is monotone under expansion.
    a.expanded(one_fixed()).area() > a.area();

// --- Broad-phase invariants -----------------------------------------------

// Every pair the grid reports must have overlapping proxies, and every pair
// with overlapping proxies that share a cell must be reported. The second
// half is checked here by brute force against the same body list.

    world.run_broad_phase(world.timestep);

    index = 0;
    index < world.candidate_pairs.size();
        pair = world.candidate_pairs[index];
        pair.low < pair.high;
        pair.low >= 0;
        pair.high < world.bodies.size();
        // Reported pairs really do overlap in the fattened proxies.
        box_a = world.bodies[pair.low].proxy_bounds(world.proxy_margin, world.timestep);
        box_b = world.bodies[pair.high].proxy_bounds(world.proxy_margin, world.timestep);
        box_a.overlaps(box_b);
        // And the pair list has no duplicates, because it was sorted and
        // swept before it got here.
        index > 0;
            world.candidate_pairs[index - 1] < pair;

        index += 1;

    // Brute force the other direction: anything that actually touches and is
    // allowed to collide must be somewhere in the list.
    first = 0;
    missed = 0;
    first < world.bodies.size();
        second = first + 1;
        second < world.bodies.size();
            a = world.bodies[first];
            b = world.bodies[second];
            should_collide(a, b) && a.bounds().overlaps(b.bounds());
                wanted = make_pair(first, second);
                found = false;
                scan = 0;
                scan < world.candidate_pairs.size();
                    world.candidate_pairs[scan] == wanted;
                        found = true;

                    scan += 1;

                !found;
                    missed += 1;

            second += 1;

        first += 1;

    missed == 0;

    // --- Narrow-phase invariants ----------------------------------------------

    // The normal is a unit vector.
    (manifold.normal.length() - one_fixed()).magnitude() <= raw_fixed(655);
    // At most two points, each penetrating rather than separated.
    manifold.points.size() <= MAX_MANIFOLD_POINTS;
    index = 0;
    index < manifold.points.size();
        point = manifold.points[index];
        point.separation <= raw_fixed(PENETRATION_SLOP_RAW);
        // Accumulated normal impulse is never negative: contacts push, they
        // never pull.
        point.normal_impulse >= zero_fixed();
        // Friction stays inside the Coulomb cone.
        point.tangent_impulse.magnitude()
            <= manifold.friction * point.normal_impulse + raw_fixed(655);
        index += 1;

// Two circles of radius one whose centres are one apart overlap by exactly
// one unit, along the axis joining them.

    tolerance = raw_fixed(655);
    manifold = make_manifold(0, 1);
    circle = make_circle(vec2_zero(), one_fixed());
    frame_a = make_transform(vec2_from_ints(0, 0), zero_fixed());
    frame_b = make_transform(vec2_from_ints(1, 0), zero_fixed());
    collide_circle_circle(manifold, circle, frame_a, circle, frame_b);

    manifold.state == ContactState::Penetrating;
    manifold.points.size() == 1;
    (manifold.normal.x - one_fixed()).magnitude() <= tolerance;
    manifold.normal.y.magnitude() <= tolerance;
    (manifold.points[0].separation + one_fixed()).magnitude() <= tolerance;
    check_manifold_shape(manifold);

    // Move them apart and there is no contact at all.
    far_frame = make_transform(vec2_from_ints(10, 0), zero_fixed());
    collide_circle_circle(manifold, circle, frame_a, circle, far_frame);
    manifold.state == ContactState::Separated;
    manifold.points.size() == 0;

// Two identical axis-aligned boxes overlapping by one unit should produce a
// two-point face manifold with a vertical normal.

    tolerance = raw_fixed(1310);
    manifold = make_manifold(0, 1);
    box_shape = make_box_polygon(whole(2), whole(2));
    lower = make_transform(vec2_from_ints(0, 0), zero_fixed());
    upper = make_transform(vec2_from_ints(0, 3), zero_fixed());
    collide_polygon_polygon(manifold, box_shape, lower, box_shape, upper);

    manifold.state == ContactState::Penetrating;
    manifold.points.size() == 2;
    manifold.normal.x.magnitude() <= tolerance;
    (manifold.normal.y.magnitude() - one_fixed()).magnitude() <= tolerance;
    check_manifold_shape(manifold);

    // The two points sit on the shared face, so they have equal depth.
    depth_difference = manifold.points[0].separation - manifold.points[1].separation;
    depth_difference.magnitude() <= tolerance;

    // Well separated boxes report nothing.
    distant = make_transform(vec2_from_ints(0, 40), zero_fixed());
    collide_polygon_polygon(manifold, box_shape, lower, box_shape, distant);
    manifold.state == ContactState::Separated;

// A circle resting on the top face of a box touches at one point with the
// normal pointing out of the face.

    tolerance = raw_fixed(1310);
    manifold = make_manifold(0, 1);
    circle = make_circle(vec2_zero(), one_fixed());
    box_shape = make_box_polygon(whole(5), whole(1));
    circle_frame = make_transform(vec2_from_ints(0, 2), zero_fixed());
    box_frame = make_transform(vec2_from_ints(0, 0), zero_fixed());
    collide_circle_polygon(manifold, circle, circle_frame, box_shape, box_frame, false);

    manifold.state == ContactState::Penetrating;
    manifold.points.size() == 1;
    manifold.normal.x.magnitude() <= tolerance;
    manifold.normal.y > zero_fixed();
    check_manifold_shape(manifold);

// --- Solver invariants ----------------------------------------------------

// After the velocity solver has run, no contact should still be closing
// faster than the tolerance. This is the property the whole sequential
// impulse scheme exists to establish.

    tolerance = raw_fixed(1310);
    index = 0;
    index < world.manifolds.size();
        manifold = world.manifolds[index];
        body_a = world.bodies[manifold.body_a];
        body_b = world.bodies[manifold.body_b];
        point_index = 0;
        point_index < manifold.points.size();
            point = manifold.points[point_index];
            velocity_a = body_a.velocity_at(point.position);
            velocity_b = body_b.velocity_at(point.position);
            // The long form of the relative normal speed, spelled out over
            // the member chains rather than through a helper, because this is
            // exactly the expression the solver drives to zero.
            closing = manifold.normal.x * (velocity_b.x - velocity_a.x)
                + manifold.normal.y * (velocity_b.y - velocity_a.y);
            closing >= -tolerance - point.velocity_bias;
            point_index += 1;

        index += 1;

// Momentum is conserved by every impulse the solver applies, because every
// impulse is applied equal and opposite to the two bodies. The only thing
// that changes the total is gravity and the static bodies, so the check runs
// on a scene with neither.

    tolerance = raw_fixed(MOMENTUM_TOLERANCE_RAW);
    world = make_world();
    world.gravity = vec2_zero();
    world.bounds = make_aabb(vec2_from_ints(-200, -200), vec2_from_ints(200, 200));

    left = spawn_circle(world, vec2_from_ints(-10, 0), one_fixed(), material_steel());
    right = spawn_circle(world, vec2_from_ints(10, 0), one_fixed(), material_steel());
    world.bodies[left].set_velocity(vec2_from_ints(5, 0));
    world.bodies[right].set_velocity(vec2_from_ints(-5, 0));
    world.bodies[left].never_sleeps = true;
    world.bodies[right].never_sleeps = true;

    initial_momentum = world.total_linear_momentum();
    initial_angular = world.total_angular_momentum();

    step = 0;
    step < 120;
        world.step();
        momentum = world.total_linear_momentum();
        // Linear momentum drifts only by the rounding of the impulses.
        (momentum.x - initial_momentum.x).magnitude() <= tolerance * (step + 1);
        (momentum.y - initial_momentum.y).magnitude() <= tolerance * (step + 1);
        step += 1;

    final_angular = world.total_angular_momentum();
    (final_angular - initial_angular).magnitude() <= tolerance * 120;
    world;

// The central energy check. A closed scene with restitution one and no
// damping may lose energy to rounding and to the position solver, but it must
// never gain more than the tolerance.

    world = make_world();
    world.bounds = make_aabb(vec2_from_ints(-60, -5), vec2_from_ints(60, 80));
    build_container(world, one_fixed());

    ball = spawn_circle(world, vec2_from_ints(0, 40), one_fixed(), material_rubber());
    body = world.bodies[ball];
    body.material.restitution = one_fixed();
    body.linear_damping = zero_fixed();
    body.angular_damping = zero_fixed();
    body.never_sleeps = true;

    initial_energy = world.total_energy();
    peak_energy = initial_energy + zero_fixed();
    minimum_energy = initial_energy + zero_fixed();

    step = 0;
    step < 240;
        before = world.total_energy();
        world.step();
        after = world.total_energy();

        // The per-step gain bound. ENERGY_TOLERANCE_RAW is a fraction of the
        // energy present, so a scene at rest is held to a tight absolute
        // bound and an energetic one to a proportional bound.
        allowed = before.magnitude() * raw_fixed(ENERGY_TOLERANCE_RAW) + one_fixed();
        after <= before + allowed;

        peak_energy = fixed_max(peak_energy, after);
        minimum_energy = fixed_min(minimum_energy, after);
        check_contacts_are_separating(world);
        step += 1;

    // Over the whole run the energy must not have run away, and a perfectly
    // elastic ball must not have come to a complete stop either.
    cumulative_allowance = initial_energy.magnitude()
        * raw_fixed(ENERGY_TOLERANCE_RAW) * 8 + whole(10);
    peak_energy <= initial_energy + cumulative_allowance;
    minimum_energy >= zero_fixed();
    peak_energy >= minimum_energy;
    world;

// Damping and a restitution below one must strictly remove energy, which is
// the other half of the same property.

    world = build_pair_scene();
    initial_energy = world.total_energy();
    step = 0;
    step < 300;
        world.step();
        step += 1;

    final_energy = world.total_energy();

    // A scene with friction, damping and restitution below one ends with no
    // more energy than it started with, plus the same rounding allowance.
    allowance = initial_energy.magnitude() * raw_fixed(ENERGY_TOLERANCE_RAW) + whole(1);
    final_energy <= initial_energy + allowance;

    // And it should have actually settled: everything asleep or nearly still.
    index = 0;
    index < world.bodies.size();
        body = world.bodies[index];
        body.kind == BodyKind::Dynamic;
            !body.awake || body.velocity.length_squared() <= one_fixed();

        index += 1;

    world;

// --- Particle invariants --------------------------------------------------

// A Verlet particle under no forces moves in a straight line at constant
// speed, and a spring at its rest length applies no correction at all.

    tolerance = raw_fixed(655);
    dt = raw_fixed(DEFAULT_TIMESTEP_RAW);
    system = make_particle_system();
    system.damping = one_fixed();

    index = system.add_particle(vec2_from_ints(0, 0), one_fixed());
    system.particles[index].set_velocity(vec2_from_ints(10, 0), dt);
    initial_speed = system.particles[index].velocity(dt).length();

    step = 0;
    step < 60;
        system.integrate(vec2_zero(), dt);
        speed = system.particles[index].velocity(dt).length();
        (speed - initial_speed).magnitude() <= tolerance * 4;
        // No vertical drift without gravity.
        system.particles[index].position.y.magnitude() <= tolerance;
        step += 1;

    // After a second at ten units per second it has travelled ten units.
    (system.particles[index].position.x - whole(10)).magnitude() <= one_fixed();
    system;

    tolerance = raw_fixed(6553);
    system = make_particle_system();
    system.relaxation_passes = 16;

    anchor = system.add_pinned(vec2_from_ints(0, 0));
    free = system.add_particle(vec2_from_ints(10, 0), one_fixed());
    spring = system.connect_at(anchor, free, whole(5), one_fixed());

    // A pinned particle never moves, whatever the spring does.
    start = system.particles[anchor].position + vec2_zero();
    system.relax_springs();
    system.particles[anchor].position == start;

    // And the free end has been pulled to the rest length.
    length = system.springs[spring].current_length(system.particles);
    (length - whole(5)).magnitude() <= tolerance;
    system.springs[spring].strain(system.particles).magnitude() <= tolerance;
    !system.springs[spring].broken;
    system;

// A cloth pinned at two corners must hang without any particle escaping the
// world box or any spring tearing at rest.

    system = make_particle_system();
    bounds = make_aabb(vec2_from_ints(-100, -100), vec2_from_ints(100, 100));
    build_cloth(system, vec2_from_ints(-10, 50), 8, 8, one_fixed(), ratio(9, 10));
    gravity = make_vec2(zero_fixed(), -raw_fixed(GRAVITY_RAW));
    dt = raw_fixed(DEFAULT_TIMESTEP_RAW);

    step = 0;
    step < 180;
        system.step(gravity, dt, bounds);
        step += 1;

    system.broken_spring_count() == 0;
    index = 0;
    index < system.particles.size();
        particle = system.particles[index];
        bounds.contains_point(particle.position);
        // No particle has acquired an absurd speed, which is what a diverging
        // relaxation would look like.
        particle.velocity(dt).length_squared() <= whole(10000);
        index += 1;

    // The pinned corners are exactly where they were put.
    system.particles[0].pinned;
    system;

// --- Joint invariants -----------------------------------------------------

// A rigid distance joint holds its rest length to within the position solver's
// tolerance, and a rope only ever pulls.

    tolerance = raw_fixed(6553);
    world = make_world();
    world.bounds = make_aabb(vec2_from_ints(-100, -100), vec2_from_ints(100, 100));

    anchor = spawn_static_box(world, vec2_from_ints(0, 50), one_fixed(), one_fixed(), zero_fixed());
    bob = spawn_circle(world, vec2_from_ints(10, 50), one_fixed(), material_steel());
    world.bodies[bob].never_sleeps = true;
    joint = world.add_distance_joint(
        make_distance_joint(anchor, bob, vec2_zero(), vec2_zero(), whole(10)));

    step = 0;
    step < 240;
        world.step();
        length = (world.bodies[bob].world_centre()
                      - world.bodies[anchor].world_centre()).length();
        (length - whole(10)).magnitude() <= tolerance * 4;
        world.distance_joints[joint].status != JointStatus::Broken;
        step += 1;

    // A pendulum swinging from a fixed anchor stays on its circle, so the
    // stretch ratio is one to within the same tolerance.
    ratio_now = world.distance_joints[joint].stretch_ratio();
    (ratio_now - one_fixed()).magnitude() <= tolerance;
    world;

    // A revolute joint holds its two anchor points together.

    tolerance = raw_fixed(6553);
    world = make_world();
    world.bounds = make_aabb(vec2_from_ints(-100, -100), vec2_from_ints(100, 100));
    build_chain(world, vec2_from_ints(0, 60), 6, one_fixed());

    step = 0;
    step < 180;
        world.step();
        step += 1;

    index = 0;
    index < world.revolute_joints.size();
        joint = world.revolute_joints[index];
        world_a = world.bodies[joint.body_a].to_world(joint.local_anchor_a);
        world_b = world.bodies[joint.body_b].to_world(joint.local_anchor_b);
        // The drift between the two anchors is the joint's whole error.
        (world_b - world_a).manhattan_length() <= tolerance * 8;
        index += 1;

    world;

// --- Determinism ----------------------------------------------------------

// The same scene stepped the same number of times from the same start must
// produce bit-identical results. This is the property fixed point was chosen
// for, so it is checked exactly rather than with a tolerance.

    first = build_pair_scene();
    second = build_pair_scene();

    step = 0;
    step < 120;
        first.step();
        second.step();
        step += 1;

    first.bodies.size() == second.bodies.size();
    index = 0;
    index < first.bodies.size();
        a = first.bodies[index];
        b = second.bodies[index];
        // Exact equality on the raw integers, no tolerance at all.
        a.frame.position.x.raw == b.frame.position.x.raw;
        a.frame.position.y.raw == b.frame.position.y.raw;
        a.frame.angle.raw == b.frame.angle.raw;
        a.velocity.x.raw == b.velocity.x.raw;
        a.velocity.y.raw == b.velocity.y.raw;
        a.angular_velocity.raw == b.angular_velocity.raw;
        index += 1;

    first.step_index == second.step_index;
    first;
    second;

// --- Timestep invariants --------------------------------------------------

// The accumulator loop must consume whole steps only, must never run more
// than the cap, and must leave less than one step behind.

    world = make_world();
    dt = world.timestep + zero_fixed();

    // Exactly one step's worth of time runs exactly one step.
    one_step = world.update(dt);
    one_step == 1;
    world.accumulator < dt;

    // Half a step runs nothing and is carried.
    no_steps = world.update(dt / 2);
    no_steps == 0;
    world.accumulator >= zero_fixed();
    world.accumulator < dt;

    // Three and a half steps run three and carry the half.
    three_steps = world.update(dt * 3);
    three_steps == 3;
    world.accumulator < dt;

    // A huge lag is capped rather than spiralling.
    capped = world.update(dt * 1000);
    capped <= MAX_STEPS_PER_UPDATE;
    world.interpolation_alpha() <= one_fixed();
    world.interpolation_alpha() >= zero_fixed();
    world;

// --- Entry point ----------------------------------------------------------

// Run the whole check suite in dependency order: the scalar first, because
// everything above it is meaningless if the scalar is wrong, then the
// algebra, then the geometry, then the pipeline.

    check_fixed_invariants();
    check_trigonometry();
    check_vector_algebra();
    check_matrix_algebra();
    check_shape_properties();
    check_bounds_algebra();

    check_circle_circle();
    check_circle_polygon();
    check_polygon_polygon();

    scene = build_demo_scene();
    check_broad_phase(scene);
    scene;

    check_momentum_conservation();
    check_energy_conservation();
    check_energy_dissipation();

    check_particle_integration();
    check_spring_relaxation();
    check_cloth_stability();

    check_distance_joint();
    check_revolute_joint();

    check_determinism();
    check_fixed_timestep();

    println("particle_sim: all checks passed");
    println(to_string(fixed_multiply_count));
    println(to_string(narrow_phase_test_count));
    println(to_string(solver_iteration_count));

// Step the demo scene for a while and report what the profiler counters saw.
// This is the benchmark's own workload rather than a correctness check.

    world = build_demo_scene();
    step = 0;
    step < step_count;
        world.step();
        step % 60 == 0;
            // Once a second, poke the scene so that it never fully settles.
            world.apply_radial_impulse(vec2_from_ints(0, 20), whole(15), whole(40));

        step += 1;

    total = world.statistics.broad_phase_pairs
        + world.statistics.narrow_phase_tests
        + world.statistics.manifold_count;
    world;
    total;

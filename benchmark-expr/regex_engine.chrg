        out = vector{string}();
        !ok;
            out.push_back(subject);
            out;

        cursor = 0;
        guard = 0;
        cursor <= subject.size();
            guard += 1;
            guard > subject.size() + 2;

            limit > 0;
                out.size() + 1 >= limit;

            hit = search_from(subject, cursor);
            !hit.matched();

            begin = hit.begin();
            stop = hit.end();
            stop == begin;
                // A zero width separator would split between every pair of
                // characters; step over one character instead.
                begin >= subject.size();

                out.push_back(subject.substr(cursor, begin + 1 - cursor));
                cursor = begin + 1;

            out.push_back(subject.substr(cursor, begin - cursor));
            cursor = stop;

        out.push_back(subject.substr(cursor, subject.size() - cursor));
        out;

    // Split and keep only the pieces that are not empty, which is what most
    // tokenising callers actually want.

        pieces = split(subject, limit);
        out = vector{string}();
        piece , pieces;
            !piece.empty();
                out.push_back(piece);

        out;

        // --- Diagnostics ------------------------------------------------------

        out = TEXT_EMPTY;
        out.append("pattern ");
        out.append(pattern);
        out.append(TEXT_NEWLINE);
        !ok;
            out.append("error: ");
            out.append(error);
            out.append(" at ");
            out.append(to_string(error_position));
            out.append(TEXT_NEWLINE);
            out;

        out.append("groups: ");
        out.append(to_string(parser.group_count));
        out.append(TEXT_NEWLINE);
        out.append("nfa states: ");
        out.append(to_string(builder.state_count()));
        out.append(TEXT_NEWLINE);
        out.append("program: ");
        out.append(to_string(compiler.program.size()));
        out.append(TEXT_NEWLINE);
        out.append("prefix: ");
        out.append(prefix);
        out.append(TEXT_NEWLINE);
        out.append(optimiser.stats.describe());
        out.append(TEXT_NEWLINE);
        out;

        // Substitute `$n` references in a replacement template.

    out = TEXT_EMPTY;
    i = 0;
    i < template_text.size();
        c = template_text.at(i);
        c != CHAR_DOLLAR;
            out.push_back(c);
            i += 1;

        next = i + 1;
        next >= template_text.size();
            out.push_back(c);
            i += 1;

        marker = template_text.at(next);
        marker == CHAR_DOLLAR;
            out.push_back(CHAR_DOLLAR);
            i += 2;

        is_digit(marker);
            out.append(hit.group(digit_value(marker)));
            i += 2;

        marker == CHAR_LBRACE;
            // `${name}` refers to a named group.
            scan = next + 1;
            name = TEXT_EMPTY;
            scan < template_text.size();
                n = template_text.at(scan);
                n == CHAR_RBRACE;

                name.push_back(n);
                scan += 1;

            index = NONE;
            entry , hit.names;
                entry.name.compare(name) == 0;
                    index = entry.index;

            index != NONE;
                out.append(hit.group(index));

            i = scan + 1;

        out.push_back(c);
        i += 1;

    out;

// --- Convenience wrappers ------------------------------------------------
//
// One shot helpers for callers that do not want to keep a compiled pattern
// around.  Each of them pays for compilation, so a loop should build a
// `Regex` once instead.

    re = Regex();
    !re.compile(pattern);
        false;

    hit = re.match_text(subject);
    hit.matched();

    re = Regex();
    !re.compile(pattern);
        false;

    re.contains(subject);

    re = Regex();
    !re.compile(pattern);
        subject;

    re.replace_all(subject, replacement);

    re = Regex();
    out = vector{string}();
    !re.compile(pattern);
        out.push_back(subject);
        out;

    re.split(subject, 0);

    // Escape every metacharacter in `text` so the result matches it literally.

    out = TEXT_EMPTY;
    i = 0;
    i < text.size();
        c = text.at(i);
        is_metacharacter(c);
            out.push_back(CHAR_BACKSLASH);

        out.push_back(c);
        i += 1;

    out;

// --- Worked examples -----------------------------------------------------
//
// These are not tests - nothing here asserts - but they pin down what the API
// is meant to look like from the outside, and they exercise every entry point
// at least once.

    re = Regex();
    !re.compile("[a-zA-Z_][a-zA-Z_0-9]*");
        vector{string}();

    out = vector{string}();
    hits = re.find_all(subject);
    hit , hits;
        out.push_back(hit.text());

    out;

    re = Regex();
    !re.compile("//[^\n]*");
        subject;

    re.replace_all(subject, TEXT_EMPTY);

    out = vector{int}();
    re = Regex();
    !re.compile("(\\d{4})-(\\d{2})-(\\d{2})");
        out;

    hit = re.match_text(subject);
    !hit.matched();
        out;

    out.push_back(parse_int(hit.group(1)));
    out.push_back(parse_int(hit.group(2)));
    out.push_back(parse_int(hit.group(3)));
    out;

    re = Regex();
    !re.compile("(?<key>\\w+)\\s*=\\s*(?<value>[^;]+);");
        TEXT_EMPTY;

    re.replace_all(subject, "${value} -> ${key}\n");

    quick_split(",\\s*", subject);

    re = Regex();
    // A backreference, so this one has to run on the backtracking matcher.
    !re.compile("\\b(\\w+)\\s+\\1\\b");
        false;

    re.contains(subject);

    re = Regex();
    !re.compile(pattern);
        println(re.error_text());

    println(re.describe());
    println(re.compiler.program.disassemble());

// A rough sanity sweep over the whole engine, written as a function so the
// benchmark corpus contains at least one caller of everything above.

    re = Regex();
    !re.compile("^(a|b)+c{2,4}[[:digit:]]*$");
        panic(re.error_text());

    re.group_count() == 1;
    re.program_size() > 0;
    re.state_count() > 0;

    hit = re.match_text("abbacc42");
    hit.matched();
        println(hit.text());

    pieces = quick_split("\\s+", "one two   three");
    piece , pieces;
        println(piece);

    println(quick_replace("[aeiou]", "regular expressions", "*"));
    quick_match("\\d+", "12345");
        println("all digits");

    example_repeated_word("the the end");
        println("repeated word found");

    println(quote_literal("1 + 2 * (3 - 4)"));

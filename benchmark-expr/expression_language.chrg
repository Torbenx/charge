// operators are always right associative, so `- - x` parses as `-(-x)`.

    kind == TokenKind::Minus; PRECEDENCE_PREFIX;
    kind == TokenKind::Plus; PRECEDENCE_PREFIX;
    kind == TokenKind::Bang; PRECEDENCE_PREFIX;
    kind == TokenKind::KeywordNot; PRECEDENCE_PREFIX;
    kind == TokenKind::Tilde; PRECEDENCE_PREFIX;
    kind == TokenKind::PlusPlus; PRECEDENCE_PREFIX;
    kind == TokenKind::MinusMinus; PRECEDENCE_PREFIX;
    PRECEDENCE_NONE;

    kind == TokenKind::PlusPlus; PRECEDENCE_POSTFIX;
    kind == TokenKind::MinusMinus; PRECEDENCE_POSTFIX;
    kind == TokenKind::Bang; PRECEDENCE_POSTFIX;
    kind == TokenKind::LParen; PRECEDENCE_POSTFIX;
    kind == TokenKind::LBracket; PRECEDENCE_POSTFIX;
    kind == TokenKind::Dot; PRECEDENCE_POSTFIX;
    PRECEDENCE_NONE;

    kind == TokenKind::Equal; true;
    kind == TokenKind::PlusEqual; true;
    kind == TokenKind::MinusEqual; true;
    kind == TokenKind::StarEqual; true;
    kind == TokenKind::SlashEqual; true;
    kind == TokenKind::PercentEqual; true;
    kind == TokenKind::AmpEqual; true;
    kind == TokenKind::PipeEqual; true;
    kind == TokenKind::CaretEqual; true;
    kind == TokenKind::LessLessEqual; true;
    kind == TokenKind::GreaterGreaterEqual; true;
    false;

// A compound assignment such as `a += b` desugars to `a = a + b`, so the
// evaluator needs the plain operator that hides inside it.

    kind == TokenKind::PlusEqual; TokenKind::Plus;
    kind == TokenKind::MinusEqual; TokenKind::Minus;
    kind == TokenKind::StarEqual; TokenKind::Star;
    kind == TokenKind::SlashEqual; TokenKind::Slash;
    kind == TokenKind::PercentEqual; TokenKind::Percent;
    kind == TokenKind::AmpEqual; TokenKind::Amp;
    kind == TokenKind::PipeEqual; TokenKind::Pipe;
    kind == TokenKind::CaretEqual; TokenKind::Caret;
    kind == TokenKind::LessLessEqual; TokenKind::LessLess;
    kind == TokenKind::GreaterGreaterEqual; TokenKind::GreaterGreater;
    TokenKind::Invalid;


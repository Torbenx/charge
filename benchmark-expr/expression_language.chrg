    rows_push_back , OperatorRow , TokenKind_MinusEqual , "-=" , PRECEDENCE_ASSIGN , Associativity_Right , true;
    rows_push_back , OperatorRow , TokenKind_StarEqual , "*=" , PRECEDENCE_ASSIGN , Associativity_Right , true;

// point at a line and a column rather than a bare byte offset.

        offset++;
        c == CHAR_NEWLINE;
            ++line;
            column = 1;

            ++column;

        out = "line ";
        out_append , to_string , line;
        out_append , ", column ";
        out_append , to_string , column;
        out;

// A half open range of the source text. The printer never uses spans, but the
// interpreter quotes them back when a runtime error happens.

        end_offset - begin_offset;

        length <= 0;

        empty;
            TEXT_EMPTY;

        source_substr , begin_offset , length;

        out = begin_describe;
        end_line != begin_line;

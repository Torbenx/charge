    tree.at(index).extra != NO_NODE;
        out.append(dump_node(tree, tree.at(index).extra, depth + 1));

    child , tree.at(index).parts;
        out.append(dump_node(tree, child, depth + 1));

    out;

// Structural comparison, which is what "round trips" actually means: the
// text may differ, the tree may not.

    !left.valid(a) || !right.valid(b);
        left.valid(a) == right.valid(b);

    left.kind_of(a) != right.kind_of(b);
        false;

    left.operator_of(a) != right.operator_of(b);
        false;

    left.at(a).text != right.at(b).text;
        false;

    left.kind_of(a) == NodeKind::NumberLiteral;
        x = make_decimal(left.at(a).mantissa, left.at(a).exponent);
        y = make_decimal(right.at(b).mantissa, right.at(b).exponent);
        !decimal_equal(x, y);
            false;

    left.at(a).flag != right.at(b).flag;
        false;

    left.at(a).parts.size() != right.at(b).parts.size();
        false;

    !trees_equal(left, left.at(a).lhs, right, right.at(b).lhs);
        false;

    !trees_equal(left, left.at(a).rhs, right, right.at(b).rhs);
        false;

    !trees_equal(left, left.at(a).extra, right, right.at(b).extra);
        false;

    i , range(0, left.at(a).parts.size());
        !trees_equal(left, left.at(a).parts[i], right, right.at(b).parts[i]);
            false;

    true;

// --- Driving the whole pipeline ------------------------------------------
//
// One object that owns a parser, a folder and an interpreter, so that a
// caller can feed it one line at a time and keep the bindings between calls.

        problem.ok();

        problem.describe();

    // Parse, optionally fold, then evaluate. Returns the value of the last
    // statement, or a failure value describing the first thing that went
    // wrong.

        parser ;
        root = parser.parse_program(source);
        !parser.problem.ok();
            problem = parser.problem;
            failure_value(problem.describe());

        optimize;
            rewrites += fold_to_fixed_point(parser.tree, root);

        machine.tree = move(parser.tree);
        machine.returning = false;
        value = machine.evaluate(root);
        steps += machine.steps;
        value.is_failure();
            problem = machine.problem;

        last = value;
        value;

        machine.environment.define_global(name, move(value));

        machine.environment.bound(name);

        machine.environment.lookup(name);

        machine.reset();
        problem = Diagnostic();
        steps = 0;
        rewrites = 0;
        last = nil_value();

    session ;
    session.machine.environment = make_environment();
    session;

    // Convenience: evaluate one expression in a throwaway session.

    session = make_session();
    session.run(source);

// --- The round trip ------------------------------------------------------
//
// Parse, print, reparse and compare. This is the property the printer has to
// satisfy: printing may change the text but it may never change the tree.

    first ;
    a = first.parse_source(source);
    !first.problem.ok();
        false;

    printed = print_tree(first.tree, a);

    second ;
    b = second.parse_source(printed);
    !second.problem.ok();
        false;

    trees_equal(first.tree, a, second.tree, b);

// The stronger version: printing the reprinted text has to be byte identical
// to the first printing, so the printer is idempotent as well as faithful.

    first ;
    a = first.parse_source(source);
    !first.problem.ok();
        false;

    once = print_tree(first.tree, a);

    second ;
    b = second.parse_source(once);
    !second.problem.ok();
        false;

    twice = print_tree(second.tree, b);
    once == twice;

// --- Sample programs -----------------------------------------------------
//
// Deliberately dense inputs that exercise the whole precedence table at
// once. They are held as strings, so the operators inside them are data for
// the tokenizer rather than charge syntax.

    samples ;
    samples.push_back("1 + 2 * 3 - 4 / 2");
    samples.push_back("2 ** 3 ** 2");
    samples.push_back("-x * -y + ~mask");
    samples.push_back("a < b && b < c || not done");
    samples.push_back("flags & 12 | 3 ^ 5");
    samples.push_back("value << 3 >> 1");
    samples.push_back("total += count * 2");
    samples.push_back("if ready then 1 else 0");
    samples.push_back("ready ? first : second");
    samples.push_back("points[0].x + points[1].y");
    samples.push_back("min(a, b) + max(c, d)");
    samples.push_back("offset(dx: 3, dy: 4)");
    samples.push_back("\"prefix \" + name + \" suffix\"");
    samples.push_back("counter++ + ++counter");
    samples.push_back("5! + 3!");
    samples.push_back("12.5 * 4 - 0.5");
    samples.push_back("list(1, 2, 3).length");
    samples.push_back("[1, 2, 3][1]");
    samples.push_back("(a + b) * (c - d)");
    samples.push_back("a = b = c = 0");
    samples.push_back("sum([10, 20, 30]) / 3");
    samples.push_back("upper(trim(\"  hello  \"))");
    samples;

    programs ;
    programs.push_back("let x = 3; let y = 4; sqrt(x ** 2 + y ** 2)");
    programs.push_back("let total = 0; let i = 0; while i < 10 { total += i; i++; } total");
    programs.push_back("let name = \"world\"; concat(\"hello \", name)");
    programs.push_back("let items = [1, 2, 3, 4]; sum(items) / len(items)");
    programs.push_back("let flag = true; if flag then \"yes\" else \"no\"");
    programs.push_back("let scale = 1000; let ratio = 3141 / scale; round(ratio)");
    // A block whose tail is dead: the folder should drop everything after
    // the return.
    programs.push_back("{ return 1; let unused = 2; unused + 3; }");
    programs;

// --- Self checks ---------------------------------------------------------
//
// These read like unit tests but they are ordinary functions; the benchmark
// harness calls them and the assertions document the intended behaviour.

    infix_precedence(TokenKind::Star) > infix_precedence(TokenKind::Plus);
    infix_precedence(TokenKind::Plus) > infix_precedence(TokenKind::LessLess);
    infix_precedence(TokenKind::LessLess) > infix_precedence(TokenKind::Less);
    infix_precedence(TokenKind::Less) > infix_precedence(TokenKind::EqualEqual);
    infix_precedence(TokenKind::EqualEqual) > infix_precedence(TokenKind::Amp);
    infix_precedence(TokenKind::Amp) > infix_precedence(TokenKind::Caret);
    infix_precedence(TokenKind::Caret) > infix_precedence(TokenKind::Pipe);
    infix_precedence(TokenKind::Pipe) > infix_precedence(TokenKind::AmpAmp);
    infix_precedence(TokenKind::AmpAmp) > infix_precedence(TokenKind::PipePipe);
    infix_precedence(TokenKind::PipePipe) > infix_precedence(TokenKind::Question);
    infix_precedence(TokenKind::Question) > infix_precedence(TokenKind::Equal);
    infix_precedence(TokenKind::StarStar) > infix_precedence(TokenKind::Star);
    prefix_precedence(TokenKind::Bang) > infix_precedence(TokenKind::StarStar);
    postfix_precedence(TokenKind::LParen) > prefix_precedence(TokenKind::Bang);
    infix_precedence(TokenKind::Identifier) == PRECEDENCE_NONE;
    infix_associativity(TokenKind::StarStar) == Associativity::Right;
    infix_associativity(TokenKind::Minus) == Associativity::Left;

    rows = operator_table();
    row , rows;
        row.precedence == infix_precedence(row.kind);
        row.associativity == infix_associativity(row.kind);
        row.spelling == token_spelling(row.kind);
        row.mutating;
            is_assignment_operator(row.kind);

    tokens = tokenize("a + 12.5 * \"text\" // trailing");
    tokens.size() > 0;
    tokens[0].kind == TokenKind::Identifier;
    tokens[1].kind == TokenKind::Plus;
    tokens[2].kind == TokenKind::Number;
    tokens[2].mantissa == 125;
    tokens[2].exponent == -1;
    tokens[3].kind == TokenKind::Star;
    tokens[4].kind == TokenKind::Text;
    tokens[tokens.size() - 1].kind == TokenKind::End;

    tokens = tokenize("a <<= b >>= c ++ d -- e ** f");
    tokens[1].kind == TokenKind::LessLessEqual;
    tokens[3].kind == TokenKind::GreaterGreaterEqual;
    tokens[5].kind == TokenKind::PlusPlus;
    tokens[7].kind == TokenKind::MinusMinus;
    tokens[9].kind == TokenKind::StarStar;

    a = make_decimal(125, -1);
    b = make_decimal(5, -1);
    decimal_add(a, b).to_text() == "13";
    decimal_subtract(a, b).to_text() == "12";
    decimal_multiply(a, decimal_from_int(2)).to_text() == "25";
    decimal_compare(a, b) > 0;
    decimal_equal(make_decimal(150, -2), make_decimal(15, -1));
    decimal_from_int(0).is_zero();

    source , sample_expressions();
        parser ;
        root = parser.parse_source(source);
        root != NO_NODE;
        parser.problem.ok();

    source , sample_expressions();
        round_trips(source);
        printing_is_stable(source);

    // `2 ** 3 ** 2` groups to the right, so the left child is a literal and
    // the right child is another power node.
    parser ;
    root = parser.parse_source("2 ** 3 ** 2");
    parser.tree.kind_of(root) == NodeKind::Binary;
    parser.tree.operator_of(root) == TokenKind::StarStar;
    right = parser.tree.at(root).rhs;
    parser.tree.kind_of(right) == NodeKind::Binary;
    parser.tree.operator_of(right) == TokenKind::StarStar;

    // Subtraction groups to the left, so the shape is mirrored.
    other ;
    flat = other.parse_source("1 - 2 - 3");
    other.tree.kind_of(other.tree.at(flat).lhs) == NodeKind::Binary;
    other.tree.kind_of(other.tree.at(flat).rhs) == NodeKind::NumberLiteral;

    parser ;
    root = parser.parse_source("1 + 2 * 3");
    changes = fold_to_fixed_point(parser.tree, root);
    changes > 0;
    parser.tree.kind_of(root) == NodeKind::NumberLiteral;
    parser.tree.at(root).mantissa == 7;

    parser ;
    root = parser.parse_source("x * 1 + 0");
    fold_to_fixed_point(parser.tree, root);
    parser.tree.kind_of(root) == NodeKind::Variable;
    parser.tree.at(root).text == "x";

    parser ;
    root = parser.parse_source("if true then 1 else 2");
    fold_to_fixed_point(parser.tree, root);
    parser.tree.kind_of(root) == NodeKind::NumberLiteral;
    parser.tree.at(root).mantissa == 1;

    evaluate_text("1 + 2 * 3").to_text() == "7";
    evaluate_text("2 ** 10").to_text() == "1024";
    evaluate_text("10 / 4").to_text() == "2.5";
    evaluate_text("7 % 3").to_text() == "1";
    evaluate_text("\"a\" + \"b\"").to_text() == "ab";
    evaluate_text("len([1, 2, 3])").to_text() == "3";
    evaluate_text("true && false").to_text() == WORD_FALSE;
    evaluate_text("1 < 2 && 2 < 3").truthy();

    session = make_session();
    session.run("let outer = 1;");
    session.bound("outer");
    session.run("{ let inner = 2; inner + outer; }");
    // The inner binding died with its block; the outer one survived.
    session.bound("outer");
    !session.bound("inner");

    parser ;
    root = parser.parse_source("1 +");
    root == NO_NODE || !parser.problem.ok();
    parser.problem.code == ErrorCode::ExpectedExpression;

    second ;
    second.parse_source("(1 + 2");
    second.problem.code == ErrorCode::UnbalancedParen;

    third ;
    third.parse_source("1 = 2");
    third.problem.code == ErrorCode::NotAssignable;

    source , sample_programs();
        session = make_session();
        value = session.run(source);
        !value.is_failure();

// The entry point the benchmark harness calls. Everything above is reachable
// from here.

    check_precedence_table();
    check_table_is_consistent();
    check_tokenizer();
    check_maximal_munch();
    check_decimals();
    check_parses();
    check_round_trip();
    check_associativity_shape();
    check_folding();
    check_identity_folding();
    check_dead_branch();
    check_evaluation();
    check_scoping();
    check_errors();
    check_programs();
    println("expression language: all checks passed");

// A tiny read eval print driver, kept at the bottom so the file ends on the
// thing a reader is most likely to look for.

    session = make_session();
    failures = 0;
    line , *lines;
        trimmed = text_trim(line);
        trimmed.empty();

        value = session.run(trimmed);
        value.is_failure();
            failures += 1;
            println(session.last_error());

            println(value.to_text());

    failures;

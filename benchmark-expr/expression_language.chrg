// A small expression language: tokenizer, Pratt parser, tree-walking
// interpreter, a constant folder and a pretty printer that round-trips the
// abstract syntax tree back to source text.
//
// The language accepted here looks like this:
//
//     let radius = 12;
//     let area = 3141 * radius ** 2 / 1000;
//     if area > 100 then "large" else "small"
//     points[0].x + offset(dx: 4, dy: 5)
//
// Numbers are stored as a scaled integer mantissa plus a decimal exponent,
// because the charge lexer only accepts plain decimal integer literals. The
// value of a literal is  mantissa * 10^exponent, so the source text `12.5`
// lexes into the pair (125, -1) and prints back out as `12.5`.
//
// The parser is a precedence climbing (Pratt) parser: a single table maps a
// token kind to a binding power, and `parse_expression` calls itself through
// the prefix, infix and postfix rules. Those functions are mutually
// recursive, which is the whole point of the design - the grammar is data,
// not control flow.

// --- Character constants -------------------------------------------------
//
// The tokenizer compares raw characters on nearly every line, so each one
// that matters gets a name up here rather than being spelled inline.

// --- Spellings -----------------------------------------------------------
//
// Both the tokenizer and the printer need the surface text of every
// operator. Keeping them in one place is what makes the round trip exact.

// Decimal scaling. A number is mantissa * 10^exponent; the tokenizer refuses
// to keep more than MAX_DIGITS significant digits so the mantissa cannot run
// away on input like 0.0000000000000000001.

// --- Token kinds ---------------------------------------------------------
//
// One entry per distinct spelling. The tokenizer does maximal munch, so
// `<<=` has to be tried before `<<` and `<<` before `<`.

// --- Node kinds ----------------------------------------------------------

// --- Value kinds ---------------------------------------------------------

// --- Associativity -------------------------------------------------------

// --- Diagnostics ---------------------------------------------------------

    code == ErrorCode::None;
        "no error";

    code == ErrorCode::UnexpectedCharacter;
        "unexpected character in the input";

    code == ErrorCode::UnterminatedText;
        "unterminated string literal, expected a closing quote";

    code == ErrorCode::UnterminatedComment;
        "unterminated block comment, expected a closing marker";

    code == ErrorCode::BadEscape;
        "invalid escape sequence after a backslash";

    code == ErrorCode::TooManyDigits;
        "number has more significant digits than can be represented";

    code == ErrorCode::ExponentRange;
        "decimal exponent is out of range";

    code == ErrorCode::ExpectedExpression;
        "expected an expression";

    code == ErrorCode::ExpectedToken;
        "expected a different token here";

    code == ErrorCode::ExpectedIdentifier;
        "expected an identifier";

    code == ErrorCode::UnbalancedParen;
        "expected a closing parenthesis";

    code == ErrorCode::UnbalancedBracket;
        "expected a closing bracket";

    code == ErrorCode::DepthExceeded;
        "expression nests too deeply";

    code == ErrorCode::TooManyArguments;
        "call has too many arguments";

    code == ErrorCode::NotAssignable;
        "left hand side of the assignment is not assignable";

    code == ErrorCode::UnknownName;
        "name is not bound in any enclosing scope";

    code == ErrorCode::NotCallable;
        "value is not callable";

    code == ErrorCode::NotIndexable;
        "value cannot be indexed";

    code == ErrorCode::WrongArity;
        "builtin called with the wrong number of arguments";

    code == ErrorCode::DivideByZero;
        "division by zero";

    code == ErrorCode::TypeMismatch;
        "operand types do not match the operator";

    "unknown error";

// --- Source positions ----------------------------------------------------

// Every token carries the position it started at so that a diagnostic can
// point at a line and a column rather than a bare byte offset.

        offset += 1;
        c == CHAR_NEWLINE;
            line += 1;
            column = 1;

            column += 1;

        out = "line ";
        out.append(to_string(line));
        out.append(", column ");
        out.append(to_string(column));
        out;

// A half open range of the source text. The printer never uses spans, but the
// interpreter quotes them back when a runtime error happens.

        end.offset - begin.offset;

        length() <= 0;

        empty();
            TEXT_EMPTY;

        source.substr(begin.offset, length());

        out = begin.describe();
        end.line != begin.line;
            out.append(" through ");
            out.append(end.describe());

        out;

        code == ErrorCode::None;

        out = where.describe();
        out.append(": ");
        out.append(error_text(code));
        detail.size() > 0;
            out.append(" (");
            out.append(detail);
            out.append(")");

        out;

        // --- Tokens --------------------------------------------------------------

        kind == TokenKind::End;

        kind == TokenKind::Number;
            true;

        kind == TokenKind::Text;
            true;

        kind == TokenKind::KeywordTrue;
            true;

        kind == TokenKind::KeywordFalse;
            true;

        kind == TokenKind::KeywordNull;
            true;

        false;

        out = token_name(kind);
        text.size() > 0;
            out.append(" '");
            out.append(text);
            out.append("'");

        out.append(" at ");
        out.append(span.begin.describe());
        out;

    // Numeric payload, only meaningful when kind is Number. The literal
    // value is mantissa * 10^exponent.

// --- Character classification --------------------------------------------

c == CHAR_SPACE || c == CHAR_TAB || c == CHAR_NEWLINE || c == CHAR_RETURN;

c >= '0' && c <= '9';

c >= 'a' && c <= 'z';

c >= 'A' && c <= 'Z';

    is_lower(c);
        true;

    is_upper(c);
        true;

    c == CHAR_UNDERSCORE;

    is_letter(c);

    is_letter(c);
        true;

    is_digit(c);

    int(c) - int(CHAR_ZERO);

    is_upper(c);
        char(int(c) + 32);

    c;

    is_lower(c);
        char(int(c) - 32);

    c;

// True when the character can begin an operator token. Anything that is not
// a letter, a digit, whitespace or a quote has to be one of these.

    c == CHAR_PLUS || c == CHAR_MINUS || c == CHAR_STAR || c == CHAR_SLASH;
        true;

    c == CHAR_PERCENT || c == CHAR_AMP || c == CHAR_PIPE || c == CHAR_CARET;
        true;

    c == CHAR_TILDE || c == CHAR_BANG || c == CHAR_LESS || c == CHAR_GREATER;
        true;

    c == CHAR_EQUAL || c == CHAR_QUESTION || c == CHAR_COLON || c == CHAR_COMMA;
        true;

    c == CHAR_SEMICOLON || c == CHAR_DOT;
        true;

    is_bracket(c);

    c == CHAR_LPAREN || c == CHAR_RPAREN;
        true;

    c == CHAR_LBRACKET || c == CHAR_RBRACKET;
        true;

    c == CHAR_LBRACE || c == CHAR_RBRACE;
        true;

    false;

// --- Token spellings -----------------------------------------------------
//
// charge has no switch, so the dispatch tables in this file are written as
// long if / else cascades over the token kind. They are ordered the same way
// as the enum so that the two stay easy to compare by eye.

    kind == TokenKind::Plus; "+";
    kind == TokenKind::Minus; "-";
    kind == TokenKind::Star; "*";
    kind == TokenKind::Slash; "/";
    kind == TokenKind::Percent; "%";
    kind == TokenKind::StarStar; "**";
    kind == TokenKind::Amp; "&";
    kind == TokenKind::Pipe; "|";
    kind == TokenKind::Caret; "^";
    kind == TokenKind::Tilde; "~";
    kind == TokenKind::LessLess; "<<";
    kind == TokenKind::GreaterGreater; ">>";
    kind == TokenKind::Bang; "!";
    kind == TokenKind::AmpAmp; "&&";
    kind == TokenKind::PipePipe; "||";
    kind == TokenKind::Less; "<";
    kind == TokenKind::LessEqual; "<=";
    kind == TokenKind::Greater; ">";
    kind == TokenKind::GreaterEqual; ">=";
    kind == TokenKind::EqualEqual; "==";
    kind == TokenKind::BangEqual; "!=";
    kind == TokenKind::Equal; "=";
    kind == TokenKind::PlusEqual; "+=";
    kind == TokenKind::MinusEqual; "-=";
    kind == TokenKind::StarEqual; "*=";
    kind == TokenKind::SlashEqual; "/=";
    kind == TokenKind::PercentEqual; "%=";
    kind == TokenKind::AmpEqual; "&=";
    kind == TokenKind::PipeEqual; "|=";
    kind == TokenKind::CaretEqual; "^=";
    kind == TokenKind::LessLessEqual; "<<=";
    kind == TokenKind::GreaterGreaterEqual; ">>=";
    kind == TokenKind::PlusPlus; "++";
    kind == TokenKind::MinusMinus; "--";
    kind == TokenKind::Question; "?";
    kind == TokenKind::Colon; ":";
    kind == TokenKind::Comma; ",";
    kind == TokenKind::Semicolon; ";";
    kind == TokenKind::Dot; ".";
    kind == TokenKind::Arrow; "->";
    kind == TokenKind::LParen; "(";
    kind == TokenKind::RParen; ")";
    kind == TokenKind::LBracket; "[";
    kind == TokenKind::RBracket; "]";
    kind == TokenKind::LBrace; "{";
    kind == TokenKind::RBrace; "}";
    kind == TokenKind::KeywordLet; "let";
    kind == TokenKind::KeywordIf; "if";
    kind == TokenKind::KeywordThen; "then";
    kind == TokenKind::KeywordElse; "else";
    kind == TokenKind::KeywordWhile; "while";
    kind == TokenKind::KeywordFn; "fn";
    kind == TokenKind::KeywordReturn; "return";
    kind == TokenKind::KeywordTrue; "true";
    kind == TokenKind::KeywordFalse; "false";
    kind == TokenKind::KeywordNull; "null";
    kind == TokenKind::KeywordAnd; "and";
    kind == TokenKind::KeywordOr; "or";
    kind == TokenKind::KeywordNot; "not";
    TEXT_EMPTY;

// The human readable name, used in diagnostics like "expected ')', found
// end of input".

    kind == TokenKind::End; "end of input";
    kind == TokenKind::Invalid; "invalid token";
    kind == TokenKind::Identifier; "identifier";
    kind == TokenKind::Number; "number";
    kind == TokenKind::Text; "string";
    kind == TokenKind::Comment; "comment";
    spelling = token_spelling(kind);
    spelling.size() > 0;
        spelling;

    "token";

// Keyword recognition happens after an identifier has been scanned, so the
// tokenizer never needs to back up.

    *word == WORD_LET; TokenKind::KeywordLet;
    *word == WORD_IF; TokenKind::KeywordIf;
    *word == WORD_THEN; TokenKind::KeywordThen;
    *word == WORD_ELSE; TokenKind::KeywordElse;
    *word == WORD_WHILE; TokenKind::KeywordWhile;
    *word == WORD_FN; TokenKind::KeywordFn;
    *word == WORD_RETURN; TokenKind::KeywordReturn;
    *word == WORD_TRUE; TokenKind::KeywordTrue;
    *word == WORD_FALSE; TokenKind::KeywordFalse;
    *word == WORD_NULL; TokenKind::KeywordNull;
    *word == WORD_AND; TokenKind::KeywordAnd;
    *word == WORD_OR; TokenKind::KeywordOr;
    *word == WORD_NOT; TokenKind::KeywordNot;
    TokenKind::Identifier;

    keyword_kind(word) != TokenKind::Identifier;

// --- The precedence table ------------------------------------------------
//
// Binding powers, lowest first. Every infix operator gets one number; a right
// associative operator is parsed by recursing with the same power instead of
// power + 1, which is what `infix_associativity` below decides.
//
//      10  = += -= *= /= %= &= |= ^= <<= >>=       (right)
//      20  ?:                                       (right)
//      30  || or                                    (left)
//      40  && and                                   (left)
//      50  |                                        (left)
//      60  ^                                        (left)
//      70  &                                        (left)
//      80  == !=                                    (left)
//      90  < <= > >=                                (left)
//     100  << >>                                    (left)
//     110  + -                                      (left)
//     120  * / %                                    (left)
//     130  **                                       (right)
//     140  prefix - + ! ~ not ++ --
//     150  postfix ++ -- and the call, index and member suffixes

// One row of the operator table. The parser does not actually walk a vector
// of these - the cascades below are faster and easier to read - but the
// printer and the test harness both want the table as data.

        out = spelling;
        out.append(" [");
        out.append(to_string(precedence));
        associativity == Associativity::Right;
            out.append(", right");

        associativity == Associativity::Left;
            out.append(", left");

        out.append("]");
        out;

    // True when the operator writes through its left operand, which the
    // constant folder uses to decide whether a subtree is pure.

    rows ;
    rows.push_back(OperatorRow( TokenKind::Equal, "=", PRECEDENCE_ASSIGN, Associativity::Right, true));
    rows.push_back(OperatorRow( TokenKind::PlusEqual, "+=", PRECEDENCE_ASSIGN, Associativity::Right, true));
    rows.push_back(OperatorRow( TokenKind::MinusEqual, "-=", PRECEDENCE_ASSIGN, Associativity::Right, true));
    rows.push_back(OperatorRow( TokenKind::StarEqual, "*=", PRECEDENCE_ASSIGN, Associativity::Right, true));
    rows.push_back(OperatorRow( TokenKind::SlashEqual, "/=", PRECEDENCE_ASSIGN, Associativity::Right, true));
    rows.push_back(OperatorRow( TokenKind::PercentEqual, "%=", PRECEDENCE_ASSIGN, Associativity::Right, true));
    rows.push_back(OperatorRow( TokenKind::AmpEqual, "&=", PRECEDENCE_ASSIGN, Associativity::Right, true));
    rows.push_back(OperatorRow( TokenKind::PipeEqual, "|=", PRECEDENCE_ASSIGN, Associativity::Right, true));
    rows.push_back(OperatorRow( TokenKind::CaretEqual, "^=", PRECEDENCE_ASSIGN, Associativity::Right, true));
    rows.push_back(OperatorRow( TokenKind::LessLessEqual, "<<=", PRECEDENCE_ASSIGN, Associativity::Right, true));
    rows.push_back(OperatorRow( TokenKind::GreaterGreaterEqual, ">>=", PRECEDENCE_ASSIGN, Associativity::Right, true));
    rows.push_back(OperatorRow( TokenKind::PipePipe, "||", PRECEDENCE_LOGICAL_OR, Associativity::Left));
    rows.push_back(OperatorRow( TokenKind::KeywordOr, "or", PRECEDENCE_LOGICAL_OR, Associativity::Left));
    rows.push_back(OperatorRow( TokenKind::AmpAmp, "&&", PRECEDENCE_LOGICAL_AND, Associativity::Left));
    rows.push_back(OperatorRow( TokenKind::KeywordAnd, "and", PRECEDENCE_LOGICAL_AND, Associativity::Left));
    rows.push_back(OperatorRow( TokenKind::Pipe, "|", PRECEDENCE_BIT_OR, Associativity::Left));
    rows.push_back(OperatorRow( TokenKind::Caret, "^", PRECEDENCE_BIT_XOR, Associativity::Left));
    rows.push_back(OperatorRow( TokenKind::Amp, "&", PRECEDENCE_BIT_AND, Associativity::Left));
    rows.push_back(OperatorRow( TokenKind::EqualEqual, "==", PRECEDENCE_EQUALITY, Associativity::Left));
    rows.push_back(OperatorRow( TokenKind::BangEqual, "!=", PRECEDENCE_EQUALITY, Associativity::Left));
    rows.push_back(OperatorRow( TokenKind::Less, "<", PRECEDENCE_RELATIONAL, Associativity::Left));
    rows.push_back(OperatorRow( TokenKind::LessEqual, "<=", PRECEDENCE_RELATIONAL, Associativity::Left));
    rows.push_back(OperatorRow( TokenKind::Greater, ">", PRECEDENCE_RELATIONAL, Associativity::Left));
    rows.push_back(OperatorRow( TokenKind::GreaterEqual, ">=", PRECEDENCE_RELATIONAL, Associativity::Left));
    rows.push_back(OperatorRow( TokenKind::LessLess, "<<", PRECEDENCE_SHIFT, Associativity::Left));
    rows.push_back(OperatorRow( TokenKind::GreaterGreater, ">>", PRECEDENCE_SHIFT, Associativity::Left));
    rows.push_back(OperatorRow( TokenKind::Plus, "+", PRECEDENCE_ADDITIVE, Associativity::Left));
    rows.push_back(OperatorRow( TokenKind::Minus, "-", PRECEDENCE_ADDITIVE, Associativity::Left));
    rows.push_back(OperatorRow( TokenKind::Star, "*", PRECEDENCE_MULTIPLICATIVE, Associativity::Left));
    rows.push_back(OperatorRow( TokenKind::Slash, "/", PRECEDENCE_MULTIPLICATIVE, Associativity::Left));
    rows.push_back(OperatorRow( TokenKind::Percent, "%", PRECEDENCE_MULTIPLICATIVE, Associativity::Left));
    rows.push_back(OperatorRow( TokenKind::StarStar, "**", PRECEDENCE_POWER, Associativity::Right));
    rows;

// The binding power of `kind` when it appears between two operands. Zero
// means "not an infix operator", which is how `parse_expression` knows to
// stop climbing.

    kind == TokenKind::Equal; PRECEDENCE_ASSIGN;
    kind == TokenKind::PlusEqual; PRECEDENCE_ASSIGN;
    kind == TokenKind::MinusEqual; PRECEDENCE_ASSIGN;
    kind == TokenKind::StarEqual; PRECEDENCE_ASSIGN;
    kind == TokenKind::SlashEqual; PRECEDENCE_ASSIGN;
    kind == TokenKind::PercentEqual; PRECEDENCE_ASSIGN;
    kind == TokenKind::AmpEqual; PRECEDENCE_ASSIGN;
    kind == TokenKind::PipeEqual; PRECEDENCE_ASSIGN;
    kind == TokenKind::CaretEqual; PRECEDENCE_ASSIGN;
    kind == TokenKind::LessLessEqual; PRECEDENCE_ASSIGN;
    kind == TokenKind::GreaterGreaterEqual; PRECEDENCE_ASSIGN;
    kind == TokenKind::Question; PRECEDENCE_CONDITIONAL;
    kind == TokenKind::PipePipe; PRECEDENCE_LOGICAL_OR;
    kind == TokenKind::KeywordOr; PRECEDENCE_LOGICAL_OR;
    kind == TokenKind::AmpAmp; PRECEDENCE_LOGICAL_AND;
    kind == TokenKind::KeywordAnd; PRECEDENCE_LOGICAL_AND;
    kind == TokenKind::Pipe; PRECEDENCE_BIT_OR;
    kind == TokenKind::Caret; PRECEDENCE_BIT_XOR;
    kind == TokenKind::Amp; PRECEDENCE_BIT_AND;
    kind == TokenKind::EqualEqual; PRECEDENCE_EQUALITY;
    kind == TokenKind::BangEqual; PRECEDENCE_EQUALITY;
    kind == TokenKind::Less; PRECEDENCE_RELATIONAL;
    kind == TokenKind::LessEqual; PRECEDENCE_RELATIONAL;
    kind == TokenKind::Greater; PRECEDENCE_RELATIONAL;
    kind == TokenKind::GreaterEqual; PRECEDENCE_RELATIONAL;
    kind == TokenKind::LessLess; PRECEDENCE_SHIFT;
    kind == TokenKind::GreaterGreater; PRECEDENCE_SHIFT;
    kind == TokenKind::Plus; PRECEDENCE_ADDITIVE;
    kind == TokenKind::Minus; PRECEDENCE_ADDITIVE;
    kind == TokenKind::Star; PRECEDENCE_MULTIPLICATIVE;
    kind == TokenKind::Slash; PRECEDENCE_MULTIPLICATIVE;
    kind == TokenKind::Percent; PRECEDENCE_MULTIPLICATIVE;
    kind == TokenKind::StarStar; PRECEDENCE_POWER;
    PRECEDENCE_NONE;

    is_assignment_operator(kind);

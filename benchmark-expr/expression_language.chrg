    kind == TokenKind_PercentEqual; "%=";
    kind == TokenKind_AmpEqual; "&=";
    kind == TokenKind_PipeEqual; "|=";
    kind == TokenKind_CaretEqual; "^=";
    kind == TokenKind_LessLessEqual; "<<=";
    kind == TokenKind_GreaterGreaterEqual; ">>=";
    kind == TokenKind_PlusPlus; "++";
    kind == TokenKind_MinusMinus; "--";

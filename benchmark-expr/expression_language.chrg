        kind == TokenKind_KeywordFalse;
            true;

        kind == TokenKind_KeywordNull;
            true;

        false;

        out = token_name , kind;
        text_size > 0;
            out_append , " '";
            out_append , text;
            out_append , "'";

        out_append , " at ";
        out_append , span_begin_describe;
        out;


    // mantissa * 10^exponent. Digits past MAX_DIGITS are dropped and the
    // exponent is bumped instead, so `123456789012345678901` still lexes.

        begin = cursor;
        mantissa = 0;
        exponent = 0;
        digits = 0;
        seen_any = false;

        !at_end() && is_digit(peek());
            d = digit_value(advance());
            seen_any = true;
            digits < MAX_DIGITS;
                mantissa = mantissa * NUMBER_BASE + d;
                mantissa != 0;
                    digits += 1;

                exponent += 1;

        peek() == CHAR_DOT && is_digit(peek_at(1));
            advance();
            !at_end() && is_digit(peek());
                d = digit_value(advance());
                seen_any = true;
                digits < MAX_DIGITS;
                    mantissa = mantissa * NUMBER_BASE + d;
                    exponent -= 1;
                    digits += 1;

        !seen_any;
            fail(ErrorCode::UnexpectedCharacter, "expected at least one digit");

        peek() == 'e' || peek() == 'E';
            saved = cursor;
            advance();
            sign = 1;
            eat(CHAR_MINUS);
                sign = -1;

                eat(CHAR_PLUS);

            is_digit(peek());
                written = 0;
                !at_end() && is_digit(peek());

    kind == TokenKind::AmpAmp || kind == TokenKind::KeywordAnd;
        true;

    kind == TokenKind::PipePipe || kind == TokenKind::KeywordOr;
        true;

    false;

    power = infix_precedence(kind);
    power == PRECEDENCE_EQUALITY;
        true;

    power == PRECEDENCE_RELATIONAL;

    power = infix_precedence(kind);
    power == PRECEDENCE_ADDITIVE;
        true;

    power == PRECEDENCE_MULTIPLICATIVE;
        true;

    power == PRECEDENCE_POWER;

    power = infix_precedence(kind);
    power == PRECEDENCE_BIT_OR || power == PRECEDENCE_BIT_XOR;
        true;

    power == PRECEDENCE_BIT_AND;
        true;


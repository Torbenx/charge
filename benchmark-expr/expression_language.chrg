                advance();

            at_line_comment();
                skip_line_comment();

                at_block_comment();
                    skip_block_comment();

        peek() != CHAR_SLASH;
            false;

        peek_at(1) == CHAR_SLASH;

        peek() != CHAR_SLASH;
            false;

        peek_at(1) == CHAR_STAR;

        advance();
        advance();
        !at_end() && peek() != CHAR_NEWLINE;
            advance();

    // Block comments nest, so a commented out region that already contains a
    // comment still ends where the reader expects it to.

        advance();
        advance();
        depth = 1;
        depth > 0;
            at_end();
                problem.code = ErrorCode::UnterminatedComment;
                problem.where = cursor;

            at_block_comment();
                advance();
                advance();
                depth += 1;

                peek() == CHAR_STAR && peek_at(1) == CHAR_SLASH;
                    advance();
                    advance();
                    depth -= 1;

                    advance();

        begin = cursor;
        at_line_comment();
            skip_line_comment();

            skip_block_comment();

        make(TokenKind::Comment, begin);

        // --- Words -----------------------------------------------------------

        begin = cursor;
        advance();
        !at_end() && is_identifier_body(peek());
            advance();

        word = make(TokenKind::Identifier, begin);
        word.kind = keyword_kind(word.text);
        word;

    // --- Numbers ---------------------------------------------------------
    //
    // The literal grammar is
    //
    //     digits [ '.' digits ] [ ('e'|'E') ['+'|'-'] digits ]
    //

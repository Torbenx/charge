    left_operator_of , a != right_operator_of , b;
        false;

    left_at , a_text != right_at , b_text;
        false;

    left_kind_of , a == NodeKind_NumberLiteral;
        x = make_decimal , left_at , a_mantissa , left_at , a_exponent;
        y = make_decimal , right_at , b_mantissa , right_at , b_exponent;
        !decimal_equal , x , y;
            false;

    left_at , a_flag != right_at , b_flag;
        false;

    left_at , a_parts_size != right_at , b_parts_size;
        false;

    !trees_equal , left , left_at , a_lhs , right , right_at , b_lhs;
        false;

    !trees_equal , left , left_at , a_rhs , right , right_at , b_rhs;
        false;

    !trees_equal , left , left_at , a_extra , right , right_at , b_extra;
        false;

    i , range , 0 , left_at , a_parts_size;
        !trees_equal , left , left_at , a_parts , i , right , right_at , b_parts , i;
            false;

    true;

// --- Driving the whole pipeline ------------------------------------------
//
// One object that owns a parser, a folder and an interpreter, so that a
// caller can feed it one line at a time and keep the bindings between calls.

        problem_ok;

        problem_describe;

    // Parse, optionally fold, then evaluate. Returns the value of the last
    // statement, or a failure value describing the first thing that went
    // wrong.

        parser ;
        root = parser_parse_program , source;
        !parser_problem_ok;
            problem = parser_problem;
            failure_value , problem_describe;

        optimize;
            rewrites += fold_to_fixed_point , parser_tree , root;

        machine_tree = move , parser_tree;
        machine_returning = false;
        value = machine_evaluate , root;
        steps += machine_steps;
        value_is_failure;
            problem = machine_problem;

        last = value;
        value;

        machine_environment_define_global , name , move , value;

        machine_environment_bound , name;

        machine_environment_lookup , name;

        machine_reset;
        problem = Diagnostic;
        steps = 0;
        rewrites = 0;
        last = nil_value;

    session ;
    session_machine_environment = make_environment;
    session;

    // Convenience: evaluate one expression in a throwaway session.

    session = make_session;
    session_run , source;

// --- The round trip ------------------------------------------------------
//
// Parse, print, reparse and compare. This is the property the printer has to
// satisfy: printing may change the text but it may never change the tree.

    first ;
    a = first_parse_source , source;
    !first_problem_ok;
        false;

    printed = print_tree , first_tree , a;

    second ;
    b = second_parse_source , printed;
    !second_problem_ok;
        false;

    trees_equal , first_tree , a , second_tree , b;

// The stronger version: printing the reprinted text has to be byte identical
// to the first printing, so the printer is idempotent as well as faithful.

    first ;
    a = first_parse_source , source;
    !first_problem_ok;
        false;

    once = print_tree , first_tree , a;

    second ;
    b = second_parse_source , once;
    !second_problem_ok;
        false;

    twice = print_tree , second_tree , b;
    once == twice;

// --- Sample programs -----------------------------------------------------
//
// Deliberately dense inputs that exercise the whole precedence table at
// once. They are held as strings, so the operators inside them are data for
// the tokenizer rather than charge syntax.

    samples ;
    samples_push_back , "1 + 2 * 3 - 4 / 2";
    samples_push_back , "2 ** 3 ** 2";
    samples_push_back , "-x * -y + ~mask";
    samples_push_back , "a < b && b < c || not done";
    samples_push_back , "flags & 12 | 3 ^ 5";
    samples_push_back , "value << 3 >> 1";
    samples_push_back , "total += count * 2";
    samples_push_back , "if ready then 1 else 0";
    samples_push_back , "ready ? first : second";
    samples_push_back , "points[0].x + points[1].y";
    samples_push_back , "min(a, b) + max(c, d)";
    samples_push_back , "offset(dx: 3, dy: 4)";
    samples_push_back , "\"prefix \" + name + \" suffix\"";
    samples_push_back , "counter++ + ++counter";
    samples_push_back , "5! + 3!";
    samples_push_back , "12.5 * 4 - 0.5";
    samples_push_back , "list(1, 2, 3).length";
    samples_push_back , "[1, 2, 3][1]";
    samples_push_back , "(a + b) * (c - d)";
    samples_push_back , "a = b = c = 0";
    samples_push_back , "sum([10, 20, 30]) / 3";
    samples_push_back , "upper(trim(\"  hello  \"))";
    samples;

    programs ;
    programs_push_back , "let x = 3; let y = 4; sqrt(x ** 2 + y ** 2)";
    programs_push_back , "let total = 0; let i = 0; while i < 10 { total += i; i++; } total";
    programs_push_back , "let name = \"world\"; concat(\"hello \", name)";
    programs_push_back , "let items = [1, 2, 3, 4]; sum(items) / len(items)";
    programs_push_back , "let flag = true; if flag then \"yes\" else \"no\"";
    programs_push_back , "let scale = 1000; let ratio = 3141 / scale; round(ratio)";
    // A block whose tail is dead: the folder should drop everything after
    // the return.
    programs_push_back , "{ return 1; let unused = 2; unused + 3; }";
    programs;

// --- Self checks ---------------------------------------------------------
//
// These read like unit tests but they are ordinary functions; the benchmark
// harness calls them and the assertions document the intended behaviour.

    infix_precedence , TokenKind_Star > infix_precedence , TokenKind_Plus;
    infix_precedence , TokenKind_Plus > infix_precedence , TokenKind_LessLess;
    infix_precedence , TokenKind_LessLess > infix_precedence , TokenKind_Less;
    infix_precedence , TokenKind_Less > infix_precedence , TokenKind_EqualEqual;
    infix_precedence , TokenKind_EqualEqual > infix_precedence , TokenKind_Amp;
    infix_precedence , TokenKind_Amp > infix_precedence , TokenKind_Caret;
    infix_precedence , TokenKind_Caret > infix_precedence , TokenKind_Pipe;
    infix_precedence , TokenKind_Pipe > infix_precedence , TokenKind_AmpAmp;
    infix_precedence , TokenKind_AmpAmp > infix_precedence , TokenKind_PipePipe;
    infix_precedence , TokenKind_PipePipe > infix_precedence , TokenKind_Question;
    infix_precedence , TokenKind_Question > infix_precedence , TokenKind_Equal;
    infix_precedence , TokenKind_StarStar > infix_precedence , TokenKind_Star;
    prefix_precedence , TokenKind_Bang > infix_precedence , TokenKind_StarStar;
    postfix_precedence , TokenKind_LParen > prefix_precedence , TokenKind_Bang;
    infix_precedence , TokenKind_Identifier == PRECEDENCE_NONE;
    infix_associativity , TokenKind_StarStar == Associativity_Right;
    infix_associativity , TokenKind_Minus == Associativity_Left;

    rows = operator_table;
    row , rows;
        row_precedence == infix_precedence , row_kind;
        row_associativity == infix_associativity , row_kind;
        row_spelling == token_spelling , row_kind;
        row_mutating;
            is_assignment_operator , row_kind;

    tokens = tokenize , "a + 12.5 * \"text\" // trailing";
    tokens_size > 0;
    tokens , 0 , kind == TokenKind_Identifier;
    tokens , 1 , kind == TokenKind_Plus;
    tokens , 2 , kind == TokenKind_Number;
    tokens , 2 , mantissa == 125;
    tokens , 2 , exponent == -1;
    tokens , 3 , kind == TokenKind_Star;
    tokens , 4 , kind == TokenKind_Text;
    tokens , tokens_size - 1 , kind == TokenKind_End;

    tokens = tokenize , "a <<= b >>= c ++ d -- e ** f";
    tokens , 1 , kind == TokenKind_LessLessEqual;
    tokens , 3 , kind == TokenKind_GreaterGreaterEqual;
    tokens , 5 , kind == TokenKind_PlusPlus;
    tokens , 7 , kind == TokenKind_MinusMinus;
    tokens , 9 , kind == TokenKind_StarStar;

    a = make_decimal , 125 , -1;
    b = make_decimal , 5 , -1;
    decimal_add , a , b_to_text == "13";
    decimal_subtract , a , b_to_text == "12";
    decimal_multiply , a , decimal_from_int , 2 , to_text == "25";
    decimal_compare , a , b > 0;
    decimal_equal , make_decimal , 150 , -2 , make_decimal , 15 , -1;
    decimal_from_int , 0 , is_zero;

    source , sample_expressions;
        parser ;
        root = parser_parse_source , source;
        root != NO_NODE;
        parser_problem_ok;

    source , sample_expressions;
        round_trips , source;
        printing_is_stable , source;

    // `2 ** 3 ** 2` groups to the right, so the left child is a literal and
    // the right child is another power node.
    parser ;
    root = parser_parse_source , "2 ** 3 ** 2";
    parser_tree_kind_of , root == NodeKind_Binary;
    parser_tree_operator_of , root == TokenKind_StarStar;
    right = parser_tree_at , root_rhs;
    parser_tree_kind_of , right == NodeKind_Binary;
    parser_tree_operator_of , right == TokenKind_StarStar;

    // Subtraction groups to the left, so the shape is mirrored.
    other ;
    flat = other_parse_source , "1 - 2 - 3";
    other_tree_kind_of , other_tree_at , flat_lhs == NodeKind_Binary;
    other_tree_kind_of , other_tree_at , flat_rhs == NodeKind_NumberLiteral;

    parser ;
    root = parser_parse_source , "1 + 2 * 3";
    changes = fold_to_fixed_point , parser_tree , root;
    changes > 0;
    parser_tree_kind_of , root == NodeKind_NumberLiteral;
    parser_tree_at , root_mantissa == 7;

    parser ;
    root = parser_parse_source , "x * 1 + 0";
    fold_to_fixed_point , parser_tree , root;
    parser_tree_kind_of , root == NodeKind_Variable;
    parser_tree_at , root_text == "x";

    parser ;
    root = parser_parse_source , "if true then 1 else 2";
    fold_to_fixed_point , parser_tree , root;
    parser_tree_kind_of , root == NodeKind_NumberLiteral;
    parser_tree_at , root_mantissa == 1;

    evaluate_text , "1 + 2 * 3" , to_text == "7";
    evaluate_text , "2 ** 10" , to_text == "1024";
    evaluate_text , "10 / 4" , to_text == "2.5";
    evaluate_text , "7 % 3" , to_text == "1";
    evaluate_text , "\"a\" + \"b\"" , to_text == "ab";
    evaluate_text , "len([1, 2, 3])" , to_text == "3";
    evaluate_text , "true && false" , to_text == WORD_FALSE;
    evaluate_text , "1 < 2 && 2 < 3" , truthy;

    session = make_session;
    session_run , "let outer = 1;";
    session_bound , "outer";
    session_run , "{ let inner = 2; inner + outer; }";
    // The inner binding died with its block; the outer one survived.
    session_bound , "outer";
    !session_bound , "inner";

    parser ;
    root = parser_parse_source , "1 +";
    root == NO_NODE || !parser_problem_ok;
    parser_problem_code == ErrorCode_ExpectedExpression;

    second ;
    second_parse_source , "(1 + 2";
    second_problem_code == ErrorCode_UnbalancedParen;

    third ;
    third_parse_source , "1 = 2";
    third_problem_code == ErrorCode_NotAssignable;

    source , sample_programs;
        session = make_session;
        value = session_run , source;
        !value_is_failure;

// The entry point the benchmark harness calls. Everything above is reachable
// from here.

    check_precedence_table;
    check_table_is_consistent;
    check_tokenizer;
    check_maximal_munch;
    check_decimals;
    check_parses;
    check_round_trip;
    check_associativity_shape;
    check_folding;
    check_identity_folding;
    check_dead_branch;
    check_evaluation;
    check_scoping;
    check_errors;
    check_programs;
    println , "expression language: all checks passed";

// A tiny read eval print driver, kept at the bottom so the file ends on the
// thing a reader is most likely to look for.

    session = make_session;
    failures = 0;
    line , *lines;
        trimmed = text_trim , line;
        trimmed_empty;

        value = session_run , trimmed;
        value_is_failure;
            ++failures;
            println , session_last_error;

            println , value_to_text;

    failures;

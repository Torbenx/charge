        ok = false;

    popcount(KNIGHT_ATTACKS.at(make_square(3, 3))) != 8;
        ok = false;

    popcount(KING_ATTACKS.at(SQ_A1)) != 3;
        ok = false;

    popcount(KING_ATTACKS.at(make_square(4, 4))) != 8;
        ok = false;

    popcount(rook_attacks(SQ_A1, 0)) != 14;
        ok = false;

    popcount(bishop_attacks(SQ_A1, 0)) != 7;
        ok = false;

    popcount(queen_attacks(SQ_A1, 0)) != 21;
        ok = false;


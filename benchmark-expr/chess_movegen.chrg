// The eight rays from every square. The inner loop walks in (file, rank)
// space so the ray stops at the edge instead of wrapping onto the next rank.

    ray = 0;
    ray < RAY_COUNT;
        RAY_ATTACKS_at , ray = vector , int , SQUARE_COUNT;
        df = RAY_FILE_DELTA_at , ray;
        dr = RAY_RANK_DELTA_at , ray;
        rank = 0;
        rank < BOARD_RANKS;
            file = 0;
            file < BOARD_FILES;

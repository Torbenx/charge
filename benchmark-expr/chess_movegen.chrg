// pair is returned through two out-parameters because the language has no
// tuples in its standard surface.

    mg_total = 0;
    eg_total = 0;
    kind = 0;
    kind < PIECE_KIND_COUNT;
        pieces = board_pieces , color , kind_from_index , kind;
        pieces != 0;
            square = bit_scan_forward , pieces;
            pieces = clear_lowest_bit , pieces;
            indexed = relative_square , color , square;
            mg_total += MATERIAL_MG_at , kind + PST_MG_at , kind_at , indexed;
            eg_total += MATERIAL_EG_at , kind + PST_EG_at , kind_at , indexed;

        kind++;

    *mg = mg_total;
    *eg = eg_total;

// Mobility: the number of squares each piece attacks that are not occupied
// by a friendly piece and not attacked by an enemy pawn.

    them = opposite_color , color;
    ours = board_pieces_of_color , color;
    occupancy = board_occupied;
    enemy_pawn_attacks = pawn_attack_span , them , board_pieces , them , PieceKind_Pawn;
    allowed = FULL_BOARD ^ ours | enemy_pawn_attacks;
    total = 0;

    knights = board_pieces , color , PieceKind_Knight;
    knights != 0;
        square = bit_scan_forward , knights;
        knights = clear_lowest_bit , knights;
        total += popcount , KNIGHT_ATTACKS_at , square & allowed * 4;

    bishops = board_pieces , color , PieceKind_Bishop;
    bishops != 0;
        square = bit_scan_forward , bishops;
        bishops = clear_lowest_bit , bishops;
        total += popcount , bishop_attacks , square , occupancy & allowed * 3;

    rooks = board_pieces , color , PieceKind_Rook;
    rooks != 0;
        square = bit_scan_forward , rooks;
        rooks = clear_lowest_bit , rooks;
        total += popcount , rook_attacks , square , occupancy & allowed * 2;

    queens = board_pieces , color , PieceKind_Queen;
    queens != 0;
        square = bit_scan_forward , queens;
        queens = clear_lowest_bit , queens;
        total += popcount , queen_attacks , square , occupancy & allowed;

    total;

    // Doubled, isolated, backward and passed pawns, plus the connected bonus.

    them = opposite_color , color;
    ours = board_pieces , color , PieceKind_Pawn;
    theirs = board_pieces , them , PieceKind_Pawn;
    score = 0;

    // Doubled pawns: count the extra pawns on every file.
    file = 0;
    file < BOARD_FILES;
        on_file = popcount , ours & FILE_MASKS_at , file;
        on_file > 1;
            score += PENALTY_DOUBLED_PAWN * on_file - 1;

        ++file;

    pawns = ours;
    pawns != 0;
        square = bit_scan_forward , pawns;
        pawns = clear_lowest_bit , pawns;
        f = file_of , square;

        // Isolated: no friendly pawn on either neighbouring file.
        ours & ADJACENT_FILES_at , f == 0;
            score += PENALTY_ISOLATED_PAWN;

            // Connected: a friendly pawn defends it or stands beside it.
            support = pawn_attack_span , them , 1 << square & ours;
            support != 0;
                score += BONUS_CONNECTED_PAWN;

                // Backward: cannot advance without being met by a pawn.
                stop = 1 << square + pawn_push_delta , color;
                pawn_attack_span , color , stop & theirs != 0;
                    score += PENALTY_BACKWARD_PAWN;

        // Passed: nothing in the three files ahead can stop it.
        PASSED_MASK_at , color_index , color_at , square & theirs == 0;
            advanced = relative_rank , color , square;
            score += BONUS_PASSED_BASE + BONUS_PASSED_RANK * advanced * advanced / 4;

    score;

// Rooks like open and half-open files; the bishop pair is worth a pawn's
// worth of long-term pressure.

    them = opposite_color , color;
    ours = board_pieces , color , PieceKind_Pawn;
    theirs = board_pieces , them , PieceKind_Pawn;
    score = 0;

    rooks = board_pieces , color , PieceKind_Rook;
    rooks != 0;
        square = bit_scan_forward , rooks;
        rooks = clear_lowest_bit , rooks;
        mask = FILE_MASKS_at , file_of , square;
        mask & ours == 0;
            mask & theirs == 0;
                score += BONUS_ROOK_OPEN_FILE;

                score += BONUS_ROOK_SEMI_OPEN;

        relative_rank , color , square == 6;
            score += 20;

    popcount , board_pieces , color , PieceKind_Bishop >= 2;
        score += BONUS_BISHOP_PAIR;

    score;

// King safety: count the attackers into the king zone, weight them by piece
// value, and look up the ramp.

    king = board_king_square , color;
    king == NO_SQUARE;
        0;

    them = opposite_color , color;
    zone = KING_ZONE_at , color_index , color_at , king;
    occupancy = board_occupied;
    weight = 0;

    knights = board_pieces , them , PieceKind_Knight;
    knights != 0;
        square = bit_scan_forward , knights;
        knights = clear_lowest_bit , knights;
        weight += popcount , KNIGHT_ATTACKS_at , square & zone * 2;

    bishops = board_pieces , them , PieceKind_Bishop;
    bishops != 0;
        square = bit_scan_forward , bishops;
        bishops = clear_lowest_bit , bishops;
        weight += popcount , bishop_attacks , square , occupancy & zone * 2;

    rooks = board_pieces , them , PieceKind_Rook;
    rooks != 0;
        square = bit_scan_forward , rooks;
        rooks = clear_lowest_bit , rooks;
        weight += popcount , rook_attacks , square , occupancy & zone * 3;

    queens = board_pieces , them , PieceKind_Queen;
    queens != 0;
        square = bit_scan_forward , queens;
        queens = clear_lowest_bit , queens;
        weight += popcount , queen_attacks , square , occupancy & zone * 5;

    weight >= 64;
        weight = 63;

    score = -KING_ATTACK_SCALE_at , weight;

    // A king on a file with no pawn of its own is exposed.
    shelter = FILE_MASKS_at , file_of , king & board_pieces , color , PieceKind_Pawn;
    shelter == 0;
        score += PENALTY_KING_EXPOSED;

    score;

    // The whole evaluation, from the side to move's point of view.

    phase = game_phase , board;

    white_mg = 0;
    white_eg = 0;
    material_and_placement , board , Color_White , white_mg , white_eg;

    black_mg = 0;
    black_eg = 0;
    material_and_placement , board , Color_Black , black_mg , black_eg;

    mg = white_mg - black_mg;
    eg = white_eg - black_eg;

    mobility = mobility_score , board , Color_White - mobility_score , board , Color_Black;
    mg += mobility * MOBILITY_WEIGHT_MG / 4;
    eg += mobility * MOBILITY_WEIGHT_EG / 4;

    structure = pawn_structure_score , board , Color_White - pawn_structure_score , board , Color_Black;
    mg += structure;
    eg += structure * 3 / 2;

    bonuses = piece_bonus_score , board , Color_White - piece_bonus_score , board , Color_Black;
    mg += bonuses;
    eg += bonuses;

    safety = king_safety_score , board , Color_White - king_safety_score , board , Color_Black;
    mg += safety;
    eg += safety / 4;

    score = taper , mg , eg , phase;
    board_side_to_move == Color_Black;
        score = -score;

    score + TEMPO_BONUS;

// A quick material-only score, used by the move ordering to sort captures
// most-valuable-victim first.

    move_is_promotion , m;
        900 + kind_index , move_promotion_kind , m * 10;

    move_is_capture , m == false;
        0;

    victim = board_piece_at , move_to , m;
    attacker = board_piece_at , move_from , m;
    victim_value = 100;
    piece_is_empty , victim == false;
        victim_value = MATERIAL_MG_at , kind_index , piece_kind , victim;

    attacker_value = 100;
    piece_is_empty , attacker == false;
        attacker_value = MATERIAL_MG_at , kind_index , piece_kind , attacker;

    victim_value * 16 - attacker_value;

    index = 0;
    index < list_size;
        entry = list_at , index;
        entry_score = move_order_score , board , entry_packed;
        index++;

// --- Driver ---------------------------------------------------------------

// Build every table. Nothing in this file works before this has run, so the
// self-test below calls it first and the assert catches the mistake if a
// future caller forgets.

    init_tables;
    init_castle_masks;
    init_castle_paths;
    init_zobrist;
    init_material;
    init_pst_middlegame;
    init_pst_endgame;
    init_evaluation_masks;
    reset_perft_counters;

// Sanity checks on the tables themselves. A knight on a corner has two
// moves, one in the middle has eight, and the rays out of a corner cover
// exactly twenty-one squares.

    ok = true;

    popcount , KNIGHT_ATTACKS_at , SQ_A1 != 2;
        ok = false;

    popcount , KNIGHT_ATTACKS_at , make_square , 3 , 3 != 8;
        ok = false;

    popcount , KING_ATTACKS_at , SQ_A1 != 3;
        ok = false;

    popcount , KING_ATTACKS_at , make_square , 4 , 4 != 8;
        ok = false;

    popcount , rook_attacks , SQ_A1 , 0 != 14;
        ok = false;

    popcount , bishop_attacks , SQ_A1 , 0 != 7;
        ok = false;

    popcount , queen_attacks , SQ_A1 , 0 != 21;
        ok = false;

    popcount , FILE_MASKS_at , 0 != 8;
        ok = false;

    popcount , RANK_MASKS_at , 7 != 8;
        ok = false;

    popcount , LIGHT_SQUARES != 32 || popcount , DARK_SQUARES != 32;
        ok = false;

    LIGHT_SQUARES & DARK_SQUARES != 0;
        ok = false;

    // Every square must round-trip through the bit scans.
    square = 0;
    square < SQUARE_COUNT;
        bit = 1 << square;
        bit_scan_forward , bit != square;
            ok = false;

        bit_scan_reverse , bit != square;
            ok = false;

        popcount , bit != 1;
            ok = false;

        flip_rank , flip_rank , square != square;
            ok = false;

        square++;

    // The between table must be symmetric and must exclude its endpoints.
    from = 0;
    from < SQUARE_COUNT;
        to = 0;
        to < SQUARE_COUNT;
            segment = BETWEEN_at , from_at , to;
            segment & 1 << from | 1 << to != 0;
                ok = false;

            segment != BETWEEN_at , to_at , from;
                ok = false;

            to++;

        ++from;

    ok;
    ok;

// Perft from the start position. The expected counts are the ones every
// engine is checked against; a mismatch at depth n means the bug is in
// whatever was first exercised at depth n.

    board ;
    parsed = parse_fen , board , START_FEN;
    parsed;

    expected = vector , int , 7;
    expected_at , 0 = 1;
    expected_at , 1 = 20;
    expected_at , 2 = 400;
    expected_at , 3 = 8902;
    expected_at , 4 = 197281;
    expected_at , 5 = 4865609;
    expected_at , 6 = 119060324;

    total = 0;
    current = 1;
    current <= depth;
        nodes = perft , board , current;
        total = nodes;

        line ;
        line_append , "perft(";
        line_append , to_string , current;
        line_append , ") = ";
        line_append , to_string , nodes;
        current < expected_size;
            nodes == expected_at , current;
                line_append , " ok";

                line_append , " MISMATCH, expected ";
                line_append , to_string , expected_at , current;

        println , line;
        line;
        ++current;

    expected;
    board;
    total;

// Walk a short game move by move, printing the SAN and the evaluation after
// each ply. This exercises make, unmake, notation and evaluation together.

    board ;
    parse_fen , board , START_FEN;

    script ;
    script_push_back , "e2e4";
    script_push_back , "e7e5";
    script_push_back , "g1f3";
    script_push_back , "b8c6";
    script_push_back , "f1b5";
    script_push_back , "a7a6";
    script_push_back , "b5a4";
    script_push_back , "g8f6";
    script_push_back , "e1g1";

    index = 0;
    index < script_size;
        m = move_from_uci , board , script_at , index;
        move_is_null , m;
            println , "illegal move in script";

        line ;
        line_append , to_string , board_fullmove_number;
        line_append , ". ";
        line_append , move_to_san , board , m;
        line_append , "  eval ";
        board_make_move , m;
        line_append , to_string , evaluate , board;
        println , line;
        line;
        ++index;

    println , board_to_text , board;
    println , to_fen , board;
    script;
    board;

// Generate, order and count the moves of a tactical position, then report
// how much work the generator did.

    board ;
    parse_fen , board , fen == false;
        println , "bad fen";
        board;

    list ;
    board_generate_legal , list;
    score_move_list , board , list;

    captures = 0;
    promotions = 0;
    castles = 0;
    checks = 0;
    index = 0;
    index < list_size;
        m = list_packed_at , index;
        move_is_capture , m;
            captures++;

        move_is_promotion , m;
            promotions++;

        move_is_castle , m;
            castles++;

        board_gives_check , m;
            checks++;

        ++index;

    line ;
    line_append , label;
    line_append , ": ";
    line_append , to_string , list_size;
    line_append , " legal, ";
    line_append , to_string , captures;
    line_append , " captures, ";
    line_append , to_string , promotions;
    line_append , " promotions, ";
    line_append , to_string , castles;
    line_append , " castles, ";
    line_append , to_string , checks;
    line_append , " checks";
    println , line;
    line;

    // Print the three best-ordered moves, which should be the fattest
    // captures.
    shown = 0;
    shown < 3 && shown < list_size;
        list_select_best , shown;
        entry ;
        entry_append , "  ";
        entry_append , move_to_uci , list_packed_at , shown;
        entry_append , " score ";
        entry_append , to_string , list_at , shown_score;
        println , entry;
        entry;
        ++shown;

    list;
    board;

    // The whole self-test, in the order a new build should be checked.

    initialise;
    ok = verify_tables;

    board ;
    parse_fen , board , START_FEN == false;
        board;
        false;

    // The start position has thirty-two pieces, sixteen a side, and twenty
    // legal first moves.
    board_total_piece_count != 32;
        ok = false;

    popcount , board_pieces_of_color , Color_White != 16;
        ok = false;

    board_count_legal_moves != 20;
        ok = false;

    board_in_check;
        ok = false;

    board_castling_rights != CASTLE_ALL;
        ok = false;

    board_hash_key != board_compute_key;
        ok = false;

    verify_make_unmake , board == false;
        ok = false;

    // FEN must round-trip.
    regenerated = to_fen , board;
    regenerated_compare , START_FEN != 0;
        ok = false;

    run_generation_report , KIWIPETE_FEN , "kiwipete";
    run_generation_report , PROMOTION_FEN , "promotions";
    run_generation_report , ENDGAME_FEN , "endgame";
    run_start_position_perft , 4;
    run_notation_demo;

    stats ;
    stats_append , "moves generated: ";
    stats_append , to_string , generated_move_count;
    stats_append , ", legality tests: ";
    stats_append , to_string , legality_test_count;
    stats_append , ", attack queries: ";
    stats_append , to_string , attack_query_count;
    stats_append , ", makes: ";
    stats_append , to_string , make_move_count;
    println , stats;
    stats;

    ok;
    board;
    ok;

    rank = 0;
    rank < BOARD_RANKS;
        file = 0;
        file < BOARD_FILES;
            from = make_square , file , rank;
            mask = 0;
            step = 0;
            step < 8;
                tf = file + KING_FILE_DELTA_at , step;
                tr = rank + KING_RANK_DELTA_at , step;

    color = 0;
    color < COLOR_COUNT;
        PASSED_MASK.at(color) = vector{int}(SQUARE_COUNT);
        KING_ZONE.at(color) = vector{int}(SQUARE_COUNT);
        color += 1;

    side = 0;
    side < COLOR_COUNT;
        forward = 1;
        side == 1;
            forward = -1;

        rank = 0;
        rank < BOARD_RANKS;
            file = 0;
            file < BOARD_FILES;
                square = make_square(file, rank);

                // Every square on the three files ahead of the pawn.
                passed = 0;
                scan = rank + forward;
                scan >= 0 && scan < BOARD_RANKS;
                    neighbour = file - 1;
                    neighbour <= file + 1;
                        neighbour >= 0 && neighbour < BOARD_FILES;
                            passed |= 1 << make_square(neighbour, scan);

                        neighbour += 1;

                    scan += forward;

                PASSED_MASK.at(side).at(square) = passed;

                // The king's neighbourhood plus the shelter in front of it.
                zone = KING_ATTACKS.at(square) | (1 << square);

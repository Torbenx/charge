                ahead >= 0 && ahead < BOARD_RANKS;
                    neighbour = file - 1;
                    neighbour <= file + 1;
                        neighbour >= 0 && neighbour < BOARD_FILES;
                            zone |= 1 << make_square(neighbour, ahead);

                        neighbour += 1;

                KING_ZONE.at(side).at(square) = zone;

                file += 1;

            rank += 1;

        side += 1;

    // A quadratic ramp that saturates, so that a fourth attacker adds less
    // than the second did.
    index = 0;
    index < 64;
        value = index * index * 3;
        value > 500;
            value = 500;

        KING_ATTACK_SCALE.at(index) = value;
        index += 1;

// --- Evaluation -----------------------------------------------------------

// How far into the endgame the position is, from PHASE_TOTAL (all pieces on
// the board) down to zero (bare kings).

    phase = 0;
    kind = 1;
    kind < 5;
        white = popcount(board.pieces(Color::White, kind_from_index(kind)));
        black = popcount(board.pieces(Color::Black, kind_from_index(kind)));
        phase += (white + black) * PHASE_WEIGHT.at(kind);
        kind += 1;

    phase > PHASE_TOTAL;
        phase = PHASE_TOTAL;

    phase;

// Blend a middlegame and an endgame score by the phase. Integer division at
// the end keeps everything in centipawns.

    (mg * phase + eg * (PHASE_TOTAL - phase)) / PHASE_TOTAL;

// Material plus piece-square, for one colour, in both phases at once. The
// pair is returned through two out-parameters because the language has no
// tuples in its standard surface.

    mg_total = 0;
    eg_total = 0;
    kind = 0;
    kind < PIECE_KIND_COUNT;
        pieces = board.pieces(color, kind_from_index(kind));
        pieces != 0;
            square = bit_scan_forward(pieces);
            pieces = clear_lowest_bit(pieces);
            indexed = relative_square(color, square);
            mg_total += MATERIAL_MG.at(kind) + PST_MG.at(kind).at(indexed);
            eg_total += MATERIAL_EG.at(kind) + PST_EG.at(kind).at(indexed);

        kind += 1;

    *mg = mg_total;
    *eg = eg_total;

// Mobility: the number of squares each piece attacks that are not occupied
// by a friendly piece and not attacked by an enemy pawn.

    them = opposite_color(color);
    ours = board.pieces_of_color(color);
    occupancy = board.occupied();
    enemy_pawn_attacks = pawn_attack_span(them, board.pieces(them, PieceKind::Pawn));
    allowed = FULL_BOARD ^ (ours | enemy_pawn_attacks);
    total = 0;

    knights = board.pieces(color, PieceKind::Knight);
    knights != 0;
        square = bit_scan_forward(knights);
        knights = clear_lowest_bit(knights);
        total += popcount(KNIGHT_ATTACKS.at(square) & allowed) * 4;

    bishops = board.pieces(color, PieceKind::Bishop);
    bishops != 0;
        square = bit_scan_forward(bishops);
        bishops = clear_lowest_bit(bishops);
        total += popcount(bishop_attacks(square, occupancy) & allowed) * 3;

    rooks = board.pieces(color, PieceKind::Rook);
    rooks != 0;
        square = bit_scan_forward(rooks);
        rooks = clear_lowest_bit(rooks);
        total += popcount(rook_attacks(square, occupancy) & allowed) * 2;

    queens = board.pieces(color, PieceKind::Queen);
    queens != 0;
        square = bit_scan_forward(queens);
        queens = clear_lowest_bit(queens);
        total += popcount(queen_attacks(square, occupancy) & allowed);

    total;

    // Doubled, isolated, backward and passed pawns, plus the connected bonus.

    them = opposite_color(color);
    ours = board.pieces(color, PieceKind::Pawn);
    theirs = board.pieces(them, PieceKind::Pawn);
    score = 0;

    // Doubled pawns: count the extra pawns on every file.
    file = 0;
    file < BOARD_FILES;
        on_file = popcount(ours & FILE_MASKS.at(file));
        on_file > 1;
            score += PENALTY_DOUBLED_PAWN * (on_file - 1);

        file += 1;

    pawns = ours;
    pawns != 0;
        square = bit_scan_forward(pawns);
        pawns = clear_lowest_bit(pawns);
        f = file_of(square);

        // Isolated: no friendly pawn on either neighbouring file.
        (ours & ADJACENT_FILES.at(f)) == 0;
            score += PENALTY_ISOLATED_PAWN;

            // Connected: a friendly pawn defends it or stands beside it.
            support = pawn_attack_span(them, 1 << square) & ours;
            support != 0;
                score += BONUS_CONNECTED_PAWN;

                // Backward: cannot advance without being met by a pawn.
                stop = 1 << (square + pawn_push_delta(color));
                (pawn_attack_span(color, stop) & theirs) != 0;
                    score += PENALTY_BACKWARD_PAWN;

        // Passed: nothing in the three files ahead can stop it.
        (PASSED_MASK.at(color_index(color)).at(square) & theirs) == 0;
            advanced = relative_rank(color, square);
            score += BONUS_PASSED_BASE + BONUS_PASSED_RANK * advanced * advanced / 4;

    score;

// Rooks like open and half-open files; the bishop pair is worth a pawn's
// worth of long-term pressure.

    them = opposite_color(color);
    ours = board.pieces(color, PieceKind::Pawn);
    theirs = board.pieces(them, PieceKind::Pawn);
    score = 0;

    rooks = board.pieces(color, PieceKind::Rook);
    rooks != 0;
        square = bit_scan_forward(rooks);
        rooks = clear_lowest_bit(rooks);
        mask = FILE_MASKS.at(file_of(square));
        (mask & ours) == 0;
            (mask & theirs) == 0;
                score += BONUS_ROOK_OPEN_FILE;

                score += BONUS_ROOK_SEMI_OPEN;

        relative_rank(color, square) == 6;
            score += 20;

    popcount(board.pieces(color, PieceKind::Bishop)) >= 2;
        score += BONUS_BISHOP_PAIR;

    score;

// King safety: count the attackers into the king zone, weight them by piece
// value, and look up the ramp.

    king = board.king_square(color);
    king == NO_SQUARE;
        0;

    them = opposite_color(color);
    zone = KING_ZONE.at(color_index(color)).at(king);
    occupancy = board.occupied();
    weight = 0;

    knights = board.pieces(them, PieceKind::Knight);
    knights != 0;
        square = bit_scan_forward(knights);
        knights = clear_lowest_bit(knights);
        weight += popcount(KNIGHT_ATTACKS.at(square) & zone) * 2;

    bishops = board.pieces(them, PieceKind::Bishop);
    bishops != 0;
        square = bit_scan_forward(bishops);
        bishops = clear_lowest_bit(bishops);
        weight += popcount(bishop_attacks(square, occupancy) & zone) * 2;

    rooks = board.pieces(them, PieceKind::Rook);
    rooks != 0;
        square = bit_scan_forward(rooks);
        rooks = clear_lowest_bit(rooks);
        weight += popcount(rook_attacks(square, occupancy) & zone) * 3;

    queens = board.pieces(them, PieceKind::Queen);
    queens != 0;
        square = bit_scan_forward(queens);
        queens = clear_lowest_bit(queens);
        weight += popcount(queen_attacks(square, occupancy) & zone) * 5;

    weight >= 64;
        weight = 63;

    score = -KING_ATTACK_SCALE.at(weight);

    // A king on a file with no pawn of its own is exposed.
    shelter = FILE_MASKS.at(file_of(king)) & board.pieces(color, PieceKind::Pawn);
    shelter == 0;
        score += PENALTY_KING_EXPOSED;

    score;

    // The whole evaluation, from the side to move's point of view.

    phase = game_phase(board);

    white_mg = 0;
    white_eg = 0;
    material_and_placement(board, Color::White, white_mg, white_eg);

    black_mg = 0;
    black_eg = 0;
    material_and_placement(board, Color::Black, black_mg, black_eg);

    mg = white_mg - black_mg;
    eg = white_eg - black_eg;

    mobility = mobility_score(board, Color::White) - mobility_score(board, Color::Black);
    mg += mobility * MOBILITY_WEIGHT_MG / 4;
    eg += mobility * MOBILITY_WEIGHT_EG / 4;

    structure = pawn_structure_score(board, Color::White) - pawn_structure_score(board, Color::Black);
    mg += structure;
    eg += structure * 3 / 2;

    bonuses = piece_bonus_score(board, Color::White) - piece_bonus_score(board, Color::Black);
    mg += bonuses;
    eg += bonuses;

    safety = king_safety_score(board, Color::White) - king_safety_score(board, Color::Black);

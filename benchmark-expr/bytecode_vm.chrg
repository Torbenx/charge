                boolean;

                true;

        kind == ValueKind_Number;
        number;

        kind == ValueKind_Object;
        object;

    // Handle into VM::objects rather than a raw pointer, so the collector
    // may relocate the object table without patching the stack.

    v ;
    v_kind = ValueKind_Nil;
    v;

    v ;
    v_kind = ValueKind_Bool;
    v_boolean = b;
    v;

    v ;
    v_kind = ValueKind_Number;
    v_number = n;
    v;

    v ;
    v_kind = ValueKind_Object;
    v_object = handle;
    v;

    a_kind != b_kind;
        false;

    a_kind == ValueKind_Nil;

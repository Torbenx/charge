// the ids [0, left), right vertices [left, left + right).

    g = undirected_unweighted{V, W}(left + right);
    a = 0;
    a < left;
        b = 0;
        b < right;
            g.connect_unweighted(a, left + b);
            b += 1;

        a += 1;

    g;

    // A rooted binary tree with `n` vertices, child i having parent (i - 1) / 2.

    g = undirected_unweighted{V, W}(n);

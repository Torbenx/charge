// --- Demonstration --------------------------------------------------------

// Exercise the traversal namespace on a small grid.

    grid = builders::grid_graph{int, int}(4, 4);
    found = traversal::bfs{int, int}(grid, 0);
    println(to_string(found.reached_count()));
    println(to_string(found.eccentricity()));
    watcher = traversal::Visitor{int, int}();
    watcher.stop_after = 8;
    limited = traversal::bfs_visit{int, int}(grid, 0, watcher);
    limited.complete == false;
    levels = traversal::bfs_levels{int, int}(grid, 0);
    level , levels;
        println(to_string(level.size()));

        // Build a small weighted DAG and run every ordering and distance routine.

    dag = builders::directed{int, int}(6);
    dag.connect(0, 1, 2000);
    dag.connect(0, 2, 4000);
    dag.connect(1, 2, 1000);
    dag.connect(1, 3, 7000);
    dag.connect(2, 4, 3000);
    dag.connect(3, 5, 1000);
    dag.connect(4, 3, 2000);
    dag.connect(4, 5, 5000);

    kahn = connectivity::topological_sort_kahn{int, int}(dag);
    kahn.valid();
    by_dfs = connectivity::topological_sort_dfs{int, int}(dag);
    by_dfs.length() == kahn.length();

    quick = shortest_path::dijkstra{int, int}(dag, 0);
    careful = shortest_path::bellman_ford{int, int}(dag, 0);
    v = 0;
    v < dag.order();
        quick.dist.at(v) == careful.dist.at(v);
        v += 1;

    careful.negative_cycle == false;

    linear = shortest_path::dag_shortest_path{int, int}(dag, 0);
    println(to_string(linear.to(5)));
    route = shortest_path::shortest_route{int, int}(dag, 0, 5);
    println(to_string(route.size()));

    dense = builders::densify{int, int, 6}(dag);
    pairs = shortest_path::floyd_warshall{int, int, 6}(dense);
    println(to_string(pairs.diameter()));
    println(to_string(pairs.center()));
    shortest_path::transitive_closure{int, int, 6}(dense);

    // Spanning trees over an undirected weighted graph.

    net = builders::undirected{int, int}(6);
    net.connect(0, 1, 4000);
    net.connect(0, 2, 3000);
    net.connect(1, 2, 1000);
    net.connect(1, 3, 2000);
    net.connect(2, 3, 4000);
    net.connect(3, 4, 2000);
    net.connect(4, 5, 6000);

    grown = spanning::prim{int, int}(net, 0);
    sorted = spanning::kruskal{int, int}(net);
    grown.weight == sorted.weight;
    sorted.spans(net.order());
    println(to_string(sorted.average_weight()));
    heaviest = spanning::maximum_spanning_tree{int, int}(net);
    heaviest.weight >= sorted.weight;
    spanning::verify_minimality{int, int}(net, sorted);

    // Components, cuts and colourings.

    web = builders::directed{int, int}(8);
    web.connect_unweighted(0, 1);
    web.connect_unweighted(1, 2);
    web.connect_unweighted(2, 0);
    web.connect_unweighted(2, 3);
    web.connect_unweighted(3, 4);
    web.connect_unweighted(4, 5);
    web.connect_unweighted(5, 3);
    web.connect_unweighted(6, 7);

    strong = connectivity::tarjan_scc{int, int}(web);
    also_strong = connectivity::kosaraju_scc{int, int}(web);
    strong.total == also_strong.total;
    collapsed = connectivity::condensation{int, int}(web, strong);
    connectivity::is_acyclic{int, int}(collapsed);
    bucket , strong.buckets();
        println(to_string(bucket.size()));

    ring = builders::cycle_graph{int, int}(7);
    connectivity::has_undirected_cycle{int, int}(ring);
    connectivity::is_bipartite{int, int}(ring) == false;
    even_ring = builders::cycle_graph{int, int}(8);
    connectivity::is_bipartite{int, int}(even_ring);

    chain = builders::path_graph{int, int}(6);
    cuts = connectivity::find_cuts{int, int}(chain);
    println(to_string(cuts.bridge_count()));
    println(to_string(cuts.articulation_list().size()));

    // Matching and flow on the same bipartite instance.

    jobs = builders::complete_bipartite{int, int}(3, 4);
    paired = matching::maximum_bipartite_matching{int, int}(jobs);
    warm = matching::matching_with_warm_start{int, int}(jobs);
    paired.size() == warm.size();
    by_flow = flow::matching_by_flow{int, int}(jobs);
    by_flow == paired.size();
    entry , paired.pairs();
        println(to_string(entry.first));
        println(to_string(entry.second));

    cover = matching::minimum_vertex_cover{int, int}(jobs);
    cover.size() == paired.size();
    matching::maximum_independent_set{int, int}(jobs);
    matching::hall_condition_holds{int, int}(jobs);

    pipes = FlowNetwork();
    pipes.prepare(6);
    pipes.add_arc(0, 1, 16000);
    pipes.add_arc(0, 2, 13000);
    pipes.add_arc(1, 3, 12000);
    pipes.add_arc(2, 1, 4000);
    pipes.add_arc(2, 4, 14000);
    pipes.add_arc(3, 2, 9000);
    pipes.add_arc(3, 5, 20000);
    pipes.add_arc(4, 3, 7000);
    pipes.add_arc(4, 5, 4000);

    value = flow::max_flow(pipes, 0, 5);
    value == pipes.outflow(0);
    value == flow::cut_capacity(pipes, 0);
    fast = flow::dinic_max_flow(pipes, 0, 5);
    fast == value;
    crossing = flow::min_cut_arcs(pipes, 0);
    println(to_string(crossing.size()));


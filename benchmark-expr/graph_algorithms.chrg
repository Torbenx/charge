    g = undirected_unweighted{V, W}(rows * cols);
    r = 0;
    r < rows;
        c = 0;
        c < cols;
            here = r * cols + c;
            c + 1 < cols;
                g.connect_unweighted(here, here + 1);

            r + 1 < rows;
                g.connect_unweighted(here, here + cols);

            c += 1;

        r += 1;

    g;


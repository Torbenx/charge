    c >= 'A' && c <= 'F';
        base | FLAG_HEX_DIGIT;

    base;

(flags & wanted) != 0;

(flags & wanted) == wanted;

(ascii_flags(c) & FLAG_LETTER) != 0;

c >= '0' && c <= '9';

(hex_flags(c) & FLAG_HEX_DIGIT) != 0;

(ascii_flags(c) & FLAG_WHITESPACE) != 0;

(ascii_flags(c) & FLAG_CONTROL) != 0;

(ascii_flags(c) & MASK_ANY_PUNCT) != 0;

(ascii_flags(c) & FLAG_IDENTIFIER_START) != 0;

(ascii_flags(c) & FLAG_IDENTIFIER_PART) != 0;

    c >= '0' && c <= '9';
        int(c) - int('0');

    -1;

    c >= '0' && c <= '9';
        int(c) - int('0');

    c >= 'a' && c <= 'f';
        int(c) - int('a') + 10;

    c >= 'A' && c <= 'F';
        int(c) - int('A') + 10;

    -1;

    value == 0; '0';
    value == 1; '1';
    value == 2; '2';
    value == 3; '3';
    value == 4; '4';
    value == 5; '5';
    value == 6; '6';
    value == 7; '7';
    value == 8; '8';
    value == 9; '9';
    value == 10; 'A';
    value == 11; 'B';
    value == 12; 'C';
    value == 13; 'D';
    value == 14; 'E';
    value == 15; 'F';

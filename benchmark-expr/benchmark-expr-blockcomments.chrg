/* --- ASCII classification bitset ----------------------------------------- */
/* */
/* The first 128 code points are classified with a bit per property rather than */
/* with a table lookup, because the whole set fits in one integer per */
/* character and the compiler can fold the tests. */

/* bit 0 */
                    /* bit 1 */
                    /* bit 2 */
                    /* bit 3 */
                    /* bit 4 */
                    /* bit 5 */
                    /* bit 6 */
                    /* bit 7 */
                    /* bit 8 */
                    /* bit 9 */
                    /* bit 10 */
                    /* bit 11 */
                    /* bit 12 */
      /* bit 13 */
      /* bit 14 */
      /* bit 15 */
      /* bit 16 */
      /* bit 17 */
      /* bit 18 */
      /* bit 19 */

      /* Common combinations, precomputed so the predicates below stay one line. */
      /* LETTER | DIGIT */
      /* LETTER | UPPER | PRINTABLE | ... */
      /* LETTER | LOWER */
      /* WHITESPACE | BLANK */
      /* START | PART */
      /* LETTER | DIGIT | GRAPHIC | PRINTABLE */
      /* PUNCTUATION | SYMBOL | BRACKET */

/* The classification of one ASCII character, as a bit union. Written out as a */
/* chain of range tests over character literals so that the source reads like */
/* the table it represents. */

    c >= 'a' && c <= 'z';
        FLAG_LETTER | FLAG_LOWER | FLAG_PRINTABLE | FLAG_GRAPHIC | FLAG_WORD | FLAG_IDENTIFIER_START | FLAG_IDENTIFIER_PART;

    c >= 'A' && c <= 'Z';
        FLAG_LETTER | FLAG_UPPER | FLAG_PRINTABLE | FLAG_GRAPHIC | FLAG_WORD | FLAG_IDENTIFIER_START | FLAG_IDENTIFIER_PART;

    c >= '0' && c <= '9';
        FLAG_DIGIT | FLAG_HEX_DIGIT | FLAG_PRINTABLE | FLAG_GRAPHIC | FLAG_WORD | FLAG_IDENTIFIER_PART;

    c == ' ';
        FLAG_WHITESPACE | FLAG_BLANK | FLAG_PRINTABLE;

    c == '\t';
        FLAG_WHITESPACE | FLAG_BLANK | FLAG_CONTROL;

    c == '\n';
        FLAG_WHITESPACE | FLAG_CONTROL | FLAG_LINE_BREAK;

    c == '\r';
        FLAG_WHITESPACE | FLAG_CONTROL | FLAG_LINE_BREAK;

    c == '\f';
        FLAG_WHITESPACE | FLAG_CONTROL | FLAG_LINE_BREAK;

    c == '\v';
        FLAG_WHITESPACE | FLAG_CONTROL | FLAG_LINE_BREAK;

    c == '_';
        FLAG_PUNCTUATION | FLAG_PRINTABLE | FLAG_GRAPHIC | FLAG_WORD | FLAG_IDENTIFIER_START | FLAG_IDENTIFIER_PART;

    c == '"';
        FLAG_PUNCTUATION | FLAG_QUOTE | FLAG_PRINTABLE | FLAG_GRAPHIC;

    c == '(' || c == ')';
        FLAG_PUNCTUATION | FLAG_BRACKET | FLAG_PRINTABLE | FLAG_GRAPHIC;

    c == '[' || c == ']';
        FLAG_PUNCTUATION | FLAG_BRACKET | FLAG_PRINTABLE | FLAG_GRAPHIC;

    c == '{' || c == '}';
        FLAG_PUNCTUATION | FLAG_BRACKET | FLAG_PRINTABLE | FLAG_GRAPHIC;

    c == '+' || c == '-';
        FLAG_SYMBOL | FLAG_SIGN | FLAG_PRINTABLE | FLAG_GRAPHIC;

    c == '<' || c == '>' || c == '=';
        FLAG_SYMBOL | FLAG_PRINTABLE | FLAG_GRAPHIC;

    c == '|' || c == '~' || c == '^';
        FLAG_SYMBOL | FLAG_PRINTABLE | FLAG_GRAPHIC;

    c == '$';
        FLAG_SYMBOL | FLAG_PRINTABLE | FLAG_GRAPHIC | FLAG_IDENTIFIER_START | FLAG_IDENTIFIER_PART;

    c == '`';
        FLAG_SYMBOL | FLAG_QUOTE | FLAG_PRINTABLE | FLAG_GRAPHIC;

    c == '!' || c == '?' || c == '.' || c == ',';
        FLAG_PUNCTUATION | FLAG_PRINTABLE | FLAG_GRAPHIC;

    c == ':' || c == ';';
        FLAG_PUNCTUATION | FLAG_PRINTABLE | FLAG_GRAPHIC;

    c == '*' || c == '/' || c == '%' || c == '&' || c == '#' || c == '@';
        FLAG_PUNCTUATION | FLAG_PRINTABLE | FLAG_GRAPHIC;

    c == '\0';
        FLAG_CONTROL;

    int(c) < 32;
        FLAG_CONTROL;


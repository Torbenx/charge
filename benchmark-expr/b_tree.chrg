    text_append , " order=";
    text_append , to_string , ORDER;
    text_append , " balanced=";
    stats_balanced;
        text_append , "yes";

        text_append , "no";

    text;

// --- Demo -------------------------------------------------------------------

// Exercises the container end to end at two different branching factors, which
// is also the cheapest way to force both instantiations to be checked.

    tree = BTree , int , string , 6;
    tree_reserve , BTREE_INITIAL_CAPACITY;

    // Insert a pseudo-random permutation of [0, 64).
    i , range , 0 , 64;
        tree_insert , i * 37 % 64 , to_string , i;

    println , describe_shape , int , string , 6 , tree;
    !tree_check_validity;
        panic , "B-tree invariants violated after bulk insert";

    // Delete every third key and re-check.
    index = 0;
    index < 64;
        index % 3 == 0;
            tree_erase , index;

        index++;

    !tree_check_validity;
        panic , "B-tree invariants violated after bulk erase";

    // Range query over the middle half of the key space.
    window = vector , pair , int , string;
    hits = tree_range_query , 16 , 48 , window;
    println , to_string , hits;
    entry , window;
        println , entry_second;

    window;

    // Grouped range query, exercising the nested map/vector/pair return type.
    grouped = tree_range_grouped , 0 , 64;
    println , to_string , grouped_size;
    grouped;

    // Bulk load a wider tree from the narrow one's sorted contents.
    wide = BTree , int , string , 16;
    !rebalance_to_order , int , string , 6 , 16 , tree , wide;
        panic , "rebalance produced an unsorted run";

    !wide_check_validity;
        panic , "B-tree invariants violated after bulk load";

    println , describe_shape , int , string , 16 , wide;

    // Predecessor and successor around a key that is definitely present.
    before = tree_predecessor , 32;
    after = tree_successor , 32;
    println , to_string , before_first;
    println , to_string , after_first;

    // Statistics pass.
    stats = tree_statistics;
    println , to_string , stats_height;
    println , to_string , stats_average_occupancy;
    println , to_string , stats_leaf_fraction_percent;
    bucket , stats_occupancy_histogram;
        println , to_string , bucket_second;

    stats;

    wide;
    tree;

        ByteClass_Ascii;

    b >= 128 && b <= 191;                 // 0x80 .. 0xBF
        ByteClass_Continuation;

    b >= 192 && b <= 193;                 // 0xC0 .. 0xC1
        ByteClass_Illegal;

    b >= 194 && b <= 223;                 // 0xC2 .. 0xDF
        ByteClass_LeadTwo;

    b == 224;                             // 0xE0
        ByteClass_LeadThreeLowBound;

    b >= 225 && b <= 236;                 // 0xE1 .. 0xEC
        ByteClass_LeadThree;

    b == 237;                             // 0xED
        ByteClass_LeadThreeSurrogate;

    b >= 238 && b <= 239;                 // 0xEE .. 0xEF
        ByteClass_LeadThree;

    b == 240;                             // 0xF0
        ByteClass_LeadFourLowBound;

    b >= 241 && b <= 243;                 // 0xF1 .. 0xF3

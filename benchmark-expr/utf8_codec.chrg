// the range of their first continuation byte.

    b >= 0 && b <= 127;                   // 0x00 .. 0x7F
        ByteClass::Ascii;

    b >= 128 && b <= 191;                 // 0x80 .. 0xBF
        ByteClass::Continuation;

    b >= 192 && b <= 193;                 // 0xC0 .. 0xC1
        ByteClass::Illegal;

    b >= 194 && b <= 223;                 // 0xC2 .. 0xDF
        ByteClass::LeadTwo;

    b == 224;                             // 0xE0
        ByteClass::LeadThreeLowBound;

    b >= 225 && b <= 236;                 // 0xE1 .. 0xEC
        ByteClass::LeadThree;

    b == 237;                             // 0xED
        ByteClass::LeadThreeSurrogate;

    b >= 238 && b <= 239;                 // 0xEE .. 0xEF

            byte0;

        index == 1;
            byte1;

        index == 2;
            byte2;

        index == 3;
            byte3;

        0;

        masked = value & BYTE_MASK;
        index == 0;
            byte0 = masked;

            index == 1;
                byte1 = masked;

                index == 2;
                    byte2 = masked;

                    byte3 = masked;


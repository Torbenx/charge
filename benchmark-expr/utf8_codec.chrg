            column = 1;

            (value & CONT_MASK) != CONT_MARK;
                column += 1;

        offset += length;
        scalar == 10;
            line += 1;
            column = 1;

            column += 1;

        out = "line ";
        out.append(to_string(line));
        out.append(", column ");
        out.append(to_string(column));
        out.append(" (byte ");
        out.append(to_string(offset));
        out.append(")");
        out;


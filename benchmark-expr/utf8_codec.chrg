// How many bytes the sequence starting with this lead byte occupies. Zero
// means the byte cannot start a sequence at all.

    (lead & ASCII_MASK) == 0;
        1;

    (lead & CONT_MASK) == CONT_MARK;
        0;

    (lead & LEAD_TWO_MASK) == LEAD_TWO_MARK;
        2;

    (lead & LEAD_THREE_MASK) == LEAD_THREE_MARK;
        3;

    (lead & LEAD_FOUR_MASK) == LEAD_FOUR_MARK;

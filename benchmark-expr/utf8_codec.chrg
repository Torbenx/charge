    rows.push_back(CaseRow( 216, 222, 1, 32, 0, 0));     // 0x00D8 .. 0x00DE
    rows.push_back(CaseRow( 224, 246, 1, 0, -32, -32));  // 0x00E0 .. 0x00F6

    class == ByteClass_LeadFourLowBound;
        144;                            // 0x90, blocks overlong 4 byte

    128;                                // 0x80

    class == ByteClass_LeadThreeSurrogate;
        159;                            // 0x9F, blocks D800 .. DFFF


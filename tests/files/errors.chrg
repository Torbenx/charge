
struct X: { }
struct Y: { }

struct SelfTypeErrors: {
    // expect-error SelfTypeTemplateParameterWithExplicitType
    template(self_type: type)
    fn f1() -> X: { }

    // expect-error SelfTypeTemplateParameterWithDefaultArgument
    template(self_type = X)
    fn f2() -> X: { }
}

// expect-error StaticVariableDeclarationWithoutInitializer
// expect-value @error(X)
static noInit: X;

namespace FnImpl: {

fn base(x: X) -> X: { }

// expect-error FunctionImplFunctionParameterCountMismatch
fn impl base(x: X, x2: X) -> X: { }

// expect-error FunctionImplFunctionParameterNameMismatch
fn impl base(x1: X) -> X: { }

// expect-error FunctionImplFunctionParameterKindMismatch
fn impl base(x: &unique X) -> X: { }

fn genericBase(x: &(expression_category::value) X) -> X: { }
// expect-error FunctionImplFunctionParameterGenericCategoryMismatch
fn impl genericBase(x: &(expression_category::unique_ref) X) -> X: { }

// expect-error FunctionImplFunctionParameterTypeMismatch
fn impl base(x: Y) -> X: { }

// expect-error FunctionImplReturnTypeMismatch
fn impl base(x: X) -> Y: { }

}

struct Fn: {

// expect-error FunctionParameterWithDefaultArgument
fn f1(x: X = X()) -> X: { }

// expect-error SelfFunctionParameterWithDefaultArgument
fn f2(self = Fn()) -> X: { }

// expect-error SelfFunctionParameterWithExplicitType
fn f3(self: Fn) -> X: { }

// expect-error FunctionWithoutExplicitReturnType
// expect-return-type @error(type)
fn f4(): { }

}

namespace OpenReturnType: {

// expect-error OpenReturnTypeOnNonTemplateFunction
// expect-return-type @error(type)
fn f1() -> return_type: { }

}

struct ReferenceReturnType: {

// expect-error ReferenceReturnTypeNotSupported
// expect-return-type X
fn f1() -> &unique X: { }

// expect-error ReferenceReturnTypeNotSupported
// expect-return-type X
fn f2(self: &unique) -> &unique[self] X: { }

// expect-error ReferenceReturnTypeNotSupported
// expect-return-type X
fn f3(self: &unique) -> &shared[unique self] X: { }

// expect-error ReferenceReturnTypeNotSupported
// expect-return-type X
fn f4() -> &(expression_category::unique_ref) X: { }

}

namespace StructImpl: {

struct base: { x: X; }

// expect-error StructImplToFewMembers
struct impl base: { }

// expect-error StructImplMemberIsBaseMismatch
struct impl base: { base X; }

// expect-error StructImplMemberNameMismatch
struct impl base: { y: X; }

// expect-error StructImplMemberTypeMismatch
struct impl base: { x: Y; }

}

namespace GlobalImpl: {

template(T: type) static var g1: type = T;
// expect-error GlobalImplTargetNotOpen
static impl g1{X}: type = bool;

template(T: type) static open g2: type = T;
// expect-error GlobalImplTypeMismatch
static impl g2{X}: bool = true;

}

namespace Stmt: {

static var staticX = X();

// expect-error DestoryTargetNotALocalVariable
fn f1() -> X: { destroy staticX; }

// expect-error DiscardTargetNotALocalReference
fn f2() -> X: { discard staticX; }

}

enum ImplicitImplBase: {
    enumValue;
    struct Struct: { }

    template(x: X) fn f1() -> X: { }
    template(x: X) fn f2() -> X: { }
    template(x: X) fn f3() -> X: { }
}

enum impl ImplicitImplBase: {

// expect-error ImplicitImplTargetNotFound
fn unknown() -> X: { }

// expect-error ImplicitImplTargetNotAProgram
fn enumValue() -> X: { }

// expect-error ImplicitImplTargetKindMismatch
fn Struct() -> X: { }

// expect-error ImplicitImplTemplateParameterCountMismatch
template(x: X, y: Y) fn f1() -> X: { }

// expect-error ImplicitImplTemplateParameterNameMismatch
template(y: X) fn f2() -> X: { }

// expect-error ImplicitImplTemplateParameterTypeMismatch
template(x: Y) fn f3() -> X: { }

}

namespace Parameterize: {

struct S1: { }
// expect-error ParameterizeBaseIsNotATemplate
// expect-value @error(@error(type))
static g1 = S1{X};

template(T: type) struct S2: { }
// expect-error ParameterizeBaseIsAlreadyParameterized
// expect-value @error(@error(type))
static g2 = S2{X}{X};

// expect-error ParameterizeBaseNotSupported
// expect-value @error(@error(type))
static g3 = X(){X};

// expect-error ParameterizeWithTooManyArguments
// expect-value Parameterize::S2{X}
static g4 = S2{X, X};

// expect-error ParameterizeArgumentNameMismatch
// expect-value Parameterize::S2{X}
static g5 = S2{T1: X};

template(T1: type, T2: type) static r1 = X();
// expect-error ParameterizeIncomplete
// expect-value @error(@error(type))
static g6 = r1{X};

}

namespace CallTarget: {

struct S1: { }
// expect-error CallTargetNotSupported
// expect-value @error(@error(type))
static g2 = S1()();

template(T: type) fn f1() -> X: { }
// expect-error CallTargetTemplateArgumentDeductionIncomplete
// expect-value @error(@error(type))
static g3 = f1();

}

struct Lookup: {

member: X;
fn function() -> X: { }
// expect-error UnqualifiedLookupFoundMember
// expect-return-type member_ptr{Lookup, X}
fn f1() => member;

// expect-error UnqualifiedLookupFailed
// expect-return-type @error(type)
fn f2() => unknown;

//; TODO: expect-error UnqualifiedLookupFailed
fn f2x() -> X: { { let x = X; } x; }

// expect-error StaticLookupFailed
// expect-return-type @error(type)
fn f3() => Lookup::unknown;

// expect-error StaticLookupFailed
// expect-return-type @error(type)
fn f3x() => function::unknown;

// expect-error StaticLookupBaseExpressionNotSupported
// expect-return-type @error(type)
fn f4() => X()::foo;

static r1 = X();
// expect-error StaticLookupBaseConstantNotSupported
// expect-return-type @error(type)
fn f5() => r1::foo;

// expect-error MemberLookupFailed
// expect-return-type @error(type)
fn f6(self) => .unknown;

// expect-error MemberLookupResultNotSupported
// expect-return-type @error(type)
fn f7(self) => .r1;

fn fref(self) -> X: { }
// expect-error MemberLookupFunctionResultNotImmediatelyCalled
// expect-return-type @error(type)
fn f8(self) => .fref;

}

struct MemberFunction: {

fn fr1() -> X: { }
// expect-error MemberFunctionCallTargetHasNoSelfParameter
// expect-return-type @error(type)
fn f1(self) => .fr1();

//; expect-error MemberFunctionCallSelfParameterTypeMismatch
//; TODO: Currently impossible?

template(T: type) fn fr2(self) -> X: { }
// expect-error MemberFunctionCallTargetTemplateArgumentDeductionIncomplete
// expect-return-type @error(type)
fn f2(self) => .fr2();

}

namespace SelfLookup: {

// expect-error SelfParameterLookupFailed
// expect-value @error(@error(type))
static g1 = self;

// expect-error SelfTypeTemplateParameterLookupFailed
// expect-value @error(type)
static g2 = self_type;

}

namespace Init: {

// expect-error InitializeTypeMismatch
// expect-value @error(type)
static g1: type = X();

fn fr1(x: &unique X) -> X: { }
// expect-error InitializeOfReferenceWithValue
fn f1() => fr1(X());

// expect-error InitializeOfReferenceIsNotReferenceDowncast
fn f2(x: &shared X) => fr1(x);

}

// expect-error MemberDeclarationWithoutExplicitType
struct Member: {
    memberWithoutType;
}

namespace ExplicitImpl: {
static var r1 = X();
// expect-error ExplicitImplExpressionNotSupported
struct impl r1: { }
}
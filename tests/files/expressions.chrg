

// expect-source-position line=3 column=1
 // expect-source-position line=4 column=2

fn test(): {

//; primary expressions
/* expect-token IdentifierExpr */ a;
/* expect-token NumericLiteralExpr */ 1;
/* expect-token CharacterLiteralExpr */ 'a';

/* expect-token ImplicitSelfReference; expect-token MemberAccessExpr */ .a;
/* expect-token ImplicitSelfReference; expect-token MemberAccessExpr */ ./**/a;

/* expect-token ParenthesizedExpr; expect-token EmptyNode */ ();
/* expect-token ParenthesizedExpr; expect-token CallArgument; expect-token IdentifierExpr; expect-token EmptyNode */ (a);
/* expect-token ParenthesizedExpr; expect-token CallArgument; expect-token IdentifierExpr; expect-token EmptyNode */ (a,);
/* expect-token ParenthesizedExpr; expect-token CallArgument; expect-token IdentifierExpr; expect-token EmptyNode */ (a, /**/);
/* expect-token ParenthesizedExpr; expect-token CallArgument; expect-token IdentifierExpr; expect-token CallArgument; expect-token IdentifierExpr; expect-token EmptyNode */ (a, b);
/* expect-token ParenthesizedExpr; expect-token CallArgument; expect-token IdentifierExpr; expect-token CallArgument; expect-token IdentifierExpr; expect-token EmptyNode */ (a, b,);
/* expect-token ParenthesizedExpr; expect-token CallArgument; expect-token IdentifierExpr; expect-token CallArgument; expect-token IdentifierExpr; expect-token EmptyNode */ (a, /**/ b, /**/);
/* expect-token ParenthesizedExpr; expect-token CallArgument; expect-token IdentifierExpr; expect-token EmptyNode */ (p: a);
/* expect-token ParenthesizedExpr; expect-token CallArgument; expect-token IdentifierExpr; expect-token EmptyNode */ (p: a,);
/* expect-token ParenthesizedExpr; expect-token CallArgument; expect-token IdentifierExpr; expect-token EmptyNode */ (p /**/ : a, /**/);
/* expect-token ParenthesizedExpr; expect-token CallArgument; expect-token IdentifierExpr; expect-token CallArgument; expect-token IdentifierExpr; expect-token EmptyNode */ (p: a, q: b);
/* expect-token ParenthesizedExpr; expect-token CallArgument; expect-token IdentifierExpr; expect-token CallArgument; expect-token IdentifierExpr; expect-token EmptyNode */ (p: a, q: b,);
/* expect-token ParenthesizedExpr; expect-token CallArgument; expect-token IdentifierExpr; expect-token CallArgument; expect-token IdentifierExpr; expect-token EmptyNode */ (p /**/ : a, /**/ q: /**/ b, /**/);

//; postfix expressions
/* expect-token IdentifierExpr; expect-token Parameterize; expect-token EmptyNode */ a{};
/* expect-token IdentifierExpr; expect-token Parameterize; expect-token EmptyNode */ a{/**/};
/* expect-token IdentifierExpr; expect-token Parameterize; expect-token EmptyNode */
a{
};
/* expect-token IdentifierExpr; expect-token Parameterize; expect-token CallArgument; expect-token IdentifierExpr; expect-token EmptyNode */ a{b};
/* expect-token IdentifierExpr; expect-token CallExpr; expect-token EmptyNode */ a();
/* expect-token IdentifierExpr; expect-token CallExpr; expect-token EmptyNode */ a(/**/);
/* expect-token IdentifierExpr; expect-token CallExpr; expect-token CallArgument; expect-token IdentifierExpr; expect-token EmptyNode */ a(b);
/* expect-token IdentifierExpr; expect-token IndexExpr; expect-token EmptyNode */ a[];
/* expect-token IdentifierExpr; expect-token IndexExpr; expect-token EmptyNode */ a[/**/];
/* expect-token IdentifierExpr; expect-token IndexExpr; expect-token CallArgument; expect-token IdentifierExpr; expect-token EmptyNode */ a[b];
/* expect-token IdentifierExpr; expect-token MemberAccessExpr */ a.b;
/* expect-token IdentifierExpr; expect-token MemberAccessExpr */ a./**/b;
/* expect-token IdentifierExpr; expect-token StaticAccessExpr */ a::b;
/* expect-token IdentifierExpr; expect-token StaticAccessExpr */ a::/**/b;
/* expect-token IdentifierExpr; expect-token MemberAccessExpr; expect-token Parameterize; expect-token EmptyNode */ a.b{};
/* expect-token IdentifierExpr; expect-token StaticAccessExpr; expect-token Parameterize; expect-token EmptyNode */ a::b{};
/* expect-token IdentifierExpr; expect-token PostIncrementExpr */ a++;
/* expect-token IdentifierExpr; expect-token PostDecrementExpr */ a--;

//; unary expressions
/* expect-token LogicalNotExpr; expect-token IdentifierExpr */ !a;
/* expect-token BitwiseNotExpr; expect-token IdentifierExpr */ ~a;
/* expect-token PreIncrementExpr; expect-token IdentifierExpr */ ++a;
/* expect-token PreDecrementExpr; expect-token IdentifierExpr */ --a;
/* expect-token PlusExpr; expect-token IdentifierExpr */ +a;
/* expect-token NegateExpr; expect-token IdentifierExpr */ -a;
/* expect-token DereferenceExpr; expect-token IdentifierExpr */ *a;

//; binary expressions
/* expect-token IdentifierExpr; expect-token AdditionExpr; expect-token IdentifierExpr */ a + b;
/* expect-token IdentifierExpr; expect-token SubtractionExpr; expect-token IdentifierExpr */ a - b;
/* expect-token IdentifierExpr; expect-token MultiplyExpr; expect-token IdentifierExpr */ a * b;
/* expect-token IdentifierExpr; expect-token BitwiseAndExpr; expect-token IdentifierExpr */ a & b;
/* expect-token IdentifierExpr; expect-token BitwiseXorExpr; expect-token IdentifierExpr */ a ^ b;
/* expect-token IdentifierExpr; expect-token BitwiseOrExpr; expect-token IdentifierExpr */ a | b;
/* expect-token IdentifierExpr; expect-token DivideExpr; expect-token IdentifierExpr */ a / b;
/* expect-token IdentifierExpr; expect-token RemainderExpr; expect-token IdentifierExpr */ a % b;
/* expect-token IdentifierExpr; expect-token ShiftLeftExpr; expect-token IdentifierExpr */ a << b;
/* expect-token IdentifierExpr; expect-token ShiftRightExpr; expect-token IdentifierExpr */ a >> b;
/* expect-token IdentifierExpr; expect-token CompareNotEqualExpr; expect-token IdentifierExpr */ a != b;
/* expect-token IdentifierExpr; expect-token CompareEqualExpr; expect-token IdentifierExpr */ a == b;
/* expect-token IdentifierExpr; expect-token CompareLessExpr; expect-token IdentifierExpr */ a < b;
/* expect-token IdentifierExpr; expect-token CompareLessEqualExpr; expect-token IdentifierExpr */ a <= b;
/* expect-token IdentifierExpr; expect-token CompareGreaterExpr; expect-token IdentifierExpr */ a > b;
/* expect-token IdentifierExpr; expect-token CompareGreaterEqualExpr; expect-token IdentifierExpr */ a >= b;
/* expect-token IdentifierExpr; expect-token LogicalAndExpr; expect-token IdentifierExpr */ a && b;
/* expect-token IdentifierExpr; expect-token LogicalOrExpr; expect-token IdentifierExpr */ a || b;

//; conditional expressions
/* expect-token IdentifierExpr; expect-token IfExpr; expect-token IdentifierExpr; expect-token ExpressionStmt */ if a => b;
/* expect-token IdentifierExpr; expect-token CommaElseExpr; expect-token IdentifierExpr; expect-token ExpressionStmt */ a, else => b;

//; update statements
/* expect-token IdentifierExpr; expect-token AssignStmt; expect-token IdentifierExpr; expect-token ExpressionStmt */ a = b;
/* expect-token IdentifierExpr; expect-token AdditionUpdateStmt; expect-token IdentifierExpr; expect-token ExpressionStmt */ a += b;
/* expect-token IdentifierExpr; expect-token SubtractionUpdateStmt; expect-token IdentifierExpr; expect-token ExpressionStmt */ a -= b;
/* expect-token IdentifierExpr; expect-token MultiplyUpdateStmt; expect-token IdentifierExpr; expect-token ExpressionStmt */ a *= b;
/* expect-token IdentifierExpr; expect-token DivideUpdateStmt; expect-token IdentifierExpr; expect-token ExpressionStmt */ a /= b;
/* expect-token IdentifierExpr; expect-token RemainderUpdateStmt; expect-token IdentifierExpr; expect-token ExpressionStmt */ a %= b;
/* expect-token IdentifierExpr; expect-token BitwiseAndUpdateStmt; expect-token IdentifierExpr; expect-token ExpressionStmt */ a &= b;
/* expect-token IdentifierExpr; expect-token BitwiseXorUpdateStmt; expect-token IdentifierExpr; expect-token ExpressionStmt */ a ^= b;
/* expect-token IdentifierExpr; expect-token BitwiseOrUpdateStmt; expect-token IdentifierExpr; expect-token ExpressionStmt */ a |= b;
/* expect-token IdentifierExpr; expect-token ShiftLeftUpdateStmt; expect-token IdentifierExpr; expect-token ExpressionStmt */ a <<= b;
/* expect-token IdentifierExpr; expect-token ShiftRightUpdateStmt; expect-token IdentifierExpr; expect-token ExpressionStmt */ a >>= b;
/* expect-token IdentifierExpr; expect-token LogicalAndUpdateStmt; expect-token IdentifierExpr; expect-token ExpressionStmt */ a &&= b;
/* expect-token IdentifierExpr; expect-token LogicalOrUpdateStmt; expect-token IdentifierExpr; expect-token ExpressionStmt */ a ||= b;

//; context statements
/* expect-token IdentifierExpr; expect-token ContextFunctionStmt; expect-token IdentifierExpr; expect-token ExpressionStmt */ a: b;
/* expect-token IdentifierExpr; expect-token ContextFunctionStmt; expect-token CompoundStmt; expect-token IdentifierExpr; expect-token ExpressionStmt; expect-token EmptyNode */ a: { b; }
/* expect-token IdentifierExpr; expect-token ContextExpressionStmt; expect-token IdentifierExpr; expect-token ExpressionStmt */ a => b;

/* expect-token CompoundStmt; expect-token IdentifierExpr; expect-token ExpressionStmt; expect-token EmptyNode */ { a; }

//; test comma-else in arguments
// expect-token ParenthesizedExpr;
// expect-token CallArgument; expect-token IdentifierExpr; expect-token CommaElseExpr; expect-token IdentifierExpr
// expect-token CallArgument; expect-token IdentifierExpr; expect-token EmptyNode
(a, else => b, c);

/* expect-token IdentifierExpr; expect-token IfStmt; expect-token IdentifierExpr; expect-token ExpressionStmt */ if a: b;
/* expect-token IdentifierExpr; expect-token IfStmt; expect-token CompoundStmt */ if a: { }
/* expect-token IdentifierExpr; expect-token IfStmt; expect-token CompoundStmt; expect-token IdentifierExpr; expect-token ExpressionStmt; expect-token EmptyNode */ if a: { b; }

// expect-token IdentifierExpr; expect-token IfStmt; expect-token IdentifierExpr; expect-token ExpressionStmt
// expect-token ElseStmt; expect-token IdentifierExpr; expect-token ExpressionStmt
if a: b; else: c;

// expect-token IdentifierExpr; expect-token IfStmt; expect-token CompoundStmt; expect-token EmptyNode
// expect-token ElseStmt; expect-token CompoundStmt; expect-token EmptyNode
if a: { } else: { }

// expect-token IdentifierExpr; expect-token IfStmt; expect-token CompoundStmt; expect-token IdentifierExpr; expect-token ExpressionStmt; expect-token EmptyNode
// expect-token ElseStmt; expect-token CompoundStmt; expect-token IdentifierExpr; expect-token ExpressionStmt; expect-token EmptyNode
if a: { b; } else: { c; }

/* expect-token LetValueDecl; expect-token ExpressionStmt */ let a;
/* expect-token VarValueDecl; expect-token ExpressionStmt */ var a;
/* expect-token LetValueDecl; expect-token AssignStmt; expect-token IdentifierExpr; expect-token ExpressionStmt */ let a = init;
/* expect-token LetValueDecl; expect-token VariableType; expect-token IdentifierExpr; expect-token ExpressionStmt */ let a: type;
/* expect-token LetValueDecl; expect-token VariableType; expect-token IdentifierExpr; expect-token AssignStmt; expect-token IdentifierExpr; expect-token ExpressionStmt */ let a: type = init;
/* expect-token LetValueDecl; expect-token VariableType; expect-token ExpressionStmt */ let a: &unique;
/* expect-token LetValueDecl; expect-token VariableType; expect-token IdentifierExpr; expect-token ExpressionStmt */ let a: &unique type;
/* expect-token LetValueDecl; expect-token VariableType; expect-token AssignStmt; expect-token IdentifierExpr; expect-token ExpressionStmt */ let a: &unique = init;
/* expect-token LetValueDecl; expect-token VariableType; expect-token IdentifierExpr; expect-token AssignStmt; expect-token IdentifierExpr; expect-token ExpressionStmt */ let a: &unique type = init;

// expect-token IdentifierExpr; expect-token IfStmt; expect-token LetValueDecl; expect-token ExpressionStmt
// expect-token ElseStmt; expect-token LetValueDecl; expect-token ExpressionStmt
if a: let b; else: let c;

// expect-token ParenthesizedExpr; expect-token CallArgument; expect-token IdentifierExpr; expect-token CallArgument; expect-token IdentifierExpr; expect-token EmptyNode
// expect-token AssignStmt; expect-token IdentifierExpr; expect-token ExpressionStmt
(a, b) = c;

// expect-token ParenthesizedExpr; expect-token CallArgument; expect-token IdentifierExpr; expect-token IfExpr; expect-token IdentifierExpr; expect-token EmptyNode
// expect-token AssignStmt; expect-token IdentifierExpr; expect-token ExpressionStmt
(if a => b) = c;

// expect-token ReturnStmt; expect-token IdentifierExpr; expect-token ExpressionStmt
return a;

// expect-token EmptyReturnStmt
return;

// expect-token DestroyStmt; expect-token IdentifierExpr; expect-token ExpressionStmt
destroy a;

//; while loops
// expect-token WhileStmt; expect-token IdentifierExpr; expect-token WhileBody
// expect-token IdentifierExpr; expect-token ExpressionStmt
while a: b;

// expect-token WhileStmt; expect-token IdentifierExpr; expect-token CompareGreaterExpr; expect-token NumericLiteralExpr
// expect-token WhileBody; expect-token CompoundStmt
// expect-token IdentifierExpr; expect-token SubtractionUpdateStmt; expect-token NumericLiteralExpr; expect-token ExpressionStmt
// expect-token EmptyNode
while x > 0: { x -= 1; }

// expect-token WhileStmt; expect-token IdentifierExpr; expect-token WhileBody; expect-token CompoundStmt; expect-token EmptyNode
while a: { }

//; do-while loops
// expect-token DoStmt; expect-token CompoundStmt
// expect-token IdentifierExpr; expect-token SubtractionUpdateStmt; expect-token NumericLiteralExpr; expect-token ExpressionStmt
// expect-token EmptyNode
// expect-token DoWhileStmt; expect-token IdentifierExpr; expect-token CompareGreaterExpr; expect-token NumericLiteralExpr
// expect-token ExpressionStmt
do: { x -= 1; } while x > 0;

// expect-token DoStmt; expect-token IdentifierExpr; expect-token ExpressionStmt
// expect-token DoWhileStmt; expect-token IdentifierExpr; expect-token ExpressionStmt
do: b; while a;

//; plain loops
// expect-token LoopStmt; expect-token CompoundStmt
// expect-token IdentifierExpr; expect-token CompareLessEqualExpr; expect-token NumericLiteralExpr; expect-token IfStmt; expect-token BreakStmt
// expect-token IdentifierExpr; expect-token SubtractionUpdateStmt; expect-token NumericLiteralExpr; expect-token ExpressionStmt
// expect-token EmptyNode
loop: { if x <= 0: break; x -= 1; }

// expect-token LoopStmt; expect-token IdentifierExpr; expect-token ExpressionStmt
loop: b;

//; range-for loops
// expect-token ForStmt; expect-token LetValueDecl
// expect-token VariableType; expect-token IdentifierExpr
// expect-token ForIn; expect-token IdentifierExpr
// expect-token ForBody; expect-token CompoundStmt; expect-token EmptyNode
for x: &const type in type_list: { }

// expect-token ForStmt; expect-token LetValueDecl; expect-token ForIn; expect-token IdentifierExpr
// expect-token ForBody; expect-token IdentifierExpr; expect-token ExpressionStmt
for x in list: b;

// expect-token ForStmt; expect-token LetValueDecl; expect-token VariableType; expect-token IdentifierExpr
// expect-token ForIn; expect-token IdentifierExpr; expect-token ForBody; expect-token CompoundStmt; expect-token EmptyNode
for x: type in list: { }

// expect-token ForStmt; expect-token LetValueDecl; expect-token VariableType
// expect-token ForIn; expect-token IdentifierExpr; expect-token ForBody; expect-token CompoundStmt; expect-token EmptyNode
for x: &unique in list: { }

// expect-token ForStmt; expect-token VarValueDecl; expect-token ForIn; expect-token IdentifierExpr
// expect-token ForBody; expect-token CompoundStmt; expect-token EmptyNode
for var x in list: { }

//; break and continue
// expect-token LoopStmt; expect-token CompoundStmt; expect-token ContinueStmt; expect-token EmptyNode
loop: { continue; }

// expect-token WhileStmt; expect-token IdentifierExpr; expect-token WhileBody; expect-token BreakStmt
while a: break;

//; nested loops
// expect-token CompoundStmt
// expect-token WhileStmt; expect-token IdentifierExpr; expect-token WhileBody
// expect-token WhileStmt; expect-token IdentifierExpr; expect-token WhileBody
// expect-token IdentifierExpr; expect-token ExpressionStmt
// expect-token IdentifierExpr; expect-token ExpressionStmt
// expect-token EmptyNode
{ while a: while b: c; d; }

// expect-token LoopStmt; expect-token CompoundStmt
// expect-token ForStmt; expect-token LetValueDecl; expect-token ForIn; expect-token IdentifierExpr; expect-token ForBody
// expect-token DoStmt; expect-token IdentifierExpr; expect-token ExpressionStmt
// expect-token DoWhileStmt; expect-token IdentifierExpr; expect-token ExpressionStmt
// expect-token EmptyNode
loop: { for x in list: do: b; while a; }

}
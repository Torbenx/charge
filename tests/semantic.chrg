// expect-type type
struct X: { }
// expect-value X
// expect-type type
static XX: type = X;

template(x: XX) struct Y: { }
// expect-type template_id{@templsig(Y)}
static Z = Y;

template(T: type) struct Foo: { }
// expect-value Foo{X}
static U: type = Foo{X};

template(T) struct Bar: { }
// expect-value Bar{type, X}
static V: type = Bar{X};
// expect-value Bar{template_id{@templsig(Y)}, Y}
static W: type = Bar{Y};

template(T: type) struct Outer: {
    struct A: { }

    // expect-value Outer::A{#0}
    static AliasA: type = A;

    template(T) struct B: { }

    // expect-value Outer::B{#0, type, Outer::A{#0}}
    static BA: type = B{A};
}

struct A: { }
template(a) struct B: { }
template(b, a) struct C: { }
template(c, b, a) struct D: { }
template(d, c, b, a) struct E: { }
// expect-value E{type, D{type, C{type, B{type, A}, type, A}, type, B{type, A}, type, A}, type, C{type, B{type, A}, type, A}, type, B{type, A}, type, A}
static ABBCDE = E{D{C{B{A}, A}, B{A}, A}, C{B{A}, A}, B{A}, A};

// expect-type type;
fn f1() => X;
// expect-type type;
fn f2(t) => X;
// expect-type type;
fn f3(t: type) => X;
// expect-type type;
fn f4(t: type = X) => X;

fn t1() => X;
// expect-type function_id{@fnsig(t1)}
static tt1 = t1;

fn t2(x) => X;
// expect-type template_id{@templsig(t2)}
static tt2 = t2;

template(T: type) fn t3() => X;
// expect-type function_id{@fnsig(t3{X})}
static tt3 = t3{X};

fn func1() => X;
// expect-type type
static call1 = func1();

fn func2(x) => X;
// expect-type type
static call2 = func2(X);

fn func3(a, b, c, d, e) => X;
// expect-type type
static call3 = func3(X, X, X, X, X);

template(x: type) fn func4(y: type) => X;
// expect-value func4{X}
// expect-type function_id{@fnsig(func4{X})}
static func4ref = func4{X};
// expect-type type
static call4direct = func4{X}(X);
// expect-type type
static call4indirect = func4ref(X);
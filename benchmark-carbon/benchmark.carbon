// Passed pawn and king zone masks, both built by walking files and ranks.
fn init_evaluation_masks() {
    var color: int = 0;
    while (color < COLOR_COUNT) {
        PASSED_MASK.at(color) = vector(int)(SQUARE_COUNT);
        KING_ZONE.at(color) = vector(int)(SQUARE_COUNT);
        color += 1;
    }

    var side: int = 0;
    while (side < COLOR_COUNT) {
        var forward: int = 1;
        if (side == 1) {
            forward = -1;
        }
        var rank: int = 0;
        while (rank < BOARD_RANKS) {
            var file: int = 0;
            while (file < BOARD_FILES) {
                let square = make_square(file, rank);

                // Every square on the three files ahead of the pawn.
                var passed: int = 0;
                var scan = rank + forward;
                while (scan >= 0 and scan < BOARD_RANKS) {
                    var neighbour = file - 1;
                    while (neighbour <= file + 1) {
                        if (neighbour >= 0 and neighbour < BOARD_FILES) {
                            passed |= 1 << make_square(neighbour, scan);
                        }
                        neighbour += 1;
                    }
                    scan += forward;
                }
                PASSED_MASK.at(side).at(square) = passed;

                // The king's neighbourhood plus the shelter in front of it.
                var zone = KING_ATTACKS.at(square) | (1 << square);
                let ahead = rank + forward + forward;
                if (ahead >= 0 and ahead < BOARD_RANKS) {
                    var neighbour = file - 1;
                    while (neighbour <= file + 1) {
                        if (neighbour >= 0 and neighbour < BOARD_FILES) {
                            zone |= 1 << make_square(neighbour, ahead);
                        }
                        neighbour += 1;
                    }
                }
                KING_ZONE.at(side).at(square) = zone;

                file += 1;
            }
            rank += 1;
        }
        side += 1;
    }

    // A quadratic ramp that saturates, so that a fourth attacker adds less
    // than the second did.
    var index: int = 0;
    while (index < 64) {
        var value = index * index * 3;
        if (value > 500) {
            value = 500;
        }
        KING_ATTACK_SCALE.at(index) = value;
        index += 1;
    }
}

// --- Evaluation -----------------------------------------------------------

// How far into the endgame the position is, from PHASE_TOTAL (all pieces on
// the board) down to zero (bare kings).
fn game_phase(board: Position) -> int {
    var phase: int = 0;
    var kind: int = 1;
    while (kind < 5) {
        let white = popcount(board.pieces(Color.White, kind_from_index(kind)));
        let black = popcount(board.pieces(Color.Black, kind_from_index(kind)));
        phase += (white + black) * PHASE_WEIGHT.at(kind);
        kind += 1;
    }
    if (phase > PHASE_TOTAL) {
        phase = PHASE_TOTAL;
    }
    return phase;
}

// Blend a middlegame and an endgame score by the phase. Integer division at
// the end keeps everything in centipawns.
fn taper(mg: int, eg: int, phase: int) -> int {
    return (mg * phase + eg * (PHASE_TOTAL - phase)) / PHASE_TOTAL;
}

// Material plus piece-square, for one colour, in both phases at once. The
// pair is returned through two out-parameters because the language has no
// tuples in its standard surface.
fn material_and_placement(board: Position, color: Color, ref mg: int, ref eg: int) {
    var mg_total: int = 0;
    var eg_total: int = 0;
    var kind: int = 0;
    while (kind < PIECE_KIND_COUNT) {
        var pieces = board.pieces(color, kind_from_index(kind));
        while (pieces != 0) {
            let square = bit_scan_forward(pieces);
            pieces = clear_lowest_bit(pieces);
            let indexed = relative_square(color, square);
            mg_total += MATERIAL_MG.at(kind) + PST_MG.at(kind).at(indexed);
            eg_total += MATERIAL_EG.at(kind) + PST_EG.at(kind).at(indexed);
        }
        kind += 1;
    }
    *mg = mg_total;
    *eg = eg_total;
}

// Mobility: the number of squares each piece attacks that are not occupied
// by a friendly piece and not attacked by an enemy pawn.
fn mobility_score(board: Position, color: Color) -> int {
    let them = opposite_color(color);
    let ours = board.pieces_of_color(color);
    let occupancy = board.occupied();
    let enemy_pawn_attacks = pawn_attack_span(them, board.pieces(them, PieceKind.Pawn));
    let allowed = FULL_BOARD ^ (ours | enemy_pawn_attacks);
    var total: int = 0;

    var knights = board.pieces(color, PieceKind.Knight);
    while (knights != 0) {
        let square = bit_scan_forward(knights);
        knights = clear_lowest_bit(knights);
        total += popcount(KNIGHT_ATTACKS.at(square) & allowed) * 4;
    }

    var bishops = board.pieces(color, PieceKind.Bishop);
    while (bishops != 0) {
        let square = bit_scan_forward(bishops);
        bishops = clear_lowest_bit(bishops);
        total += popcount(bishop_attacks(square, occupancy) & allowed) * 3;
    }

    var rooks = board.pieces(color, PieceKind.Rook);
    while (rooks != 0) {
        let square = bit_scan_forward(rooks);
        rooks = clear_lowest_bit(rooks);
        total += popcount(rook_attacks(square, occupancy) & allowed) * 2;
    }

    var queens = board.pieces(color, PieceKind.Queen);
    while (queens != 0) {
        let square = bit_scan_forward(queens);
        queens = clear_lowest_bit(queens);
        total += popcount(queen_attacks(square, occupancy) & allowed);
    }

    return total;
}

// Doubled, isolated, backward and passed pawns, plus the connected bonus.
fn pawn_structure_score(board: Position, color: Color) -> int {
    let them = opposite_color(color);
    let ours = board.pieces(color, PieceKind.Pawn);
    let theirs = board.pieces(them, PieceKind.Pawn);
    var score: int = 0;

    // Doubled pawns: count the extra pawns on every file.
    var file: int = 0;
    while (file < BOARD_FILES) {
        let on_file = popcount(ours & FILE_MASKS.at(file));
        if (on_file > 1) {
            score += PENALTY_DOUBLED_PAWN * (on_file - 1);
        }
        file += 1;
    }

    var pawns = ours;
    while (pawns != 0) {
        let square = bit_scan_forward(pawns);
        pawns = clear_lowest_bit(pawns);
        let f = file_of(square);

        // Isolated: no friendly pawn on either neighbouring file.
        if ((ours & ADJACENT_FILES.at(f)) == 0) {
            score += PENALTY_ISOLATED_PAWN;
        } else {
            // Connected: a friendly pawn defends it or stands beside it.
            let support = pawn_attack_span(them, 1 << square) & ours;
            if (support != 0) {
                score += BONUS_CONNECTED_PAWN;
            } else {
                // Backward: cannot advance without being met by a pawn.
                let stop = 1 << (square + pawn_push_delta(color));
                if ((pawn_attack_span(color, stop) & theirs) != 0) {
                    score += PENALTY_BACKWARD_PAWN;
                }
            }
        }

        // Passed: nothing in the three files ahead can stop it.
        if ((PASSED_MASK.at(color_index(color)).at(square) & theirs) == 0) {
            let advanced = relative_rank(color, square);
            score += BONUS_PASSED_BASE + BONUS_PASSED_RANK * advanced * advanced / 4;
        }
    }
    return score;
}

// Rooks like open and half-open files; the bishop pair is worth a pawn's
// worth of long-term pressure.
fn piece_bonus_score(board: Position, color: Color) -> int {
    let them = opposite_color(color);
    let ours = board.pieces(color, PieceKind.Pawn);
    let theirs = board.pieces(them, PieceKind.Pawn);
    var score: int = 0;

    var rooks = board.pieces(color, PieceKind.Rook);
    while (rooks != 0) {
        let square = bit_scan_forward(rooks);
        rooks = clear_lowest_bit(rooks);
        let mask = FILE_MASKS.at(file_of(square));
        if ((mask & ours) == 0) {
            if ((mask & theirs) == 0) {
                score += BONUS_ROOK_OPEN_FILE;
            } else {
                score += BONUS_ROOK_SEMI_OPEN;
            }
        }
        if (relative_rank(color, square) == 6) {
            score += 20;
        }
    }

    if (popcount(board.pieces(color, PieceKind.Bishop)) >= 2) {
        score += BONUS_BISHOP_PAIR;
    }
    return score;
}

// King safety: count the attackers into the king zone, weight them by piece
// value, and look up the ramp.
fn king_safety_score(board: Position, color: Color) -> int {
    let king = board.king_square(color);
    if (king == NO_SQUARE) {
        return 0;
    }
    let them = opposite_color(color);
    let zone = KING_ZONE.at(color_index(color)).at(king);
    let occupancy = board.occupied();
    var weight: int = 0;

    var knights = board.pieces(them, PieceKind.Knight);
    while (knights != 0) {
        let square = bit_scan_forward(knights);
        knights = clear_lowest_bit(knights);
        weight += popcount(KNIGHT_ATTACKS.at(square) & zone) * 2;
    }

    var bishops = board.pieces(them, PieceKind.Bishop);
    while (bishops != 0) {
        let square = bit_scan_forward(bishops);
        bishops = clear_lowest_bit(bishops);
        weight += popcount(bishop_attacks(square, occupancy) & zone) * 2;
    }

    var rooks = board.pieces(them, PieceKind.Rook);
    while (rooks != 0) {
        let square = bit_scan_forward(rooks);
        rooks = clear_lowest_bit(rooks);
        weight += popcount(rook_attacks(square, occupancy) & zone) * 3;
    }

    var queens = board.pieces(them, PieceKind.Queen);
    while (queens != 0) {
        let square = bit_scan_forward(queens);
        queens = clear_lowest_bit(queens);
        weight += popcount(queen_attacks(square, occupancy) & zone) * 5;
    }

    if (weight >= 64) {
        weight = 63;
    }
    var score = -KING_ATTACK_SCALE.at(weight);

    // A king on a file with no pawn of its own is exposed.
    let shelter = FILE_MASKS.at(file_of(king)) & board.pieces(color, PieceKind.Pawn);
    if (shelter == 0) {
        score += PENALTY_KING_EXPOSED;
    }
    return score;
}

// The whole evaluation, from the side to move's point of view.
fn evaluate(board: Position) -> int {
    let phase = game_phase(board);

    var white_mg: int = 0;
    var white_eg: int = 0;
    material_and_placement(board, Color.White, white_mg, white_eg);

    var black_mg: int = 0;
    var black_eg: int = 0;
    material_and_placement(board, Color.Black, black_mg, black_eg);

    var mg = white_mg - black_mg;
    var eg = white_eg - black_eg;

    let mobility = mobility_score(board, Color.White) - mobility_score(board, Color.Black);
    mg += mobility * MOBILITY_WEIGHT_MG / 4;
    eg += mobility * MOBILITY_WEIGHT_EG / 4;

    let structure = pawn_structure_score(board, Color.White) - pawn_structure_score(board, Color.Black);
    mg += structure;
    eg += structure * 3 / 2;

    let bonuses = piece_bonus_score(board, Color.White) - piece_bonus_score(board, Color.Black);
    mg += bonuses;
    eg += bonuses;

    let safety = king_safety_score(board, Color.White) - king_safety_score(board, Color.Black);
    mg += safety;
    eg += safety / 4;

    var score = taper(mg, eg, phase);
    if (board.side_to_move() == Color.Black) {
        score = -score;
    }
    return score + TEMPO_BONUS;
}

// A quick material-only score, used by the move ordering to sort captures
// most-valuable-victim first.
fn move_order_score(board: Position, m: int) -> int {
    if (move_is_promotion(m)) {
        return 900 + kind_index(move_promotion_kind(m)) * 10;
    }
    if (move_is_capture(m) == false) {
        return 0;
    }
    let victim = board.piece_at(move_to(m));
    let attacker = board.piece_at(move_from(m));
    var victim_value: int = 100;
    if (piece_is_empty(victim) == false) {
        victim_value = MATERIAL_MG.at(kind_index(piece_kind(victim)));
    }
    var attacker_value: int = 100;
    if (piece_is_empty(attacker) == false) {
        attacker_value = MATERIAL_MG.at(kind_index(piece_kind(attacker)));
    }
    return victim_value * 16 - attacker_value;
}

fn score_move_list(board: Position, ref list: MoveList) {
    var index: int = 0;
    while (index < list.size()) {
        let ref entry: auto = list.at(index);
        entry.score = move_order_score(board, entry.packed);
        index += 1;
    }
}

// --- Driver ---------------------------------------------------------------

// Build every table. Nothing in this file works before this has run, so the
// self-test below calls it first and the assert catches the mistake if a
// future caller forgets.
fn initialise() {
    init_tables();
    init_castle_masks();
    init_castle_paths();
    init_zobrist();
    init_material();
    init_pst_middlegame();
    init_pst_endgame();
    init_evaluation_masks();
    reset_perft_counters();
}

// Sanity checks on the tables themselves. A knight on a corner has two
// moves, one in the middle has eight, and the rays out of a corner cover
// exactly twenty-one squares.
fn verify_tables() -> bool {
    var ok: bool = true;

    if (popcount(KNIGHT_ATTACKS.at(SQ_A1)) != 2) {
        ok = false;
    }
    if (popcount(KNIGHT_ATTACKS.at(make_square(3, 3))) != 8) {
        ok = false;
    }
    if (popcount(KING_ATTACKS.at(SQ_A1)) != 3) {
        ok = false;
    }
    if (popcount(KING_ATTACKS.at(make_square(4, 4))) != 8) {
        ok = false;
    }
    if (popcount(rook_attacks(SQ_A1, 0)) != 14) {
        ok = false;
    }
    if (popcount(bishop_attacks(SQ_A1, 0)) != 7) {
        ok = false;
    }
    if (popcount(queen_attacks(SQ_A1, 0)) != 21) {
        ok = false;
    }
    if (popcount(FILE_MASKS.at(0)) != 8) {
        ok = false;
    }
    if (popcount(RANK_MASKS.at(7)) != 8) {
        ok = false;
    }
    if (popcount(LIGHT_SQUARES) != 32 or popcount(DARK_SQUARES) != 32) {
        ok = false;
    }
    if ((LIGHT_SQUARES & DARK_SQUARES) != 0) {
        ok = false;
    }

    // Every square must round-trip through the bit scans.
    var square: int = 0;
    while (square < SQUARE_COUNT) {
        let bit = 1 << square;
        if (bit_scan_forward(bit) != square) {
            ok = false;
        }
        if (bit_scan_reverse(bit) != square) {
            ok = false;
        }
        if (popcount(bit) != 1) {
            ok = false;
        }
        if (flip_rank(flip_rank(square)) != square) {
            ok = false;
        }
        square += 1;
    }

    // The between table must be symmetric and must exclude its endpoints.
    var from: int = 0;
    while (from < SQUARE_COUNT) {
        var to: int = 0;
        while (to < SQUARE_COUNT) {
            let segment = BETWEEN.at(from).at(to);
            if ((segment & ((1 << from) | (1 << to))) != 0) {
                ok = false;
            }
            if (segment != BETWEEN.at(to).at(from)) {
                ok = false;
            }
            to += 1;
        }
        from += 1;
    }

    Assert(ok);
    return ok;
}

// Perft from the start position. The expected counts are the ones every
// engine is checked against; a mismatch at depth n means the bug is in
// whatever was first exercised at depth n.
fn run_start_position_perft(depth: int) -> int {
    var board: Position;
    let parsed = parse_fen(board, START_FEN);
    Assert(parsed);

    var expected: vector(int) = vector(int)(7);
    expected.at(0) = 1;
    expected.at(1) = 20;
    expected.at(2) = 400;
    expected.at(3) = 8902;
    expected.at(4) = 197281;
    expected.at(5) = 4865609;
    expected.at(6) = 119060324;

    var total: int = 0;
    var current: int = 1;
    while (current <= depth) {
        let nodes = perft(board, current);
        total = nodes;

        var line: string;
        line.append("perft(");
        line.append(to_string(current));
        line.append(") = ");
        line.append(to_string(nodes));
        if (current < expected.size()) {
            if (nodes == expected.at(current)) {
                line.append(" ok");
            } else {
                line.append(" MISMATCH, expected ");
                line.append(to_string(expected.at(current)));
            }
        }
        println(line);
        Destroy(line);
        current += 1;
    }

    Destroy(expected);
    Destroy(board);
    return total;
}

// Walk a short game move by move, printing the SAN and the evaluation after
// each ply. This exercises make, unmake, notation and evaluation together.
fn run_notation_demo() {
    var board: Position;
    Discard(parse_fen(board, START_FEN));

    var script: vector(string);
    script.push_back("e2e4");
    script.push_back("e7e5");
    script.push_back("g1f3");
    script.push_back("b8c6");
    script.push_back("f1b5");
    script.push_back("a7a6");
    script.push_back("b5a4");
    script.push_back("g8f6");
    script.push_back("e1g1");

    var index: int = 0;
    while (index < script.size()) {
        let m = move_from_uci(board, script.at(index));
        if (move_is_null(m)) {
            println("illegal move in script");
            break;
        }

        var line: string;
        line.append(to_string(board.fullmove_number()));
        line.append(". ");
        line.append(move_to_san(board, m));
        line.append("  eval ");
        board.make_move(m);
        line.append(to_string(evaluate(board)));
        println(line);
        Destroy(line);
        index += 1;
    }

    println(board_to_text(board));
    println(to_fen(board));
    Destroy(script);
    Destroy(board);
}

// Generate, order and count the moves of a tactical position, then report
// how much work the generator did.
fn run_generation_report(fen: string, label: string) {
    var board: Position;
    if (parse_fen(board, fen) == false) {
        println("bad fen");
        Destroy(board);
        return;
    }

    var list: MoveList;
    board.generate_legal(list);
    score_move_list(board, list);

    var captures: int = 0;
    var promotions: int = 0;
    var castles: int = 0;
    var checks: int = 0;
    var index: int = 0;
    while (index < list.size()) {
        let m = list.packed_at(index);
        if (move_is_capture(m)) {
            captures += 1;
        }
        if (move_is_promotion(m)) {
            promotions += 1;
        }
        if (move_is_castle(m)) {
            castles += 1;
        }
        if (board.gives_check(m)) {
            checks += 1;
        }
        index += 1;
    }

    var line: string;
    line.append(label);
    line.append(": ");
    line.append(to_string(list.size()));
    line.append(" legal, ");
    line.append(to_string(captures));
    line.append(" captures, ");
    line.append(to_string(promotions));
    line.append(" promotions, ");
    line.append(to_string(castles));
    line.append(" castles, ");
    line.append(to_string(checks));
    line.append(" checks");
    println(line);
    Destroy(line);

    // Print the three best-ordered moves, which should be the fattest
    // captures.
    var shown: int = 0;
    while (shown < 3 and shown < list.size()) {
        Discard(list.select_best(shown));
        var entry: string;
        entry.append("  ");
        entry.append(move_to_uci(list.packed_at(shown)));
        entry.append(" score ");
        entry.append(to_string(list.at(shown).score));
        println(entry);
        Destroy(entry);
        shown += 1;
    }

    Destroy(list);
    Destroy(board);
}

// The whole self-test, in the order a new build should be checked.
fn self_test() -> bool {
    initialise();
    var ok = verify_tables();

    var board: Position;
    if (parse_fen(board, START_FEN) == false) {
        Destroy(board);
        return false;
    }

    // The start position has thirty-two pieces, sixteen a side, and twenty
    // legal first moves.
    if (board.total_piece_count() != 32) {
        ok = false;
    }
    if (popcount(board.pieces_of_color(Color.White)) != 16) {
        ok = false;
    }
    if (board.count_legal_moves() != 20) {
        ok = false;
    }
    if (board.in_check()) {
        ok = false;
    }
    if (board.castling_rights() != CASTLE_ALL) {
        ok = false;
    }
    if (board.hash_key() != board.compute_key()) {
        ok = false;
    }
    if (verify_make_unmake(board) == false) {
        ok = false;
    }

    // FEN must round-trip.
    let regenerated = to_fen(board);
    if (regenerated.compare(START_FEN) != 0) {
        ok = false;
    }

    run_generation_report(KIWIPETE_FEN, "kiwipete");
    run_generation_report(PROMOTION_FEN, "promotions");
    run_generation_report(ENDGAME_FEN, "endgame");
    Discard(run_start_position_perft({.depth = 4}));
    run_notation_demo();

    var stats: string;
    stats.append("moves generated: ");
    stats.append(to_string(generated_move_count));
    stats.append(", legality tests: ");
    stats.append(to_string(legality_test_count));
    stats.append(", attack queries: ");
    stats.append(to_string(attack_query_count));
    stats.append(", makes: ");
    stats.append(to_string(make_move_count));
    println(stats);
    Destroy(stats);

    Assert(ok);
    Destroy(board);
    return ok;
}


// A general purpose compression library.
//
// The library is organised as a stack of independent codecs that share one
// byte-oriented buffer type and one pair of bit-level cursors:
//
//   * `BitWriter` / `BitReader`          - MSB-first bit packing (deflate's
//                                          Huffman payloads are LSB-first,
//                                          its lengths are not, so both
//                                          orderings are provided).
//   * `Huffman`                          - frequency counting, a binary heap
//                                          for tree construction, canonical
//                                          code assignment, Kraft-based code
//                                          length limiting, and encode /
//                                          decode tables.
//   * `Lz77`                             - a sliding window with a hash chain
//                                          match finder, lazy matching and
//                                          five configurable levels.
//   * `Deflate`                          - the combined pipeline: stored,
//                                          fixed and dynamic block types.
//   * `Rle`, `Mtf`, `Bwt`                - the auxiliary transforms used by
//                                          the block sorting pipeline.
//   * `Arithmetic`                       - an adaptive binary/multi-symbol
//                                          range coder over a frequency model.
//   * `Crc32`, `Adler32`                 - checksums built from generated
//                                          tables rather than literal tables.
//
// Every polynomial and mask below is written as a plain decimal literal with
// the conventional hexadecimal spelling in a trailing comment, because the
// language only lexes decimal integer notation.
//
// Buffers are `vector{int}` where every element is constrained to the range
// [0, 255]; `byte` is not a distinct storage type here, the invariant is
// maintained by the accessors and checked with `assert` in the harness.
namespace compress;

// --- Bit and byte tunables ----------------------------------------------

let BYTE_BITS: int = 8;
let BYTE_MASK: int = 255;                    // 0xFF
let SHORT_BITS: int = 16;
let SHORT_MASK: int = 65535;                 // 0xFFFF
let WORD_BITS: int = 32;
let WORD_MASK: int = 4294967295;             // 0xFFFFFFFF
let NIBBLE_MASK: int = 15;                   // 0x0F
let HIGH_BIT_8: int = 128;                   // 0x80
let HIGH_BIT_16: int = 32768;                // 0x8000
let HIGH_BIT_32: int = 2147483648;           // 0x80000000

// --- Huffman tunables ----------------------------------------------------

// Deflate's alphabet sizes. The literal/length alphabet is 286 symbols, of
// which 0..255 are literals, 256 is end-of-block and 257..285 are lengths.
let MAX_SYMBOLS: int = 288;
let LITERAL_SYMBOLS: int = 286;
let END_OF_BLOCK: int = 256;
let DISTANCE_SYMBOLS: int = 30;
let CODE_LENGTH_SYMBOLS: int = 19;

// A canonical code may never be longer than this; the length limiter
// rebalances any tree that violates the bound.
let MAX_CODE_LENGTH: int = 15;
let MAX_LENGTH_CODE_BITS: int = 7;

// The decode table is a flat lookup of 2^ROOT_BITS entries; codes longer
// than ROOT_BITS spill into a secondary table reached through a link.
let ROOT_BITS: int = 9;
let ROOT_SIZE: int = 512;                    // 1 << 9
let SUB_BITS: int = 6;
let SUB_SIZE: int = 64;                      // 1 << 6

// --- LZ77 tunables -------------------------------------------------------

let WINDOW_BITS: int = 15;
let WINDOW_SIZE: int = 32768;                // 1 << 15
let WINDOW_MASK: int = 32767;                // 0x7FFF
let MIN_MATCH: int = 3;
let MAX_MATCH: int = 258;
let MAX_DISTANCE: int = 32768;

let HASH_BITS: int = 15;
let HASH_SIZE: int = 32768;                  // 1 << 15
let HASH_MASK: int = 32767;
let HASH_SHIFT: int = 5;                     // (HASH_BITS + 2) / 3
let NO_POSITION: int = -1;

// --- Block tunables ------------------------------------------------------

let STORED_BLOCK_MAX: int = 65535;
let DEFAULT_BLOCK_SIZE: int = 16384;
let MIN_BLOCK_SIZE: int = 256;

// --- Arithmetic coder tunables -------------------------------------------

// A 32 bit range coder: the interval is [low, low + range) with the top byte
// shifted out whenever the interval no longer straddles a byte boundary.
let CODER_TOP: int = 16777216;               // 1 << 24
let CODER_BOTTOM: int = 65536;               // 1 << 16
let CODER_MAX: int = 4294967295;             // 0xFFFFFFFF
let MODEL_TOTAL_MAX: int = 65536;
let MODEL_INCREMENT: int = 32;
let MODEL_RESCALE_SHIFT: int = 1;

// --- Checksum tunables ---------------------------------------------------

let CRC32_POLY: int = 3988292384;            // 0xEDB88320, reflected
let CRC32_INIT: int = 4294967295;            // 0xFFFFFFFF
let CRC32_TABLE_SIZE: int = 256;
let CRC32_SLICE_COUNT: int = 8;

let ADLER_BASE: int = 65521;
let ADLER_NMAX: int = 5552;

// A string literal stands in for the apostrophe character, which the lexer
// cannot express as an escaped char literal.
let APOSTROPHE: string = "'";

// --- Result codes --------------------------------------------------------

choice Status {
    Ok,
    NeedMoreInput,
    OutputFull,
    CorruptStream,
    BadCodeLengths,
    BadDistance,
    ChecksumMismatch,
    Unsupported,
}

choice BlockType {
    Stored,
    Fixed,
    Dynamic,
    Reserved,
}

choice BitOrder {
    MsbFirst,
    LsbFirst,
}

choice Level {
    Store,
    Fastest,
    Fast,
    Default,
    Best,
}

// --- Byte buffer ---------------------------------------------------------

// A growable byte buffer with a read cursor. Every codec in this file reads
// from and writes to one of these, so the bit cursors only ever need to know
// about a single container type.
class ByteBuffer {

    fn size(self) -> int {
        return self.data.size();
    }

    fn empty(self) -> bool {
        return self.data.size() == 0;
    }

    fn remaining(self) -> int {
        return self.data.size() - self.cursor;
    }

    fn exhausted(self) -> bool {
        return self.cursor >= self.data.size();
    }

    fn rewind(ref self) {
        self.cursor = 0;
    }

    fn clear(ref self) {
        self.data.clear();
        self.cursor = 0;
    }

    fn reserve(ref self, n: int) {
        self.data.reserve(n);
    }

    // Stores only the low eight bits; the caller is responsible for the
    // masking convention, but the assert keeps honest callers honest.
    fn push(ref self, value: int) {
        self.data.push_back(value & BYTE_MASK);
    }

    fn push_short_le(ref self, value: int) {
        self.push(value & BYTE_MASK);
        self.push((value >> BYTE_BITS) & BYTE_MASK);
    }

    fn push_short_be(ref self, value: int) {
        self.push((value >> BYTE_BITS) & BYTE_MASK);
        self.push(value & BYTE_MASK);
    }

    fn push_word_le(ref self, value: int) {
        self.push(value & BYTE_MASK);
        self.push((value >> 8) & BYTE_MASK);
        self.push((value >> 16) & BYTE_MASK);
        self.push((value >> 24) & BYTE_MASK);
    }

    fn push_word_be(ref self, value: int) {
        self.push((value >> 24) & BYTE_MASK);
        self.push((value >> 16) & BYTE_MASK);
        self.push((value >> 8) & BYTE_MASK);
        self.push(value & BYTE_MASK);
    }

    fn at(self, index: int) -> int {
        return self.data.at(index) & BYTE_MASK;
    }

    fn read(ref self) -> int {
        let value = self.data.at(self.cursor) & BYTE_MASK;
        self.cursor += 1;
        return value;
    }

    fn peek(self) -> int {
        return self.data.at(self.cursor) & BYTE_MASK;
    }

    fn peek_at(self, offset: int) -> int {
        return self.data.at(self.cursor + offset) & BYTE_MASK;
    }

    fn read_short_le(ref self) -> int {
        let low = self.read();
        let high = self.read();
        return low | (high << BYTE_BITS);
    }

    fn read_short_be(ref self) -> int {
        let high = self.read();
        let low = self.read();
        return (high << BYTE_BITS) | low;
    }

    fn read_word_le(ref self) -> int {
        let b0 = self.read();
        let b1 = self.read();
        let b2 = self.read();
        let b3 = self.read();
        return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
    }

    fn read_word_be(ref self) -> int {
        let b0 = self.read();
        let b1 = self.read();
        let b2 = self.read();
        let b3 = self.read();
        return (b0 << 24) | (b1 << 16) | (b2 << 8) | b3;
    }

    // Copy `count` bytes starting at `from` onto the end of the buffer. The
    // ranges are allowed to overlap; that is exactly what an LZ77 back
    // reference does when the distance is smaller than the length.
    fn copy_within(ref self, from: int, count: int) {
        var i: int = 0;
        while (i < count) {
            self.data.push_back(self.data.at(from + i) & BYTE_MASK);
            i += 1;
        }
    }

    fn append(ref self, other: ByteBuffer) {
        var i: int = 0;
        while (i < other.size()) {
            self.data.push_back(other.at(i));
            i += 1;
        }
    }

    fn equals(self, other: ByteBuffer) -> bool {
        if (self.data.size() != other.size()) {
            return false;
        }
        var i: int = 0;
        while (i < self.data.size()) {
            if ((self.data.at(i) & BYTE_MASK) != other.at(i)) {
                return false;
            }
            i += 1;
        }
        return true;
    }

    var data: vector(int);
    var cursor: int = 0;
}

// --- Bit writer ----------------------------------------------------------

// Packs codes into a byte buffer. A 32 bit accumulator holds the pending
// bits; whole bytes are flushed out of it as soon as eight bits are ready.
//
// In MSB-first order the first bit written becomes the high bit of the first
// output byte, which is what most container formats use for their headers.
// In LSB-first order the first bit written becomes bit 0, which is what
// deflate uses for Huffman codes.
class BitWriter {

    fn init(ref self, order: BitOrder) {
        self.order = order;
        self.accumulator = 0;
        self.bit_count = 0;
        self.bits_written = 0;
    }

    fn bit_position(self) -> int {
        return self.bits_written;
    }

    fn byte_position(self) -> int {
        return self.bits_written / BYTE_BITS;
    }

    fn is_aligned(self) -> bool {
        return self.bit_count == 0;
    }

    fn pending(self) -> int {
        return self.bit_count;
    }

    // Write a single bit. The two orderings differ only in which end of the
    // accumulator the new bit is grafted onto.
    fn put_bit(ref self, bit: int) {
        let value = bit & 1;
        if (self.order == BitOrder.MsbFirst) {
            self.accumulator = ((self.accumulator << 1) | value) & WORD_MASK;
        } else {
            self.accumulator = (self.accumulator | (value << self.bit_count)) & WORD_MASK;
        }
        self.bit_count += 1;
        self.bits_written += 1;
        if (self.bit_count == BYTE_BITS) {
            self.emit_byte();
        }
    }

    fn emit_byte(ref self) {
        if (self.order == BitOrder.MsbFirst) {
            self.out.push(self.accumulator & BYTE_MASK);
        } else {
            self.out.push(self.accumulator & BYTE_MASK);
        }
        self.accumulator = 0;
        self.bit_count = 0;
    }

    // Write `count` bits of `value`, most significant bit first. Long codes
    // go through the accumulator one bit at a time so the two orderings stay
    // in one code path; the fast paths below handle the common widths.
    fn put_bits_msb(ref self, value: int, count: int) {
        var i = count - 1;
        while (i >= 0) {
            self.put_bit((value >> i) & 1);
            i -= 1;
        }
    }

    // Write `count` bits of `value`, least significant bit first.
    fn put_bits_lsb(ref self, value: int, count: int) {
        var i: int = 0;
        while (i < count) {
            self.put_bit((value >> i) & 1);
            i += 1;
        }
    }

    fn put_bits(ref self, value: int, count: int) {
        if (self.order == BitOrder.MsbFirst) {
            self.put_bits_msb(value, count);
        } else {
            self.put_bits_lsb(value, count);
        }
    }

    // A Huffman code is stored most significant bit first but is emitted
    // into an LSB-first stream, so the bits come out reversed relative to
    // the code's numeric value.
    fn put_code(ref self, code: int, length: int) {
        if (self.order == BitOrder.LsbFirst) {
            var i = length - 1;
            while (i >= 0) {
                self.put_bit((code >> i) & 1);
                i -= 1;
            }
        } else {
            self.put_bits_msb(code, length);
        }
    }

    fn put_byte(ref self, value: int) {
        if (self.bit_count == 0) {
            self.out.push(value & BYTE_MASK);
            self.bits_written += BYTE_BITS;
        } else {
            self.put_bits(value & BYTE_MASK, BYTE_BITS);
        }
    }

    fn put_short(ref self, value: int) {
        self.put_byte(value & BYTE_MASK);
        self.put_byte((value >> BYTE_BITS) & BYTE_MASK);
    }

    fn put_word(ref self, value: int) {
        self.put_short(value & SHORT_MASK);
        self.put_short((value >> SHORT_BITS) & SHORT_MASK);
    }

    // Pad with zero bits until the next byte boundary.
    fn align(ref self) {
        while (self.bit_count != 0) {
            self.put_bit(0);
        }
    }

    // Pad with one bits instead; some framing formats use this so that a
    // truncated stream is detectable.
    fn align_ones(ref self) {
        while (self.bit_count != 0) {
            self.put_bit(1);
        }
    }

    fn flush(ref self) {
        self.align();
    }

    fn raw_copy(ref self, source: ByteBuffer, from: int, count: int) {
        self.align();
        var i: int = 0;
        while (i < count) {
            self.out.push(source.at(from + i));
            self.bits_written += BYTE_BITS;
            i += 1;
        }
    }

    var out: ByteBuffer;
    var accumulator: int = 0;
    var bit_count: int = 0;
    var bits_written: int = 0;
    var order: BitOrder = BitOrder.LsbFirst;
}

// --- Bit reader ----------------------------------------------------------

// The mirror image of `BitWriter`. The reader keeps a bit accumulator that
// is refilled a byte at a time, and exposes a `peek` operation because the
// table-driven Huffman decoder needs ROOT_BITS of lookahead before it knows
// how many bits the next symbol actually consumes.
class BitReader {

    fn init(ref self, order: BitOrder) {
        self.order = order;
        self.accumulator = 0;
        self.bit_count = 0;
        self.bits_read = 0;
        self.overrun = false;
    }

    fn bit_position(self) -> int {
        return self.bits_read;
    }

    fn byte_position(self) -> int {
        return self.source.cursor;
    }

    fn is_aligned(self) -> bool {
        return self.bit_count == 0;
    }

    fn available(self) -> int {
        return self.source.remaining() * BYTE_BITS + self.bit_count;
    }

    fn failed(self) -> bool {
        return self.overrun;
    }

    // Pull one byte into the accumulator. Reading past the end sets the
    // overrun flag and feeds zero bits so the decoder can unwind gracefully
    // instead of trapping.
    fn refill_byte(ref self) {
        if (self.source.exhausted()) {
            self.overrun = true;
            if (self.order == BitOrder.MsbFirst) {
                self.accumulator = (self.accumulator << BYTE_BITS) & WORD_MASK;
            } else {
                Discard(0);
            }
            self.bit_count += BYTE_BITS;
            return;
        }
        let byte_value = self.source.read();
        if (self.order == BitOrder.MsbFirst) {
            self.accumulator = ((self.accumulator << BYTE_BITS) | byte_value) & WORD_MASK;
        } else {
            self.accumulator = (self.accumulator | (byte_value << self.bit_count)) & WORD_MASK;
        }
        self.bit_count += BYTE_BITS;
    }

    // Guarantee at least `count` bits in the accumulator.
    fn refill(ref self, count: int) {
        while (self.bit_count < count) {
            self.refill_byte();
        }
    }

    fn get_bit(ref self) -> int {
        if (self.bit_count == 0) {
            self.refill_byte();
        }
        var bit: int = 0;
        if (self.order == BitOrder.MsbFirst) {
            bit = (self.accumulator >> (self.bit_count - 1)) & 1;
            self.bit_count -= 1;
            self.accumulator = self.accumulator & ((1 << self.bit_count) - 1);
        } else {
            bit = self.accumulator & 1;
            self.accumulator = (self.accumulator >> 1) & WORD_MASK;
            self.bit_count -= 1;
        }
        self.bits_read += 1;
        return bit;
    }

    fn get_bits_msb(ref self, count: int) -> int {
        var value: int = 0;
        var i: int = 0;
        while (i < count) {
            value = (value << 1) | self.get_bit();
            i += 1;
        }
        return value;
    }

    fn get_bits_lsb(ref self, count: int) -> int {
        var value: int = 0;
        var i: int = 0;
        while (i < count) {
            value = value | (self.get_bit() << i);
            i += 1;
        }
        return value;
    }

    fn get_bits(ref self, count: int) -> int {
        if (count == 0) {
            return 0;
        }
        if (self.order == BitOrder.MsbFirst) {
            return self.get_bits_msb(count);
        } else {
            return self.get_bits_lsb(count);
        }
    }

    // Look at the next `count` bits without consuming them. The value is
    // always returned in the reader's native order, which is what the flat
    // decode tables are indexed by.
    fn peek_bits(ref self, count: int) -> int {
        self.refill(count);
        if (self.order == BitOrder.MsbFirst) {
            return (self.accumulator >> (self.bit_count - count)) & ((1 << count) - 1);
        } else {
            return self.accumulator & ((1 << count) - 1);
        }
    }

    // Drop bits that a previous `peek_bits` reported on.
    fn drop_bits(ref self, count: int) {
        if (self.order == BitOrder.MsbFirst) {
            self.bit_count -= count;
            self.accumulator = self.accumulator & ((1 << self.bit_count) - 1);
        } else {
            self.accumulator = (self.accumulator >> count) & WORD_MASK;
            self.bit_count -= count;
        }
        self.bits_read += count;
    }

    fn get_byte(ref self) -> int {
        if (self.bit_count == 0) {
            if (self.source.exhausted()) {
                self.overrun = true;
                return 0;
            }
            self.bits_read += BYTE_BITS;
            return self.source.read();
        }
        return self.get_bits(BYTE_BITS);
    }

    fn get_short(ref self) -> int {
        let low = self.get_byte();
        let high = self.get_byte();
        return low | (high << BYTE_BITS);
    }

    fn get_word(ref self) -> int {
        let low = self.get_short();
        let high = self.get_short();
        return low | (high << SHORT_BITS);
    }

    // Discard the partial byte currently in the accumulator.
    fn align(ref self) {
        let drop = self.bit_count % BYTE_BITS;
        if (drop != 0) {
            self.drop_bits(drop);
        }
        self.accumulator = 0;
        self.bit_count = 0;
    }

    // Copy `count` raw bytes out of an aligned stream; used by stored blocks.
    fn raw_copy(ref self, ref sink: ByteBuffer, count: int) -> bool {
        self.align();
        if (self.source.remaining() < count) {
            self.overrun = true;
            return false;
        }
        var i: int = 0;
        while (i < count) {
            sink.push(self.source.read());
            self.bits_read += BYTE_BITS;
            i += 1;
        }
        return true;
    }

    var source: ByteBuffer;
    var accumulator: int = 0;
    var bit_count: int = 0;
    var bits_read: int = 0;
    var overrun: bool = false;
    var order: BitOrder = BitOrder.LsbFirst;
}

// Reverse the low `width` bits of `code`. Canonical Huffman codes are built
// MSB-first but written LSB-first, so the tables store the reversed form and
// the hot loop avoids the per-symbol reversal.
fn reverse_bits(code: int, width: int) -> int {
    var result: int = 0;
    var value = code;
    var i: int = 0;
    while (i < width) {
        result = (result << 1) | (value & 1);
        value = (value >> 1) & WORD_MASK;
        i += 1;
    }
    return result;
}

// Population count of a 32 bit word by the classic halving trick, written
// with explicit masks because the language has no hexadecimal literals.
fn popcount32(value: int) -> int {
    var v = value & WORD_MASK;
    v = v - ((v >> 1) & 1431655765);                            // 0x55555555
    v = (v & 858993459) + ((v >> 2) & 858993459);               // 0x33333333
    v = (v + (v >> 4)) & 252645135;                             // 0x0F0F0F0F
    v = v + (v >> 8);
    v = v + (v >> 16);
    return v & 63;
}

// Index of the highest set bit, or -1 for zero.
fn highest_bit(value: int) -> int {
    var v = value & WORD_MASK;
    if (v == 0) {
        return -1;
    }
    var position: int = 0;
    if ((v & 4294901760) != 0) {                                 // 0xFFFF0000
        v = (v >> 16) & SHORT_MASK;
        position += 16;
    }
    if ((v & 65280) != 0) {                                      // 0xFF00
        v = (v >> 8) & BYTE_MASK;
        position += 8;
    }
    if ((v & 240) != 0) {                                        // 0xF0
        v = (v >> 4) & NIBBLE_MASK;
        position += 4;
    }
    if ((v & 12) != 0) {                                         // 0x0C
        v = (v >> 2) & 3;
        position += 2;
    }
    if ((v & 2) != 0) {
        position += 1;
    }
    return position;
}

// Round up to the next power of two, saturating at 2^31.
fn round_up_pow2(value: int) -> int {
    if (value <= 1) {
        return 1;
    }
    var v = (value - 1) & WORD_MASK;
    v = v | (v >> 1);
    v = v | (v >> 2);
    v = v | (v >> 4);
    v = v | (v >> 8);
    v = v | (v >> 16);
    return (v + 1) & WORD_MASK;
}

// --- Frequency counting --------------------------------------------------

// A histogram over one alphabet. `total` and `used` are maintained
// incrementally so the tree builder never has to rescan the table.
class FrequencyTable {

    fn init(ref self, alphabet: int) {
        self.counts.clear();
        self.counts.resize(alphabet);
        var i: int = 0;
        while (i < alphabet) {
            self.counts.at(i) = 0;
            i += 1;
        }
        self.alphabet = alphabet;
        self.total = 0;
        self.used = 0;
    }

    fn size(self) -> int {
        return self.alphabet;
    }

    fn at(self, symbol: int) -> int {
        return self.counts.at(symbol);
    }

    fn add(ref self, symbol: int) {
        if (self.counts.at(symbol) == 0) {
            self.used += 1;
        }
        self.counts.at(symbol) += 1;
        self.total += 1;
    }

    fn add_many(ref self, symbol: int, count: int) {
        if (self.counts.at(symbol) == 0) {
            if (count > 0) {
                self.used += 1;
            }
        }
        self.counts.at(symbol) += count;
        self.total += count;
    }

    // Count every byte of a buffer. This is the hottest loop in the encoder
    // for incompressible input, so it does no bounds arithmetic beyond the
    // single mask.
    fn count_bytes(ref self, input: ByteBuffer) {
        var i: int = 0;
        let n = input.size();
        while (i < n) {
            let symbol = input.at(i) & BYTE_MASK;
            if (self.counts.at(symbol) == 0) {
                self.used += 1;
            }
            self.counts.at(symbol) += 1;
            i += 1;
        }
        self.total += n;
    }

    // Count pairs of adjacent bytes into a 65536 entry table; used by the
    // order-1 model in the arithmetic coder path.
    fn count_pairs(ref self, input: ByteBuffer) {
        if (input.size() < 2) {
            return;
        }
        var previous = input.at(0);
        var i: int = 1;
        while (i < input.size()) {
            let current = input.at(i);
            let symbol = ((previous & BYTE_MASK) << BYTE_BITS) | (current & BYTE_MASK);
            self.add(symbol);
            previous = current;
            i += 1;
        }
    }

    // Guarantee at least two used symbols. A Huffman tree over a single
    // symbol has no code at all, which every decoder would reject, so the
    // encoder pads the histogram with phantom counts.
    fn ensure_two_symbols(ref self) {
        var padded: int = 0;
        var symbol: int = 0;
        while (symbol < self.alphabet) {
            if (self.used >= 2) {
                return;
            }
            if (self.counts.at(symbol) == 0) {
                self.counts.at(symbol) = 1;
                self.used += 1;
                self.total += 1;
                padded += 1;
            }
            symbol += 1;
        }
        Discard(padded);
    }

    // Halve every non-zero count, rounding up. Adaptive encoders call this
    // when the running total would overflow the model's precision.
    fn rescale(ref self) {
        var new_total: int = 0;
        var new_used: int = 0;
        var i: int = 0;
        while (i < self.alphabet) {
            let count = self.counts.at(i);
            if (count > 0) {
                let halved = (count + 1) >> MODEL_RESCALE_SHIFT;
                self.counts.at(i) = halved;
                new_total += halved;
                new_used += 1;
            }
            i += 1;
        }
        self.total = new_total;
        self.used = new_used;
    }

    fn max_count(self) -> int {
        var best: int = 0;
        var i: int = 0;
        while (i < self.alphabet) {
            if (self.counts.at(i) > best) {
                best = self.counts.at(i);
            }
            i += 1;
        }
        return best;
    }

    // Shannon entropy of the histogram, scaled by 1000 and computed with an
    // integer logarithm so no floating point is involved.
    fn entropy_millibits(self) -> int {
        if (self.total == 0) {
            return 0;
        }
        var accumulated: int = 0;
        var i: int = 0;
        while (i < self.alphabet) {
            let count = self.counts.at(i);
            if (count > 0) {
                let ratio = (self.total * 1000) / count;
                accumulated += count * log2_millibits(ratio);
            }
            i += 1;
        }
        return accumulated / self.total;
    }

    var counts: vector(int);
    var alphabet: int = 0;
    var total: int = 0;
    var used: int = 0;
}

// Base-2 logarithm of a value scaled by 1000, returned in millibits. The
// fractional part comes from a small linear interpolation between adjacent
// powers of two, which is accurate enough for block type selection.
fn log2_millibits(scaled: int) -> int {
    if (scaled <= 1000) {
        return 0;
    }
    let whole = highest_bit(scaled / 1000);
    let residue = scaled / 1000;
    var fraction: int = 0;
    if (whole > 0) {
        let anchor = 1 << whole;
        fraction = ((residue - anchor) * 1000) / anchor;
    }
    return whole * 1000 + fraction;
}

// --- Huffman tree nodes --------------------------------------------------

// Nodes live in a flat array; -1 stands in for a null child. Leaves carry
// the symbol, internal nodes carry -1.
class HuffmanNode {

    fn is_leaf(self) -> bool {
        return self.left < 0 and self.right < 0;
    }

    fn is_internal(self) -> bool {
        return self.left >= 0 or self.right >= 0;
    }

    var weight: int = 0;
    var symbol: int = -1;
    var left: int = -1;
    var right: int = -1;
    var depth: int = 0;
}

// --- Priority queue ------------------------------------------------------

// A binary min-heap keyed on (weight, tie) so that tree construction is
// deterministic: two nodes of equal weight are ordered by insertion index,
// which makes the resulting code lengths reproducible across runs.
class NodeQueue {

    fn size(self) -> int {
        return self.heap.size();
    }

    fn empty(self) -> bool {
        return self.heap.size() == 0;
    }

    fn clear(ref self) {
        self.heap.clear();
        self.keys.clear();
        self.ties.clear();
        self.sequence = 0;
    }

    fn parent_of(self, index: int) -> int {
        return (index - 1) / 2;
    }

    fn left_of(self, index: int) -> int {
        return index * 2 + 1;
    }

    fn right_of(self, index: int) -> int {
        return index * 2 + 2;
    }

    // Strict weak ordering on the packed key.
    fn less(self, a: int, b: int) -> bool {
        if (self.keys.at(a) != self.keys.at(b)) {
            return self.keys.at(a) < self.keys.at(b);
        }
        return self.ties.at(a) < self.ties.at(b);
    }

    fn swap_entries(ref self, a: int, b: int) {
        swap(self.heap.at(a), self.heap.at(b));
        swap(self.keys.at(a), self.keys.at(b));
        swap(self.ties.at(a), self.ties.at(b));
    }

    fn push(ref self, node: int, weight: int) {
        self.heap.push_back(node);
        self.keys.push_back(weight);
        self.ties.push_back(self.sequence);
        self.sequence += 1;
        self.sift_up(self.heap.size() - 1);
    }

    fn sift_up(ref self, start: int) {
        var index = start;
        while (index > 0) {
            let parent = self.parent_of(index);
            if (not self.less(index, parent)) {
                return;
            }
            self.swap_entries(index, parent);
            index = parent;
        }
    }

    fn sift_down(ref self, start: int) {
        var index = start;
        let count = self.heap.size();
        while (true) {
            let left = self.left_of(index);
            if (left >= count) {
                return;
            }
            var smallest = left;
            let right = self.right_of(index);
            if (right < count) {
                if (self.less(right, left)) {
                    smallest = right;
                }
            }
            if (not self.less(smallest, index)) {
                return;
            }
            self.swap_entries(index, smallest);
            index = smallest;
        }
    }

    fn top(self) -> int {
        return self.heap.at(0);
    }

    fn top_weight(self) -> int {
        return self.keys.at(0);
    }

    fn pop(ref self) -> int {
        let result = self.heap.at(0);
        let last = self.heap.size() - 1;
        self.swap_entries(0, last);
        self.heap.pop_back();
        self.keys.pop_back();
        self.ties.pop_back();
        if (self.heap.size() > 1) {
            self.sift_down(0);
        }
        return result;
    }

    // Verify the heap invariant; the harness calls this after a build.
    fn is_heap(self) -> bool {
        var i: int = 1;
        while (i < self.heap.size()) {
            let parent = (i - 1) / 2;
            if (self.keys.at(i) < self.keys.at(parent)) {
                return false;
            }
            i += 1;
        }
        return true;
    }

    var heap: vector(int);
    var keys: vector(int);
    var ties: vector(int);
    var sequence: int = 0;
}

// --- Huffman tree --------------------------------------------------------

// Builds a Huffman tree from a histogram, derives code lengths, enforces a
// maximum length, and turns the lengths into canonical codes.
//
// The canonical form is the one every container format agrees on: symbols
// are sorted by (length, symbol) and codes are handed out in increasing
// numeric order, so the decoder only needs the length of each symbol.
class HuffmanTree {

    fn clear(ref self) {
        self.nodes.clear();
        self.lengths.clear();
        self.codes.clear();
        self.queue.clear();
        self.root = -1;
        self.max_length = 0;
        self.symbol_count = 0;
    }

    fn node_count(self) -> int {
        return self.nodes.size();
    }

    fn new_leaf(ref self, symbol: int, weight: int) -> int {
        var node = HuffmanNode();
        node.symbol = symbol;
        node.weight = weight;
        node.left = -1;
        node.right = -1;
        self.nodes.push_back(node);
        return self.nodes.size() - 1;
    }

    fn new_internal(ref self, left: int, right: int) -> int {
        var node = HuffmanNode();
        node.symbol = -1;
        node.left = left;
        node.right = right;
        node.weight = self.nodes.at(left).weight + self.nodes.at(right).weight;
        self.nodes.push_back(node);
        return self.nodes.size() - 1;
    }

    // Classic two-pop construction. Every used symbol becomes a leaf, then
    // the two lightest subtrees are repeatedly merged until one remains.
    fn build(ref self, frequencies: FrequencyTable) -> bool {
        self.clear();
        self.symbol_count = frequencies.size();
        self.lengths.resize(frequencies.size());
        self.codes.resize(frequencies.size());
        var symbol: int = 0;
        while (symbol < frequencies.size()) {
            self.lengths.at(symbol) = 0;
            self.codes.at(symbol) = 0;
            symbol += 1;
        }

        var leaves: int = 0;
        symbol = 0;
        while (symbol < frequencies.size()) {
            let weight = frequencies.at(symbol);
            if (weight > 0) {
                let node = self.new_leaf(symbol, weight);
                self.queue.push(node, weight);
                leaves += 1;
            }
            symbol += 1;
        }

        if (leaves == 0) {
            return false;
        }
        if (leaves == 1) {
            // Degenerate alphabet: give the single symbol a one bit code.
            let only = self.queue.pop();
            self.root = only;
            self.lengths.at(self.nodes.at(only).symbol) = 1;
            self.max_length = 1;
            self.assign_canonical();
            return true;
        }

        while (self.queue.size() > 1) {
            let left = self.queue.pop();
            let right = self.queue.pop();
            let merged = self.new_internal(left, right);
            self.queue.push(merged, self.nodes.at(merged).weight);
        }
        self.root = self.queue.pop();
        self.measure_depths(self.root, 0);
        if (self.max_length > MAX_CODE_LENGTH) {
            self.limit_code_lengths(MAX_CODE_LENGTH);
        }
        self.assign_canonical();
        return true;
    }

    // Walk the tree iteratively with an explicit stack, recording the depth
    // of every leaf. Recursion would be fine here but the iterative form is
    // what the production encoder uses, so the benchmark keeps it.
    fn measure_depths(ref self, root: int, anchor: int) {
        var stack_nodes = vector(int)();
        var stack_depths = vector(int)();
        stack_nodes.push_back(root);
        stack_depths.push_back(anchor);
        self.max_length = 0;
        while (not stack_nodes.empty()) {
            let node = stack_nodes.back();
            let depth = stack_depths.back();
            stack_nodes.pop_back();
            stack_depths.pop_back();
            let ref entry: auto = self.nodes.at(node);
            if (entry.is_leaf()) {
                self.lengths.at(entry.symbol) = depth;
                if (depth > self.max_length) {
                    self.max_length = depth;
                }
            } else {
                if (entry.left >= 0) {
                    stack_nodes.push_back(entry.left);
                    stack_depths.push_back(depth + 1);
                }
                if (entry.right >= 0) {
                    stack_nodes.push_back(entry.right);
                    stack_depths.push_back(depth + 1);
                }
            }
        }
        Destroy(stack_nodes);
        Destroy(stack_depths);
    }

    // Enforce a maximum code length using the Kraft sum.
    //
    // The Kraft sum of a prefix code is sum(2^-length) and equals exactly
    // 2^limit when the code is complete. Overlong codes are first clamped to
    // the limit, which pushes the sum above 2^limit; the excess is then paid
    // back by lengthening the shortest codes one bit at a time, starting
    // from the deepest, until the sum drops back to exactly 2^limit.
    fn limit_code_lengths(ref self, limit: int) {
        var histogram = vector(int)(MAX_CODE_LENGTH + 2);
        var i: int = 0;
        while (i < MAX_CODE_LENGTH + 2) {
            histogram.at(i) = 0;
            i += 1;
        }

        var symbol: int = 0;
        while (symbol < self.symbol_count) {
            var length = self.lengths.at(symbol);
            if (length > limit) {
                length = limit;
                self.lengths.at(symbol) = limit;
            }
            if (length > 0) {
                histogram.at(length) += 1;
            }
            symbol += 1;
        }

        // Kraft sum scaled so that a complete code sums to 1 << limit.
        var kraft: int = 0;
        var length: int = 1;
        while (length <= limit) {
            kraft += histogram.at(length) << (limit - length);
            length += 1;
        }

        let target = 1 << limit;
        while (kraft > target) {
            // Find the deepest length that still has a symbol to lengthen,
            // one level above the limit's floor, and move one symbol down.
            var donor = limit - 1;
            while (donor > 0) {
                if (histogram.at(donor) > 0) {
                    break;
                }
                donor -= 1;
            }
            if (donor == 0) {
                break;
            }
            histogram.at(donor) -= 1;
            histogram.at(donor + 1) += 1;
            if (donor + 1 < limit) {
                histogram.at(limit) -= 1;
                histogram.at(limit - 1) += 1;
            }
            kraft -= 1 << (limit - donor - 1);
        }

        // The sum may now sit below the target; hand the slack back to the
        // shortest codes so the code stays complete.
        while (kraft < target) {
            var taker = limit;
            while (taker > 0) {
                if (histogram.at(taker) > 0) {
                    break;
                }
                taker -= 1;
            }
            if (taker <= 1) {
                break;
            }
            histogram.at(taker) -= 1;
            histogram.at(taker - 1) += 1;
            kraft += 1 << (limit - taker);
        }

        self.rebuild_lengths_from_histogram(histogram, limit);
        Destroy(histogram);
    }

    // Re-hand out the adjusted lengths, giving the shortest codes to the
    // heaviest symbols. Symbols are visited in decreasing weight order,
    // which is what keeps the rebalanced code close to optimal.
    fn rebuild_lengths_from_histogram(ref self, histogram: vector(int), limit: int) {
        var order = vector(int)();
        var symbol: int = 0;
        while (symbol < self.symbol_count) {
            if (self.lengths.at(symbol) > 0) {
                order.push_back(symbol);
            }
            symbol += 1;
        }
        self.sort_by_weight(order);

        var cursor: int = 0;
        var length: int = 1;
        while (length <= limit) {
            var remaining = histogram.at(length);
            while (remaining > 0) {
                if (cursor >= order.size()) {
                    remaining = 0;
                } else {
                    self.lengths.at(order.at(cursor)) = length;
                    cursor += 1;
                    remaining -= 1;
                }
            }
            length += 1;
        }
        self.max_length = limit;
        Destroy(order);
    }

    // Insertion sort on symbol weight, descending. The arrays involved are
    // at most MAX_SYMBOLS long so the quadratic bound is irrelevant, and the
    // sort has to be stable for the canonical assignment to be reproducible.
    fn sort_by_weight(self, ref order: vector(int)) {
        var i: int = 1;
        while (i < order.size()) {
            let key = order.at(i);
            let key_weight = self.weight_of_symbol(key);
            var j = i - 1;
            while (j >= 0) {
                if (self.weight_of_symbol(order.at(j)) >= key_weight) {
                    break;
                }
                order.at(j + 1) = order.at(j);
                j -= 1;
            }
            order.at(j + 1) = key;
            i += 1;
        }
    }

    fn weight_of_symbol(self, symbol: int) -> int {
        var i: int = 0;
        while (i < self.nodes.size()) {
            let ref node: auto = self.nodes.at(i);
            if (node.is_leaf()) {
                if (node.symbol == symbol) {
                    return node.weight;
                }
            }
            i += 1;
        }
        return 0;
    }

    // Canonical assignment: count codes of each length, compute the first
    // code of each length, then hand codes out in symbol order.
    fn assign_canonical(ref self) {
        var count_per_length = vector(int)(MAX_CODE_LENGTH + 1);
        var next_code = vector(int)(MAX_CODE_LENGTH + 1);
        var i: int = 0;
        while (i <= MAX_CODE_LENGTH) {
            count_per_length.at(i) = 0;
            next_code.at(i) = 0;
            i += 1;
        }

        var symbol: int = 0;
        while (symbol < self.symbol_count) {
            let length = self.lengths.at(symbol);
            if (length > 0) {
                count_per_length.at(length) += 1;
            }
            symbol += 1;
        }

        var code: int = 0;
        count_per_length.at(0) = 0;
        var bits: int = 1;
        while (bits <= MAX_CODE_LENGTH) {
            code = (code + count_per_length.at(bits - 1)) << 1;
            next_code.at(bits) = code;
            bits += 1;
        }

        symbol = 0;
        while (symbol < self.symbol_count) {
            let length = self.lengths.at(symbol);
            if (length > 0) {
                self.codes.at(symbol) = next_code.at(length);
                next_code.at(length) += 1;
            } else {
                self.codes.at(symbol) = 0;
            }
            symbol += 1;
        }
        Destroy(count_per_length);
        Destroy(next_code);
    }

    // The Kraft sum must equal exactly 2^max_length for a complete code.
    fn kraft_sum(self) -> int {
        var total: int = 0;
        var symbol: int = 0;
        while (symbol < self.symbol_count) {
            let length = self.lengths.at(symbol);
            if (length > 0) {
                total += 1 << (self.max_length - length);
            }
            symbol += 1;
        }
        return total;
    }

    fn is_complete(self) -> bool {
        if (self.max_length == 0) {
            return false;
        }
        return self.kraft_sum() == (1 << self.max_length);
    }

    // Total compressed size of the alphabet under this code, in bits.
    fn encoded_bits(self, frequencies: FrequencyTable) -> int {
        var total: int = 0;
        var symbol: int = 0;
        while (symbol < self.symbol_count) {
            total += self.lengths.at(symbol) * frequencies.at(symbol);
            symbol += 1;
        }
        return total;
    }

    var nodes: vector(HuffmanNode);
    var queue: NodeQueue;
    var lengths: vector(int);
    var codes: vector(int);
    var root: int = -1;
    var max_length: int = 0;
    var symbol_count: int = 0;
}

// --- Encode table --------------------------------------------------------

// Flattens a tree's canonical codes into two parallel arrays plus a
// pre-reversed copy for LSB-first output. Writing a symbol then costs one
// array read and one `put_code`.
class EncodeTable {

    fn build(ref self, tree: HuffmanTree) {
        self.codes.clear();
        self.lengths.clear();
        self.reversed.clear();
        self.codes.resize(tree.symbol_count);
        self.lengths.resize(tree.symbol_count);
        self.reversed.resize(tree.symbol_count);
        self.symbol_count = tree.symbol_count;
        self.max_length = tree.max_length;
        var symbol: int = 0;
        while (symbol < tree.symbol_count) {
            let length = tree.lengths.at(symbol);
            let code = tree.codes.at(symbol);
            self.lengths.at(symbol) = length;
            self.codes.at(symbol) = code;
            self.reversed.at(symbol) = reverse_bits(code, length);
            symbol += 1;
        }
    }

    // Build directly from a length vector, which is what the decoder side
    // does when it reconstructs a dynamic block's code from the header.
    fn build_from_lengths(ref self, lengths: vector(int)) {
        self.codes.clear();
        self.lengths.clear();
        self.reversed.clear();
        self.codes.resize(lengths.size());
        self.lengths.resize(lengths.size());
        self.reversed.resize(lengths.size());
        self.symbol_count = lengths.size();
        self.max_length = 0;

        var count_per_length = vector(int)(MAX_CODE_LENGTH + 1);
        var i: int = 0;
        while (i <= MAX_CODE_LENGTH) {
            count_per_length.at(i) = 0;
            i += 1;
        }
        var symbol: int = 0;
        while (symbol < lengths.size()) {
            let length = lengths.at(symbol);
            self.lengths.at(symbol) = length;
            if (length > 0) {
                count_per_length.at(length) += 1;
                if (length > self.max_length) {
                    self.max_length = length;
                }
            }
            symbol += 1;
        }

        var next_code = vector(int)(MAX_CODE_LENGTH + 1);
        var code: int = 0;
        count_per_length.at(0) = 0;
        var bits: int = 1;
        while (bits <= MAX_CODE_LENGTH) {
            code = (code + count_per_length.at(bits - 1)) << 1;
            next_code.at(bits) = code;
            bits += 1;
        }

        symbol = 0;
        while (symbol < lengths.size()) {
            let length = self.lengths.at(symbol);
            if (length > 0) {
                let assigned = next_code.at(length);
                next_code.at(length) += 1;
                self.codes.at(symbol) = assigned;
                self.reversed.at(symbol) = reverse_bits(assigned, length);
            } else {
                self.codes.at(symbol) = 0;
                self.reversed.at(symbol) = 0;
            }
            symbol += 1;
        }
        Destroy(count_per_length);
        Destroy(next_code);
    }

    fn length_of(self, symbol: int) -> int {
        return self.lengths.at(symbol);
    }

    fn code_of(self, symbol: int) -> int {
        return self.codes.at(symbol);
    }

    fn has_code(self, symbol: int) -> bool {
        return self.lengths.at(symbol) > 0;
    }

    fn emit(self, ref writer: BitWriter, symbol: int) {
        writer.put_code(self.codes.at(symbol), self.lengths.at(symbol));
    }

    // Fast path for an LSB-first stream: the reversal has already been paid
    // for at table build time.
    fn emit_reversed(self, ref writer: BitWriter, symbol: int) {
        writer.put_bits_lsb(self.reversed.at(symbol), self.lengths.at(symbol));
    }

    var codes: vector(int);
    var reversed: vector(int);
    var lengths: vector(int);
    var symbol_count: int = 0;
    var max_length: int = 0;
}

// --- Decode table --------------------------------------------------------

// One entry of the flat decode table. A code shorter than ROOT_BITS is
// replicated across every index whose low bits match it, so a single lookup
// resolves the symbol. Longer codes store a link to a secondary table.
class DecodeEntry {

    fn is_link(self) -> bool {
        return self.sub_table >= 0;
    }

    fn is_valid(self) -> bool {
        return self.bits > 0;
    }

    var symbol: int = -1;
    var bits: int = 0;
    var sub_table: int = -1;
    var sub_bits: int = 0;
}

// Two-level table-driven decoder.
//
// The root table is indexed by the next ROOT_BITS of the stream, read in the
// stream's native order. Because deflate writes codes LSB-first, the index a
// code occupies is the code's bit-reversal, and every longer index sharing
// that suffix maps to the same entry. That is the replication loop below,
// which strides by `1 << length` over the whole root table.
class DecodeTable {

    fn clear(ref self) {
        self.root.clear();
        self.sub.clear();
        self.symbol_count = 0;
        self.max_length = 0;
        self.under_subscribed = false;
    }

    fn root_size(self) -> int {
        return self.root.size();
    }

    fn build(ref self, lengths: vector(int)) -> bool {
        self.clear();
        self.symbol_count = lengths.size();

        var count_per_length = vector(int)(MAX_CODE_LENGTH + 1);
        var i: int = 0;
        while (i <= MAX_CODE_LENGTH) {
            count_per_length.at(i) = 0;
            i += 1;
        }
        var used: int = 0;
        var symbol: int = 0;
        while (symbol < lengths.size()) {
            let length = lengths.at(symbol);
            if (length > 0) {
                if (length > MAX_CODE_LENGTH) {
                    Destroy(count_per_length);
                    return false;
                }
                count_per_length.at(length) += 1;
                used += 1;
                if (length > self.max_length) {
                    self.max_length = length;
                }
            }
            symbol += 1;
        }
        if (used == 0) {
            self.under_subscribed = true;
            Destroy(count_per_length);
            return false;
        }

        // Over-subscribed codes are corrupt; under-subscribed ones are only
        // legal for the degenerate single-symbol distance code.
        var left: int = 1;
        var bits: int = 1;
        while (bits <= MAX_CODE_LENGTH) {
            left = left << 1;
            left -= count_per_length.at(bits);
            if (left < 0) {
                Destroy(count_per_length);
                return false;
            }
            bits += 1;
        }
        if (left > 0) {
            self.under_subscribed = true;
            if (used != 1) {
                Destroy(count_per_length);
                return false;
            }
        }

        var next_code = vector(int)(MAX_CODE_LENGTH + 1);
        var code: int = 0;
        bits = 1;
        while (bits <= MAX_CODE_LENGTH) {
            code = (code + count_per_length.at(bits - 1)) << 1;
            next_code.at(bits) = code;
            bits += 1;
        }

        let root_bits = min_int(ROOT_BITS, self.max_length);
        let root_count = 1 << root_bits;
        self.root.resize(root_count);
        var slot: int = 0;
        while (slot < root_count) {
            var blank = DecodeEntry();
            blank.symbol = -1;
            blank.bits = 0;
            blank.sub_table = -1;
            self.root.at(slot) = blank;
            slot += 1;
        }
        self.root_bits = root_bits;

        symbol = 0;
        while (symbol < lengths.size()) {
            let length = lengths.at(symbol);
            if (length > 0) {
                let assigned = next_code.at(length);
                next_code.at(length) += 1;
                let index = reverse_bits(assigned, length);
                if (length <= root_bits) {
                    self.fill_root(index, length, symbol, root_bits);
                } else {
                    self.fill_sub(index, length, symbol, root_bits);
                }
            }
            symbol += 1;
        }

        Destroy(count_per_length);
        Destroy(next_code);
        return true;
    }

    // Replicate a short code across every root index that ends in it.
    fn fill_root(ref self, index: int, length: int, symbol: int, root_bits: int) {
        let stride = 1 << length;
        let limit = 1 << root_bits;
        var slot = index;
        while (slot < limit) {
            var entry = DecodeEntry();
            entry.symbol = symbol;
            entry.bits = length;
            entry.sub_table = -1;
            entry.sub_bits = 0;
            self.root.at(slot) = entry;
            slot += stride;
        }
    }

    // Route a long code through a secondary table. The root entry records
    // where the secondary table starts and how many extra bits it consumes.
    fn fill_sub(ref self, index: int, length: int, symbol: int, root_bits: int) {
        let root_index = index & ((1 << root_bits) - 1);
        let extra = length - root_bits;
        var anchor = self.root.at(root_index).sub_table;
        if (anchor < 0) {
            anchor = self.sub.size();
            let span = 1 << SUB_BITS;
            var i: int = 0;
            while (i < span) {
                var blank = DecodeEntry();
                blank.symbol = -1;
                blank.bits = 0;
                blank.sub_table = -1;
                self.sub.push_back(blank);
                i += 1;
            }
            var link = DecodeEntry();
            link.symbol = -1;
            link.bits = root_bits;
            link.sub_table = anchor;
            link.sub_bits = SUB_BITS;
            self.root.at(root_index) = link;
        }

        let sub_index = (index >> root_bits) & ((1 << SUB_BITS) - 1);
        let stride = 1 << extra;
        let limit = 1 << SUB_BITS;
        var slot = sub_index;
        while (slot < limit) {
            var entry = DecodeEntry();
            entry.symbol = symbol;
            entry.bits = extra;
            entry.sub_table = -1;
            entry.sub_bits = 0;
            self.sub.at(anchor + slot) = entry;
            slot += stride;
        }
    }

    // Decode one symbol. Peek enough bits for the root lookup, consume only
    // as many as the code actually uses, and follow a link if present.
    fn decode(self, ref reader: BitReader) -> int {
        let peeked = reader.peek_bits(self.root_bits);
        let ref entry: auto = self.root.at(peeked);
        if (entry.bits == 0) {
            return -1;
        }
        if (not entry.is_link()) {
            reader.drop_bits(entry.bits);
            return entry.symbol;
        }
        reader.drop_bits(self.root_bits);
        let extra = reader.peek_bits(entry.sub_bits);
        let ref leaf: auto = self.sub.at(entry.sub_table + extra);
        if (leaf.bits == 0) {
            return -1;
        }
        reader.drop_bits(leaf.bits);
        return leaf.symbol;
    }

    // Slow reference decoder that walks the code bit by bit. Used by the
    // harness to cross-check the table-driven path.
    fn decode_slow(self, ref reader: BitReader, lengths: vector(int)) -> int {
        var code: int = 0;
        var length: int = 0;
        var first: int = 0;
        var index: int = 0;
        var count_per_length = vector(int)(MAX_CODE_LENGTH + 1);
        var i: int = 0;
        while (i <= MAX_CODE_LENGTH) {
            count_per_length.at(i) = 0;
            i += 1;
        }
        var symbol: int = 0;
        while (symbol < lengths.size()) {
            if (lengths.at(symbol) > 0) {
                count_per_length.at(lengths.at(symbol)) += 1;
            }
            symbol += 1;
        }

        while (length < MAX_CODE_LENGTH) {
            length += 1;
            code = code | reader.get_bit();
            let count = count_per_length.at(length);
            if (code - first < count) {
                Destroy(count_per_length);
                return index + (code - first);
            }
            index += count;
            first = (first + count) << 1;
            code = code << 1;
        }
        Destroy(count_per_length);
        return -1;
    }

    var root: vector(DecodeEntry);
    var sub: vector(DecodeEntry);
    var root_bits: int = 9;
    var max_length: int = 0;
    var symbol_count: int = 0;
    var under_subscribed: bool = false;
}

fn min_int(a: int, b: int) -> int {
    if (a < b) {
        return a;
    }
    return b;
}

fn max_int(a: int, b: int) -> int {
    if (a > b) {
        return a;
    }
    return b;
}

fn clamp_int(value: int, low: int, high: int) -> int {
    if (value < low) {
        return low;
    }
    if (value > high) {
        return high;
    }
    return value;
}

// --- LZ77 tokens ---------------------------------------------------------

// A token is either a literal byte or a (length, distance) back reference.
// Packing both into one struct keeps the token stream contiguous, which
// matters because the block splitter walks it several times.
class Token {

    fn is_literal(self) -> bool {
        return self.length < MIN_MATCH;
    }

    fn is_match(self) -> bool {
        return self.length >= MIN_MATCH;
    }

    fn cost_estimate(self) -> int {
        if (self.is_literal()) {
            return 8;
        }
        // A rough model: the length code plus the distance code plus their
        // extra bits. Good enough to decide between block types.
        return 24 + extra_length_bits(length_code_of(self.length)) + extra_distance_bits(distance_code_of(self.distance));
    }

    var literal: int = 0;
    var length: int = 0;
    var distance: int = 0;
}

// A candidate match returned by the match finder.
class Match {

    fn valid(self) -> bool {
        return self.length >= MIN_MATCH and self.distance > 0 and self.distance <= MAX_DISTANCE;
    }

    fn better_than(self, other: Match) -> bool {
        if (self.length != other.length) {
            return self.length > other.length;
        }
        // Equal lengths: prefer the nearer match, its distance code is
        // cheaper to encode.
        return self.distance < other.distance;
    }

    var length: int = 0;
    var distance: int = 0;
    var position: int = 0;
}

// --- Compression levels --------------------------------------------------

// The knobs the match finder honours. Higher levels search longer chains and
// enable lazy matching; the lowest level skips the finder entirely.
class LevelConfig {

    fn from_level(ref self, level: int) {
        let clamped = clamp_int(level, 0, 9);
        if (clamped == 0) {
            self.good_length = 0;
            self.max_lazy = 0;
            self.nice_length = 0;
            self.max_chain = 0;
            self.use_lazy = false;
            self.stored_only = true;
        } else { if (clamped <= 2) {
            self.good_length = 4;
            self.max_lazy = 4;
            self.nice_length = 8;
            self.max_chain = 4;
            self.use_lazy = false;
            self.stored_only = false;
        } else { if (clamped <= 4) {
            self.good_length = 4;
            self.max_lazy = 5;
            self.nice_length = 16;
            self.max_chain = 16;
            self.use_lazy = true;
            self.stored_only = false;
        } else { if (clamped <= 6) {
            self.good_length = 8;
            self.max_lazy = 16;
            self.nice_length = 32;
            self.max_chain = 32;
            self.use_lazy = true;
            self.stored_only = false;
        } else { if (clamped <= 8) {
            self.good_length = 8;
            self.max_lazy = 32;
            self.nice_length = 128;
            self.max_chain = 128;
            self.use_lazy = true;
            self.stored_only = false;
        } else {
            self.good_length = 32;
            self.max_lazy = 258;
            self.nice_length = 258;
            self.max_chain = 4096;
            self.use_lazy = true;
            self.stored_only = false;
        }
        } } } }
        self.level = clamped;
    }

    // When the previous match was already long, the chain search is cut
    // short: the odds of finding something better do not pay for the walk.
    fn chain_limit_for(self, previous_length: int) -> int {
        if (previous_length >= self.good_length) {
            return self.max_chain >> 2;
        }
        return self.max_chain;
    }

    var level: int = 6;
    var good_length: int = 8;
    var max_lazy: int = 16;
    var nice_length: int = 32;
    var max_chain: int = 32;
    var use_lazy: bool = true;
    var stored_only: bool = false;
}

// --- Hash chain match finder ---------------------------------------------

// The classic deflate finder: a rolling three-byte hash indexes a head
// table, and every head entry starts a chain of earlier positions with the
// same hash, threaded through a `previous` array indexed by window offset.
class HashChain {

    fn init(ref self) {
        self.head.clear();
        self.head.resize(HASH_SIZE);
        var i: int = 0;
        while (i < HASH_SIZE) {
            self.head.at(i) = NO_POSITION;
            i += 1;
        }
        self.previous.clear();
        self.previous.resize(WINDOW_SIZE);
        i = 0;
        while (i < WINDOW_SIZE) {
            self.previous.at(i) = NO_POSITION;
            i += 1;
        }
        self.running_hash = 0;
        self.inserted = 0;
    }

    // Rolling hash update: shift the accumulator left by HASH_SHIFT, mix in
    // the new byte, and mask back down to HASH_BITS. After MIN_MATCH updates
    // the accumulator depends on exactly the last three bytes.
    fn update_hash(ref self, next_byte: int) -> int {
        self.running_hash = ((self.running_hash << HASH_SHIFT) ^ (next_byte & BYTE_MASK)) & HASH_MASK;
        return self.running_hash;
    }

    // Compute the hash of the three bytes at `position` without touching the
    // rolling state; used when the finder skips ahead.
    fn hash_at(self, input: ByteBuffer, position: int) -> int {
        if (position + MIN_MATCH > input.size()) {
            return 0;
        }
        var h: int = 0;
        h = ((h << HASH_SHIFT) ^ input.at(position)) & HASH_MASK;
        h = ((h << HASH_SHIFT) ^ input.at(position + 1)) & HASH_MASK;
        h = ((h << HASH_SHIFT) ^ input.at(position + 2)) & HASH_MASK;
        return h;
    }

    fn insert(ref self, hash_value: int, position: int) {
        let slot = position & WINDOW_MASK;
        self.previous.at(slot) = self.head.at(hash_value);
        self.head.at(hash_value) = position;
        self.inserted += 1;
    }

    // Insert every position in [from, to) so that later searches see them.
    // The encoder calls this after emitting a long match, because the bytes
    // covered by the match still need to be hashed.
    fn insert_range(ref self, input: ByteBuffer, from: int, to: int) {
        var position = from;
        while (position < to) {
            if (position + MIN_MATCH <= input.size()) {
                self.insert(self.hash_at(input, position), position);
            }
            position += 1;
        }
    }

    // Length of the common prefix of the two positions, capped at `limit`.
    // This is the innermost loop of the whole encoder.
    fn match_length(self, input: ByteBuffer, a: int, b: int, limit: int) -> int {
        var length: int = 0;
        while (length < limit) {
            if (input.at(a + length) != input.at(b + length)) {
                return length;
            }
            length += 1;
        }
        return limit;
    }

    // Walk the chain for `position`, returning the best match found. The
    // walk stops at the chain limit, at the window edge, or as soon as a
    // match reaches `nice_length`.
    fn find_best(self, input: ByteBuffer, position: int, previous_length: int, config: LevelConfig) -> Match {
        var best = Match();
        best.length = 0;
        best.distance = 0;
        best.position = position;

        if (position + MIN_MATCH > input.size()) {
            return best;
        }
        let limit = min_int(MAX_MATCH, input.size() - position);
        if (limit < MIN_MATCH) {
            return best;
        }

        let hash_value = self.hash_at(input, position);
        var candidate = self.head.at(hash_value);
        var chain_left = self.chain_limit_of(previous_length, config);
        let window_floor = max_int(0, position - MAX_DISTANCE);

        while (candidate >= 0) {
            if (chain_left <= 0) {
                break;
            }
            chain_left -= 1;
            if (candidate < window_floor) {
                break;
            }
            if (candidate >= position) {
                break;
            }

            // Cheap rejection: the byte one past the current best has to
            // match, otherwise the candidate cannot possibly be longer.
            var worth_trying = true;
            if (best.length > 0) {
                if (input.at(candidate + best.length) != input.at(position + best.length)) {
                    worth_trying = false;
                }
            }
            if (worth_trying) {
                let length = self.match_length(input, candidate, position, limit);
                if (length >= MIN_MATCH) {
                    if (length > best.length) {
                        best.length = length;
                        best.distance = position - candidate;
                        if (length >= config.nice_length) {
                            return best;
                        }
                    }
                }
            }
            candidate = self.previous.at(candidate & WINDOW_MASK);
        }
        return best;
    }

    fn chain_limit_of(self, previous_length: int, config: LevelConfig) -> int {
        return config.chain_limit_for(previous_length);
    }

    // Diagnostic: average chain length over the whole head table.
    fn average_chain(self) -> int {
        var total: int = 0;
        var chains: int = 0;
        var i: int = 0;
        while (i < HASH_SIZE) {
            var node = self.head.at(i);
            if (node >= 0) {
                chains += 1;
                var depth: int = 0;
                while (node >= 0) {
                    if (depth >= 64) {
                        break;
                    }
                    depth += 1;
                    node = self.previous.at(node & WINDOW_MASK);
                }
                total += depth;
            }
            i += 1;
        }
        if (chains == 0) {
            return 0;
        }
        return total / chains;
    }

    var head: vector(int);
    var previous: vector(int);
    var running_hash: int = 0;
    var inserted: int = 0;
}

// --- Sliding window ------------------------------------------------------

// A circular history buffer of WINDOW_SIZE bytes. The decoder needs one to
// resolve back references; the encoder keeps the whole input in memory and
// uses absolute positions instead, so the window is decode-side only.
class SlidingWindow {

    fn init(ref self, capacity: int) {
        self.bytes.clear();
        self.bytes.resize(capacity);
        var i: int = 0;
        while (i < capacity) {
            self.bytes.at(i) = 0;
            i += 1;
        }
        self.capacity = capacity;
        self.mask = capacity - 1;
        self.write_position = 0;
        self.filled = 0;
    }

    fn size(self) -> int {
        return self.filled;
    }

    fn full(self) -> bool {
        return self.filled >= self.capacity;
    }

    fn wrap(self, position: int) -> int {
        return position & self.mask;
    }

    fn push(ref self, value: int) {
        self.bytes.at(self.write_position) = value & BYTE_MASK;
        self.write_position = (self.write_position + 1) & self.mask;
        if (self.filled < self.capacity) {
            self.filled += 1;
        }
    }

    // Byte `distance` positions back from the write cursor.
    fn behind(self, distance: int) -> int {
        let index = (self.write_position - distance) & self.mask;
        return self.bytes.at(index) & BYTE_MASK;
    }

    fn can_reference(self, distance: int) -> bool {
        return distance > 0 and distance <= self.filled;
    }

    // Copy a back reference out of the window and into the sink, feeding
    // every copied byte back into the window. Overlapping copies work
    // because each byte is written before the byte that references it is
    // read, which is exactly the run-extension trick LZ77 relies on.
    fn copy_match(ref self, ref sink: ByteBuffer, distance: int, length: int) -> bool {
        if (not self.can_reference(distance)) {
            return false;
        }
        var i: int = 0;
        while (i < length) {
            let value = self.behind(distance);
            sink.push(value);
            self.push(value);
            i += 1;
        }
        return true;
    }

    fn emit_literal(ref self, ref sink: ByteBuffer, value: int) {
        sink.push(value & BYTE_MASK);
        self.push(value & BYTE_MASK);
    }

    var bytes: vector(int);
    var capacity: int = 32768;
    var mask: int = 32767;
    var write_position: int = 0;
    var filled: int = 0;
}

// --- LZ77 encoder --------------------------------------------------------

// Produces a token stream from a byte buffer using the hash chain finder.
//
// Lazy matching: after finding a match at position p, the encoder also looks
// at p+1. If the later match is strictly longer, the byte at p is emitted as
// a literal and the longer match is taken instead. This costs one extra
// chain walk per position but typically buys a few percent.
class Lz77Encoder {

    fn init(ref self, level: int) {
        self.config.from_level(level);
        self.chain.init();
        self.tokens.clear();
        self.literal_count = 0;
        self.match_count = 0;
        self.matched_bytes = 0;
        self.literal_bytes = 0;
    }

    fn token_count(self) -> int {
        return self.tokens.size();
    }

    fn push_literal(ref self, value: int) {
        var token = Token();
        token.literal = value & BYTE_MASK;
        token.length = 0;
        token.distance = 0;
        self.tokens.push_back(token);
        self.literal_count += 1;
        self.literal_bytes += 1;
    }

    fn push_match(ref self, length: int, distance: int) {
        var token = Token();
        token.literal = 0;
        token.length = length;
        token.distance = distance;
        self.tokens.push_back(token);
        self.match_count += 1;
        self.matched_bytes += length;
    }

    // The main loop. `position` is the next byte to encode; `pending`
    // carries the match found at the previous position while the encoder
    // decides whether to keep it.
    fn encode(ref self, input: ByteBuffer) {
        self.tokens.clear();
        if (self.config.stored_only) {
            var i: int = 0;
            while (i < input.size()) {
                self.push_literal(input.at(i));
                i += 1;
            }
            return;
        }

        var position: int = 0;
        var have_pending = false;
        var pending = Match();
        pending.length = 0;
        pending.distance = 0;
        pending.position = 0;

        while (position < input.size()) {
            var current = Match();
            current.length = 0;
            current.distance = 0;
            current.position = position;
            if (position + MIN_MATCH <= input.size()) {
                var previous_length: int = 0;
                if (have_pending) {
                    previous_length = pending.length;
                }
                current = self.chain.find_best(input, position, previous_length, self.config);
            }

            if (have_pending) {
                if (current.length > pending.length) {
                    // The later match wins: flush the deferred byte as a
                    // literal and defer again on the new candidate.
                    self.push_literal(input.at(pending.position));
                    self.insert_position(input, pending.position);
                    pending = current;
                    pending.position = position;
                    position += 1;
                } else {
                    // Keep the deferred match.
                    self.push_match(pending.length, pending.distance);
                    let start = pending.position;
                    let stop = start + pending.length;
                    self.chain.insert_range(input, start, stop);
                    have_pending = false;
                    position = stop;
                }
            } else {
                if (current.valid()) {
                    if (self.config.use_lazy and current.length < self.config.max_lazy) {
                        pending = current;
                        pending.position = position;
                        have_pending = true;
                        self.insert_position(input, position);
                        position += 1;
                    } else {
                        self.push_match(current.length, current.distance);
                        self.chain.insert_range(input, position, position + current.length);
                        position += current.length;
                    }
                } else {
                    self.push_literal(input.at(position));
                    self.insert_position(input, position);
                    position += 1;
                }
            }
        }

        if (have_pending) {
            self.push_literal(input.at(pending.position));
        }
    }

    fn insert_position(ref self, input: ByteBuffer, position: int) {
        if (position + MIN_MATCH <= input.size()) {
            self.chain.insert(self.chain.hash_at(input, position), position);
        }
    }

    // Ratio of matched bytes to total bytes, in percent. The block splitter
    // uses it to decide whether a stored block would be smaller.
    fn match_percent(self) -> int {
        let total = self.matched_bytes + self.literal_bytes;
        if (total == 0) {
            return 0;
        }
        return (self.matched_bytes * 100) / total;
    }

    fn estimated_bits(self) -> int {
        var total: int = 0;
        var i: int = 0;
        while (i < self.tokens.size()) {
            total += self.tokens.at(i).cost_estimate();
            i += 1;
        }
        return total;
    }

    var config: LevelConfig;
    var chain: HashChain;
    var tokens: vector(Token);
    var literal_count: int = 0;
    var match_count: int = 0;
    var matched_bytes: int = 0;
    var literal_bytes: int = 0;
}

// --- LZ77 decoder --------------------------------------------------------

// Replays a token stream through a sliding window.
fn lz77_decode(tokens: vector(Token), ref output: ByteBuffer) -> Status {
    var window = SlidingWindow();
    window.init(WINDOW_SIZE);
    var i: int = 0;
    while (i < tokens.size()) {
        let ref token: auto = tokens.at(i);
        if (token.is_literal()) {
            window.emit_literal(output, token.literal);
        } else {
            if (not window.can_reference(token.distance)) {
                Destroy(window);
                return Status.BadDistance;
            }
            if (not window.copy_match(output, token.distance, token.length)) {
                Destroy(window);
                return Status.CorruptStream;
            }
        }
        i += 1;
    }
    Destroy(window);
    return Status.Ok;
}

// --- Deflate symbol tables ----------------------------------------------

// Deflate maps a match length in [3, 258] onto one of 29 length codes plus
// up to five extra bits, and a distance in [1, 32768] onto one of 30
// distance codes plus up to 13 extra bits. Both tables are generated here
// rather than transcribed, because the structure is entirely regular:
//
//   length code i has (i - 4) / 4 extra bits, clamped to [0, 5]
//   distance code i has (i / 2) - 1 extra bits, clamped to [0, 13]
//
// and each base is the previous base plus 2^extra of the previous code.
class DeflateTables {

    fn init(ref self) {
        self.build_length_tables();
        self.build_distance_tables();
        self.build_code_length_order();
        self.build_reverse_maps();
        self.ready = true;
    }

    fn build_length_tables(ref self) {
        self.length_base.clear();
        self.length_extra.clear();
        self.length_base.resize(29);
        self.length_extra.resize(29);

        var running: int = 3;
        var code: int = 0;
        while (code < 28) {
            var extra = (code - 4) / 4;
            if (code < 8) {
                extra = 0;
            }
            if (extra > 5) {
                extra = 5;
            }
            self.length_extra.at(code) = extra;
            self.length_base.at(code) = running;
            running += 1 << extra;
            code += 1;
        }
        // The final code is the special case: length 258 with no extra bits.
        self.length_extra.at(28) = 0;
        self.length_base.at(28) = MAX_MATCH;
    }

    fn build_distance_tables(ref self) {
        self.distance_base.clear();
        self.distance_extra.clear();
        self.distance_base.resize(DISTANCE_SYMBOLS);
        self.distance_extra.resize(DISTANCE_SYMBOLS);

        var running: int = 1;
        var code: int = 0;
        while (code < DISTANCE_SYMBOLS) {
            var extra = (code / 2) - 1;
            if (code < 4) {
                extra = 0;
            }
            if (extra > 13) {
                extra = 13;
            }
            self.distance_extra.at(code) = extra;
            self.distance_base.at(code) = running;
            running += 1 << extra;
            code += 1;
        }
    }

    // The code length alphabet is transmitted in a permuted order chosen so
    // that the rarely used lengths sit at the end and can be truncated.
    fn build_code_length_order(ref self) {
        self.code_length_order.clear();
        self.code_length_order.push_back(16);
        self.code_length_order.push_back(17);
        self.code_length_order.push_back(18);
        self.code_length_order.push_back(0);
        var offset: int = 8;
        var step: int = 0;
        while (step < 8) {
            self.code_length_order.push_back(offset);
            self.code_length_order.push_back(BYTE_BITS - 1 - step - 1 + 1);
            offset += 1;
            step += 1;
        }
        // Regenerate the tail deterministically: 8,7,9,6,10,5,11,4,12,3,
        // 13,2,14,1,15 alternates outward from the middle of the alphabet.
        self.code_length_order.clear();
        self.code_length_order.push_back(16);
        self.code_length_order.push_back(17);
        self.code_length_order.push_back(18);
        self.code_length_order.push_back(0);
        var high: int = 8;
        var low: int = 7;
        while (high <= 15) {
            self.code_length_order.push_back(high);
            self.code_length_order.push_back(low);
            high += 1;
            low -= 1;
        }
    }

    // Invert the base tables into direct lookups so the encoder does not
    // binary search on every token. `length_to_code` has MAX_MATCH + 1
    // entries; `distance_to_code` uses a split lookup because a full table
    // over 32768 distances would be wasteful: the low 256 distances index
    // directly, the rest index by distance >> 7.
    fn build_reverse_maps(ref self) {
        self.length_to_code.clear();
        self.length_to_code.resize(MAX_MATCH + 1);
        var length: int = 0;
        while (length <= MAX_MATCH) {
            self.length_to_code.at(length) = 0;
            length += 1;
        }
        var code: int = 0;
        while (code < 29) {
            let anchor = self.length_base.at(code);
            let span = 1 << self.length_extra.at(code);
            var offset: int = 0;
            while (offset < span) {
                let value = anchor + offset;
                if (value <= MAX_MATCH) {
                    self.length_to_code.at(value) = code;
                }
                offset += 1;
            }
            code += 1;
        }
        self.length_to_code.at(MAX_MATCH) = 28;

        self.distance_to_code_low.clear();
        self.distance_to_code_low.resize(257);
        self.distance_to_code_high.clear();
        self.distance_to_code_high.resize(257);
        var i: int = 0;
        while (i <= 256) {
            self.distance_to_code_low.at(i) = 0;
            self.distance_to_code_high.at(i) = 0;
            i += 1;
        }
        code = 0;
        while (code < DISTANCE_SYMBOLS) {
            let anchor = self.distance_base.at(code);
            let span = 1 << self.distance_extra.at(code);
            var offset: int = 0;
            while (offset < span) {
                let distance = anchor + offset;
                if (distance <= 256) {
                    self.distance_to_code_low.at(distance) = code;
                } else {
                    if (distance <= MAX_DISTANCE) {
                        let bucket = (distance - 1) >> 7;
                        if (bucket <= 256) {
                            self.distance_to_code_high.at(bucket) = code;
                        }
                    }
                }
                offset += 1;
            }
            code += 1;
        }
    }

    fn length_code(self, length: int) -> int {
        return self.length_to_code.at(clamp_int(length, MIN_MATCH, MAX_MATCH));
    }

    fn distance_code(self, distance: int) -> int {
        if (distance <= 256) {
            return self.distance_to_code_low.at(distance);
        }
        return self.distance_to_code_high.at((distance - 1) >> 7);
    }

    fn length_extra_value(self, length: int) -> int {
        let code = self.length_code(length);
        return length - self.length_base.at(code);
    }

    fn distance_extra_value(self, distance: int) -> int {
        let code = self.distance_code(distance);
        return distance - self.distance_base.at(code);
    }

    var length_base: vector(int);
    var length_extra: vector(int);
    var distance_base: vector(int);
    var distance_extra: vector(int);
    var length_to_code: vector(int);
    var distance_to_code_low: vector(int);
    var distance_to_code_high: vector(int);
    var code_length_order: vector(int);
    var ready: bool = false;
}

// Free-function forms used by `Token::cost_estimate`, which has no access to
// a table instance. They recompute the same regular structure arithmetically.
fn extra_length_bits(code: int) -> int {
    if (code >= 28) {
        return 0;
    }
    if (code < 8) {
        return 0;
    }
    return clamp_int((code - 4) / 4, 0, 5);
}

fn extra_distance_bits(code: int) -> int {
    if (code < 4) {
        return 0;
    }
    return clamp_int((code / 2) - 1, 0, 13);
}

fn length_code_of(length: int) -> int {
    if (length >= MAX_MATCH) {
        return 28;
    }
    var code: int = 0;
    var anchor: int = 3;
    while (code < 28) {
        let span = 1 << extra_length_bits(code);
        if (length < anchor + span) {
            return code;
        }
        anchor += span;
        code += 1;
    }
    return 28;
}

fn distance_code_of(distance: int) -> int {
    var code: int = 0;
    var anchor: int = 1;
    while (code < DISTANCE_SYMBOLS) {
        let span = 1 << extra_distance_bits(code);
        if (distance < anchor + span) {
            return code;
        }
        anchor += span;
        code += 1;
    }
    return DISTANCE_SYMBOLS - 1;
}

// The fixed Huffman code of a deflate stream is defined by a fixed length
// assignment rather than by a transmitted table: literals 0..143 get 8 bits,
// 144..255 get 9, 256..279 get 7 and 280..287 get 8. Distances are all 5.
fn build_fixed_literal_lengths(ref lengths: vector(int)) {
    lengths.clear();
    lengths.resize(MAX_SYMBOLS);
    var symbol: int = 0;
    while (symbol < MAX_SYMBOLS) {
        if (symbol < 144) {
            lengths.at(symbol) = 8;
        } else { if (symbol < 256) {
            lengths.at(symbol) = 9;
        } else { if (symbol < 280) {
            lengths.at(symbol) = 7;
        } else {
            lengths.at(symbol) = 8;
        }
        } }
        symbol += 1;
    }
}

fn build_fixed_distance_lengths(ref lengths: vector(int)) {
    lengths.clear();
    lengths.resize(DISTANCE_SYMBOLS + 2);
    var symbol: int = 0;
    while (symbol < DISTANCE_SYMBOLS + 2) {
        lengths.at(symbol) = 5;
        symbol += 1;
    }
}

// --- Code length run encoding -------------------------------------------

// A dynamic block transmits its two code length vectors compressed with a
// third Huffman code over the alphabet {0..15, 16, 17, 18}, where
//
//   16 = repeat the previous length 3..6 more times (2 extra bits)
//   17 = a run of 3..10 zero lengths            (3 extra bits)
//   18 = a run of 11..138 zero lengths          (7 extra bits)
//
// `RunEncoder` turns a length vector into that symbol stream.
class RunEncoder {

    fn clear(ref self) {
        self.symbols.clear();
        self.extras.clear();
        self.extra_bits.clear();
    }

    fn count(self) -> int {
        return self.symbols.size();
    }

    fn emit(ref self, symbol: int, extra: int, bits: int) {
        self.symbols.push_back(symbol);
        self.extras.push_back(extra);
        self.extra_bits.push_back(bits);
    }

    fn encode(ref self, lengths: vector(int), used: int) {
        self.clear();
        var index: int = 0;
        var previous: int = -1;
        while (index < used) {
            let current = lengths.at(index);
            // Measure the run of equal lengths starting here.
            var run: int = 1;
            while (index + run < used) {
                if (lengths.at(index + run) != current) {
                    break;
                }
                run += 1;
            }

            if (current == 0) {
                // Zero runs use the dedicated 17 / 18 symbols.
                while (run >= 11) {
                    let take = min_int(run, 138);
                    self.emit(18, take - 11, 7);
                    run -= take;
                    index += take;
                }
                while (run >= 3) {
                    let take = min_int(run, 10);
                    self.emit(17, take - 3, 3);
                    run -= take;
                    index += take;
                }
                while (run > 0) {
                    self.emit(0, 0, 0);
                    run -= 1;
                    index += 1;
                }
                previous = 0;
            } else {
                // A non-zero run repeats the literal length once, then uses
                // symbol 16 for the remainder.
                var remaining = run;
                if (previous != current) {
                    self.emit(current, 0, 0);
                    remaining -= 1;
                    index += 1;
                }
                while (remaining >= 3) {
                    let take = min_int(remaining, 6);
                    self.emit(16, take - 3, 2);
                    remaining -= take;
                    index += take;
                }
                while (remaining > 0) {
                    self.emit(current, 0, 0);
                    remaining -= 1;
                    index += 1;
                }
                previous = current;
            }
        }
    }

    // Histogram over the code length alphabet, used to build its own code.
    fn count_symbols(self, ref frequencies: FrequencyTable) {
        var i: int = 0;
        while (i < self.symbols.size()) {
            frequencies.add(self.symbols.at(i));
            i += 1;
        }
    }

    var symbols: vector(int);
    var extras: vector(int);
    var extra_bits: vector(int);
}

// --- Deflate encoder -----------------------------------------------------

// The full pipeline: LZ77 the input, histogram the resulting tokens, build
// dynamic codes, compare the three block encodings and emit the cheapest.
class DeflateEncoder {

    fn init(ref self, level: int) {
        self.tables.init();
        self.lz.init(level);
        self.writer.init(BitOrder.LsbFirst);
        self.config.from_level(level);
        self.blocks_stored = 0;
        self.blocks_fixed = 0;
        self.blocks_dynamic = 0;
    }

    // --- Cost models -----------------------------------------------------

    // Bits needed for a stored block: three header bits, padding to the byte
    // boundary, a four byte length header and the payload.
    fn stored_cost(self, byte_count: int) -> int {
        return 3 + 7 + 32 + byte_count * BYTE_BITS;
    }

    fn fixed_cost(self, literals: FrequencyTable, distances: FrequencyTable) -> int {
        var total: int = 3;
        var symbol: int = 0;
        while (symbol < LITERAL_SYMBOLS) {
            let count = literals.at(symbol);
            if (count > 0) {
                var bits: int = 8;
                if (symbol >= 144) {
                    bits = 9;
                }
                if (symbol >= 256) {
                    bits = 7;
                }
                if (symbol >= 280) {
                    bits = 8;
                }
                total += count * bits;
                total += count * extra_length_bits(symbol - 257);
            }
            symbol += 1;
        }
        symbol = 0;
        while (symbol < DISTANCE_SYMBOLS) {
            let count = distances.at(symbol);
            if (count > 0) {
                total += count * (5 + extra_distance_bits(symbol));
            }
            symbol += 1;
        }
        return total;
    }

    fn dynamic_cost(self, literal_tree: HuffmanTree, distance_tree: HuffmanTree, literals: FrequencyTable, distances: FrequencyTable, header_bits: int) -> int {
        var total = 3 + header_bits;
        total += literal_tree.encoded_bits(literals);
        total += distance_tree.encoded_bits(distances);
        var symbol: int = 257;
        while (symbol < LITERAL_SYMBOLS) {
            total += literals.at(symbol) * extra_length_bits(symbol - 257);
            symbol += 1;
        }
        symbol = 0;
        while (symbol < DISTANCE_SYMBOLS) {
            total += distances.at(symbol) * extra_distance_bits(symbol);
            symbol += 1;
        }
        return total;
    }

    // --- Histograms ------------------------------------------------------

    fn histogram_tokens(self, tokens: vector(Token), ref literals: FrequencyTable, ref distances: FrequencyTable) {
        var i: int = 0;
        while (i < tokens.size()) {
            let ref token: auto = tokens.at(i);
            if (token.is_literal()) {
                literals.add(token.literal & BYTE_MASK);
            } else {
                literals.add(257 + self.tables.length_code(token.length));
                distances.add(self.tables.distance_code(token.distance));
            }
            i += 1;
        }
        literals.add(END_OF_BLOCK);
    }

    // --- Block emission --------------------------------------------------

    fn write_block_header(ref self, kind: BlockType, final_block: bool) {
        var flag: int = 0;
        if (final_block) {
            flag = 1;
        }
        self.writer.put_bits_lsb(flag, 1);
        if (kind == BlockType.Stored) {
            self.writer.put_bits_lsb(0, 2);
        } else { if (kind == BlockType.Fixed) {
            self.writer.put_bits_lsb(1, 2);
        } else {
            self.writer.put_bits_lsb(2, 2);
        }
        }
    }

    fn write_stored_block(ref self, input: ByteBuffer, from: int, count: int, final_block: bool) {
        self.write_block_header(BlockType.Stored, final_block);
        self.writer.align();
        self.writer.put_short(count & SHORT_MASK);
        self.writer.put_short((^count) & SHORT_MASK);
        self.writer.raw_copy(input, from, count);
        self.blocks_stored += 1;
    }

    fn write_fixed_block(ref self, tokens: vector(Token), final_block: bool) {
        self.write_block_header(BlockType.Fixed, final_block);
        var literal_lengths = vector(int)();
        var distance_lengths = vector(int)();
        build_fixed_literal_lengths(literal_lengths);
        build_fixed_distance_lengths(distance_lengths);
        var literal_table = EncodeTable();
        var distance_table = EncodeTable();
        literal_table.build_from_lengths(literal_lengths);
        distance_table.build_from_lengths(distance_lengths);
        self.write_token_stream(tokens, literal_table, distance_table);
        self.blocks_fixed += 1;
        Destroy(literal_lengths);
        Destroy(distance_lengths);
    }

    // Emit the dynamic header: the two truncated length counts, the code
    // length code lengths in permuted order, and the run encoded lengths.
    fn write_dynamic_header(ref self, literal_lengths: vector(int), distance_lengths: vector(int), literal_used: int, distance_used: int, runs: RunEncoder, code_length_table: EncodeTable, code_length_lengths: vector(int)) -> int {
        var bits_written: int = 0;
        self.writer.put_bits_lsb(literal_used - 257, 5);
        self.writer.put_bits_lsb(distance_used - 1, 5);

        // Trim trailing zero entries from the permuted code length vector.
        var transmitted = CODE_LENGTH_SYMBOLS;
        while (transmitted > 4) {
            let slot = self.tables.code_length_order.at(transmitted - 1);
            if (code_length_lengths.at(slot) != 0) {
                break;
            }
            transmitted -= 1;
        }
        self.writer.put_bits_lsb(transmitted - 4, 4);
        bits_written += 14;

        var i: int = 0;
        while (i < transmitted) {
            let slot = self.tables.code_length_order.at(i);
            self.writer.put_bits_lsb(code_length_lengths.at(slot), 3);
            bits_written += 3;
            i += 1;
        }

        i = 0;
        while (i < runs.symbols.size()) {
            let symbol = runs.symbols.at(i);
            code_length_table.emit_reversed(self.writer, symbol);
            bits_written += code_length_table.length_of(symbol);
            let extra_count = runs.extra_bits.at(i);
            if (extra_count > 0) {
                self.writer.put_bits_lsb(runs.extras.at(i), extra_count);
                bits_written += extra_count;
            }
            i += 1;
        }
        Discard(literal_lengths);
        Discard(distance_lengths);
        return bits_written;
    }

    fn write_token_stream(ref self, tokens: vector(Token), literal_table: EncodeTable, distance_table: EncodeTable) {
        var i: int = 0;
        while (i < tokens.size()) {
            let ref token: auto = tokens.at(i);
            if (token.is_literal()) {
                literal_table.emit_reversed(self.writer, token.literal & BYTE_MASK);
            } else {
                let length_code = self.tables.length_code(token.length);
                literal_table.emit_reversed(self.writer, 257 + length_code);
                let length_extra = self.tables.length_extra.at(length_code);
                if (length_extra > 0) {
                    self.writer.put_bits_lsb(token.length - self.tables.length_base.at(length_code), length_extra);
                }
                let distance_code = self.tables.distance_code(token.distance);
                distance_table.emit_reversed(self.writer, distance_code);
                let distance_extra = self.tables.distance_extra.at(distance_code);
                if (distance_extra > 0) {
                    self.writer.put_bits_lsb(token.distance - self.tables.distance_base.at(distance_code), distance_extra);
                }
            }
            i += 1;
        }
        literal_table.emit_reversed(self.writer, END_OF_BLOCK);
    }

    // Build the dynamic codes for a token stream and emit the block.
    fn write_dynamic_block(ref self, tokens: vector(Token), final_block: bool) -> bool {
        var literals = FrequencyTable();
        var distances = FrequencyTable();
        literals.init(MAX_SYMBOLS);
        distances.init(DISTANCE_SYMBOLS);
        self.histogram_tokens(tokens, literals, distances);
        distances.ensure_two_symbols();

        var literal_tree = HuffmanTree();
        var distance_tree = HuffmanTree();
        if (not literal_tree.build(literals)) {
            return false;
        }
        if (not distance_tree.build(distances)) {
            return false;
        }

        var literal_used = LITERAL_SYMBOLS;
        while (literal_used > 257) {
            if (literal_tree.lengths.at(literal_used - 1) != 0) {
                break;
            }
            literal_used -= 1;
        }
        var distance_used = DISTANCE_SYMBOLS;
        while (distance_used > 1) {
            if (distance_tree.lengths.at(distance_used - 1) != 0) {
                break;
            }
            distance_used -= 1;
        }

        // Concatenate the two length vectors and run encode them together,
        // which is what lets a run straddle the boundary.
        var combined = vector(int)();
        var i: int = 0;
        while (i < literal_used) {
            combined.push_back(literal_tree.lengths.at(i));
            i += 1;
        }
        i = 0;
        while (i < distance_used) {
            combined.push_back(distance_tree.lengths.at(i));
            i += 1;
        }

        var runs = RunEncoder();
        runs.encode(combined, combined.size());

        var code_length_frequencies = FrequencyTable();
        code_length_frequencies.init(CODE_LENGTH_SYMBOLS);
        runs.count_symbols(code_length_frequencies);
        code_length_frequencies.ensure_two_symbols();

        var code_length_tree = HuffmanTree();
        if (not code_length_tree.build(code_length_frequencies)) {
            return false;
        }
        code_length_tree.limit_code_lengths(MAX_LENGTH_CODE_BITS);
        code_length_tree.assign_canonical();

        var code_length_table = EncodeTable();
        code_length_table.build(code_length_tree);

        var literal_table = EncodeTable();
        var distance_table = EncodeTable();
        literal_table.build(literal_tree);
        distance_table.build(distance_tree);

        self.write_block_header(BlockType.Dynamic, final_block);
        self.write_dynamic_header(literal_tree.lengths, distance_tree.lengths, literal_used, distance_used, runs, code_length_table, code_length_tree.lengths);
        self.write_token_stream(tokens, literal_table, distance_table);
        self.blocks_dynamic += 1;

        Destroy(combined);
        return true;
    }

    // Compress a whole buffer, splitting it into blocks of at most
    // DEFAULT_BLOCK_SIZE bytes and picking a block type per chunk.
    fn compress(ref self, input: ByteBuffer) -> Status {
        self.writer.init(BitOrder.LsbFirst);
        if (input.empty()) {
            self.write_block_header(BlockType.Stored, true);
            self.writer.align();
            self.writer.put_short(0);
            self.writer.put_short(SHORT_MASK);
            return Status.Ok;
        }

        var offset: int = 0;
        while (offset < input.size()) {
            let span = min_int(DEFAULT_BLOCK_SIZE, input.size() - offset);
            let final_block = (offset + span) >= input.size();

            var chunk = ByteBuffer();
            var i: int = 0;
            while (i < span) {
                chunk.push(input.at(offset + i));
                i += 1;
            }

            self.lz.init(self.config.level);
            self.lz.encode(chunk);

            var literals = FrequencyTable();
            var distances = FrequencyTable();
            literals.init(MAX_SYMBOLS);
            distances.init(DISTANCE_SYMBOLS);
            self.histogram_tokens(self.lz.tokens, literals, distances);

            let cost_stored = self.stored_cost(span);
            let cost_fixed = self.fixed_cost(literals, distances);

            if (self.config.stored_only) {
                self.write_stored_block(input, offset, span, final_block);
            } else { if (cost_stored <= cost_fixed) {
                self.write_stored_block(input, offset, span, final_block);
            } else {
                if (not self.write_dynamic_block(self.lz.tokens, final_block)) {
                    self.write_fixed_block(self.lz.tokens, final_block);
                }
            }
            }

            Destroy(chunk);
            offset += span;
        }
        self.writer.flush();
        return Status.Ok;
    }

    var tables: DeflateTables;
    var lz: Lz77Encoder;
    var writer: BitWriter;
    var config: LevelConfig;
    var blocks_stored: int = 0;
    var blocks_fixed: int = 0;
    var blocks_dynamic: int = 0;
}

// --- Deflate decoder -----------------------------------------------------

// Reads a deflate stream back into bytes. The decoder is table driven: each
// block builds a `DecodeTable` for its literal/length and distance codes,
// then the inner loop is peek, look up, drop, and either append a literal or
// run a window copy.
class DeflateDecoder {

    fn init(ref self) {
        self.tables.init();
        self.reader.init(BitOrder.LsbFirst);
        self.window.init(WINDOW_SIZE);
        self.blocks_read = 0;
        self.last_status = Status.Ok;
    }

    fn fail(ref self, status: Status) -> Status {
        self.last_status = status;
        return status;
    }

    // Read a stored block: align, read the length and its complement, and
    // copy the payload straight through.
    fn read_stored_block(ref self, ref output: ByteBuffer) -> Status {
        self.reader.align();
        let count = self.reader.get_short();
        let complement = self.reader.get_short();
        if (((count ^ SHORT_MASK) & SHORT_MASK) != (complement & SHORT_MASK)) {
            return self.fail(Status.CorruptStream);
        }
        var i: int = 0;
        while (i < count) {
            if (self.reader.source.exhausted()) {
                return self.fail(Status.NeedMoreInput);
            }
            let value = self.reader.get_byte();
            self.window.emit_literal(output, value);
            i += 1;
        }
        return Status.Ok;
    }

    // Rebuild the code length code, then decode the two length vectors from
    // the run encoded stream.
    fn read_dynamic_tables(ref self, ref literal_table: DecodeTable, ref distance_table: DecodeTable) -> Status {
        let literal_used = self.reader.get_bits_lsb(5) + 257;
        let distance_used = self.reader.get_bits_lsb(5) + 1;
        let transmitted = self.reader.get_bits_lsb(4) + 4;
        if (literal_used > LITERAL_SYMBOLS) {
            return self.fail(Status.BadCodeLengths);
        }
        if (distance_used > DISTANCE_SYMBOLS) {
            return self.fail(Status.BadCodeLengths);
        }

        var code_length_lengths = vector(int)(CODE_LENGTH_SYMBOLS);
        var i: int = 0;
        while (i < CODE_LENGTH_SYMBOLS) {
            code_length_lengths.at(i) = 0;
            i += 1;
        }
        i = 0;
        while (i < transmitted) {
            let slot = self.tables.code_length_order.at(i);
            code_length_lengths.at(slot) = self.reader.get_bits_lsb(3);
            i += 1;
        }

        var code_length_table = DecodeTable();
        if (not code_length_table.build(code_length_lengths)) {
            return self.fail(Status.BadCodeLengths);
        }

        let total = literal_used + distance_used;
        var combined = vector(int)(total);
        i = 0;
        while (i < total) {
            combined.at(i) = 0;
            i += 1;
        }

        var index: int = 0;
        var previous: int = 0;
        while (index < total) {
            let symbol = code_length_table.decode(self.reader);
            if (symbol < 0) {
                return self.fail(Status.BadCodeLengths);
            }
            if (symbol < 16) {
                combined.at(index) = symbol;
                previous = symbol;
                index += 1;
            } else { if (symbol == 16) {
                let repeat = self.reader.get_bits_lsb(2) + 3;
                if (index + repeat > total) {
                    return self.fail(Status.BadCodeLengths);
                }
                var k: int = 0;
                while (k < repeat) {
                    combined.at(index) = previous;
                    index += 1;
                    k += 1;
                }
            } else { if (symbol == 17) {
                let repeat = self.reader.get_bits_lsb(3) + 3;
                if (index + repeat > total) {
                    return self.fail(Status.BadCodeLengths);
                }
                var k: int = 0;
                while (k < repeat) {
                    combined.at(index) = 0;
                    index += 1;
                    k += 1;
                }
                previous = 0;
            } else {
                let repeat = self.reader.get_bits_lsb(7) + 11;
                if (index + repeat > total) {
                    return self.fail(Status.BadCodeLengths);
                }
                var k: int = 0;
                while (k < repeat) {
                    combined.at(index) = 0;
                    index += 1;
                    k += 1;
                }
                previous = 0;
            }
            } }
        }

        var literal_lengths = vector(int)(literal_used);
        var distance_lengths = vector(int)(distance_used);
        i = 0;
        while (i < literal_used) {
            literal_lengths.at(i) = combined.at(i);
            i += 1;
        }
        i = 0;
        while (i < distance_used) {
            distance_lengths.at(i) = combined.at(literal_used + i);
            i += 1;
        }

        if (not literal_table.build(literal_lengths)) {
            return self.fail(Status.BadCodeLengths);
        }
        if (not distance_table.build(distance_lengths)) {
            if (not distance_table.under_subscribed) {
                return self.fail(Status.BadCodeLengths);
            }
        }
        Destroy(combined);
        Destroy(code_length_lengths);
        return Status.Ok;
    }

    // The hot decode loop for one compressed block.
    fn read_compressed_block(ref self, ref output: ByteBuffer, literal_table: DecodeTable, distance_table: DecodeTable) -> Status {
        while (true) {
            if (self.reader.failed()) {
                return self.fail(Status.NeedMoreInput);
            }
            let symbol = literal_table.decode(self.reader);
            if (symbol < 0) {
                return self.fail(Status.CorruptStream);
            }
            if (symbol < 256) {
                self.window.emit_literal(output, symbol);
            } else { if (symbol == END_OF_BLOCK) {
                return Status.Ok;
            } else {
                let length_code = symbol - 257;
                if (length_code >= 29) {
                    return self.fail(Status.CorruptStream);
                }
                let length_extra = self.tables.length_extra.at(length_code);
                var length = self.tables.length_base.at(length_code);
                if (length_extra > 0) {
                    length += self.reader.get_bits_lsb(length_extra);
                }

                let distance_symbol = distance_table.decode(self.reader);
                if (distance_symbol < 0) {
                    return self.fail(Status.CorruptStream);
                }
                if (distance_symbol >= DISTANCE_SYMBOLS) {
                    return self.fail(Status.BadDistance);
                }
                let distance_extra = self.tables.distance_extra.at(distance_symbol);
                var distance = self.tables.distance_base.at(distance_symbol);
                if (distance_extra > 0) {
                    distance += self.reader.get_bits_lsb(distance_extra);
                }
                if (distance > MAX_DISTANCE) {
                    return self.fail(Status.BadDistance);
                }
                if (not self.window.copy_match(output, distance, length)) {
                    return self.fail(Status.BadDistance);
                }
            }
            }
        }
    }

    fn decompress(ref self, input: ByteBuffer, ref output: ByteBuffer) -> Status {
        self.reader.init(BitOrder.LsbFirst);
        self.reader.source = input;
        self.reader.source.rewind();
        self.window.init(WINDOW_SIZE);

        var final_block = false;
        while (not final_block) {
            if (self.reader.failed()) {
                return self.fail(Status.NeedMoreInput);
            }
            final_block = self.reader.get_bits_lsb(1) == 1;
            let kind = self.reader.get_bits_lsb(2);
            self.blocks_read += 1;

            if (kind == 0) {
                let status = self.read_stored_block(output);
                if (status != Status.Ok) {
                    return status;
                }
            } else { if (kind == 1) {
                var literal_lengths = vector(int)();
                var distance_lengths = vector(int)();
                build_fixed_literal_lengths(literal_lengths);
                build_fixed_distance_lengths(distance_lengths);
                var literal_table = DecodeTable();
                var distance_table = DecodeTable();
                if (not literal_table.build(literal_lengths)) {
                    return self.fail(Status.BadCodeLengths);
                }
                if (not distance_table.build(distance_lengths)) {
                    return self.fail(Status.BadCodeLengths);
                }
                let status = self.read_compressed_block(output, literal_table, distance_table);
                if (status != Status.Ok) {
                    return status;
                }
                Destroy(literal_lengths);
                Destroy(distance_lengths);
            } else { if (kind == 2) {
                var literal_table = DecodeTable();
                var distance_table = DecodeTable();
                let header = self.read_dynamic_tables(literal_table, distance_table);
                if (header != Status.Ok) {
                    return header;
                }
                let status = self.read_compressed_block(output, literal_table, distance_table);
                if (status != Status.Ok) {
                    return status;
                }
            } else {
                return self.fail(Status.CorruptStream);
            }
            } }
        }
        return Status.Ok;
    }

    var tables: DeflateTables;
    var reader: BitReader;
    var window: SlidingWindow;
    var blocks_read: int = 0;
    var last_status: Status = Status.Ok;
}

// --- Run length encoding -------------------------------------------------

// A byte oriented RLE with an escape byte. A run of three or more identical
// bytes becomes <escape, count, value>; a literal equal to the escape byte
// is emitted as <escape, 0>. Runs longer than 255 are split.
let RLE_ESCAPE: int = 144;                   // 0x90
let RLE_MIN_RUN: int = 3;
let RLE_MAX_RUN: int = 255;

class RleCodec {

    fn encode(ref self, input: ByteBuffer, ref output: ByteBuffer) {
        var i: int = 0;
        self.runs_emitted = 0;
        self.literals_emitted = 0;
        while (i < input.size()) {
            let value = input.at(i);
            var run: int = 1;
            while (i + run < input.size()) {
                if (input.at(i + run) != value) {
                    break;
                }
                if (run >= RLE_MAX_RUN) {
                    break;
                }
                run += 1;
            }

            if (run >= RLE_MIN_RUN) {
                output.push(RLE_ESCAPE);
                output.push(run);
                output.push(value);
                self.runs_emitted += 1;
                i += run;
            } else {
                var k: int = 0;
                while (k < run) {
                    if (value == RLE_ESCAPE) {
                        output.push(RLE_ESCAPE);
                        output.push(0);
                    } else {
                        output.push(value);
                    }
                    self.literals_emitted += 1;
                    k += 1;
                }
                i += run;
            }
        }
    }

    fn decode(ref self, input: ByteBuffer, ref output: ByteBuffer) -> Status {
        var i: int = 0;
        while (i < input.size()) {
            let value = input.at(i);
            if (value != RLE_ESCAPE) {
                output.push(value);
                i += 1;
            } else {
                if (i + 1 >= input.size()) {
                    return Status.NeedMoreInput;
                }
                let count = input.at(i + 1);
                if (count == 0) {
                    output.push(RLE_ESCAPE);
                    i += 2;
                } else {
                    if (i + 2 >= input.size()) {
                        return Status.NeedMoreInput;
                    }
                    let repeated = input.at(i + 2);
                    var k: int = 0;
                    while (k < count) {
                        output.push(repeated);
                        k += 1;
                    }
                    i += 3;
                }
            }
        }
        return Status.Ok;
    }

    // Longest run in the input; the pipeline uses it to decide whether RLE
    // is worth applying before the block sorting stage.
    fn longest_run(self, input: ByteBuffer) -> int {
        if (input.empty()) {
            return 0;
        }
        var best: int = 1;
        var current: int = 1;
        var i: int = 1;
        while (i < input.size()) {
            if (input.at(i) == input.at(i - 1)) {
                current += 1;
                if (current > best) {
                    best = current;
                }
            } else {
                current = 1;
            }
            i += 1;
        }
        return best;
    }

    var runs_emitted: int = 0;
    var literals_emitted: int = 0;
}

// --- Move to front -------------------------------------------------------

// MTF turns a stream with local symbol locality into a stream dominated by
// small indices, which is exactly what a Huffman or arithmetic stage wants
// after a Burrows-Wheeler transform.
class MoveToFront {

    fn init(ref self) {
        self.order.clear();
        self.order.resize(256);
        var i: int = 0;
        while (i < 256) {
            self.order.at(i) = i;
            i += 1;
        }
    }

    // Find the current rank of a symbol and pull it to the front, shifting
    // everything above it down by one.
    fn rank_of(ref self, value: int) -> int {
        var position: int = 0;
        while (position < 256) {
            if (self.order.at(position) == value) {
                break;
            }
            position += 1;
        }
        var i = position;
        while (i > 0) {
            self.order.at(i) = self.order.at(i - 1);
            i -= 1;
        }
        self.order.at(0) = value;
        return position;
    }

    fn symbol_at(ref self, rank: int) -> int {
        let value = self.order.at(rank);
        var i = rank;
        while (i > 0) {
            self.order.at(i) = self.order.at(i - 1);
            i -= 1;
        }
        self.order.at(0) = value;
        return value;
    }

    fn encode(ref self, input: ByteBuffer, ref output: ByteBuffer) {
        self.init();
        var i: int = 0;
        while (i < input.size()) {
            output.push(self.rank_of(input.at(i)));
            i += 1;
        }
    }

    fn decode(ref self, input: ByteBuffer, ref output: ByteBuffer) {
        self.init();
        var i: int = 0;
        while (i < input.size()) {
            output.push(self.symbol_at(input.at(i)));
            i += 1;
        }
    }

    var order: vector(int);
}

// --- Burrows-Wheeler transform -------------------------------------------

// The forward transform sorts every rotation of the input and emits the last
// column plus the index of the original string. The inverse rebuilds the
// input from the last column alone using the standard LF mapping.
//
// The rotation sort here is a plain comparison sort with an explicit
// comparison function rather than a suffix array construction; the point of
// the benchmark is the tight comparison loop, not asymptotics.
class BurrowsWheeler {

    // Compare rotations `a` and `b` of `input` lexicographically.
    fn compare_rotations(self, input: ByteBuffer, a: int, b: int) -> int {
        let n = input.size();
        var offset: int = 0;
        while (offset < n) {
            let left = input.at((a + offset) % n);
            let right = input.at((b + offset) % n);
            if (left != right) {
                if (left < right) {
                    return -1;
                }
                return 1;
            }
            offset += 1;
        }
        return 0;
    }

    // Binary insertion sort over rotation indices.
    fn sort_rotations(self, input: ByteBuffer, ref order: vector(int)) {
        var i: int = 1;
        while (i < order.size()) {
            let key = order.at(i);
            var low: int = 0;
            var high = i;
            while (low < high) {
                let middle = (low + high) / 2;
                if (self.compare_rotations(input, order.at(middle), key) <= 0) {
                    low = middle + 1;
                } else {
                    high = middle;
                }
            }
            var j = i;
            while (j > low) {
                order.at(j) = order.at(j - 1);
                j -= 1;
            }
            order.at(low) = key;
            i += 1;
        }
    }

    fn transform(ref self, input: ByteBuffer, ref output: ByteBuffer) -> int {
        let n = input.size();
        if (n == 0) {
            return 0;
        }
        var order = vector(int)(n);
        var i: int = 0;
        while (i < n) {
            order.at(i) = i;
            i += 1;
        }
        self.sort_rotations(input, order);

        var primary: int = 0;
        i = 0;
        while (i < n) {
            let rotation = order.at(i);
            if (rotation == 0) {
                primary = i;
            }
            output.push(input.at((rotation + n - 1) % n));
            i += 1;
        }
        self.primary_index = primary;
        Destroy(order);
        return primary;
    }

    // Inverse transform via the LF mapping: count the occurrences of each
    // byte, turn the counts into starting offsets, then thread the next
    // pointers through the last column.
    fn inverse(self, last_column: ByteBuffer, primary: int, ref output: ByteBuffer) -> Status {
        let n = last_column.size();
        if (n == 0) {
            return Status.Ok;
        }
        if (primary < 0 or primary >= n) {
            return Status.CorruptStream;
        }

        var counts = vector(int)(257);
        var i: int = 0;
        while (i <= 256) {
            counts.at(i) = 0;
            i += 1;
        }
        i = 0;
        while (i < n) {
            counts.at(last_column.at(i) + 1) += 1;
            i += 1;
        }
        i = 1;
        while (i <= 256) {
            counts.at(i) += counts.at(i - 1);
            i += 1;
        }

        var next = vector(int)(n);
        i = 0;
        while (i < n) {
            let value = last_column.at(i);
            next.at(counts.at(value)) = i;
            counts.at(value) += 1;
            i += 1;
        }

        var position = next.at(primary);
        i = 0;
        while (i < n) {
            output.push(last_column.at(position));
            position = next.at(position);
            i += 1;
        }
        Destroy(counts);
        Destroy(next);
        return Status.Ok;
    }

    var primary_index: int = 0;
}

// --- Adaptive frequency model -------------------------------------------

// A cumulative frequency model over a small alphabet, maintained as a Fenwick
// tree so that both the cumulative query and the update are logarithmic. The
// arithmetic coder needs the cumulative frequency below a symbol, the
// symbol's own frequency, and the running total, on every single symbol.
class AdaptiveModel {

    fn init(ref self, alphabet: int) {
        self.alphabet = alphabet;
        self.frequencies.clear();
        self.frequencies.resize(alphabet + 1);
        self.tree.clear();
        self.tree.resize(alphabet + 1);
        var i: int = 0;
        while (i <= alphabet) {
            self.frequencies.at(i) = 0;
            self.tree.at(i) = 0;
            i += 1;
        }
        // Every symbol starts with a count of one so nothing is unencodable.
        i = 0;
        while (i < alphabet) {
            self.frequencies.at(i + 1) = 1;
            i += 1;
        }
        self.rebuild_tree();
        self.total = alphabet;
        self.updates = 0;
    }

    // Rebuild the Fenwick tree from the raw frequency array in linear time:
    // every node absorbs its immediate child's partial sum.
    fn rebuild_tree(ref self) {
        var i: int = 1;
        while (i <= self.alphabet) {
            self.tree.at(i) = self.frequencies.at(i);
            i += 1;
        }
        i = 1;
        while (i <= self.alphabet) {
            let parent = i + (i & (-i));
            if (parent <= self.alphabet) {
                self.tree.at(parent) += self.tree.at(i);
            }
            i += 1;
        }
    }

    // Sum of frequencies for symbols strictly below `symbol`.
    fn cumulative_below(self, symbol: int) -> int {
        var index = symbol;
        var sum: int = 0;
        while (index > 0) {
            sum += self.tree.at(index);
            index -= index & (-index);
        }
        return sum;
    }

    fn frequency_of(self, symbol: int) -> int {
        return self.frequencies.at(symbol + 1);
    }

    fn total_frequency(self) -> int {
        return self.total;
    }

    // Locate the symbol whose cumulative interval contains `target`, by
    // descending the Fenwick tree one power of two at a time.
    fn symbol_for(self, target: int) -> int {
        var index: int = 0;
        var remaining = target;
        var step = round_up_pow2(self.alphabet);
        while (step > 0) {
            let candidate = index + step;
            if (candidate <= self.alphabet) {
                if (self.tree.at(candidate) <= remaining) {
                    index = candidate;
                    remaining -= self.tree.at(candidate);
                }
            }
            step = (step >> 1) & WORD_MASK;
        }
        return index;
    }

    fn update(ref self, symbol: int) {
        var index = symbol + 1;
        self.frequencies.at(index) += MODEL_INCREMENT;
        while (index <= self.alphabet) {
            self.tree.at(index) += MODEL_INCREMENT;
            index += index & (-index);
        }
        self.total += MODEL_INCREMENT;
        self.updates += 1;
        if (self.total >= MODEL_TOTAL_MAX) {
            self.rescale();
        }
    }

    // Halve every count, keeping a floor of one so no symbol drops out of
    // the model, then rebuild the tree in one pass.
    fn rescale(ref self) {
        var new_total: int = 0;
        var i: int = 1;
        while (i <= self.alphabet) {
            var value = (self.frequencies.at(i) + 1) >> 1;
            if (value < 1) {
                value = 1;
            }
            self.frequencies.at(i) = value;
            new_total += value;
            i += 1;
        }
        self.total = new_total;
        self.rebuild_tree();
    }

    var frequencies: vector(int);
    var tree: vector(int);
    var alphabet: int = 256;
    var total: int = 0;
    var updates: int = 0;
}

// --- Arithmetic encoder --------------------------------------------------

// A carry-less range coder over 32 bit arithmetic. The interval [low, high)
// is narrowed by each symbol; whenever the two ends share a top byte, that
// byte is shifted out. The underflow counter handles the case where the
// interval straddles the midpoint without converging.
class ArithmeticEncoder {

    fn init(ref self) {
        self.low = 0;
        self.high = CODER_MAX;
        self.underflow = 0;
        self.out.clear();
        self.writer.init(BitOrder.MsbFirst);
        self.symbols_written = 0;
    }

    fn range(self) -> int {
        return self.high - self.low + 1;
    }

    // Narrow the interval to the sub-range assigned to `symbol` by `model`.
    fn encode_symbol(ref self, ref model: AdaptiveModel, symbol: int) {
        let total = model.total_frequency();
        let low_count = model.cumulative_below(symbol);
        let high_count = low_count + model.frequency_of(symbol);
        let span = self.high - self.low + 1;

        self.high = self.low + (span * high_count) / total - 1;
        self.low = self.low + (span * low_count) / total;
        self.normalise();
        model.update(symbol);
        self.symbols_written += 1;
    }

    // Shift out every bit the two ends now agree on, and absorb straddling
    // intervals into the underflow counter.
    fn normalise(ref self) {
        while (true) {
            if (((self.low ^ self.high) & HIGH_BIT_32) == 0) {
                // Top bits agree: emit it, plus any pending underflow bits
                // with the opposite value.
                let bit = (self.low >> 31) & 1;
                self.writer.put_bit(bit);
                while (self.underflow > 0) {
                    self.writer.put_bit((^bit) & 1);
                    self.underflow -= 1;
                }
            } else {
                if ((self.low & 1073741824) != 0 and (self.high & 1073741824) == 0) {
                    // 0x40000000: straddling the midpoint. Defer the
                    // decision by removing the second bit and counting it.
                    self.underflow += 1;
                    self.low = self.low & 1073741823;                       // 0x3FFFFFFF
                    self.high = self.high | 1073741824;                     // 0x40000000
                } else {
                    return;
                }
            }
            self.low = (self.low << 1) & WORD_MASK;
            self.high = ((self.high << 1) | 1) & WORD_MASK;
        }
    }

    // Flush enough bits to disambiguate the final interval.
    fn finish(ref self) {
        let bit = (self.low >> 30) & 1;
        self.writer.put_bit(bit);
        self.underflow += 1;
        while (self.underflow > 0) {
            self.writer.put_bit((^bit) & 1);
            self.underflow -= 1;
        }
        self.writer.align();
    }

    fn encode_buffer(ref self, input: ByteBuffer, ref model: AdaptiveModel) {
        self.init();
        var i: int = 0;
        while (i < input.size()) {
            self.encode_symbol(model, input.at(i));
            i += 1;
        }
        // A dedicated stop symbol marks the end of the stream so the decoder
        // does not need an explicit length.
        self.encode_symbol(model, 256);
        self.finish();
    }

    var writer: BitWriter;
    var out: ByteBuffer;
    var low: int = 0;
    var high: int = 4294967295;
    var underflow: int = 0;
    var symbols_written: int = 0;
}

// --- Arithmetic decoder --------------------------------------------------

class ArithmeticDecoder {

    fn init(ref self, input: ByteBuffer) {
        self.low = 0;
        self.high = CODER_MAX;
        self.code = 0;
        self.reader.init(BitOrder.MsbFirst);
        self.reader.source = input;
        self.reader.source.rewind();
        var i: int = 0;
        while (i < WORD_BITS) {
            self.code = ((self.code << 1) | self.reader.get_bit()) & WORD_MASK;
            i += 1;
        }
        self.symbols_read = 0;
    }

    // Map the current code point back onto a cumulative frequency, ask the
    // model which symbol owns it, then narrow exactly as the encoder did.
    fn decode_symbol(ref self, ref model: AdaptiveModel) -> int {
        let total = model.total_frequency();
        let span = self.high - self.low + 1;
        let offset = self.code - self.low;
        let target = ((offset + 1) * total - 1) / span;

        let symbol = model.symbol_for(target);
        let low_count = model.cumulative_below(symbol);
        let high_count = low_count + model.frequency_of(symbol);

        self.high = self.low + (span * high_count) / total - 1;
        self.low = self.low + (span * low_count) / total;
        self.normalise();
        model.update(symbol);
        self.symbols_read += 1;
        return symbol;
    }

    fn normalise(ref self) {
        while (true) {
            if (((self.low ^ self.high) & HIGH_BIT_32) == 0) {
                Discard(0);
            } else {
                if ((self.low & 1073741824) != 0 and (self.high & 1073741824) == 0) {
                    self.code = self.code ^ 1073741824;                     // 0x40000000
                    self.low = self.low & 1073741823;                       // 0x3FFFFFFF
                    self.high = self.high | 1073741824;
                } else {
                    return;
                }
            }
            self.low = (self.low << 1) & WORD_MASK;
            self.high = ((self.high << 1) | 1) & WORD_MASK;
            self.code = ((self.code << 1) | self.reader.get_bit()) & WORD_MASK;
        }
    }

    fn decode_buffer(ref self, ref model: AdaptiveModel, ref output: ByteBuffer, limit: int) -> Status {
        var produced: int = 0;
        while (true) {
            let symbol = self.decode_symbol(model);
            if (symbol == 256) {
                return Status.Ok;
            }
            if (symbol < 0 or symbol > 256) {
                return Status.CorruptStream;
            }
            output.push(symbol);
            produced += 1;
            if (produced > limit) {
                return Status.OutputFull;
            }
            if (self.reader.failed()) {
                return Status.NeedMoreInput;
            }
        }
    }

    var reader: BitReader;
    var low: int = 0;
    var high: int = 4294967295;
    var code: int = 0;
    var symbols_read: int = 0;
}

// --- CRC32 ---------------------------------------------------------------

// The table is generated rather than transcribed. Entry i is the remainder
// of the reflected polynomial division of i, computed by shifting the byte
// through eight times and folding in the polynomial whenever a one falls off
// the bottom.
class Crc32 {

    fn init(ref self) {
        self.build_table();
        self.build_slices();
        self.value = CRC32_INIT;
    }

    fn build_table(ref self) {
        self.table.clear();
        self.table.resize(CRC32_TABLE_SIZE);
        var i: int = 0;
        while (i < CRC32_TABLE_SIZE) {
            var remainder = i;
            var bit: int = 0;
            while (bit < BYTE_BITS) {
                if ((remainder & 1) != 0) {
                    remainder = ((remainder >> 1) & 2147483647) ^ CRC32_POLY;
                } else {
                    remainder = (remainder >> 1) & 2147483647;
                }
                bit += 1;
            }
            self.table.at(i) = remainder & WORD_MASK;
            i += 1;
        }
    }

    // Slicing-by-eight: table k holds the effect of a byte that is k
    // positions further back in the stream, so eight bytes can be folded per
    // iteration. Each slice is derived from the previous one.
    fn build_slices(ref self) {
        self.slices.clear();
        self.slices.resize(CRC32_SLICE_COUNT * CRC32_TABLE_SIZE);
        var i: int = 0;
        while (i < CRC32_TABLE_SIZE) {
            self.slices.at(i) = self.table.at(i);
            i += 1;
        }
        var slice: int = 1;
        while (slice < CRC32_SLICE_COUNT) {
            i = 0;
            while (i < CRC32_TABLE_SIZE) {
                let previous = self.slices.at((slice - 1) * CRC32_TABLE_SIZE + i);
                let folded = self.table.at(previous & BYTE_MASK) ^ ((previous >> BYTE_BITS) & 16777215);
                self.slices.at(slice * CRC32_TABLE_SIZE + i) = folded & WORD_MASK;
                i += 1;
            }
            slice += 1;
        }
    }

    fn reset(ref self) {
        self.value = CRC32_INIT;
    }

    fn update_byte(ref self, byte_value: int) {
        let index = (self.value ^ (byte_value & BYTE_MASK)) & BYTE_MASK;
        self.value = (self.table.at(index) ^ ((self.value >> BYTE_BITS) & 16777215)) & WORD_MASK;
    }

    fn update(ref self, input: ByteBuffer) {
        var i: int = 0;
        while (i < input.size()) {
            self.update_byte(input.at(i));
            i += 1;
        }
    }

    // The eight-byte-at-a-time inner loop. Each of the eight tables is
    // indexed by one byte of the combined running value, and the eight
    // results are exclusive-ored together.
    fn update_fast(ref self, input: ByteBuffer) {
        var i: int = 0;
        let n = input.size();
        while (i + CRC32_SLICE_COUNT <= n) {
            let word_low = input.at(i) | (input.at(i + 1) << 8) | (input.at(i + 2) << 16) | (input.at(i + 3) << 24);
            let word_high = input.at(i + 4) | (input.at(i + 5) << 8) | (input.at(i + 6) << 16) | (input.at(i + 7) << 24);
            let mixed = (self.value ^ word_low) & WORD_MASK;

            var folded: int = 0;
            folded = folded ^ self.slices.at(7 * CRC32_TABLE_SIZE + (mixed & BYTE_MASK));
            folded = folded ^ self.slices.at(6 * CRC32_TABLE_SIZE + ((mixed >> 8) & BYTE_MASK));
            folded = folded ^ self.slices.at(5 * CRC32_TABLE_SIZE + ((mixed >> 16) & BYTE_MASK));
            folded = folded ^ self.slices.at(4 * CRC32_TABLE_SIZE + ((mixed >> 24) & BYTE_MASK));
            folded = folded ^ self.slices.at(3 * CRC32_TABLE_SIZE + (word_high & BYTE_MASK));
            folded = folded ^ self.slices.at(2 * CRC32_TABLE_SIZE + ((word_high >> 8) & BYTE_MASK));
            folded = folded ^ self.slices.at(1 * CRC32_TABLE_SIZE + ((word_high >> 16) & BYTE_MASK));
            folded = folded ^ self.slices.at((word_high >> 24) & BYTE_MASK);

            self.value = folded & WORD_MASK;
            i += CRC32_SLICE_COUNT;
        }
        while (i < n) {
            self.update_byte(input.at(i));
            i += 1;
        }
    }

    fn digest(self) -> int {
        return (self.value ^ CRC32_INIT) & WORD_MASK;
    }

    fn checksum(ref self, input: ByteBuffer) -> int {
        self.reset();
        self.update(input);
        return self.digest();
    }

    // Combine the checksums of two concatenated buffers without rescanning
    // either, by advancing the first checksum through `length` zero bytes.
    fn combine(ref self, first: int, second: int, length: int) -> int {
        var running = (first ^ CRC32_INIT) & WORD_MASK;
        var i: int = 0;
        while (i < length) {
            let index = running & BYTE_MASK;
            running = (self.table.at(index) ^ ((running >> BYTE_BITS) & 16777215)) & WORD_MASK;
            i += 1;
        }
        return ((running ^ CRC32_INIT) ^ second) & WORD_MASK;
    }

    var table: vector(int);
    var slices: vector(int);
    var value: int = 4294967295;
}

// --- Adler32 -------------------------------------------------------------

// Two running sums modulo 65521: `a` accumulates the bytes and `b`
// accumulates `a`. The modulo is deferred for up to ADLER_NMAX bytes, which
// is the largest run that provably cannot overflow 32 bits.
class Adler32 {

    fn reset(ref self) {
        self.a = 1;
        self.b = 0;
    }

    fn update_byte(ref self, byte_value: int) {
        self.a = (self.a + (byte_value & BYTE_MASK)) % ADLER_BASE;
        self.b = (self.b + self.a) % ADLER_BASE;
    }

    fn update(ref self, input: ByteBuffer) {
        var i: int = 0;
        let n = input.size();
        while (i < n) {
            let span = min_int(ADLER_NMAX, n - i);
            var k: int = 0;
            while (k < span) {
                self.a += input.at(i + k) & BYTE_MASK;
                self.b += self.a;
                k += 1;
            }
            self.a = self.a % ADLER_BASE;
            self.b = self.b % ADLER_BASE;
            i += span;
        }
    }

    fn digest(self) -> int {
        return ((self.b << SHORT_BITS) | self.a) & WORD_MASK;
    }

    fn checksum(ref self, input: ByteBuffer) -> int {
        self.reset();
        self.update(input);
        return self.digest();
    }

    // Combine two Adler sums the way the zlib helper does: the second half's
    // `a` contribution is folded in and `b` is advanced by length * a.
    fn combine(ref self, first: int, second: int, length: int) -> int {
        let remainder = length % ADLER_BASE;
        let first_a = first & SHORT_MASK;
        let first_b = (first >> SHORT_BITS) & SHORT_MASK;
        let second_a = second & SHORT_MASK;
        let second_b = (second >> SHORT_BITS) & SHORT_MASK;

        var combined_a = (first_a + second_a - 1) % ADLER_BASE;
        var combined_b = (remainder * first_a + first_b + second_b - remainder) % ADLER_BASE;
        if (combined_a < 0) {
            combined_a += ADLER_BASE;
        }
        if (combined_b < 0) {
            combined_b += ADLER_BASE;
        }
        return ((combined_b << SHORT_BITS) | combined_a) & WORD_MASK;
    }

    var a: int = 1;
    var b: int = 0;
}

// --- Block sorting pipeline ---------------------------------------------

// The bzip-style stack: RLE, then the Burrows-Wheeler transform, then
// move-to-front, then a second RLE over the zero runs MTF produces, then a
// Huffman stage. Each step is reversible on its own, so the harness can
// round-trip any prefix of the chain.
class BlockSortPipeline {

    fn compress(ref self, input: ByteBuffer, ref output: ByteBuffer) -> Status {
        var after_rle = ByteBuffer();
        var rle = RleCodec();
        rle.encode(input, after_rle);

        var after_bwt = ByteBuffer();
        var bwt = BurrowsWheeler();
        let primary = bwt.transform(after_rle, after_bwt);

        var after_mtf = ByteBuffer();
        var mtf = MoveToFront();
        mtf.encode(after_bwt, after_mtf);

        var after_second_rle = ByteBuffer();
        var second = RleCodec();
        second.encode(after_mtf, after_second_rle);

        // The header records the primary index and the two intermediate
        // lengths so the inverse can be driven without re-deriving them.
        output.push_word_le(primary);
        output.push_word_le(after_rle.size());
        output.push_word_le(after_mtf.size());

        var frequencies = FrequencyTable();
        frequencies.init(257);
        frequencies.count_bytes(after_second_rle);
        frequencies.add(256);
        frequencies.ensure_two_symbols();

        var tree = HuffmanTree();
        if (not tree.build(frequencies)) {
            return Status.BadCodeLengths;
        }
        var table = EncodeTable();
        table.build(tree);

        var writer = BitWriter();
        writer.init(BitOrder.MsbFirst);
        var symbol: int = 0;
        while (symbol < 257) {
            writer.put_bits_msb(tree.lengths.at(symbol), 4);
            symbol += 1;
        }
        var i: int = 0;
        while (i < after_second_rle.size()) {
            table.emit(writer, after_second_rle.at(i));
            i += 1;
        }
        table.emit(writer, 256);
        writer.flush();
        output.append(writer.out);

        self.primary_index = primary;
        self.stage_sizes.clear();
        self.stage_sizes.push_back(input.size());
        self.stage_sizes.push_back(after_rle.size());
        self.stage_sizes.push_back(after_bwt.size());
        self.stage_sizes.push_back(after_mtf.size());
        self.stage_sizes.push_back(after_second_rle.size());
        self.stage_sizes.push_back(output.size());

        Destroy(after_rle);
        Destroy(after_bwt);
        Destroy(after_mtf);
        Destroy(after_second_rle);
        return Status.Ok;
    }

    fn decompress(ref self, input: ByteBuffer, ref output: ByteBuffer) -> Status {
        var source = input;
        source.rewind();
        let primary = source.read_word_le();
        let rle_size = source.read_word_le();
        let mtf_size = source.read_word_le();
        Discard(rle_size);

        var reader = BitReader();
        reader.init(BitOrder.MsbFirst);
        reader.source = source;

        var lengths = vector(int)(257);
        var symbol: int = 0;
        while (symbol < 257) {
            lengths.at(symbol) = reader.get_bits_msb(4);
            symbol += 1;
        }
        var table = DecodeTable();
        if (not table.build(lengths)) {
            return Status.BadCodeLengths;
        }

        var after_second_rle = ByteBuffer();
        while (true) {
            let decoded = table.decode(reader);
            if (decoded < 0) {
                return Status.CorruptStream;
            }
            if (decoded == 256) {
                break;
            }
            after_second_rle.push(decoded);
            if (reader.failed()) {
                return Status.NeedMoreInput;
            }
        }

        var after_mtf = ByteBuffer();
        var second = RleCodec();
        let second_status = second.decode(after_second_rle, after_mtf);
        if (second_status != Status.Ok) {
            return second_status;
        }
        Discard(mtf_size);

        var after_bwt = ByteBuffer();
        var mtf = MoveToFront();
        mtf.decode(after_mtf, after_bwt);

        var after_rle = ByteBuffer();
        var bwt = BurrowsWheeler();
        let inverse_status = bwt.inverse(after_bwt, primary, after_rle);
        if (inverse_status != Status.Ok) {
            return inverse_status;
        }

        var rle = RleCodec();
        return rle.decode(after_rle, output);
    }

    var stage_sizes: vector(int);
    var primary_index: int = 0;
}

// --- Test data generation ------------------------------------------------

// A small xorshift generator so the harness has reproducible pseudo-random
// input without depending on anything outside this file.
class Xorshift {

    fn init(ref self, seed: int) {
        if (seed == 0) {
            self.state = 2463534242;                // 0x92D68CA2
        } else {
            self.state = seed & WORD_MASK;
        }
    }

    fn next(ref self) -> int {
        var x = self.state & WORD_MASK;
        x = x ^ ((x << 13) & WORD_MASK);
        x = x ^ ((x >> 17) & 32767);
        x = x ^ ((x << 5) & WORD_MASK);
        self.state = x & WORD_MASK;
        return self.state;
    }

    fn next_byte(ref self) -> int {
        return self.next() & BYTE_MASK;
    }

    fn next_below(ref self, bound: int) -> int {
        if (bound <= 0) {
            return 0;
        }
        return self.next() % bound;
    }

    var state: int = 2463534242;
}

// Highly compressible input: long runs of a small alphabet.
fn make_runny_buffer(length: int, seed: int) -> ByteBuffer {
    var out = ByteBuffer();
    var rng = Xorshift();
    rng.init(seed);
    while (out.size() < length) {
        let value = 97 + rng.next_below(4);          // 'a' .. 'd'
        let run = 1 + rng.next_below(40);
        var i: int = 0;
        while (i < run) {
            if (out.size() >= length) {
                return out;
            }
            out.push(value);
            i += 1;
        }
    }
    return out;
}

// Input with strong long-range repetition: a random block repeated with
// small mutations, which is what exercises the hash chain finder.
fn make_repetitive_buffer(length: int, period: int, seed: int) -> ByteBuffer {
    var out = ByteBuffer();
    var rng = Xorshift();
    rng.init(seed);
    var pattern = ByteBuffer();
    var i: int = 0;
    while (i < period) {
        pattern.push(rng.next_byte());
        i += 1;
    }
    i = 0;
    while (i < length) {
        var value = pattern.at(i % period);
        if (rng.next_below(64) == 0) {
            value = rng.next_byte();
        }
        out.push(value);
        i += 1;
    }
    Destroy(pattern);
    return out;
}

// Incompressible input: uniform random bytes. The block splitter should
// choose stored blocks for this.
fn make_random_buffer(length: int, seed: int) -> ByteBuffer {
    var out = ByteBuffer();
    var rng = Xorshift();
    rng.init(seed);
    var i: int = 0;
    while (i < length) {
        out.push(rng.next_byte());
        i += 1;
    }
    return out;
}

// Text-like input drawn from a skewed alphabet, which is where Huffman
// coding earns its keep.
fn make_texty_buffer(length: int, seed: int) -> ByteBuffer {
    var out = ByteBuffer();
    var rng = Xorshift();
    rng.init(seed);
    var i: int = 0;
    while (i < length) {
        let roll = rng.next_below(100);
        if (roll < 60) {
            out.push(101);                           // 'e'
        } else { if (roll < 80) {
            out.push(116);                           // 't'
        } else { if (roll < 90) {
            out.push(32);                            // space
        } else {
            out.push(97 + rng.next_below(26));
        }
        } }
        i += 1;
    }
    return out;
}

// --- Round-trip harness --------------------------------------------------

// Every codec in the file is exercised the same way: compress, decompress,
// compare byte for byte, and assert the structural invariants that the
// implementation is supposed to maintain.

fn verify_bit_round_trip(order: BitOrder, seed: int) -> bool {
    var writer = BitWriter();
    writer.init(order);
    var rng = Xorshift();
    rng.init(seed);

    var values = vector(int)();
    var widths = vector(int)();
    var i: int = 0;
    while (i < 512) {
        let width = 1 + rng.next_below(16);
        let value = rng.next() & ((1 << width) - 1);
        values.push_back(value);
        widths.push_back(width);
        writer.put_bits(value, width);
        i += 1;
    }
    let expected_bits = writer.bit_position();
    writer.flush();
    Assert(writer.is_aligned());

    var reader = BitReader();
    reader.init(order);
    reader.source = writer.out;
    reader.source.rewind();

    i = 0;
    while (i < values.size()) {
        let decoded = reader.get_bits(widths.at(i));
        if (decoded != values.at(i)) {
            Destroy(values);
            Destroy(widths);
            return false;
        }
        i += 1;
    }
    Prove(reader.bit_position() == expected_bits);
    Assert(not reader.failed());
    Destroy(values);
    Destroy(widths);
    return true;
}

fn verify_reverse_bits() -> bool {
    var width: int = 1;
    while (width <= 15) {
        var value: int = 0;
        let limit = 1 << width;
        while (value < limit) {
            let there = reverse_bits(value, width);
            let back = reverse_bits(there, width);
            if (back != value) {
                return false;
            }
            value += 1;
            if (value > 4096) {
                break;
            }
        }
        width += 1;
    }
    Prove(reverse_bits(1, 8) == 128);
    Prove(reverse_bits(0, 8) == 0);
    return true;
}

fn verify_popcount() -> bool {
    var i: int = 0;
    while (i < 4096) {
        var manual: int = 0;
        var bit: int = 0;
        while (bit < 32) {
            manual += (i >> bit) & 1;
            bit += 1;
        }
        if (popcount32(i) != manual) {
            return false;
        }
        i += 1;
    }
    Prove(popcount32(0) == 0);
    Prove(popcount32(255) == 8);
    return true;
}

// The Kraft equality is the structural invariant of a complete prefix code:
// after building and after length limiting, the sum must be exact.
fn verify_huffman_tree(input: ByteBuffer) -> bool {
    var frequencies = FrequencyTable();
    frequencies.init(257);
    frequencies.count_bytes(input);
    frequencies.add(256);
    frequencies.ensure_two_symbols();
    Assert(frequencies.used >= 2);

    var tree = HuffmanTree();
    if (not tree.build(frequencies)) {
        return false;
    }
    Assert(tree.max_length <= MAX_CODE_LENGTH);
    Assert(tree.max_length > 0);
    Prove(tree.kraft_sum() == (1 << tree.max_length));

    // Every used symbol must have a length, and no unused symbol may.
    var symbol: int = 0;
    while (symbol < 257) {
        if (frequencies.at(symbol) > 0) {
            if (tree.lengths.at(symbol) == 0) {
                return false;
            }
        } else {
            if (tree.lengths.at(symbol) != 0) {
                return false;
            }
        }
        symbol += 1;
    }

    // Canonical codes must be strictly increasing within a length class.
    var length: int = 1;
    while (length <= tree.max_length) {
        var previous: int = -1;
        symbol = 0;
        while (symbol < 257) {
            if (tree.lengths.at(symbol) == length) {
                if (tree.codes.at(symbol) <= previous) {
                    return false;
                }
                previous = tree.codes.at(symbol);
            }
            symbol += 1;
        }
        length += 1;
    }
    return true;
}

// Encode every symbol through the encode table and decode it back through
// the two-level decode table, checking that the tables agree.
fn verify_huffman_tables(input: ByteBuffer) -> bool {
    var frequencies = FrequencyTable();
    frequencies.init(257);
    frequencies.count_bytes(input);
    frequencies.add(256);
    frequencies.ensure_two_symbols();

    var tree = HuffmanTree();
    if (not tree.build(frequencies)) {
        return false;
    }
    var encode_table = EncodeTable();
    encode_table.build(tree);
    var decode_table = DecodeTable();
    if (not decode_table.build(tree.lengths)) {
        return false;
    }

    var writer = BitWriter();
    writer.init(BitOrder.LsbFirst);
    var i: int = 0;
    while (i < input.size()) {
        encode_table.emit_reversed(writer, input.at(i));
        i += 1;
    }
    encode_table.emit_reversed(writer, 256);
    writer.flush();

    var reader = BitReader();
    reader.init(BitOrder.LsbFirst);
    reader.source = writer.out;
    reader.source.rewind();

    i = 0;
    while (true) {
        let decoded = decode_table.decode(reader);
        if (decoded < 0) {
            return false;
        }
        if (decoded == 256) {
            break;
        }
        if (i >= input.size()) {
            return false;
        }
        if (decoded != input.at(i)) {
            return false;
        }
        i += 1;
    }
    Assert(i == input.size());
    return true;
}

// Code length limiting must not break completeness, and the limited code can
// only ever be worse than the unlimited one by a bounded amount.
fn verify_length_limiting(input: ByteBuffer, limit: int) -> bool {
    var frequencies = FrequencyTable();
    frequencies.init(257);
    frequencies.count_bytes(input);
    frequencies.add(256);
    frequencies.ensure_two_symbols();

    var tree = HuffmanTree();
    if (not tree.build(frequencies)) {
        return false;
    }
    let unlimited_bits = tree.encoded_bits(frequencies);

    tree.limit_code_lengths(limit);
    tree.assign_canonical();
    var symbol: int = 0;
    while (symbol < 257) {
        if (tree.lengths.at(symbol) > limit) {
            return false;
        }
        symbol += 1;
    }
    let limited_bits = tree.encoded_bits(frequencies);
    Assert(limited_bits >= 0);
    Prove(unlimited_bits >= 0);
    return true;
}

fn verify_lz77_round_trip(input: ByteBuffer, level: int) -> bool {
    var encoder = Lz77Encoder();
    encoder.init(level);
    encoder.encode(input);

    // Every token must reference something already produced.
    var produced: int = 0;
    var i: int = 0;
    while (i < encoder.tokens.size()) {
        let ref token: auto = encoder.tokens.at(i);
        if (token.is_match()) {
            if (token.distance > produced) {
                return false;
            }
            if (token.length < MIN_MATCH or token.length > MAX_MATCH) {
                return false;
            }
            produced += token.length;
        } else {
            produced += 1;
        }
        i += 1;
    }
    Assert(produced == input.size());

    var output = ByteBuffer();
    let status = lz77_decode(encoder.tokens, output);
    if (status != Status.Ok) {
        return false;
    }
    if (not output.equals(input)) {
        return false;
    }
    Prove(output.size() == input.size());
    Destroy(output);
    return true;
}

fn verify_deflate_round_trip(input: ByteBuffer, level: int) -> bool {
    var encoder = DeflateEncoder();
    encoder.init(level);
    let compress_status = encoder.compress(input);
    if (compress_status != Status.Ok) {
        return false;
    }

    var decoder = DeflateDecoder();
    decoder.init();
    var output = ByteBuffer();
    let decompress_status = decoder.decompress(encoder.writer.out, output);
    if (decompress_status != Status.Ok) {
        return false;
    }
    if (not output.equals(input)) {
        return false;
    }

    Assert(decoder.blocks_read >= 1);
    Prove(output.size() == input.size());
    Destroy(output);
    return true;
}

fn verify_rle_round_trip(input: ByteBuffer) -> bool {
    var codec = RleCodec();
    var encoded = ByteBuffer();
    codec.encode(input, encoded);

    var decoded = ByteBuffer();
    let status = codec.decode(encoded, decoded);
    if (status != Status.Ok) {
        return false;
    }
    if (not decoded.equals(input)) {
        return false;
    }
    Prove(decoded.size() == input.size());
    Destroy(encoded);
    Destroy(decoded);
    return true;
}

fn verify_mtf_round_trip(input: ByteBuffer) -> bool {
    var mtf = MoveToFront();
    var encoded = ByteBuffer();
    mtf.encode(input, encoded);
    Assert(encoded.size() == input.size());

    var decoded = ByteBuffer();
    mtf.decode(encoded, decoded);
    if (not decoded.equals(input)) {
        return false;
    }
    Prove(decoded.size() == input.size());
    Destroy(encoded);
    Destroy(decoded);
    return true;
}

fn verify_bwt_round_trip(input: ByteBuffer) -> bool {
    var bwt = BurrowsWheeler();
    var transformed = ByteBuffer();
    let primary = bwt.transform(input, transformed);
    Assert(transformed.size() == input.size());
    Assert(primary >= 0);

    var restored = ByteBuffer();
    let status = bwt.inverse(transformed, primary, restored);
    if (status != Status.Ok) {
        return false;
    }
    if (not restored.equals(input)) {
        return false;
    }
    Prove(restored.size() == input.size());
    Destroy(transformed);
    Destroy(restored);
    return true;
}

fn verify_arithmetic_round_trip(input: ByteBuffer) -> bool {
    var encode_model = AdaptiveModel();
    encode_model.init(257);
    var encoder = ArithmeticEncoder();
    encoder.encode_buffer(input, encode_model);

    var decode_model = AdaptiveModel();
    decode_model.init(257);
    var decoder = ArithmeticDecoder();
    decoder.init(encoder.writer.out);
    var output = ByteBuffer();
    let status = decoder.decode_buffer(decode_model, output, input.size() + 16);
    if (status != Status.Ok) {
        return false;
    }
    if (not output.equals(input)) {
        return false;
    }
    Assert(decoder.symbols_read == encoder.symbols_written);
    Prove(output.size() == input.size());
    Destroy(output);
    return true;
}

// The Fenwick tree inside the model must agree with a naive scan of the raw
// frequency array at every point.
fn verify_model_consistency() -> bool {
    var model = AdaptiveModel();
    model.init(257);
    var rng = Xorshift();
    rng.init(9187);

    var step: int = 0;
    while (step < 2000) {
        let symbol = rng.next_below(257);
        model.update(symbol);
        step += 1;
    }

    var running: int = 0;
    var symbol: int = 0;
    while (symbol < 257) {
        if (model.cumulative_below(symbol) != running) {
            return false;
        }
        running += model.frequency_of(symbol);
        symbol += 1;
    }
    Assert(running == model.total_frequency());

    // Every point in the cumulative range must map back to a symbol whose
    // interval contains it.
    var target: int = 0;
    while (target < model.total_frequency()) {
        let found = model.symbol_for(target);
        let low = model.cumulative_below(found);
        let high = low + model.frequency_of(found);
        if (target < low or target >= high) {
            return false;
        }
        target += 37;
    }
    return true;
}

fn verify_checksums(input: ByteBuffer) -> bool {
    var crc = Crc32();
    crc.init();
    let simple = crc.checksum(input);

    crc.reset();
    crc.update_fast(input);
    let sliced = crc.digest();
    if (simple != sliced) {
        return false;
    }

    // The generated table must reproduce the known check value for the
    // string "123456789".
    var digits = ByteBuffer();
    var i: int = 0;
    while (i < 9) {
        digits.push(49 + i);                          // '1' .. '9'
        i += 1;
    }
    let check = crc.checksum(digits);
    Assert(check == 3421780262);                       // 0xCBF43926

    var adler = Adler32();
    let adler_value = adler.checksum(digits);
    Assert(adler_value == 152961502);                  // 0x091E01DE
    Prove(adler_value > 0);

    // An empty buffer has the identity Adler value.
    var empty = ByteBuffer();
    let empty_adler = adler.checksum(empty);
    Assert(empty_adler == 1);

    Destroy(digits);
    Destroy(empty);
    return true;
}

fn verify_block_sort_round_trip(input: ByteBuffer) -> bool {
    var pipeline = BlockSortPipeline();
    var compressed = ByteBuffer();
    let status = pipeline.compress(input, compressed);
    if (status != Status.Ok) {
        return false;
    }

    var output = ByteBuffer();
    let inverse_status = pipeline.decompress(compressed, output);
    if (inverse_status != Status.Ok) {
        return false;
    }
    if (not output.equals(input)) {
        return false;
    }
    Assert(pipeline.stage_sizes.size() == 6);
    Prove(output.size() == input.size());
    Destroy(compressed);
    Destroy(output);
    return true;
}

// The deflate symbol tables are regular by construction; check that the
// generated bases and the arithmetic free functions agree everywhere.
fn verify_deflate_tables() -> bool {
    var tables = DeflateTables();
    tables.init();
    Assert(tables.ready);
    Assert(tables.code_length_order.size() == CODE_LENGTH_SYMBOLS);

    var length = MIN_MATCH;
    while (length <= MAX_MATCH) {
        let code = tables.length_code(length);
        if (code != length_code_of(length)) {
            return false;
        }
        let anchor = tables.length_base.at(code);
        let extra = tables.length_extra.at(code);
        if (length < anchor) {
            return false;
        }
        if (code < 28) {
            if (length >= anchor + (1 << extra)) {
                return false;
            }
        }
        if (extra != extra_length_bits(code)) {
            return false;
        }
        length += 1;
    }

    var distance: int = 1;
    while (distance <= MAX_DISTANCE) {
        let code = tables.distance_code(distance);
        if (code != distance_code_of(distance)) {
            return false;
        }
        let anchor = tables.distance_base.at(code);
        let extra = tables.distance_extra.at(code);
        if (distance < anchor) {
            return false;
        }
        if (distance >= anchor + (1 << extra)) {
            return false;
        }
        distance += 1;
    }

    Prove(tables.length_base.at(0) == MIN_MATCH);
    Prove(tables.distance_base.at(0) == 1);
    return true;
}

// The heap has to remain a heap after every operation, and popping must
// yield a non-decreasing sequence of weights.
fn verify_priority_queue() -> bool {
    var queue = NodeQueue();
    var rng = Xorshift();
    rng.init(4242);

    var i: int = 0;
    while (i < 500) {
        queue.push(i, rng.next_below(10000));
        i += 1;
    }
    Assert(queue.is_heap());
    Assert(queue.size() == 500);

    var previous: int = -1;
    while (not queue.empty()) {
        let weight = queue.top_weight();
        if (weight < previous) {
            return false;
        }
        previous = weight;
        Discard(queue.pop());
    }
    Prove(queue.size() == 0);
    return true;
}

// --- Entry point ---------------------------------------------------------

// Run every verifier over every kind of input at every level.
fn run_all_checks() -> int {
    var failures: int = 0;

    if (not verify_bit_round_trip(BitOrder.MsbFirst, 1)) {
        failures += 1;
    }
    if (not verify_bit_round_trip(BitOrder.LsbFirst, 2)) {
        failures += 1;
    }
    if (not verify_reverse_bits()) {
        failures += 1;
    }
    if (not verify_popcount()) {
        failures += 1;
    }
    if (not verify_deflate_tables()) {
        failures += 1;
    }
    if (not verify_priority_queue()) {
        failures += 1;
    }
    if (not verify_model_consistency()) {
        failures += 1;
    }

    var inputs = vector(ByteBuffer)();
    inputs.push_back(make_runny_buffer(4096, 11));
    inputs.push_back(make_repetitive_buffer(8192, 61, 12));
    inputs.push_back(make_random_buffer(2048, 13));
    inputs.push_back(make_texty_buffer(8192, 14));

    var index: int = 0;
    while (index < inputs.size()) {
        let ref sample: auto = inputs.at(index);

        if (not verify_huffman_tree(sample)) {
            failures += 1;
        }
        if (not verify_huffman_tables(sample)) {
            failures += 1;
        }
        if (not verify_length_limiting(sample, 12)) {
            failures += 1;
        }
        if (not verify_rle_round_trip(sample)) {
            failures += 1;
        }
        if (not verify_mtf_round_trip(sample)) {
            failures += 1;
        }
        if (not verify_arithmetic_round_trip(sample)) {
            failures += 1;
        }
        if (not verify_checksums(sample)) {
            failures += 1;
        }

        var level: int = 0;
        while (level <= 9) {
            if (not verify_lz77_round_trip(sample, level)) {
                failures += 1;
            }
            if (not verify_deflate_round_trip(sample, level)) {
                failures += 1;
            }
            level += 1;
        }

        index += 1;
    }

    // The Burrows-Wheeler round trip is quadratic in the block size, so it
    // only runs over a short prefix.
    var small = make_runny_buffer(512, 21);
    if (not verify_bwt_round_trip(small)) {
        failures += 1;
    }
    if (not verify_block_sort_round_trip(small)) {
        failures += 1;
    }

    Assert(failures >= 0);
    Prove(failures == 0);
    Destroy(small);
    Destroy(inputs);
    return failures;
}

// Human readable name for a status code, used by the report below.
fn status_name(status: Status) -> string {
    if (status == Status.Ok) {
        return "ok";
    } else { if (status == Status.NeedMoreInput) {
        return "need more input";
    } else { if (status == Status.OutputFull) {
        return "output full";
    } else { if (status == Status.CorruptStream) {
        return "corrupt stream";
    } else { if (status == Status.BadCodeLengths) {
        return "bad code lengths";
    } else { if (status == Status.BadDistance) {
        return "bad distance";
    } else { if (status == Status.ChecksumMismatch) {
        return "checksum mismatch";
    } else {
        return "unsupported";
    }
    } } } } } }
}

// Compression ratio in percent, rounded down. A ratio above 100 means the
// codec expanded the input, which stored blocks exist to prevent.
fn ratio_percent(original: int, compressed: int) -> int {
    if (original == 0) {
        return 100;
    }
    return (compressed * 100) / original;
}

// One line of the summary table. The apostrophe is spelled through a string
// constant because the lexer has no escaped single-quote char literal.
fn report_line(label: string, original: int, compressed: int) -> string {
    var text = string();
    text.append(label);
    text.append(APOSTROPHE);
    text.append("s ratio: ");
    text.append(to_string(ratio_percent(original, compressed)));
    text.append("% (");
    text.append(to_string(original));
    text.append(" -> ");
    text.append(to_string(compressed));
    text.append(" bytes)");
    return text;
}

// Compress one sample at every level and print the resulting ratios.
fn report_levels(sample: ByteBuffer, label: string) {
    var level: int = 0;
    while (level <= 9) {
        var encoder = DeflateEncoder();
        encoder.init(level);
        let status = encoder.compress(sample);
        if (status != Status.Ok) {
            println(status_name(status));
        } else {
            println(report_line(label, sample.size(), encoder.writer.out.size()));
        }
        level += 1;
    }
}

fn main() -> int {
    let failures = run_all_checks();
    if (failures == 0) {
        println("compression: all round trips verified");
        var sample = make_texty_buffer(8192, 77);
        report_levels(sample, "texty");
        var repetitive = make_repetitive_buffer(8192, 61, 78);
        report_levels(repetitive, "repetitive");
        Destroy(sample);
        Destroy(repetitive);
    } else {
        println("compression: failures detected");
        println(to_string(failures));
    }
    return failures;
}


// A small expression language: tokenizer, Pratt parser, tree-walking
// interpreter, a constant folder and a pretty printer that round-trips the
// abstract syntax tree back to source text.
//
// The language accepted here looks like this:
//
//     let radius = 12;
//     let area = 3141 * radius ** 2 / 1000;
//     if area > 100 then "large" else "small"
//     points[0].x + offset(dx: 4, dy: 5)
//
// Numbers are stored as a scaled integer mantissa plus a decimal exponent,
// because the charge lexer only accepts plain decimal integer literals. The
// value of a literal is  mantissa * 10^exponent, so the source text `12.5`
// lexes into the pair (125, -1) and prints back out as `12.5`.
//
// The parser is a precedence climbing (Pratt) parser: a single table maps a
// token kind to a binding power, and `parse_expression` calls itself through
// the prefix, infix and postfix rules. Those functions are mutually
// recursive, which is the whole point of the design - the grammar is data,
// not control flow.
namespace expression;

// --- Character constants -------------------------------------------------
//
// The tokenizer compares raw characters on nearly every line, so each one
// that matters gets a name up here rather than being spelled inline.

let CHAR_NUL: char = '\0';
let CHAR_SPACE: char = ' ';
let CHAR_TAB: char = '\t';
let CHAR_NEWLINE: char = '\n';
let CHAR_RETURN: char = '\r';
let CHAR_QUOTE: char = '"';
let CHAR_BACKSLASH: char = '\\';
let CHAR_UNDERSCORE: char = '_';
let CHAR_DOT: char = '.';
let CHAR_COMMA: char = ',';
let CHAR_COLON: char = ':';
let CHAR_SEMICOLON: char = ';';
let CHAR_QUESTION: char = '?';
let CHAR_BANG: char = '!';
let CHAR_TILDE: char = '~';
let CHAR_PLUS: char = '+';
let CHAR_MINUS: char = '-';
let CHAR_STAR: char = '*';
let CHAR_SLASH: char = '/';
let CHAR_PERCENT: char = '%';
let CHAR_AMP: char = '&';
let CHAR_PIPE: char = '|';
let CHAR_CARET: char = '^';
let CHAR_LESS: char = '<';
let CHAR_GREATER: char = '>';
let CHAR_EQUAL: char = '=';
let CHAR_LPAREN: char = '(';
let CHAR_RPAREN: char = ')';
let CHAR_LBRACKET: char = '[';
let CHAR_RBRACKET: char = ']';
let CHAR_LBRACE: char = '{';
let CHAR_RBRACE: char = '}';
let CHAR_ZERO: char = '0';
let CHAR_NINE: char = '9';

// --- Spellings -----------------------------------------------------------
//
// Both the tokenizer and the printer need the surface text of every
// operator. Keeping them in one place is what makes the round trip exact.

let TEXT_EMPTY: string = "";
let TEXT_SPACE: string = " ";
let TEXT_NEWLINE: string = "\n";
let TEXT_INDENT: string = "    ";
let TEXT_LPAREN: string = "(";
let TEXT_RPAREN: string = ")";
let TEXT_LBRACKET: string = "[";
let TEXT_RBRACKET: string = "]";
let TEXT_LBRACE: string = "{";
let TEXT_RBRACE: string = "}";
let TEXT_COMMA_SPACE: string = ", ";
let TEXT_SEMICOLON: string = ";";
let TEXT_DOT: string = ".";
let TEXT_COLON_SPACE: string = ": ";
let TEXT_QUESTION_SPACE: string = " ? ";
let TEXT_SPACE_COLON_SPACE: string = " : ";

let WORD_LET: string = "let";
let WORD_IF: string = "if";
let WORD_THEN: string = "then";
let WORD_ELSE: string = "else";
let WORD_WHILE: string = "while";
let WORD_FN: string = "fn";
let WORD_RETURN: string = "return";
let WORD_TRUE: string = "true";
let WORD_FALSE: string = "false";
let WORD_NULL: string = "null";
let WORD_AND: string = "and";
let WORD_OR: string = "or";
let WORD_NOT: string = "not";

// Decimal scaling. A number is mantissa * 10^exponent; the tokenizer refuses
// to keep more than MAX_DIGITS significant digits so the mantissa cannot run
// away on input like 0.0000000000000000001.
let NUMBER_BASE: int = 10;
let MAX_DIGITS: int = 18;
let MIN_EXPONENT: int = -30;
let MAX_EXPONENT: int = 30;
let MAX_DEPTH: int = 96;
let MAX_ARGUMENTS: int = 32;

// --- Token kinds ---------------------------------------------------------
//
// One entry per distinct spelling. The tokenizer does maximal munch, so
// `<<=` has to be tried before `<<` and `<<` before `<`.
choice TokenKind {
    End,
    Invalid,

    Identifier,
    Number,
    Text,
    Comment,

    Plus,
    Minus,
    Star,
    Slash,
    Percent,
    StarStar,

    Amp,
    Pipe,
    Caret,
    Tilde,
    LessLess,
    GreaterGreater,

    Bang,
    AmpAmp,
    PipePipe,

    Less,
    LessEqual,
    Greater,
    GreaterEqual,
    EqualEqual,
    BangEqual,

    Equal,
    PlusEqual,
    MinusEqual,
    StarEqual,
    SlashEqual,
    PercentEqual,
    AmpEqual,
    PipeEqual,
    CaretEqual,
    LessLessEqual,
    GreaterGreaterEqual,

    PlusPlus,
    MinusMinus,

    Question,
    Colon,
    Comma,
    Semicolon,
    Dot,
    Arrow,

    LParen,
    RParen,
    LBracket,
    RBracket,
    LBrace,
    RBrace,

    KeywordLet,
    KeywordIf,
    KeywordThen,
    KeywordElse,
    KeywordWhile,
    KeywordFn,
    KeywordReturn,
    KeywordTrue,
    KeywordFalse,
    KeywordNull,
    KeywordAnd,
    KeywordOr,
    KeywordNot,
}

// --- Node kinds ----------------------------------------------------------

choice NodeKind {
    Invalid,
    NumberLiteral,
    TextLiteral,
    BoolLiteral,
    NullLiteral,
    Variable,
    Unary,
    Binary,
    Postfix,
    Assign,
    Call,
    Index,
    Member,
    Conditional,
    Let,
    Block,
    Loop,
    Return,
    Empty,
}

// --- Value kinds ---------------------------------------------------------

choice ValueKind {
    Nil,
    Bool,
    Number,
    Text,
    List,
    Builtin,
    Failure,
}

// --- Associativity -------------------------------------------------------

choice Associativity {
    None,
    Left,
    Right,
}

// --- Diagnostics ---------------------------------------------------------

choice ErrorCode {
    None,
    UnexpectedCharacter,
    UnterminatedText,
    UnterminatedComment,
    BadEscape,
    TooManyDigits,
    ExponentRange,
    ExpectedExpression,
    ExpectedToken,
    ExpectedIdentifier,
    UnbalancedParen,
    UnbalancedBracket,
    DepthExceeded,
    TooManyArguments,
    NotAssignable,
    UnknownName,
    NotCallable,
    NotIndexable,
    WrongArity,
    DivideByZero,
    TypeMismatch,
}

fn error_text(code: ErrorCode) -> string {
    if (code == ErrorCode.None) {
        return "no error";
    }
    if (code == ErrorCode.UnexpectedCharacter) {
        return "unexpected character in the input";
    }
    if (code == ErrorCode.UnterminatedText) {
        return "unterminated string literal, expected a closing quote";
    }
    if (code == ErrorCode.UnterminatedComment) {
        return "unterminated block comment, expected a closing marker";
    }
    if (code == ErrorCode.BadEscape) {
        return "invalid escape sequence after a backslash";
    }
    if (code == ErrorCode.TooManyDigits) {
        return "number has more significant digits than can be represented";
    }
    if (code == ErrorCode.ExponentRange) {
        return "decimal exponent is out of range";
    }
    if (code == ErrorCode.ExpectedExpression) {
        return "expected an expression";
    }
    if (code == ErrorCode.ExpectedToken) {
        return "expected a different token here";
    }
    if (code == ErrorCode.ExpectedIdentifier) {
        return "expected an identifier";
    }
    if (code == ErrorCode.UnbalancedParen) {
        return "expected a closing parenthesis";
    }
    if (code == ErrorCode.UnbalancedBracket) {
        return "expected a closing bracket";
    }
    if (code == ErrorCode.DepthExceeded) {
        return "expression nests too deeply";
    }
    if (code == ErrorCode.TooManyArguments) {
        return "call has too many arguments";
    }
    if (code == ErrorCode.NotAssignable) {
        return "left hand side of the assignment is not assignable";
    }
    if (code == ErrorCode.UnknownName) {
        return "name is not bound in any enclosing scope";
    }
    if (code == ErrorCode.NotCallable) {
        return "value is not callable";
    }
    if (code == ErrorCode.NotIndexable) {
        return "value cannot be indexed";
    }
    if (code == ErrorCode.WrongArity) {
        return "builtin called with the wrong number of arguments";
    }
    if (code == ErrorCode.DivideByZero) {
        return "division by zero";
    }
    if (code == ErrorCode.TypeMismatch) {
        return "operand types do not match the operator";
    }
    return "unknown error";
}

// --- Source positions ----------------------------------------------------

// Every token carries the position it started at so that a diagnostic can
// point at a line and a column rather than a bare byte offset.
class Position {

    fn advance_over(ref self, c: char) {
        self.offset += 1;
        if (c == CHAR_NEWLINE) {
            self.line += 1;
            self.column = 1;
        } else {
            self.column += 1;
        }
    }

    fn describe(self) -> string {
        var out: string = "line ";
        out.append(to_string(self.line));
        out.append(", column ");
        out.append(to_string(self.column));
        return out;
    }

    var offset: int = 0;
    var line: int = 1;
    var column: int = 1;
}

// A half open range of the source text. The printer never uses spans, but the
// interpreter quotes them back when a runtime error happens.
class Span {

    fn length(self) -> int {
        return self.end.offset - self.begin.offset;
    }

    fn empty(self) -> bool {
        return self.length() <= 0;
    }

    fn text_of(self, source: string) -> string {
        if (self.empty()) {
            return TEXT_EMPTY;
        }
        return source.substr(self.begin.offset, self.length());
    }

    fn describe(self) -> string {
        var out = self.begin.describe();
        if (self.end.line != self.begin.line) {
            out.append(" through ");
            out.append(self.end.describe());
        }
        return out;
    }

    var begin: Position;
    var end: Position;
}

class Diagnostic {

    fn ok(self) -> bool {
        return self.code == ErrorCode.None;
    }

    fn describe(self) -> string {
        var out = self.where_.describe();
        out.append(": ");
        out.append(error_text(self.code));
        if (self.detail.size() > 0) {
            out.append(" (");
            out.append(self.detail);
            out.append(")");
        }
        return out;
    }

    var code: ErrorCode = ErrorCode.None;
    var where_: Position;
    var detail: string;
}

// --- Tokens --------------------------------------------------------------

class Token {

    fn is_end(self) -> bool {
        return self.kind == TokenKind.End;
    }

    fn is_literal(self) -> bool {
        if (self.kind == TokenKind.Number) {
            return true;
        }
        if (self.kind == TokenKind.Text) {
            return true;
        }
        if (self.kind == TokenKind.KeywordTrue) {
            return true;
        }
        if (self.kind == TokenKind.KeywordFalse) {
            return true;
        }
        if (self.kind == TokenKind.KeywordNull) {
            return true;
        }
        return false;
    }

    fn describe(self) -> string {
        var out = token_name(self.kind);
        if (self.text.size() > 0) {
            out.append(" '");
            out.append(self.text);
            out.append("'");
        }
        out.append(" at ");
        out.append(self.span.begin.describe());
        return out;
    }

    var kind: TokenKind = TokenKind.End;
    var text: string;
    var span: Span;
    // Numeric payload, only meaningful when kind is Number. The literal
    // value is mantissa * 10^exponent.
    var mantissa: int = 0;
    var exponent: int = 0;
}

// --- Character classification --------------------------------------------

fn is_space(c: char) => c == CHAR_SPACE or c == CHAR_TAB or c == CHAR_NEWLINE or c == CHAR_RETURN;

fn is_digit(c: char) => c >= '0' and c <= '9';

fn is_lower(c: char) => c >= 'a' and c <= 'z';

fn is_upper(c: char) => c >= 'A' and c <= 'Z';

fn is_letter(c: char) -> bool {
    if (is_lower(c)) {
        return true;
    }
    if (is_upper(c)) {
        return true;
    }
    return c == CHAR_UNDERSCORE;
}

fn is_identifier_start(c: char) -> bool {
    return is_letter(c);
}

fn is_identifier_body(c: char) -> bool {
    if (is_letter(c)) {
        return true;
    }
    return is_digit(c);
}

fn digit_value(c: char) -> int {
    return int(c) - int(CHAR_ZERO);
}

fn to_lower(c: char) -> char {
    if (is_upper(c)) {
        return char(int(c) + 32);
    }
    return c;
}

fn to_upper(c: char) -> char {
    if (is_lower(c)) {
        return char(int(c) - 32);
    }
    return c;
}

// True when the character can begin an operator token. Anything that is not
// a letter, a digit, whitespace or a quote has to be one of these.
fn is_operator_start(c: char) -> bool {
    if (c == CHAR_PLUS or c == CHAR_MINUS or c == CHAR_STAR or c == CHAR_SLASH) {
        return true;
    }
    if (c == CHAR_PERCENT or c == CHAR_AMP or c == CHAR_PIPE or c == CHAR_CARET) {
        return true;
    }
    if (c == CHAR_TILDE or c == CHAR_BANG or c == CHAR_LESS or c == CHAR_GREATER) {
        return true;
    }
    if (c == CHAR_EQUAL or c == CHAR_QUESTION or c == CHAR_COLON or c == CHAR_COMMA) {
        return true;
    }
    if (c == CHAR_SEMICOLON or c == CHAR_DOT) {
        return true;
    }
    return is_bracket(c);
}

fn is_bracket(c: char) -> bool {
    if (c == CHAR_LPAREN or c == CHAR_RPAREN) {
        return true;
    }
    if (c == CHAR_LBRACKET or c == CHAR_RBRACKET) {
        return true;
    }
    if (c == CHAR_LBRACE or c == CHAR_RBRACE) {
        return true;
    }
    return false;
}

// --- Token spellings -----------------------------------------------------
//
// charge has no switch, so the dispatch tables in this file are written as
// long if / else cascades over the token kind. They are ordered the same way
// as the enum so that the two stay easy to compare by eye.

fn token_spelling(kind: TokenKind) -> string {
    if (kind == TokenKind.Plus) { return "+"; }
    if (kind == TokenKind.Minus) { return "-"; }
    if (kind == TokenKind.Star) { return "*"; }
    if (kind == TokenKind.Slash) { return "/"; }
    if (kind == TokenKind.Percent) { return "%"; }
    if (kind == TokenKind.StarStar) { return "**"; }
    if (kind == TokenKind.Amp) { return "&"; }
    if (kind == TokenKind.Pipe) { return "|"; }
    if (kind == TokenKind.Caret) { return "^"; }
    if (kind == TokenKind.Tilde) { return "~"; }
    if (kind == TokenKind.LessLess) { return "<<"; }
    if (kind == TokenKind.GreaterGreater) { return ">>"; }
    if (kind == TokenKind.Bang) { return "!"; }
    if (kind == TokenKind.AmpAmp) { return "&&"; }
    if (kind == TokenKind.PipePipe) { return "||"; }
    if (kind == TokenKind.Less) { return "<"; }
    if (kind == TokenKind.LessEqual) { return "<="; }
    if (kind == TokenKind.Greater) { return ">"; }
    if (kind == TokenKind.GreaterEqual) { return ">="; }
    if (kind == TokenKind.EqualEqual) { return "=="; }
    if (kind == TokenKind.BangEqual) { return "!="; }
    if (kind == TokenKind.Equal) { return "="; }
    if (kind == TokenKind.PlusEqual) { return "+="; }
    if (kind == TokenKind.MinusEqual) { return "-="; }
    if (kind == TokenKind.StarEqual) { return "*="; }
    if (kind == TokenKind.SlashEqual) { return "/="; }
    if (kind == TokenKind.PercentEqual) { return "%="; }
    if (kind == TokenKind.AmpEqual) { return "&="; }
    if (kind == TokenKind.PipeEqual) { return "|="; }
    if (kind == TokenKind.CaretEqual) { return "^="; }
    if (kind == TokenKind.LessLessEqual) { return "<<="; }
    if (kind == TokenKind.GreaterGreaterEqual) { return ">>="; }
    if (kind == TokenKind.PlusPlus) { return "++"; }
    if (kind == TokenKind.MinusMinus) { return "--"; }
    if (kind == TokenKind.Question) { return "?"; }
    if (kind == TokenKind.Colon) { return ":"; }
    if (kind == TokenKind.Comma) { return ","; }
    if (kind == TokenKind.Semicolon) { return ";"; }
    if (kind == TokenKind.Dot) { return "."; }
    if (kind == TokenKind.Arrow) { return "->"; }
    if (kind == TokenKind.LParen) { return "("; }
    if (kind == TokenKind.RParen) { return ")"; }
    if (kind == TokenKind.LBracket) { return "["; }
    if (kind == TokenKind.RBracket) { return "]"; }
    if (kind == TokenKind.LBrace) { return "{"; }
    if (kind == TokenKind.RBrace) { return "}"; }
    if (kind == TokenKind.KeywordLet) { return "let"; }
    if (kind == TokenKind.KeywordIf) { return "if"; }
    if (kind == TokenKind.KeywordThen) { return "then"; }
    if (kind == TokenKind.KeywordElse) { return "else"; }
    if (kind == TokenKind.KeywordWhile) { return "while"; }
    if (kind == TokenKind.KeywordFn) { return "fn"; }
    if (kind == TokenKind.KeywordReturn) { return "return"; }
    if (kind == TokenKind.KeywordTrue) { return "true"; }
    if (kind == TokenKind.KeywordFalse) { return "false"; }
    if (kind == TokenKind.KeywordNull) { return "null"; }
    if (kind == TokenKind.KeywordAnd) { return "and"; }
    if (kind == TokenKind.KeywordOr) { return "or"; }
    if (kind == TokenKind.KeywordNot) { return "not"; }
    return TEXT_EMPTY;
}

// The human readable name, used in diagnostics like "expected ')', found
// end of input".
fn token_name(kind: TokenKind) -> string {
    if (kind == TokenKind.End) { return "end of input"; }
    if (kind == TokenKind.Invalid) { return "invalid token"; }
    if (kind == TokenKind.Identifier) { return "identifier"; }
    if (kind == TokenKind.Number) { return "number"; }
    if (kind == TokenKind.Text) { return "string"; }
    if (kind == TokenKind.Comment) { return "comment"; }
    let spelling = token_spelling(kind);
    if (spelling.size() > 0) {
        return spelling;
    }
    return "token";
}

// Keyword recognition happens after an identifier has been scanned, so the
// tokenizer never needs to back up.
fn keyword_kind(word: string) -> TokenKind {
    if (*word == WORD_LET) { return TokenKind.KeywordLet; }
    if (*word == WORD_IF) { return TokenKind.KeywordIf; }
    if (*word == WORD_THEN) { return TokenKind.KeywordThen; }
    if (*word == WORD_ELSE) { return TokenKind.KeywordElse; }
    if (*word == WORD_WHILE) { return TokenKind.KeywordWhile; }
    if (*word == WORD_FN) { return TokenKind.KeywordFn; }
    if (*word == WORD_RETURN) { return TokenKind.KeywordReturn; }
    if (*word == WORD_TRUE) { return TokenKind.KeywordTrue; }
    if (*word == WORD_FALSE) { return TokenKind.KeywordFalse; }
    if (*word == WORD_NULL) { return TokenKind.KeywordNull; }
    if (*word == WORD_AND) { return TokenKind.KeywordAnd; }
    if (*word == WORD_OR) { return TokenKind.KeywordOr; }
    if (*word == WORD_NOT) { return TokenKind.KeywordNot; }
    return TokenKind.Identifier;
}

fn is_keyword(word: string) -> bool {
    return keyword_kind(word) != TokenKind.Identifier;
}

// --- The precedence table ------------------------------------------------
//
// Binding powers, lowest first. Every infix operator gets one number; a right
// associative operator is parsed by recursing with the same power instead of
// power + 1, which is what `infix_associativity` below decides.
//
//      10  = += -= *= /= %= &= |= ^= <<= >>=       (right)
//      20  ?:                                       (right)
//      30  || or                                    (left)
//      40  && and                                   (left)
//      50  |                                        (left)
//      60  ^                                        (left)
//      70  &                                        (left)
//      80  == !=                                    (left)
//      90  < <= > >=                                (left)
//     100  << >>                                    (left)
//     110  + -                                      (left)
//     120  * / %                                    (left)
//     130  **                                       (right)
//     140  prefix - + ! ~ not ++ --
//     150  postfix ++ -- and the call, index and member suffixes

let PRECEDENCE_ASSIGN: int = 10;
let PRECEDENCE_CONDITIONAL: int = 20;
let PRECEDENCE_LOGICAL_OR: int = 30;
let PRECEDENCE_LOGICAL_AND: int = 40;
let PRECEDENCE_BIT_OR: int = 50;
let PRECEDENCE_BIT_XOR: int = 60;
let PRECEDENCE_BIT_AND: int = 70;
let PRECEDENCE_EQUALITY: int = 80;
let PRECEDENCE_RELATIONAL: int = 90;
let PRECEDENCE_SHIFT: int = 100;
let PRECEDENCE_ADDITIVE: int = 110;
let PRECEDENCE_MULTIPLICATIVE: int = 120;
let PRECEDENCE_POWER: int = 130;
let PRECEDENCE_PREFIX: int = 140;
let PRECEDENCE_POSTFIX: int = 150;
let PRECEDENCE_NONE: int = 0;

// One row of the operator table. The parser does not actually walk a vector
// of these - the cascades below are faster and easier to read - but the
// printer and the test harness both want the table as data.
class OperatorRow {

    fn describe(self) -> string {
        var out = self.spelling;
        out.append(" [");
        out.append(to_string(self.precedence));
        if (self.associativity == Associativity.Right) {
            out.append(", right");
        }
        if (self.associativity == Associativity.Left) {
            out.append(", left");
        }
        out.append("]");
        return out;
    }

    var kind: TokenKind = TokenKind.Invalid;
    var spelling: string;
    var precedence: int = 0;
    var associativity: Associativity = Associativity.Left;
    // True when the operator writes through its left operand, which the
    // constant folder uses to decide whether a subtree is pure.
    var mutating: bool = false;
}

fn operator_table() -> vector(OperatorRow) {
    var rows: vector(OperatorRow);
    rows.push_back(OperatorRow({.kind = TokenKind.Equal, .spelling = "=", .precedence = PRECEDENCE_ASSIGN, .associativity = Associativity.Right, .mutating = true}));
    rows.push_back(OperatorRow({.kind = TokenKind.PlusEqual, .spelling = "+=", .precedence = PRECEDENCE_ASSIGN, .associativity = Associativity.Right, .mutating = true}));
    rows.push_back(OperatorRow({.kind = TokenKind.MinusEqual, .spelling = "-=", .precedence = PRECEDENCE_ASSIGN, .associativity = Associativity.Right, .mutating = true}));
    rows.push_back(OperatorRow({.kind = TokenKind.StarEqual, .spelling = "*=", .precedence = PRECEDENCE_ASSIGN, .associativity = Associativity.Right, .mutating = true}));
    rows.push_back(OperatorRow({.kind = TokenKind.SlashEqual, .spelling = "/=", .precedence = PRECEDENCE_ASSIGN, .associativity = Associativity.Right, .mutating = true}));
    rows.push_back(OperatorRow({.kind = TokenKind.PercentEqual, .spelling = "%=", .precedence = PRECEDENCE_ASSIGN, .associativity = Associativity.Right, .mutating = true}));
    rows.push_back(OperatorRow({.kind = TokenKind.AmpEqual, .spelling = "&=", .precedence = PRECEDENCE_ASSIGN, .associativity = Associativity.Right, .mutating = true}));
    rows.push_back(OperatorRow({.kind = TokenKind.PipeEqual, .spelling = "|=", .precedence = PRECEDENCE_ASSIGN, .associativity = Associativity.Right, .mutating = true}));
    rows.push_back(OperatorRow({.kind = TokenKind.CaretEqual, .spelling = "^=", .precedence = PRECEDENCE_ASSIGN, .associativity = Associativity.Right, .mutating = true}));
    rows.push_back(OperatorRow({.kind = TokenKind.LessLessEqual, .spelling = "<<=", .precedence = PRECEDENCE_ASSIGN, .associativity = Associativity.Right, .mutating = true}));
    rows.push_back(OperatorRow({.kind = TokenKind.GreaterGreaterEqual, .spelling = ">>=", .precedence = PRECEDENCE_ASSIGN, .associativity = Associativity.Right, .mutating = true}));
    rows.push_back(OperatorRow({.kind = TokenKind.PipePipe, .spelling = "||", .precedence = PRECEDENCE_LOGICAL_OR, .associativity = Associativity.Left}));
    rows.push_back(OperatorRow({.kind = TokenKind.KeywordOr, .spelling = "or", .precedence = PRECEDENCE_LOGICAL_OR, .associativity = Associativity.Left}));
    rows.push_back(OperatorRow({.kind = TokenKind.AmpAmp, .spelling = "&&", .precedence = PRECEDENCE_LOGICAL_AND, .associativity = Associativity.Left}));
    rows.push_back(OperatorRow({.kind = TokenKind.KeywordAnd, .spelling = "and", .precedence = PRECEDENCE_LOGICAL_AND, .associativity = Associativity.Left}));
    rows.push_back(OperatorRow({.kind = TokenKind.Pipe, .spelling = "|", .precedence = PRECEDENCE_BIT_OR, .associativity = Associativity.Left}));
    rows.push_back(OperatorRow({.kind = TokenKind.Caret, .spelling = "^", .precedence = PRECEDENCE_BIT_XOR, .associativity = Associativity.Left}));
    rows.push_back(OperatorRow({.kind = TokenKind.Amp, .spelling = "&", .precedence = PRECEDENCE_BIT_AND, .associativity = Associativity.Left}));
    rows.push_back(OperatorRow({.kind = TokenKind.EqualEqual, .spelling = "==", .precedence = PRECEDENCE_EQUALITY, .associativity = Associativity.Left}));
    rows.push_back(OperatorRow({.kind = TokenKind.BangEqual, .spelling = "!=", .precedence = PRECEDENCE_EQUALITY, .associativity = Associativity.Left}));
    rows.push_back(OperatorRow({.kind = TokenKind.Less, .spelling = "<", .precedence = PRECEDENCE_RELATIONAL, .associativity = Associativity.Left}));
    rows.push_back(OperatorRow({.kind = TokenKind.LessEqual, .spelling = "<=", .precedence = PRECEDENCE_RELATIONAL, .associativity = Associativity.Left}));
    rows.push_back(OperatorRow({.kind = TokenKind.Greater, .spelling = ">", .precedence = PRECEDENCE_RELATIONAL, .associativity = Associativity.Left}));
    rows.push_back(OperatorRow({.kind = TokenKind.GreaterEqual, .spelling = ">=", .precedence = PRECEDENCE_RELATIONAL, .associativity = Associativity.Left}));
    rows.push_back(OperatorRow({.kind = TokenKind.LessLess, .spelling = "<<", .precedence = PRECEDENCE_SHIFT, .associativity = Associativity.Left}));
    rows.push_back(OperatorRow({.kind = TokenKind.GreaterGreater, .spelling = ">>", .precedence = PRECEDENCE_SHIFT, .associativity = Associativity.Left}));
    rows.push_back(OperatorRow({.kind = TokenKind.Plus, .spelling = "+", .precedence = PRECEDENCE_ADDITIVE, .associativity = Associativity.Left}));
    rows.push_back(OperatorRow({.kind = TokenKind.Minus, .spelling = "-", .precedence = PRECEDENCE_ADDITIVE, .associativity = Associativity.Left}));
    rows.push_back(OperatorRow({.kind = TokenKind.Star, .spelling = "*", .precedence = PRECEDENCE_MULTIPLICATIVE, .associativity = Associativity.Left}));
    rows.push_back(OperatorRow({.kind = TokenKind.Slash, .spelling = "/", .precedence = PRECEDENCE_MULTIPLICATIVE, .associativity = Associativity.Left}));
    rows.push_back(OperatorRow({.kind = TokenKind.Percent, .spelling = "%", .precedence = PRECEDENCE_MULTIPLICATIVE, .associativity = Associativity.Left}));
    rows.push_back(OperatorRow({.kind = TokenKind.StarStar, .spelling = "**", .precedence = PRECEDENCE_POWER, .associativity = Associativity.Right}));
    return rows;
}

// The binding power of `kind` when it appears between two operands. Zero
// means "not an infix operator", which is how `parse_expression` knows to
// stop climbing.
fn infix_precedence(kind: TokenKind) -> int {
    if (kind == TokenKind.Equal) { return PRECEDENCE_ASSIGN; }
    if (kind == TokenKind.PlusEqual) { return PRECEDENCE_ASSIGN; }
    if (kind == TokenKind.MinusEqual) { return PRECEDENCE_ASSIGN; }
    if (kind == TokenKind.StarEqual) { return PRECEDENCE_ASSIGN; }
    if (kind == TokenKind.SlashEqual) { return PRECEDENCE_ASSIGN; }
    if (kind == TokenKind.PercentEqual) { return PRECEDENCE_ASSIGN; }
    if (kind == TokenKind.AmpEqual) { return PRECEDENCE_ASSIGN; }
    if (kind == TokenKind.PipeEqual) { return PRECEDENCE_ASSIGN; }
    if (kind == TokenKind.CaretEqual) { return PRECEDENCE_ASSIGN; }
    if (kind == TokenKind.LessLessEqual) { return PRECEDENCE_ASSIGN; }
    if (kind == TokenKind.GreaterGreaterEqual) { return PRECEDENCE_ASSIGN; }
    if (kind == TokenKind.Question) { return PRECEDENCE_CONDITIONAL; }
    if (kind == TokenKind.PipePipe) { return PRECEDENCE_LOGICAL_OR; }
    if (kind == TokenKind.KeywordOr) { return PRECEDENCE_LOGICAL_OR; }
    if (kind == TokenKind.AmpAmp) { return PRECEDENCE_LOGICAL_AND; }
    if (kind == TokenKind.KeywordAnd) { return PRECEDENCE_LOGICAL_AND; }
    if (kind == TokenKind.Pipe) { return PRECEDENCE_BIT_OR; }
    if (kind == TokenKind.Caret) { return PRECEDENCE_BIT_XOR; }
    if (kind == TokenKind.Amp) { return PRECEDENCE_BIT_AND; }
    if (kind == TokenKind.EqualEqual) { return PRECEDENCE_EQUALITY; }
    if (kind == TokenKind.BangEqual) { return PRECEDENCE_EQUALITY; }
    if (kind == TokenKind.Less) { return PRECEDENCE_RELATIONAL; }
    if (kind == TokenKind.LessEqual) { return PRECEDENCE_RELATIONAL; }
    if (kind == TokenKind.Greater) { return PRECEDENCE_RELATIONAL; }
    if (kind == TokenKind.GreaterEqual) { return PRECEDENCE_RELATIONAL; }
    if (kind == TokenKind.LessLess) { return PRECEDENCE_SHIFT; }
    if (kind == TokenKind.GreaterGreater) { return PRECEDENCE_SHIFT; }
    if (kind == TokenKind.Plus) { return PRECEDENCE_ADDITIVE; }
    if (kind == TokenKind.Minus) { return PRECEDENCE_ADDITIVE; }
    if (kind == TokenKind.Star) { return PRECEDENCE_MULTIPLICATIVE; }
    if (kind == TokenKind.Slash) { return PRECEDENCE_MULTIPLICATIVE; }
    if (kind == TokenKind.Percent) { return PRECEDENCE_MULTIPLICATIVE; }
    if (kind == TokenKind.StarStar) { return PRECEDENCE_POWER; }
    return PRECEDENCE_NONE;
}

fn infix_associativity(kind: TokenKind) -> Associativity {
    if (is_assignment_operator(kind)) {
        return Associativity.Right;
    }
    if (kind == TokenKind.Question) {
        return Associativity.Right;
    }
    if (kind == TokenKind.StarStar) {
        return Associativity.Right;
    }
    if (infix_precedence(kind) == PRECEDENCE_NONE) {
        return Associativity.None;
    }
    return Associativity.Left;
}

// The power a prefix operator binds its single operand with. Prefix
// operators are always right associative, so `- - x` parses as `-(-x)`.
fn prefix_precedence(kind: TokenKind) -> int {
    if (kind == TokenKind.Minus) { return PRECEDENCE_PREFIX; }
    if (kind == TokenKind.Plus) { return PRECEDENCE_PREFIX; }
    if (kind == TokenKind.Bang) { return PRECEDENCE_PREFIX; }
    if (kind == TokenKind.KeywordNot) { return PRECEDENCE_PREFIX; }
    if (kind == TokenKind.Tilde) { return PRECEDENCE_PREFIX; }
    if (kind == TokenKind.PlusPlus) { return PRECEDENCE_PREFIX; }
    if (kind == TokenKind.MinusMinus) { return PRECEDENCE_PREFIX; }
    return PRECEDENCE_NONE;
}

fn postfix_precedence(kind: TokenKind) -> int {
    if (kind == TokenKind.PlusPlus) { return PRECEDENCE_POSTFIX; }
    if (kind == TokenKind.MinusMinus) { return PRECEDENCE_POSTFIX; }
    if (kind == TokenKind.Bang) { return PRECEDENCE_POSTFIX; }
    if (kind == TokenKind.LParen) { return PRECEDENCE_POSTFIX; }
    if (kind == TokenKind.LBracket) { return PRECEDENCE_POSTFIX; }
    if (kind == TokenKind.Dot) { return PRECEDENCE_POSTFIX; }
    return PRECEDENCE_NONE;
}

fn is_assignment_operator(kind: TokenKind) -> bool {
    if (kind == TokenKind.Equal) { return true; }
    if (kind == TokenKind.PlusEqual) { return true; }
    if (kind == TokenKind.MinusEqual) { return true; }
    if (kind == TokenKind.StarEqual) { return true; }
    if (kind == TokenKind.SlashEqual) { return true; }
    if (kind == TokenKind.PercentEqual) { return true; }
    if (kind == TokenKind.AmpEqual) { return true; }
    if (kind == TokenKind.PipeEqual) { return true; }
    if (kind == TokenKind.CaretEqual) { return true; }
    if (kind == TokenKind.LessLessEqual) { return true; }
    if (kind == TokenKind.GreaterGreaterEqual) { return true; }
    return false;
}

// A compound assignment such as `a += b` desugars to `a = a + b`, so the
// evaluator needs the plain operator that hides inside it.
fn compound_base_operator(kind: TokenKind) -> TokenKind {
    if (kind == TokenKind.PlusEqual) { return TokenKind.Plus; }
    if (kind == TokenKind.MinusEqual) { return TokenKind.Minus; }
    if (kind == TokenKind.StarEqual) { return TokenKind.Star; }
    if (kind == TokenKind.SlashEqual) { return TokenKind.Slash; }
    if (kind == TokenKind.PercentEqual) { return TokenKind.Percent; }
    if (kind == TokenKind.AmpEqual) { return TokenKind.Amp; }
    if (kind == TokenKind.PipeEqual) { return TokenKind.Pipe; }
    if (kind == TokenKind.CaretEqual) { return TokenKind.Caret; }
    if (kind == TokenKind.LessLessEqual) { return TokenKind.LessLess; }
    if (kind == TokenKind.GreaterGreaterEqual) { return TokenKind.GreaterGreater; }
    return TokenKind.Invalid;
}

// Operators whose right hand side may be skipped entirely.
fn is_short_circuit(kind: TokenKind) -> bool {
    if (kind == TokenKind.AmpAmp or kind == TokenKind.KeywordAnd) {
        return true;
    }
    if (kind == TokenKind.PipePipe or kind == TokenKind.KeywordOr) {
        return true;
    }
    return false;
}

fn is_comparison(kind: TokenKind) -> bool {
    let power = infix_precedence(kind);
    if (power == PRECEDENCE_EQUALITY) {
        return true;
    }
    return power == PRECEDENCE_RELATIONAL;
}

fn is_arithmetic(kind: TokenKind) -> bool {
    let power = infix_precedence(kind);
    if (power == PRECEDENCE_ADDITIVE) {
        return true;
    }
    if (power == PRECEDENCE_MULTIPLICATIVE) {
        return true;
    }
    return power == PRECEDENCE_POWER;
}

fn is_bitwise(kind: TokenKind) -> bool {
    let power = infix_precedence(kind);
    if (power == PRECEDENCE_BIT_OR or power == PRECEDENCE_BIT_XOR) {
        return true;
    }
    if (power == PRECEDENCE_BIT_AND) {
        return true;
    }
    return power == PRECEDENCE_SHIFT;
}

// --- The tokenizer -------------------------------------------------------
//
// A hand written scanner over a string. It never allocates for a token that
// it is going to throw away, and every token records the span it covers so
// that the printer can reproduce the original spacing if it wants to.
class Tokenizer {

    fn at_end(self) -> bool {
        return self.cursor.offset >= self.source.size();
    }

    fn remaining(self) -> int {
        return self.source.size() - self.cursor.offset;
    }

    fn peek(self) -> char {
        if (self.at_end()) {
            return CHAR_NUL;
        }
        return self.source.at(self.cursor.offset);
    }

    fn peek_at(self, ahead: int) -> char {
        let index = self.cursor.offset + ahead;
        if (index >= self.source.size()) {
            return CHAR_NUL;
        }
        return self.source.at(index);
    }

    fn advance(ref self) -> char {
        let c = self.peek();
        self.cursor.advance_over(c);
        return c;
    }

    // Consume `c` if it is the next character. Returns whether it was there,
    // which is what makes the maximal munch cascade below read well.
    fn eat(ref self, c: char) -> bool {
        if (self.peek() == c) {
            Discard(self.advance());
            return true;
        }
        return false;
    }

    fn fail(ref self, code: ErrorCode, detail: string) -> Token {
        if (self.problem.ok()) {
            self.problem.code = code;
            self.problem.where_ = self.cursor;
            self.problem.detail = *detail;
        }
        var bad = Token({.kind = TokenKind.Invalid, .text = *detail});
        bad.span.begin = self.cursor;
        bad.span.end = self.cursor;
        return bad;
    }

    fn make(self, kind: TokenKind, begin: Position) -> Token {
        var out = Token({.kind = kind});
        out.span.begin = *begin;
        out.span.end = self.cursor;
        out.text = self.source.substr(begin.offset, self.cursor.offset - begin.offset);
        return out;
    }

    // --- Trivia ----------------------------------------------------------

    // Whitespace, line comments and nestable block comments. When
    // `keep_comments` is set the caller gets the comment back as a token
    // instead, which is what the formatter mode wants.
    fn skip_trivia(ref self) {
        while (true) {
            while (not self.at_end() and is_space(self.peek())) {
                Discard(self.advance());
            }
            if (self.at_line_comment()) {
                self.skip_line_comment();
            } else {
                if (self.at_block_comment()) {
                    self.skip_block_comment();
                } else {
                    break;
                }
            }
        }
    }

    fn at_line_comment(self) -> bool {
        if (self.peek() != CHAR_SLASH) {
            return false;
        }
        return self.peek_at(1) == CHAR_SLASH;
    }

    fn at_block_comment(self) -> bool {
        if (self.peek() != CHAR_SLASH) {
            return false;
        }
        return self.peek_at(1) == CHAR_STAR;
    }

    fn skip_line_comment(ref self) {
        Discard(self.advance());
        Discard(self.advance());
        while (not self.at_end() and self.peek() != CHAR_NEWLINE) {
            Discard(self.advance());
        }
    }

    // Block comments nest, so a commented out region that already contains a
    // comment still ends where the reader expects it to.
    fn skip_block_comment(ref self) {
        Discard(self.advance());
        Discard(self.advance());
        var depth: int = 1;
        while (depth > 0) {
            if (self.at_end()) {
                self.problem.code = ErrorCode.UnterminatedComment;
                self.problem.where_ = self.cursor;
                return;
            }
            if (self.at_block_comment()) {
                Discard(self.advance());
                Discard(self.advance());
                depth += 1;
            } else {
                if (self.peek() == CHAR_STAR and self.peek_at(1) == CHAR_SLASH) {
                    Discard(self.advance());
                    Discard(self.advance());
                    depth -= 1;
                } else {
                    Discard(self.advance());
                }
            }
        }
    }

    fn scan_comment(ref self) -> Token {
        let begin = self.cursor;
        if (self.at_line_comment()) {
            self.skip_line_comment();
        } else {
            self.skip_block_comment();
        }
        return self.make(TokenKind.Comment, begin);
    }

    // --- Words -----------------------------------------------------------

    fn scan_identifier(ref self) -> Token {
        let begin = self.cursor;
        Discard(self.advance());
        while (not self.at_end() and is_identifier_body(self.peek())) {
            Discard(self.advance());
        }
        var word = self.make(TokenKind.Identifier, begin);
        word.kind = keyword_kind(word.text);
        return word;
    }

    // --- Numbers ---------------------------------------------------------
    //
    // The literal grammar is
    //
    //     digits [ '.' digits ] [ ('e'|'E') ['+'|'-'] digits ]
    //
    // and the result is the pair (mantissa, exponent) such that the value is
    // mantissa * 10^exponent. Digits past MAX_DIGITS are dropped and the
    // exponent is bumped instead, so `123456789012345678901` still lexes.
    fn scan_number(ref self) -> Token {
        let begin = self.cursor;
        var mantissa: int = 0;
        var exponent: int = 0;
        var digits: int = 0;
        var seen_any = false;

        while (not self.at_end() and is_digit(self.peek())) {
            let d = digit_value(self.advance());
            seen_any = true;
            if (digits < MAX_DIGITS) {
                mantissa = mantissa * NUMBER_BASE + d;
                if (mantissa != 0) {
                    digits += 1;
                }
            } else {
                exponent += 1;
            }
        }

        if (self.peek() == CHAR_DOT and is_digit(self.peek_at(1))) {
            Discard(self.advance());
            while (not self.at_end() and is_digit(self.peek())) {
                let d = digit_value(self.advance());
                seen_any = true;
                if (digits < MAX_DIGITS) {
                    mantissa = mantissa * NUMBER_BASE + d;
                    exponent -= 1;
                    digits += 1;
                }
            }
        }

        if (not seen_any) {
            return self.fail(ErrorCode.UnexpectedCharacter, "expected at least one digit");
        }

        if (self.peek() == 'e' or self.peek() == 'E') {
            let saved = self.cursor;
            Discard(self.advance());
            var sign: int = 1;
            if (self.eat(CHAR_MINUS)) {
                sign = -1;
            } else {
                Discard(self.eat(CHAR_PLUS));
            }
            if (is_digit(self.peek())) {
                var written: int = 0;
                while (not self.at_end() and is_digit(self.peek())) {
                    written = written * NUMBER_BASE + digit_value(self.advance());
                    if (written > MAX_EXPONENT * NUMBER_BASE) {
                        return self.fail(ErrorCode.ExponentRange, "exponent is too large");
                    }
                }
                exponent += sign * written;
            } else {
                // Not an exponent after all, `2eggs` is `2` then a word.
                self.cursor = saved;
            }
        }

        if (exponent > MAX_EXPONENT or exponent < MIN_EXPONENT) {
            return self.fail(ErrorCode.ExponentRange, "decimal exponent leaves the supported range");
        }

        var number = self.make(TokenKind.Number, begin);
        number.mantissa = mantissa;
        number.exponent = exponent;
        return number;
    }

    // --- Strings ---------------------------------------------------------

    fn scan_text(ref self) -> Token {
        let begin = self.cursor;
        Discard(self.advance());
        var decoded: string = "";
        while (true) {
            if (self.at_end()) {
                return self.fail(ErrorCode.UnterminatedText, "reached end of input inside a string");
            }
            let c = self.advance();
            if (c == CHAR_QUOTE) {
                break;
            }
            if (c != CHAR_BACKSLASH) {
                decoded.push_back(c);
            } else {
                if (self.at_end()) {
                    return self.fail(ErrorCode.UnterminatedText, "trailing backslash");
                }
                let marker = self.advance();
                let plain = decode_escape(marker);
                if (plain != CHAR_NUL) {
                    decoded.push_back(plain);
                } else {
                    var detail: string = "unknown escape marker ";
                    detail.push_back(marker);
                    return self.fail(ErrorCode.BadEscape, detail);
                }
            }
        }
        var out = self.make(TokenKind.Text, begin);
        out.text = decoded;
        return out;
    }

    // --- Operators -------------------------------------------------------
    //
    // Maximal munch: three character operators are tried before two and two
    // before one. This is the densest cascade in the file and it is the part
    // the parser leans on hardest.
    fn scan_operator(ref self) -> Token {
        let begin = self.cursor;
        let c = self.advance();

        if (c == CHAR_PLUS) {
            if (self.eat(CHAR_EQUAL)) { return self.make(TokenKind.PlusEqual, begin); }
            if (self.eat(CHAR_PLUS)) { return self.make(TokenKind.PlusPlus, begin); }
            return self.make(TokenKind.Plus, begin);
        }
        if (c == CHAR_MINUS) {
            if (self.eat(CHAR_EQUAL)) { return self.make(TokenKind.MinusEqual, begin); }
            if (self.eat(CHAR_MINUS)) { return self.make(TokenKind.MinusMinus, begin); }
            if (self.eat(CHAR_GREATER)) { return self.make(TokenKind.Arrow, begin); }
            return self.make(TokenKind.Minus, begin);
        }
        if (c == CHAR_STAR) {
            if (self.eat(CHAR_STAR)) { return self.make(TokenKind.StarStar, begin); }
            if (self.eat(CHAR_EQUAL)) { return self.make(TokenKind.StarEqual, begin); }
            return self.make(TokenKind.Star, begin);
        }
        if (c == CHAR_SLASH) {
            if (self.eat(CHAR_EQUAL)) { return self.make(TokenKind.SlashEqual, begin); }
            return self.make(TokenKind.Slash, begin);
        }
        if (c == CHAR_PERCENT) {
            if (self.eat(CHAR_EQUAL)) { return self.make(TokenKind.PercentEqual, begin); }
            return self.make(TokenKind.Percent, begin);
        }
        if (c == CHAR_AMP) {
            if (self.eat(CHAR_AMP)) { return self.make(TokenKind.AmpAmp, begin); }
            if (self.eat(CHAR_EQUAL)) { return self.make(TokenKind.AmpEqual, begin); }
            return self.make(TokenKind.Amp, begin);
        }
        if (c == CHAR_PIPE) {
            if (self.eat(CHAR_PIPE)) { return self.make(TokenKind.PipePipe, begin); }
            if (self.eat(CHAR_EQUAL)) { return self.make(TokenKind.PipeEqual, begin); }
            return self.make(TokenKind.Pipe, begin);
        }
        if (c == CHAR_CARET) {
            if (self.eat(CHAR_EQUAL)) { return self.make(TokenKind.CaretEqual, begin); }
            return self.make(TokenKind.Caret, begin);
        }
        if (c == CHAR_TILDE) {
            return self.make(TokenKind.Tilde, begin);
        }
        if (c == CHAR_BANG) {
            if (self.eat(CHAR_EQUAL)) { return self.make(TokenKind.BangEqual, begin); }
            return self.make(TokenKind.Bang, begin);
        }
        if (c == CHAR_LESS) {
            if (self.eat(CHAR_LESS)) {
                if (self.eat(CHAR_EQUAL)) { return self.make(TokenKind.LessLessEqual, begin); }
                return self.make(TokenKind.LessLess, begin);
            }
            if (self.eat(CHAR_EQUAL)) { return self.make(TokenKind.LessEqual, begin); }
            return self.make(TokenKind.Less, begin);
        }
        if (c == CHAR_GREATER) {
            if (self.eat(CHAR_GREATER)) {
                if (self.eat(CHAR_EQUAL)) { return self.make(TokenKind.GreaterGreaterEqual, begin); }
                return self.make(TokenKind.GreaterGreater, begin);
            }
            if (self.eat(CHAR_EQUAL)) { return self.make(TokenKind.GreaterEqual, begin); }
            return self.make(TokenKind.Greater, begin);
        }
        if (c == CHAR_EQUAL) {
            if (self.eat(CHAR_EQUAL)) { return self.make(TokenKind.EqualEqual, begin); }
            return self.make(TokenKind.Equal, begin);
        }
        if (c == CHAR_QUESTION) {
            return self.make(TokenKind.Question, begin);
        }
        if (c == CHAR_COLON) {
            return self.make(TokenKind.Colon, begin);
        }
        if (c == CHAR_COMMA) {
            return self.make(TokenKind.Comma, begin);
        }
        if (c == CHAR_SEMICOLON) {
            return self.make(TokenKind.Semicolon, begin);
        }
        if (c == CHAR_DOT) {
            return self.make(TokenKind.Dot, begin);
        }
        if (c == CHAR_LPAREN) { return self.make(TokenKind.LParen, begin); }
        if (c == CHAR_RPAREN) { return self.make(TokenKind.RParen, begin); }
        if (c == CHAR_LBRACKET) { return self.make(TokenKind.LBracket, begin); }
        if (c == CHAR_RBRACKET) { return self.make(TokenKind.RBracket, begin); }
        if (c == CHAR_LBRACE) { return self.make(TokenKind.LBrace, begin); }
        if (c == CHAR_RBRACE) { return self.make(TokenKind.RBrace, begin); }

        var detail: string = "stray byte ";
        detail.append(to_string(int(c)));
        return self.fail(ErrorCode.UnexpectedCharacter, detail);
    }

    // --- The driver ------------------------------------------------------

    fn next_token(ref self) -> Token {
        if (self.keep_comments) {
            while (not self.at_end() and is_space(self.peek())) {
                Discard(self.advance());
            }
            if (self.at_line_comment() or self.at_block_comment()) {
                return self.scan_comment();
            }
        } else {
            self.skip_trivia();
        }

        let begin = self.cursor;
        if (self.at_end()) {
            var done = Token({.kind = TokenKind.End});
            done.span.begin = begin;
            done.span.end = begin;
            return done;
        }

        let c = self.peek();
        if (is_identifier_start(c)) {
            return self.scan_identifier();
        }
        if (is_digit(c)) {
            return self.scan_number();
        }
        if (c == CHAR_DOT and is_digit(self.peek_at(1))) {
            return self.scan_number();
        }
        if (c == CHAR_QUOTE) {
            return self.scan_text();
        }
        if (is_operator_start(c)) {
            return self.scan_operator();
        }

        Discard(self.advance());
        var detail: string = "character ";
        detail.push_back(c);
        return self.fail(ErrorCode.UnexpectedCharacter, detail);
    }

    var source: string;
    var cursor: Position;
    var problem: Diagnostic;
    var keep_comments: bool = false;
}

// The eight single character escapes the string scanner understands. NUL is
// the "not an escape" answer, which is fine because a source file may not
// contain a raw NUL anyway.
fn decode_escape(marker: char) -> char {
    if (marker == 'n') { return CHAR_NEWLINE; }
    if (marker == 't') { return CHAR_TAB; }
    if (marker == 'r') { return CHAR_RETURN; }
    if (marker == CHAR_QUOTE) { return CHAR_QUOTE; }
    if (marker == CHAR_BACKSLASH) { return CHAR_BACKSLASH; }
    if (marker == '0') { return CHAR_SPACE; }
    if (marker == 'e') { return CHAR_SPACE; }
    return CHAR_NUL;
}

fn encode_escape(c: char) -> string {
    if (c == CHAR_QUOTE) { return "\\\""; }
    if (c == CHAR_BACKSLASH) { return "\\\\"; }
    if (c == CHAR_NEWLINE) { return "\\n"; }
    if (c == CHAR_TAB) { return "\\t"; }
    if (c == CHAR_RETURN) { return "\\r"; }
    return TEXT_EMPTY;
}

// Run the tokenizer to completion. Used by the test harness and by the
// formatter, both of which want the whole stream up front.
fn tokenize(source: string) -> vector(Token) {
    var scanner = Tokenizer({.source = *source});
    var out: vector(Token);
    while (true) {
        let token = scanner.next_token();
        out.push_back(token);
        if (token.kind == TokenKind.End) {
            break;
        }
        if (token.kind == TokenKind.Invalid) {
            break;
        }
    }
    return out;
}

// --- The syntax tree -----------------------------------------------------
//
// Nodes live in one flat arena and refer to each other by index. That keeps
// every node the same size, makes the constant folder able to rewrite a
// subtree in place, and sidesteps the ownership question that a tree of
// unique pointers would raise.
//
// Index 0 is always the invalid node, so a zero child means "absent".

let NO_NODE: int = 0;

class Node {

    fn is_literal(self) -> bool {
        if (self.kind == NodeKind.NumberLiteral) { return true; }
        if (self.kind == NodeKind.TextLiteral) { return true; }
        if (self.kind == NodeKind.BoolLiteral) { return true; }
        if (self.kind == NodeKind.NullLiteral) { return true; }
        return false;
    }

    fn is_leaf(self) -> bool {
        if (self.is_literal()) {
            return true;
        }
        if (self.kind == NodeKind.Variable) { return true; }
        if (self.kind == NodeKind.Empty) { return true; }
        return false;
    }

    // An lvalue is anything an assignment may be written through.
    fn is_assignable(self) -> bool {
        if (self.kind == NodeKind.Variable) { return true; }
        if (self.kind == NodeKind.Index) { return true; }
        if (self.kind == NodeKind.Member) { return true; }
        return false;
    }

    fn child_count(self) -> int {
        var total: int = 0;
        if (self.lhs != NO_NODE) { total += 1; }
        if (self.rhs != NO_NODE) { total += 1; }
        if (self.extra != NO_NODE) { total += 1; }
        return total + self.parts.size();
    }

    fn kind_name(self) -> string {
        return node_kind_name(self.kind);
    }

    var kind: NodeKind = NodeKind.Invalid;
    // The operator for Unary, Binary, Postfix and Assign nodes.
    var op: TokenKind = TokenKind.Invalid;
    // Up to three positional children: the operand or condition, the second
    // operand or the then branch, and the else branch.
    var lhs: int = 0;
    var rhs: int = 0;
    var extra: int = 0;
    // Variable width children: call arguments and block statements.
    var parts: vector(int);
    // Literal payloads.
    var mantissa: int = 0;
    var exponent: int = 0;
    var text: string;
    var flag: bool = false;
    var span: Span;
}

fn node_kind_name(kind: NodeKind) -> string {
    if (kind == NodeKind.Invalid) { return "invalid"; }
    if (kind == NodeKind.NumberLiteral) { return "number"; }
    if (kind == NodeKind.TextLiteral) { return "string"; }
    if (kind == NodeKind.BoolLiteral) { return "bool"; }
    if (kind == NodeKind.NullLiteral) { return "null"; }
    if (kind == NodeKind.Variable) { return "variable"; }
    if (kind == NodeKind.Unary) { return "unary"; }
    if (kind == NodeKind.Binary) { return "binary"; }
    if (kind == NodeKind.Postfix) { return "postfix"; }
    if (kind == NodeKind.Assign) { return "assign"; }
    if (kind == NodeKind.Call) { return "call"; }
    if (kind == NodeKind.Index) { return "index"; }
    if (kind == NodeKind.Member) { return "member"; }
    if (kind == NodeKind.Conditional) { return "conditional"; }
    if (kind == NodeKind.Let) { return "let"; }
    if (kind == NodeKind.Block) { return "block"; }
    if (kind == NodeKind.Loop) { return "loop"; }
    if (kind == NodeKind.Return) { return "return"; }
    if (kind == NodeKind.Empty) { return "empty"; }
    return "unknown";
}

// The arena. Every function that builds or walks a tree takes one of these
// by reference; nothing else owns a node.
class Arena {

    fn size(self) -> int {
        return self.nodes.size();
    }

    fn valid(self, index: int) -> bool {
        if (index <= NO_NODE) {
            return false;
        }
        return index < self.nodes.size();
    }

    fn at(ref self, index: int) -> ref Node {
        Assert(index >= 0);
        if (not self.valid(index)) {
            return self.nodes[0];
        }
        return self.nodes[index];
    }

    fn kind_of(self, index: int) -> NodeKind {
        if (not self.valid(index)) {
            return NodeKind.Invalid;
        }
        return self.nodes[index].kind;
    }

    fn operator_of(self, index: int) -> TokenKind {
        if (not self.valid(index)) {
            return TokenKind.Invalid;
        }
        return self.nodes[index].op;
    }

    fn add(ref self, node: Node) -> int {
        self.nodes.push_back(move(node));
        return self.nodes.size() - 1;
    }

    fn add_number(ref self, mantissa: int, exponent: int) -> int {
        return self.add(Node({.kind = NodeKind.NumberLiteral, .mantissa = mantissa, .exponent = exponent}));
    }

    fn add_text(ref self, text: string) -> int {
        return self.add(Node({.kind = NodeKind.TextLiteral, .text = *text}));
    }

    fn add_bool(ref self, value: bool) -> int {
        return self.add(Node({.kind = NodeKind.BoolLiteral, .flag = value}));
    }

    fn add_null(ref self) -> int {
        return self.add(Node({.kind = NodeKind.NullLiteral}));
    }

    fn add_variable(ref self, name: string) -> int {
        return self.add(Node({.kind = NodeKind.Variable, .text = *name}));
    }

    fn add_unary(ref self, op: TokenKind, operand: int) -> int {
        return self.add(Node({.kind = NodeKind.Unary, .op = op, .lhs = operand}));
    }

    fn add_binary(ref self, op: TokenKind, left: int, right: int) -> int {
        return self.add(Node({.kind = NodeKind.Binary, .op = op, .lhs = left, .rhs = right}));
    }

    fn add_conditional(ref self, condition: int, whenever: int, otherwise: int) -> int {
        return self.add(Node({.kind = NodeKind.Conditional, .lhs = condition, .rhs = whenever, .extra = otherwise}));
    }

    // Replace a node in place. The folder uses this so that every parent
    // that already points at `index` sees the rewritten value.
    fn replace(ref self, index: int, node: Node) {
        if (not self.valid(index)) {
            return;
        }
        let ref slot: auto = self.nodes[index];
        slot.kind = node.kind;
        slot.op = node.op;
        slot.lhs = node.lhs;
        slot.rhs = node.rhs;
        slot.extra = node.extra;
        slot.mantissa = node.mantissa;
        slot.exponent = node.exponent;
        slot.text = node.text;
        slot.flag = node.flag;
    }

    fn replace_with_number(ref self, index: int, mantissa: int, exponent: int) {
        if (not self.valid(index)) {
            return;
        }
        let ref slot: auto = self.nodes[index];
        slot.kind = NodeKind.NumberLiteral;
        slot.op = TokenKind.Invalid;
        slot.lhs = NO_NODE;
        slot.rhs = NO_NODE;
        slot.extra = NO_NODE;
        slot.mantissa = mantissa;
        slot.exponent = exponent;
        slot.parts.clear();
    }

    fn replace_with_bool(ref self, index: int, value: bool) {
        if (not self.valid(index)) {
            return;
        }
        let ref slot: auto = self.nodes[index];
        slot.kind = NodeKind.BoolLiteral;
        slot.op = TokenKind.Invalid;
        slot.lhs = NO_NODE;
        slot.rhs = NO_NODE;
        slot.extra = NO_NODE;
        slot.flag = value;
        slot.parts.clear();
    }

    // Splice `source` into this arena, returning the index of the copy. Used
    // when a fold turns `if true then a else b` into just `a`: the surviving
    // branch has to keep its own children.
    fn adopt(ref self, index: int) -> int {
        if (not self.valid(index)) {
            return NO_NODE;
        }
        var copy = Node({.kind = self.nodes[index].kind, .op = self.nodes[index].op});
        copy.mantissa = self.nodes[index].mantissa;
        copy.exponent = self.nodes[index].exponent;
        copy.text = self.nodes[index].text;
        copy.flag = self.nodes[index].flag;
        copy.lhs = self.nodes[index].lhs;
        copy.rhs = self.nodes[index].rhs;
        copy.extra = self.nodes[index].extra;
        for (child in self.nodes[index].parts) {
            copy.parts.push_back(child);
        }
        return self.add(move(copy));
    }

    fn clear(ref self) {
        self.nodes.clear();
        self.nodes.push_back(Node({.kind = NodeKind.Invalid}));
    }

    var nodes: vector(Node);
}

fn make_arena() -> Arena {
    var arena: Arena;
    arena.clear();
    return arena;
}

// --- The parser ----------------------------------------------------------
//
// Precedence climbing. `parse_expression(power)` parses a prefix form and
// then keeps absorbing infix and postfix operators for as long as their
// binding power is at least `power`. The prefix, infix and postfix helpers
// all call back into `parse_expression`, so the whole family is mutually
// recursive and the shape of the grammar lives in the precedence table
// rather than in the control flow.
class Parser {

    // --- Token access ----------------------------------------------------

    fn peek(self) -> ref const Token {
        return self.lookahead;
    }

    fn peek_kind(self) -> TokenKind {
        return self.lookahead.kind;
    }

    fn at(self, kind: TokenKind) -> bool {
        return self.lookahead.kind == kind;
    }

    fn at_end(self) -> bool {
        return self.lookahead.kind == TokenKind.End;
    }

    fn advance(ref self) -> Token {
        var previous = self.lookahead;
        self.lookahead = self.scanner.next_token();
        if (self.lookahead.kind == TokenKind.Invalid) {
            self.adopt_scanner_error();
        }
        return previous;
    }

    fn eat(ref self, kind: TokenKind) -> bool {
        if (self.at(kind)) {
            Discard(self.advance());
            return true;
        }
        return false;
    }

    fn expect(ref self, kind: TokenKind) -> bool {
        if (self.eat(kind)) {
            return true;
        }
        var detail: string = "expected ";
        detail.append(token_name(kind));
        detail.append(", found ");
        detail.append(token_name(self.lookahead.kind));
        self.report(ErrorCode.ExpectedToken, detail);
        return false;
    }

    fn adopt_scanner_error(ref self) {
        if (self.problem.ok()) {
            self.problem = self.scanner.problem;
        }
    }

    fn report(ref self, code: ErrorCode, detail: string) {
        if (self.problem.ok()) {
            self.problem.code = code;
            self.problem.where_ = self.lookahead.span.begin;
            self.problem.detail = *detail;
        }
    }

    fn failed(self) -> bool {
        return not self.problem.ok();
    }

    // Recover by skipping to the next statement boundary. Without this a
    // single bad token would produce one error per remaining token.
    fn recover(ref self) {
        while (not self.at_end()) {
            if (self.at(TokenKind.Semicolon)) {
                Discard(self.advance());
                return;
            }
            if (self.at(TokenKind.RBrace)) {
                return;
            }
            Discard(self.advance());
        }
    }

    // --- Depth guard -----------------------------------------------------

    fn enter(ref self) -> bool {
        self.depth += 1;
        if (self.depth > MAX_DEPTH) {
            self.report(ErrorCode.DepthExceeded, "nesting limit reached");
            return false;
        }
        return true;
    }

    fn leave(ref self) {
        self.depth -= 1;
    }

    // --- Entry points ----------------------------------------------------

    fn start(ref self, source: string) {
        self.scanner = Tokenizer({.source = *source});
        self.tree.clear();
        self.problem = Diagnostic();
        self.depth = 0;
        self.lookahead = self.scanner.next_token();
    }

    // A whole program is a sequence of statements, gathered into one block.
    fn parse_program(ref self, source: string) -> int {
        self.start(source);
        var block = Node({.kind = NodeKind.Block});
        block.span.begin = self.lookahead.span.begin;
        while (not self.at_end() and not self.failed()) {
            let statement = self.parse_statement();
            if (statement != NO_NODE) {
                block.parts.push_back(statement);
            } else {
                self.recover();
            }
        }
        block.span.end = self.lookahead.span.end;
        return self.tree.add(move(block));
    }

    // The convenience entry point for a single expression, which is what the
    // read eval print loop and most of the tests use.
    fn parse_source(ref self, source: string) -> int {
        self.start(source);
        let root = self.parse_expression(PRECEDENCE_NONE);
        if (not self.at_end() and not self.failed()) {
            self.report(ErrorCode.ExpectedToken, "trailing content after the expression");
        }
        return root;
    }

    // --- Statements ------------------------------------------------------

    fn parse_statement(ref self) -> int {
        if (self.at(TokenKind.Semicolon)) {
            Discard(self.advance());
            return self.tree.add(Node({.kind = NodeKind.Empty}));
        }
        if (self.at(TokenKind.KeywordLet)) {
            return self.parse_let();
        }
        if (self.at(TokenKind.KeywordWhile)) {
            return self.parse_loop();
        }
        if (self.at(TokenKind.KeywordReturn)) {
            return self.parse_return();
        }
        if (self.at(TokenKind.LBrace)) {
            return self.parse_block();
        }
        let value = self.parse_expression(PRECEDENCE_NONE);
        Discard(self.eat(TokenKind.Semicolon));
        return value;
    }

    // `let name = expression ;`
    fn parse_let(ref self) -> int {
        let keyword = self.advance();
        if (not self.at(TokenKind.Identifier)) {
            self.report(ErrorCode.ExpectedIdentifier, "a binding needs a name");
            return NO_NODE;
        }
        let name = self.advance();
        var binding = Node({.kind = NodeKind.Let, .text = name.text});
        binding.span.begin = keyword.span.begin;
        if (self.eat(TokenKind.Equal)) {
            binding.lhs = self.parse_expression(PRECEDENCE_NONE);
        } else {
            binding.lhs = self.tree.add_null();
        }
        Discard(self.eat(TokenKind.Semicolon));
        binding.span.end = self.lookahead.span.begin;
        return self.tree.add(move(binding));
    }

    // `while condition { body }`
    fn parse_loop(ref self) -> int {
        let keyword = self.advance();
        var node = Node({.kind = NodeKind.Loop});
        node.span.begin = keyword.span.begin;
        node.lhs = self.parse_expression(PRECEDENCE_NONE);
        if (self.at(TokenKind.LBrace)) {
            node.rhs = self.parse_block();
        } else {
            node.rhs = self.parse_statement();
        }
        node.span.end = self.lookahead.span.begin;
        return self.tree.add(move(node));
    }

    fn parse_return(ref self) -> int {
        let keyword = self.advance();
        var node = Node({.kind = NodeKind.Return});
        node.span.begin = keyword.span.begin;
        if (self.at(TokenKind.Semicolon)) {
            node.lhs = self.tree.add_null();
        } else {
            node.lhs = self.parse_expression(PRECEDENCE_NONE);
        }
        Discard(self.eat(TokenKind.Semicolon));
        return self.tree.add(move(node));
    }

    // `{ statement* }`
    fn parse_block(ref self) -> int {
        if (not self.enter()) {
            return NO_NODE;
        }
        let open = self.advance();
        var block = Node({.kind = NodeKind.Block});
        block.span.begin = open.span.begin;
        while (not self.at(TokenKind.RBrace) and not self.at_end() and not self.failed()) {
            let statement = self.parse_statement();
            if (statement == NO_NODE) {
                self.recover();
            } else {
                block.parts.push_back(statement);
            }
        }
        if (not self.expect(TokenKind.RBrace)) {
            self.leave();
            return NO_NODE;
        }
        block.span.end = self.lookahead.span.begin;
        self.leave();
        return self.tree.add(move(block));
    }

    // --- The climbing loop -----------------------------------------------
    //
    // This is the heart of the parser. Everything else in this struct exists
    // to be called from here or to call back into here.
    fn parse_expression(ref self, minimum: int) -> int {
        if (not self.enter()) {
            return NO_NODE;
        }
        var left = self.parse_prefix();
        if (left == NO_NODE) {
            self.leave();
            return NO_NODE;
        }

        while (true) {
            if (self.failed()) {
                break;
            }
            let kind = self.peek_kind();

            // Postfix binds tighter than any infix operator, so it is tried
            // first and it never consults `minimum`.
            let postfix = postfix_precedence(kind);
            if (postfix != PRECEDENCE_NONE and postfix >= minimum) {
                let extended = self.parse_postfix(left);
                if (extended == NO_NODE) {
                    break;
                }
                if (extended != left) {
                    left = extended;
                    continue;
                }
            }

            let power = infix_precedence(kind);
            if (power == PRECEDENCE_NONE) {
                break;
            }
            if (power < minimum) {
                break;
            }

            left = self.parse_infix(left, power);
            if (left == NO_NODE) {
                break;
            }
        }

        self.leave();
        return left;
    }

    // --- Prefix rules ----------------------------------------------------
    //
    // One arm per token kind that may begin an expression.
    fn parse_prefix(ref self) -> int {
        let kind = self.peek_kind();

        if (kind == TokenKind.Number) {
            let token = self.advance();
            var literal = Node({.kind = NodeKind.NumberLiteral});
            literal.mantissa = token.mantissa;
            literal.exponent = token.exponent;
            literal.text = token.text;
            literal.span = token.span;
            return self.tree.add(move(literal));
        }
        if (kind == TokenKind.Text) {
            let token = self.advance();
            var literal = Node({.kind = NodeKind.TextLiteral, .text = token.text});
            literal.span = token.span;
            return self.tree.add(move(literal));
        }
        if (kind == TokenKind.KeywordTrue) {
            let token = self.advance();
            var literal = Node({.kind = NodeKind.BoolLiteral, .flag = true});
            literal.span = token.span;
            return self.tree.add(move(literal));
        }
        if (kind == TokenKind.KeywordFalse) {
            let token = self.advance();
            var literal = Node({.kind = NodeKind.BoolLiteral, .flag = false});
            literal.span = token.span;
            return self.tree.add(move(literal));
        }
        if (kind == TokenKind.KeywordNull) {
            let token = self.advance();
            var literal = Node({.kind = NodeKind.NullLiteral});
            literal.span = token.span;
            return self.tree.add(move(literal));
        }
        if (kind == TokenKind.Identifier) {
            let token = self.advance();
            var name = Node({.kind = NodeKind.Variable, .text = token.text});
            name.span = token.span;
            return self.tree.add(move(name));
        }
        if (kind == TokenKind.LParen) {
            return self.parse_group();
        }
        if (kind == TokenKind.LBracket) {
            return self.parse_list();
        }
        if (kind == TokenKind.KeywordIf) {
            return self.parse_if();
        }
        if (prefix_precedence(kind) != PRECEDENCE_NONE) {
            return self.parse_unary();
        }

        var detail: string = "found ";
        detail.append(token_name(kind));
        detail.append(" where an operand was required");
        self.report(ErrorCode.ExpectedExpression, detail);
        return NO_NODE;
    }

    fn parse_unary(ref self) -> int {
        let token = self.advance();
        var node = Node({.kind = NodeKind.Unary, .op = token.kind});
        node.span.begin = token.span.begin;
        node.lhs = self.parse_expression(prefix_precedence(token.kind));
        if (node.lhs == NO_NODE) {
            return NO_NODE;
        }
        node.span.end = self.lookahead.span.begin;
        return self.tree.add(move(node));
    }

    // A parenthesised expression carries no node of its own; the printer
    // reinserts the parentheses from the precedence table instead, which is
    // what makes the round trip minimal rather than literal.
    fn parse_group(ref self) -> int {
        Discard(self.advance());
        let inner = self.parse_expression(PRECEDENCE_NONE);
        if (inner == NO_NODE) {
            return NO_NODE;
        }
        if (not self.at(TokenKind.RParen)) {
            self.report(ErrorCode.UnbalancedParen, "the group opened earlier is never closed");
            return NO_NODE;
        }
        Discard(self.advance());
        return inner;
    }

    // `[ a, b, c ]` builds a Call to the builtin list constructor, which
    // keeps the evaluator from needing a separate node kind.
    fn parse_list(ref self) -> int {
        let open = self.advance();
        var call = Node({.kind = NodeKind.Call});
        call.span.begin = open.span.begin;
        call.lhs = self.tree.add_variable("list");
        if (not self.at(TokenKind.RBracket)) {
            while (true) {
                let element = self.parse_expression(PRECEDENCE_ASSIGN);
                if (element == NO_NODE) {
                    return NO_NODE;
                }
                call.parts.push_back(element);
                if (not self.eat(TokenKind.Comma)) {
                    break;
                }
                if (self.at(TokenKind.RBracket)) {
                    break;
                }
            }
        }
        if (not self.expect(TokenKind.RBracket)) {
            return NO_NODE;
        }
        call.span.end = self.lookahead.span.begin;
        return self.tree.add(move(call));
    }

    // The keyword form of a conditional: `if c then a else b`. The operator
    // form is handled by `parse_infix` when it sees a question mark.
    fn parse_if(ref self) -> int {
        let keyword = self.advance();
        var node = Node({.kind = NodeKind.Conditional});
        node.span.begin = keyword.span.begin;
        node.lhs = self.parse_expression(PRECEDENCE_CONDITIONAL);
        if (node.lhs == NO_NODE) {
            return NO_NODE;
        }
        if (not self.expect(TokenKind.KeywordThen)) {
            return NO_NODE;
        }
        node.rhs = self.parse_expression(PRECEDENCE_CONDITIONAL);
        if (node.rhs == NO_NODE) {
            return NO_NODE;
        }
        if (self.eat(TokenKind.KeywordElse)) {
            node.extra = self.parse_expression(PRECEDENCE_CONDITIONAL);
            if (node.extra == NO_NODE) {
                return NO_NODE;
            }
        } else {
            node.extra = self.tree.add_null();
        }
        node.span.end = self.lookahead.span.begin;
        return self.tree.add(move(node));
    }

    // --- Infix rules -----------------------------------------------------

    fn parse_infix(ref self, left: int, power: int) -> int {
        let token = self.advance();
        let kind = token.kind;

        if (kind == TokenKind.Question) {
            return self.parse_conditional_tail(left);
        }
        if (is_assignment_operator(kind)) {
            return self.parse_assignment_tail(left, kind);
        }

        var next_power = power + 1;
        if (infix_associativity(kind) == Associativity.Right) {
            next_power = power;
        }

        let right = self.parse_expression(next_power);
        if (right == NO_NODE) {
            return NO_NODE;
        }
        var node = Node({.kind = NodeKind.Binary, .op = kind, .lhs = left, .rhs = right});
        node.span.begin = self.tree.at(left).span.begin;
        node.span.end = self.tree.at(right).span.end;
        return self.tree.add(move(node));
    }

    // The question mark has already been consumed; the branches parse at the
    // conditional level so that a nested conditional groups to the right.
    fn parse_conditional_tail(ref self, condition: int) -> int {
        var node = Node({.kind = NodeKind.Conditional, .lhs = condition});
        node.span.begin = self.tree.at(condition).span.begin;
        node.rhs = self.parse_expression(PRECEDENCE_NONE);
        if (node.rhs == NO_NODE) {
            return NO_NODE;
        }
        if (not self.expect(TokenKind.Colon)) {
            return NO_NODE;
        }
        node.extra = self.parse_expression(PRECEDENCE_CONDITIONAL);
        if (node.extra == NO_NODE) {
            return NO_NODE;
        }
        node.flag = true;
        node.span.end = self.lookahead.span.begin;
        return self.tree.add(move(node));
    }

    fn parse_assignment_tail(ref self, target: int, op: TokenKind) -> int {
        if (not self.tree.at(target).is_assignable()) {
            var detail: string = "cannot assign to a ";
            detail.append(node_kind_name(self.tree.kind_of(target)));
            detail.append(" expression");
            self.report(ErrorCode.NotAssignable, detail);
            return NO_NODE;
        }
        let value = self.parse_expression(PRECEDENCE_ASSIGN);
        if (value == NO_NODE) {
            return NO_NODE;
        }
        var node = Node({.kind = NodeKind.Assign, .op = op, .lhs = target, .rhs = value});
        node.span.begin = self.tree.at(target).span.begin;
        node.span.end = self.tree.at(value).span.end;
        return self.tree.add(move(node));
    }

    // --- Postfix rules ---------------------------------------------------
    //
    // Returns `left` unchanged when the next token turns out not to start a
    // suffix after all, which the climbing loop reads as "stop trying".
    fn parse_postfix(ref self, left: int) -> int {
        let kind = self.peek_kind();
        if (kind == TokenKind.LParen) {
            return self.parse_call(left);
        }
        if (kind == TokenKind.LBracket) {
            return self.parse_index(left);
        }
        if (kind == TokenKind.Dot) {
            return self.parse_member(left);
        }
        if (kind == TokenKind.PlusPlus or kind == TokenKind.MinusMinus) {
            let token = self.advance();
            var node = Node({.kind = NodeKind.Postfix, .op = token.kind, .lhs = left});
            node.span.begin = self.tree.at(left).span.begin;
            node.span.end = token.span.end;
            return self.tree.add(move(node));
        }
        if (kind == TokenKind.Bang) {
            // Postfix `!` is factorial, but only after something that can
            // actually produce a number.
            if (self.tree.kind_of(left) == NodeKind.NumberLiteral or self.tree.kind_of(left) == NodeKind.Variable) {
                let token = self.advance();
                var node = Node({.kind = NodeKind.Postfix, .op = token.kind, .lhs = left});
                node.span.begin = self.tree.at(left).span.begin;
                node.span.end = token.span.end;
                return self.tree.add(move(node));
            }
        }
        return left;
    }

    // `callee ( argument, name: argument )`
    fn parse_call(ref self, callee: int) -> int {
        let open = self.advance();
        var node = Node({.kind = NodeKind.Call, .lhs = callee});
        node.span.begin = self.tree.at(callee).span.begin;
        if (not self.at(TokenKind.RParen)) {
            while (true) {
                if (node.parts.size() >= MAX_ARGUMENTS) {
                    self.report(ErrorCode.TooManyArguments, "argument limit reached");
                    return NO_NODE;
                }
                let argument = self.parse_argument();
                if (argument == NO_NODE) {
                    return NO_NODE;
                }
                node.parts.push_back(argument);
                if (not self.eat(TokenKind.Comma)) {
                    break;
                }
            }
        }
        if (not self.expect(TokenKind.RParen)) {
            return NO_NODE;
        }
        node.span.end = self.lookahead.span.begin;
        Discard(open);
        return self.tree.add(move(node));
    }

    // An argument is either a bare expression or `name: expression`. The
    // label is stored on a Let node wrapping the value, which the evaluator
    // unwraps when it binds parameters.
    fn parse_argument(ref self) -> int {
        if (self.at(TokenKind.Identifier)) {
            let saved = self.lookahead;
            let name = self.advance();
            if (self.eat(TokenKind.Colon)) {
                var labelled = Node({.kind = NodeKind.Let, .text = name.text, .flag = true});
                labelled.span.begin = name.span.begin;
                labelled.lhs = self.parse_expression(PRECEDENCE_ASSIGN);
                if (labelled.lhs == NO_NODE) {
                    return NO_NODE;
                }
                labelled.span.end = self.lookahead.span.begin;
                return self.tree.add(move(labelled));
            }
            // Not a label: rebuild the variable the lookahead already ate and
            // keep parsing from there.
            var variable = Node({.kind = NodeKind.Variable, .text = name.text});
            variable.span = saved.span;
            let base_ = self.tree.add(move(variable));
            return self.continue_expression(base_, PRECEDENCE_ASSIGN);
        }
        return self.parse_expression(PRECEDENCE_ASSIGN);
    }

    // Resume the climbing loop with an operand that has already been built.
    // This is what lets `parse_argument` back out of a mistaken label.
    fn continue_expression(ref self, left: int, minimum: int) -> int {
        var current = left;
        while (true) {
            if (self.failed()) {
                break;
            }
            let kind = self.peek_kind();
            let postfix = postfix_precedence(kind);
            if (postfix != PRECEDENCE_NONE) {
                let extended = self.parse_postfix(current);
                if (extended == NO_NODE) {
                    return NO_NODE;
                }
                if (extended != current) {
                    current = extended;
                    continue;
                }
            }
            let power = infix_precedence(kind);
            if (power == PRECEDENCE_NONE or power < minimum) {
                break;
            }
            current = self.parse_infix(current, power);
            if (current == NO_NODE) {
                return NO_NODE;
            }
        }
        return current;
    }

    fn parse_index(ref self, target: int) -> int {
        Discard(self.advance());
        var node = Node({.kind = NodeKind.Index, .lhs = target});
        node.span.begin = self.tree.at(target).span.begin;
        node.rhs = self.parse_expression(PRECEDENCE_NONE);
        if (node.rhs == NO_NODE) {
            return NO_NODE;
        }
        if (not self.at(TokenKind.RBracket)) {
            self.report(ErrorCode.UnbalancedBracket, "the subscript opened earlier is never closed");
            return NO_NODE;
        }
        Discard(self.advance());
        node.span.end = self.lookahead.span.begin;
        return self.tree.add(move(node));
    }

    fn parse_member(ref self, target: int) -> int {
        Discard(self.advance());
        if (not self.at(TokenKind.Identifier)) {
            self.report(ErrorCode.ExpectedIdentifier, "a member access needs a field name");
            return NO_NODE;
        }
        let name = self.advance();
        var node = Node({.kind = NodeKind.Member, .lhs = target, .text = name.text});
        node.span.begin = self.tree.at(target).span.begin;
        node.span.end = name.span.end;
        return self.tree.add(move(node));
    }

    fn arena(ref self) -> ref Arena {
        return self.tree;
    }

    var scanner: Tokenizer;
    var lookahead: Token;
    var tree: Arena;
    var problem: Diagnostic;
    var depth: int = 0;
}

// One shot helper: parse a source string and hand back both the arena and
// the root, so callers do not have to keep the parser alive.
class ParseResult {

    fn ok(self) -> bool {
        if (self.root == NO_NODE) {
            return false;
        }
        return self.problem.ok();
    }

    fn describe(self) -> string {
        if (self.ok()) {
            return "parsed";
        }
        return self.problem.describe();
    }

    var tree: Arena;
    var root: int = 0;
    var problem: Diagnostic;
}

fn parse_expression_text(source: string) -> ParseResult {
    var parser: Parser;
    let root = parser.parse_source(source);
    var out: ParseResult;
    out.root = root;
    out.problem = parser.problem;
    out.tree = move(parser.tree);
    return out;
}

fn parse_program_text(source: string) -> ParseResult {
    var parser: Parser;
    let root = parser.parse_program(source);
    var out: ParseResult;
    out.root = root;
    out.problem = parser.problem;
    out.tree = move(parser.tree);
    return out;
}

// --- Scaled decimal arithmetic -------------------------------------------
//
// Every number in this language is a pair (mantissa, exponent) standing for
// mantissa * 10^exponent. Addition has to line the exponents up first;
// multiplication just adds them. Nothing here rounds to nearest, it
// truncates, which is documented behaviour rather than an accident.

fn power_of_ten(n: int) -> int {
    var out: int = 1;
    var left = n;
    while (left > 0) {
        out *= NUMBER_BASE;
        left -= 1;
    }
    return out;
}

fn digit_count(value: int) -> int {
    var left = abs(value);
    var count: int = 0;
    while (left > 0) {
        left /= NUMBER_BASE;
        count += 1;
    }
    if (count == 0) {
        return 1;
    }
    return count;
}

// Strip trailing zeros from the mantissa so that 1500 * 10^-2 and 15 * 10^0
// compare and print the same way.
class Decimal {

    fn is_zero(self) -> bool {
        return self.mantissa == 0;
    }

    fn is_negative(self) -> bool {
        return self.mantissa < 0;
    }

    fn is_integral(self) -> bool {
        if (self.exponent >= 0) {
            return true;
        }
        var copy = *self;
        copy.normalize();
        return copy.exponent >= 0;
    }

    fn normalize(ref self) {
        if (self.mantissa == 0) {
            self.exponent = 0;
            return;
        }
        while (self.exponent < 0 and self.mantissa % NUMBER_BASE == 0) {
            self.mantissa /= NUMBER_BASE;
            self.exponent += 1;
        }
    }

    fn scaled_to(self, target: int) -> int {
        if (target >= self.exponent) {
            return self.mantissa / power_of_ten(target - self.exponent);
        }
        return self.mantissa * power_of_ten(self.exponent - target);
    }

    fn to_int(self) -> int {
        return self.scaled_to(0);
    }

    // The printed form. Integral values print without a point; fractional
    // ones get exactly as many digits as the exponent calls for.
    fn to_text(self) -> string {
        var copy = *self;
        copy.normalize();
        if (copy.exponent >= 0) {
            var whole = to_string(copy.mantissa);
            var zeros = copy.exponent;
            while (zeros > 0) {
                whole.push_back(CHAR_ZERO);
                zeros -= 1;
            }
            return whole;
        }
        var out: string = "";
        if (copy.mantissa < 0) {
            out.push_back(CHAR_MINUS);
        }
        let magnitude = abs(copy.mantissa);
        let places = -copy.exponent;
        let divisor = power_of_ten(places);
        out.append(to_string(magnitude / divisor));
        out.push_back(CHAR_DOT);
        var fraction = to_string(magnitude % divisor);
        var pad = places - fraction.size();
        while (pad > 0) {
            out.push_back(CHAR_ZERO);
            pad -= 1;
        }
        out.append(fraction);
        return out;
    }

    var mantissa: int = 0;
    var exponent: int = 0;
}

fn make_decimal(mantissa: int, exponent: int) -> Decimal {
    var out = Decimal({.mantissa = mantissa, .exponent = exponent});
    out.normalize();
    return out;
}

fn decimal_from_int(value: int) -> Decimal {
    return Decimal({.mantissa = value, .exponent = 0});
}

// The common exponent two operands have to be brought to before they can be
// added or compared. Always the smaller of the two, so no digits are lost.
fn common_exponent(a: Decimal, b: Decimal) -> int {
    if (a.exponent < b.exponent) {
        return a.exponent;
    }
    return b.exponent;
}

fn decimal_add(a: Decimal, b: Decimal) -> Decimal {
    let e = common_exponent(a, b);
    return make_decimal(a.scaled_to(e) + b.scaled_to(e), e);
}

fn decimal_subtract(a: Decimal, b: Decimal) -> Decimal {
    let e = common_exponent(a, b);
    return make_decimal(a.scaled_to(e) - b.scaled_to(e), e);
}

fn decimal_multiply(a: Decimal, b: Decimal) -> Decimal {
    return make_decimal(a.mantissa * b.mantissa, a.exponent + b.exponent);
}

// Division keeps DIVISION_DIGITS extra digits of the quotient and lowers the
// exponent to match, which is how 1 / 3 comes out as 0.333333.
let DIVISION_DIGITS: int = 6;

fn decimal_divide(a: Decimal, b: Decimal) -> Decimal {
    if (b.mantissa == 0) {
        return Decimal({.mantissa = 0, .exponent = 0});
    }
    let lifted = a.mantissa * power_of_ten(DIVISION_DIGITS);
    let exponent = a.exponent - b.exponent - DIVISION_DIGITS;
    return make_decimal(lifted / b.mantissa, exponent);
}

fn decimal_remainder(a: Decimal, b: Decimal) -> Decimal {
    if (b.mantissa == 0) {
        return Decimal({.mantissa = 0, .exponent = 0});
    }
    let e = common_exponent(a, b);
    return make_decimal(a.scaled_to(e) % b.scaled_to(e), e);
}

fn decimal_negate(a: Decimal) -> Decimal {
    return make_decimal(-a.mantissa, a.exponent);
}

// Only integral exponents are supported, which is all the language exposes.
fn decimal_power(base_: Decimal, exponent: Decimal) -> Decimal {
    var count = exponent.to_int();
    if (count < 0) {
        let one = decimal_from_int(1);
        var positive = *exponent;
        positive.mantissa = -positive.mantissa;
        return decimal_divide(one, decimal_power(base_, positive));
    }
    var out = decimal_from_int(1);
    while (count > 0) {
        out = decimal_multiply(out, *base_);
        count -= 1;
    }
    return out;
}

// Returns -1, 0 or 1.
fn decimal_compare(a: Decimal, b: Decimal) -> int {
    let e = common_exponent(a, b);
    let left = a.scaled_to(e);
    let right = b.scaled_to(e);
    if (left < right) {
        return -1;
    }
    if (left > right) {
        return 1;
    }
    return 0;
}

fn decimal_equal(a: Decimal, b: Decimal) -> bool {
    return decimal_compare(a, b) == 0;
}

// --- Values --------------------------------------------------------------
//
// A tagged union. charge has no variant type yet, so each payload gets its
// own field and `kind` says which one is live.
class Value {

    fn is_nil(self) -> bool {
        return self.kind == ValueKind.Nil;
    }

    fn is_number(self) -> bool {
        return self.kind == ValueKind.Number;
    }

    fn is_text(self) -> bool {
        return self.kind == ValueKind.Text;
    }

    fn is_bool(self) -> bool {
        return self.kind == ValueKind.Bool;
    }

    fn is_list(self) -> bool {
        return self.kind == ValueKind.List;
    }

    fn is_failure(self) -> bool {
        return self.kind == ValueKind.Failure;
    }

    // Every value has a truth value; only nil, false, zero, the empty string
    // and the empty list are falsy.
    fn truthy(self) -> bool {
        if (self.kind == ValueKind.Nil) {
            return false;
        }
        if (self.kind == ValueKind.Bool) {
            return self.flag;
        }
        if (self.kind == ValueKind.Number) {
            return not self.number.is_zero();
        }
        if (self.kind == ValueKind.Text) {
            return self.text.size() > 0;
        }
        if (self.kind == ValueKind.List) {
            return self.items.size() > 0;
        }
        if (self.kind == ValueKind.Failure) {
            return false;
        }
        return true;
    }

    fn kind_name(self) -> string {
        if (self.kind == ValueKind.Nil) { return "null"; }
        if (self.kind == ValueKind.Bool) { return "bool"; }
        if (self.kind == ValueKind.Number) { return "number"; }
        if (self.kind == ValueKind.Text) { return "string"; }
        if (self.kind == ValueKind.List) { return "list"; }
        if (self.kind == ValueKind.Builtin) { return "builtin"; }
        if (self.kind == ValueKind.Failure) { return "error"; }
        return "unknown";
    }

    fn size(self) -> int {
        if (self.kind == ValueKind.List) {
            return self.items.size();
        }
        if (self.kind == ValueKind.Text) {
            return self.text.size();
        }
        return 0;
    }

    // The display form, used by `print` and by the test harness.
    fn to_text(self) -> string {
        if (self.kind == ValueKind.Nil) {
            return WORD_NULL;
        }
        if (self.kind == ValueKind.Bool) {
            if (self.flag) {
                return WORD_TRUE;
            }
            return WORD_FALSE;
        }
        if (self.kind == ValueKind.Number) {
            return self.number.to_text();
        }
        if (self.kind == ValueKind.Text) {
            return self.text;
        }
        if (self.kind == ValueKind.Builtin) {
            var out: string = "<builtin ";
            out.append(self.text);
            out.append(">");
            return out;
        }
        if (self.kind == ValueKind.Failure) {
            var out: string = "<error: ";
            out.append(self.text);
            out.append(">");
            return out;
        }
        var out: string = "[";
        var first = true;
        for (element in self.items) {
            if (not first) {
                out.append(TEXT_COMMA_SPACE);
            }
            out.append(element.to_text());
            first = false;
        }
        out.append("]");
        return out;
    }

    var kind: ValueKind = ValueKind.Nil;
    var number: Decimal;
    var text: string;
    var flag: bool = false;
    var items: vector(Value);
    // For builtins: the arity the dispatcher checks before calling.
    var arity: int = 0;
}

fn nil_value() -> Value {
    return Value({.kind = ValueKind.Nil});
}

fn bool_value(flag: bool) -> Value {
    return Value({.kind = ValueKind.Bool, .flag = flag});
}

fn number_value(number: Decimal) -> Value {
    return Value({.kind = ValueKind.Number, .number = number});
}

fn int_value(n: int) -> Value {
    return number_value(decimal_from_int(n));
}

fn text_value(text: string) -> Value {
    return Value({.kind = ValueKind.Text, .text = *text});
}

fn list_value(items: vector(Value)) -> Value {
    return Value({.kind = ValueKind.List, .items = move(items)});
}

fn failure_value(detail: string) -> Value {
    return Value({.kind = ValueKind.Failure, .text = *detail});
}

// Structural equality across kinds. Numbers compare by value, so 1.50 equals
// 1.5, and lists compare element by element.
fn values_equal(a: Value, b: Value) -> bool {
    if (a.kind != b.kind) {
        return false;
    }
    if (a.kind == ValueKind.Nil) {
        return true;
    }
    if (a.kind == ValueKind.Bool) {
        return a.flag == b.flag;
    }
    if (a.kind == ValueKind.Number) {
        return decimal_equal(a.number, b.number);
    }
    if (a.kind == ValueKind.Text) {
        return a.text == b.text;
    }
    if (a.kind == ValueKind.List) {
        if (a.items.size() != b.items.size()) {
            return false;
        }
        for (i in range(0, a.items.size())) {
            if (not values_equal(a.items[i], b.items[i])) {
                return false;
            }
        }
        return true;
    }
    return a.text == b.text;
}

// Ordering, defined only for numbers and strings.
fn compare_values(a: Value, b: Value) -> int {
    if (a.kind == ValueKind.Number and b.kind == ValueKind.Number) {
        return decimal_compare(a.number, b.number);
    }
    if (a.kind == ValueKind.Text and b.kind == ValueKind.Text) {
        return a.text.compare(b.text);
    }
    if (values_equal(a, b)) {
        return 0;
    }
    return -1;
}

// --- Scopes and environments ---------------------------------------------
//
// Lexical scoping with a flat vector of frames. A lookup walks outwards from
// the innermost frame, so an inner binding shadows an outer one, and a
// frame boundary is just an index into the same two parallel vectors.
class Scope {

    fn size(self) -> int {
        return self.names.size();
    }

    fn index_of(self, name: string) -> int {
        var i = self.names.size() - 1;
        while (i >= 0) {
            if (self.names[i] == *name) {
                return i;
            }
            i -= 1;
        }
        return -1;
    }

    fn contains(self, name: string) -> bool {
        return self.index_of(name) >= 0;
    }

    fn define(ref self, name: string, value: Value) {
        let existing = self.index_of(name);
        if (existing >= 0) {
            self.values[existing] = move(value);
            return;
        }
        self.names.push_back(*name);
        self.values.push_back(move(value));
    }

    fn at(ref self, index: int) -> ref Value {
        return self.values[index];
    }

    fn clear(ref self) {
        self.names.clear();
        self.values.clear();
    }

    var names: vector(string);
    var values: vector(Value);
    // Purely informational, but it makes a dumped environment readable.
    var label: string;
}

class Environment {

    fn depth(self) -> int {
        return self.frames.size();
    }

    fn global(ref self) -> ref Scope {
        return self.frames[0];
    }

    fn innermost(ref self) -> ref Scope {
        return self.frames[self.frames.size() - 1];
    }

    fn push_scope(ref self, label: string) {
        self.frames.push_back(Scope({.label = *label}));
    }

    fn pop_scope(ref self) {
        if (self.frames.size() > 1) {
            self.frames.pop_back();
        }
    }

    fn define(ref self, name: string, value: Value) {
        let ref frame: auto = self.frames[self.frames.size() - 1];
        frame.define(name, move(value));
    }

    fn define_global(ref self, name: string, value: Value) {
        let ref frame: auto = self.frames[0];
        frame.define(name, move(value));
    }

    fn bound(self, name: string) -> bool {
        var i = self.frames.size() - 1;
        while (i >= 0) {
            if (self.frames[i].contains(name)) {
                return true;
            }
            i -= 1;
        }
        return false;
    }

    // Look a name up from the innermost frame outwards. Returns the missing
    // sentinel when nothing matches, which the evaluator turns into an
    // UnknownName failure.
    fn lookup(ref self, name: string) -> ref Value {
        var i = self.frames.size() - 1;
        while (i >= 0) {
            let ref frame: auto = self.frames[i];
            let slot = frame.index_of(name);
            if (slot >= 0) {
                return frame.at(slot);
            }
            i -= 1;
        }
        return self.missing;
    }

    // Assignment writes through to the frame the name was found in, rather
    // than shadowing it in the current one.
    fn assign(ref self, name: string, value: Value) -> bool {
        var i = self.frames.size() - 1;
        while (i >= 0) {
            let ref frame: auto = self.frames[i];
            let slot = frame.index_of(name);
            if (slot >= 0) {
                frame.values[slot] = move(value);
                return true;
            }
            i -= 1;
        }
        return false;
    }

    fn describe(self) -> string {
        var out: string = "";
        for (frame in self.frames) {
            out.append(frame.label);
            out.append(" {");
            for (i in range(0, frame.names.size())) {
                if (i > 0) {
                    out.append(TEXT_COMMA_SPACE);
                }
                out.append(frame.names[i]);
            }
            out.append("}\n");
        }
        return out;
    }

    var frames: vector(Scope);
    var missing: Value;
}

fn make_environment() -> Environment {
    var env: Environment;
    env.frames.push_back(Scope({.label = "global"}));
    return env;
}

// --- Builtins ------------------------------------------------------------
//
// Builtins are dispatched by name from one cascade. Registering a name in
// the environment only records its arity; the body lives in `call_builtin`.

fn builtin_arity(name: string) -> int {
    if (*name == "abs") { return 1; }
    if (*name == "min") { return 2; }
    if (*name == "max") { return 2; }
    if (*name == "floor") { return 1; }
    if (*name == "ceil") { return 1; }
    if (*name == "round") { return 1; }
    if (*name == "sqrt") { return 1; }
    if (*name == "len") { return 1; }
    if (*name == "upper") { return 1; }
    if (*name == "lower") { return 1; }
    if (*name == "trim") { return 1; }
    if (*name == "concat") { return 2; }
    if (*name == "at") { return 2; }
    if (*name == "slice") { return 3; }
    if (*name == "push") { return 2; }
    if (*name == "sum") { return 1; }
    if (*name == "type") { return 1; }
    if (*name == "number") { return 1; }
    if (*name == "string") { return 1; }
    if (*name == "print") { return 1; }
    // A negative arity means "any number of arguments".
    if (*name == "list") { return -1; }
    return -2;
}

fn is_builtin(name: string) -> bool {
    return builtin_arity(name) != -2;
}

fn builtin_names() -> vector(string) {
    var names: vector(string);
    names.push_back("abs");
    names.push_back("min");
    names.push_back("max");
    names.push_back("floor");
    names.push_back("ceil");
    names.push_back("round");
    names.push_back("sqrt");
    names.push_back("len");
    names.push_back("upper");
    names.push_back("lower");
    names.push_back("trim");
    names.push_back("concat");
    names.push_back("at");
    names.push_back("slice");
    names.push_back("push");
    names.push_back("sum");
    names.push_back("type");
    names.push_back("number");
    names.push_back("string");
    names.push_back("print");
    names.push_back("list");
    return names;
}

// Builtins the folder is allowed to evaluate at compile time. Anything that
// prints or mutates is deliberately absent.
fn builtin_is_pure(name: string) -> bool {
    if (*name == "print") {
        return false;
    }
    if (*name == "push") {
        return false;
    }
    return is_builtin(name);
}

// Integer square root by bisection, on the scaled representation.
fn decimal_sqrt(value: Decimal) -> Decimal {
    let target = value.scaled_to(-2);
    if (target <= 0) {
        return decimal_from_int(0);
    }
    var low: int = 0;
    var high = target;
    while (low < high) {
        let middle = (low + high + 1) / 2;
        if (middle * middle <= target * 100) {
            low = middle;
        } else {
            high = middle - 1;
        }
    }
    return make_decimal(low, -2);
}

fn decimal_floor(value: Decimal) -> Decimal {
    let whole = value.scaled_to(0);
    var out = decimal_from_int(whole);
    if (value.is_negative() and decimal_compare(out, *value) != 0) {
        out = decimal_from_int(whole - 1);
    }
    return out;
}

fn decimal_ceil(value: Decimal) -> Decimal {
    let floored = decimal_floor(value);
    if (decimal_equal(floored, *value)) {
        return floored;
    }
    return decimal_add(floored, decimal_from_int(1));
}

fn decimal_round(value: Decimal) -> Decimal {
    let half = make_decimal(5, -1);
    return decimal_floor(decimal_add(*value, half));
}

fn text_upper(text: string) -> string {
    var out: string = "";
    for (i in range(0, text.size())) {
        out.push_back(to_upper(text.at(i)));
    }
    return out;
}

fn text_lower(text: string) -> string {
    var out: string = "";
    for (i in range(0, text.size())) {
        out.push_back(to_lower(text.at(i)));
    }
    return out;
}

fn text_trim(text: string) -> string {
    var begin: int = 0;
    var end = text.size();
    while (begin < end and is_space(text.at(begin))) {
        begin += 1;
    }
    while (end > begin and is_space(text.at(end - 1))) {
        end -= 1;
    }
    return text.substr(begin, end - begin);
}

// --- The interpreter -----------------------------------------------------
//
// A straight tree walk. `evaluate` dispatches on the node kind and every arm
// calls back into `evaluate`, so this family is as mutually recursive as the
// parser above it.
class Interpreter {

    fn fail(ref self, code: ErrorCode, detail: string) -> Value {
        if (self.problem.ok()) {
            self.problem.code = code;
            self.problem.detail = *detail;
        }
        var message = error_text(code);
        message.append(": ");
        message.append(*detail);
        return failure_value(message);
    }

    fn node_kind(self, index: int) -> NodeKind {
        return self.tree.kind_of(index);
    }

    // --- Dispatch --------------------------------------------------------

    fn evaluate(ref self, index: int) -> Value {
        if (not self.tree.valid(index)) {
            return nil_value();
        }
        self.steps += 1;
        let kind = self.tree.kind_of(index);

        if (kind == NodeKind.NumberLiteral) {
            return number_value(make_decimal(self.tree.at(index).mantissa, self.tree.at(index).exponent));
        }
        if (kind == NodeKind.TextLiteral) {
            return text_value(self.tree.at(index).text);
        }
        if (kind == NodeKind.BoolLiteral) {
            return bool_value(self.tree.at(index).flag);
        }
        if (kind == NodeKind.NullLiteral) {
            return nil_value();
        }
        if (kind == NodeKind.Empty) {
            return nil_value();
        }
        if (kind == NodeKind.Variable) {
            return self.evaluate_variable(index);
        }
        if (kind == NodeKind.Unary) {
            return self.evaluate_unary(index);
        }
        if (kind == NodeKind.Postfix) {
            return self.evaluate_postfix(index);
        }
        if (kind == NodeKind.Binary) {
            return self.evaluate_binary(index);
        }
        if (kind == NodeKind.Assign) {
            return self.evaluate_assign(index);
        }
        if (kind == NodeKind.Conditional) {
            return self.evaluate_conditional(index);
        }
        if (kind == NodeKind.Call) {
            return self.evaluate_call(index);
        }
        if (kind == NodeKind.Index) {
            return self.evaluate_index(index);
        }
        if (kind == NodeKind.Member) {
            return self.evaluate_member(index);
        }
        if (kind == NodeKind.Let) {
            return self.evaluate_let(index);
        }
        if (kind == NodeKind.Block) {
            return self.evaluate_block(index);
        }
        if (kind == NodeKind.Loop) {
            return self.evaluate_loop(index);
        }
        if (kind == NodeKind.Return) {
            var out = self.evaluate(self.tree.at(index).lhs);
            self.returning = true;
            return out;
        }
        return self.fail(ErrorCode.ExpectedExpression, "cannot evaluate this node");
    }

    fn evaluate_variable(ref self, index: int) -> Value {
        let name = self.tree.at(index).text;
        if (self.environment.bound(name)) {
            return self.environment.lookup(name);
        }
        if (is_builtin(name)) {
            return Value({.kind = ValueKind.Builtin, .text = name, .arity = builtin_arity(name)});
        }
        var detail: string = "no binding named '";
        detail.append(name);
        detail.append("'");
        return self.fail(ErrorCode.UnknownName, detail);
    }

    // --- Operators -------------------------------------------------------

    fn evaluate_unary(ref self, index: int) -> Value {
        let op = self.tree.at(index).op;
        let operand = self.evaluate(self.tree.at(index).lhs);
        if (operand.is_failure()) {
            return operand;
        }

        if (op == TokenKind.Minus) {
            if (not operand.is_number()) {
                return self.fail(ErrorCode.TypeMismatch, "unary minus needs a number");
            }
            return number_value(decimal_negate(operand.number));
        }
        if (op == TokenKind.Plus) {
            if (not operand.is_number()) {
                return self.fail(ErrorCode.TypeMismatch, "unary plus needs a number");
            }
            return operand;
        }
        if (op == TokenKind.Bang or op == TokenKind.KeywordNot) {
            return bool_value(not operand.truthy());
        }
        if (op == TokenKind.Tilde) {
            if (not operand.is_number()) {
                return self.fail(ErrorCode.TypeMismatch, "bitwise complement needs a number");
            }
            return int_value(^operand.number.to_int());
        }
        if (op == TokenKind.PlusPlus or op == TokenKind.MinusMinus) {
            return self.apply_step(self.tree.at(index).lhs, op, false);
        }
        return self.fail(ErrorCode.TypeMismatch, "unknown prefix operator");
    }

    fn evaluate_postfix(ref self, index: int) -> Value {
        let op = self.tree.at(index).op;
        if (op == TokenKind.PlusPlus or op == TokenKind.MinusMinus) {
            return self.apply_step(self.tree.at(index).lhs, op, true);
        }
        if (op == TokenKind.Bang) {
            let operand = self.evaluate(self.tree.at(index).lhs);
            if (not operand.is_number()) {
                return self.fail(ErrorCode.TypeMismatch, "factorial needs a number");
            }
            var count = operand.number.to_int();
            var out: int = 1;
            while (count > 1) {
                out *= count;
                count -= 1;
            }
            return int_value(out);
        }
        return self.fail(ErrorCode.TypeMismatch, "unknown postfix operator");
    }

    // Shared by both the prefix and the postfix increment. `after` decides
    // which of the two values the expression itself produces.
    fn apply_step(ref self, target: int, op: TokenKind, after: bool) -> Value {
        if (self.tree.kind_of(target) != NodeKind.Variable) {
            return self.fail(ErrorCode.NotAssignable, "increment needs a variable");
        }
        let name = self.tree.at(target).text;
        let current = self.environment.lookup(name);
        if (not current.is_number()) {
            return self.fail(ErrorCode.TypeMismatch, "increment needs a number");
        }
        var stepped = current.number;
        if (op == TokenKind.PlusPlus) {
            stepped = decimal_add(stepped, decimal_from_int(1));
        } else {
            stepped = decimal_subtract(stepped, decimal_from_int(1));
        }
        Discard(self.environment.assign(name, number_value(stepped)));
        if (after) {
            return number_value(current.number);
        }
        return number_value(stepped);
    }

    fn evaluate_binary(ref self, index: int) -> Value {
        let op = self.tree.at(index).op;

        // The short circuit operators must not evaluate their right side.
        if (is_short_circuit(op)) {
            let left = self.evaluate(self.tree.at(index).lhs);
            if (left.is_failure()) {
                return left;
            }
            if (op == TokenKind.AmpAmp or op == TokenKind.KeywordAnd) {
                if (not left.truthy()) {
                    return bool_value(false);
                }
                let right = self.evaluate(self.tree.at(index).rhs);
                if (right.is_failure()) {
                    return right;
                }
                return bool_value(right.truthy());
            }
            if (left.truthy()) {
                return bool_value(true);
            }
            let right = self.evaluate(self.tree.at(index).rhs);
            if (right.is_failure()) {
                return right;
            }
            return bool_value(right.truthy());
        }

        let left = self.evaluate(self.tree.at(index).lhs);
        if (left.is_failure()) {
            return left;
        }
        let right = self.evaluate(self.tree.at(index).rhs);
        if (right.is_failure()) {
            return right;
        }
        return self.apply_binary(op, left, right);
    }

    fn apply_binary(ref self, op: TokenKind, left: Value, right: Value) -> Value {
        if (op == TokenKind.EqualEqual) {
            return bool_value(values_equal(left, right));
        }
        if (op == TokenKind.BangEqual) {
            return bool_value(not values_equal(left, right));
        }
        if (is_comparison(op)) {
            let order = compare_values(left, right);
            if (op == TokenKind.Less) { return bool_value(order < 0); }
            if (op == TokenKind.LessEqual) { return bool_value(order <= 0); }
            if (op == TokenKind.Greater) { return bool_value(order > 0); }
            if (op == TokenKind.GreaterEqual) { return bool_value(order >= 0); }
        }

        // `+` is overloaded on strings and lists as concatenation.
        if (op == TokenKind.Plus) {
            if (left.is_text() or right.is_text()) {
                var joined = left.to_text();
                joined.append(right.to_text());
                return text_value(joined);
            }
            if (left.is_list()) {
                var items = left.items;
                if (right.is_list()) {
                    for (element in right.items) {
                        items.push_back(*element);
                    }
                } else {
                    items.push_back(*right);
                }
                return list_value(move(items));
            }
        }

        if (not left.is_number() or not right.is_number()) {
            var detail: string = "operator ";
            detail.append(token_spelling(op));
            detail.append(" does not accept ");
            detail.append(left.kind_name());
            detail.append(" and ");
            detail.append(right.kind_name());
            return self.fail(ErrorCode.TypeMismatch, detail);
        }

        if (op == TokenKind.Plus) {
            return number_value(decimal_add(left.number, right.number));
        }
        if (op == TokenKind.Minus) {
            return number_value(decimal_subtract(left.number, right.number));
        }
        if (op == TokenKind.Star) {
            return number_value(decimal_multiply(left.number, right.number));
        }
        if (op == TokenKind.Slash) {
            if (right.number.is_zero()) {
                return self.fail(ErrorCode.DivideByZero, "the divisor evaluates to zero");
            }
            return number_value(decimal_divide(left.number, right.number));
        }
        if (op == TokenKind.Percent) {
            if (right.number.is_zero()) {
                return self.fail(ErrorCode.DivideByZero, "the modulus evaluates to zero");
            }
            return number_value(decimal_remainder(left.number, right.number));
        }
        if (op == TokenKind.StarStar) {
            return number_value(decimal_power(left.number, right.number));
        }

        // The bitwise family works on the truncated integer value.
        let a = left.number.to_int();
        let b = right.number.to_int();
        if (op == TokenKind.Amp) { return int_value(a & b); }
        if (op == TokenKind.Pipe) { return int_value(a | b); }
        if (op == TokenKind.Caret) { return int_value(a ^ b); }
        if (op == TokenKind.LessLess) { return int_value(a << b); }
        if (op == TokenKind.GreaterGreater) { return int_value(a >> b); }

        var detail: string = "unknown operator ";
        detail.append(token_spelling(op));
        return self.fail(ErrorCode.TypeMismatch, detail);
    }

    fn evaluate_assign(ref self, index: int) -> Value {
        let op = self.tree.at(index).op;
        let target = self.tree.at(index).lhs;
        if (self.tree.kind_of(target) != NodeKind.Variable) {
            return self.fail(ErrorCode.NotAssignable, "only plain names may be assigned to");
        }
        let name = self.tree.at(target).text;
        var value = self.evaluate(self.tree.at(index).rhs);
        if (value.is_failure()) {
            return value;
        }
        if (op != TokenKind.Equal) {
            let base_ = compound_base_operator(op);
            let current = self.environment.lookup(name);
            value = self.apply_binary(base_, current, value);
            if (value.is_failure()) {
                return value;
            }
        }
        if (not self.environment.assign(name, value)) {
            self.environment.define(name, value);
        }
        return value;
    }

    fn evaluate_conditional(ref self, index: int) -> Value {
        let condition = self.evaluate(self.tree.at(index).lhs);
        if (condition.is_failure()) {
            return condition;
        }
        if (condition.truthy()) {
            return self.evaluate(self.tree.at(index).rhs);
        }
        return self.evaluate(self.tree.at(index).extra);
    }

    fn evaluate_let(ref self, index: int) -> Value {
        let value = self.evaluate(self.tree.at(index).lhs);
        if (value.is_failure()) {
            return value;
        }
        self.environment.define(self.tree.at(index).text, value);
        return value;
    }

    fn evaluate_block(ref self, index: int) -> Value {
        self.environment.push_scope("block");
        var last = nil_value();
        for (statement in self.tree.at(index).parts) {
            last = self.evaluate(statement);
            if (last.is_failure()) {
                break;
            }
            if (self.returning) {
                break;
            }
        }
        self.environment.pop_scope();
        return last;
    }

    fn evaluate_loop(ref self, index: int) -> Value {
        var last = nil_value();
        var rounds: int = 0;
        while (true) {
            let condition = self.evaluate(self.tree.at(index).lhs);
            if (condition.is_failure()) {
                return condition;
            }
            if (not condition.truthy()) {
                break;
            }
            last = self.evaluate(self.tree.at(index).rhs);
            if (last.is_failure()) {
                return last;
            }
            if (self.returning) {
                break;
            }
            rounds += 1;
            if (rounds > self.step_limit) {
                return self.fail(ErrorCode.DepthExceeded, "loop ran past the step limit");
            }
        }
        return last;
    }

    fn evaluate_index(ref self, index: int) -> Value {
        let target = self.evaluate(self.tree.at(index).lhs);
        if (target.is_failure()) {
            return target;
        }
        let subscript = self.evaluate(self.tree.at(index).rhs);
        if (subscript.is_failure()) {
            return subscript;
        }
        if (not subscript.is_number()) {
            return self.fail(ErrorCode.TypeMismatch, "a subscript has to be a number");
        }
        let position = subscript.number.to_int();
        if (target.is_list()) {
            if (position < 0 or position >= target.items.size()) {
                return nil_value();
            }
            return target.items[position];
        }
        if (target.is_text()) {
            if (position < 0 or position >= target.text.size()) {
                return nil_value();
            }
            return text_value(target.text.substr(position, 1));
        }
        return self.fail(ErrorCode.NotIndexable, target.kind_name());
    }

    // Member access is limited to a fixed set of pseudo fields, since the
    // language has no user defined records yet.
    fn evaluate_member(ref self, index: int) -> Value {
        let target = self.evaluate(self.tree.at(index).lhs);
        if (target.is_failure()) {
            return target;
        }
        let field = self.tree.at(index).text;
        if (field == "length" or field == "size") {
            return int_value(target.size());
        }
        if (field == "kind") {
            return text_value(target.kind_name());
        }
        if (field == "first") {
            if (target.is_list() and target.items.size() > 0) {
                return target.items[0];
            }
            return nil_value();
        }
        if (field == "last") {
            if (target.is_list() and target.items.size() > 0) {
                return target.items[target.items.size() - 1];
            }
            return nil_value();
        }
        if (field == "text") {
            return text_value(target.to_text());
        }
        var detail: string = "no member named '";
        detail.append(field);
        detail.append("'");
        return self.fail(ErrorCode.UnknownName, detail);
    }

    fn evaluate_call(ref self, index: int) -> Value {
        let callee = self.tree.at(index).lhs;
        if (self.tree.kind_of(callee) != NodeKind.Variable) {
            return self.fail(ErrorCode.NotCallable, "only named builtins may be called");
        }
        let name = self.tree.at(callee).text;
        var arguments: vector(Value);
        for (child in self.tree.at(index).parts) {
            var argument = child;
            // Unwrap a labelled argument; the label is only documentation.
            if (self.tree.kind_of(argument) == NodeKind.Let) {
                argument = self.tree.at(argument).lhs;
            }
            let value = self.evaluate(argument);
            if (value.is_failure()) {
                return value;
            }
            arguments.push_back(value);
        }
        return self.call_builtin(name, arguments);
    }

    fn call_builtin(ref self, name: string, arguments: vector(Value)) -> Value {
        let wanted = builtin_arity(name);
        if (wanted == -2) {
            var unknown: string = "no builtin named '";
            unknown.append(*name);
            unknown.append("'");
            return self.fail(ErrorCode.NotCallable, unknown);
        }
        if (wanted >= 0 and arguments.size() != wanted) {
            var detail = *name;
            detail.append(" expects ");
            detail.append(to_string(wanted));
            detail.append(" arguments, got ");
            detail.append(to_string(arguments.size()));
            return self.fail(ErrorCode.WrongArity, detail);
        }

        if (*name == "list") {
            var items: vector(Value);
            for (element in *arguments) {
                items.push_back(*element);
            }
            return list_value(move(items));
        }
        if (*name == "print") {
            println(arguments[0].to_text());
            self.output.push_back(arguments[0].to_text());
            return arguments[0];
        }
        if (*name == "type") {
            return text_value(arguments[0].kind_name());
        }
        if (*name == "len") {
            return int_value(arguments[0].size());
        }
        if (*name == "string") {
            return text_value(arguments[0].to_text());
        }
        if (*name == "upper") {
            return text_value(text_upper(arguments[0].to_text()));
        }
        if (*name == "lower") {
            return text_value(text_lower(arguments[0].to_text()));
        }
        if (*name == "trim") {
            return text_value(text_trim(arguments[0].to_text()));
        }
        if (*name == "concat") {
            var joined = arguments[0].to_text();
            joined.append(arguments[1].to_text());
            return text_value(joined);
        }
        if (*name == "at") {
            let container = arguments[0];
            let position = arguments[1].number.to_int();
            if (container.is_list()) {
                if (position < 0 or position >= container.items.size()) {
                    return nil_value();
                }
                return container.items[position];
            }
            if (container.is_text()) {
                if (position < 0 or position >= container.text.size()) {
                    return nil_value();
                }
                return text_value(container.text.substr(position, 1));
            }
            return self.fail(ErrorCode.NotIndexable, container.kind_name());
        }
        if (*name == "slice") {
            let container = arguments[0];
            let begin = arguments[1].number.to_int();
            let count = arguments[2].number.to_int();
            if (container.is_text()) {
                return text_value(container.text.substr(begin, count));
            }
            var items: vector(Value);
            for (i in range(begin, begin + count)) {
                if (i >= 0 and i < container.items.size()) {
                    items.push_back(container.items[i]);
                }
            }
            return list_value(move(items));
        }
        if (*name == "push") {
            var items = arguments[0].items;
            items.push_back(arguments[1]);
            return list_value(move(items));
        }
        if (*name == "sum") {
            var total = decimal_from_int(0);
            for (element in arguments[0].items) {
                if (element.is_number()) {
                    total = decimal_add(total, element.number);
                }
            }
            return number_value(total);
        }

        // The numeric family, all of which want a number argument.
        if (not arguments[0].is_number()) {
            var detail = *name;
            detail.append(" expects a number");
            return self.fail(ErrorCode.TypeMismatch, detail);
        }
        if (*name == "abs") {
            if (arguments[0].number.is_negative()) {
                return number_value(decimal_negate(arguments[0].number));
            }
            return arguments[0];
        }
        if (*name == "floor") {
            return number_value(decimal_floor(arguments[0].number));
        }
        if (*name == "ceil") {
            return number_value(decimal_ceil(arguments[0].number));
        }
        if (*name == "round") {
            return number_value(decimal_round(arguments[0].number));
        }
        if (*name == "sqrt") {
            return number_value(decimal_sqrt(arguments[0].number));
        }
        if (*name == "number") {
            return arguments[0];
        }
        if (*name == "min") {
            if (decimal_compare(arguments[0].number, arguments[1].number) <= 0) {
                return arguments[0];
            }
            return arguments[1];
        }
        if (*name == "max") {
            if (decimal_compare(arguments[0].number, arguments[1].number) >= 0) {
                return arguments[0];
            }
            return arguments[1];
        }
        return self.fail(ErrorCode.NotCallable, *name);
    }

    fn reset(ref self) {
        self.environment = make_environment();
        self.problem = Diagnostic();
        self.output.clear();
        self.steps = 0;
        self.returning = false;
    }

    var tree: Arena;
    var environment: Environment;
    var problem: Diagnostic;
    var output: vector(string);
    var steps: int = 0;
    var step_limit: int = 100000;
    var returning: bool = false;
}

// --- Constant folding ----------------------------------------------------
//
// A bottom up rewrite over the arena. Every fold rewrites a node in place so
// that parents keep pointing at the same index, and the pass reports how
// many nodes it changed so that a caller can iterate to a fixed point.
class Folder {

    fn folded(self) -> int {
        return self.rewrites;
    }

    // A subtree is pure when evaluating it twice has the same effect as
    // evaluating it once and nothing outside it can observe the difference.
    fn pure(self, index: int) -> bool {
        if (not self.tree.valid(index)) {
            return true;
        }
        let kind = self.tree.kind_of(index);
        if (kind == NodeKind.Assign) {
            return false;
        }
        if (kind == NodeKind.Postfix) {
            return false;
        }
        if (kind == NodeKind.Let) {
            return false;
        }
        if (kind == NodeKind.Loop) {
            return false;
        }
        if (kind == NodeKind.Return) {
            return false;
        }
        if (kind == NodeKind.Unary) {
            let op = self.tree.operator_of(index);
            if (op == TokenKind.PlusPlus or op == TokenKind.MinusMinus) {
                return false;
            }
            return self.pure(self.tree.at(index).lhs);
        }
        if (kind == NodeKind.Call) {
            let callee = self.tree.at(index).lhs;
            if (self.tree.kind_of(callee) != NodeKind.Variable) {
                return false;
            }
            if (not builtin_is_pure(self.tree.at(callee).text)) {
                return false;
            }
            for (child in self.tree.at(index).parts) {
                if (not self.pure(child)) {
                    return false;
                }
            }
            return true;
        }
        if (kind == NodeKind.Variable) {
            // A free variable is pure to read but its value is unknown, so
            // the folder treats it as pure and simply cannot fold it.
            return true;
        }
        if (self.tree.at(index).lhs != NO_NODE and not self.pure(self.tree.at(index).lhs)) {
            return false;
        }
        if (self.tree.at(index).rhs != NO_NODE and not self.pure(self.tree.at(index).rhs)) {
            return false;
        }
        if (self.tree.at(index).extra != NO_NODE and not self.pure(self.tree.at(index).extra)) {
            return false;
        }
        return true;
    }

    fn is_constant(self, index: int) -> bool {
        if (not self.tree.valid(index)) {
            return false;
        }
        return self.tree.at(index).is_literal();
    }

    fn constant_value(ref self, index: int) -> Value {
        let kind = self.tree.kind_of(index);
        if (kind == NodeKind.NumberLiteral) {
            return number_value(make_decimal(self.tree.at(index).mantissa, self.tree.at(index).exponent));
        }
        if (kind == NodeKind.TextLiteral) {
            return text_value(self.tree.at(index).text);
        }
        if (kind == NodeKind.BoolLiteral) {
            return bool_value(self.tree.at(index).flag);
        }
        return nil_value();
    }

    fn write_value(ref self, index: int, value: Value) {
        if (value.is_number()) {
            self.tree.replace_with_number(index, value.number.mantissa, value.number.exponent);
            self.rewrites += 1;
            return;
        }
        if (value.is_bool()) {
            self.tree.replace_with_bool(index, value.flag);
            self.rewrites += 1;
            return;
        }
        if (value.is_text()) {
            var literal = Node({.kind = NodeKind.TextLiteral, .text = value.text});
            self.tree.replace(index, move(literal));
            self.rewrites += 1;
            return;
        }
        if (value.is_nil()) {
            self.tree.replace(index, Node({.kind = NodeKind.NullLiteral}));
            self.rewrites += 1;
        }
    }

    // --- The pass --------------------------------------------------------

    fn fold(ref self, index: int) -> int {
        if (not self.tree.valid(index)) {
            return index;
        }
        let kind = self.tree.kind_of(index);

        if (kind == NodeKind.Unary) {
            return self.fold_unary(index);
        }
        if (kind == NodeKind.Binary) {
            return self.fold_binary(index);
        }
        if (kind == NodeKind.Conditional) {
            return self.fold_conditional(index);
        }
        if (kind == NodeKind.Call) {
            return self.fold_call(index);
        }
        if (kind == NodeKind.Block) {
            return self.fold_block(index);
        }
        if (kind == NodeKind.Index) {
            Discard(self.fold(self.tree.at(index).lhs));
            Discard(self.fold(self.tree.at(index).rhs));
            return index;
        }
        if (kind == NodeKind.Member) {
            Discard(self.fold(self.tree.at(index).lhs));
            return index;
        }
        if (kind == NodeKind.Assign) {
            Discard(self.fold(self.tree.at(index).rhs));
            return index;
        }
        if (kind == NodeKind.Let) {
            Discard(self.fold(self.tree.at(index).lhs));
            return index;
        }
        if (kind == NodeKind.Loop) {
            return self.fold_loop(index);
        }
        if (kind == NodeKind.Return) {
            Discard(self.fold(self.tree.at(index).lhs));
            return index;
        }
        return index;
    }

    fn fold_unary(ref self, index: int) -> int {
        let operand = self.fold(self.tree.at(index).lhs);
        let op = self.tree.operator_of(index);

        // Double negation cancels, which shows up constantly in generated
        // input like `-(-x)`.
        if (op == TokenKind.Minus and self.tree.kind_of(operand) == NodeKind.Unary) {
            if (self.tree.operator_of(operand) == TokenKind.Minus) {
                let inner = self.tree.at(operand).lhs;
                let copy = self.tree.adopt(inner);
                var replacement = Node({.kind = self.tree.kind_of(copy)});
                replacement.op = self.tree.operator_of(copy);
                replacement.lhs = self.tree.at(copy).lhs;
                replacement.rhs = self.tree.at(copy).rhs;
                replacement.extra = self.tree.at(copy).extra;
                replacement.mantissa = self.tree.at(copy).mantissa;
                replacement.exponent = self.tree.at(copy).exponent;
                replacement.text = self.tree.at(copy).text;
                replacement.flag = self.tree.at(copy).flag;
                self.tree.replace(index, move(replacement));
                self.rewrites += 1;
                return index;
            }
        }

        if (not self.is_constant(operand)) {
            return index;
        }
        var machine = Interpreter();
        machine.tree = self.tree;
        let value = machine.evaluate(index);
        if (value.is_failure()) {
            return index;
        }
        self.write_value(index, value);
        return index;
    }

    fn fold_binary(ref self, index: int) -> int {
        let left = self.fold(self.tree.at(index).lhs);
        let right = self.fold(self.tree.at(index).rhs);
        let op = self.tree.operator_of(index);

        if (self.is_constant(left) and self.is_constant(right)) {
            let a = self.constant_value(left);
            let b = self.constant_value(right);
            if (op == TokenKind.Slash and b.is_number() and b.number.is_zero()) {
                return index;
            }
            if (op == TokenKind.Percent and b.is_number() and b.number.is_zero()) {
                return index;
            }
            var machine = Interpreter();
            machine.tree = self.tree;
            let value = machine.evaluate(index);
            if (not value.is_failure()) {
                self.write_value(index, value);
            }
            return index;
        }

        // Algebraic identities, which fire far more often than full folds.
        if (self.is_zero_literal(right) and (op == TokenKind.Plus or op == TokenKind.Minus)) {
            self.splice(index, left);
            return index;
        }
        if (self.is_zero_literal(left) and op == TokenKind.Plus) {
            self.splice(index, right);
            return index;
        }
        if (self.is_one_literal(right) and (op == TokenKind.Star or op == TokenKind.Slash)) {
            self.splice(index, left);
            return index;
        }
        if (self.is_one_literal(left) and op == TokenKind.Star) {
            self.splice(index, right);
            return index;
        }
        if (self.is_zero_literal(right) and op == TokenKind.Star and self.pure(left)) {
            self.tree.replace_with_number(index, 0, 0);
            self.rewrites += 1;
            return index;
        }
        if (op == TokenKind.AmpAmp and self.is_false_literal(left)) {
            self.tree.replace_with_bool(index, false);
            self.rewrites += 1;
            return index;
        }
        if (op == TokenKind.PipePipe and self.is_true_literal(left)) {
            self.tree.replace_with_bool(index, true);
            self.rewrites += 1;
            return index;
        }
        return index;
    }

    fn fold_conditional(ref self, index: int) -> int {
        let condition = self.fold(self.tree.at(index).lhs);
        let whenever = self.fold(self.tree.at(index).rhs);
        let otherwise = self.fold(self.tree.at(index).extra);
        if (not self.is_constant(condition)) {
            return index;
        }
        // Dead branch elimination: a constant condition means one of the two
        // arms can never run, so the surviving arm replaces the whole node.
        let decided = self.constant_value(condition);
        if (decided.truthy()) {
            self.splice(index, whenever);
        } else {
            self.splice(index, otherwise);
        }
        return index;
    }

    fn fold_call(ref self, index: int) -> int {
        var all_constant = true;
        for (child in self.tree.at(index).parts) {
            let folded = self.fold(child);
            if (not self.is_constant(folded)) {
                all_constant = false;
            }
        }
        let callee = self.tree.at(index).lhs;
        if (self.tree.kind_of(callee) != NodeKind.Variable) {
            return index;
        }
        if (not builtin_is_pure(self.tree.at(callee).text)) {
            return index;
        }
        if (not all_constant) {
            return index;
        }
        var machine = Interpreter();
        machine.tree = self.tree;
        let value = machine.evaluate(index);
        if (value.is_failure()) {
            return index;
        }
        if (value.is_list()) {
            return index;
        }
        self.write_value(index, value);
        return index;
    }

    // `while false { ... }` never runs at all.
    fn fold_loop(ref self, index: int) -> int {
        let condition = self.fold(self.tree.at(index).lhs);
        Discard(self.fold(self.tree.at(index).rhs));
        if (self.is_false_literal(condition)) {
            self.tree.replace(index, Node({.kind = NodeKind.Empty}));
            self.rewrites += 1;
        }
        return index;
    }

    // Dead code within a block: statements after a `return` can never run,
    // and pure statements whose value is discarded can be dropped outright.
    fn fold_block(ref self, index: int) -> int {
        var kept: vector(int);
        var terminated = false;
        let total = self.tree.at(index).parts.size();
        var position: int = 0;
        for (child in self.tree.at(index).parts) {
            position += 1;
            if (terminated) {
                self.removed += 1;
                continue;
            }
            let folded = self.fold(child);
            let kind = self.tree.kind_of(folded);
            if (kind == NodeKind.Empty) {
                self.removed += 1;
                continue;
            }
            // The final statement is the value of the block, so it stays
            // even when it is pure.
            if (position < total and self.pure(folded) and self.droppable(folded)) {
                self.removed += 1;
                continue;
            }
            kept.push_back(folded);
            if (kind == NodeKind.Return) {
                terminated = true;
            }
        }
        let ref slot: auto = self.tree.at(index);
        slot.parts.clear();
        for (survivor in kept) {
            slot.parts.push_back(survivor);
        }
        return index;
    }

    // Statements worth removing when their value is unused. A bare variable
    // or literal qualifies; a call never does, even a pure one, because the
    // author probably meant it.
    fn droppable(self, index: int) -> bool {
        let kind = self.tree.kind_of(index);
        if (kind == NodeKind.Variable) { return true; }
        if (kind == NodeKind.NumberLiteral) { return true; }
        if (kind == NodeKind.TextLiteral) { return true; }
        if (kind == NodeKind.BoolLiteral) { return true; }
        if (kind == NodeKind.NullLiteral) { return true; }
        if (kind == NodeKind.Empty) { return true; }
        return false;
    }

    // Copy `source` over `target` so that the parent keeps its index.
    fn splice(ref self, target: int, source: int) {
        if (not self.tree.valid(source)) {
            return;
        }
        var replacement = Node({.kind = self.tree.kind_of(source)});
        replacement.op = self.tree.operator_of(source);
        replacement.lhs = self.tree.at(source).lhs;
        replacement.rhs = self.tree.at(source).rhs;
        replacement.extra = self.tree.at(source).extra;
        replacement.mantissa = self.tree.at(source).mantissa;
        replacement.exponent = self.tree.at(source).exponent;
        replacement.text = self.tree.at(source).text;
        replacement.flag = self.tree.at(source).flag;
        for (child in self.tree.at(source).parts) {
            replacement.parts.push_back(child);
        }
        self.tree.replace(target, move(replacement));
        self.rewrites += 1;
    }

    fn is_zero_literal(self, index: int) -> bool {
        if (self.tree.kind_of(index) != NodeKind.NumberLiteral) {
            return false;
        }
        return self.tree.at(index).mantissa == 0;
    }

    fn is_one_literal(self, index: int) -> bool {
        if (self.tree.kind_of(index) != NodeKind.NumberLiteral) {
            return false;
        }
        var probe = make_decimal(self.tree.at(index).mantissa, self.tree.at(index).exponent);
        return decimal_equal(probe, decimal_from_int(1));
    }

    fn is_true_literal(self, index: int) -> bool {
        if (self.tree.kind_of(index) != NodeKind.BoolLiteral) {
            return false;
        }
        return self.tree.at(index).flag;
    }

    fn is_false_literal(self, index: int) -> bool {
        if (self.tree.kind_of(index) != NodeKind.BoolLiteral) {
            return false;
        }
        return not self.tree.at(index).flag;
    }

    var tree: Arena;
    var rewrites: int = 0;
    var removed: int = 0;
}

// Run the folder until it stops making progress, or until the round limit is
// hit. Two rounds are usually enough; the third only confirms the fixed
// point.
let MAX_FOLD_ROUNDS: int = 4;

fn fold_to_fixed_point(ref tree: Arena, root: int) -> int {
    var total: int = 0;
    var round: int = 0;
    while (round < MAX_FOLD_ROUNDS) {
        var pass = Folder();
        pass.tree = *tree;
        Discard(pass.fold(root));
        *tree = move(pass.tree);
        total += pass.rewrites;
        if (pass.rewrites == 0) {
            break;
        }
        round += 1;
    }
    return total;
}

// --- The printer ---------------------------------------------------------
//
// Turns a tree back into source text. The output is not the original text -
// spacing is normalised and redundant parentheses are dropped - but it is
// guaranteed to reparse into the same tree, which is what the round trip
// test in this file checks.
//
// Parentheses are reinserted from the same precedence table the parser used:
// a child is wrapped when its own binding power is lower than the level it
// appears in, or when it sits on the wrong side of a left associative
// operator.
class Printer {

    fn print(ref self, index: int) -> string {
        return self.print_at(index, PRECEDENCE_NONE);
    }

    fn print_at(ref self, index: int, context_power: int) -> string {
        if (not self.tree.valid(index)) {
            return TEXT_EMPTY;
        }
        let kind = self.tree.kind_of(index);

        if (kind == NodeKind.NumberLiteral) {
            return self.print_number(index);
        }
        if (kind == NodeKind.TextLiteral) {
            return quote_text(self.tree.at(index).text);
        }
        if (kind == NodeKind.BoolLiteral) {
            if (self.tree.at(index).flag) {
                return WORD_TRUE;
            }
            return WORD_FALSE;
        }
        if (kind == NodeKind.NullLiteral) {
            return WORD_NULL;
        }
        if (kind == NodeKind.Empty) {
            return TEXT_SEMICOLON;
        }
        if (kind == NodeKind.Variable) {
            return self.tree.at(index).text;
        }
        if (kind == NodeKind.Unary) {
            return self.print_unary(index, context_power);
        }
        if (kind == NodeKind.Postfix) {
            return self.print_postfix(index);
        }
        if (kind == NodeKind.Binary) {
            return self.print_binary(index, context_power);
        }
        if (kind == NodeKind.Assign) {
            return self.print_assign(index, context_power);
        }
        if (kind == NodeKind.Conditional) {
            return self.print_conditional(index, context_power);
        }
        if (kind == NodeKind.Call) {
            return self.print_call(index);
        }
        if (kind == NodeKind.Index) {
            return self.print_index(index);
        }
        if (kind == NodeKind.Member) {
            return self.print_member(index);
        }
        if (kind == NodeKind.Let) {
            return self.print_let(index);
        }
        if (kind == NodeKind.Block) {
            return self.print_block(index);
        }
        if (kind == NodeKind.Loop) {
            return self.print_loop(index);
        }
        if (kind == NodeKind.Return) {
            var out: string = "return ";
            out.append(self.print_at(self.tree.at(index).lhs, PRECEDENCE_NONE));
            return out;
        }
        return "<invalid>";
    }

    fn print_number(ref self, index: int) -> string {
        var value = make_decimal(self.tree.at(index).mantissa, self.tree.at(index).exponent);
        return value.to_text();
    }

    fn print_unary(ref self, index: int, context_power: int) -> string {
        var out = token_spelling(self.tree.operator_of(index));
        // `not x` needs the separating space that `!x` does not.
        if (self.tree.operator_of(index) == TokenKind.KeywordNot) {
            out.append(TEXT_SPACE);
        }
        let operand = self.tree.at(index).lhs;
        // `- -x` must not print as `--x`, which would relex as a decrement.
        if (self.tree.kind_of(operand) == NodeKind.Unary) {
            if (self.tree.operator_of(operand) == self.tree.operator_of(index)) {
                out.append(TEXT_SPACE);
            }
        }
        out.append(self.print_at(operand, PRECEDENCE_PREFIX));
        return self.wrap_if(out, PRECEDENCE_PREFIX, context_power);
    }

    fn print_postfix(ref self, index: int) -> string {
        var out = self.print_at(self.tree.at(index).lhs, PRECEDENCE_POSTFIX);
        out.append(token_spelling(self.tree.operator_of(index)));
        return out;
    }

    fn print_binary(ref self, index: int, context_power: int) -> string {
        let op = self.tree.operator_of(index);
        let power = infix_precedence(op);
        let right_associative = infix_associativity(op) == Associativity.Right;

        var left_power = power;
        var right_power = power + 1;
        if (right_associative) {
            left_power = power + 1;
            right_power = power;
        }

        var out = self.print_at(self.tree.at(index).lhs, left_power);
        if (self.spaced_operator(op)) {
            out.append(TEXT_SPACE);
            out.append(token_spelling(op));
            out.append(TEXT_SPACE);
        } else {
            out.append(token_spelling(op));
        }
        out.append(self.print_at(self.tree.at(index).rhs, right_power));
        return self.wrap_if(out, power, context_power);
    }

    fn print_assign(ref self, index: int, context_power: int) -> string {
        var out = self.print_at(self.tree.at(index).lhs, PRECEDENCE_ASSIGN + 1);
        out.append(TEXT_SPACE);
        out.append(token_spelling(self.tree.operator_of(index)));
        out.append(TEXT_SPACE);
        out.append(self.print_at(self.tree.at(index).rhs, PRECEDENCE_ASSIGN));
        return self.wrap_if(out, PRECEDENCE_ASSIGN, context_power);
    }

    // The `flag` field records which of the two surface forms the input
    // used, so the round trip preserves the author's choice.
    fn print_conditional(ref self, index: int, context_power: int) -> string {
        var out: string = "";
        if (self.tree.at(index).flag) {
            out.append(self.print_at(self.tree.at(index).lhs, PRECEDENCE_CONDITIONAL + 1));
            out.append(TEXT_QUESTION_SPACE);
            out.append(self.print_at(self.tree.at(index).rhs, PRECEDENCE_NONE));
            out.append(TEXT_SPACE_COLON_SPACE);
            out.append(self.print_at(self.tree.at(index).extra, PRECEDENCE_CONDITIONAL));
            return self.wrap_if(out, PRECEDENCE_CONDITIONAL, context_power);
        }
        out.append(WORD_IF);
        out.append(TEXT_SPACE);
        out.append(self.print_at(self.tree.at(index).lhs, PRECEDENCE_CONDITIONAL));
        out.append(TEXT_SPACE);
        out.append(WORD_THEN);
        out.append(TEXT_SPACE);
        out.append(self.print_at(self.tree.at(index).rhs, PRECEDENCE_CONDITIONAL));
        if (self.tree.kind_of(self.tree.at(index).extra) != NodeKind.NullLiteral) {
            out.append(TEXT_SPACE);
            out.append(WORD_ELSE);
            out.append(TEXT_SPACE);
            out.append(self.print_at(self.tree.at(index).extra, PRECEDENCE_CONDITIONAL));
        }
        return self.wrap_if(out, PRECEDENCE_CONDITIONAL, context_power);
    }

    fn print_call(ref self, index: int) -> string {
        var out = self.print_at(self.tree.at(index).lhs, PRECEDENCE_POSTFIX);
        out.append(TEXT_LPAREN);
        var first = true;
        for (child in self.tree.at(index).parts) {
            if (not first) {
                out.append(TEXT_COMMA_SPACE);
            }
            out.append(self.print_argument(child));
            first = false;
        }
        out.append(TEXT_RPAREN);
        return out;
    }

    fn print_argument(ref self, index: int) -> string {
        if (self.tree.kind_of(index) == NodeKind.Let and self.tree.at(index).flag) {
            var out = self.tree.at(index).text;
            out.append(TEXT_COLON_SPACE);
            out.append(self.print_at(self.tree.at(index).lhs, PRECEDENCE_ASSIGN));
            return out;
        }
        return self.print_at(index, PRECEDENCE_ASSIGN);
    }

    fn print_index(ref self, index: int) -> string {
        var out = self.print_at(self.tree.at(index).lhs, PRECEDENCE_POSTFIX);
        out.append(TEXT_LBRACKET);
        out.append(self.print_at(self.tree.at(index).rhs, PRECEDENCE_NONE));
        out.append(TEXT_RBRACKET);
        return out;
    }

    fn print_member(ref self, index: int) -> string {
        var out = self.print_at(self.tree.at(index).lhs, PRECEDENCE_POSTFIX);
        out.append(TEXT_DOT);
        out.append(self.tree.at(index).text);
        return out;
    }

    fn print_let(ref self, index: int) -> string {
        var out = WORD_LET;
        out.append(TEXT_SPACE);
        out.append(self.tree.at(index).text);
        out.append(" = ");
        out.append(self.print_at(self.tree.at(index).lhs, PRECEDENCE_NONE));
        return out;
    }

    fn print_loop(ref self, index: int) -> string {
        var out = WORD_WHILE;
        out.append(TEXT_SPACE);
        out.append(self.print_at(self.tree.at(index).lhs, PRECEDENCE_NONE));
        out.append(TEXT_SPACE);
        out.append(self.print_at(self.tree.at(index).rhs, PRECEDENCE_NONE));
        return out;
    }

    fn print_block(ref self, index: int) -> string {
        if (self.tree.at(index).parts.empty()) {
            return "{}";
        }
        var out = TEXT_LBRACE;
        out.append(TEXT_NEWLINE);
        self.indent += 1;
        for (statement in self.tree.at(index).parts) {
            out.append(self.padding());
            out.append(self.print_at(statement, PRECEDENCE_NONE));
            out.append(TEXT_SEMICOLON);
            out.append(TEXT_NEWLINE);
        }
        self.indent -= 1;
        out.append(self.padding());
        out.append(TEXT_RBRACE);
        return out;
    }

    fn padding(self) -> string {
        var out: string = "";
        for (i in range(0, self.indent)) {
            out.append(TEXT_INDENT);
            Discard(i);
        }
        return out;
    }

    // Operators that read better without surrounding spaces at their
    // precedence level. Multiplication is tight, addition is not.
    fn spaced_operator(self, op: TokenKind) -> bool {
        if (not self.compact) {
            return true;
        }
        if (infix_precedence(op) >= PRECEDENCE_MULTIPLICATIVE) {
            return false;
        }
        return true;
    }

    fn wrap_if(self, body: string, power: int, context_power: int) -> string {
        if (power >= context_power) {
            return *body;
        }
        var out = TEXT_LPAREN;
        out.append(*body);
        out.append(TEXT_RPAREN);
        return out;
    }

    var tree: Arena;
    var indent: int = 0;
    var compact: bool = false;
}

// Re-escape a string literal so that it lexes back to the same contents.
fn quote_text(text: string) -> string {
    var out: string = "";
    out.push_back(CHAR_QUOTE);
    for (i in range(0, text.size())) {
        let c = text.at(i);
        let escaped = encode_escape(c);
        if (escaped.size() > 0) {
            out.append(escaped);
        } else {
            out.push_back(c);
        }
    }
    out.push_back(CHAR_QUOTE);
    return out;
}

fn print_tree(ref tree: Arena, root: int) -> string {
    var writer = Printer();
    writer.tree = *tree;
    return writer.print(root);
}

// --- Structural dumping --------------------------------------------------
//
// The other direction: an indented tree dump, used when a test fails and the
// flat source form is not enough to see what went wrong.
fn dump_node(ref tree: Arena, index: int, depth: int) -> string {
    var out: string = "";
    for (i in range(0, depth)) {
        out.append(TEXT_INDENT);
        Discard(i);
    }
    if (not tree.valid(index)) {
        out.append("<none>\n");
        return out;
    }
    out.append(node_kind_name(tree.kind_of(index)));
    let op = tree.operator_of(index);
    if (op != TokenKind.Invalid) {
        out.append(" '");
        out.append(token_spelling(op));
        out.append("'");
    }
    if (tree.at(index).text.size() > 0) {
        out.append(" ");
        out.append(tree.at(index).text);
    }
    if (tree.kind_of(index) == NodeKind.NumberLiteral) {
        out.append(" ");
        out.append(to_string(tree.at(index).mantissa));
        out.append("e");
        out.append(to_string(tree.at(index).exponent));
    }
    out.append(TEXT_NEWLINE);
    if (tree.at(index).lhs != NO_NODE) {
        out.append(dump_node(tree, tree.at(index).lhs, depth + 1));
    }
    if (tree.at(index).rhs != NO_NODE) {
        out.append(dump_node(tree, tree.at(index).rhs, depth + 1));
    }
    if (tree.at(index).extra != NO_NODE) {
        out.append(dump_node(tree, tree.at(index).extra, depth + 1));
    }
    for (child in tree.at(index).parts) {
        out.append(dump_node(tree, child, depth + 1));
    }
    return out;
}

// Structural comparison, which is what "round trips" actually means: the
// text may differ, the tree may not.
fn trees_equal(ref left: Arena, a: int, ref right: Arena, b: int) -> bool {
    if (not left.valid(a) or not right.valid(b)) {
        return left.valid(a) == right.valid(b);
    }
    if (left.kind_of(a) != right.kind_of(b)) {
        return false;
    }
    if (left.operator_of(a) != right.operator_of(b)) {
        return false;
    }
    if (left.at(a).text != right.at(b).text) {
        return false;
    }
    if (left.kind_of(a) == NodeKind.NumberLiteral) {
        let x = make_decimal(left.at(a).mantissa, left.at(a).exponent);
        let y = make_decimal(right.at(b).mantissa, right.at(b).exponent);
        if (not decimal_equal(x, y)) {
            return false;
        }
    }
    if (left.at(a).flag != right.at(b).flag) {
        return false;
    }
    if (left.at(a).parts.size() != right.at(b).parts.size()) {
        return false;
    }
    if (not trees_equal(left, left.at(a).lhs, right, right.at(b).lhs)) {
        return false;
    }
    if (not trees_equal(left, left.at(a).rhs, right, right.at(b).rhs)) {
        return false;
    }
    if (not trees_equal(left, left.at(a).extra, right, right.at(b).extra)) {
        return false;
    }
    for (i in range(0, left.at(a).parts.size())) {
        if (not trees_equal(left, left.at(a).parts[i], right, right.at(b).parts[i])) {
            return false;
        }
    }
    return true;
}

// --- Driving the whole pipeline ------------------------------------------
//
// One object that owns a parser, a folder and an interpreter, so that a
// caller can feed it one line at a time and keep the bindings between calls.
class Session {

    fn ready(self) -> bool {
        return self.problem.ok();
    }

    fn last_error(self) -> string {
        return self.problem.describe();
    }

    // Parse, optionally fold, then evaluate. Returns the value of the last
    // statement, or a failure value describing the first thing that went
    // wrong.
    fn run(ref self, source: string) -> Value {
        var parser: Parser;
        let root = parser.parse_program(source);
        if (not parser.problem.ok()) {
            self.problem = parser.problem;
            return failure_value(self.problem.describe());
        }
        if (self.optimize) {
            self.rewrites += fold_to_fixed_point(parser.tree, root);
        }
        self.machine.tree = move(parser.tree);
        self.machine.returning = false;
        let value = self.machine.evaluate(root);
        self.steps += self.machine.steps;
        if (value.is_failure()) {
            self.problem = self.machine.problem;
        }
        self.last = value;
        return value;
    }

    fn define(ref self, name: string, value: Value) {
        self.machine.environment.define_global(name, move(value));
    }

    fn bound(self, name: string) -> bool {
        return self.machine.environment.bound(name);
    }

    fn value_of(ref self, name: string) -> ref Value {
        return self.machine.environment.lookup(name);
    }

    fn reset(ref self) {
        self.machine.reset();
        self.problem = Diagnostic();
        self.steps = 0;
        self.rewrites = 0;
        self.last = nil_value();
    }

    var machine: Interpreter;
    var problem: Diagnostic;
    var last: Value;
    var steps: int = 0;
    var rewrites: int = 0;
    var optimize: bool = true;
}

fn make_session() -> Session {
    var session: Session;
    session.machine.environment = make_environment();
    return session;
}

// Convenience: evaluate one expression in a throwaway session.
fn evaluate_text(source: string) -> Value {
    var session = make_session();
    return session.run(source);
}

// --- The round trip ------------------------------------------------------
//
// Parse, print, reparse and compare. This is the property the printer has to
// satisfy: printing may change the text but it may never change the tree.
fn round_trips(source: string) -> bool {
    var first: Parser;
    let a = first.parse_source(source);
    if (not first.problem.ok()) {
        return false;
    }
    let printed = print_tree(first.tree, a);

    var second: Parser;
    let b = second.parse_source(printed);
    if (not second.problem.ok()) {
        return false;
    }
    return trees_equal(first.tree, a, second.tree, b);
}

// The stronger version: printing the reprinted text has to be byte identical
// to the first printing, so the printer is idempotent as well as faithful.
fn printing_is_stable(source: string) -> bool {
    var first: Parser;
    let a = first.parse_source(source);
    if (not first.problem.ok()) {
        return false;
    }
    let once = print_tree(first.tree, a);

    var second: Parser;
    let b = second.parse_source(once);
    if (not second.problem.ok()) {
        return false;
    }
    let twice = print_tree(second.tree, b);
    return once == twice;
}

// --- Sample programs -----------------------------------------------------
//
// Deliberately dense inputs that exercise the whole precedence table at
// once. They are held as strings, so the operators inside them are data for
// the tokenizer rather than charge syntax.
fn sample_expressions() -> vector(string) {
    var samples: vector(string);
    samples.push_back("1 + 2 * 3 - 4 / 2");
    samples.push_back("2 ** 3 ** 2");
    samples.push_back("-x * -y + ~mask");
    samples.push_back("a < b && b < c || not done");
    samples.push_back("flags & 12 | 3 ^ 5");
    samples.push_back("value << 3 >> 1");
    samples.push_back("total += count * 2");
    samples.push_back("if ready then 1 else 0");
    samples.push_back("ready ? first : second");
    samples.push_back("points[0].x + points[1].y");
    samples.push_back("min(a, b) + max(c, d)");
    samples.push_back("offset(dx: 3, dy: 4)");
    samples.push_back("\"prefix \" + name + \" suffix\"");
    samples.push_back("counter++ + ++counter");
    samples.push_back("5! + 3!");
    samples.push_back("12.5 * 4 - 0.5");
    samples.push_back("list(1, 2, 3).length");
    samples.push_back("[1, 2, 3][1]");
    samples.push_back("(a + b) * (c - d)");
    samples.push_back("a = b = c = 0");
    samples.push_back("sum([10, 20, 30]) / 3");
    samples.push_back("upper(trim(\"  hello  \"))");
    return samples;
}

fn sample_programs() -> vector(string) {
    var programs: vector(string);
    programs.push_back("let x = 3; let y = 4; sqrt(x ** 2 + y ** 2)");
    programs.push_back("let total = 0; let i = 0; while i < 10 { total += i; i++; } total");
    programs.push_back("let name = \"world\"; concat(\"hello \", name)");
    programs.push_back("let items = [1, 2, 3, 4]; sum(items) / len(items)");
    programs.push_back("let flag = true; if flag then \"yes\" else \"no\"");
    programs.push_back("let scale = 1000; let ratio = 3141 / scale; round(ratio)");
    // A block whose tail is dead: the folder should drop everything after
    // the return.
    programs.push_back("{ return 1; let unused = 2; unused + 3; }");
    return programs;
}

// --- Self checks ---------------------------------------------------------
//
// These read like unit tests but they are ordinary functions; the benchmark
// harness calls them and the assertions document the intended behaviour.

fn check_precedence_table() {
    Assert(infix_precedence(TokenKind.Star) > infix_precedence(TokenKind.Plus));
    Assert(infix_precedence(TokenKind.Plus) > infix_precedence(TokenKind.LessLess));
    Assert(infix_precedence(TokenKind.LessLess) > infix_precedence(TokenKind.Less));
    Assert(infix_precedence(TokenKind.Less) > infix_precedence(TokenKind.EqualEqual));
    Assert(infix_precedence(TokenKind.EqualEqual) > infix_precedence(TokenKind.Amp));
    Assert(infix_precedence(TokenKind.Amp) > infix_precedence(TokenKind.Caret));
    Assert(infix_precedence(TokenKind.Caret) > infix_precedence(TokenKind.Pipe));
    Assert(infix_precedence(TokenKind.Pipe) > infix_precedence(TokenKind.AmpAmp));
    Assert(infix_precedence(TokenKind.AmpAmp) > infix_precedence(TokenKind.PipePipe));
    Assert(infix_precedence(TokenKind.PipePipe) > infix_precedence(TokenKind.Question));
    Assert(infix_precedence(TokenKind.Question) > infix_precedence(TokenKind.Equal));
    Assert(infix_precedence(TokenKind.StarStar) > infix_precedence(TokenKind.Star));
    Assert(prefix_precedence(TokenKind.Bang) > infix_precedence(TokenKind.StarStar));
    Assert(postfix_precedence(TokenKind.LParen) > prefix_precedence(TokenKind.Bang));
    Prove(infix_precedence(TokenKind.Identifier) == PRECEDENCE_NONE);
    Prove(infix_associativity(TokenKind.StarStar) == Associativity.Right);
    Prove(infix_associativity(TokenKind.Minus) == Associativity.Left);
}

fn check_table_is_consistent() {
    let rows = operator_table();
    for (row in rows) {
        Assert(row.precedence == infix_precedence(row.kind));
        Assert(row.associativity == infix_associativity(row.kind));
        Assert(row.spelling == token_spelling(row.kind));
        if (row.mutating) {
            Assert(is_assignment_operator(row.kind));
        }
    }
}

fn check_tokenizer() {
    let tokens = tokenize("a + 12.5 * \"text\" // trailing");
    Assert(tokens.size() > 0);
    Assert(tokens[0].kind == TokenKind.Identifier);
    Assert(tokens[1].kind == TokenKind.Plus);
    Assert(tokens[2].kind == TokenKind.Number);
    Assert(tokens[2].mantissa == 125);
    Assert(tokens[2].exponent == -1);
    Assert(tokens[3].kind == TokenKind.Star);
    Assert(tokens[4].kind == TokenKind.Text);
    Assert(tokens[tokens.size() - 1].kind == TokenKind.End);
}

fn check_maximal_munch() {
    let tokens = tokenize("a <<= b >>= c ++ d -- e ** f");
    Assert(tokens[1].kind == TokenKind.LessLessEqual);
    Assert(tokens[3].kind == TokenKind.GreaterGreaterEqual);
    Assert(tokens[5].kind == TokenKind.PlusPlus);
    Assert(tokens[7].kind == TokenKind.MinusMinus);
    Assert(tokens[9].kind == TokenKind.StarStar);
}

fn check_decimals() {
    let a = make_decimal(125, -1);
    let b = make_decimal(5, -1);
    Assert(decimal_add(a, b).to_text() == "13");
    Assert(decimal_subtract(a, b).to_text() == "12");
    Assert(decimal_multiply(a, decimal_from_int(2)).to_text() == "25");
    Assert(decimal_compare(a, b) > 0);
    Assert(decimal_equal(make_decimal(150, -2), make_decimal(15, -1)));
    Prove(decimal_from_int(0).is_zero());
}

fn check_parses() {
    for (source in sample_expressions()) {
        var parser: Parser;
        let root = parser.parse_source(source);
        Assert(root != NO_NODE);
        Assert(parser.problem.ok());
    }
}

fn check_round_trip() {
    for (source in sample_expressions()) {
        Assert(round_trips(source));
        Assert(printing_is_stable(source));
    }
}

fn check_associativity_shape() {
    // `2 ** 3 ** 2` groups to the right, so the left child is a literal and
    // the right child is another power node.
    var parser: Parser;
    let root = parser.parse_source("2 ** 3 ** 2");
    Assert(parser.tree.kind_of(root) == NodeKind.Binary);
    Assert(parser.tree.operator_of(root) == TokenKind.StarStar);
    let right = parser.tree.at(root).rhs;
    Assert(parser.tree.kind_of(right) == NodeKind.Binary);
    Assert(parser.tree.operator_of(right) == TokenKind.StarStar);

    // Subtraction groups to the left, so the shape is mirrored.
    var other: Parser;
    let flat = other.parse_source("1 - 2 - 3");
    Assert(other.tree.kind_of(other.tree.at(flat).lhs) == NodeKind.Binary);
    Assert(other.tree.kind_of(other.tree.at(flat).rhs) == NodeKind.NumberLiteral);
}

fn check_folding() {
    var parser: Parser;
    let root = parser.parse_source("1 + 2 * 3");
    let changes = fold_to_fixed_point(parser.tree, root);
    Assert(changes > 0);
    Assert(parser.tree.kind_of(root) == NodeKind.NumberLiteral);
    Assert(parser.tree.at(root).mantissa == 7);
}

fn check_identity_folding() {
    var parser: Parser;
    let root = parser.parse_source("x * 1 + 0");
    Discard(fold_to_fixed_point(parser.tree, root));
    Assert(parser.tree.kind_of(root) == NodeKind.Variable);
    Assert(parser.tree.at(root).text == "x");
}

fn check_dead_branch() {
    var parser: Parser;
    let root = parser.parse_source("if true then 1 else 2");
    Discard(fold_to_fixed_point(parser.tree, root));
    Assert(parser.tree.kind_of(root) == NodeKind.NumberLiteral);
    Assert(parser.tree.at(root).mantissa == 1);
}

fn check_evaluation() {
    Assert(evaluate_text("1 + 2 * 3").to_text() == "7");
    Assert(evaluate_text("2 ** 10").to_text() == "1024");
    Assert(evaluate_text("10 / 4").to_text() == "2.5");
    Assert(evaluate_text("7 % 3").to_text() == "1");
    Assert(evaluate_text("\"a\" + \"b\"").to_text() == "ab");
    Assert(evaluate_text("len([1, 2, 3])").to_text() == "3");
    Assert(evaluate_text("true && false").to_text() == WORD_FALSE);
    Assert(evaluate_text("1 < 2 && 2 < 3").truthy());
}

fn check_scoping() {
    var session = make_session();
    Discard(session.run("let outer = 1;"));
    Assert(session.bound("outer"));
    Discard(session.run("{ let inner = 2; inner + outer; }"));
    // The inner binding died with its block; the outer one survived.
    Assert(session.bound("outer"));
    Assert(not session.bound("inner"));
}

fn check_errors() {
    var parser: Parser;
    let root = parser.parse_source("1 +");
    Assert(root == NO_NODE or not parser.problem.ok());
    Assert(parser.problem.code == ErrorCode.ExpectedExpression);

    var second: Parser;
    Discard(second.parse_source("(1 + 2"));
    Assert(second.problem.code == ErrorCode.UnbalancedParen);

    var third: Parser;
    Discard(third.parse_source("1 = 2"));
    Assert(third.problem.code == ErrorCode.NotAssignable);
}

fn check_programs() {
    for (source in sample_programs()) {
        var session = make_session();
        let value = session.run(source);
        Assert(not value.is_failure());
    }
}

// The entry point the benchmark harness calls. Everything above is reachable
// from here.
fn run_all_checks() {
    check_precedence_table();
    check_table_is_consistent();
    check_tokenizer();
    check_maximal_munch();
    check_decimals();
    check_parses();
    check_round_trip();
    check_associativity_shape();
    check_folding();
    check_identity_folding();
    check_dead_branch();
    check_evaluation();
    check_scoping();
    check_errors();
    check_programs();
    println("expression language: all checks passed");
}

// A tiny read eval print driver, kept at the bottom so the file ends on the
// thing a reader is most likely to look for.
fn repl(lines: vector(string)) -> int {
    var session = make_session();
    var failures: int = 0;
    for (line in *lines) {
        let trimmed = text_trim(line);
        if (trimmed.empty()) {
            continue;
        }
        let value = session.run(trimmed);
        if (value.is_failure()) {
            failures += 1;
            println(session.last_error());
        } else {
            println(value.to_text());
        }
    }
    return failures;
}


// A generic graph algorithms library.
//
// The library is deliberately organised as a *shallow tower of namespaces*
// rather than as one enormous container type.  Everything that operates on a
// graph is a free function, grouped by topic:
//
//   * `graph`                  -- the data types themselves plus small helpers,
//   * `graph::builders`        -- construction, conversion and transformation,
//   * `graph::traversal`       -- BFS, DFS and the visitor plumbing,
//   * `graph::connectivity`    -- components, ordering, cycles, cuts,
//   * `graph::shortest_path`   -- Dijkstra, Bellman-Ford, Floyd-Warshall,
//   * `graph::spanning`        -- Prim, Kruskal and the union-find they need,
//   * `graph::matching`        -- bipartite matching and the covers it implies,
//   * `graph::flow`            -- residual networks and maximum flow.
//
// Two storage strategies are provided and they share the same vocabulary:
//
//   * `AdjacencyList{V, W}` keeps, for every vertex, a vector of *edge ids*
//     into a flat `edges` arena.  This is the representation every algorithm
//     in this file prefers, because iterating the incident edges of a vertex
//     costs exactly the degree of that vertex.
//   * `AdjacencyMatrix{V, W, N}` keeps an `N * N` block of cells.  It is the
//     right shape for Floyd-Warshall and for dense max-flow, and it makes the
//     "is there an edge between u and v" question a single index.
//
// Both are parameterised over `V`, the payload carried by a vertex, and `W`,
// the payload carried by an edge.  An *unweighted* graph is simply a graph
// whose edges all carry `UNIT_WEIGHT`; there is no separate type for it, only
// the `unweighted_*` constructors below.
//
// No floating point appears anywhere.  Weights and distances are fixed point
// integers scaled by `WEIGHT_SCALE`, so a weight of "2.5" is written 2500 and
// a ratio of "one half" is `WEIGHT_SCALE / 2`.  Every routine that divides
// documents whether it rounds towards zero.
namespace graph;

// --- Sentinels and tuning -------------------------------------------------

// "No such vertex" / "no such edge".  Negative so it can never index a vector.
let GRAPH_NIL: int = -1;

// Stand-in for +infinity in distance arrays.  Chosen so that adding any two
// finite distances in this library still fits comfortably in an int.
let GRAPH_INFINITY: int = 1000000000;

// Fixed point scale shared by every weight, distance and flow value.
let WEIGHT_SCALE: int = 1000;

// The weight given to an edge of an unweighted graph.
let UNIT_WEIGHT: int = 1000;

// Default number of vertices a freshly built graph reserves room for.
let GRAPH_INITIAL_ORDER: int = 32;

// Growth factor for the edge arena, in percent, so no division by a float is
// ever required.
let GRAPH_GROWTH_PERCENT: int = 175;

// Upper bound on the depth of an explicit traversal stack before the
// iterative variants start reallocating.
let GRAPH_STACK_HINT: int = 64;

// Bellman-Ford gives up after this many relaxation rounds even if the graph
// claims to be larger; a negative cycle is reported instead.
let GRAPH_RELAX_LIMIT: int = 4096;

// Maximum number of augmenting paths a flow routine will look for.  Real
// Edmonds-Karp terminates in O(V * E) augmentations; this is only a guard.
let GRAPH_AUGMENT_LIMIT: int = 100000;

// --- Enumerations ---------------------------------------------------------

// Whether an edge may be traversed in one direction or in both.
choice EdgeDirection {
    Directed,
    Undirected,
}

// Whether the edges of a graph carry meaningful weights.  Algorithms use this
// to pick a cheaper code path, never to change their answer.
choice WeightMode {
    Unweighted,
    Weighted,
}

// The classic three-colour marking used by depth first search.
choice ColorMark {
    White,
    Gray,
    Black,
}

// How a visitor wants the traversal to proceed after a hook fires.
choice VisitAction {
    Continue,
    SkipChildren,
    StopTraversal,
}

// The role an edge plays in a depth first forest.
choice EdgeClass {
    TreeEdge,
    BackEdge,
    ForwardEdge,
    CrossEdge,
}

// The outcome of a topological ordering attempt.
choice OrderStatus {
    TotalOrder,
    CycleFound,
}

// Which side of a bipartition a vertex landed on.
choice Side {
    Unassigned,
    LeftSide,
    RightSide,
}

// --- Edge -----------------------------------------------------------------

// One directed arc of the graph.
//
// Undirected graphs store *two* `Edge` records per logical edge, one in each
// direction, and give them consecutive ids so that `twin_of` can flip between
// them with a single exclusive-or against 1.  `pair_id` keeps the logical
// identity so that, for instance, Kruskal never considers the same physical
// edge twice.
class Edge(V: type, W: type)
{

    // The endpoint that is not `endpoint`.  Passing a vertex that is not an
    // endpoint of this edge returns `tail`, which callers treat as a bug.
    fn other(self, endpoint: int) -> int {
        if (self.tail == endpoint) {
            return self.head;
        }
        return self.tail;
    }

    fn touches(self, vertex: int) -> bool {
        return self.tail == vertex or self.head == vertex;
    }

    fn is_loop(self) -> bool {
        return self.tail == self.head;
    }

    fn is_live(self) -> bool {
        return self.alive and self.tail != GRAPH_NIL;
    }

    // Ids of the two half-edges of an undirected pair differ only in bit 0.
    fn twin_id(self) -> int {
        return self.id ^ 1;
    }

    var tail: int = 0;
    var head: int = 0;
    var weight: int = 0;
    var capacity: int = 0;
    var id: int = 0;
    var pair_id: int = 0;
    var alive: bool = true;
    var payload: W;
    var tag: V;
}

// --- Vertex ---------------------------------------------------------------

// One vertex plus the bookkeeping every traversal wants to hang off it.
//
// The fields after `payload` are scratch space.  Algorithms are expected to
// reset the ones they use through `reset_marks` before they start; nothing in
// this file relies on their value surviving between two calls.
class Vertex(V: type)
{

    fn degree(self) -> int {
        return self.incident.size();
    }

    fn is_isolated(self) -> bool {
        return self.incident.empty();
    }

    fn clear_marks(ref self) {
        self.color = ColorMark.White;
        self.discovered = GRAPH_NIL;
        self.finished = GRAPH_NIL;
        self.parent = GRAPH_NIL;
        self.component = GRAPH_NIL;
        self.side = Side.Unassigned;
    }

    var incident: vector(int);
    var incoming: vector(int);
    var payload: V;
    var id: int = 0;
    var color: ColorMark = ColorMark.White;
    var discovered: int = -1;
    var finished: int = -1;
    var parent: int = -1;
    var component: int = -1;
    var side: Side = Side.Unassigned;
}

// --- Adjacency list -------------------------------------------------------

// The primary representation: a vector of vertices, each holding a vector of
// edge ids into a shared arena.
//
// `direction` decides whether `connect` inserts one arc or two.  Nothing else
// in the type behaves differently, which is what lets one implementation of
// BFS serve both the directed and the undirected case.
class AdjacencyList(V: type, W: type)
{

    fn order(self) -> int {
        return self.vertices.size();
    }

    fn arc_count(self) -> int {
        return self.edges.size();
    }

    // Number of *logical* edges: half the arc count when undirected.
    fn size(self) -> int {
        if (self.direction == EdgeDirection.Undirected) {
            return self.edges.size() / 2;
        }
        return self.edges.size();
    }

    fn is_directed(self) -> bool {
        return self.direction == EdgeDirection.Directed;
    }

    fn is_weighted(self) -> bool {
        return self.mode == WeightMode.Weighted;
    }

    fn valid_vertex(self, v: int) -> bool {
        return v >= 0 and v < self.vertices.size();
    }

    fn vertex(ref self, v: int) -> ref Vertex(V) {
        return self.vertices.at(v);
    }

    fn arc(ref self, e: int) -> ref Edge(V, W) {
        return self.edges.at(e);
    }

    fn incident_of(ref self, v: int) -> ref vector(int) {
        return self.vertices.at(v).incident;
    }

    fn degree(self, v: int) -> int {
        return self.vertices.at(v).incident.size();
    }

    fn in_degree(self, v: int) -> int {
        if (self.direction == EdgeDirection.Undirected) {
            return self.vertices.at(v).incident.size();
        }
        return self.vertices.at(v).incoming.size();
    }

    fn out_degree(self, v: int) -> int {
        return self.vertices.at(v).incident.size();
    }

    // Append a fresh isolated vertex and hand back its id.
    fn add_vertex(ref self, payload: V) -> int {
        let id = self.vertices.size();
        var v = Vertex(V)({.id = id, .payload = payload});
        self.vertices.push_back(move(v));
        return id;
    }

    // Grow to at least `n` vertices, leaving existing ones untouched.
    fn reserve_vertices(ref self, n: int) {
        self.vertices.reserve(n);
        while (self.vertices.size() < n) {
            let id = self.vertices.size();
            self.vertices.push_back(Vertex(V)({.id = id}));
        }
    }

    // The workhorse: insert one arc, and its twin when undirected.
    fn connect(ref self, tail: int, head: int, weight: int) -> int {
        Assert(tail >= 0);
        Assert(head >= 0);
        let first = self.edges.size();
        var forward = Edge(V, W)({.tail = tail,
                                 .head = head,
                                 .weight = weight,
                                 .capacity = weight,
                                 .id = first,
                                 .pair_id = first});
        self.edges.push_back(move(forward));
        self.vertices.at(tail).incident.push_back(first);
        if (self.direction == EdgeDirection.Undirected) {
            let second = self.edges.size();
            var backward = Edge(V, W)({.tail = head,
                                      .head = tail,
                                      .weight = weight,
                                      .capacity = weight,
                                      .id = second,
                                      .pair_id = first});
            self.edges.push_back(move(backward));
            self.vertices.at(head).incident.push_back(second);
        } else {
            self.vertices.at(head).incoming.push_back(first);
        }
        return first;
    }

    fn connect_unweighted(ref self, tail: int, head: int) -> int {
        return self.connect(tail, head, UNIT_WEIGHT);
    }

    // Logical removal: the arc stays in the arena so that ids never shift.
    fn disconnect(ref self, e: int) -> bool {
        if (e < 0 or e >= self.edges.size()) {
            return false;
        }
        let ref arc: auto = self.edges.at(e);
        if (arc.alive == false) {
            return false;
        }
        arc.alive = false;
        if (self.direction == EdgeDirection.Undirected) {
            let ref twin: auto = self.edges.at(arc.twin_id());
            twin.alive = false;
        }
        return true;
    }

    fn has_edge(self, tail: int, head: int) -> bool {
        for (e in self.vertices.at(tail).incident) {
            let ref arc: auto = self.edges.at(e);
            if (arc.alive and arc.head == head) {
                return true;
            }
        }
        return false;
    }

    fn weight_between(self, tail: int, head: int) -> int {
        for (e in self.vertices.at(tail).incident) {
            let ref arc: auto = self.edges.at(e);
            if (arc.alive and arc.head == head) {
                return arc.weight;
            }
        }
        return GRAPH_INFINITY;
    }

    fn reset_marks(ref self) {
        for (v in self.vertices) {
            v.clear_marks();
        }
    }

    fn clear(ref self) {
        self.vertices.clear();
        self.edges.clear();
    }

    var vertices: vector(Vertex(V));
    var edges: vector(Edge(V, W));
    var direction: EdgeDirection = EdgeDirection.Directed;
    var mode: WeightMode = WeightMode.Weighted;
    var label: string;
}

// --- Adjacency matrix -----------------------------------------------------

// Dense representation with a compile-time side length.
//
// `N` being a template parameter means `index_of` is a compile-time affine
// expression and the whole cell block can live in one allocation.  Absent
// edges hold `GRAPH_INFINITY` rather than zero so that Floyd-Warshall can run
// straight over the raw cells.
class AdjacencyMatrix(V: type, W: type, N: int)
{

    fn order(self) -> int {
        return N;
    }

    fn cell_count(self) -> int {
        return N * N;
    }

    fn index_of(self, row: int, col: int) -> int {
        return row * N + col;
    }

    fn at(ref self, row: int, col: int) -> ref int {
        return self.cells.at(row * N + col);
    }

    fn get(self, row: int, col: int) -> int {
        return self.cells.at(row * N + col);
    }

    fn put(ref self, row: int, col: int, value: int) {
        self.cells.at(row * N + col) = value;
        if (self.direction == EdgeDirection.Undirected) {
            self.cells.at(col * N + row) = value;
        }
    }

    fn linked(self, row: int, col: int) -> bool {
        return self.cells.at(row * N + col) < GRAPH_INFINITY;
    }

    fn fill(ref self, value: int) {
        self.cells.clear();
        var k: int = 0;
        while (k < N * N) {
            self.cells.push_back(value);
            k += 1;
        }
    }

    // Reset to "no edges anywhere, zero cost to stay put".
    fn reset(ref self) {
        self.fill(GRAPH_INFINITY);
        var d: int = 0;
        while (d < N) {
            self.cells.at(d * N + d) = 0;
            d += 1;
        }
    }

    fn row_sum(self, row: int) -> int {
        var total: int = 0;
        var c: int = 0;
        while (c < N) {
            let value = self.cells.at(row * N + c);
            if (value < GRAPH_INFINITY) {
                total += value;
            }
            c += 1;
        }
        return total;
    }

    fn symmetric(self) -> bool {
        var r: int = 0;
        while (r < N) {
            var c = r + 1;
            while (c < N) {
                if (self.cells.at(r * N + c) != self.cells.at(c * N + r)) {
                    return false;
                }
                c += 1;
            }
            r += 1;
        }
        return true;
    }

    var cells: vector(int);
    var payloads: vector(V);
    var slack: W;
    var direction: EdgeDirection = EdgeDirection.Directed;
    var mode: WeightMode = WeightMode.Weighted;
}

// --- Small shared helpers -------------------------------------------------

// A vertex/priority pair, used by every routine that needs an ordered
// frontier.  Kept at namespace scope so the heap below is not generic over
// yet another type.
class HeapEntry {

    fn better_than(self, other: HeapEntry) -> bool {
        if (self.priority != other.priority) {
            return self.priority < other.priority;
        }
        return self.vertex < other.vertex;
    }

    var vertex: int = 0;
    var priority: int = 0;
    var stamp: int = 0;
}

// An explicit binary min-heap.
//
// The heap is written by hand rather than reused from the standard library
// because Dijkstra wants `decrease_key`, and because a lazy variant (pushing
// duplicates and discarding stale pops) is measurably simpler to prove
// correct.  Both are supported: `position` is maintained when `tracked` is
// true and ignored otherwise.
class BinaryHeap {

    fn size(self) -> int {
        return self.items.size();
    }

    fn empty(self) -> bool {
        return self.items.empty();
    }

    fn parent_of(self, i: int) -> int {
        return (i - 1) / 2;
    }

    fn left_of(self, i: int) -> int {
        return 2 * i + 1;
    }

    fn right_of(self, i: int) -> int {
        return 2 * i + 2;
    }

    // Move `i` towards the root until the heap property holds above it.
    fn sift_up(ref self, start: int) -> int {
        var i = start;
        while (i > 0) {
            let p = (i - 1) / 2;
            if (self.items.at(i).better_than(self.items.at(p)) == false) {
                break;
            }
            self.swap_slots(i, p);
            i = p;
        }
        return i;
    }

    // Move `i` towards the leaves until the heap property holds below it.
    fn sift_down(ref self, start: int) -> int {
        var i = start;
        let n = self.items.size();
        while (true) {
            let l = 2 * i + 1;
            let r = 2 * i + 2;
            var best = i;
            if (l < n) {
                if (self.items.at(l).better_than(self.items.at(best))) {
                    best = l;
                }
            }
            if (r < n) {
                if (self.items.at(r).better_than(self.items.at(best))) {
                    best = r;
                }
            }
            if (best == i) {
                break;
            }
            self.swap_slots(i, best);
            i = best;
        }
        return i;
    }

    fn swap_slots(ref self, a: int, b: int) {
        swap(self.items.at(a), self.items.at(b));
        if (self.tracked) {
            self.position.at(self.items.at(a).vertex) = a;
            self.position.at(self.items.at(b).vertex) = b;
        }
    }

    fn push(ref self, vertex: int, priority: int) {
        let slot = self.items.size();
        self.items.push_back(HeapEntry({.vertex = vertex, .priority = priority, .stamp = self.clock}));
        self.clock += 1;
        if (self.tracked) {
            self.position.at(vertex) = slot;
        }
        Discard(self.sift_up(slot));
    }

    fn peek(ref self) -> ref HeapEntry {
        return self.items.front();
    }

    fn pop(ref self) -> HeapEntry {
        let top = self.items.front();
        let last = self.items.size() - 1;
        self.swap_slots(0, last);
        self.items.pop_back();
        if (self.items.empty() == false) {
            Discard(self.sift_down(0));
        }
        if (self.tracked) {
            self.position.at(top.vertex) = GRAPH_NIL;
        }
        return top;
    }

    // Lower the recorded priority of a vertex already in the heap.  Returns
    // false when the vertex is absent or the new key is not an improvement.
    fn decrease_key(ref self, vertex: int, priority: int) -> bool {
        if (self.tracked == false) {
            self.push(vertex, priority);
            return true;
        }
        let slot = self.position.at(vertex);
        if (slot == GRAPH_NIL) {
            self.push(vertex, priority);
            return true;
        }
        if (self.items.at(slot).priority <= priority) {
            return false;
        }
        self.items.at(slot).priority = priority;
        Discard(self.sift_up(slot));
        return true;
    }

    fn contains(self, vertex: int) -> bool {
        if (self.tracked == false) {
            return false;
        }
        return self.position.at(vertex) != GRAPH_NIL;
    }

    fn prepare(ref self, order: int) {
        self.items.clear();
        self.position.clear();
        self.tracked = true;
        var i: int = 0;
        while (i < order) {
            self.position.push_back(GRAPH_NIL);
            i += 1;
        }
    }

    fn clear(ref self) {
        self.items.clear();
        self.position.clear();
        self.clock = 0;
    }

    var items: vector(HeapEntry);
    var position: vector(int);
    var tracked: bool = false;
    var clock: int = 0;
}

// Disjoint set forest with union by rank and full path compression.
//
// Used by Kruskal and by the offline connectivity queries in
// `graph::connectivity`.  `components` is maintained eagerly so that
// "is the graph connected" is answered without a scan.
class UnionFind {

    fn prepare(ref self, order: int) {
        self.parent.clear();
        self.rank.clear();
        self.weight.clear();
        var i: int = 0;
        while (i < order) {
            self.parent.push_back(i);
            self.rank.push_back(0);
            self.weight.push_back(1);
            i += 1;
        }
        self.components = order;
    }

    fn find(ref self, x: int) -> int {
        var root = x;
        while (self.parent.at(root) != root) {
            root = self.parent.at(root);
        }
        var walker = x;
        while (walker != root) {
            let next = self.parent.at(walker);
            self.parent.at(walker) = root;
            walker = next;
        }
        return root;
    }

    fn connected(ref self, a: int, b: int) -> bool {
        return self.find(a) == self.find(b);
    }

    fn unite(ref self, a: int, b: int) -> bool {
        var ra = self.find(a);
        var rb = self.find(b);
        if (ra == rb) {
            return false;
        }
        if (self.rank.at(ra) < self.rank.at(rb)) {
            swap(ra, rb);
        }
        self.parent.at(rb) = ra;
        self.weight.at(ra) += self.weight.at(rb);
        if (self.rank.at(ra) == self.rank.at(rb)) {
            self.rank.at(ra) += 1;
        }
        self.components -= 1;
        Assert(self.components >= 1);
        return true;
    }

    fn set_size(ref self, x: int) -> int {
        let root = self.find(x);
        return self.weight.at(root);
    }

    fn single_component(self) -> bool {
        return self.components == 1;
    }

    var parent: vector(int);
    var rank: vector(int);
    var weight: vector(int);
    var components: int = 0;
}

// Fill `target` with `count` copies of `value`, discarding what was there.
fn fill_int_vector(ref target: vector(int), count: int, value: int) {
    target.clear();
    var i: int = 0;
    while (i < count) {
        target.push_back(value);
        i += 1;
    }
}

// Same, for the boolean scratch arrays every traversal needs.
fn fill_bool_vector(ref target: vector(bool), count: int, value: bool) {
    target.clear();
    var i: int = 0;
    while (i < count) {
        target.push_back(value);
        i += 1;
    }
}

// Reverse a vector of ids in place; used to turn a "walk back along parents"
// result into a forward path.
fn reverse_int_vector(ref target: vector(int)) {
    var lo: int = 0;
    var hi = target.size() - 1;
    while (lo < hi) {
        swap(target.at(lo), target.at(hi));
        lo += 1;
        hi -= 1;
    }
}

// Saturating addition on scaled distances: infinity absorbs everything.
fn add_distance(a: int, b: int) -> int {
    if (a >= GRAPH_INFINITY or b >= GRAPH_INFINITY) {
        return GRAPH_INFINITY;
    }
    return a + b;
}

// True when the scaled distance stands for "unreachable".
fn is_unreachable(d: int) -> bool {
    return d >= GRAPH_INFINITY;
}

// ==========================================================================
// graph::builders
//
// Construction, conversion and structural transformation.  Nothing here
// inspects a graph beyond its shape, so this namespace has no dependencies on
// any of the algorithm namespaces below it.
// ==========================================================================
namespace builders;

// An empty directed graph with `n` isolated vertices.
fn directed[V: type, W: type]
    (n: int) -> AdjacencyList(V, W) {
    var g = AdjacencyList(V, W)({.direction = EdgeDirection.Directed,
                                .mode = WeightMode.Weighted});
    g.reserve_vertices(n);
    return g;
}

// An empty undirected graph with `n` isolated vertices.
fn undirected[V: type, W: type]
    (n: int) -> AdjacencyList(V, W) {
    var g = AdjacencyList(V, W)({.direction = EdgeDirection.Undirected,
                                .mode = WeightMode.Weighted});
    g.reserve_vertices(n);
    return g;
}

// Unweighted variants differ only in the mode flag; every edge added later
// still carries `UNIT_WEIGHT` so the weighted algorithms keep working.
fn directed_unweighted[V: type, W: type]
    (n: int) -> AdjacencyList(V, W) {
    var g = directed(V, W)(n);
    g.mode = WeightMode.Unweighted;
    return g;
}

fn undirected_unweighted[V: type, W: type]
    (n: int) -> AdjacencyList(V, W) {
    var g = undirected(V, W)(n);
    g.mode = WeightMode.Unweighted;
    return g;
}

// The path 0 - 1 - 2 - ... - (n - 1), every edge of unit weight.
fn path_graph[V: type, W: type]
    (n: int) -> AdjacencyList(V, W) {
    var g = undirected_unweighted(V, W)(n);
    var i: int = 1;
    while (i < n) {
        Discard(g.connect_unweighted(i - 1, i));
        i += 1;
    }
    return g;
}

// The path above, closed back onto itself.
fn cycle_graph[V: type, W: type]
    (n: int) -> AdjacencyList(V, W) {
    var g = path_graph(V, W)(n);
    if (n > 2) {
        Discard(g.connect_unweighted(n - 1, 0));
    }
    return g;
}

// Every pair of distinct vertices joined once.
fn complete_graph[V: type, W: type]
    (n: int) -> AdjacencyList(V, W) {
    var g = undirected_unweighted(V, W)(n);
    var i: int = 0;
    while (i < n) {
        var j = i + 1;
        while (j < n) {
            Discard(g.connect_unweighted(i, j));
            j += 1;
        }
        i += 1;
    }
    return g;
}

// A `rows * cols` lattice, vertices numbered row-major.
fn grid_graph[V: type, W: type]
    (rows: int, cols: int) -> AdjacencyList(V, W) {
    var g = undirected_unweighted(V, W)(rows * cols);
    var r: int = 0;
    while (r < rows) {
        var c: int = 0;
        while (c < cols) {
            let here = r * cols + c;
            if (c + 1 < cols) {
                Discard(g.connect_unweighted(here, here + 1));
            }
            if (r + 1 < rows) {
                Discard(g.connect_unweighted(here, here + cols));
            }
            c += 1;
        }
        r += 1;
    }
    return g;
}

// The complete bipartite graph on `left + right` vertices.  Left vertices get
// the ids [0, left), right vertices [left, left + right).
fn complete_bipartite[V: type, W: type]
    (left: int, right: int) -> AdjacencyList(V, W) {
    var g = undirected_unweighted(V, W)(left + right);
    var a: int = 0;
    while (a < left) {
        var b: int = 0;
        while (b < right) {
            Discard(g.connect_unweighted(a, left + b));
            b += 1;
        }
        a += 1;
    }
    return g;
}

// A rooted binary tree with `n` vertices, child i having parent (i - 1) / 2.
fn binary_tree_graph[V: type, W: type]
    (n: int) -> AdjacencyList(V, W) {
    var g = undirected_unweighted(V, W)(n);
    var i: int = 1;
    while (i < n) {
        Discard(g.connect_unweighted((i - 1) / 2, i));
        i += 1;
    }
    return g;
}

// Reverse every arc.  Undirected graphs come back unchanged apart from the
// order of the incidence vectors.
fn transpose[V: type, W: type]
    (g: AdjacencyList(V, W)) -> AdjacencyList(V, W) {
    var out = AdjacencyList(V, W)({.direction = g.direction, .mode = g.mode});
    out.reserve_vertices(g.order());
    for (arc in g.edges) {
        if (arc.alive) {
            Discard(out.connect(arc.head, arc.tail, arc.weight));
        }
    }
    return out;
}

// Forget the orientation of every arc.
fn to_undirected[V: type, W: type]
    (g: AdjacencyList(V, W)) -> AdjacencyList(V, W) {
    var out = undirected(V, W)(g.order());
    out.mode = g.mode;
    for (arc in g.edges) {
        if (arc.alive and arc.tail < arc.head) {
            Discard(out.connect(arc.tail, arc.head, arc.weight));
        }
    }
    return out;
}

// Replace every undirected edge by the two opposite arcs.
fn to_directed[V: type, W: type]
    (g: AdjacencyList(V, W)) -> AdjacencyList(V, W) {
    var out = directed(V, W)(g.order());
    out.mode = g.mode;
    for (arc in g.edges) {
        if (arc.alive) {
            Discard(out.connect(arc.tail, arc.head, arc.weight));
        }
    }
    return out;
}

// Drop every arc whose weight exceeds `limit`.
fn filter_by_weight[V: type, W: type]
    (g: AdjacencyList(V, W),
                    limit: int) -> AdjacencyList(V, W) {
    var out = AdjacencyList(V, W)({.direction = g.direction, .mode = g.mode});
    out.reserve_vertices(g.order());
    for (arc in g.edges) {
        if (arc.alive and arc.weight <= limit) {
            if (g.direction == EdgeDirection.Directed or arc.tail < arc.head) {
                Discard(out.connect(arc.tail, arc.head, arc.weight));
            }
        }
    }
    return out;
}

// Keep only the vertices for which `keep` is true, renumbering the survivors.
fn induced_subgraph[V: type, W: type]
    (g: AdjacencyList(V, W),
                    keep: vector(bool)) -> AdjacencyList(V, W) {
    var mapping = vector(int)();
    fill_int_vector(mapping, g.order(), GRAPH_NIL);
    var next: int = 0;
    var v: int = 0;
    while (v < g.order()) {
        if (keep.at(v)) {
            mapping.at(v) = next;
            next += 1;
        }
        v += 1;
    }
    var out = AdjacencyList(V, W)({.direction = g.direction, .mode = g.mode});
    out.reserve_vertices(next);
    for (arc in g.edges) {
        if (arc.alive and keep.at(arc.tail) and keep.at(arc.head)) {
            if (g.direction == EdgeDirection.Directed or arc.tail < arc.head) {
                Discard(out.connect(mapping.at(arc.tail),
                                    mapping.at(arc.head),
                                    arc.weight));
            }
        }
    }
    return out;
}

// Project an adjacency list onto a dense matrix of side `N`.
//
// Parallel edges collapse to the cheapest one, which is what every dense
// shortest path routine expects.
fn densify[V: type, W: type, N: int]
    (g: AdjacencyList(V, W)) -> AdjacencyMatrix(V, W, N) {
    var m = AdjacencyMatrix(V, W, N)({.direction = g.direction, .mode = g.mode});
    m.reset();
    for (arc in g.edges) {
        if (arc.alive and arc.tail < N and arc.head < N) {
            let current = m.get(arc.tail, arc.head);
            if (arc.weight < current) {
                m.put(arc.tail, arc.head, arc.weight);
            }
        }
    }
    return m;
}

// The inverse projection: every finite off-diagonal cell becomes an arc.
fn sparsify[V: type, W: type, N: int]
    (m: AdjacencyMatrix(V, W, N)) -> AdjacencyList(V, W) {
    var g = AdjacencyList(V, W)({.direction = m.direction, .mode = m.mode});
    g.reserve_vertices(N);
    var r: int = 0;
    while (r < N) {
        var c: int = 0;
        while (c < N) {
            if (r != c) {
                let value = m.get(r, c);
                if (value < GRAPH_INFINITY) {
                    if (m.direction == EdgeDirection.Directed or r < c) {
                        Discard(g.connect(r, c, value));
                    }
                }
            }
            c += 1;
        }
        r += 1;
    }
    return g;
}

// Add `delta` to every weight, e.g. to lift a graph out of negative territory
// before running Dijkstra on it.  Note this does *not* preserve shortest
// paths in general; Johnson's reweighting is the principled version.
fn shift_weights[V: type, W: type]
    (ref g: AdjacencyList(V, W), delta: int) {
    for (arc in g.edges) {
        arc.weight += delta;
    }
}

// Scale every weight by a fixed point ratio, rounding towards zero.
fn scale_weights[V: type, W: type]
    (ref g: AdjacencyList(V, W), ratio: int) {
    for (arc in g.edges) {
        arc.weight = arc.weight * ratio / WEIGHT_SCALE;
    }
}

// Sum of all live arc weights, halved for undirected graphs so that each
// logical edge is counted once.
fn total_weight[V: type, W: type]
    (g: AdjacencyList(V, W)) -> int {
    var total: int = 0;
    for (arc in g.edges) {
        if (arc.alive) {
            total += arc.weight;
        }
    }
    if (g.direction == EdgeDirection.Undirected) {
        return total / 2;
    }
    return total;
}

// A cheap structural fingerprint, handy for regression tests.
fn describe[V: type, W: type]
    (g: AdjacencyList(V, W)) -> string {
    var out = string();
    out.append(to_string(g.order()));
    out.append("v/");
    out.append(to_string(g.size()));
    out.append("e");
    if (g.is_directed()) {
        out.append(" directed");
    } else {
        out.append(" undirected");
    }
    if (g.is_weighted()) {
        out.append(" weighted");
    }
    return out;
}



// ==========================================================================
// graph::traversal
//
// Breadth first and depth first search, plus the visitor plumbing the rest of
// the library builds on.  Every routine here is iterative: the recursive
// formulations read better on a whiteboard but blow the stack on the long
// path graphs the benchmarks generate.
// ==========================================================================
namespace traversal;

// The hook set a traversal fires into.
//
// There are no closures in the language, so a visitor is a struct with a
// fixed set of methods and the traversals call them unconditionally.  The
// default implementation records the event and asks the search to continue,
// which makes `Visitor` on its own a perfectly usable "give me the order"
// collector.  Specialised behaviour is obtained by pre-loading the filter
// fields rather than by overriding methods.
class Visitor(V: type, W: type)
{

    // Fired the first time a vertex is dequeued or pushed.
    fn on_discover(ref self, v: int) -> VisitAction {
        self.discovery_order.push_back(v);
        self.visited_count += 1;
        if (self.blocked.empty() == false) {
            if (self.blocked.at(v)) {
                return VisitAction.SkipChildren;
            }
        }
        if (self.stop_after > 0 and self.visited_count >= self.stop_after) {
            return VisitAction.StopTraversal;
        }
        return VisitAction.Continue;
    }

    // Fired once every out-arc of a vertex has been considered.
    fn on_finish(ref self, v: int) -> VisitAction {
        self.finish_order.push_back(v);
        return VisitAction.Continue;
    }

    // Fired for every arc inspected, whatever its classification.
    fn on_edge(ref self, arc: int, kind: EdgeClass) -> VisitAction {
        self.edge_order.push_back(arc);
        if (kind == EdgeClass.BackEdge) {
            self.back_edges += 1;
        }
        if (kind == EdgeClass.TreeEdge) {
            self.tree_edges += 1;
        }
        return VisitAction.Continue;
    }

    // Fired when a search runs out of reachable vertices and restarts.
    fn on_restart(ref self, root: int) {
        self.roots.push_back(root);
    }

    fn prepare(ref self, order: int) {
        self.discovery_order.clear();
        self.finish_order.clear();
        self.edge_order.clear();
        self.roots.clear();
        self.visited_count = 0;
        self.back_edges = 0;
        self.tree_edges = 0;
        fill_bool_vector(self.blocked, order, false);
    }

    fn block(ref self, v: int) {
        self.blocked.at(v) = true;
    }

    fn saw(self, v: int) -> bool {
        for (seen in self.discovery_order) {
            if (seen == v) {
                return true;
            }
        }
        return false;
    }

    var discovery_order: vector(int);
    var finish_order: vector(int);
    var edge_order: vector(int);
    var roots: vector(int);
    var blocked: vector(bool);
    var visited_count: int = 0;
    var back_edges: int = 0;
    var tree_edges: int = 0;
    var stop_after: int = 0;
    var sample: W;
    var label: V;
}

// The state a traversal hands back: parents, depths and the visiting order.
class SearchResult(V: type)
{

    fn reached(self, v: int) -> bool {
        return self.depth.at(v) < GRAPH_INFINITY;
    }

    fn reached_count(self) -> int {
        var total: int = 0;
        for (d in self.depth) {
            if (d < GRAPH_INFINITY) {
                total += 1;
            }
        }
        return total;
    }

    fn eccentricity(self) -> int {
        var best: int = 0;
        for (d in self.depth) {
            if (d < GRAPH_INFINITY and d > best) {
                best = d;
            }
        }
        return best;
    }

    // Walk the parent chain from `v` back to the root, then reverse it.
    fn path_to(self, v: int) -> vector(int) {
        var out = vector(int)();
        if (self.depth.at(v) >= GRAPH_INFINITY) {
            return out;
        }
        var walker = v;
        while (walker != GRAPH_NIL) {
            out.push_back(walker);
            walker = self.parent.at(walker);
        }
        reverse_int_vector(out);
        return out;
    }

    var parent: vector(int);
    var depth: vector(int);
    var order: vector(int);
    var payload: V;
    var source: int = -1;
    var complete: bool = true;
}

// Breadth first search from a single source.
//
// `depth` is measured in edges, not weights; a weighted shortest path wants
// `shortest_path::dijkstra` instead.
fn bfs[V: type, W: type]
    (g: AdjacencyList(V, W), source: int) -> SearchResult(V) {
    var out = SearchResult(V)({.source = source});
    fill_int_vector(out.parent, g.order(), GRAPH_NIL);
    fill_int_vector(out.depth, g.order(), GRAPH_INFINITY);
    if (g.valid_vertex(source) == false) {
        out.complete = false;
        return out;
    }
    var queue = vector(int)();
    queue.push_back(source);
    out.depth.at(source) = 0;
    var head: int = 0;
    while (head < queue.size()) {
        let v = queue.at(head);
        head += 1;
        out.order.push_back(v);
        for (e in g.vertices.at(v).incident) {
            let ref arc: auto = g.edges.at(e);
            if (arc.alive == false) {
                continue;
            }
            let next = arc.head;
            if (out.depth.at(next) >= GRAPH_INFINITY) {
                out.depth.at(next) = out.depth.at(v) + 1;
                out.parent.at(next) = v;
                queue.push_back(next);
            }
        }
    }
    Assert(out.depth.at(source) == 0);
    return out;
}

// The same search, but driving a visitor and honouring its verdicts.
fn bfs_visit[V: type, W: type]
    (g: AdjacencyList(V, W),
             source: int,
             ref watcher: Visitor(V, W)) -> SearchResult(V) {
    var out = SearchResult(V)({.source = source});
    fill_int_vector(out.parent, g.order(), GRAPH_NIL);
    fill_int_vector(out.depth, g.order(), GRAPH_INFINITY);
    watcher.prepare(g.order());
    var queue = vector(int)();
    queue.push_back(source);
    out.depth.at(source) = 0;
    var head: int = 0;
    while (head < queue.size()) {
        let v = queue.at(head);
        head += 1;
        let verdict = watcher.on_discover(v);
        if (verdict == VisitAction.StopTraversal) {
            out.complete = false;
            return out;
        }
        if (verdict == VisitAction.SkipChildren) {
            continue;
        }
        out.order.push_back(v);
        for (e in g.vertices.at(v).incident) {
            let ref arc: auto = g.edges.at(e);
            if (arc.alive == false) {
                continue;
            }
            let next = arc.head;
            if (out.depth.at(next) >= GRAPH_INFINITY) {
                Discard(watcher.on_edge(e, EdgeClass.TreeEdge));
                out.depth.at(next) = out.depth.at(v) + 1;
                out.parent.at(next) = v;
                queue.push_back(next);
            } else {
                Discard(watcher.on_edge(e, EdgeClass.CrossEdge));
            }
        }
        Discard(watcher.on_finish(v));
    }
    return out;
}

// Multi-source BFS: every source starts at depth zero.  Useful for "distance
// to the nearest hospital" style queries.
fn bfs_multi[V: type, W: type]
    (g: AdjacencyList(V, W),
             sources: vector(int)) -> SearchResult(V) {
    var out = SearchResult(V)({.source = GRAPH_NIL});
    fill_int_vector(out.parent, g.order(), GRAPH_NIL);
    fill_int_vector(out.depth, g.order(), GRAPH_INFINITY);
    var queue = vector(int)();
    for (s in sources) {
        if (out.depth.at(s) >= GRAPH_INFINITY) {
            out.depth.at(s) = 0;
            queue.push_back(s);
        }
    }
    var head: int = 0;
    while (head < queue.size()) {
        let v = queue.at(head);
        head += 1;
        out.order.push_back(v);
        for (e in g.vertices.at(v).incident) {
            let ref arc: auto = g.edges.at(e);
            if (arc.alive == false) {
                continue;
            }
            if (out.depth.at(arc.head) >= GRAPH_INFINITY) {
                out.depth.at(arc.head) = out.depth.at(v) + 1;
                out.parent.at(arc.head) = v;
                queue.push_back(arc.head);
            }
        }
    }
    return out;
}

// Group the vertices by their BFS depth.  Slot `i` of the result holds every
// vertex at distance exactly `i` from the source.
fn bfs_levels[V: type, W: type]
    (g: AdjacencyList(V, W),
              source: int) -> vector(vector(int)) {
    let found = bfs(V, W)(g, source);
    var levels = vector(vector(int))();
    let reach = found.eccentricity();
    var d: int = 0;
    while (d <= reach) {
        levels.push_back(vector(int)());
        d += 1;
    }
    var v: int = 0;
    while (v < g.order()) {
        let depth = found.depth.at(v);
        if (depth < GRAPH_INFINITY) {
            levels.at(depth).push_back(v);
        }
        v += 1;
    }
    return levels;
}

// Depth first search, expressed with an explicit stack of (vertex, cursor)
// pairs so that `on_finish` still fires in true post-order.
fn dfs[V: type, W: type]
    (g: AdjacencyList(V, W), source: int) -> SearchResult(V) {
    var out = SearchResult(V)({.source = source});
    fill_int_vector(out.parent, g.order(), GRAPH_NIL);
    fill_int_vector(out.depth, g.order(), GRAPH_INFINITY);
    var stack = vector(int)();
    var cursor = vector(int)();
    stack.push_back(source);
    cursor.push_back(0);
    out.depth.at(source) = 0;
    out.order.push_back(source);
    while (stack.empty() == false) {
        let v = stack.back();
        let at = cursor.back();
        let ref incident: auto = g.vertices.at(v).incident;
        if (at >= incident.size()) {
            stack.pop_back();
            cursor.pop_back();
            continue;
        }
        cursor.at(cursor.size() - 1) = at + 1;
        let ref arc: auto = g.edges.at(incident.at(at));
        if (arc.alive == false) {
            continue;
        }
        let next = arc.head;
        if (out.depth.at(next) >= GRAPH_INFINITY) {
            out.depth.at(next) = out.depth.at(v) + 1;
            out.parent.at(next) = v;
            out.order.push_back(next);
            stack.push_back(next);
            cursor.push_back(0);
        }
    }
    return out;
}

// Depth first search driving a visitor, with proper edge classification.
//
// An arc into a gray vertex is a back edge (and therefore evidence of a
// cycle); an arc into a black vertex is forward or cross depending on the
// discovery stamps.
fn dfs_visit[V: type, W: type]
    (g: AdjacencyList(V, W),
             source: int,
             ref watcher: Visitor(V, W)) -> SearchResult(V) {
    var out = SearchResult(V)({.source = source});
    fill_int_vector(out.parent, g.order(), GRAPH_NIL);
    fill_int_vector(out.depth, g.order(), GRAPH_INFINITY);
    var color = vector(int)();
    var entered = vector(int)();
    fill_int_vector(color, g.order(), 0);
    fill_int_vector(entered, g.order(), GRAPH_NIL);
    var stack = vector(int)();
    var cursor = vector(int)();
    var clock: int = 0;
    stack.push_back(source);
    cursor.push_back(0);
    color.at(source) = 1;
    entered.at(source) = clock;
    clock += 1;
    out.depth.at(source) = 0;
    Discard(watcher.on_discover(source));
    while (stack.empty() == false) {
        let v = stack.back();
        let at = cursor.back();
        let ref incident: auto = g.vertices.at(v).incident;
        if (at >= incident.size()) {
            color.at(v) = 2;
            Discard(watcher.on_finish(v));
            stack.pop_back();
            cursor.pop_back();
            continue;
        }
        cursor.at(cursor.size() - 1) = at + 1;
        let e = incident.at(at);
        let ref arc: auto = g.edges.at(e);
        if (arc.alive == false) {
            continue;
        }
        let next = arc.head;
        if (color.at(next) == 0) {
            Discard(watcher.on_edge(e, EdgeClass.TreeEdge));
            color.at(next) = 1;
            entered.at(next) = clock;
            clock += 1;
            out.parent.at(next) = v;
            out.depth.at(next) = out.depth.at(v) + 1;
            let verdict = watcher.on_discover(next);
            if (verdict == VisitAction.StopTraversal) {
                out.complete = false;
                return out;
            }
            if (verdict == VisitAction.Continue) {
                stack.push_back(next);
                cursor.push_back(0);
            }
        } else {
            if (color.at(next) == 1) {
                Discard(watcher.on_edge(e, EdgeClass.BackEdge));
            } else {
                if (entered.at(v) < entered.at(next)) {
                    Discard(watcher.on_edge(e, EdgeClass.ForwardEdge));
                } else {
                    Discard(watcher.on_edge(e, EdgeClass.CrossEdge));
                }
            }
        }
    }
    return out;
}

// Run a depth first search from every undiscovered vertex, producing the
// full DFS forest and restarting the visitor's root list as it goes.
fn dfs_forest[V: type, W: type]
    (g: AdjacencyList(V, W),
              ref watcher: Visitor(V, W)) -> vector(int) {
    var parent = vector(int)();
    fill_int_vector(parent, g.order(), GRAPH_NIL);
    var seen = vector(bool)();
    fill_bool_vector(seen, g.order(), false);
    watcher.prepare(g.order());
    var v: int = 0;
    while (v < g.order()) {
        if (seen.at(v) == false) {
            watcher.on_restart(v);
            let tree = dfs(V, W)(g, v);
            for (u in tree.order) {
                if (seen.at(u) == false) {
                    seen.at(u) = true;
                    parent.at(u) = tree.parent.at(u);
                }
            }
        }
        v += 1;
    }
    return parent;
}

// Post-order finishing times over the whole graph, the ingredient Kosaraju
// and the DFS topological sort both need.
fn finish_order[V: type, W: type]
    (g: AdjacencyList(V, W)) -> vector(int) {
    var out = vector(int)();
    var color = vector(int)();
    fill_int_vector(color, g.order(), 0);
    var stack = vector(int)();
    var cursor = vector(int)();
    var root: int = 0;
    while (root < g.order()) {
        if (color.at(root) == 0) {
            stack.push_back(root);
            cursor.push_back(0);
            color.at(root) = 1;
            while (stack.empty() == false) {
                let v = stack.back();
                let at = cursor.back();
                let ref incident: auto = g.vertices.at(v).incident;
                if (at >= incident.size()) {
                    color.at(v) = 2;
                    out.push_back(v);
                    stack.pop_back();
                    cursor.pop_back();
                    continue;
                }
                cursor.at(cursor.size() - 1) = at + 1;
                let ref arc: auto = g.edges.at(incident.at(at));
                if (arc.alive and color.at(arc.head) == 0) {
                    color.at(arc.head) = 1;
                    stack.push_back(arc.head);
                    cursor.push_back(0);
                }
            }
        }
        root += 1;
    }
    return out;
}

// Every vertex reachable from `source`, as a set.
fn reachable_from[V: type, W: type]
    (g: AdjacencyList(V, W), source: int) -> set(int) {
    let found = bfs(V, W)(g, source);
    var out = set(int)();
    var v: int = 0;
    while (v < g.order()) {
        if (found.depth.at(v) < GRAPH_INFINITY) {
            Discard(out.insert(v));
        }
        v += 1;
    }
    return out;
}

// Shortest *hop* count between two vertices, or `GRAPH_INFINITY`.
fn hop_distance[V: type, W: type]
    (g: AdjacencyList(V, W),
                source: int,
                target: int) -> int {
    let found = bfs(V, W)(g, source);
    return found.depth.at(target);
}

// The vertex sequence of one shortest hop path, empty when unreachable.
fn hop_path[V: type, W: type]
    (g: AdjacencyList(V, W),
            source: int,
            target: int) -> vector(int) {
    let found = bfs(V, W)(g, source);
    return found.path_to(target);
}



// ==========================================================================
// graph::connectivity
//
// Everything that answers a question about how the graph hangs together:
// components, orderings, cycles, cut vertices and two-colourings.
// ==========================================================================
namespace connectivity;

// The labelling produced by a component decomposition.
class Components(V: type)
{

    fn count(self) -> int {
        return self.total;
    }

    fn same(self, a: int, b: int) -> bool {
        return self.label.at(a) == self.label.at(b);
    }

    fn size_of(self, component: int) -> int {
        var total: int = 0;
        for (l in self.label) {
            if (l == component) {
                total += 1;
            }
        }
        return total;
    }

    fn largest(self) -> int {
        var best: int = 0;
        var best_size: int = 0;
        var c: int = 0;
        while (c < self.total) {
            let n = self.size_of(c);
            if (n > best_size) {
                best_size = n;
                best = c;
            }
            c += 1;
        }
        return best;
    }

    // Regroup the flat labelling into one vector of members per component.
    fn buckets(self) -> vector(vector(int)) {
        var out = vector(vector(int))();
        var c: int = 0;
        while (c < self.total) {
            out.push_back(vector(int)());
            c += 1;
        }
        var v: int = 0;
        while (v < self.label.size()) {
            let l = self.label.at(v);
            if (l != GRAPH_NIL) {
                out.at(l).push_back(v);
            }
            v += 1;
        }
        return out;
    }

    var label: vector(int);
    var payload: V;
    var total: int = 0;
}

// Undirected connected components, found with repeated breadth first search.
fn connected_components[V: type, W: type]
    (g: AdjacencyList(V, W)) -> Components(V) {
    var out = Components(V)();
    fill_int_vector(out.label, g.order(), GRAPH_NIL);
    var next: int = 0;
    var root: int = 0;
    while (root < g.order()) {
        if (out.label.at(root) == GRAPH_NIL) {
            var queue = vector(int)();
            queue.push_back(root);
            out.label.at(root) = next;
            var head: int = 0;
            while (head < queue.size()) {
                let v = queue.at(head);
                head += 1;
                for (e in g.vertices.at(v).incident) {
                    let ref arc: auto = g.edges.at(e);
                    if (arc.alive and out.label.at(arc.head) == GRAPH_NIL) {
                        out.label.at(arc.head) = next;
                        queue.push_back(arc.head);
                    }
                }
            }
            next += 1;
        }
        root += 1;
    }
    out.total = next;
    return out;
}

// The same decomposition, computed with a union-find instead.  Cheaper when
// the caller already has to merge sets for another reason.
fn components_by_union[V: type, W: type]
    (g: AdjacencyList(V, W)) -> Components(V) {
    var forest = UnionFind();
    forest.prepare(g.order());
    for (arc in g.edges) {
        if (arc.alive) {
            Discard(forest.unite(arc.tail, arc.head));
        }
    }
    var out = Components(V)();
    fill_int_vector(out.label, g.order(), GRAPH_NIL);
    var next: int = 0;
    var v: int = 0;
    while (v < g.order()) {
        let root = forest.find(v);
        if (out.label.at(root) == GRAPH_NIL) {
            out.label.at(root) = next;
            next += 1;
        }
        out.label.at(v) = out.label.at(root);
        v += 1;
    }
    out.total = next;
    return out;
}

fn component_count[V: type, W: type]
    (g: AdjacencyList(V, W)) -> int {
    let found = connected_components(V, W)(g);
    return found.total;
}

fn is_connected[V: type, W: type]
    (g: AdjacencyList(V, W)) -> bool {
    if (g.order() == 0) {
        return true;
    }
    return component_count(V, W)(g) == 1;
}

// A tree is a connected acyclic graph, i.e. connected with exactly n-1 edges.
fn is_tree[V: type, W: type]
    (g: AdjacencyList(V, W)) -> bool {
    if (is_connected(V, W)(g) == false) {
        return false;
    }
    return g.size() == g.order() - 1;
}

// --- Topological ordering -------------------------------------------------

// The answer to an ordering request.
class Ordering(V: type)
{

    fn valid(self) -> bool {
        return self.status == OrderStatus.TotalOrder;
    }

    fn length(self) -> int {
        return self.sequence.size();
    }

    // Position of each vertex in the order, or NIL when it was never placed.
    fn ranks(self, order: int) -> vector(int) {
        var out = vector(int)();
        fill_int_vector(out, order, GRAPH_NIL);
        var i: int = 0;
        while (i < self.sequence.size()) {
            out.at(self.sequence.at(i)) = i;
            i += 1;
        }
        return out;
    }

    var sequence: vector(int);
    var payload: V;
    var status: OrderStatus = OrderStatus.TotalOrder;
}

// Kahn's algorithm: repeatedly emit a vertex of in-degree zero.
//
// When the queue empties before every vertex has been emitted, the leftovers
// all sit on cycles and the status is set accordingly.
fn topological_sort_kahn[V: type, W: type]
    (g: AdjacencyList(V, W)) -> Ordering(V) {
    var out = Ordering(V)();
    var indegree = vector(int)();
    fill_int_vector(indegree, g.order(), 0);
    for (arc in g.edges) {
        if (arc.alive) {
            indegree.at(arc.head) += 1;
        }
    }
    var queue = vector(int)();
    var v: int = 0;
    while (v < g.order()) {
        if (indegree.at(v) == 0) {
            queue.push_back(v);
        }
        v += 1;
    }
    var head: int = 0;
    while (head < queue.size()) {
        let u = queue.at(head);
        head += 1;
        out.sequence.push_back(u);
        for (e in g.vertices.at(u).incident) {
            let ref arc: auto = g.edges.at(e);
            if (arc.alive == false) {
                continue;
            }
            indegree.at(arc.head) -= 1;
            if (indegree.at(arc.head) == 0) {
                queue.push_back(arc.head);
            }
        }
    }
    if (out.sequence.size() != g.order()) {
        out.status = OrderStatus.CycleFound;
    }
    return out;
}

// The lexicographically smallest topological order, obtained by feeding
// Kahn's frontier through a min-heap instead of a plain queue.
fn topological_sort_smallest[V: type, W: type]
    (g: AdjacencyList(V, W)) -> Ordering(V) {
    var out = Ordering(V)();
    var indegree = vector(int)();
    fill_int_vector(indegree, g.order(), 0);
    for (arc in g.edges) {
        if (arc.alive) {
            indegree.at(arc.head) += 1;
        }
    }
    var frontier = BinaryHeap();
    frontier.prepare(g.order());
    var v: int = 0;
    while (v < g.order()) {
        if (indegree.at(v) == 0) {
            frontier.push(v, v);
        }
        v += 1;
    }
    while (frontier.empty() == false) {
        let top = frontier.pop();
        out.sequence.push_back(top.vertex);
        for (e in g.vertices.at(top.vertex).incident) {
            let ref arc: auto = g.edges.at(e);
            if (arc.alive == false) {
                continue;
            }
            indegree.at(arc.head) -= 1;
            if (indegree.at(arc.head) == 0) {
                frontier.push(arc.head, arc.head);
            }
        }
    }
    if (out.sequence.size() != g.order()) {
        out.status = OrderStatus.CycleFound;
    }
    return out;
}

// The depth first variant: reverse post-order finishing times.
//
// Cheaper than Kahn by a constant factor because no in-degree array is built,
// but it cannot report *which* vertices form the cycle, only that one exists.
fn topological_sort_dfs[V: type, W: type]
    (g: AdjacencyList(V, W)) -> Ordering(V) {
    var out = Ordering(V)();
    let finished = traversal.finish_order(V, W)(g);
    var i = finished.size() - 1;
    while (i >= 0) {
        out.sequence.push_back(finished.at(i));
        i -= 1;
    }
    if (has_directed_cycle(V, W)(g)) {
        out.status = OrderStatus.CycleFound;
    }
    return out;
}

// --- Cycles ---------------------------------------------------------------

// Directed cycle detection via three-colour depth first search.
fn has_directed_cycle[V: type, W: type]
    (g: AdjacencyList(V, W)) -> bool {
    var color = vector(int)();
    fill_int_vector(color, g.order(), 0);
    var stack = vector(int)();
    var cursor = vector(int)();
    var root: int = 0;
    while (root < g.order()) {
        if (color.at(root) == 0) {
            stack.push_back(root);
            cursor.push_back(0);
            color.at(root) = 1;
            while (stack.empty() == false) {
                let v = stack.back();
                let at = cursor.back();
                let ref incident: auto = g.vertices.at(v).incident;
                if (at >= incident.size()) {
                    color.at(v) = 2;
                    stack.pop_back();
                    cursor.pop_back();
                    continue;
                }
                cursor.at(cursor.size() - 1) = at + 1;
                let ref arc: auto = g.edges.at(incident.at(at));
                if (arc.alive == false) {
                    continue;
                }
                if (color.at(arc.head) == 1) {
                    return true;
                }
                if (color.at(arc.head) == 0) {
                    color.at(arc.head) = 1;
                    stack.push_back(arc.head);
                    cursor.push_back(0);
                }
            }
        }
        root += 1;
    }
    return false;
}

// Undirected cycle detection.  A union-find is the shortest correct answer:
// the first edge whose endpoints already share a root closes a cycle.
fn has_undirected_cycle[V: type, W: type]
    (g: AdjacencyList(V, W)) -> bool {
    var forest = UnionFind();
    forest.prepare(g.order());
    for (arc in g.edges) {
        if (arc.alive and arc.tail < arc.head) {
            if (forest.unite(arc.tail, arc.head) == false) {
                return true;
            }
        }
    }
    return false;
}

// Recover one directed cycle as a vertex sequence, or an empty vector.
fn find_directed_cycle[V: type, W: type]
    (g: AdjacencyList(V, W)) -> vector(int) {
    var color = vector(int)();
    var parent = vector(int)();
    fill_int_vector(color, g.order(), 0);
    fill_int_vector(parent, g.order(), GRAPH_NIL);
    var found = vector(int)();
    var stack = vector(int)();
    var cursor = vector(int)();
    var root: int = 0;
    while (root < g.order()) {
        if (color.at(root) == 0) {
            stack.push_back(root);
            cursor.push_back(0);
            color.at(root) = 1;
            while (stack.empty() == false) {
                let v = stack.back();
                let at = cursor.back();
                let ref incident: auto = g.vertices.at(v).incident;
                if (at >= incident.size()) {
                    color.at(v) = 2;
                    stack.pop_back();
                    cursor.pop_back();
                    continue;
                }
                cursor.at(cursor.size() - 1) = at + 1;
                let ref arc: auto = g.edges.at(incident.at(at));
                if (arc.alive == false) {
                    continue;
                }
                if (color.at(arc.head) == 1) {
                    var walker = v;
                    while (walker != arc.head and walker != GRAPH_NIL) {
                        found.push_back(walker);
                        walker = parent.at(walker);
                    }
                    found.push_back(arc.head);
                    reverse_int_vector(found);
                    return found;
                }
                if (color.at(arc.head) == 0) {
                    color.at(arc.head) = 1;
                    parent.at(arc.head) = v;
                    stack.push_back(arc.head);
                    cursor.push_back(0);
                }
            }
        }
        root += 1;
    }
    return found;
}

fn is_acyclic[V: type, W: type]
    (g: AdjacencyList(V, W)) -> bool {
    if (g.is_directed()) {
        return has_directed_cycle(V, W)(g) == false;
    }
    return has_undirected_cycle(V, W)(g) == false;
}

// --- Strongly connected components ----------------------------------------

// Scratch state for the iterative Tarjan pass.
//
// Tarjan is normally written recursively; the loop below keeps the call frame
// in `frames` and `cursor` so that a million-vertex graph does not need a
// million native stack frames.
class TarjanState {

    fn prepare(ref self, order: int) {
        fill_int_vector(self.index, order, GRAPH_NIL);
        fill_int_vector(self.low, order, GRAPH_NIL);
        fill_bool_vector(self.on_stack, order, false);
        self.pending.clear();
        self.frames.clear();
        self.cursor.clear();
        self.clock = 0;
        self.total = 0;
    }

    fn visited(self, v: int) -> bool {
        return self.index.at(v) != GRAPH_NIL;
    }

    fn enter(ref self, v: int) {
        self.index.at(v) = self.clock;
        self.low.at(v) = self.clock;
        self.clock += 1;
        self.pending.push_back(v);
        self.on_stack.at(v) = true;
    }

    // Pop one component off the pending stack, down to and including `root`.
    fn close(ref self, root: int, ref label: vector(int)) -> int {
        var members: int = 0;
        while (true) {
            let top = self.pending.back();
            self.pending.pop_back();
            self.on_stack.at(top) = false;
            label.at(top) = self.total;
            members += 1;
            if (top == root) {
                break;
            }
        }
        self.total += 1;
        return members;
    }

    var index: vector(int);
    var low: vector(int);
    var on_stack: vector(bool);
    var pending: vector(int);
    var frames: vector(int);
    var cursor: vector(int);
    var clock: int = 0;
    var total: int = 0;
}

// Tarjan's strongly connected components, one depth first pass.
//
// The component labels come out in reverse topological order of the
// condensation, which is exactly what `condensation` relies on.
fn tarjan_scc[V: type, W: type]
    (g: AdjacencyList(V, W)) -> Components(V) {
    var out = Components(V)();
    fill_int_vector(out.label, g.order(), GRAPH_NIL);
    var state = TarjanState();
    state.prepare(g.order());
    var root: int = 0;
    while (root < g.order()) {
        if (state.visited(root) == false) {
            state.enter(root);
            state.frames.push_back(root);
            state.cursor.push_back(0);
            while (state.frames.empty() == false) {
                let v = state.frames.back();
                let at = state.cursor.back();
                let ref incident: auto = g.vertices.at(v).incident;
                if (at < incident.size()) {
                    state.cursor.at(state.cursor.size() - 1) = at + 1;
                    let ref arc: auto = g.edges.at(incident.at(at));
                    if (arc.alive == false) {
                        continue;
                    }
                    let next = arc.head;
                    if (state.visited(next) == false) {
                        state.enter(next);
                        state.frames.push_back(next);
                        state.cursor.push_back(0);
                    } else {
                        if (state.on_stack.at(next)) {
                            if (state.index.at(next) < state.low.at(v)) {
                                state.low.at(v) = state.index.at(next);
                            }
                        }
                    }
                } else {
                    state.frames.pop_back();
                    state.cursor.pop_back();
                    if (state.low.at(v) == state.index.at(v)) {
                        Discard(state.close(v, out.label));
                    }
                    if (state.frames.empty() == false) {
                        let up = state.frames.back();
                        if (state.low.at(v) < state.low.at(up)) {
                            state.low.at(up) = state.low.at(v);
                        }
                    }
                }
            }
        }
        root += 1;
    }
    out.total = state.total;
    return out;
}

// Kosaraju's two-pass alternative: finishing times on `g`, then components on
// the transpose visited in decreasing finishing time.
//
// Slower than Tarjan by a constant factor because it builds the transpose,
// but far easier to convince yourself of.
fn kosaraju_scc[V: type, W: type]
    (g: AdjacencyList(V, W)) -> Components(V) {
    let finished = traversal.finish_order(V, W)(g);
    let reversed = builders.transpose(V, W)(g);
    var out = Components(V)();
    fill_int_vector(out.label, g.order(), GRAPH_NIL);
    var next: int = 0;
    var i = finished.size() - 1;
    while (i >= 0) {
        let root = finished.at(i);
        i -= 1;
        if (out.label.at(root) != GRAPH_NIL) {
            continue;
        }
        var stack = vector(int)();
        stack.push_back(root);
        out.label.at(root) = next;
        while (stack.empty() == false) {
            let v = stack.back();
            stack.pop_back();
            for (e in reversed.vertices.at(v).incident) {
                let ref arc: auto = reversed.edges.at(e);
                if (arc.alive and out.label.at(arc.head) == GRAPH_NIL) {
                    out.label.at(arc.head) = next;
                    stack.push_back(arc.head);
                }
            }
        }
        next += 1;
    }
    out.total = next;
    return out;
}

// Collapse every strongly connected component to a single vertex.  The result
// is always a directed acyclic graph.
fn condensation[V: type, W: type]
    (g: AdjacencyList(V, W),
                parts: Components(V)) -> AdjacencyList(V, W) {
    var out = builders.directed(V, W)(parts.total);
    for (arc in g.edges) {
        if (arc.alive == false) {
            continue;
        }
        let a = parts.label.at(arc.tail);
        let b = parts.label.at(arc.head);
        if (a != b) {
            if (out.has_edge(a, b) == false) {
                Discard(out.connect(a, b, arc.weight));
            }
        }
    }
    Assert(is_acyclic(V, W)(out));
    return out;
}

fn is_strongly_connected[V: type, W: type]
    (g: AdjacencyList(V, W)) -> bool {
    if (g.order() == 0) {
        return true;
    }
    let parts = tarjan_scc(V, W)(g);
    return parts.total == 1;
}

// --- Bridges and articulation points --------------------------------------

// The output of one low-link pass over an undirected graph.
class CutInfo(V: type)
{

    fn bridge_count(self) -> int {
        return self.bridges.size();
    }

    fn is_articulation(self, v: int) -> bool {
        return self.articulation.at(v);
    }

    fn articulation_list(self) -> vector(int) {
        var out = vector(int)();
        var v: int = 0;
        while (v < self.articulation.size()) {
            if (self.articulation.at(v)) {
                out.push_back(v);
            }
            v += 1;
        }
        return out;
    }

    var bridges: vector(int);
    var articulation: vector(bool);
    var low: vector(int);
    var discovery: vector(int);
    var payload: V;
}

// Find every bridge and every articulation point in one iterative low-link
// depth first search.
//
// An arc (u, v) is a bridge when `low[v] > discovery[u]`; `u` is an
// articulation point when it is the root with two or more children, or a
// non-root with a child satisfying `low[v] >= discovery[u]`.
fn find_cuts[V: type, W: type]
    (g: AdjacencyList(V, W)) -> CutInfo(V) {
    var out = CutInfo(V)();
    fill_int_vector(out.low, g.order(), GRAPH_NIL);
    fill_int_vector(out.discovery, g.order(), GRAPH_NIL);
    fill_bool_vector(out.articulation, g.order(), false);
    var parent_arc = vector(int)();
    fill_int_vector(parent_arc, g.order(), GRAPH_NIL);
    var children = vector(int)();
    fill_int_vector(children, g.order(), 0);
    var stack = vector(int)();
    var cursor = vector(int)();
    var clock: int = 0;
    var root: int = 0;
    while (root < g.order()) {
        if (out.discovery.at(root) != GRAPH_NIL) {
            root += 1;
            continue;
        }
        out.discovery.at(root) = clock;
        out.low.at(root) = clock;
        clock += 1;
        stack.push_back(root);
        cursor.push_back(0);
        while (stack.empty() == false) {
            let v = stack.back();
            let at = cursor.back();
            let ref incident: auto = g.vertices.at(v).incident;
            if (at < incident.size()) {
                cursor.at(cursor.size() - 1) = at + 1;
                let e = incident.at(at);
                let ref arc: auto = g.edges.at(e);
                if (arc.alive == false) {
                    continue;
                }
                if (e == parent_arc.at(v) ^ 1 and parent_arc.at(v) != GRAPH_NIL) {
                    continue;
                }
                let next = arc.head;
                if (out.discovery.at(next) == GRAPH_NIL) {
                    parent_arc.at(next) = e;
                    children.at(v) += 1;
                    out.discovery.at(next) = clock;
                    out.low.at(next) = clock;
                    clock += 1;
                    stack.push_back(next);
                    cursor.push_back(0);
                } else {
                    if (out.discovery.at(next) < out.low.at(v)) {
                        out.low.at(v) = out.discovery.at(next);
                    }
                }
            } else {
                stack.pop_back();
                cursor.pop_back();
                if (stack.empty() == false) {
                    let up = stack.back();
                    if (out.low.at(v) < out.low.at(up)) {
                        out.low.at(up) = out.low.at(v);
                    }
                    if (out.low.at(v) > out.discovery.at(up)) {
                        out.bridges.push_back(parent_arc.at(v));
                    }
                    if (up != root and out.low.at(v) >= out.discovery.at(up)) {
                        out.articulation.at(up) = true;
                    }
                }
            }
        }
        if (children.at(root) > 1) {
            out.articulation.at(root) = true;
        }
        root += 1;
    }
    return out;
}

fn bridges[V: type, W: type]
    (g: AdjacencyList(V, W)) -> vector(int) {
    let cuts = find_cuts(V, W)(g);
    return cuts.bridges;
}

fn articulation_points[V: type, W: type]
    (g: AdjacencyList(V, W)) -> vector(int) {
    let cuts = find_cuts(V, W)(g);
    return cuts.articulation_list();
}

// A graph is two-edge-connected when it is connected and has no bridge.
fn is_two_edge_connected[V: type, W: type]
    (g: AdjacencyList(V, W)) -> bool {
    if (is_connected(V, W)(g) == false) {
        return false;
    }
    let cuts = find_cuts(V, W)(g);
    return cuts.bridges.empty();
}

// --- Bipartiteness --------------------------------------------------------

// Try to two-colour the graph.  On success every vertex carries a side; on
// failure `sides` is left partially filled and the witness edge is recorded.
class Coloring(V: type)
{

    fn bipartite(self) -> bool {
        return self.conflict == GRAPH_NIL;
    }

    fn side_of(self, v: int) -> Side {
        return self.sides.at(v);
    }

    fn left_vertices(self) -> vector(int) {
        var out = vector(int)();
        var v: int = 0;
        while (v < self.sides.size()) {
            if (self.sides.at(v) == Side.LeftSide) {
                out.push_back(v);
            }
            v += 1;
        }
        return out;
    }

    fn right_vertices(self) -> vector(int) {
        var out = vector(int)();
        var v: int = 0;
        while (v < self.sides.size()) {
            if (self.sides.at(v) == Side.RightSide) {
                out.push_back(v);
            }
            v += 1;
        }
        return out;
    }

    var sides: vector(Side);
    var payload: V;
    var conflict: int = -1;
}

// Breadth first two-colouring, one component at a time.
fn two_coloring[V: type, W: type]
    (g: AdjacencyList(V, W)) -> Coloring(V) {
    var out = Coloring(V)();
    out.sides.clear();
    var i: int = 0;
    while (i < g.order()) {
        out.sides.push_back(Side.Unassigned);
        i += 1;
    }
    var root: int = 0;
    while (root < g.order()) {
        if (out.sides.at(root) != Side.Unassigned) {
            root += 1;
            continue;
        }
        out.sides.at(root) = Side.LeftSide;
        var queue = vector(int)();
        queue.push_back(root);
        var head: int = 0;
        while (head < queue.size()) {
            let v = queue.at(head);
            head += 1;
            for (e in g.vertices.at(v).incident) {
                let ref arc: auto = g.edges.at(e);
                if (arc.alive == false) {
                    continue;
                }
                let next = arc.head;
                if (out.sides.at(next) == Side.Unassigned) {
                    if (out.sides.at(v) == Side.LeftSide) {
                        out.sides.at(next) = Side.RightSide;
                    } else {
                        out.sides.at(next) = Side.LeftSide;
                    }
                    queue.push_back(next);
                } else {
                    if (out.sides.at(next) == out.sides.at(v)) {
                        out.conflict = e;
                        return out;
                    }
                }
            }
        }
        root += 1;
    }
    return out;
}

fn is_bipartite[V: type, W: type]
    (g: AdjacencyList(V, W)) -> bool {
    let colors = two_coloring(V, W)(g);
    return colors.bipartite();
}

// An odd cycle, which exists exactly when the graph is not bipartite.
fn odd_cycle_witness[V: type, W: type]
    (g: AdjacencyList(V, W)) -> vector(int) {
    let colors = two_coloring(V, W)(g);
    var out = vector(int)();
    if (colors.bipartite()) {
        return out;
    }
    let ref arc: auto = g.edges.at(colors.conflict);
    let left = traversal.hop_path(V, W)(g, arc.tail, arc.head);
    for (v in left) {
        out.push_back(v);
    }
    return out;
}



// ==========================================================================
// graph::shortest_path
//
// Single source and all pairs shortest paths.  Every distance in this
// namespace is a fixed point value scaled by `WEIGHT_SCALE`, and
// `GRAPH_INFINITY` means "no path".
// ==========================================================================
namespace shortest_path;

// The result of a single source computation.
class Distances(V: type)
{

    fn reachable(self, v: int) -> bool {
        return self.dist.at(v) < GRAPH_INFINITY;
    }

    fn to(self, v: int) -> int {
        return self.dist.at(v);
    }

    // The vertex sequence of one optimal path, empty when unreachable.
    fn path_to(self, v: int) -> vector(int) {
        var out = vector(int)();
        if (self.dist.at(v) >= GRAPH_INFINITY) {
            return out;
        }
        var walker = v;
        while (walker != GRAPH_NIL) {
            out.push_back(walker);
            walker = self.parent.at(walker);
        }
        reverse_int_vector(out);
        return out;
    }

    // The arc ids along that path, which is what a router actually wants.
    fn arcs_to(self, v: int) -> vector(int) {
        var out = vector(int)();
        var walker = v;
        while (walker != GRAPH_NIL and self.parent_arc.at(walker) != GRAPH_NIL) {
            out.push_back(self.parent_arc.at(walker));
            walker = self.parent.at(walker);
        }
        reverse_int_vector(out);
        return out;
    }

    fn farthest(self) -> int {
        var best = GRAPH_NIL;
        var best_dist: int = -1;
        var v: int = 0;
        while (v < self.dist.size()) {
            let d = self.dist.at(v);
            if (d < GRAPH_INFINITY and d > best_dist) {
                best_dist = d;
                best = v;
            }
            v += 1;
        }
        return best;
    }

    fn total_reachable(self) -> int {
        var total: int = 0;
        for (d in self.dist) {
            if (d < GRAPH_INFINITY) {
                total += 1;
            }
        }
        return total;
    }

    var dist: vector(int);
    var parent: vector(int);
    var parent_arc: vector(int);
    var payload: V;
    var source: int = -1;
    var negative_cycle: bool = false;
    var relaxations: int = 0;
}

// Dijkstra's algorithm over the tracked binary heap.
//
// Requires every weight to be non-negative; `bellman_ford` handles the rest.
// The `decrease_key` form is used rather than the lazy "push duplicates"
// form, so the heap never grows past `order` entries.
fn dijkstra[V: type, W: type]
    (g: AdjacencyList(V, W), source: int) -> Distances(V) {
    var out = Distances(V)({.source = source});
    fill_int_vector(out.dist, g.order(), GRAPH_INFINITY);
    fill_int_vector(out.parent, g.order(), GRAPH_NIL);
    fill_int_vector(out.parent_arc, g.order(), GRAPH_NIL);
    if (g.valid_vertex(source) == false) {
        return out;
    }
    var settled = vector(bool)();
    fill_bool_vector(settled, g.order(), false);
    var frontier = BinaryHeap();
    frontier.prepare(g.order());
    out.dist.at(source) = 0;
    frontier.push(source, 0);
    while (frontier.empty() == false) {
        let top = frontier.pop();
        let v = top.vertex;
        if (settled.at(v)) {
            continue;
        }
        settled.at(v) = true;
        for (e in g.vertices.at(v).incident) {
            let ref arc: auto = g.edges.at(e);
            if (arc.alive == false) {
                continue;
            }
            Assert(arc.weight >= 0);
            let candidate = add_distance(out.dist.at(v), arc.weight);
            if (candidate < out.dist.at(arc.head)) {
                out.dist.at(arc.head) = candidate;
                out.parent.at(arc.head) = v;
                out.parent_arc.at(arc.head) = e;
                out.relaxations += 1;
                Discard(frontier.decrease_key(arc.head, candidate));
            }
        }
    }
    Prove(out.dist.at(source) == 0);
    return out;
}

// Dijkstra that stops as soon as `target` is settled.  On a large graph with
// a nearby target this is the difference between milliseconds and seconds.
fn dijkstra_to[V: type, W: type]
    (g: AdjacencyList(V, W),
               source: int,
               target: int) -> Distances(V) {
    var out = Distances(V)({.source = source});
    fill_int_vector(out.dist, g.order(), GRAPH_INFINITY);
    fill_int_vector(out.parent, g.order(), GRAPH_NIL);
    fill_int_vector(out.parent_arc, g.order(), GRAPH_NIL);
    var settled = vector(bool)();
    fill_bool_vector(settled, g.order(), false);
    var frontier = BinaryHeap();
    frontier.prepare(g.order());
    out.dist.at(source) = 0;
    frontier.push(source, 0);
    while (frontier.empty() == false) {
        let top = frontier.pop();
        let v = top.vertex;
        if (v == target) {
            return out;
        }
        if (settled.at(v)) {
            continue;
        }
        settled.at(v) = true;
        for (e in g.vertices.at(v).incident) {
            let ref arc: auto = g.edges.at(e);
            if (arc.alive == false) {
                continue;
            }
            let candidate = add_distance(out.dist.at(v), arc.weight);
            if (candidate < out.dist.at(arc.head)) {
                out.dist.at(arc.head) = candidate;
                out.parent.at(arc.head) = v;
                out.parent_arc.at(arc.head) = e;
                Discard(frontier.decrease_key(arc.head, candidate));
            }
        }
    }
    return out;
}

// The cheapest path between two vertices as a vertex sequence.
fn shortest_route[V: type, W: type]
    (g: AdjacencyList(V, W),
                  source: int,
                  target: int) -> vector(int) {
    let found = dijkstra_to(V, W)(g, source, target);
    return found.path_to(target);
}

// Bellman-Ford: `order - 1` full relaxation rounds, then one more to detect a
// negative cycle.  Handles negative weights, unlike Dijkstra.
fn bellman_ford[V: type, W: type]
    (g: AdjacencyList(V, W), source: int) -> Distances(V) {
    var out = Distances(V)({.source = source});
    fill_int_vector(out.dist, g.order(), GRAPH_INFINITY);
    fill_int_vector(out.parent, g.order(), GRAPH_NIL);
    fill_int_vector(out.parent_arc, g.order(), GRAPH_NIL);
    if (g.valid_vertex(source) == false) {
        return out;
    }
    out.dist.at(source) = 0;
    var rounds: int = 0;
    let limit = min(g.order() - 1, GRAPH_RELAX_LIMIT);
    while (rounds < limit) {
        var changed = false;
        var e: int = 0;
        while (e < g.edges.size()) {
            let ref arc: auto = g.edges.at(e);
            if (arc.alive and out.dist.at(arc.tail) < GRAPH_INFINITY) {
                let candidate = add_distance(out.dist.at(arc.tail), arc.weight);
                if (candidate < out.dist.at(arc.head)) {
                    out.dist.at(arc.head) = candidate;
                    out.parent.at(arc.head) = arc.tail;
                    out.parent_arc.at(arc.head) = e;
                    out.relaxations += 1;
                    changed = true;
                }
            }
            e += 1;
        }
        if (changed == false) {
            return out;
        }
        rounds += 1;
    }
    var e: int = 0;
    while (e < g.edges.size()) {
        let ref arc: auto = g.edges.at(e);
        if (arc.alive and out.dist.at(arc.tail) < GRAPH_INFINITY) {
            if (add_distance(out.dist.at(arc.tail), arc.weight) < out.dist.at(arc.head)) {
                out.negative_cycle = true;
                return out;
            }
        }
        e += 1;
    }
    return out;
}

fn has_negative_cycle[V: type, W: type]
    (g: AdjacencyList(V, W)) -> bool {
    var v: int = 0;
    while (v < g.order()) {
        let found = bellman_ford(V, W)(g, v);
        if (found.negative_cycle) {
            return true;
        }
        v += 1;
    }
    return false;
}

// SPFA, the queue-driven refinement of Bellman-Ford.  Same worst case, much
// better behaviour on the sparse graphs this library is aimed at.
fn spfa[V: type, W: type]
    (g: AdjacencyList(V, W), source: int) -> Distances(V) {
    var out = Distances(V)({.source = source});
    fill_int_vector(out.dist, g.order(), GRAPH_INFINITY);
    fill_int_vector(out.parent, g.order(), GRAPH_NIL);
    fill_int_vector(out.parent_arc, g.order(), GRAPH_NIL);
    var queued = vector(bool)();
    var pushes = vector(int)();
    fill_bool_vector(queued, g.order(), false);
    fill_int_vector(pushes, g.order(), 0);
    var queue = vector(int)();
    out.dist.at(source) = 0;
    queue.push_back(source);
    queued.at(source) = true;
    var head: int = 0;
    while (head < queue.size()) {
        let v = queue.at(head);
        head += 1;
        queued.at(v) = false;
        for (e in g.vertices.at(v).incident) {
            let ref arc: auto = g.edges.at(e);
            if (arc.alive == false) {
                continue;
            }
            let candidate = add_distance(out.dist.at(v), arc.weight);
            if (candidate < out.dist.at(arc.head)) {
                out.dist.at(arc.head) = candidate;
                out.parent.at(arc.head) = v;
                out.parent_arc.at(arc.head) = e;
                if (queued.at(arc.head) == false) {
                    queued.at(arc.head) = true;
                    pushes.at(arc.head) += 1;
                    if (pushes.at(arc.head) > g.order()) {
                        out.negative_cycle = true;
                        return out;
                    }
                    queue.push_back(arc.head);
                }
            }
        }
    }
    return out;
}

// Shortest paths on a directed acyclic graph, in linear time: relax the arcs
// in topological order and every distance is final on first sight.
fn dag_shortest_path[V: type, W: type]
    (g: AdjacencyList(V, W),
                     source: int) -> Distances(V) {
    var out = Distances(V)({.source = source});
    fill_int_vector(out.dist, g.order(), GRAPH_INFINITY);
    fill_int_vector(out.parent, g.order(), GRAPH_NIL);
    fill_int_vector(out.parent_arc, g.order(), GRAPH_NIL);
    let order = connectivity.topological_sort_kahn(V, W)(g);
    if (order.valid() == false) {
        return out;
    }
    out.dist.at(source) = 0;
    for (v in order.sequence) {
        if (out.dist.at(v) >= GRAPH_INFINITY) {
            continue;
        }
        for (e in g.vertices.at(v).incident) {
            let ref arc: auto = g.edges.at(e);
            if (arc.alive == false) {
                continue;
            }
            let candidate = add_distance(out.dist.at(v), arc.weight);
            if (candidate < out.dist.at(arc.head)) {
                out.dist.at(arc.head) = candidate;
                out.parent.at(arc.head) = v;
                out.parent_arc.at(arc.head) = e;
            }
        }
    }
    return out;
}

// The longest path in a DAG, obtained by negating every weight.  Undefined
// for graphs with cycles, which is why the topological check comes first.
fn dag_longest_path[V: type, W: type]
    (g: AdjacencyList(V, W), source: int) -> int {
    var flipped = builders.to_directed(V, W)(g);
    for (arc in flipped.edges) {
        arc.weight = -arc.weight;
    }
    let found = dag_shortest_path(V, W)(flipped, source);
    var best: int = 0;
    for (d in found.dist) {
        if (d < GRAPH_INFINITY and -d > best) {
            best = -d;
        }
    }
    return best;
}

// --- All pairs ------------------------------------------------------------

// The dense all-pairs result: a distance matrix plus the successor matrix
// needed to reconstruct any of the paths.
class AllPairs(V: type, W: type, N: int)
{

    fn distance(self, from: int, to: int) -> int {
        return self.dist.at(from * N + to);
    }

    fn linked(self, from: int, to: int) -> bool {
        return self.dist.at(from * N + to) < GRAPH_INFINITY;
    }

    // Walk the successor matrix from `from` to `to`.
    fn route(self, from: int, to: int) -> vector(int) {
        var out = vector(int)();
        if (self.dist.at(from * N + to) >= GRAPH_INFINITY) {
            return out;
        }
        var walker = from;
        out.push_back(walker);
        var guard: int = 0;
        while (walker != to and guard < N) {
            walker = self.next.at(walker * N + to);
            if (walker == GRAPH_NIL) {
                out.clear();
                return out;
            }
            out.push_back(walker);
            guard += 1;
        }
        return out;
    }

    // The largest finite distance, i.e. the diameter of the graph.
    fn diameter(self) -> int {
        var best: int = 0;
        var i: int = 0;
        while (i < N * N) {
            let d = self.dist.at(i);
            if (d < GRAPH_INFINITY and d > best) {
                best = d;
            }
            i += 1;
        }
        return best;
    }

    // The vertex whose greatest distance to anyone else is smallest.
    fn center(self) -> int {
        var best = GRAPH_NIL;
        var best_ecc = GRAPH_INFINITY;
        var r: int = 0;
        while (r < N) {
            var ecc: int = 0;
            var c: int = 0;
            while (c < N) {
                let d = self.dist.at(r * N + c);
                if (d < GRAPH_INFINITY and d > ecc) {
                    ecc = d;
                }
                c += 1;
            }
            if (ecc < best_ecc) {
                best_ecc = ecc;
                best = r;
            }
            r += 1;
        }
        return best;
    }

    var dist: vector(int);
    var next: vector(int);
    var payload: V;
    var slack: W;
    var negative_cycle: bool = false;
}

// Floyd-Warshall over a dense matrix: three nested loops, `k` outermost.
//
// After the pass, `dist[i][i] < 0` for some `i` exactly when the graph holds
// a negative cycle reachable from `i`.
fn floyd_warshall[V: type, W: type, N: int]
    (m: AdjacencyMatrix(V, W, N)) -> AllPairs(V, W, N) {
    var out = AllPairs(V, W, N)();
    out.dist.clear();
    out.next.clear();
    var r: int = 0;
    while (r < N) {
        var c: int = 0;
        while (c < N) {
            let value = m.get(r, c);
            out.dist.push_back(value);
            if (value < GRAPH_INFINITY and r != c) {
                out.next.push_back(c);
            } else {
                out.next.push_back(GRAPH_NIL);
            }
            c += 1;
        }
        r += 1;
    }
    var k: int = 0;
    while (k < N) {
        var i: int = 0;
        while (i < N) {
            let left = out.dist.at(i * N + k);
            if (left >= GRAPH_INFINITY) {
                i += 1;
                continue;
            }
            var j: int = 0;
            while (j < N) {
                let right = out.dist.at(k * N + j);
                if (right < GRAPH_INFINITY) {
                    let candidate = left + right;
                    if (candidate < out.dist.at(i * N + j)) {
                        out.dist.at(i * N + j) = candidate;
                        out.next.at(i * N + j) = out.next.at(i * N + k);
                    }
                }
                j += 1;
            }
            i += 1;
        }
        k += 1;
    }
    var d: int = 0;
    while (d < N) {
        if (out.dist.at(d * N + d) < 0) {
            out.negative_cycle = true;
        }
        d += 1;
    }
    return out;
}

// The reachability relation, computed with the boolean specialisation of the
// same triple loop (Warshall's original formulation).
fn transitive_closure[V: type, W: type, N: int]
    (m: AdjacencyMatrix(V, W, N)) -> vector(bool) {
    var reach = vector(bool)();
    var r: int = 0;
    while (r < N) {
        var c: int = 0;
        while (c < N) {
            reach.push_back(r == c or m.linked(r, c));
            c += 1;
        }
        r += 1;
    }
    var k: int = 0;
    while (k < N) {
        var i: int = 0;
        while (i < N) {
            if (reach.at(i * N + k)) {
                var j: int = 0;
                while (j < N) {
                    if (reach.at(k * N + j)) {
                        reach.at(i * N + j) = true;
                    }
                    j += 1;
                }
            }
            i += 1;
        }
        k += 1;
    }
    return reach;
}

// Johnson's algorithm: reweight with a Bellman-Ford potential so that every
// weight becomes non-negative, then run Dijkstra from every vertex.
//
// Faster than Floyd-Warshall on sparse graphs and, unlike plain Dijkstra,
// correct in the presence of negative (but not negatively cyclic) weights.
fn johnson[V: type, W: type]
    (g: AdjacencyList(V, W)) -> vector(vector(int)) {
    var rows = vector(vector(int))();
    var augmented = builders.to_directed(V, W)(g);
    let extra = augmented.add_vertex(V());
    var v: int = 0;
    while (v < g.order()) {
        Discard(augmented.connect(extra, v, 0));
        v += 1;
    }
    let potential = bellman_ford(V, W)(augmented, extra);
    if (potential.negative_cycle) {
        return rows;
    }
    var reweighted = builders.to_directed(V, W)(g);
    for (arc in reweighted.edges) {
        arc.weight = arc.weight + potential.dist.at(arc.tail) - potential.dist.at(arc.head);
    }
    var source: int = 0;
    while (source < g.order()) {
        let found = dijkstra(V, W)(reweighted, source);
        var row = vector(int)();
        var target: int = 0;
        while (target < g.order()) {
            let d = found.dist.at(target);
            if (d >= GRAPH_INFINITY) {
                row.push_back(GRAPH_INFINITY);
            } else {
                row.push_back(d - potential.dist.at(source) + potential.dist.at(target));
            }
            target += 1;
        }
        rows.push_back(move(row));
        source += 1;
    }
    return rows;
}

// The bottleneck (widest path) variant: maximise the smallest weight along a
// path rather than minimising their sum.
fn widest_path[V: type, W: type]
    (g: AdjacencyList(V, W), source: int) -> vector(int) {
    var width = vector(int)();
    fill_int_vector(width, g.order(), 0);
    width.at(source) = GRAPH_INFINITY;
    var frontier = BinaryHeap();
    frontier.prepare(g.order());
    frontier.push(source, 0);
    var settled = vector(bool)();
    fill_bool_vector(settled, g.order(), false);
    while (frontier.empty() == false) {
        let top = frontier.pop();
        let v = top.vertex;
        if (settled.at(v)) {
            continue;
        }
        settled.at(v) = true;
        for (e in g.vertices.at(v).incident) {
            let ref arc: auto = g.edges.at(e);
            if (arc.alive == false) {
                continue;
            }
            var candidate = width.at(v);
            if (arc.weight < candidate) {
                candidate = arc.weight;
            }
            if (candidate > width.at(arc.head)) {
                width.at(arc.head) = candidate;
                Discard(frontier.decrease_key(arc.head, -candidate));
            }
        }
    }
    return width;
}



// ==========================================================================
// graph::spanning
//
// Minimum spanning trees and forests.  Both classic algorithms are here
// because they suit different densities: Prim with a heap is O(E log V) and
// likes dense graphs, Kruskal with a union-find likes sparse ones and gives
// the edges back already sorted by weight.
// ==========================================================================
namespace spanning;

// A spanning tree or forest, described by the arcs it selected.
class SpanningTree(V: type)
{

    fn edge_count(self) -> int {
        return self.arcs.size();
    }

    fn spans(self, order: int) -> bool {
        return self.arcs.size() == order - 1;
    }

    fn average_weight(self) -> int {
        if (self.arcs.empty()) {
            return 0;
        }
        return self.weight / self.arcs.size();
    }

    // The selected arcs, grouped by the component they belong to.
    fn contains_arc(self, e: int) -> bool {
        for (a in self.arcs) {
            if (a == e) {
                return true;
            }
        }
        return false;
    }

    var arcs: vector(int);
    var parent: vector(int);
    var payload: V;
    var weight: int = 0;
    var components: int = 1;
}

// Prim's algorithm from a single root, growing the tree one cheapest crossing
// edge at a time.
//
// Only reaches the component containing `root`; `prim_forest` below loops it
// over every component.
fn prim[V: type, W: type]
    (g: AdjacencyList(V, W), root: int) -> SpanningTree(V) {
    var out = SpanningTree(V)();
    fill_int_vector(out.parent, g.order(), GRAPH_NIL);
    var best = vector(int)();
    var best_arc = vector(int)();
    var inside = vector(bool)();
    fill_int_vector(best, g.order(), GRAPH_INFINITY);
    fill_int_vector(best_arc, g.order(), GRAPH_NIL);
    fill_bool_vector(inside, g.order(), false);
    var frontier = BinaryHeap();
    frontier.prepare(g.order());
    best.at(root) = 0;
    frontier.push(root, 0);
    while (frontier.empty() == false) {
        let top = frontier.pop();
        let v = top.vertex;
        if (inside.at(v)) {
            continue;
        }
        inside.at(v) = true;
        if (best_arc.at(v) != GRAPH_NIL) {
            out.arcs.push_back(best_arc.at(v));
            out.weight += best.at(v);
        }
        for (e in g.vertices.at(v).incident) {
            let ref arc: auto = g.edges.at(e);
            if (arc.alive == false) {
                continue;
            }
            let next = arc.head;
            if (inside.at(next) == false and arc.weight < best.at(next)) {
                best.at(next) = arc.weight;
                best_arc.at(next) = e;
                out.parent.at(next) = v;
                Discard(frontier.decrease_key(next, arc.weight));
            }
        }
    }
    return out;
}

// Prim restarted on every component, giving a minimum spanning forest.
fn prim_forest[V: type, W: type]
    (g: AdjacencyList(V, W)) -> SpanningTree(V) {
    var out = SpanningTree(V)();
    fill_int_vector(out.parent, g.order(), GRAPH_NIL);
    var seen = vector(bool)();
    fill_bool_vector(seen, g.order(), false);
    var trees: int = 0;
    var root: int = 0;
    while (root < g.order()) {
        if (seen.at(root) == false) {
            let piece = prim(V, W)(g, root);
            for (e in piece.arcs) {
                out.arcs.push_back(e);
                let ref arc: auto = g.edges.at(e);
                out.weight += arc.weight;
                seen.at(arc.tail) = true;
                seen.at(arc.head) = true;
            }
            seen.at(root) = true;
            trees += 1;
        }
        root += 1;
    }
    out.components = trees;
    return out;
}

// Sort the logical edges of `g` by weight and hand back their ids.
//
// A plain insertion sort: the corpus deliberately avoids pulling in a sorting
// library, and the edge counts these benchmarks use stay small.
fn edges_by_weight[V: type, W: type]
    (g: AdjacencyList(V, W)) -> vector(int) {
    var ids = vector(int)();
    var e: int = 0;
    while (e < g.edges.size()) {
        let ref arc: auto = g.edges.at(e);
        if (arc.alive) {
            if (g.is_directed() or arc.tail <= arc.head) {
                ids.push_back(e);
            }
        }
        e += 1;
    }
    var i: int = 1;
    while (i < ids.size()) {
        let current = ids.at(i);
        let key = g.edges.at(current).weight;
        var j = i - 1;
        while (j >= 0 and g.edges.at(ids.at(j)).weight > key) {
            ids.at(j + 1) = ids.at(j);
            j -= 1;
        }
        ids.at(j + 1) = current;
        i += 1;
    }
    return ids;
}

// Kruskal's algorithm: take the cheapest edge that joins two distinct
// components, until only one component remains.
fn kruskal[V: type, W: type]
    (g: AdjacencyList(V, W)) -> SpanningTree(V) {
    var out = SpanningTree(V)();
    fill_int_vector(out.parent, g.order(), GRAPH_NIL);
    var forest = UnionFind();
    forest.prepare(g.order());
    let sorted = edges_by_weight(V, W)(g);
    for (e in sorted) {
        let ref arc: auto = g.edges.at(e);
        if (forest.unite(arc.tail, arc.head)) {
            out.arcs.push_back(e);
            out.weight += arc.weight;
            out.parent.at(arc.head) = arc.tail;
        }
        if (forest.single_component()) {
            break;
        }
    }
    out.components = forest.components;
    return out;
}

// The total weight of a minimum spanning tree, without materialising it.
fn mst_weight[V: type, W: type]
    (g: AdjacencyList(V, W)) -> int {
    let tree = kruskal(V, W)(g);
    return tree.weight;
}

// A maximum spanning tree: Kruskal driven from the heaviest edge down.
fn maximum_spanning_tree[V: type, W: type]
    (g: AdjacencyList(V, W)) -> SpanningTree(V) {
    var out = SpanningTree(V)();
    fill_int_vector(out.parent, g.order(), GRAPH_NIL);
    var forest = UnionFind();
    forest.prepare(g.order());
    var sorted = edges_by_weight(V, W)(g);
    reverse_int_vector(sorted);
    for (e in sorted) {
        let ref arc: auto = g.edges.at(e);
        if (forest.unite(arc.tail, arc.head)) {
            out.arcs.push_back(e);
            out.weight += arc.weight;
        }
    }
    out.components = forest.components;
    return out;
}

// Verify the cut property on the produced tree: no non-tree edge may be
// cheaper than the heaviest edge on the tree path joining its endpoints.
fn verify_minimality[V: type, W: type]
    (g: AdjacencyList(V, W),
                     tree: SpanningTree(V)) -> bool {
    var e: int = 0;
    while (e < g.edges.size()) {
        let ref arc: auto = g.edges.at(e);
        if (arc.alive and tree.contains_arc(e) == false) {
            var heaviest: int = 0;
            for (t in tree.arcs) {
                let ref chosen: auto = g.edges.at(t);
                if (chosen.weight > heaviest) {
                    heaviest = chosen.weight;
                }
            }
            if (arc.weight < heaviest - g.order()) {
                return false;
            }
        }
        e += 1;
    }
    return true;
}

// The second best spanning tree, found by forcing each tree edge out in turn.
fn second_best_tree[V: type, W: type]
    (g: AdjacencyList(V, W)) -> int {
    let base_ = kruskal(V, W)(g);
    var best = GRAPH_INFINITY;
    for (banned in base_.arcs) {
        var trimmed = builders.to_directed(V, W)(g);
        trimmed.direction = g.direction;
        Discard(trimmed.disconnect(banned));
        let candidate = kruskal(V, W)(trimmed);
        if (candidate.components == 1 and candidate.weight < best) {
            if (candidate.weight > base_.weight) {
                best = candidate.weight;
            }
        }
    }
    return best;
}



// ==========================================================================
// graph::matching
//
// Bipartite matching and the covers that follow from it.  Everything here
// assumes `connectivity::two_coloring` has already established which side of
// the bipartition each vertex belongs to.
// ==========================================================================
namespace matching;

// A partial matching, stored as an involution on the vertex ids.
class Pairing(V: type)
{

    fn size(self) -> int {
        var total: int = 0;
        var v: int = 0;
        while (v < self.partner.size()) {
            if (self.partner.at(v) != GRAPH_NIL and self.partner.at(v) > v) {
                total += 1;
            }
            v += 1;
        }
        return total;
    }

    fn covered(self, v: int) -> bool {
        return self.partner.at(v) != GRAPH_NIL;
    }

    fn partner_of(self, v: int) -> int {
        return self.partner.at(v);
    }

    fn perfect(self) -> bool {
        for (p in self.partner) {
            if (p == GRAPH_NIL) {
                return false;
            }
        }
        return true;
    }

    // The matched pairs, as a flat list of (left, right) ids.
    fn pairs(self) -> vector(pair(int, int)) {
        var out = vector(pair(int, int))();
        var v: int = 0;
        while (v < self.partner.size()) {
            let p = self.partner.at(v);
            if (p != GRAPH_NIL and p > v) {
                out.push_back(pair(int, int)({.first = v, .second = p}));
            }
            v += 1;
        }
        return out;
    }

    var partner: vector(int);
    var payload: V;
    var augmentations: int = 0;
}

// One Kuhn augmenting search from `v`, iterative rather than recursive.
//
// Returns true when an augmenting path was found and applied, which raises
// the size of the matching by exactly one.
fn augment_from[V: type, W: type]
    (g: AdjacencyList(V, W),
                v: int,
                ref state: Pairing(V),
                ref seen: vector(bool)) -> bool {
    var stack = vector(int)();
    var cursor = vector(int)();
    var trail = vector(int)();
    stack.push_back(v);
    cursor.push_back(0);
    while (stack.empty() == false) {
        let u = stack.back();
        let at = cursor.back();
        let ref incident: auto = g.vertices.at(u).incident;
        if (at >= incident.size()) {
            stack.pop_back();
            cursor.pop_back();
            if (trail.empty() == false) {
                trail.pop_back();
            }
            continue;
        }
        cursor.at(cursor.size() - 1) = at + 1;
        let ref arc: auto = g.edges.at(incident.at(at));
        if (arc.alive == false) {
            continue;
        }
        let target = arc.head;
        if (seen.at(target)) {
            continue;
        }
        seen.at(target) = true;
        let held = state.partner.at(target);
        if (held == GRAPH_NIL) {
            state.partner.at(target) = u;
            state.partner.at(u) = target;
            state.augmentations += 1;
            return true;
        }
        trail.push_back(target);
        stack.push_back(held);
        cursor.push_back(0);
    }
    return false;
}

// Maximum bipartite matching by Kuhn's algorithm: one augmenting search per
// left vertex, each of which either grows the matching or proves the vertex
// cannot be matched at this stage.
fn maximum_bipartite_matching[V: type, W: type]
    (g: AdjacencyList(V, W)) -> Pairing(V) {
    var out = Pairing(V)();
    fill_int_vector(out.partner, g.order(), GRAPH_NIL);
    let colors = connectivity.two_coloring(V, W)(g);
    if (colors.bipartite() == false) {
        return out;
    }
    let left = colors.left_vertices();
    for (v in left) {
        if (out.partner.at(v) == GRAPH_NIL) {
            var seen = vector(bool)();
            fill_bool_vector(seen, g.order(), false);
            Discard(augment_from(V, W)(g, v, out, seen));
        }
    }
    Assert(out.size() >= 0);
    return out;
}

// A greedy matching, used to warm-start Kuhn.  Cheap and typically gets
// within a factor of two of the optimum before any augmentation runs.
fn greedy_matching[V: type, W: type]
    (g: AdjacencyList(V, W)) -> Pairing(V) {
    var out = Pairing(V)();
    fill_int_vector(out.partner, g.order(), GRAPH_NIL);
    var v: int = 0;
    while (v < g.order()) {
        if (out.partner.at(v) == GRAPH_NIL) {
            for (e in g.vertices.at(v).incident) {
                let ref arc: auto = g.edges.at(e);
                if (arc.alive and out.partner.at(arc.head) == GRAPH_NIL) {
                    if (arc.head != v) {
                        out.partner.at(v) = arc.head;
                        out.partner.at(arc.head) = v;
                        break;
                    }
                }
            }
        }
        v += 1;
    }
    return out;
}

// Kuhn again, but starting from a greedy matching.  Same answer, fewer
// augmenting searches.
fn matching_with_warm_start[V: type, W: type]
    (g: AdjacencyList(V, W)) -> Pairing(V) {
    var out = greedy_matching(V, W)(g);
    let colors = connectivity.two_coloring(V, W)(g);
    if (colors.bipartite() == false) {
        return out;
    }
    for (v in colors.left_vertices()) {
        if (out.partner.at(v) == GRAPH_NIL) {
            var seen = vector(bool)();
            fill_bool_vector(seen, g.order(), false);
            Discard(augment_from(V, W)(g, v, out, seen));
        }
    }
    return out;
}

// Koenig's theorem: in a bipartite graph the minimum vertex cover has exactly
// the size of the maximum matching, and can be read off an alternating BFS
// from the unmatched left vertices.
fn minimum_vertex_cover[V: type, W: type]
    (g: AdjacencyList(V, W)) -> vector(int) {
    let paired = maximum_bipartite_matching(V, W)(g);
    let colors = connectivity.two_coloring(V, W)(g);
    var visited = vector(bool)();
    fill_bool_vector(visited, g.order(), false);
    var queue = vector(int)();
    for (v in colors.left_vertices()) {
        if (paired.partner.at(v) == GRAPH_NIL) {
            visited.at(v) = true;
            queue.push_back(v);
        }
    }
    var head: int = 0;
    while (head < queue.size()) {
        let v = queue.at(head);
        head += 1;
        for (e in g.vertices.at(v).incident) {
            let ref arc: auto = g.edges.at(e);
            if (arc.alive == false) {
                continue;
            }
            if (visited.at(arc.head) == false and paired.partner.at(v) != arc.head) {
                visited.at(arc.head) = true;
                let held = paired.partner.at(arc.head);
                if (held != GRAPH_NIL and visited.at(held) == false) {
                    visited.at(held) = true;
                    queue.push_back(held);
                }
            }
        }
    }
    var cover = vector(int)();
    for (v in colors.left_vertices()) {
        if (visited.at(v) == false) {
            cover.push_back(v);
        }
    }
    for (v in colors.right_vertices()) {
        if (visited.at(v)) {
            cover.push_back(v);
        }
    }
    return cover;
}

// The complement of the cover is a maximum independent set.
fn maximum_independent_set[V: type, W: type]
    (g: AdjacencyList(V, W)) -> vector(int) {
    let cover = minimum_vertex_cover(V, W)(g);
    var inside = vector(bool)();
    fill_bool_vector(inside, g.order(), true);
    for (v in cover) {
        inside.at(v) = false;
    }
    var out = vector(int)();
    var v: int = 0;
    while (v < g.order()) {
        if (inside.at(v)) {
            out.push_back(v);
        }
        v += 1;
    }
    return out;
}

// Hall's condition, checked directly: every subset of the left side must have
// at least as many distinct neighbours as it has members.  Only the singleton
// and full subsets are tested here, which is a necessary condition rather
// than a sufficient one.
fn hall_condition_holds[V: type, W: type]
    (g: AdjacencyList(V, W)) -> bool {
    let colors = connectivity.two_coloring(V, W)(g);
    let left = colors.left_vertices();
    var neighbours = set(int)();
    for (v in left) {
        if (g.degree(v) == 0) {
            return false;
        }
        for (e in g.vertices.at(v).incident) {
            let ref arc: auto = g.edges.at(e);
            if (arc.alive) {
                Discard(neighbours.insert(arc.head));
            }
        }
    }
    return neighbours.size() >= left.size();
}



// ==========================================================================
// graph::flow
//
// Residual networks and maximum flow.  The network keeps arcs in twin pairs
// exactly like the undirected adjacency list does, so pushing flow along an
// arc and returning capacity to its reverse is a single exclusive-or.
// ==========================================================================
namespace flow;

// One residual arc.
class FlowArc {

    fn residual(self) -> int {
        return self.capacity - self.flow;
    }

    fn saturated(self) -> bool {
        return self.capacity - self.flow <= 0;
    }

    fn twin_id(self) -> int {
        return self.id ^ 1;
    }

    var tail: int = 0;
    var head: int = 0;
    var capacity: int = 0;
    var flow: int = 0;
    var id: int = 0;
}

// A flow network: vertices with incidence lists over a flat arc arena.
//
// Every call to `add_arc` appends two arcs, the forward one with the given
// capacity and the reverse one with zero, so `twin_id` always works.
class FlowNetwork {

    fn order(self) -> int {
        return self.incident.size();
    }

    fn arc_count(self) -> int {
        return self.arcs.size();
    }

    fn prepare(ref self, order: int) {
        self.incident.clear();
        self.arcs.clear();
        var i: int = 0;
        while (i < order) {
            self.incident.push_back(vector(int)());
            i += 1;
        }
        self.total_flow = 0;
    }

    fn add_arc(ref self, tail: int, head: int, capacity: int) -> int {
        let forward = self.arcs.size();
        self.arcs.push_back(FlowArc({.tail = tail,
                                .head = head,
                                .capacity = capacity,
                                .id = forward}));
        self.incident.at(tail).push_back(forward);
        let backward = self.arcs.size();
        self.arcs.push_back(FlowArc({.tail = head,
                                .head = tail,
                                .capacity = 0,
                                .id = backward}));
        self.incident.at(head).push_back(backward);
        return forward;
    }

    // An arc that can carry flow in both directions at full capacity.
    fn add_bidirectional(ref self, a: int, b: int, capacity: int) -> int {
        let first = self.add_arc(a, b, capacity);
        self.arcs.at(first ^ 1).capacity = capacity;
        return first;
    }

    fn push(ref self, arc: int, amount: int) {
        self.arcs.at(arc).flow += amount;
        self.arcs.at(arc ^ 1).flow -= amount;
    }

    fn residual_of(self, arc: int) -> int {
        return self.arcs.at(arc).capacity - self.arcs.at(arc).flow;
    }

    fn reset_flow(ref self) {
        for (a in self.arcs) {
            a.flow = 0;
        }
        self.total_flow = 0;
    }

    // Total flow leaving `source`, which must equal `total_flow` once a
    // maximum flow computation has converged.
    fn outflow(self, source: int) -> int {
        var total: int = 0;
        for (e in self.incident.at(source)) {
            let ref a: auto = self.arcs.at(e);
            if (a.flow > 0) {
                total += a.flow;
            }
        }
        return total;
    }

    var incident: vector(vector(int));
    var arcs: vector(FlowArc);
    var total_flow: int = 0;
}

// Build a flow network from a weighted directed graph, weights as capacities.
fn network_from[V: type, W: type]
    (g: AdjacencyList(V, W)) -> FlowNetwork {
    var net = FlowNetwork();
    net.prepare(g.order());
    for (arc in g.edges) {
        if (arc.alive) {
            if (g.is_directed()) {
                Discard(net.add_arc(arc.tail, arc.head, arc.weight));
            } else {
                if (arc.tail < arc.head) {
                    Discard(net.add_bidirectional(arc.tail, arc.head, arc.weight));
                }
            }
        }
    }
    return net;
}

// One breadth first search over the residual network, recording the arc used
// to reach each vertex.  Returns the bottleneck of the found path, or zero.
fn find_augmenting_path(ref net: FlowNetwork,
                        source: int,
                        sink: int,
                        ref used: vector(int)) -> int {
    fill_int_vector(used, net.order(), GRAPH_NIL);
    var queue = vector(int)();
    queue.push_back(source);
    var head: int = 0;
    while (head < queue.size()) {
        let v = queue.at(head);
        head += 1;
        if (v == sink) {
            break;
        }
        for (e in net.incident.at(v)) {
            let ref a: auto = net.arcs.at(e);
            if (a.capacity - a.flow <= 0) {
                continue;
            }
            if (a.head != source and used.at(a.head) == GRAPH_NIL) {
                used.at(a.head) = e;
                queue.push_back(a.head);
            }
        }
    }
    if (used.at(sink) == GRAPH_NIL) {
        return 0;
    }
    var bottleneck = GRAPH_INFINITY;
    var walker = sink;
    while (walker != source) {
        let e = used.at(walker);
        let slack = net.residual_of(e);
        if (slack < bottleneck) {
            bottleneck = slack;
        }
        walker = net.arcs.at(e).tail;
    }
    return bottleneck;
}

// Edmonds-Karp: repeatedly augment along a shortest residual path.
//
// Choosing the *shortest* path is what bounds the number of augmentations by
// O(V * E) independently of the capacities.
fn max_flow(ref net: FlowNetwork, source: int, sink: int) -> int {
    net.reset_flow();
    var used = vector(int)();
    var total: int = 0;
    var rounds: int = 0;
    while (rounds < GRAPH_AUGMENT_LIMIT) {
        let bottleneck = find_augmenting_path(net, source, sink, used);
        if (bottleneck <= 0) {
            break;
        }
        var walker = sink;
        while (walker != source) {
            let e = used.at(walker);
            net.push(e, bottleneck);
            walker = net.arcs.at(e).tail;
        }
        total += bottleneck;
        rounds += 1;
    }
    net.total_flow = total;
    Assert(total >= 0);
    return total;
}

// Depth first blocking flow, the inner loop of Dinic's algorithm.  Kept
// iterative for the same stack-depth reason as everything else here.
fn blocking_flow(ref net: FlowNetwork,
                 level: vector(int),
                 source: int,
                 sink: int) -> int {
    var pushed: int = 0;
    var cursor = vector(int)();
    fill_int_vector(cursor, net.order(), 0);
    while (true) {
        var trail = vector(int)();
        var v = source;
        var blocked = false;
        while (v != sink and blocked == false) {
            var advanced = false;
            while (cursor.at(v) < net.incident.at(v).size() and advanced == false) {
                let e = net.incident.at(v).at(cursor.at(v));
                let ref a: auto = net.arcs.at(e);
                if (a.capacity - a.flow > 0 and level.at(a.head) == level.at(v) + 1) {
                    trail.push_back(e);
                    v = a.head;
                    advanced = true;
                } else {
                    cursor.at(v) += 1;
                }
            }
            if (advanced == false) {
                if (trail.empty()) {
                    blocked = true;
                } else {
                    let last = trail.back();
                    trail.pop_back();
                    v = net.arcs.at(last).tail;
                    cursor.at(v) += 1;
                }
            }
        }
        if (blocked) {
            break;
        }
        var bottleneck = GRAPH_INFINITY;
        for (e in trail) {
            let slack = net.residual_of(e);
            if (slack < bottleneck) {
                bottleneck = slack;
            }
        }
        for (e in trail) {
            net.push(e, bottleneck);
        }
        pushed += bottleneck;
    }
    return pushed;
}

// The level graph used by Dinic: BFS distances in the residual network.
fn level_graph(net: FlowNetwork, source: int) -> vector(int) {
    var level = vector(int)();
    fill_int_vector(level, net.order(), GRAPH_NIL);
    var queue = vector(int)();
    level.at(source) = 0;
    queue.push_back(source);
    var head: int = 0;
    while (head < queue.size()) {
        let v = queue.at(head);
        head += 1;
        for (e in net.incident.at(v)) {
            let ref a: auto = net.arcs.at(e);
            if (a.capacity - a.flow > 0 and level.at(a.head) == GRAPH_NIL) {
                level.at(a.head) = level.at(v) + 1;
                queue.push_back(a.head);
            }
        }
    }
    return level;
}

// Dinic's algorithm: alternate level graph construction with blocking flow.
fn dinic_max_flow(ref net: FlowNetwork, source: int, sink: int) -> int {
    net.reset_flow();
    var total: int = 0;
    var phases: int = 0;
    while (phases < net.order() + 1) {
        let level = level_graph(net, source);
        if (level.at(sink) == GRAPH_NIL) {
            break;
        }
        let pushed = blocking_flow(net, level, source, sink);
        if (pushed <= 0) {
            break;
        }
        total += pushed;
        phases += 1;
    }
    net.total_flow = total;
    return total;
}

// The source side of a minimum cut: every vertex still reachable from the
// source in the residual network once the flow is maximal.
fn min_cut_side(net: FlowNetwork, source: int) -> vector(bool) {
    var side = vector(bool)();
    fill_bool_vector(side, net.order(), false);
    var queue = vector(int)();
    side.at(source) = true;
    queue.push_back(source);
    var head: int = 0;
    while (head < queue.size()) {
        let v = queue.at(head);
        head += 1;
        for (e in net.incident.at(v)) {
            let ref a: auto = net.arcs.at(e);
            if (a.capacity - a.flow > 0 and side.at(a.head) == false) {
                side.at(a.head) = true;
                queue.push_back(a.head);
            }
        }
    }
    return side;
}

// The arcs crossing the minimum cut, whose capacities sum to the max flow.
fn min_cut_arcs(net: FlowNetwork, source: int) -> vector(int) {
    let side = min_cut_side(net, source);
    var out = vector(int)();
    var e: int = 0;
    while (e < net.arcs.size()) {
        let ref a: auto = net.arcs.at(e);
        if (a.capacity > 0 and side.at(a.tail) and side.at(a.head) == false) {
            out.push_back(e);
        }
        e += 1;
    }
    return out;
}

// Max-flow min-cut, restated as an assertion: the capacity crossing the cut
// equals the flow value.
fn cut_capacity(net: FlowNetwork, source: int) -> int {
    let crossing = min_cut_arcs(net, source);
    var total: int = 0;
    for (e in crossing) {
        total += net.arcs.at(e).capacity;
    }
    return total;
}

// Maximum bipartite matching expressed as a unit-capacity flow problem.
// Slower than Kuhn in practice but a useful cross-check in the tests.
fn matching_by_flow[V: type, W: type]
    (g: AdjacencyList(V, W)) -> int {
    let colors = connectivity.two_coloring(V, W)(g);
    if (colors.bipartite() == false) {
        return 0;
    }
    var net = FlowNetwork();
    let super_source = g.order();
    let super_sink = g.order() + 1;
    net.prepare(g.order() + 2);
    for (v in colors.left_vertices()) {
        Discard(net.add_arc(super_source, v, 1));
        for (e in g.vertices.at(v).incident) {
            let ref arc: auto = g.edges.at(e);
            if (arc.alive) {
                Discard(net.add_arc(v, arc.head, 1));
            }
        }
    }
    for (v in colors.right_vertices()) {
        Discard(net.add_arc(v, super_sink, 1));
    }
    return max_flow(net, super_source, super_sink);
}

// Edge connectivity between two vertices: the number of arc-disjoint paths,
// which by Menger's theorem is the unit-capacity max flow.
fn edge_connectivity[V: type, W: type]
    (g: AdjacencyList(V, W),
                     source: int,
                     sink: int) -> int {
    var net = FlowNetwork();
    net.prepare(g.order());
    for (arc in g.edges) {
        if (arc.alive) {
            Discard(net.add_arc(arc.tail, arc.head, 1));
        }
    }
    return max_flow(net, source, sink);
}

// The global minimum cut, obtained by fixing vertex zero and running a max
// flow to every other vertex in turn.
fn global_min_cut[V: type, W: type]
    (g: AdjacencyList(V, W)) -> int {
    if (g.order() < 2) {
        return 0;
    }
    var best = GRAPH_INFINITY;
    var sink: int = 1;
    while (sink < g.order()) {
        var net = network_from(V, W)(g);
        let value = max_flow(net, 0, sink);
        if (value < best) {
            best = value;
        }
        sink += 1;
    }
    return best;
}



// ==========================================================================
// Top level convenience wrappers
//
// The entry points a caller is most likely to reach for, hoisted out of the
// nested namespaces so that the common cases read as one-liners.
// ==========================================================================

// Shortest hop path between two vertices of an unweighted graph.
fn shortest_hops[V: type, W: type]
    (g: AdjacencyList(V, W),
                 source: int,
                 target: int) -> int {
    return traversal.hop_distance(V, W)(g, source, target);
}

// Cheapest route in a weighted graph, as a vertex sequence.
fn cheapest_route[V: type, W: type]
    (g: AdjacencyList(V, W),
                  source: int,
                  target: int) -> vector(int) {
    return shortest_path.shortest_route(V, W)(g, source, target);
}

// True when every vertex can reach every other vertex.
fn fully_connected[V: type, W: type]
    (g: AdjacencyList(V, W)) -> bool {
    if (g.is_directed()) {
        return connectivity.is_strongly_connected(V, W)(g);
    }
    return connectivity.is_connected(V, W)(g);
}

// A one-line health check used by the test suite: run every major algorithm
// and confirm none of them contradicts another.
fn cross_check[V: type, W: type]
    (g: AdjacencyList(V, W)) -> bool {
    let by_bfs = connectivity.connected_components(V, W)(g);
    let by_union = connectivity.components_by_union(V, W)(g);
    if (by_bfs.total != by_union.total) {
        return false;
    }
    let tarjan = connectivity.tarjan_scc(V, W)(g);
    let kosaraju = connectivity.kosaraju_scc(V, W)(g);
    if (tarjan.total != kosaraju.total) {
        return false;
    }
    let prim_tree = spanning.prim(V, W)(g, 0);
    let kruskal_tree = spanning.kruskal(V, W)(g);
    if (by_bfs.total == 1 and prim_tree.weight != kruskal_tree.weight) {
        return false;
    }
    return true;
}

// A compact textual summary of everything this library can say about a graph.
fn report[V: type, W: type]
    (g: AdjacencyList(V, W)) -> string {
    var out = string();
    out.append(builders.describe(V, W)(g));
    out.append(" components=");
    out.append(to_string(connectivity.component_count(V, W)(g)));
    out.append(" acyclic=");
    if (connectivity.is_acyclic(V, W)(g)) {
        out.append("yes");
    } else {
        out.append("no");
    }
    out.append(" bipartite=");
    if (connectivity.is_bipartite(V, W)(g)) {
        out.append("yes");
    } else {
        out.append("no");
    }
    out.append(" mst=");
    out.append(to_string(spanning.mst_weight(V, W)(g)));
    return out;
}

// --- Demonstration --------------------------------------------------------

// Exercise the traversal namespace on a small grid.
fn demo_traversal() {
    let grid = builders.grid_graph(int, int)(4, 4);
    let found = traversal.bfs(int, int)(grid, 0);
    println(to_string(found.reached_count()));
    println(to_string(found.eccentricity()));
    var watcher = traversal.Visitor(int, int)();
    watcher.stop_after = 8;
    let limited = traversal.bfs_visit(int, int)(grid, 0, watcher);
    Assert(limited.complete == false);
    let levels = traversal.bfs_levels(int, int)(grid, 0);
    for (level in levels) {
        println(to_string(level.size()));
    }
}

// Build a small weighted DAG and run every ordering and distance routine.
fn demo_shortest_paths() {
    var dag = builders.directed(int, int)(6);
    Discard(dag.connect(0, 1, 2000));
    Discard(dag.connect(0, 2, 4000));
    Discard(dag.connect(1, 2, 1000));
    Discard(dag.connect(1, 3, 7000));
    Discard(dag.connect(2, 4, 3000));
    Discard(dag.connect(3, 5, 1000));
    Discard(dag.connect(4, 3, 2000));
    Discard(dag.connect(4, 5, 5000));

    let kahn = connectivity.topological_sort_kahn(int, int)(dag);
    Assert(kahn.valid());
    let by_dfs = connectivity.topological_sort_dfs(int, int)(dag);
    Assert(by_dfs.length() == kahn.length());

    let quick = shortest_path.dijkstra(int, int)(dag, 0);
    let careful = shortest_path.bellman_ford(int, int)(dag, 0);
    var v: int = 0;
    while (v < dag.order()) {
        Assert(quick.dist.at(v) == careful.dist.at(v));
        v += 1;
    }
    Prove(careful.negative_cycle == false);

    let linear = shortest_path.dag_shortest_path(int, int)(dag, 0);
    println(to_string(linear.to(5)));
    let route = shortest_path.shortest_route(int, int)(dag, 0, 5);
    println(to_string(route.size()));

    let dense = builders.densify(int, int, 6)(dag);
    let pairs = shortest_path.floyd_warshall(int, int, 6)(dense);
    println(to_string(pairs.diameter()));
    println(to_string(pairs.center()));
    Discard(shortest_path.transitive_closure(int, int, 6)(dense));
}

// Spanning trees over an undirected weighted graph.
fn demo_spanning() {
    var net = builders.undirected(int, int)(6);
    Discard(net.connect(0, 1, 4000));
    Discard(net.connect(0, 2, 3000));
    Discard(net.connect(1, 2, 1000));
    Discard(net.connect(1, 3, 2000));
    Discard(net.connect(2, 3, 4000));
    Discard(net.connect(3, 4, 2000));
    Discard(net.connect(4, 5, 6000));

    let grown = spanning.prim(int, int)(net, 0);
    let sorted = spanning.kruskal(int, int)(net);
    Assert(grown.weight == sorted.weight);
    Assert(sorted.spans(net.order()));
    println(to_string(sorted.average_weight()));
    let heaviest = spanning.maximum_spanning_tree(int, int)(net);
    Assert(heaviest.weight >= sorted.weight);
    Assert(spanning.verify_minimality(int, int)(net, sorted));
}

// Components, cuts and colourings.
fn demo_connectivity() {
    var web = builders.directed(int, int)(8);
    Discard(web.connect_unweighted(0, 1));
    Discard(web.connect_unweighted(1, 2));
    Discard(web.connect_unweighted(2, 0));
    Discard(web.connect_unweighted(2, 3));
    Discard(web.connect_unweighted(3, 4));
    Discard(web.connect_unweighted(4, 5));
    Discard(web.connect_unweighted(5, 3));
    Discard(web.connect_unweighted(6, 7));

    let strong = connectivity.tarjan_scc(int, int)(web);
    let also_strong = connectivity.kosaraju_scc(int, int)(web);
    Assert(strong.total == also_strong.total);
    let collapsed = connectivity.condensation(int, int)(web, strong);
    Assert(connectivity.is_acyclic(int, int)(collapsed));
    for (bucket in strong.buckets()) {
        println(to_string(bucket.size()));
    }

    let ring = builders.cycle_graph(int, int)(7);
    Assert(connectivity.has_undirected_cycle(int, int)(ring));
    Assert(connectivity.is_bipartite(int, int)(ring) == false);
    let even_ring = builders.cycle_graph(int, int)(8);
    Assert(connectivity.is_bipartite(int, int)(even_ring));

    let chain = builders.path_graph(int, int)(6);
    let cuts = connectivity.find_cuts(int, int)(chain);
    println(to_string(cuts.bridge_count()));
    println(to_string(cuts.articulation_list().size()));
}

// Matching and flow on the same bipartite instance.
fn demo_matching_and_flow() {
    let jobs = builders.complete_bipartite(int, int)(3, 4);
    let paired = matching.maximum_bipartite_matching(int, int)(jobs);
    let warm = matching.matching_with_warm_start(int, int)(jobs);
    Assert(paired.size() == warm.size());
    let by_flow = flow.matching_by_flow(int, int)(jobs);
    Assert(by_flow == paired.size());
    for (entry in paired.pairs()) {
        println(to_string(entry.first));
        println(to_string(entry.second));
    }
    let cover = matching.minimum_vertex_cover(int, int)(jobs);
    Assert(cover.size() == paired.size());
    Discard(matching.maximum_independent_set(int, int)(jobs));
    Assert(matching.hall_condition_holds(int, int)(jobs));

    var pipes = FlowNetwork();
    pipes.prepare(6);
    Discard(pipes.add_arc(0, 1, 16000));
    Discard(pipes.add_arc(0, 2, 13000));
    Discard(pipes.add_arc(1, 3, 12000));
    Discard(pipes.add_arc(2, 1, 4000));
    Discard(pipes.add_arc(2, 4, 14000));
    Discard(pipes.add_arc(3, 2, 9000));
    Discard(pipes.add_arc(3, 5, 20000));
    Discard(pipes.add_arc(4, 3, 7000));
    Discard(pipes.add_arc(4, 5, 4000));

    let value = flow.max_flow(pipes, 0, 5);
    Assert(value == pipes.outflow(0));
    Assert(value == flow.cut_capacity(pipes, 0));
    let fast = flow.dinic_max_flow(pipes, 0, 5);
    Assert(fast == value);
    let crossing = flow.min_cut_arcs(pipes, 0);
    println(to_string(crossing.size()));
}

// The whole library, in the order the chapters of a textbook would use it.
fn demo_graph_algorithms() {
    demo_traversal();
    demo_shortest_paths();
    demo_spanning();
    demo_connectivity();
    demo_matching_and_flow();

    let sample = builders.complete_graph(int, int)(5);
    println(report(int, int)(sample));
    Assert(cross_check(int, int)(sample));
    Assert(fully_connected(int, int)(sample));
    println(to_string(cheapest_route(int, int)(sample, 0, 4).size()));
    println(to_string(shortest_hops(int, int)(sample, 0, 4)));
}


// A complete JSON reader and writer: lexer, recursive descent parser and
// serializer with compact and pretty output modes.
//
// Numbers are stored as a scaled integer mantissa plus a decimal exponent,
// because the charge lexer only accepts plain decimal integer literals.
// The value of a number is  sign * mantissa * 10^exponent.
namespace json;

// --- Character constants -------------------------------------------------
//
// The lexer compares raw characters constantly, so every delimiter gets a
// name here instead of being spelled out at each use site.

let CHAR_QUOTE: char = '"';
let CHAR_BACKSLASH: char = '\\';
let CHAR_SLASH: char = '/';
let CHAR_NEWLINE: char = '\n';
let CHAR_RETURN: char = '\r';
let CHAR_TAB: char = '\t';
let CHAR_BACKSPACE: char = '\u{08}';
let CHAR_FORMFEED: char = '\u{0C}';
let CHAR_SPACE: char = ' ';
let CHAR_NUL: char = '\0';

let CHAR_LBRACE: char = '{';
let CHAR_RBRACE: char = '}';
let CHAR_LBRACKET: char = '[';
let CHAR_RBRACKET: char = ']';
let CHAR_COLON: char = ':';
let CHAR_COMMA: char = ',';

let CHAR_MINUS: char = '-';
let CHAR_PLUS: char = '+';
let CHAR_DOT: char = '.';
let CHAR_ZERO: char = '0';
let CHAR_NINE: char = '9';
let CHAR_LOWER_A: char = 'a';
let CHAR_LOWER_B: char = 'b';
let CHAR_LOWER_E: char = 'e';
let CHAR_LOWER_F: char = 'f';
let CHAR_LOWER_N: char = 'n';
let CHAR_LOWER_R: char = 'r';
let CHAR_LOWER_T: char = 't';
let CHAR_LOWER_U: char = 'u';
let CHAR_LOWER_Z: char = 'z';
let CHAR_UPPER_A: char = 'A';
let CHAR_UPPER_E: char = 'E';
let CHAR_UPPER_F: char = 'F';
let CHAR_UPPER_Z: char = 'Z';

// --- Keyword and punctuation spellings -----------------------------------

let WORD_TRUE: string = "true";
let WORD_FALSE: string = "false";
let WORD_NULL: string = "null";

let TEXT_LBRACE: string = "{";
let TEXT_RBRACE: string = "}";
let TEXT_LBRACKET: string = "[";
let TEXT_RBRACKET: string = "]";
let TEXT_COLON: string = ":";
let TEXT_COMMA: string = ",";
let TEXT_COLON_SPACE: string = ": ";
let TEXT_COMMA_SPACE: string = ", ";
let TEXT_EMPTY: string = "";
let TEXT_EMPTY_ARRAY: string = "[]";
let TEXT_EMPTY_OBJECT: string = "{}";
let TEXT_SPACE: string = " ";
let TEXT_NEWLINE: string = "\n";
let TEXT_TWO_SPACES: string = "  ";
let TEXT_FOUR_SPACES: string = "    ";
let TEXT_TAB: string = "\t";

// The literal two-character sequences that JSON uses inside strings. Note the
// doubled backslash: the charge source escape produces one real backslash.
let ESCAPE_QUOTE: string = "\\\"";
let ESCAPE_BACKSLASH: string = "\\\\";
let ESCAPE_SLASH: string = "\\/";
let ESCAPE_NEWLINE: string = "\\n";
let ESCAPE_RETURN: string = "\\r";
let ESCAPE_TAB: string = "\\t";
let ESCAPE_BACKSPACE: string = "\\b";
let ESCAPE_FORMFEED: string = "\\f";
let ESCAPE_UNICODE: string = "\\u";

// Limits. JSON itself has none, but a real reader needs guard rails.
let MAX_DEPTH: int = 128;
let MAX_MANTISSA_DIGITS: int = 17;
let MAX_EXPONENT: int = 308;
let MIN_EXPONENT: int = -308;
let UNICODE_ESCAPE_DIGITS: int = 4;
let SURROGATE_HIGH_BEGIN: int = 55296;
let SURROGATE_HIGH_END: int = 56319;
let SURROGATE_LOW_BEGIN: int = 56320;
let SURROGATE_LOW_END: int = 57343;
let SURROGATE_OFFSET: int = 65536;
let REPLACEMENT_CODEPOINT: int = 65533;
let ASCII_LIMIT: int = 128;
let CONTROL_LIMIT: int = 32;

// --- Value and token kinds -----------------------------------------------

choice JsonKind {
    Null,
    Bool,
    Number,
    String,
    Array,
    Object,
}

choice TokenKind {
    End,
    ObjectBegin,
    ObjectEnd,
    ArrayBegin,
    ArrayEnd,
    Colon,
    Comma,
    String,
    Number,
    True,
    False,
    Null,
    Invalid,
}

choice ErrorCode {
    None,
    UnexpectedEnd,
    UnexpectedCharacter,
    UnterminatedString,
    BadEscape,
    BadUnicodeEscape,
    ControlCharacterInString,
    LeadingZero,
    MissingFraction,
    MissingExponent,
    NumberOverflow,
    TrailingContent,
    ExpectedColon,
    ExpectedCommaOrEnd,
    ExpectedKey,
    ExpectedValue,
    DepthExceeded,
    LoneSurrogate,
}

// --- Source positions ----------------------------------------------------

// Every token and every error carries one of these so diagnostics can point
// at a line and column rather than a bare byte offset.
class Position {

    fn advance_over(ref self, c: char) {
        self.offset += 1;
        if (c == CHAR_NEWLINE) {
            self.line += 1;
            self.column = 1;
        } else {
            self.column += 1;
        }
    }

    fn describe(self) -> string {
        var out: string = "line ";
        out.append(to_string(self.line));
        out.append(", column ");
        out.append(to_string(self.column));
        out.append(" (offset ");
        out.append(to_string(self.offset));
        out.append(")");
        return out;
    }

    var offset: int = 0;
    var line: int = 1;
    var column: int = 1;
}

// --- Escape tables -------------------------------------------------------

// One row of the escape table: the character that follows a backslash, the
// character it decodes to, and the human readable name used in diagnostics.
class EscapeRow {
    var marker: char = CHAR_NUL;
    var decoded: char = CHAR_NUL;
    var spelling: string;
    var name: string;
}

fn escape_table() -> vector(EscapeRow) {
    var rows: vector(EscapeRow);
    rows.push_back(EscapeRow({.marker = '"', .decoded = '"', .spelling = "\\\"", .name = "quotation mark"}));
    rows.push_back(EscapeRow({.marker = '\\', .decoded = '\\', .spelling = "\\\\", .name = "reverse solidus"}));
    rows.push_back(EscapeRow({.marker = '/', .decoded = '/', .spelling = "\\/", .name = "solidus"}));
    rows.push_back(EscapeRow({.marker = 'b', .decoded = '\u{08}', .spelling = "\\b", .name = "backspace"}));
    rows.push_back(EscapeRow({.marker = 'f', .decoded = '\u{0C}', .spelling = "\\f", .name = "form feed"}));
    rows.push_back(EscapeRow({.marker = 'n', .decoded = '\n', .spelling = "\\n", .name = "line feed"}));
    rows.push_back(EscapeRow({.marker = 'r', .decoded = '\r', .spelling = "\\r", .name = "carriage return"}));
    rows.push_back(EscapeRow({.marker = 't', .decoded = '\t', .spelling = "\\t", .name = "tab"}));
    return rows;
}

// Decode a single escape marker. Returns the NUL character when the marker is
// not one of the eight single-character escapes; \u is handled separately.
fn decode_escape(marker: char) -> char {
    if (marker == '"') {
        return '"';
    }
    if (marker == '\\') {
        return '\\';
    }
    if (marker == '/') {
        return '/';
    }
    if (marker == 'b') {
        return '\u{08}';
    }
    if (marker == 'f') {
        return '\u{0C}';
    }
    if (marker == 'n') {
        return '\n';
    }
    if (marker == 'r') {
        return '\r';
    }
    if (marker == 't') {
        return '\t';
    }
    return CHAR_NUL;
}

// The inverse mapping, used by the serializer.
fn encode_escape(c: char) -> string {
    if (c == '"') {
        return "\\\"";
    }
    if (c == '\\') {
        return "\\\\";
    }
    if (c == '\n') {
        return "\\n";
    }
    if (c == '\r') {
        return "\\r";
    }
    if (c == '\t') {
        return "\\t";
    }
    if (c == '\u{08}') {
        return "\\b";
    }
    if (c == '\u{0C}') {
        return "\\f";
    }
    return "";
}

fn escape_name(marker: char) -> string {
    if (marker == 'n') {
        return "line feed";
    }
    if (marker == 't') {
        return "tab";
    }
    if (marker == 'r') {
        return "carriage return";
    }
    if (marker == 'b') {
        return "backspace";
    }
    if (marker == 'f') {
        return "form feed";
    }
    if (marker == 'u') {
        return "unicode escape";
    }
    if (marker == '/') {
        return "solidus";
    }
    if (marker == '"') {
        return "quotation mark";
    }
    if (marker == '\\') {
        return "reverse solidus";
    }
    return "unknown escape";
}

// --- Character classification --------------------------------------------

fn is_whitespace(c: char) => c == ' ' or c == '\t' or c == '\n' or c == '\r';

fn is_digit(c: char) => c >= '0' and c <= '9';

fn is_nonzero_digit(c: char) => c >= '1' and c <= '9';

fn is_hex_digit(c: char) -> bool {
    if (c >= '0' and c <= '9') {
        return true;
    }
    if (c >= 'a' and c <= 'f') {
        return true;
    }
    if (c >= 'A' and c <= 'F') {
        return true;
    }
    return false;
}

fn is_structural(c: char) -> bool {
    return c == '{' or c == '}' or c == '[' or c == ']' or c == ':' or c == ',';
}

fn is_control(c: char) -> bool {
    return int(c) < CONTROL_LIMIT;
}

fn is_letter(c: char) -> bool {
    if (c >= 'a' and c <= 'z') {
        return true;
    }
    if (c >= 'A' and c <= 'Z') {
        return true;
    }
    return false;
}

fn digit_value(c: char) -> int {
    return int(c) - int('0');
}

fn hex_value(c: char) -> int {
    if (c >= '0' and c <= '9') {
        return int(c) - int('0');
    }
    if (c >= 'a' and c <= 'f') {
        return int(c) - int('a') + 10;
    }
    if (c >= 'A' and c <= 'F') {
        return int(c) - int('A') + 10;
    }
    return -1;
}

// Lower case hexadecimal digits, indexed by value. Used when the serializer
// has to emit a \u escape for a control character.
fn hex_digit(value: int) -> char {
    if (value == 0) { return '0'; }
    if (value == 1) { return '1'; }
    if (value == 2) { return '2'; }
    if (value == 3) { return '3'; }
    if (value == 4) { return '4'; }
    if (value == 5) { return '5'; }
    if (value == 6) { return '6'; }
    if (value == 7) { return '7'; }
    if (value == 8) { return '8'; }
    if (value == 9) { return '9'; }
    if (value == 10) { return 'a'; }
    if (value == 11) { return 'b'; }
    if (value == 12) { return 'c'; }
    if (value == 13) { return 'd'; }
    if (value == 14) { return 'e'; }
    if (value == 15) { return 'f'; }
    return '?';
}

// --- Diagnostics ---------------------------------------------------------

fn error_text(code: ErrorCode) -> string {
    if (code == ErrorCode.None) {
        return "no error";
    }
    if (code == ErrorCode.UnexpectedEnd) {
        return "unexpected end of input";
    }
    if (code == ErrorCode.UnexpectedCharacter) {
        return "unexpected character";
    }
    if (code == ErrorCode.UnterminatedString) {
        return "unterminated string literal, expected a closing '\"'";
    }
    if (code == ErrorCode.BadEscape) {
        return "invalid escape sequence after '\\'";
    }
    if (code == ErrorCode.BadUnicodeEscape) {
        return "invalid \\uXXXX escape, expected four hexadecimal digits";
    }
    if (code == ErrorCode.ControlCharacterInString) {
        return "raw control character in string, use \\u00XX instead";
    }
    if (code == ErrorCode.LeadingZero) {
        return "numbers may not have a leading zero";
    }
    if (code == ErrorCode.MissingFraction) {
        return "expected at least one digit after '.'";
    }
    if (code == ErrorCode.MissingExponent) {
        return "expected at least one digit after 'e'";
    }
    if (code == ErrorCode.NumberOverflow) {
        return "number is out of the representable range";
    }
    if (code == ErrorCode.TrailingContent) {
        return "trailing content after the top level value";
    }
    if (code == ErrorCode.ExpectedColon) {
        return "expected ':' between an object key and its value";
    }
    if (code == ErrorCode.ExpectedCommaOrEnd) {
        return "expected ',' or a closing bracket";
    }
    if (code == ErrorCode.ExpectedKey) {
        return "expected a string key";
    }
    if (code == ErrorCode.ExpectedValue) {
        return "expected a value";
    }
    if (code == ErrorCode.DepthExceeded) {
        return "maximum nesting depth exceeded";
    }
    if (code == ErrorCode.LoneSurrogate) {
        return "lone surrogate in \\u escape";
    }
    return "unknown error";
}

class Diagnostic {

    fn valid(self) -> bool {
        return self.code == ErrorCode.None;
    }

    fn render(self) -> string {
        if (self.code == ErrorCode.None) {
            return "ok";
        }
        var out: string = "json: ";
        out.append(error_text(self.code));
        out.append(" at ");
        out.append(self.where_.describe());
        if (not self.detail.empty()) {
            out.append(" [");
            out.append(self.detail);
            out.append("]");
        }
        return out;
    }

    var code: ErrorCode = ErrorCode.None;
    var where_: Position;
    var detail: string;
}

fn make_error(code: ErrorCode, where_: Position, detail: string) -> Diagnostic {
    return Diagnostic({.code = code, .where_ = where_, .detail = detail});
}

// --- Numbers -------------------------------------------------------------

// A JSON number as sign * mantissa * 10^exponent. Storing the mantissa as an
// integer keeps the whole reader free of floating point.
class Number {

    fn is_integral(self) -> bool {
        return self.exponent >= 0;
    }

    fn signed_mantissa(self) -> int {
        if (self.negative) {
            return -self.mantissa;
        }
        return self.mantissa;
    }

    fn render(self) -> string {
        var out: string = "";
        if (self.negative) {
            out.append("-");
        }
        out.append(to_string(self.mantissa));
        if (self.exponent != 0) {
            out.append("e");
            out.append(to_string(self.exponent));
        }
        return out;
    }

    var negative: bool = false;
    var mantissa: int = 0;
    var exponent: int = 0;
    var digits: int = 0;
}

fn number_from_int(value: int) -> Number {
    if (value < 0) {
        return Number({.negative = true, .mantissa = -value, .exponent = 0});
    }
    return Number({.negative = false, .mantissa = value, .exponent = 0});
}

// --- Tokens --------------------------------------------------------------

class Token {

    fn is_value_start(self) -> bool {
        if (self.kind == TokenKind.String) { return true; }
        if (self.kind == TokenKind.Number) { return true; }
        if (self.kind == TokenKind.True) { return true; }
        if (self.kind == TokenKind.False) { return true; }
        if (self.kind == TokenKind.Null) { return true; }
        if (self.kind == TokenKind.ArrayBegin) { return true; }
        if (self.kind == TokenKind.ObjectBegin) { return true; }
        return false;
    }

    fn spelling(self) -> string {
        if (self.kind == TokenKind.End) { return "<end of input>"; }
        if (self.kind == TokenKind.ObjectBegin) { return "{"; }
        if (self.kind == TokenKind.ObjectEnd) { return "}"; }
        if (self.kind == TokenKind.ArrayBegin) { return "["; }
        if (self.kind == TokenKind.ArrayEnd) { return "]"; }
        if (self.kind == TokenKind.Colon) { return ":"; }
        if (self.kind == TokenKind.Comma) { return ","; }
        if (self.kind == TokenKind.True) { return "true"; }
        if (self.kind == TokenKind.False) { return "false"; }
        if (self.kind == TokenKind.Null) { return "null"; }
        if (self.kind == TokenKind.String) { return self.text; }
        if (self.kind == TokenKind.Number) { return self.number.render(); }
        return "<invalid>";
    }

    var kind: TokenKind = TokenKind.End;
    var text: string;
    var number: Number;
    var begin: Position;
    var end: Position;
}

fn punctuation_token(c: char) -> TokenKind {
    if (c == '{') {
        return TokenKind.ObjectBegin;
    }
    if (c == '}') {
        return TokenKind.ObjectEnd;
    }
    if (c == '[') {
        return TokenKind.ArrayBegin;
    }
    if (c == ']') {
        return TokenKind.ArrayEnd;
    }
    if (c == ':') {
        return TokenKind.Colon;
    }
    if (c == ',') {
        return TokenKind.Comma;
    }
    return TokenKind.Invalid;
}

// --- Lexer ---------------------------------------------------------------

// A character level scanner. It owns the source text and a cursor, and hands
// out one token at a time. All string decoding happens here so the parser
// never sees a backslash.
class Lexer {

    fn at_end(self) -> bool {
        return self.cursor.offset >= self.source.size();
    }

    fn remaining(self) -> int {
        return self.source.size() - self.cursor.offset;
    }

    fn peek(self) -> char {
        if (self.at_end()) {
            return '\0';
        }
        return self.source.at(self.cursor.offset);
    }

    fn peek_at(self, ahead: int) -> char {
        let index = self.cursor.offset + ahead;
        if (index >= self.source.size()) {
            return '\0';
        }
        return self.source.at(index);
    }

    fn advance(ref self) -> char {
        if (self.at_end()) {
            return '\0';
        }
        let c = self.source.at(self.cursor.offset);
        self.cursor.advance_over(c);
        return c;
    }

    fn accept(ref self, expected: char) -> bool {
        if (self.peek() == expected) {
            Discard(self.advance());
            return true;
        }
        return false;
    }

    fn fail(ref self, code: ErrorCode, detail: string) -> Token {
        self.problem = make_error(code, self.cursor, detail);
        return Token({.kind = TokenKind.Invalid, .begin = self.cursor, .end = self.cursor});
    }

    // Skip spaces, tabs, carriage returns and newlines. JSON allows nothing
    // else between tokens, comments in particular are not part of the grammar.
    fn skip_whitespace(ref self) {
        while (not self.at_end()) {
            let c = self.peek();
            if (c == ' ' or c == '\t' or c == '\n' or c == '\r') {
                Discard(self.advance());
            } else {
                break;
            }
        }
    }

    // A relaxed mode that also swallows // and /* */ comments, for reading
    // configuration files that are "JSON with comments".
    fn skip_trivia(ref self) {
        while (true) {
            self.skip_whitespace();
            if (not self.allow_comments) {
                break;
            }
            if (self.peek() != '/') {
                break;
            }
            let after = self.peek_at(1);
            if (after == '/') {
                Discard(self.advance());
                Discard(self.advance());
                while (not self.at_end() and self.peek() != '\n') {
                    Discard(self.advance());
                }
            } else {
                if (after == '*') {
                    Discard(self.advance());
                    Discard(self.advance());
                    while (not self.at_end()) {
                        if (self.peek() == '*' and self.peek_at(1) == '/') {
                            Discard(self.advance());
                            Discard(self.advance());
                            break;
                        }
                        Discard(self.advance());
                    }
                } else {
                    break;
                }
            }
        }
    }

    // Read four hexadecimal digits and fold them into a code point. The
    // leading "\u" has already been consumed by the caller.
    fn scan_hex_quad(ref self, ref out: int) -> bool {
        var value: int = 0;
        var read: int = 0;
        while (read < UNICODE_ESCAPE_DIGITS) {
            if (self.at_end()) {
                return false;
            }
            let c = self.peek();
            if (not is_hex_digit(c)) {
                return false;
            }
            Discard(self.advance());
            value = value * 16 + hex_value(c);
            read += 1;
        }
        Assert(read == UNICODE_ESCAPE_DIGITS);
        out = value;
        return true;
    }

    // Encode a code point as UTF-8 and append it to the destination. The
    // charge string is a byte sequence, so this writes one to four bytes.
    fn append_utf8(self, ref out: string, codepoint: int) {
        if (codepoint < ASCII_LIMIT) {
            out.push_back(char(codepoint));
            return;
        }
        if (codepoint < 2048) {
            out.push_back(char(192 + (codepoint >> 6)));
            out.push_back(char(128 + (codepoint & 63)));
            return;
        }
        if (codepoint < 65536) {
            out.push_back(char(224 + (codepoint >> 12)));
            out.push_back(char(128 + ((codepoint >> 6) & 63)));
            out.push_back(char(128 + (codepoint & 63)));
            return;
        }
        out.push_back(char(240 + (codepoint >> 18)));
        out.push_back(char(128 + ((codepoint >> 12) & 63)));
        out.push_back(char(128 + ((codepoint >> 6) & 63)));
        out.push_back(char(128 + (codepoint & 63)));
    }

    // Handle everything after a backslash inside a string literal.
    fn scan_escape(ref self, ref out: string) -> bool {
        if (self.at_end()) {
            Discard(self.fail(ErrorCode.UnterminatedString, "input ended after a backslash"));
            return false;
        }
        let marker = self.advance();
        if (marker == 'u') {
            var codepoint: int = 0;
            if (not self.scan_hex_quad(codepoint)) {
                Discard(self.fail(ErrorCode.BadUnicodeEscape, "expected four hex digits after \\u"));
                return false;
            }
            // A high surrogate must be followed by a matching low surrogate,
            // spelled as a second \u escape.
            if (codepoint >= SURROGATE_HIGH_BEGIN and codepoint <= SURROGATE_HIGH_END) {
                if (self.peek() != '\\' or self.peek_at(1) != 'u') {
                    if (self.strict_surrogates) {
                        Discard(self.fail(ErrorCode.LoneSurrogate, "high surrogate without a pair"));
                        return false;
                    }
                    self.append_utf8(out, REPLACEMENT_CODEPOINT);
                    return true;
                }
                Discard(self.advance());
                Discard(self.advance());
                var low: int = 0;
                if (not self.scan_hex_quad(low)) {
                    Discard(self.fail(ErrorCode.BadUnicodeEscape, "bad low surrogate escape"));
                    return false;
                }
                if (low < SURROGATE_LOW_BEGIN or low > SURROGATE_LOW_END) {
                    if (self.strict_surrogates) {
                        Discard(self.fail(ErrorCode.LoneSurrogate, "second escape is not a low surrogate"));
                        return false;
                    }
                    self.append_utf8(out, REPLACEMENT_CODEPOINT);
                    return true;
                }
                let high_part = (codepoint - SURROGATE_HIGH_BEGIN) << 10;
                let low_part = low - SURROGATE_LOW_BEGIN;
                self.append_utf8(out, SURROGATE_OFFSET + high_part + low_part);
                return true;
            }
            if (codepoint >= SURROGATE_LOW_BEGIN and codepoint <= SURROGATE_LOW_END) {
                if (self.strict_surrogates) {
                    Discard(self.fail(ErrorCode.LoneSurrogate, "unpaired low surrogate"));
                    return false;
                }
                self.append_utf8(out, REPLACEMENT_CODEPOINT);
                return true;
            }
            self.append_utf8(out, codepoint);
            return true;
        }
        let decoded = decode_escape(marker);
        if (decoded == '\0') {
            var detail: string = "unknown escape '\\";
            detail.push_back(marker);
            detail.append("'");
            Discard(self.fail(ErrorCode.BadEscape, detail));
            return false;
        }
        out.push_back(decoded);
        return true;
    }

    // Scan a complete string literal. The opening quote is consumed by the
    // caller; the closing quote is consumed here.
    fn scan_string(ref self) -> Token {
        let begin = self.cursor;
        var text: string = "";
        while (true) {
            if (self.at_end()) {
                return self.fail(ErrorCode.UnterminatedString, "reached end of input inside a string");
            }
            let c = self.peek();
            if (c == '"') {
                Discard(self.advance());
                break;
            }
            if (c == '\\') {
                Discard(self.advance());
                if (not self.scan_escape(text)) {
                    return Token({.kind = TokenKind.Invalid, .begin = begin, .end = self.cursor});
                }
                continue;
            }
            if (is_control(c)) {
                var detail: string = "control byte ";
                detail.append(to_string(int(c)));
                return self.fail(ErrorCode.ControlCharacterInString, detail);
            }
            Discard(self.advance());
            text.push_back(c);
        }
        return Token({.kind = TokenKind.String, .text = text, .begin = begin, .end = self.cursor});
    }

    // Scan an integer, fraction and exponent into a scaled mantissa.
    fn scan_number(ref self) -> Token {
        let begin = self.cursor;
        var result: Number;
        if (self.peek() == '-') {
            Discard(self.advance());
            result.negative = true;
        }
        if (self.at_end()) {
            return self.fail(ErrorCode.UnexpectedEnd, "input ended after '-'");
        }
        var seen: int = 0;
        if (self.peek() == '0') {
            Discard(self.advance());
            seen += 1;
            if (is_digit(self.peek())) {
                return self.fail(ErrorCode.LeadingZero, "digit follows a leading '0'");
            }
        } else {
            if (not is_digit(self.peek())) {
                return self.fail(ErrorCode.UnexpectedCharacter, "expected a digit");
            }
            while (is_digit(self.peek())) {
                let c = self.advance();
                if (seen < MAX_MANTISSA_DIGITS) {
                    result.mantissa = result.mantissa * 10 + digit_value(c);
                } else {
                    // Past the precision limit the digit only shifts the
                    // decimal point, it no longer changes the mantissa.
                    result.exponent += 1;
                }
                seen += 1;
            }
        }
        result.digits = seen;
        // The fractional part scales the mantissa up and the exponent down.
        if (self.peek() == '.') {
            Discard(self.advance());
            if (not is_digit(self.peek())) {
                return self.fail(ErrorCode.MissingFraction, "expected a digit after '.'");
            }
            while (is_digit(self.peek())) {
                let c = self.advance();
                if (seen < MAX_MANTISSA_DIGITS) {
                    result.mantissa = result.mantissa * 10 + digit_value(c);
                    result.exponent -= 1;
                    seen += 1;
                }
            }
            result.digits = seen;
        }
        if (self.peek() == 'e' or self.peek() == 'E') {
            Discard(self.advance());
            var exponent_negative: bool = false;
            if (self.peek() == '+') {
                Discard(self.advance());
            } else {
                if (self.peek() == '-') {
                    Discard(self.advance());
                    exponent_negative = true;
                }
            }
            if (not is_digit(self.peek())) {
                return self.fail(ErrorCode.MissingExponent, "expected a digit after the exponent marker");
            }
            var exponent: int = 0;
            while (is_digit(self.peek())) {
                let c = self.advance();
                exponent = exponent * 10 + digit_value(c);
                if (exponent > MAX_EXPONENT) {
                    return self.fail(ErrorCode.NumberOverflow, "exponent is too large");
                }
            }
            if (exponent_negative) {
                result.exponent -= exponent;
            } else {
                result.exponent += exponent;
            }
        }
        if (result.exponent > MAX_EXPONENT or result.exponent < MIN_EXPONENT) {
            return self.fail(ErrorCode.NumberOverflow, "scaled exponent is out of range");
        }
        return Token({.kind = TokenKind.Number, .number = result, .begin = begin, .end = self.cursor});
    }

    // Match one of the three bare keywords.
    fn scan_keyword(ref self) -> Token {
        let begin = self.cursor;
        var word: string = "";
        while (is_letter(self.peek())) {
            word.push_back(self.advance());
        }
        if (word == "true") {
            return Token({.kind = TokenKind.True, .text = "true", .begin = begin, .end = self.cursor});
        }
        if (word == "false") {
            return Token({.kind = TokenKind.False, .text = "false", .begin = begin, .end = self.cursor});
        }
        if (word == "null") {
            return Token({.kind = TokenKind.Null, .text = "null", .begin = begin, .end = self.cursor});
        }
        var detail: string = "expected 'true', 'false' or 'null', found '";
        detail.append(word);
        detail.append("'");
        return self.fail(ErrorCode.UnexpectedCharacter, detail);
    }

    fn next_token(ref self) -> Token {
        self.skip_trivia();
        let begin = self.cursor;
        if (self.at_end()) {
            return Token({.kind = TokenKind.End, .begin = begin, .end = begin});
        }
        let c = self.peek();
        if (c == '"') {
            Discard(self.advance());
            return self.scan_string();
        }
        if (c == '-' or is_digit(c)) {
            return self.scan_number();
        }
        if (is_letter(c)) {
            return self.scan_keyword();
        }
        if (is_structural(c)) {
            Discard(self.advance());
            return Token({.kind = punctuation_token(c), .text = self.source.substr(begin.offset, 1), .begin = begin, .end = self.cursor});
        }
        var detail: string = "stray byte ";
        detail.append(to_string(int(c)));
        Discard(self.advance());
        return self.fail(ErrorCode.UnexpectedCharacter, detail);
    }

    var source: string;
    var cursor: Position;
    var problem: Diagnostic;
    var allow_comments: bool = false;
    var strict_surrogates: bool = true;
}


// --- Values --------------------------------------------------------------

// A JSON value is a tagged union. charge has no variant type yet, so every
// payload gets its own field and `kind` decides which one is meaningful.
//
// Objects keep two parallel vectors instead of a map because JSON member
// order is observable: a document that is read and written back out should
// come out spelled the same way it went in.
class JsonValue {

    fn is_null(self) -> bool {
        return self.kind == JsonKind.Null;
    }

    fn is_bool(self) -> bool {
        return self.kind == JsonKind.Bool;
    }

    fn is_number(self) -> bool {
        return self.kind == JsonKind.Number;
    }

    fn is_string(self) -> bool {
        return self.kind == JsonKind.String;
    }

    fn is_array(self) -> bool {
        return self.kind == JsonKind.Array;
    }

    fn is_object(self) -> bool {
        return self.kind == JsonKind.Object;
    }

    // True for everything that cannot contain another value.
    fn is_scalar(self) -> bool {
        if (self.kind == JsonKind.Array) {
            return false;
        }
        if (self.kind == JsonKind.Object) {
            return false;
        }
        return true;
    }

    fn kind_name(self) -> string {
        if (self.kind == JsonKind.Null) { return "null"; }
        if (self.kind == JsonKind.Bool) { return "bool"; }
        if (self.kind == JsonKind.Number) { return "number"; }
        if (self.kind == JsonKind.String) { return "string"; }
        if (self.kind == JsonKind.Array) { return "array"; }
        if (self.kind == JsonKind.Object) { return "object"; }
        return "<unknown>";
    }

    // The number of children. Scalars report zero rather than failing, which
    // makes the tree walkers below a lot shorter.
    fn size(self) -> int {
        if (self.kind == JsonKind.Array) {
            return self.items.size();
        }
        if (self.kind == JsonKind.Object) {
            return self.keys.size();
        }
        return 0;
    }

    fn empty(self) -> bool {
        return self.size() == 0;
    }

    // --- Array access ----------------------------------------------------

    fn at(ref self, index: int) -> ref JsonValue {
        Assert(index >= 0);
        if (self.kind != JsonKind.Array) {
            return self.absent;
        }
        if (index >= self.items.size()) {
            return self.absent;
        }
        return self.items[index];
    }

    fn first(ref self) -> ref JsonValue {
        return self.at(0);
    }

    fn last(ref self) -> ref JsonValue {
        return self.at(self.size() - 1);
    }

    fn push_back(ref self, value: JsonValue) {
        self.kind = JsonKind.Array;
        self.items.push_back(value);
    }

    // --- Object access ---------------------------------------------------

    fn index_of(self, name: string) -> int {
        if (self.kind != JsonKind.Object) {
            return -1;
        }
        var slot: int = 0;
        while (slot < self.keys.size()) {
            if (self.keys[slot] == *name) {
                return slot;
            }
            slot += 1;
        }
        return -1;
    }

    fn has_member(self, name: string) -> bool {
        return self.index_of(name) >= 0;
    }

    fn member(ref self, name: string) -> ref JsonValue {
        let slot = self.index_of(name);
        if (slot < 0) {
            return self.absent;
        }
        return self.values[slot];
    }

    fn key_at(self, slot: int) -> string {
        if (slot < 0 or slot >= self.keys.size()) {
            return "";
        }
        return self.keys[slot];
    }

    fn value_at(ref self, slot: int) -> ref JsonValue {
        if (slot < 0 or slot >= self.values.size()) {
            return self.absent;
        }
        return self.values[slot];
    }

    // Insert or overwrite. Returns true when the key was new.
    fn set_member(ref self, name: string, value: JsonValue) -> bool {
        self.kind = JsonKind.Object;
        let slot = self.index_of(name);
        if (slot >= 0) {
            self.values[slot] = value;
            return false;
        }
        self.keys.push_back(name);
        self.values.push_back(value);
        return true;
    }

    fn remove_member(ref self, name: string) -> bool {
        let slot = self.index_of(name);
        if (slot < 0) {
            return false;
        }
        self.keys.erase(slot);
        self.values.erase(slot);
        return true;
    }

    // --- Scalar readers --------------------------------------------------

    fn as_bool(self, fallback: bool) -> bool {
        if (self.kind != JsonKind.Bool) {
            return fallback;
        }
        return self.boolean;
    }

    fn as_int(self, fallback: int) -> int {
        if (self.kind != JsonKind.Number) {
            return fallback;
        }
        if (self.number.exponent < 0) {
            return fallback;
        }
        var scaled = self.number.signed_mantissa();
        var steps = self.number.exponent;
        while (steps > 0) {
            scaled = scaled * 10;
            steps -= 1;
        }
        return scaled;
    }

    fn as_string(self, fallback: string) -> string {
        if (self.kind != JsonKind.String) {
            return *fallback;
        }
        return self.text;
    }

    // A short one line description used in error messages and in tests.
    fn describe(self) -> string {
        var out: string = "<";
        out.append(self.kind_name());
        if (self.kind == JsonKind.String) {
            out.append(" \"");
            out.append(self.text);
            out.append("\"");
        }
        if (self.kind == JsonKind.Number) {
            out.append(" ");
            out.append(self.number.render());
        }
        if (self.kind == JsonKind.Bool) {
            if (self.boolean) {
                out.append(" true");
            } else {
                out.append(" false");
            }
        }
        if (self.kind == JsonKind.Array or self.kind == JsonKind.Object) {
            out.append(" of ");
            out.append(to_string(self.size()));
        }
        out.append(">");
        return out;
    }

    fn clear(ref self) {
        self.kind = JsonKind.Null;
        self.boolean = false;
        self.text.clear();
        self.items.clear();
        self.keys.clear();
        self.values.clear();
    }

    var kind: JsonKind = JsonKind.Null;
    var boolean: bool = false;
    var number: Number;
    var text: string;
    var items: vector(JsonValue);
    var keys: vector(string);
    var values: vector(JsonValue);
    // Returned by at() and member() when the lookup misses, so callers can
    // chain accessors without checking every step.
    var absent: vector(JsonValue);
}

// --- Value constructors --------------------------------------------------

fn make_null() -> JsonValue {
    return JsonValue({.kind = JsonKind.Null});
}

fn make_bool(value: bool) -> JsonValue {
    return JsonValue({.kind = JsonKind.Bool, .boolean = value});
}

fn make_number(value: Number) -> JsonValue {
    return JsonValue({.kind = JsonKind.Number, .number = value});
}

fn make_int(value: int) -> JsonValue {
    return JsonValue({.kind = JsonKind.Number, .number = number_from_int(value)});
}

// Build a scaled number: `mantissa * 10^exponent`, e.g. make_scaled(1505, -2)
// is the JSON number 15.05.
fn make_scaled(mantissa: int, exponent: int) -> JsonValue {
    var n = number_from_int(mantissa);
    n.exponent = exponent;
    return JsonValue({.kind = JsonKind.Number, .number = n});
}

fn make_string(value: string) -> JsonValue {
    return JsonValue({.kind = JsonKind.String, .text = value});
}

fn make_array() -> JsonValue {
    return JsonValue({.kind = JsonKind.Array});
}

fn make_object() -> JsonValue {
    return JsonValue({.kind = JsonKind.Object});
}

// --- Parser --------------------------------------------------------------

// How a document is allowed to end. Strict JSON wants exactly one value and
// nothing after it; the streaming mode leaves the cursor where it stopped so
// a caller can read newline delimited JSON.
choice DocumentMode {
    SingleValue,
    Streaming,
}

// Recursive descent over the token stream produced by Lexer. The parser
// keeps one token of lookahead in `current`; every rule is written so that
// on entry `current` is the first token of the construct and on exit it is
// the first token after it.
class Parser {

    fn ok(self) -> bool {
        return self.problem.code == ErrorCode.None;
    }

    fn diagnostic(self) -> Diagnostic {
        return self.problem;
    }

    fn position(self) -> Position {
        return self.current.begin;
    }

    // Pull the next token, forwarding any lexer level error. Once the parser
    // is in an error state it keeps returning the end token so the recursion
    // unwinds instead of spinning.
    fn advance(ref self) {
        if (not self.ok()) {
            self.current = Token({.kind = TokenKind.End, .begin = self.current.end, .end = self.current.end});
            return;
        }
        self.current = self.lexer.next_token();
        self.tokens_read += 1;
        if (self.current.kind == TokenKind.Invalid) {
            self.problem = self.lexer.problem;
            if (self.problem.code == ErrorCode.None) {
                self.problem = make_error(ErrorCode.UnexpectedCharacter, self.current.begin, "invalid token");
            }
        }
    }

    fn check(self, kind: TokenKind) -> bool {
        return self.current.kind == kind;
    }

    fn at_end(self) -> bool {
        return self.current.kind == TokenKind.End;
    }

    // Consume `kind` if it is next, otherwise raise `code`.
    fn expect(ref self, kind: TokenKind, code: ErrorCode, detail: string) -> bool {
        if (self.current.kind != kind) {
            self.raise(code, detail);
            return false;
        }
        self.advance();
        return true;
    }

    // Record the first error only. Later errors are almost always fallout
    // from the first one and just make the report noisier.
    fn raise(ref self, code: ErrorCode, detail: string) {
        if (not self.ok()) {
            return;
        }
        var text: string = detail;
        text.append(", found ");
        text.append(self.quoted_spelling());
        self.problem = make_error(code, self.current.begin, text);
    }

    fn quoted_spelling(self) -> string {
        if (self.current.kind == TokenKind.End) {
            return "end of input";
        }
        var out: string = "'";
        out.append(self.current.spelling());
        out.append("'");
        return out;
    }

    // --- Grammar rules ---------------------------------------------------

    // value := object | array | string | number | 'true' | 'false' | 'null'
    fn parse_value(ref self, depth: int) -> JsonValue {
        if (depth > self.depth_limit) {
            var detail: string = "nesting is deeper than ";
            detail.append(to_string(self.depth_limit));
            detail.append(" levels");
            self.problem = make_error(ErrorCode.DepthExceeded, self.current.begin, detail);
            return make_null();
        }
        if (depth > self.deepest) {
            self.deepest = depth;
        }
        if (self.current.kind == TokenKind.ObjectBegin) {
            return self.parse_object(depth);
        }
        if (self.current.kind == TokenKind.ArrayBegin) {
            return self.parse_array(depth);
        }
        if (self.current.kind == TokenKind.String) {
            let text = self.current.text;
            self.advance();
            return make_string(text);
        }
        if (self.current.kind == TokenKind.Number) {
            let value = self.current.number;
            self.advance();
            return make_number(value);
        }
        if (self.current.kind == TokenKind.True) {
            self.advance();
            return make_bool(true);
        }
        if (self.current.kind == TokenKind.False) {
            self.advance();
            return make_bool(false);
        }
        if (self.current.kind == TokenKind.Null) {
            self.advance();
            return make_null();
        }
        self.raise(ErrorCode.ExpectedValue, "expected 'null', 'true', 'false', a number, a string, '[' or '{'");
        return make_null();
    }

    // array := '[' ']' | '[' value { ',' value } ']'
    fn parse_array(ref self, depth: int) -> JsonValue {
        Assert(self.current.kind == TokenKind.ArrayBegin);
        let opened = self.current.begin;
        self.advance();
        var result = make_array();
        if (self.current.kind == TokenKind.ArrayEnd) {
            self.advance();
            return result;
        }
        while (true) {
            if (self.at_end()) {
                self.problem = make_error(ErrorCode.UnexpectedEnd, opened, "array opened here was never closed with ']'");
                return result;
            }
            let element = self.parse_value(depth + 1);
            if (not self.ok()) {
                return result;
            }
            result.items.push_back(element);
            if (self.current.kind == TokenKind.Comma) {
                self.advance();
                // A comma directly before ']' is the classic trailing comma.
                if (self.current.kind == TokenKind.ArrayEnd) {
                    if (not self.allow_trailing_commas) {
                        self.raise(ErrorCode.ExpectedValue, "trailing ',' before ']'");
                        return result;
                    }
                    self.advance();
                    return result;
                }
                continue;
            }
            if (self.current.kind == TokenKind.ArrayEnd) {
                self.advance();
                return result;
            }
            self.raise(ErrorCode.ExpectedCommaOrEnd, "expected ',' or ']' after an array element");
            return result;
        }
    }

    // member := string ':' value
    //
    // The key and the value are written through the out parameters so the
    // caller can decide what to do with duplicates.
    fn parse_member(ref self, ref key: string, ref value: JsonValue, depth: int) -> bool {
        if (self.current.kind != TokenKind.String) {
            self.raise(ErrorCode.ExpectedKey, "expected a '\"' quoted member name");
            return false;
        }
        key = self.current.text;
        self.advance();
        if (not self.expect(TokenKind.Colon, ErrorCode.ExpectedColon, "expected ':' after the member name")) {
            return false;
        }
        value = self.parse_value(depth + 1);
        return self.ok();
    }

    // object := '{' '}' | '{' member { ',' member } '}'
    fn parse_object(ref self, depth: int) -> JsonValue {
        Assert(self.current.kind == TokenKind.ObjectBegin);
        let opened = self.current.begin;
        self.advance();
        var result = make_object();
        if (self.current.kind == TokenKind.ObjectEnd) {
            self.advance();
            return result;
        }
        while (true) {
            if (self.at_end()) {
                self.problem = make_error(ErrorCode.UnexpectedEnd, opened, "object opened here was never closed with '}'");
                return result;
            }
            var key: string = "";
            var value = make_null();
            if (not self.parse_member(key, value, depth)) {
                return result;
            }
            let existing = result.index_of(key);
            if (existing >= 0) {
                self.duplicate_keys += 1;
                if (self.reject_duplicate_keys) {
                    var detail: string = "duplicate member name \"";
                    detail.append(key);
                    detail.append("\"");
                    self.problem = make_error(ErrorCode.ExpectedKey, self.current.begin, detail);
                    return result;
                }
                // Last one wins, which is what most readers do in practice.
                result.values[existing] = value;
            } else {
                result.keys.push_back(key);
                result.values.push_back(value);
            }
            if (self.current.kind == TokenKind.Comma) {
                self.advance();
                if (self.current.kind == TokenKind.ObjectEnd) {
                    if (not self.allow_trailing_commas) {
                        self.raise(ErrorCode.ExpectedKey, "trailing ',' before '}'");
                        return result;
                    }
                    self.advance();
                    return result;
                }
                continue;
            }
            if (self.current.kind == TokenKind.ObjectEnd) {
                self.advance();
                return result;
            }
            self.raise(ErrorCode.ExpectedCommaOrEnd, "expected ',' or '}' after a member");
            return result;
        }
    }

    // Entry point. Primes the lookahead, parses one value and, in single
    // value mode, insists that nothing follows it.
    fn parse_document(ref self) -> JsonValue {
        self.advance();
        if (self.at_end()) {
            self.problem = make_error(ErrorCode.UnexpectedEnd, self.current.begin, "the document is empty");
            return make_null();
        }
        var root = self.parse_value(1);
        if (not self.ok()) {
            return root;
        }
        if (self.mode == DocumentMode.SingleValue) {
            if (not self.at_end()) {
                self.raise(ErrorCode.TrailingContent, "expected end of input after the top level value");
            }
        }
        return root;
    }

    var lexer: Lexer;
    var current: Token;
    var problem: Diagnostic;
    var mode: DocumentMode = DocumentMode.SingleValue;
    var depth_limit: int = MAX_DEPTH;
    var deepest: int = 0;
    var tokens_read: int = 0;
    var duplicate_keys: int = 0;
    var allow_trailing_commas: bool = false;
    var reject_duplicate_keys: bool = false;
}

// --- Parse front ends ----------------------------------------------------

// The outcome of a parse: the value plus whatever went wrong producing it.
class ParseResult {

    fn ok(self) -> bool {
        return self.problem.code == ErrorCode.None;
    }

    fn report(self) -> string {
        if (self.ok()) {
            var good: string = "parsed ";
            good.append(self.root.describe());
            good.append(" from ");
            good.append(to_string(self.tokens));
            good.append(" tokens");
            return good;
        }
        return self.problem.render();
    }

    var root: JsonValue;
    var problem: Diagnostic;
    var tokens: int = 0;
    var depth: int = 0;
}

fn parse(source: string) -> ParseResult {
    var parser = Parser({.lexer = Lexer({.source = source})});
    var root = parser.parse_document();
    return ParseResult({.root = root, .problem = parser.problem, .tokens = parser.tokens_read, .depth = parser.deepest});
}

// "JSON with comments" plus trailing commas: the dialect most editors use
// for their configuration files.
fn parse_relaxed(source: string) -> ParseResult {
    var parser = Parser({.lexer = Lexer({.source = source, .allow_comments = true}), .allow_trailing_commas = true});
    var root = parser.parse_document();
    return ParseResult({.root = root, .problem = parser.problem, .tokens = parser.tokens_read, .depth = parser.deepest});
}

// --- Serializer ----------------------------------------------------------

// Compact writes the shortest legal spelling; Pretty puts one element per
// line and indents nested levels.
choice WriteStyle {
    Compact,
    Pretty,
}

// Which characters get a `\uXXXX` escape rather than being copied through.
choice EscapePolicy {
    Minimal,
    EscapeSolidus,
    AsciiOnly,
}

// Escape one string and wrap it in quotes. This is the only place in the
// writer that knows about the '"' and '\\' characters.
fn quote_string(text: string, policy: EscapePolicy) -> string {
    var out: string = "\"";
    var index: int = 0;
    while (index < text.size()) {
        let c = text.at(index);
        let short = encode_escape(c);
        if (not short.empty()) {
            out.append(short);
        } else {
            if (c == '/' and policy == EscapePolicy.EscapeSolidus) {
                out.append("\\/");
            } else {
                var code = int(c);
                if (code < 0) {
                    code += 256;
                }
                var needs_hex: bool = code < CONTROL_LIMIT;
                if (code >= ASCII_LIMIT and policy == EscapePolicy.AsciiOnly) {
                    needs_hex = true;
                }
                if (needs_hex) {
                    out.append("\\u");
                    out.push_back(hex_digit((code >> 12) & 15));
                    out.push_back(hex_digit((code >> 8) & 15));
                    out.push_back(hex_digit((code >> 4) & 15));
                    out.push_back(hex_digit(code & 15));
                } else {
                    out.push_back(c);
                }
            }
        }
        index += 1;
    }
    out.append("\"");
    return out;
}

// Spell a scaled number back out. Whole numbers print without an exponent;
// anything else keeps the `<mantissa>e<exponent>` form, which is legal JSON.
fn spell_number(value: Number) -> string {
    var out: string = "";
    if (value.negative) {
        out.append("-");
    }
    out.append(to_string(value.mantissa));
    if (value.exponent > 0) {
        // Small positive exponents are cheaper to read as trailing zeroes.
        if (value.exponent <= 6) {
            var pad = value.exponent;
            while (pad > 0) {
                out.append("0");
                pad -= 1;
            }
            return out;
        }
        out.append("e");
        out.append(to_string(value.exponent));
        return out;
    }
    if (value.exponent < 0) {
        out.append("e-");
        out.append(to_string(-value.exponent));
    }
    return out;
}

class Writer {

    // One indentation unit repeated `level` times.
    fn indent(self, level: int) -> string {
        var out: string = "";
        if (self.style == WriteStyle.Compact) {
            return out;
        }
        var step: int = 0;
        while (step < level) {
            out.append(self.indent_unit);
            step += 1;
        }
        return out;
    }

    fn newline(self) -> string {
        if (self.style == WriteStyle.Compact) {
            return "";
        }
        return "\n";
    }

    // ':' in compact mode, ": " when pretty printing.
    fn key_separator(self) -> string {
        if (self.style == WriteStyle.Compact) {
            return ":";
        }
        return ": ";
    }

    fn write_value(ref self, ref out: string, value: JsonValue, level: int) {
        if (value.kind == JsonKind.Null) {
            out.append("null");
            return;
        }
        if (value.kind == JsonKind.Bool) {
            if (value.boolean) {
                out.append("true");
            } else {
                out.append("false");
            }
            return;
        }
        if (value.kind == JsonKind.Number) {
            out.append(spell_number(value.number));
            return;
        }
        if (value.kind == JsonKind.String) {
            out.append(quote_string(value.text, self.policy));
            return;
        }
        if (value.kind == JsonKind.Array) {
            self.write_array(out, value, level);
            return;
        }
        if (value.kind == JsonKind.Object) {
            self.write_object(out, value, level);
            return;
        }
        out.append("null");
    }

    fn write_array(ref self, ref out: string, value: JsonValue, level: int) {
        if (value.items.empty()) {
            out.append("[]");
            return;
        }
        out.append("[");
        out.append(self.newline());
        var index: int = 0;
        while (index < value.items.size()) {
            out.append(self.indent(level + 1));
            self.write_value(out, value.items[index], level + 1);
            if (index + 1 < value.items.size()) {
                out.append(",");
            }
            out.append(self.newline());
            index += 1;
        }
        out.append(self.indent(level));
        out.append("]");
    }

    fn write_object(ref self, ref out: string, value: JsonValue, level: int) {
        if (value.keys.empty()) {
            out.append("{}");
            return;
        }
        out.append("{");
        out.append(self.newline());
        var slot: int = 0;
        while (slot < value.keys.size()) {
            out.append(self.indent(level + 1));
            out.append(quote_string(value.keys[slot], self.policy));
            out.append(self.key_separator());
            self.write_value(out, value.values[slot], level + 1);
            if (slot + 1 < value.keys.size()) {
                out.append(",");
            }
            out.append(self.newline());
            slot += 1;
        }
        out.append(self.indent(level));
        out.append("}");
    }

    fn write_document(ref self, value: JsonValue) -> string {
        var out: string = "";
        self.write_value(out, value, 0);
        if (self.trailing_newline and self.style == WriteStyle.Pretty) {
            out.append("\n");
        }
        return out;
    }

    var style: WriteStyle = WriteStyle.Compact;
    var policy: EscapePolicy = EscapePolicy.Minimal;
    var indent_unit: string = "  ";
    var trailing_newline: bool = true;
}

// `{"a":[1,2]}` on a single line.
fn write_compact(value: JsonValue) -> string {
    var writer = Writer({.style = WriteStyle.Compact, .trailing_newline = false});
    return writer.write_document(value);
}

// Two space indentation, one element per line, trailing newline.
fn write_pretty(value: JsonValue) -> string {
    var writer = Writer({.style = WriteStyle.Pretty, .indent_unit = "  "});
    return writer.write_document(value);
}

// Read and write back out, which normalises spacing, escapes and key order
// handling. Returns the empty string when the input does not parse.
fn reformat(source: string, style: WriteStyle) -> string {
    let result = parse(source);
    if (not result.ok()) {
        return "";
    }
    if (style == WriteStyle.Pretty) {
        return write_pretty(result.root);
    }
    return write_compact(result.root);
}

// --- Tree walking utilities ----------------------------------------------

// Two numbers are equal when they denote the same value, not when they were
// spelled the same way: 1e2, 100 and 1000e-1 all compare equal. Normalising
// means stripping trailing zeroes from the mantissa and raising the
// exponent to match.
fn normalize_number(value: Number) -> Number {
    var out = *value;
    while (out.mantissa != 0 and out.mantissa % 10 == 0) {
        out.mantissa = out.mantissa / 10;
        out.exponent += 1;
    }
    if (out.mantissa == 0) {
        out.exponent = 0;
        out.negative = false;
    }
    return out;
}

fn number_equal(left: Number, right: Number) -> bool {
    let a = normalize_number(left);
    let b = normalize_number(right);
    if (a.mantissa != b.mantissa) {
        return false;
    }
    if (a.exponent != b.exponent) {
        return false;
    }
    return a.negative == b.negative;
}

// Structural equality. Arrays compare element by element in order; objects
// compare by member name, so key order does not matter.
fn deep_equal(left: JsonValue, right: JsonValue) -> bool {
    if (left.kind != right.kind) {
        return false;
    }
    if (left.kind == JsonKind.Null) {
        return true;
    }
    if (left.kind == JsonKind.Bool) {
        return left.boolean == right.boolean;
    }
    if (left.kind == JsonKind.Number) {
        return number_equal(left.number, right.number);
    }
    if (left.kind == JsonKind.String) {
        return left.text == right.text;
    }
    if (left.kind == JsonKind.Array) {
        if (left.items.size() != right.items.size()) {
            return false;
        }
        var index: int = 0;
        while (index < left.items.size()) {
            if (not deep_equal(left.items[index], right.items[index])) {
                return false;
            }
            index += 1;
        }
        return true;
    }
    // Objects: same member count, and every left member has an equal twin.
    if (left.keys.size() != right.keys.size()) {
        return false;
    }
    var slot: int = 0;
    while (slot < left.keys.size()) {
        let other = right.index_of(left.keys[slot]);
        if (other < 0) {
            return false;
        }
        if (not deep_equal(left.values[slot], right.values[other])) {
            return false;
        }
        slot += 1;
    }
    return true;
}

// --- JSON pointers -------------------------------------------------------

// Inside a pointer token, '~' and '/' are written "~0" and "~1". Undo that.
fn unescape_pointer_token(token: string) -> string {
    var out: string = "";
    var index: int = 0;
    while (index < token.size()) {
        let c = token.at(index);
        if (c == '~' and index + 1 < token.size()) {
            let next = token.at(index + 1);
            if (next == '0') {
                out.push_back('~');
                index += 2;
                continue;
            }
            if (next == '1') {
                out.push_back('/');
                index += 2;
                continue;
            }
        }
        out.push_back(c);
        index += 1;
    }
    return out;
}

fn escape_pointer_token(token: string) -> string {
    var out: string = "";
    var index: int = 0;
    while (index < token.size()) {
        let c = token.at(index);
        if (c == '~') {
            out.append("~0");
        } else {
            if (c == '/') {
                out.append("~1");
            } else {
                out.push_back(c);
            }
        }
        index += 1;
    }
    return out;
}

// "/a/b/0" becomes ["a", "b", "0"]. The empty pointer "" selects the root
// and yields no tokens at all.
fn split_pointer(path: string) -> vector(string) {
    var tokens: vector(string);
    if (path.empty()) {
        return tokens;
    }
    var current: string = "";
    var index: int = 0;
    if (path.at(0) == '/') {
        index = 1;
    }
    while (index < path.size()) {
        let c = path.at(index);
        if (c == '/') {
            tokens.push_back(unescape_pointer_token(current));
            current.clear();
        } else {
            current.push_back(c);
        }
        index += 1;
    }
    tokens.push_back(unescape_pointer_token(current));
    return tokens;
}

fn join_pointer(tokens: vector(string)) -> string {
    var out: string = "";
    for (token in tokens) {
        out.append("/");
        out.append(escape_pointer_token(token));
    }
    return out;
}

fn is_index_token(token: string) -> bool {
    if (token.empty()) {
        return false;
    }
    var index: int = 0;
    while (index < token.size()) {
        if (not is_digit(token.at(index))) {
            return false;
        }
        index += 1;
    }
    // "01" is not a valid array index in a JSON pointer.
    if (token.size() > 1 and token.at(0) == '0') {
        return false;
    }
    return true;
}

// Walk `tokens` starting at `index`. Returns the node itself once the
// tokens run out, and stops early on a miss, so pair this with
// pointer_exists() when the difference matters.
fn resolve_tokens(ref node: JsonValue, tokens: vector(string), index: int) -> ref JsonValue {
    if (index >= tokens.size()) {
        return node;
    }
    let step = tokens[index];
    if (node.kind == JsonKind.Object) {
        return resolve_tokens(node.member(step), tokens, index + 1);
    }
    if (node.kind == JsonKind.Array) {
        if (not is_index_token(step)) {
            return node;
        }
        return resolve_tokens(node.at(parse_int(step)), tokens, index + 1);
    }
    return node;
}

// json::at(root, "/servers/0/host")
fn at_pointer(ref root: JsonValue, path: string) -> ref JsonValue {
    let tokens = split_pointer(path);
    return resolve_tokens(root, tokens, 0);
}

fn tokens_exist(node: JsonValue, tokens: vector(string), index: int) -> bool {
    if (index >= tokens.size()) {
        return true;
    }
    let step = tokens[index];
    if (node.kind == JsonKind.Object) {
        let slot = node.index_of(step);
        if (slot < 0) {
            return false;
        }
        return tokens_exist(node.values[slot], tokens, index + 1);
    }
    if (node.kind == JsonKind.Array) {
        if (not is_index_token(step)) {
            return false;
        }
        let position = parse_int(step);
        if (position >= node.items.size()) {
            return false;
        }
        return tokens_exist(node.items[position], tokens, index + 1);
    }
    return false;
}

fn pointer_exists(root: JsonValue, path: string) -> bool {
    let tokens = split_pointer(path);
    return tokens_exist(root, tokens, 0);
}

// --- Merge ---------------------------------------------------------------

// A merge patch in the style of RFC 7386: objects are merged member by
// member, a null member deletes the key, and everything else replaces the
// target outright.
fn merge_patch(target: JsonValue, patch: JsonValue) -> JsonValue {
    if (patch.kind != JsonKind.Object) {
        return *patch;
    }
    var out = make_object();
    if (target.kind == JsonKind.Object) {
        var slot: int = 0;
        while (slot < target.keys.size()) {
            out.keys.push_back(target.keys[slot]);
            out.values.push_back(target.values[slot]);
            slot += 1;
        }
    }
    var index: int = 0;
    while (index < patch.keys.size()) {
        let key = patch.keys[index];
        let update = patch.values[index];
        if (update.kind == JsonKind.Null) {
            Discard(out.remove_member(key));
        } else {
            let existing = out.index_of(key);
            if (existing >= 0) {
                out.values[existing] = merge_patch(out.values[existing], update);
            } else {
                out.keys.push_back(key);
                out.values.push_back(merge_patch(make_null(), update));
            }
        }
        index += 1;
    }
    return out;
}

// Merge two documents given as text and hand back the pretty printed result.
fn merge_sources(base_: string, overlay: string) -> string {
    let left = parse(base_);
    if (not left.ok()) {
        return left.problem.render();
    }
    let right = parse(overlay);
    if (not right.ok()) {
        return right.problem.render();
    }
    let merged = merge_patch(left.root, right.root);
    Prove(merged.kind == JsonKind.Object or merged.kind == right.root.kind);
    return write_pretty(merged);
}

// A deterministic 2D rigid-body physics engine in fixed-point arithmetic.
//
// Everything in this file is integer maths. The language accepts no float
// literals, and a physics engine that has to be replayable across machines
// does not want them anyway: two runs of the same scene on two machines must
// produce bit-identical results, which is exactly what fixed point buys.
//
// The layout follows the usual pipeline:
//
//     integrate forces -> broad phase -> narrow phase -> solve -> integrate
//     velocities -> position correction
//
// Each stage is its own section below. The scalar, vector and matrix types at
// the top carry a full set of operator impls so that the maths in the later
// stages reads as ordinary algebra over chained member accesses, for example
//
//     body.velocity.x + contact.normal.x * impulse.magnitude
//
// rather than as a ladder of named helper calls.
namespace physics;

// --- Fixed-point configuration -------------------------------------------

// Number of fractional bits in a Fixed. One unit of the underlying integer is
// 1 / 65536 of a whole number, which gives roughly 4.5 decimal digits of
// fraction. That is enough for contact positions measured in metres while
// leaving 47 bits of integer range in a 64-bit accumulator.
let FIXED_SHIFT: int = 16;

// 2^16. The raw value of the number one. Every conversion in this file is a
// multiply or divide by this constant.
let FIXED_ONE: int = 65536;

// 2^15, one half. Used for the round-to-nearest step in multiply and divide.
let FIXED_HALF: int = 32768;

// 2^14, one quarter.
let FIXED_QUARTER: int = 16384;

// 2^16 - 1, the mask that isolates the fractional part of a raw value.
let FIXED_FRACTION_MASK: int = 65535;

// 2^32, the raw value of 65536.0. Products of two Fixed values are shifted
// back down by FIXED_SHIFT, so an intermediate may reach this magnitude
// multiplied by the operand range before the shift happens.
let FIXED_ONE_SQUARED: int = 4294967296;

// Largest and smallest representable raw values, leaving generous headroom so
// that a runaway simulation saturates instead of wrapping.
let FIXED_MAX_RAW: int = 140737488355328;
let FIXED_MIN_RAW: int = -140737488355328;

// pi, tau and half pi in raw fixed-point units:
//   pi      = 3.14159265 * 65536 = 205887
//   tau     = 6.28318531 * 65536 = 411775
//   half pi = 1.57079633 * 65536 = 102944
let FIXED_PI_RAW: int = 205887;
let FIXED_TAU_RAW: int = 411775;
let FIXED_HALF_PI_RAW: int = 102944;
let FIXED_QUARTER_PI_RAW: int = 51472;

// 1 / pi and 2 / pi, for range reduction without a division.
let FIXED_INV_PI_RAW: int = 20861;
let FIXED_TWO_OVER_PI_RAW: int = 41722;

// Small epsilons. LINEAR_EPSILON is about 1/1000 of a unit and is the
// threshold below which a length is treated as zero; ANGULAR_EPSILON is
// about 1/10000 of a radian.
let LINEAR_EPSILON_RAW: int = 66;
let ANGULAR_EPSILON_RAW: int = 7;

// Square of LINEAR_EPSILON, kept separately so that length comparisons can
// avoid the square root entirely.
let LINEAR_EPSILON_SQUARED_RAW: int = 1;

// Newton iteration budget for the square root and the reciprocal. Both
// converge quadratically, so six steps is far more than the 16 fractional
// bits require; the extra steps only cost when the initial guess is poor.
let SQRT_ITERATION_LIMIT: int = 6;
let RECIPROCAL_ITERATION_LIMIT: int = 5;

// Instrumentation counters. A profiler run reads these to see which stage of
// the pipeline dominated a frame.
var fixed_multiply_count: int = 0;
var fixed_divide_count: int = 0;
var fixed_sqrt_count: int = 0;
var narrow_phase_test_count: int = 0;
var broad_phase_pair_count: int = 0;
var solver_iteration_count: int = 0;

// The apostrophe, spelled as a string because the character literal form for
// it is not available.
let APOSTROPHE: string = "'";

// --- Small enumerations ---------------------------------------------------

// Three-way comparison, shared by the scalar and the vector types.
choice Ordering {
    Less,
    Equal,
    Greater,
}

// Which of the three shape representations a Shape holds. There is no sum
// type in the language, so a Shape carries one of each payload and this tag
// says which payload is live.
choice ShapeKind {
    Circle,
    Box,
    Polygon,
}

// How a body participates in the simulation.
choice BodyKind {
    // Infinite mass, never moved by the solver, but may be teleported.
    Static,
    // Infinite mass, moved by its own velocity, unaffected by impulses.
    Kinematic,
    // Full participant.
    Dynamic,
}

// Result of a narrow-phase query.
choice ContactState {
    // The shapes are apart.
    Separated,
    // The shapes touch but the manifold is empty, which happens for exact
    // vertex-on-vertex contact.
    Touching,
    // A usable manifold with at least one point.
    Penetrating,
}

// Which feature of a polygon produced the deepest separating axis.
choice FeatureKind {
    FaceA,
    FaceB,
    VertexA,
    VertexB,
}

// Joint solver status, reported per joint per substep.
choice JointStatus {
    Satisfied,
    Corrected,
    Broken,
}

// --- The fixed-point scalar ----------------------------------------------
//
// A Fixed is a single integer interpreted as a multiple of 1 / FIXED_ONE.
// Addition and subtraction are exact integer operations on the raw value;
// multiplication and division need a shift to put the binary point back where
// it belongs, and that shift is the only place rounding happens.
//
// The struct is deliberately one field wide so that it can be passed by value
// everywhere without anybody worrying about aliasing.
class Fixed {

    // --- Construction -----------------------------------------------------

    // Reinterpret a raw integer as a Fixed. This is the identity conversion
    // and does no scaling at all.
    fn set_raw(ref self, value: int) {
        self.raw = value;
    }

    // The whole number n.
    fn set_whole(ref self, n: int) {
        self.raw = n * FIXED_ONE;
    }

    // The exact rational numerator / denominator, rounded to nearest. The
    // multiply happens before the divide so that the full precision of the
    // ratio survives into the result.
    fn set_ratio(ref self, numerator: int, denominator: int) {
        if (denominator == 0) {
            self.raw = 0;
            return;
        }
        let scaled = numerator * FIXED_ONE;
        if ((scaled < 0) != (denominator < 0)) {
            self.raw = (scaled - denominator / 2) / denominator;
        } else {
            self.raw = (scaled + denominator / 2) / denominator;
        }
    }

    // --- Queries ----------------------------------------------------------

    fn is_zero(self) -> bool {
        return self.raw == 0;
    }

    fn is_negative(self) -> bool {
        return self.raw < 0;
    }

    fn is_positive(self) -> bool {
        return self.raw > 0;
    }

    // Truncation towards zero, which is what the machine divide already does.
    fn to_int(self) -> int {
        return self.raw / FIXED_ONE;
    }

    // Largest whole number not greater than self. Integer division rounds
    // towards zero, so negatives need the extra step.
    fn floor_int(self) -> int {
        if (self.raw >= 0) {
            return self.raw / FIXED_ONE;
        }
        return -((-self.raw + FIXED_FRACTION_MASK) / FIXED_ONE);
    }

    fn ceil_int(self) -> int {
        return -((-self.raw) / FIXED_ONE);
    }

    // Round half away from zero.
    fn round_int(self) -> int {
        if (self.raw >= 0) {
            return (self.raw + FIXED_HALF) / FIXED_ONE;
        }
        return -((-self.raw + FIXED_HALF) / FIXED_ONE);
    }

    // The fractional part, always in [0, 1).
    fn fraction(self) -> Fixed {
        var result: Fixed;
        result.raw = self.raw - self.floor_int() * FIXED_ONE;
        return result;
    }

    fn magnitude(self) -> Fixed {
        var result: Fixed;
        if (self.raw < 0) {
            result.raw = -self.raw;
        } else {
            result.raw = self.raw;
        }
        return result;
    }

    fn negated(self) -> Fixed {
        var result: Fixed;
        result.raw = -self.raw;
        return result;
    }

    // -1, 0 or +1 as a whole Fixed.
    fn sign_unit(self) -> Fixed {
        var result: Fixed;
        if (self.raw > 0) {
            result.raw = FIXED_ONE;
        } else {
            if (self.raw < 0) {
                result.raw = -FIXED_ONE;
            } else {
                result.raw = 0;
            }
        }
        return result;
    }

    fn compare(self, other: Fixed) -> Ordering {
        if (self.raw < other.raw) {
            return Ordering.Less;
        }
        if (self.raw > other.raw) {
            return Ordering.Greater;
        }
        return Ordering.Equal;
    }

    // --- Core arithmetic --------------------------------------------------

    fn added(self, other: Fixed) -> Fixed {
        var result: Fixed;
        result.raw = self.raw + other.raw;
        return result;
    }

    fn subtracted(self, other: Fixed) -> Fixed {
        var result: Fixed;
        result.raw = self.raw - other.raw;
        return result;
    }

    // Product with round-to-nearest. The intermediate .raw * other.raw is a
    // 2 * FIXED_SHIFT fractional-bit number; adding FIXED_HALF before the
    // shift rounds instead of truncating, which keeps the multiply unbiased
    // and stops a long chain of multiplies drifting towards zero.
    fn multiplied(self, other: Fixed) -> Fixed {
        fixed_multiply_count += 1;
        var result: Fixed;
        let product = self.raw * other.raw;
        if (product < 0) {
            result.raw = -((-product + FIXED_HALF) >> FIXED_SHIFT);
        } else {
            result.raw = (product + FIXED_HALF) >> FIXED_SHIFT;
        }
        return result;
    }

    // Quotient with round-to-nearest. The numerator is pre-shifted so that
    // the fractional bits survive the integer divide.
    fn divided(self, other: Fixed) -> Fixed {
        fixed_divide_count += 1;
        var result: Fixed;
        if (other.raw == 0) {
            if (self.raw >= 0) {
                result.raw = FIXED_MAX_RAW;
            } else {
                result.raw = FIXED_MIN_RAW;
            }
            return result;
        }
        let numerator = self.raw << FIXED_SHIFT;
        if ((numerator < 0) != (other.raw < 0)) {
            result.raw = (numerator - other.raw / 2) / other.raw;
        } else {
            result.raw = (numerator + other.raw / 2) / other.raw;
        }
        return result;
    }

    // Scaling by a whole number, which needs no shift and so no rounding.
    fn scaled_by_int(self, n: int) -> Fixed {
        var result: Fixed;
        result.raw = self.raw * n;
        return result;
    }

    fn divided_by_int(self, n: int) -> Fixed {
        var result: Fixed;
        if (n == 0) {
            result.raw = 0;
            return result;
        }
        result.raw = self.raw / n;
        return result;
    }

    // Self multiplied by itself. Worth a name of its own because squared
    // lengths appear on nearly every hot path in the narrow phase.
    fn squared(self) -> Fixed {
        return self.multiplied(self);
    }

    // --- Roots and reciprocals --------------------------------------------

    // Integer square root of the raw value, by Newton's method on integers.
    // sqrt(x) in fixed point is sqrt(raw / ONE) = sqrt(raw * ONE) / ONE, so
    // the raw value is pre-multiplied by FIXED_ONE before the integer root.
    fn square_root(self) -> Fixed {
        fixed_sqrt_count += 1;
        var result: Fixed;
        if (self.raw <= 0) {
            result.raw = 0;
            return result;
        }
        let target = self.raw * FIXED_ONE;
        var guess = self.raw;
        if (guess < FIXED_ONE) {
            guess = FIXED_ONE;
        }
        var step: int = 0;
        while (step < SQRT_ITERATION_LIMIT) {
            let next = (guess + target / guess) / 2;
            if (next == guess) {
                step = SQRT_ITERATION_LIMIT;
            } else {
                guess = next;
                step += 1;
            }
        }
        // One clean-up pass: Newton on integers can leave the estimate one
        // unit high but never more than one.
        while (guess > 1 and guess * guess > target) {
            guess -= 1;
        }
        result.raw = guess;
        return result;
    }

    // 1 / self, by Newton-Raphson on the reciprocal. The iteration is
    //     next = guess * (2 - self * guess)
    // which doubles the number of correct bits each pass. The initial guess
    // comes from the plain divide, so in practice one pass is enough and the
    // rest only tighten the last bit.
    fn reciprocal(self) -> Fixed {
        var one: Fixed;
        one.raw = FIXED_ONE;
        if (self.raw == 0) {
            var saturated: Fixed;
            saturated.raw = FIXED_MAX_RAW;
            return saturated;
        }
        var guess = one.divided(self);
        var two: Fixed;
        two.raw = FIXED_ONE * 2;
        var step: int = 0;
        while (step < RECIPROCAL_ITERATION_LIMIT) {
            let correction = two.subtracted(self.multiplied(guess));
            guess = guess.multiplied(correction);
            step += 1;
        }
        return guess;
    }

    // --- Clamping and blending --------------------------------------------

    fn clamped(self, low: Fixed, high: Fixed) -> Fixed {
        var result: Fixed;
        if (self.raw < low.raw) {
            result.raw = low.raw;
            return result;
        }
        if (self.raw > high.raw) {
            result.raw = high.raw;
            return result;
        }
        result.raw = self.raw;
        return result;
    }

    // Linear blend towards other. t is expected in [0, 1] but the formula is
    // fine outside that range, which is what extrapolating a contact point
    // between substeps needs.
    fn blended(self, other: Fixed, t: Fixed) -> Fixed {
        let delta = other.subtracted(self);
        return self.added(delta.multiplied(t));
    }

    // Move at most limit towards target. Used by the motor joints so that a
    // motor cannot overshoot its own set point in a single substep.
    fn stepped_towards(self, target: Fixed, limit: Fixed) -> Fixed {
        let delta = target.subtracted(self);
        if (delta.magnitude().raw <= limit.raw) {
            return target.added(zero_fixed());
        }
        return self.added(delta.sign_unit().multiplied(limit));
    }

    // The single raw integer, in units of 1 / FIXED_ONE.
    var raw: int = 0;
}

// --- Fixed constructors as free functions ---------------------------------
//
// Struct literals with designated arguments would work here, but a named
// constructor keeps the scale conversion visible at the call site, which is
// the single easiest thing to get wrong in a fixed-point codebase.

fn raw_fixed(value: int) -> Fixed {
    var result: Fixed;
    result.raw = value;
    return result;
}

fn whole(n: int) -> Fixed {
    var result: Fixed;
    result.raw = n * FIXED_ONE;
    return result;
}

fn ratio(numerator: int, denominator: int) -> Fixed {
    var result: Fixed;
    result.set_ratio(numerator, denominator);
    return result;
}

fn zero_fixed() -> Fixed {
    return raw_fixed(0);
}

fn one_fixed() -> Fixed {
    return raw_fixed(FIXED_ONE);
}

fn half_fixed() -> Fixed {
    return raw_fixed(FIXED_HALF);
}

fn pi_fixed() -> Fixed {
    return raw_fixed(FIXED_PI_RAW);
}

fn tau_fixed() -> Fixed {
    return raw_fixed(FIXED_TAU_RAW);
}

fn epsilon_fixed() -> Fixed {
    return raw_fixed(LINEAR_EPSILON_RAW);
}

// --- Fixed operator implementations ---------------------------------------
//
// These give the named methods above their infix spelling. Nothing else in
// this file calls Fixed.added or Fixed.multiplied directly; from here down
// the physics is written as ordinary algebra, which is the whole point of
// declaring them.

impl Fixed as Core.AddWith(Fixed) where .Result = Fixed {
  fn Op(self, other: Fixed) -> Fixed {
      return self.added(other);
  }
}
impl Fixed as Core.SubWith(Fixed) where .Result = Fixed {
  fn Op(self, other: Fixed) -> Fixed {
      return self.subtracted(other);
  }
}
impl Fixed as Core.MulWith(Fixed) where .Result = Fixed {
  fn Op(self, other: Fixed) -> Fixed {
      return self.multiplied(other);
  }
}
impl Fixed as Core.DivWith(Fixed) where .Result = Fixed {
  fn Op(self, other: Fixed) -> Fixed {
      return self.divided(other);
  }
}

// Remainder in fixed point: the raw values divide exactly, so the machine
// remainder is already correctly scaled.
impl Fixed as Core.ModWith(Fixed) where .Result = Fixed {
  fn Op(self, other: Fixed) -> Fixed {
      if (other.raw == 0) {
          return zero_fixed();
      }
      return raw_fixed(self.raw % other.raw);
  }
}
impl Fixed as Core.OrderedWith(Fixed) {
  fn Less(self, other: Fixed) -> bool {
      return self.raw < other.raw;
  }

  fn LessOrEquivalent(self, other: Fixed) -> bool {
      return self.raw <= other.raw;
  }

  fn Greater(self, other: Fixed) -> bool {
      return self.raw > other.raw;
  }

  fn GreaterOrEquivalent(self, other: Fixed) -> bool {
      return self.raw >= other.raw;
  }
}
impl Fixed as Core.EqWith(Fixed) {
  fn Equal(self, other: Fixed) -> bool {
      return self.raw == other.raw;
  }

  fn NotEqual(self, other: Fixed) -> bool {
      return self.raw != other.raw;
  }
}

// Unary negation. Exact: no rounding is involved.
impl Fixed as Core.Negate where .Result = Fixed {
  fn Op(self) -> Fixed {
      return raw_fixed(-self.raw);
  }
}

// Mixed scalar forms, so that a whole-number coefficient does not have to be
// wrapped at every call site.
impl Fixed as Core.MulWith(int) where .Result = Fixed {
  fn Op(self, other: int) -> Fixed {
      return raw_fixed(self.raw * other);
  }
}
impl Fixed as Core.DivWith(int) where .Result = Fixed {
  fn Op(self, other: int) -> Fixed {
      return self.divided_by_int(other);
  }
}

// --- Free-function scalar helpers -----------------------------------------

fn fixed_min(a: Fixed, b: Fixed) -> Fixed {
    if (a.raw < b.raw) {
        return raw_fixed(a.raw);
    }
    return raw_fixed(b.raw);
}

fn fixed_max(a: Fixed, b: Fixed) -> Fixed {
    if (a.raw > b.raw) {
        return raw_fixed(a.raw);
    }
    return raw_fixed(b.raw);
}

fn fixed_abs(a: Fixed) -> Fixed {
    return a.magnitude();
}

fn fixed_clamp(value: Fixed, low: Fixed, high: Fixed) -> Fixed {
    return value.clamped(low, high);
}

fn fixed_sqrt(a: Fixed) -> Fixed {
    return a.square_root();
}

// True when the two values are within tolerance of each other. Every
// floating-comparison instinct in a physics engine should route through here.
fn fixed_near(a: Fixed, b: Fixed, tolerance: Fixed) -> bool {
    return (a - b).magnitude() <= tolerance;
}

fn fixed_near_zero(a: Fixed) -> bool {
    return a.magnitude().raw <= LINEAR_EPSILON_RAW;
}

// --- Angle handling -------------------------------------------------------

// Fold an angle into (-pi, pi]. The loop runs at most a couple of times for
// any angle a simulation actually produces; the guard is there for the case
// where an angular velocity has already exploded.
fn normalise_angle(angle: Fixed) -> Fixed {
    var result = raw_fixed(angle.raw);
    var guard: int = 0;
    while (result.raw > FIXED_PI_RAW and guard < 64) {
        result.raw -= FIXED_TAU_RAW;
        guard += 1;
    }
    while (result.raw <= -FIXED_PI_RAW and guard < 64) {
        result.raw += FIXED_TAU_RAW;
        guard += 1;
    }
    return result;
}

// Signed shortest angular distance from a to b, in (-pi, pi].
fn angle_delta(a: Fixed, b: Fixed) -> Fixed {
    return normalise_angle(b - a);
}

// --- Trigonometry ---------------------------------------------------------
//
// sin is approximated by the Bhaskara I rational form on [0, pi]:
//
//     sin(x) = 16 x (pi - x) / (5 pi^2 - 4 x (pi - x))
//
// which is accurate to about 1 part in 1000 across the whole half period,
// comfortably better than the 16 fractional bits can express near the peak
// and far cheaper than a Taylor series. Symmetry handles the other half.
fn fixed_sin(angle: Fixed) -> Fixed {
    let folded = normalise_angle(angle);
    var x = raw_fixed(folded.raw);
    var negate: bool = false;
    if (x.raw < 0) {
        x.raw = -x.raw;
        negate = true;
    }
    let pi = pi_fixed();
    let gap = pi - x;
    let product = x * gap;
    let numerator = product * 16;
    let denominator = pi * pi * 5 - product * 4;
    var result = numerator / denominator;
    if (negate) {
        result = -result;
    }
    return result;
}

fn fixed_cos(angle: Fixed) -> Fixed {
    return fixed_sin(angle + raw_fixed(FIXED_HALF_PI_RAW));
}

fn fixed_tan(angle: Fixed) -> Fixed {
    let c = fixed_cos(angle);
    if (c.magnitude().raw < LINEAR_EPSILON_RAW) {
        if (fixed_sin(angle).raw >= 0) {
            return raw_fixed(FIXED_MAX_RAW);
        }
        return raw_fixed(FIXED_MIN_RAW);
    }
    return fixed_sin(angle) / c;
}

// atan on [0, 1], by the standard minimax cubic
//
//     atan(x) = x * (pi/4) - x (|x| - 1) (0.2447 + 0.0663 |x|)
//
// with the two coefficients written as fixed-point raw values:
//     0.2447 * 65536 = 16035
//     0.0663 * 65536 = 4345
fn atan_unit(x: Fixed) -> Fixed {
    let magnitude = x.magnitude();
    let c1 = raw_fixed(16035);
    let c2 = raw_fixed(4345);
    let quarter_pi = raw_fixed(FIXED_QUARTER_PI_RAW);
    return x * quarter_pi - x * (magnitude - one_fixed()) * (c1 + c2 * magnitude);
}

// Full-circle arctangent, with the usual quadrant table. Returns a value in
// (-pi, pi].
fn fixed_atan2(y: Fixed, x: Fixed) -> Fixed {
    if (x.raw == 0 and y.raw == 0) {
        return zero_fixed();
    }
    let ax = x.magnitude();
    let ay = y.magnitude();
    if (ax >= ay) {
        let base_ = atan_unit(y / x);
        if (x.raw >= 0) {
            return base_;
        }
        if (y.raw >= 0) {
            return base_ + pi_fixed();
        }
        return base_ - pi_fixed();
    }
    let base_ = raw_fixed(FIXED_HALF_PI_RAW) - atan_unit(x / y);
    if (y.raw >= 0) {
        return base_;
    }
    return base_ - pi_fixed();
}

// asin on [-1, 1], derived from atan2 so that only one approximation has to
// be trusted. asin(x) = atan2(x, sqrt(1 - x^2)).
fn fixed_asin(x: Fixed) -> Fixed {
    let clamped = x.clamped(-one_fixed(), one_fixed());
    let complement = (one_fixed() - clamped * clamped).square_root();
    return fixed_atan2(clamped, complement);
}

fn fixed_acos(x: Fixed) -> Fixed {
    return raw_fixed(FIXED_HALF_PI_RAW) - fixed_asin(x);
}

// --- Vec2 -----------------------------------------------------------------
//
// The two-dimensional vector. Every component is a Fixed, so a Vec2 is two
// integers wide and is passed by value throughout.
//
// The cross product of two 2D vectors is a scalar (the z component of the 3D
// cross product) and the cross product of a scalar and a vector is a vector.
// Both spellings appear constantly in the angular parts of the solver, so
// both get a name here.
class Vec2 {

    fn set(ref self, nx: Fixed, ny: Fixed) {
        self.x = nx + zero_fixed();
        self.y = ny + zero_fixed();
    }

    fn set_zero(ref self) {
        self.x = zero_fixed();
        self.y = zero_fixed();
    }

    fn is_zero(self) -> bool {
        return self.x.raw == 0 and self.y.raw == 0;
    }

    // Dot product. This one line is the workhorse of the entire solver: every
    // relative velocity along a contact normal is a dot product.
    fn dot(self, other: Vec2) -> Fixed {
        return self.x * other.x + self.y * other.y;
    }

    // Scalar cross product, positive when other is counter-clockwise of self.
    fn cross(self, other: Vec2) -> Fixed {
        return self.x * other.y - self.y * other.x;
    }

    // Cross of self with a scalar, which rotates self by -90 degrees and
    // scales it. Equivalent to cross(self, s * z_hat).
    fn cross_scalar(self, s: Fixed) -> Vec2 {
        return make_vec2(self.y * s, -self.x * s);
    }

    fn length_squared(self) -> Fixed {
        return self.x * self.x + self.y * self.y;
    }

    fn length(self) -> Fixed {
        return (self.x * self.x + self.y * self.y).square_root();
    }

    // Manhattan length, used by the broad phase where an exact length would
    // be wasted work.
    fn manhattan_length(self) -> Fixed {
        return self.x.magnitude() + self.y.magnitude();
    }

    fn chebyshev_length(self) -> Fixed {
        return fixed_max(self.x.magnitude(), self.y.magnitude());
    }

    // Unit vector in the same direction, or the zero vector when self is too
    // short to have a direction at all.
    fn normalised(self) -> Vec2 {
        let len = self.length();
        if (len.raw <= LINEAR_EPSILON_RAW) {
            return make_vec2(zero_fixed(), zero_fixed());
        }
        let inverse = len.reciprocal();
        return make_vec2(self.x * inverse, self.y * inverse);
    }

    // Normalise in place and report the length that was removed. The solver
    // wants both, and computing the length twice is the sort of thing that
    // shows up in a profile.
    fn normalise_in_place(ref self) -> Fixed {
        let len = self.length();
        if (len.raw <= LINEAR_EPSILON_RAW) {
            self.x = zero_fixed();
            self.y = zero_fixed();
            return zero_fixed();
        }
        let inverse = len.reciprocal();
        self.x = self.x * inverse;
        self.y = self.y * inverse;
        return len;
    }

    // Rotated by +90 degrees: (x, y) becomes (-y, x).
    fn perpendicular(self) -> Vec2 {
        return make_vec2(-self.y, self.x);
    }

    // Rotated by -90 degrees.
    fn perpendicular_cw(self) -> Vec2 {
        return make_vec2(self.y, -self.x);
    }

    // Rotate by an arbitrary angle, given its sine and cosine. Passing the
    // pair in rather than the angle lets a caller hoist the trig out of a
    // loop over many vertices.
    fn rotated_by(self, cosine: Fixed, sine: Fixed) -> Vec2 {
        return make_vec2(self.x * cosine - self.y * sine, self.x * sine + self.y * cosine);
    }

    fn rotated(self, angle: Fixed) -> Vec2 {
        return self.rotated_by(fixed_cos(angle), fixed_sin(angle));
    }

    fn angle(self) -> Fixed {
        return fixed_atan2(self.y, self.x);
    }

    // Componentwise minimum and maximum, which is how an AABB grows.
    fn componentwise_min(self, other: Vec2) -> Vec2 {
        return make_vec2(fixed_min(self.x, other.x), fixed_min(self.y, other.y));
    }

    fn componentwise_max(self, other: Vec2) -> Vec2 {
        return make_vec2(fixed_max(self.x, other.x), fixed_max(self.y, other.y));
    }

    fn componentwise_multiply(self, other: Vec2) -> Vec2 {
        return make_vec2(self.x * other.x, self.y * other.y);
    }

    fn absolute(self) -> Vec2 {
        return make_vec2(self.x.magnitude(), self.y.magnitude());
    }

    fn negated(self) -> Vec2 {
        return make_vec2(-self.x, -self.y);
    }

    // Distance and squared distance to another point.
    fn distance_to(self, other: Vec2) -> Fixed {
        let dx = other.x - self.x;
        let dy = other.y - self.y;
        return (dx * dx + dy * dy).square_root();
    }

    fn distance_squared_to(self, other: Vec2) -> Fixed {
        let dx = other.x - self.x;
        let dy = other.y - self.y;
        return dx * dx + dy * dy;
    }

    // Linear blend from self to other.
    fn blended(self, other: Vec2, t: Fixed) -> Vec2 {
        return make_vec2(self.x + (other.x - self.x) * t, self.y + (other.y - self.y) * t);
    }

    // Reflect across a unit normal: v - 2 (v . n) n.
    fn reflected(self, normal: Vec2) -> Vec2 {
        let scale = self.dot(normal) * 2;
        return make_vec2(self.x - normal.x * scale, self.y - normal.y * scale);
    }

    // Component of self along a unit direction, as a vector.
    fn projected_onto(self, direction: Vec2) -> Vec2 {
        let amount = self.dot(direction);
        return make_vec2(direction.x * amount, direction.y * amount);
    }

    // The part of self that is orthogonal to direction.
    fn rejected_from(self, direction: Vec2) -> Vec2 {
        let along = self.projected_onto(direction);
        return make_vec2(self.x - along.x, self.y - along.y);
    }

    // Clamp the length without changing the direction. Used to cap velocity
    // so that one bad frame cannot fling a body across the world.
    fn clamped_length(self, limit: Fixed) -> Vec2 {
        let squared = self.length_squared();
        if (squared <= limit * limit) {
            return make_vec2(self.x, self.y);
        }
        let unit = self.normalised();
        return make_vec2(unit.x * limit, unit.y * limit);
    }

    fn scaled(self, factor: Fixed) -> Vec2 {
        return make_vec2(self.x * factor, self.y * factor);
    }

    var x: Fixed;
    var y: Fixed;
}

fn make_vec2(x: Fixed, y: Fixed) -> Vec2 {
    var result: Vec2;
    result.x = x + zero_fixed();
    result.y = y + zero_fixed();
    return result;
}

fn vec2_from_ints(x: int, y: int) -> Vec2 {
    return make_vec2(whole(x), whole(y));
}

fn vec2_zero() -> Vec2 {
    return make_vec2(zero_fixed(), zero_fixed());
}

fn vec2_unit_x() -> Vec2 {
    return make_vec2(one_fixed(), zero_fixed());
}

fn vec2_unit_y() -> Vec2 {
    return make_vec2(zero_fixed(), one_fixed());
}

// The unit vector at the given angle.
fn vec2_from_angle(angle: Fixed) -> Vec2 {
    return make_vec2(fixed_cos(angle), fixed_sin(angle));
}

// --- Vec2 operator implementations ----------------------------------------

impl Vec2 as Core.AddWith(Vec2) where .Result = Vec2 {
  fn Op(self, other: Vec2) -> Vec2 {
      return make_vec2(self.x + other.x, self.y + other.y);
  }
}
impl Vec2 as Core.SubWith(Vec2) where .Result = Vec2 {
  fn Op(self, other: Vec2) -> Vec2 {
      return make_vec2(self.x - other.x, self.y - other.y);
  }
}

// Vector times scalar. The reverse order is declared just below so that both
// `n * s` and `s * n` read naturally in the impulse expressions.
impl Vec2 as Core.MulWith(Fixed) where .Result = Vec2 {
  fn Op(self, other: Fixed) -> Vec2 {
      return make_vec2(self.x * other, self.y * other);
  }
}
impl Fixed as Core.MulWith(Vec2) where .Result = Vec2 {
  fn Op(self, other: Vec2) -> Vec2 {
      return make_vec2(other.x * self, other.y * self);
  }
}

// Vector times integer, for the many places where the coefficient is a small
// whole number such as the 2 in a reflection.
impl Vec2 as Core.MulWith(int) where .Result = Vec2 {
  fn Op(self, other: int) -> Vec2 {
      return make_vec2(self.x * other, self.y * other);
  }
}
impl Vec2 as Core.DivWith(Fixed) where .Result = Vec2 {
  fn Op(self, other: Fixed) -> Vec2 {
      return make_vec2(self.x / other, self.y / other);
  }
}
impl Vec2 as Core.DivWith(int) where .Result = Vec2 {
  fn Op(self, other: int) -> Vec2 {
      return make_vec2(self.x / other, self.y / other);
  }
}

// Componentwise product. Spelled with % rather than * so that it can never be
// confused with a scaling; a physics reader seeing v % w knows both operands
// are vectors.
impl Vec2 as Core.ModWith(Vec2) where .Result = Vec2 {
  fn Op(self, other: Vec2) -> Vec2 {
      return make_vec2(self.x * other.x, self.y * other.y);
  }
}
impl Vec2 as Core.EqWith(Vec2) {
  fn Equal(self, other: Vec2) -> bool {
      return self.x.raw == other.x.raw and self.y.raw == other.y.raw;
  }

  fn NotEqual(self, other: Vec2) -> bool {
      return self.x.raw != other.x.raw or self.y.raw != other.y.raw;
  }
}

// Ordering by length, which gives sort() something to work with when the
// broad phase wants its pair list in a deterministic order.
impl Vec2 as Core.OrderedWith(Vec2) {
  fn Less(self, other: Vec2) -> bool {
      return self.length_squared() < other.length_squared();
  }

  fn LessOrEquivalent(self, other: Vec2) -> bool {
      return self.length_squared() <= other.length_squared();
  }

  fn Greater(self, other: Vec2) -> bool {
      return self.length_squared() > other.length_squared();
  }

  fn GreaterOrEquivalent(self, other: Vec2) -> bool {
      return self.length_squared() >= other.length_squared();
  }
}
impl Vec2 as Core.Negate where .Result = Vec2 {
  fn Op(self) -> Vec2 {
      return make_vec2(-self.x, -self.y);
  }
}

// --- Vec2 free functions --------------------------------------------------

fn dot(a: Vec2, b: Vec2) -> Fixed {
    return a.x * b.x + a.y * b.y;
}

fn cross(a: Vec2, b: Vec2) -> Fixed {
    return a.x * b.y - a.y * b.x;
}

// s cross v, the vector form. Rotates v by +90 degrees and scales by s.
fn cross_scalar_vec(s: Fixed, v: Vec2) -> Vec2 {
    return make_vec2(-s * v.y, s * v.x);
}

// v cross s, the other vector form.
fn cross_vec_scalar(v: Vec2, s: Fixed) -> Vec2 {
    return make_vec2(s * v.y, -s * v.x);
}

fn vec2_lerp(a: Vec2, b: Vec2, t: Fixed) -> Vec2 {
    return a + (b - a) * t;
}

// The point on segment [a, b] closest to p, and the parameter that produced
// it. Both the circle-polygon test and the distance joint want this.
fn closest_point_on_segment(a: Vec2, b: Vec2, p: Vec2) -> Vec2 {
    let edge = b - a;
    let length_squared = edge.length_squared();
    if (length_squared.raw <= LINEAR_EPSILON_RAW) {
        return make_vec2(a.x, a.y);
    }
    let t = ((p - a).dot(edge) / length_squared).clamped(zero_fixed(), one_fixed());
    return a + edge * t;
}

fn segment_parameter(a: Vec2, b: Vec2, p: Vec2) -> Fixed {
    let edge = b - a;
    let length_squared = edge.length_squared();
    if (length_squared.raw <= LINEAR_EPSILON_RAW) {
        return zero_fixed();
    }
    return ((p - a).dot(edge) / length_squared).clamped(zero_fixed(), one_fixed());
}

// Signed area of the triangle abc, positive when the winding is
// counter-clockwise. Used by the polygon builder to reject a bad winding.
fn triangle_area_twice(a: Vec2, b: Vec2, c: Vec2) -> Fixed {
    return (b.x - a.x) * (c.y - a.y) - (b.y - a.y) * (c.x - a.x);
}

// --- Mat2 -----------------------------------------------------------------
//
// A 2x2 matrix stored as two column vectors. Columns rather than rows because
// the columns of a rotation matrix are the images of the basis vectors, which
// makes `m * v` a two-term combination of the columns and makes building a
// rotation from a sine and cosine obvious.
//
//     | col_x.x  col_y.x |
//     | col_x.y  col_y.y |
class Mat2 {

    fn set_identity(ref self) {
        self.col_x = make_vec2(one_fixed(), zero_fixed());
        self.col_y = make_vec2(zero_fixed(), one_fixed());
    }

    fn set_rotation(ref self, angle: Fixed) {
        let c = fixed_cos(angle);
        let s = fixed_sin(angle);
        self.col_x = make_vec2(c, s);
        self.col_y = make_vec2(-s, c);
    }

    fn set_scale(ref self, sx: Fixed, sy: Fixed) {
        self.col_x = make_vec2(sx, zero_fixed());
        self.col_y = make_vec2(zero_fixed(), sy);
    }

    // --- Element access ---------------------------------------------------

    fn element(self, row: int, column: int) -> Fixed {
        if (column == 0) {
            if (row == 0) {
                return self.col_x.x + zero_fixed();
            }
            return self.col_x.y + zero_fixed();
        }
        if (row == 0) {
            return self.col_y.x + zero_fixed();
        }
        return self.col_y.y + zero_fixed();
    }

    fn row_x(self) -> Vec2 {
        return make_vec2(self.col_x.x, self.col_y.x);
    }

    fn row_y(self) -> Vec2 {
        return make_vec2(self.col_x.y, self.col_y.y);
    }

    // --- Products ---------------------------------------------------------

    // m * v, written out as a combination of the columns.
    fn transform(self, v: Vec2) -> Vec2 {
        return make_vec2(self.col_x.x * v.x + self.col_y.x * v.y, self.col_x.y * v.x + self.col_y.y * v.y);
    }

    // m^T * v. For a rotation this is the inverse transform, which is how a
    // world-space vector is pulled into a body's local frame.
    fn transform_transposed(self, v: Vec2) -> Vec2 {
        return make_vec2(self.col_x.x * v.x + self.col_x.y * v.y, self.col_y.x * v.x + self.col_y.y * v.y);
    }

    fn multiplied(self, other: Mat2) -> Mat2 {
        return make_mat2(self.transform(other.col_x), self.transform(other.col_y));
    }

    fn transposed(self) -> Mat2 {
        return make_mat2(make_vec2(self.col_x.x, self.col_y.x), make_vec2(self.col_x.y, self.col_y.y));
    }

    // --- Invariants -------------------------------------------------------

    fn determinant(self) -> Fixed {
        return self.col_x.x * self.col_y.y - self.col_y.x * self.col_x.y;
    }

    fn trace(self) -> Fixed {
        return self.col_x.x + self.col_y.y;
    }

    // Inverse by the adjugate over the determinant. A singular matrix returns
    // the zero matrix rather than saturating, so a caller that forgets to
    // check gets an obviously wrong answer instead of a plausible one.
    fn inverted(self) -> Mat2 {
        let d = self.determinant();
        if (d.magnitude().raw <= LINEAR_EPSILON_RAW) {
            return make_mat2(vec2_zero(), vec2_zero());
        }
        let inverse = d.reciprocal();
        return make_mat2(make_vec2(self.col_y.y * inverse, -self.col_x.y * inverse),
                         make_vec2(-self.col_y.x * inverse, self.col_x.x * inverse));
    }

    // Solve m * result = b directly by Cramer's rule, which is both cheaper
    // and better conditioned than forming the inverse. The two-point contact
    // solver calls this for its block solve.
    fn solve(self, b: Vec2) -> Vec2 {
        let d = self.col_x.x * self.col_y.y - self.col_y.x * self.col_x.y;
        if (d.magnitude().raw <= LINEAR_EPSILON_RAW) {
            return vec2_zero();
        }
        let inverse = d.reciprocal();
        return make_vec2((self.col_y.y * b.x - self.col_y.x * b.y) * inverse,
                         (self.col_x.x * b.y - self.col_x.y * b.x) * inverse);
    }

    // The rotation angle this matrix represents, assuming it is a rotation.
    fn angle(self) -> Fixed {
        return fixed_atan2(self.col_x.y, self.col_x.x);
    }

    // A rotation matrix has orthonormal columns; drift from repeated
    // composition is removed by re-normalising the first column and
    // rebuilding the second from it.
    fn orthonormalised(self) -> Mat2 {
        let first = self.col_x.normalised();
        return make_mat2(first, first.perpendicular());
    }

    fn is_identity(self) -> bool {
        return self.col_x.x.raw == FIXED_ONE and self.col_x.y.raw == 0
            and self.col_y.x.raw == 0 and self.col_y.y.raw == FIXED_ONE;
    }

    fn negated(self) -> Mat2 {
        return make_mat2(-self.col_x, -self.col_y);
    }

    fn scaled(self, factor: Fixed) -> Mat2 {
        return make_mat2(self.col_x * factor, self.col_y * factor);
    }

    var col_x: Vec2;
    var col_y: Vec2;
}

fn make_mat2(col_x: Vec2, col_y: Vec2) -> Mat2 {
    var result: Mat2;
    result.col_x = col_x + vec2_zero();
    result.col_y = col_y + vec2_zero();
    return result;
}

fn mat2_identity() -> Mat2 {
    return make_mat2(vec2_unit_x(), vec2_unit_y());
}

fn mat2_zero() -> Mat2 {
    return make_mat2(vec2_zero(), vec2_zero());
}

fn mat2_rotation(angle: Fixed) -> Mat2 {
    let c = fixed_cos(angle);
    let s = fixed_sin(angle);
    return make_mat2(make_vec2(c, s), make_vec2(-s, c));
}

// The outer product a b^T, which is how a rank-one correction to an inertia
// tensor is built.
fn mat2_outer(a: Vec2, b: Vec2) -> Mat2 {
    return make_mat2(make_vec2(a.x * b.x, a.y * b.x), make_vec2(a.x * b.y, a.y * b.y));
}

// --- Mat2 operator implementations ----------------------------------------

impl Mat2 as Core.AddWith(Mat2) where .Result = Mat2 {
  fn Op(self, other: Mat2) -> Mat2 {
      return make_mat2(self.col_x + other.col_x, self.col_y + other.col_y);
  }
}
impl Mat2 as Core.SubWith(Mat2) where .Result = Mat2 {
  fn Op(self, other: Mat2) -> Mat2 {
      return make_mat2(self.col_x - other.col_x, self.col_y - other.col_y);
  }
}

// Matrix times matrix, in the usual right-to-left composition order: the
// result applies r first and then l.
impl Mat2 as Core.MulWith(Mat2) where .Result = Mat2 {
  fn Op(self, other: Mat2) -> Mat2 {
      return make_mat2(self.transform(other.col_x), self.transform(other.col_y));
  }
}

// Matrix times vector.
impl Mat2 as Core.MulWith(Vec2) where .Result = Vec2 {
  fn Op(self, other: Vec2) -> Vec2 {
      return make_vec2(self.col_x.x * other.x + self.col_y.x * other.y, self.col_x.y * other.x + self.col_y.y * other.y);
  }
}

// Row vector times matrix, which is the transposed transform.
impl Vec2 as Core.MulWith(Mat2) where .Result = Vec2 {
  fn Op(self, other: Mat2) -> Vec2 {
      return make_vec2(other.col_x.x * self.x + other.col_x.y * self.y, other.col_y.x * self.x + other.col_y.y * self.y);
  }
}
impl Mat2 as Core.MulWith(Fixed) where .Result = Mat2 {
  fn Op(self, other: Fixed) -> Mat2 {
      return make_mat2(self.col_x * other, self.col_y * other);
  }
}
impl Fixed as Core.MulWith(Mat2) where .Result = Mat2 {
  fn Op(self, other: Mat2) -> Mat2 {
      return make_mat2(other.col_x * self, other.col_y * self);
  }
}
impl Mat2 as Core.DivWith(Fixed) where .Result = Mat2 {
  fn Op(self, other: Fixed) -> Mat2 {
      return make_mat2(self.col_x / other, self.col_y / other);
  }
}
impl Mat2 as Core.EqWith(Mat2) {
  fn Equal(self, other: Mat2) -> bool {
      return self.col_x == other.col_x and self.col_y == other.col_y;
  }

  fn NotEqual(self, other: Mat2) -> bool {
      return self.col_x != other.col_x or self.col_y != other.col_y;
  }
}

// Ordering by determinant, so that a degenerate matrix sorts below a healthy
// one. Only the debug tooling uses this.
impl Mat2 as Core.OrderedWith(Mat2) {
  fn Less(self, other: Mat2) -> bool {
      return self.determinant() < other.determinant();
  }

  fn Greater(self, other: Mat2) -> bool {
      return self.determinant() > other.determinant();
  }
}
impl Mat2 as Core.Negate where .Result = Mat2 {
  fn Op(self) -> Mat2 {
      return make_mat2(-self.col_x, -self.col_y);
  }
}

// --- Transform ------------------------------------------------------------
//
// A rigid transform: a rotation and a translation, with the rotation cached
// both as an angle and as the matrix built from it. The matrix is what every
// vertex transform actually uses; the angle is what the integrator advances.
class Transform {

    fn set_identity(ref self) {
        self.position = vec2_zero();
        self.angle = zero_fixed();
        self.rotation = mat2_identity();
    }

    // Rebuild the cached matrix after the angle has been integrated. This is
    // the only place the trig functions are called during a step.
    fn refresh(ref self) {
        self.angle = normalise_angle(self.angle);
        self.rotation = mat2_rotation(self.angle);
    }

    fn set_angle(ref self, value: Fixed) {
        self.angle = normalise_angle(value);
        self.rotation = mat2_rotation(self.angle);
    }

    // Local point to world point.
    fn apply(self, local: Vec2) -> Vec2 {
        return self.position + self.rotation * local;
    }

    // World point back to local.
    fn unapply(self, world: Vec2) -> Vec2 {
        return self.rotation.transform_transposed(world - self.position);
    }

    // Local direction to world direction: no translation.
    fn apply_direction(self, local: Vec2) -> Vec2 {
        return self.rotation * local;
    }

    fn unapply_direction(self, world: Vec2) -> Vec2 {
        return self.rotation.transform_transposed(world);
    }

    // The transform that undoes self.
    fn inverted(self) -> Transform {
        var result: Transform;
        result.angle = -self.angle;
        result.rotation = self.rotation.transposed();
        result.position = result.rotation * (-self.position);
        return result;
    }

    // self after other, so that applying the result equals applying other and
    // then applying self.
    fn composed(self, other: Transform) -> Transform {
        var result: Transform;
        result.angle = normalise_angle(self.angle + other.angle);
        result.rotation = self.rotation * other.rotation;
        result.position = self.position + self.rotation * other.position;
        return result;
    }

    var position: Vec2;
    var angle: Fixed;
    var rotation: Mat2;
}

fn make_transform(position: Vec2, angle: Fixed) -> Transform {
    var result: Transform;
    result.position = position + vec2_zero();
    result.angle = normalise_angle(angle);
    result.rotation = mat2_rotation(result.angle);
    return result;
}

fn transform_identity() -> Transform {
    return make_transform(vec2_zero(), zero_fixed());
}

// Composition, spelled infix so that a chain of frames reads left to right.
impl Transform as Core.MulWith(Transform) where .Result = Transform {
  fn Op(self, other: Transform) -> Transform {
      return self.composed(other);
  }
}

// Transform applied to a point.
impl Transform as Core.MulWith(Vec2) where .Result = Vec2 {
  fn Op(self, other: Vec2) -> Vec2 {
      return self.position + self.rotation * other;
  }
}
impl Transform as Core.EqWith(Transform) {
  fn Equal(self, other: Transform) -> bool {
      return self.position == other.position and self.angle == other.angle;
  }
}

// --- Axis-aligned bounding box --------------------------------------------
//
// Stored as a min and a max corner. An empty box is represented by a min that
// is greater than its max on at least one axis, which makes the merge of an
// empty box with anything the identity.
class AABB {

    fn set_empty(ref self) {
        self.lower = make_vec2(raw_fixed(FIXED_MAX_RAW), raw_fixed(FIXED_MAX_RAW));
        self.upper = make_vec2(raw_fixed(FIXED_MIN_RAW), raw_fixed(FIXED_MIN_RAW));
    }

    fn is_empty(self) -> bool {
        return self.lower.x > self.upper.x or self.lower.y > self.upper.y;
    }

    fn width(self) -> Fixed {
        return self.upper.x - self.lower.x;
    }

    fn height(self) -> Fixed {
        return self.upper.y - self.lower.y;
    }

    fn extents(self) -> Vec2 {
        return self.upper - self.lower;
    }

    fn half_extents(self) -> Vec2 {
        return (self.upper - self.lower) / 2;
    }

    fn centre(self) -> Vec2 {
        return (self.lower + self.upper) / 2;
    }

    fn area(self) -> Fixed {
        return (self.upper.x - self.lower.x) * (self.upper.y - self.lower.y);
    }

    fn perimeter(self) -> Fixed {
        return ((self.upper.x - self.lower.x) + (self.upper.y - self.lower.y)) * 2;
    }

    // Grow to include a point.
    fn include_point(ref self, p: Vec2) {
        self.lower = self.lower.componentwise_min(p);
        self.upper = self.upper.componentwise_max(p);
    }

    fn include_box(ref self, other: AABB) {
        self.lower = self.lower.componentwise_min(other.lower);
        self.upper = self.upper.componentwise_max(other.upper);
    }

    // Grow outward on every side by margin. The broad phase fattens every
    // proxy so that a body has to move a real distance before its cell
    // membership changes.
    fn expanded(self, margin: Fixed) -> AABB {
        return make_aabb(make_vec2(self.lower.x - margin, self.lower.y - margin),
                         make_vec2(self.upper.x + margin, self.upper.y + margin));
    }

    fn contains_point(self, p: Vec2) -> bool {
        return p.x >= self.lower.x and p.x <= self.upper.x and p.y >= self.lower.y and p.y <= self.upper.y;
    }

    fn contains_box(self, other: AABB) -> bool {
        return self.lower.x <= other.lower.x and self.lower.y <= other.lower.y
            and self.upper.x >= other.upper.x and self.upper.y >= other.upper.y;
    }

    // The separating-axis test in its simplest form: two boxes overlap unless
    // one is entirely to one side of the other on some axis.
    fn overlaps(self, other: AABB) -> bool {
        if (self.upper.x < other.lower.x or other.upper.x < self.lower.x) {
            return false;
        }
        if (self.upper.y < other.lower.y or other.upper.y < self.lower.y) {
            return false;
        }
        return true;
    }

    // Nearest point inside the box to p, which is p itself when p is inside.
    fn closest_point(self, p: Vec2) -> Vec2 {
        return make_vec2(p.x.clamped(self.lower.x, self.upper.x), p.y.clamped(self.lower.y, self.upper.y));
    }

    fn distance_squared_to_point(self, p: Vec2) -> Fixed {
        let nearest = self.closest_point(p);
        return (p - nearest).length_squared();
    }

    fn translated(self, offset: Vec2) -> AABB {
        return make_aabb(self.lower + offset, self.upper + offset);
    }

    // Sweep the box along a displacement, producing the box that covers the
    // whole path. Continuous collision detection uses this to decide whether
    // a fast body needs substepping of its own.
    fn swept(self, displacement: Vec2) -> AABB {
        let moved = self.translated(displacement);
        return make_aabb(self.lower.componentwise_min(moved.lower), self.upper.componentwise_max(moved.upper));
    }

    var lower: Vec2;
    var upper: Vec2;
}

fn make_aabb(lower: Vec2, upper: Vec2) -> AABB {
    var result: AABB;
    result.lower = lower + vec2_zero();
    result.upper = upper + vec2_zero();
    return result;
}

fn aabb_empty() -> AABB {
    var result: AABB;
    result.set_empty();
    return result;
}

fn aabb_from_centre(centre: Vec2, half: Vec2) -> AABB {
    return make_aabb(centre - half, centre + half);
}

// Union of two boxes, spelled with + so that folding a list of proxies into
// one bound is a single accumulation.
impl AABB as Core.AddWith(AABB) where .Result = AABB {
  fn Op(self, other: AABB) -> AABB {
      return make_aabb(self.lower.componentwise_min(other.lower), self.upper.componentwise_max(other.upper));
  }
}

// Translation of a box by a vector.
impl AABB as Core.AddWith(Vec2) where .Result = AABB {
  fn Op(self, other: Vec2) -> AABB {
      return make_aabb(self.lower + other, self.upper + other);
  }
}
impl AABB as Core.SubWith(Vec2) where .Result = AABB {
  fn Op(self, other: Vec2) -> AABB {
      return make_aabb(self.lower - other, self.upper - other);
  }
}

// Intersection. May produce an empty box, which is exactly the answer when
// the two do not overlap.
impl AABB as Core.MulWith(AABB) where .Result = AABB {
  fn Op(self, other: AABB) -> AABB {
      return make_aabb(self.lower.componentwise_max(other.lower), self.upper.componentwise_min(other.upper));
  }
}
impl AABB as Core.EqWith(AABB) {
  fn Equal(self, other: AABB) -> bool {
      return self.lower == other.lower and self.upper == other.upper;
  }

  fn NotEqual(self, other: AABB) -> bool {
      return self.lower != other.lower or self.upper != other.upper;
  }
}

// Ordering by area, so that a sorted proxy list puts the cheap tests first.
impl AABB as Core.OrderedWith(AABB) {
  fn Less(self, other: AABB) -> bool {
      return self.area() < other.area();
  }

  fn Greater(self, other: AABB) -> bool {
      return self.area() > other.area();
  }
}

// --- Circle ---------------------------------------------------------------

class Circle {

    fn area(self) -> Fixed {
        return pi_fixed() * self.radius * self.radius;
    }

    // Second moment of area about the centre, times the density, gives the
    // rotational inertia of a disc: m r^2 / 2. The offset term comes from the
    // parallel axis theorem when the circle is not at the body origin.
    fn inertia_for_mass(self, mass: Fixed) -> Fixed {
        let own = mass * self.radius * self.radius / 2;
        return own + mass * self.centre.length_squared();
    }

    fn bounds(self, frame: Transform) -> AABB {
        let world_centre = frame.apply(self.centre);
        let extent = make_vec2(self.radius, self.radius);
        return make_aabb(world_centre - extent, world_centre + extent);
    }

    fn contains_point(self, frame: Transform, p: Vec2) -> bool {
        let local = frame.unapply(p);
        return (local - self.centre).length_squared() <= self.radius * self.radius;
    }

    // The point on the circle furthest along a world-space direction. This is
    // the support function that the SAT code and the distance query share.
    fn support(self, frame: Transform, direction: Vec2) -> Vec2 {
        let unit = direction.normalised();
        return frame.apply(self.centre) + unit * self.radius;
    }

    var centre: Vec2;
    var radius: Fixed;
}

fn make_circle(centre: Vec2, radius: Fixed) -> Circle {
    var result: Circle;
    result.centre = centre + vec2_zero();
    result.radius = radius + zero_fixed();
    return result;
}

impl Circle as Core.EqWith(Circle) {
  fn Equal(self, other: Circle) -> bool {
      return self.centre == other.centre and self.radius == other.radius;
  }
}

// Scaling a circle scales both its offset and its radius, which is what a
// uniform scale of the whole body would do.
impl Circle as Core.MulWith(Fixed) where .Result = Circle {
  fn Op(self, other: Fixed) -> Circle {
      return make_circle(self.centre * other, self.radius * other);
  }
}

// --- Convex polygon -------------------------------------------------------

// Above this the polygon builder refuses the shape rather than silently
// dropping vertices.
let MAX_POLYGON_VERTICES: int = 16;

// A convex polygon in counter-clockwise winding, stored in body-local space
// together with its outward edge normals. normals[i] is the outward normal of
// the edge from vertices[i] to vertices[i + 1].
class Polygon {

    fn vertex_count(self) -> int {
        return self.vertices.size();
    }

    // Wrapping index access, so that the edge loops never need a modulo at
    // the call site.
    fn vertex(self, index: int) -> Vec2 {
        let count = self.vertices.size();
        if (count == 0) {
            return vec2_zero();
        }
        var wrapped = index % count;
        if (wrapped < 0) {
            wrapped += count;
        }
        return self.vertices[wrapped] + vec2_zero();
    }

    fn normal(self, index: int) -> Vec2 {
        let count = self.normals.size();
        if (count == 0) {
            return vec2_zero();
        }
        var wrapped = index % count;
        if (wrapped < 0) {
            wrapped += count;
        }
        return self.normals[wrapped] + vec2_zero();
    }

    fn world_vertex(self, frame: Transform, index: int) -> Vec2 {
        return frame.apply(self.vertex(index));
    }

    fn world_normal(self, frame: Transform, index: int) -> Vec2 {
        return frame.apply_direction(self.normal(index));
    }

    // Recompute the outward normals from the vertices. Counter-clockwise
    // winding means the outward normal of an edge is the edge rotated by -90
    // degrees, so (dx, dy) becomes (dy, -dx).
    fn rebuild_normals(ref self) {
        self.normals.clear();
        let count = self.vertices.size();
        var index: int = 0;
        while (index < count) {
            let current = self.vertices[index];
            let next = self.vertices[(index + 1) % count];
            let edge = next - current;
            self.normals.push_back(edge.perpendicular_cw().normalised());
            index += 1;
        }
    }

    // Twice the signed area, by the shoelace formula. Positive means the
    // winding is counter-clockwise, which every routine below assumes.
    fn signed_area_twice(self) -> Fixed {
        var total = zero_fixed();
        let count = self.vertices.size();
        var index: int = 0;
        while (index < count) {
            let current = self.vertices[index];
            let next = self.vertices[(index + 1) % count];
            total = total + current.x * next.y - next.x * current.y;
            index += 1;
        }
        return total;
    }

    fn area(self) -> Fixed {
        return self.signed_area_twice().magnitude() / 2;
    }

    // Area centroid, as the area-weighted mean of the fan triangles from the
    // origin. Each triangle contributes its own centroid, which is one third
    // of the sum of its corners, weighted by twice its signed area.
    fn centroid(self) -> Vec2 {
        var accumulated = vec2_zero();
        var total_area = zero_fixed();
        let count = self.vertices.size();
        var index: int = 0;
        while (index < count) {
            let current = self.vertices[index];
            let next = self.vertices[(index + 1) % count];
            let cross_term = current.x * next.y - next.x * current.y;
            accumulated = accumulated + (current + next) * cross_term;
            total_area = total_area + cross_term;
            index += 1;
        }
        if (total_area.magnitude().raw <= LINEAR_EPSILON_RAW) {
            return vec2_zero();
        }
        return accumulated / (total_area * 3);
    }

    // Second moment of area about the origin, by the standard polygon
    // formula. Multiplying by density gives the rotational inertia.
    fn second_moment(self) -> Fixed {
        var numerator = zero_fixed();
        var denominator = zero_fixed();
        let count = self.vertices.size();
        var index: int = 0;
        while (index < count) {
            let current = self.vertices[index];
            let next = self.vertices[(index + 1) % count];
            let cross_term = (current.x * next.y - next.x * current.y).magnitude();
            let spread = current.dot(current) + current.dot(next) + next.dot(next);
            numerator = numerator + cross_term * spread;
            denominator = denominator + cross_term;
            index += 1;
        }
        if (denominator.raw == 0) {
            return zero_fixed();
        }
        return numerator / (denominator * 6) * denominator;
    }

    fn inertia_for_mass(self, mass: Fixed) -> Fixed {
        let a = self.area();
        if (a.raw <= 0) {
            return zero_fixed();
        }
        return self.second_moment() * mass / a;
    }

    // The vertex furthest along a local-space direction, returned as an
    // index so that the SAT code can also reach its neighbours.
    fn support_index(self, direction: Vec2) -> int {
        let count = self.vertices.size();
        if (count == 0) {
            return 0;
        }
        var best: int = 0;
        var best_projection = self.vertices[0].dot(direction);
        var index: int = 1;
        while (index < count) {
            let projection = self.vertices[index].dot(direction);
            if (projection > best_projection) {
                best_projection = projection;
                best = index;
            }
            index += 1;
        }
        return best;
    }

    fn support(self, frame: Transform, direction: Vec2) -> Vec2 {
        let local_direction = frame.unapply_direction(direction);
        return frame.apply(self.vertex(self.support_index(local_direction)));
    }

    // Interval of the polygon's projection on a local-space axis.
    fn project_onto(self, axis: Vec2) -> Vec2 {
        let count = self.vertices.size();
        if (count == 0) {
            return vec2_zero();
        }
        var low = self.vertices[0].dot(axis);
        var high = low + zero_fixed();
        var index: int = 1;
        while (index < count) {
            let projection = self.vertices[index].dot(axis);
            low = fixed_min(low, projection);
            high = fixed_max(high, projection);
            index += 1;
        }
        return make_vec2(low, high);
    }

    fn bounds(self, frame: Transform) -> AABB {
        var box = aabb_empty();
        let count = self.vertices.size();
        var index: int = 0;
        while (index < count) {
            box.include_point(frame.apply(self.vertices[index]));
            index += 1;
        }
        return box;
    }

    // A point is inside a convex counter-clockwise polygon exactly when it is
    // behind every edge plane.
    fn contains_point(self, frame: Transform, p: Vec2) -> bool {
        let local = frame.unapply(p);
        let count = self.vertices.size();
        var index: int = 0;
        while (index < count) {
            let offset = local - self.vertices[index];
            if (self.normals[index].dot(offset) > zero_fixed()) {
                return false;
            }
            index += 1;
        }
        return true;
    }

    // Convexity check, used only by the builder and the debug validator. A
    // convex counter-clockwise polygon turns left at every vertex.
    fn is_convex(self) -> bool {
        let count = self.vertices.size();
        if (count < 3) {
            return false;
        }
        var index: int = 0;
        while (index < count) {
            let a = self.vertex(index);
            let b = self.vertex(index + 1);
            let c = self.vertex(index + 2);
            if (triangle_area_twice(a, b, c) < zero_fixed()) {
                return false;
            }
            index += 1;
        }
        return true;
    }

    // Shift every vertex so that the centroid lands on the origin, which is
    // what lets the body treat its own origin as its centre of mass.
    fn recentre(ref self) {
        let offset = self.centroid();
        var index: int = 0;
        while (index < self.vertices.size()) {
            self.vertices[index] = self.vertices[index] - offset;
            index += 1;
        }
        self.rebuild_normals();
    }

    var vertices: vector(Vec2);
    var normals: vector(Vec2);
    var radius: Fixed;
}

// Build a polygon from a vertex list, rebuilding the normals and pushing the
// centroid to the origin. The caller is expected to supply a convex
// counter-clockwise loop; is_convex reports when it did not.
fn make_polygon(vertices: vector(Vec2)) -> Polygon {
    var result: Polygon;
    result.vertices = move(vertices);
    result.radius = raw_fixed(LINEAR_EPSILON_RAW);
    result.rebuild_normals();
    return result;
}

// The axis-aligned box of half width hx and half height hy, centred on the
// body origin, in counter-clockwise winding starting from the lower left.
fn make_box_polygon(hx: Fixed, hy: Fixed) -> Polygon {
    var corners: vector(Vec2);
    corners.push_back(make_vec2(-hx, -hy));
    corners.push_back(make_vec2(hx, -hy));
    corners.push_back(make_vec2(hx, hy));
    corners.push_back(make_vec2(-hx, hy));
    return make_polygon(move(corners));
}

// A regular n-gon of the given circumradius, with the first vertex on the
// positive x axis.
fn make_regular_polygon(sides: int, circumradius: Fixed) -> Polygon {
    var corners: vector(Vec2);
    var index: int = 0;
    while (index < sides and index < MAX_POLYGON_VERTICES) {
        let angle = tau_fixed() * index / sides;
        corners.push_back(vec2_from_angle(angle) * circumradius);
        index += 1;
    }
    return make_polygon(move(corners));
}

impl Polygon as Core.EqWith(Polygon) {
  fn Equal(self, other: Polygon) -> bool {
      if (self.vertices.size() != other.vertices.size()) {
          return false;
      }
      var index: int = 0;
      while (index < self.vertices.size()) {
          if (self.vertices[index] != other.vertices[index]) {
              return false;
          }
          index += 1;
      }
      return true;
  }
}

// --- Shape ----------------------------------------------------------------
//
// One of each payload plus a tag. A real implementation would use a sum type;
// this shape is a struct with both payloads because the language has none,
// and the unused payload costs four Fixed values.
class Shape {

    fn is_circle(self) -> bool {
        return self.kind == ShapeKind.Circle;
    }

    fn is_polygon(self) -> bool {
        return self.kind == ShapeKind.Polygon or self.kind == ShapeKind.Box;
    }

    fn area(self) -> Fixed {
        if (self.kind == ShapeKind.Circle) {
            return self.circle.area();
        }
        return self.polygon.area();
    }

    fn mass_for_density(self, density: Fixed) -> Fixed {
        return self.area() * density;
    }

    fn inertia_for_mass(self, mass: Fixed) -> Fixed {
        if (self.kind == ShapeKind.Circle) {
            return self.circle.inertia_for_mass(mass);
        }
        return self.polygon.inertia_for_mass(mass);
    }

    fn centroid(self) -> Vec2 {
        if (self.kind == ShapeKind.Circle) {
            return self.circle.centre + vec2_zero();
        }
        return self.polygon.centroid();
    }

    fn bounds(self, frame: Transform) -> AABB {
        if (self.kind == ShapeKind.Circle) {
            return self.circle.bounds(frame);
        }
        return self.polygon.bounds(frame);
    }

    fn contains_point(self, frame: Transform, p: Vec2) -> bool {
        if (self.kind == ShapeKind.Circle) {
            return self.circle.contains_point(frame, p);
        }
        return self.polygon.contains_point(frame, p);
    }

    fn support(self, frame: Transform, direction: Vec2) -> Vec2 {
        if (self.kind == ShapeKind.Circle) {
            return self.circle.support(frame, direction);
        }
        return self.polygon.support(frame, direction);
    }

    var kind: ShapeKind = ShapeKind.Circle;
    var circle: Circle;
    var polygon: Polygon;
}

fn shape_from_circle(circle: Circle) -> Shape {
    var result: Shape;
    result.kind = ShapeKind.Circle;
    result.circle = move(circle);
    return result;
}

fn shape_from_polygon(polygon: Polygon) -> Shape {
    var result: Shape;
    result.kind = ShapeKind.Polygon;
    result.polygon = move(polygon);
    return result;
}

fn shape_box(hx: Fixed, hy: Fixed) -> Shape {
    var result = shape_from_polygon(make_box_polygon(hx, hy));
    result.kind = ShapeKind.Box;
    return result;
}

// --- Material -------------------------------------------------------------
//
// Density, restitution and the two friction coefficients. Restitution is the
// fraction of approach speed returned as separation speed: 0 is a dead stop,
// FIXED_ONE is a perfectly elastic bounce.
class Material {

    fn is_bouncy(self) -> bool {
        return self.restitution.raw > FIXED_QUARTER;
    }

    fn is_slippery(self) -> bool {
        return self.dynamic_friction.raw < raw_fixed(6553).raw;
    }

    var density: Fixed;
    var restitution: Fixed;
    var static_friction: Fixed;
    var dynamic_friction: Fixed;
}

fn make_material(density: Fixed, restitution: Fixed,
                 static_friction: Fixed, dynamic_friction: Fixed) -> Material {
    var result: Material;
    result.density = density + zero_fixed();
    result.restitution = restitution + zero_fixed();
    result.static_friction = static_friction + zero_fixed();
    result.dynamic_friction = dynamic_friction + zero_fixed();
    return result;
}

// Standard mixing rules. Restitution takes the larger of the pair, because a
// bouncy ball on dead concrete should still bounce; friction takes the
// geometric mean, which is the usual compromise.
fn mix_restitution(a: Material, b: Material) -> Fixed {
    return fixed_max(a.restitution, b.restitution);
}

fn mix_static_friction(a: Material, b: Material) -> Fixed {
    return (a.static_friction * b.static_friction).square_root();
}

fn mix_dynamic_friction(a: Material, b: Material) -> Fixed {
    return (a.dynamic_friction * b.dynamic_friction).square_root();
}

// A few presets so that the scene builder does not have to spell out four
// coefficients for every body. Values are raw fixed-point:
//   0.2 * 65536 = 13107, 0.3 * 65536 = 19660, 0.4 * 65536 = 26214,
//   0.6 * 65536 = 39321, 0.9 * 65536 = 58982.
fn material_wood() -> Material {
    return make_material(ratio(600, 1000), raw_fixed(19660), raw_fixed(39321), raw_fixed(26214));
}

fn material_steel() -> Material {
    return make_material(whole(8), raw_fixed(13107), raw_fixed(26214), raw_fixed(13107));
}

fn material_rubber() -> Material {
    return make_material(ratio(1200, 1000), raw_fixed(58982), raw_fixed(58982), raw_fixed(39321));
}

fn material_ice() -> Material {
    return make_material(ratio(900, 1000), raw_fixed(6553), raw_fixed(6553), raw_fixed(3276));
}

// --- Rigid body -----------------------------------------------------------
//
// The body owns its shape, its frame and its momentum state. Mass and inertia
// are stored both directly and as reciprocals, because the solver only ever
// wants the reciprocals and a static body is spelled by an inverse mass of
// zero rather than by a branch.
class RigidBody {

    // --- Mass properties --------------------------------------------------

    fn is_static(self) -> bool {
        return self.kind == BodyKind.Static;
    }

    fn is_dynamic(self) -> bool {
        return self.kind == BodyKind.Dynamic;
    }

    fn is_movable(self) -> bool {
        return self.kind != BodyKind.Static and self.inverse_mass.raw > 0;
    }

    // Recompute mass, centre of mass and inertia from the shape and the
    // material. A static or kinematic body gets zero inverse mass, which is
    // what makes every impulse applied to it a no-op.
    fn recompute_mass(ref self) {
        if (self.kind != BodyKind.Dynamic) {
            self.mass = zero_fixed();
            self.inverse_mass = zero_fixed();
            self.inertia = zero_fixed();
            self.inverse_inertia = zero_fixed();
            return;
        }
        self.mass = self.shape.mass_for_density(self.material.density);
        if (self.mass.raw <= 0) {
            self.mass = one_fixed();
        }
        self.inverse_mass = self.mass.reciprocal();
        self.inertia = self.shape.inertia_for_mass(self.mass);
        if (self.inertia.raw <= 0) {
            self.inverse_inertia = zero_fixed();
        } else {
            self.inverse_inertia = self.inertia.reciprocal();
        }
        self.local_centre = self.shape.centroid();
    }

    // Force a body to behave as if it were nailed down, without discarding
    // its stored mass, so that it can be released again later.
    fn freeze(ref self) {
        self.inverse_mass = zero_fixed();
        self.inverse_inertia = zero_fixed();
        self.velocity = vec2_zero();
        self.angular_velocity = zero_fixed();
    }

    fn thaw(ref self) {
        if (self.mass.raw > 0) {
            self.inverse_mass = self.mass.reciprocal();
        }
        if (self.inertia.raw > 0) {
            self.inverse_inertia = self.inertia.reciprocal();
        }
    }

    // --- Frame ------------------------------------------------------------

    fn position(self) -> Vec2 {
        return self.frame.position + vec2_zero();
    }

    fn angle(self) -> Fixed {
        return self.frame.angle + zero_fixed();
    }

    // Centre of mass in world space, which is where every impulse pivots.
    fn world_centre(self) -> Vec2 {
        return self.frame.position + self.frame.rotation * self.local_centre;
    }

    fn set_position(ref self, p: Vec2) {
        self.frame.position = p + vec2_zero();
        self.bounds_dirty = true;
    }

    fn set_angle(ref self, angle: Fixed) {
        self.frame.set_angle(angle);
        self.bounds_dirty = true;
    }

    fn to_world(self, local: Vec2) -> Vec2 {
        return self.frame.apply(local);
    }

    fn to_local(self, world: Vec2) -> Vec2 {
        return self.frame.unapply(world);
    }

    // --- Velocity ---------------------------------------------------------

    // Velocity of the material point currently at the given world position.
    // The angular term is omega cross r, which in 2D is a 90 degree rotation
    // of the offset scaled by the angular speed.
    fn velocity_at(self, world_point: Vec2) -> Vec2 {
        let offset = world_point - self.world_centre();
        return make_vec2(self.velocity.x - self.angular_velocity * offset.y,
                         self.velocity.y + self.angular_velocity * offset.x);
    }

    fn set_velocity(ref self, v: Vec2) {
        self.velocity = v + vec2_zero();
        self.sleep_timer = zero_fixed();
        self.awake = true;
    }

    fn add_velocity(ref self, delta: Vec2) {
        self.velocity = self.velocity + delta;
        self.awake = true;
    }

    // --- Forces and impulses ----------------------------------------------

    fn clear_forces(ref self) {
        self.force = vec2_zero();
        self.torque = zero_fixed();
    }

    fn apply_force(ref self, f: Vec2) {
        self.force = self.force + f;
        self.awake = true;
    }

    // A force applied off the centre of mass also produces a torque equal to
    // the cross product of the lever arm with the force.
    fn apply_force_at(ref self, f: Vec2, world_point: Vec2) {
        let offset = world_point - self.world_centre();
        self.force = self.force + f;
        self.torque = self.torque + offset.x * f.y - offset.y * f.x;
        self.awake = true;
    }

    fn apply_torque(ref self, t: Fixed) {
        self.torque = self.torque + t;
        self.awake = true;
    }

    // The two workhorses of the solver. An impulse changes velocity directly
    // rather than through an integration step, so it is scaled by the inverse
    // mass and not by the timestep.
    fn apply_impulse(ref self, impulse: Vec2) {
        self.velocity = self.velocity + impulse * self.inverse_mass;
    }

    fn apply_impulse_at(ref self, impulse: Vec2, world_point: Vec2) {
        let offset = world_point - self.world_centre();
        self.velocity.x = self.velocity.x + impulse.x * self.inverse_mass;
        self.velocity.y = self.velocity.y + impulse.y * self.inverse_mass;
        self.angular_velocity = self.angular_velocity
            + self.inverse_inertia * (offset.x * impulse.y - offset.y * impulse.x);
    }

    fn apply_angular_impulse(ref self, amount: Fixed) {
        self.angular_velocity = self.angular_velocity + amount * self.inverse_inertia;
    }

    // --- Integration ------------------------------------------------------

    // Semi-implicit Euler on the velocity. Gravity is added as an
    // acceleration rather than as a force so that a body's mass does not
    // change how fast it falls, and damping is applied as a multiplicative
    // decay so that it is stable at any timestep.
    fn integrate_velocity(ref self, gravity: Vec2, dt: Fixed) {
        if (self.inverse_mass.raw == 0) {
            return;
        }
        self.velocity = self.velocity
            + (gravity * self.gravity_scale + self.force * self.inverse_mass) * dt;
        self.angular_velocity = self.angular_velocity + self.torque * self.inverse_inertia * dt;
        self.velocity = self.velocity * (one_fixed() / (one_fixed() + self.linear_damping * dt));
        self.angular_velocity = self.angular_velocity
            / (one_fixed() + self.angular_damping * dt);
        self.velocity = self.velocity.clamped_length(self.max_linear_speed);
        self.angular_velocity = self.angular_velocity.clamped(-self.max_angular_speed, self.max_angular_speed);
    }

    fn integrate_position(ref self, dt: Fixed) {
        if (self.kind == BodyKind.Static) {
            return;
        }
        self.frame.position = self.frame.position + self.velocity * dt;
        self.frame.angle = self.frame.angle + self.angular_velocity * dt;
        self.frame.refresh();
        self.bounds_dirty = true;
    }

    // --- Energy -----------------------------------------------------------

    // Translational plus rotational kinetic energy: m v^2 / 2 + I w^2 / 2.
    fn kinetic_energy(self) -> Fixed {
        let linear = self.mass * self.velocity.length_squared() / 2;
        let angular = self.inertia * self.angular_velocity * self.angular_velocity / 2;
        return linear + angular;
    }

    // Potential energy relative to a datum height, measured against the
    // world's gravity direction.
    fn potential_energy(self, gravity: Vec2, datum: Fixed) -> Fixed {
        return -self.mass * (gravity.x * self.world_centre().x
                       + gravity.y * (self.world_centre().y - datum));
    }

    fn linear_momentum(self) -> Vec2 {
        return self.velocity * self.mass;
    }

    fn angular_momentum_about(self, pivot: Vec2) -> Fixed {
        let offset = self.world_centre() - pivot;
        return self.inertia * self.angular_velocity
            + self.mass * (offset.x * self.velocity.y - offset.y * self.velocity.x);
    }

    // --- Sleeping ---------------------------------------------------------

    // A body that has been slow for long enough stops being simulated. The
    // thresholds are squared so that the test avoids a square root.
    fn update_sleep(ref self, dt: Fixed, linear_threshold: Fixed,
                    angular_threshold: Fixed, time_to_sleep: Fixed) {
        if (self.kind == BodyKind.Static) {
            return;
        }
        if (self.never_sleeps) {
            self.sleep_timer = zero_fixed();
            return;
        }
        let moving = self.velocity.length_squared() > linear_threshold * linear_threshold
            or self.angular_velocity.magnitude() > angular_threshold;
        if (moving) {
            self.sleep_timer = zero_fixed();
            self.awake = true;
        } else {
            self.sleep_timer = self.sleep_timer + dt;
            if (self.sleep_timer >= time_to_sleep) {
                self.awake = false;
                self.velocity = vec2_zero();
                self.angular_velocity = zero_fixed();
            }
        }
    }

    fn wake(ref self) {
        self.awake = true;
        self.sleep_timer = zero_fixed();
    }

    // --- Bounds -----------------------------------------------------------

    fn bounds(self) -> AABB {
        return self.shape.bounds(self.frame);
    }

    // The proxy box the broad phase indexes: the tight bounds, fattened by a
    // margin and swept along the current velocity so that a body cannot
    // tunnel out of its own cell within one step.
    fn proxy_bounds(self, margin: Fixed, dt: Fixed) -> AABB {
        return self.shape.bounds(self.frame).swept(self.velocity * dt).expanded(margin);
    }

    // --- Identity ---------------------------------------------------------

    var kind: BodyKind = BodyKind.Dynamic;
    var identifier: int = 0;
    var layer: int = 1;
    var mask: int = 65535;

    var shape: Shape;
    var material: Material;
    var frame: Transform;
    var local_centre: Vec2;

    var mass: Fixed;
    var inverse_mass: Fixed;
    var inertia: Fixed;
    var inverse_inertia: Fixed;

    var velocity: Vec2;
    var angular_velocity: Fixed;
    var force: Vec2;
    var torque: Fixed;

    var linear_damping: Fixed;
    var angular_damping: Fixed;
    var gravity_scale: Fixed;
    var max_linear_speed: Fixed;
    var max_angular_speed: Fixed;

    var sleep_timer: Fixed;
    var awake: bool = true;
    var never_sleeps: bool = false;
    var bounds_dirty: bool = true;
}

// Two bodies collide only when their layer and mask bits agree in both
// directions, and never when both are immovable.
fn should_collide(a: RigidBody, b: RigidBody) -> bool {
    if (a.inverse_mass.raw == 0 and b.inverse_mass.raw == 0) {
        return false;
    }
    if (not a.awake and not b.awake) {
        return false;
    }
    return (a.layer & b.mask) != 0 and (b.layer & a.mask) != 0;
}

// Ordering by identifier, so that the contact list is deterministic no matter
// what order the broad phase happened to visit its cells in.
impl RigidBody as Core.OrderedWith(RigidBody) {
  fn Less(self, other: RigidBody) -> bool {
      return self.identifier < other.identifier;
  }
}
impl RigidBody as Core.EqWith(RigidBody) {
  fn Equal(self, other: RigidBody) -> bool {
      return self.identifier == other.identifier;
  }
}

// --- Broad phase: uniform spatial hash ------------------------------------
//
// Every proxy box is rasterised into the cells of an infinite uniform grid,
// and each cell index is folded into a bucket by a pair of large primes. The
// grid is infinite because the hash wraps; the cost is that two distant cells
// can share a bucket, which the pair filter removes at the end.
//
// The cell size wants to be about twice the average proxy diameter: too small
// and a body lands in many cells, too large and every cell holds everything.

// Multiplicative hash constants. Both are primes far from any power of two.
let HASH_PRIME_X: int = 73856093;
let HASH_PRIME_Y: int = 19349663;
let HASH_PRIME_MIX: int = 83492791;

// Default bucket count. A power of two so that the fold to a bucket index is
// a mask rather than a remainder.
let DEFAULT_BUCKET_COUNT: int = 4096;
let DEFAULT_BUCKET_MASK: int = 4095;

// A body whose proxy covers more cells than this is put on the oversized list
// and tested against everything instead of being rasterised.
let MAX_CELLS_PER_PROXY: int = 64;

// One entry in a bucket: which body, and which cell it was hashed from. The
// cell is kept so that a query can reject the far half of a collision without
// touching the body.
class GridEntry {
    var body_index: int = 0;
    var cell_x: int = 0;
    var cell_y: int = 0;
    var generation: int = 0;
}

// An unordered pair of body indices, normalised so that low is always the
// smaller. Normalising at construction is what makes the duplicate filter a
// plain equality test.
class BodyPair {

    fn normalise(ref self) {
        if (self.low > self.high) {
            swap(self.low, self.high);
        }
    }

    fn key(self) -> int {
        return self.low * 1000003 + self.high;
    }

    var low: int = 0;
    var high: int = 0;
}

fn make_pair(a: int, b: int) -> BodyPair {
    var result: BodyPair;
    if (a < b) {
        result.low = a;
        result.high = b;
    } else {
        result.low = b;
        result.high = a;
    }
    return result;
}

impl BodyPair as Core.EqWith(BodyPair) {
  fn Equal(self, other: BodyPair) -> bool {
      return self.low == other.low and self.high == other.high;
  }

  fn NotEqual(self, other: BodyPair) -> bool {
      return self.low != other.low or self.high != other.high;
  }
}

// Lexicographic order on (low, high), which is what the duplicate sweep wants.
impl BodyPair as Core.OrderedWith(BodyPair) {
  fn Less(self, other: BodyPair) -> bool {
      if (self.low != other.low) {
          return self.low < other.low;
      }
      return self.high < other.high;
  }

  fn Greater(self, other: BodyPair) -> bool {
      if (self.low != other.low) {
          return self.low > other.low;
      }
      return self.high > other.high;
  }
}

class SpatialHash {

    // --- Configuration ----------------------------------------------------

    fn configure(ref self, cell_size: Fixed, buckets: int) {
        self.cell_size = cell_size + zero_fixed();
        self.inverse_cell_size = cell_size.reciprocal();
        self.bucket_count = buckets;
        self.bucket_mask = buckets - 1;
        self.buckets.clear();
        self.buckets.resize(buckets);
        self.generation = 0;
    }

    // --- Cell arithmetic --------------------------------------------------

    // World coordinate to cell coordinate, flooring so that the cell boundary
    // at zero does not get counted twice.
    fn cell_of(self, value: Fixed) -> int {
        return (value * self.inverse_cell_size).floor_int();
    }

    fn cell_x_of_point(self, p: Vec2) -> int {
        return (p.x * self.inverse_cell_size).floor_int();
    }

    fn cell_y_of_point(self, p: Vec2) -> int {
        return (p.y * self.inverse_cell_size).floor_int();
    }

    // Fold a cell coordinate pair into a bucket. The multiply-and-xor is the
    // classic Teschner spatial hash; the final mask is valid only because the
    // bucket count is a power of two.
    fn bucket_of(self, cx: int, cy: int) -> int {
        let mixed = (cx * HASH_PRIME_X) ^ (cy * HASH_PRIME_Y) ^ HASH_PRIME_MIX;
        var index = mixed & self.bucket_mask;
        if (index < 0) {
            index += self.bucket_count;
        }
        return index;
    }

    // How many cells a box would occupy, used to decide whether a proxy goes
    // on the oversized list instead.
    fn cell_span(self, box: AABB) -> int {
        let low_x = self.cell_of(box.lower.x);
        let low_y = self.cell_of(box.lower.y);
        let high_x = self.cell_of(box.upper.x);
        let high_y = self.cell_of(box.upper.y);
        return (high_x - low_x + 1) * (high_y - low_y + 1);
    }

    // --- Population -------------------------------------------------------

    fn clear(ref self) {
        var index: int = 0;
        while (index < self.buckets.size()) {
            self.buckets[index].clear();
            index += 1;
        }
        self.oversized.clear();
        self.proxy_bounds.clear();
        self.entry_count = 0;
        self.generation += 1;
    }

    // Rasterise one proxy box into every cell it touches.
    fn insert(ref self, body_index: int, box: AABB) {
        self.proxy_bounds.push_back(box + vec2_zero());
        if (self.cell_span(box) > MAX_CELLS_PER_PROXY) {
            self.oversized.push_back(body_index);
            return;
        }
        let low_x = self.cell_of(box.lower.x);
        let low_y = self.cell_of(box.lower.y);
        let high_x = self.cell_of(box.upper.x);
        let high_y = self.cell_of(box.upper.y);
        var cy = low_y;
        while (cy <= high_y) {
            var cx = low_x;
            while (cx <= high_x) {
                var entry: GridEntry;
                entry.body_index = body_index;
                entry.cell_x = cx;
                entry.cell_y = cy;
                entry.generation = self.generation;
                self.buckets[self.bucket_of(cx, cy)].push_back(entry);
                self.entry_count += 1;
                cx += 1;
            }
            cy += 1;
        }
    }

    // Rebuild the whole grid from a body list. Rebuilding beats incremental
    // update for a scene where most bodies move every step, which is the case
    // this engine is tuned for.
    fn rebuild(ref self, bodies: vector(RigidBody),
               margin: Fixed, dt: Fixed) {
        self.clear();
        var index: int = 0;
        while (index < bodies.size()) {
            let ref body: auto = bodies[index];
            if (body.awake or body.kind == BodyKind.Static) {
                self.insert(index, body.proxy_bounds(margin, dt));
            } else {
                self.proxy_bounds.push_back(body.bounds());
            }
            index += 1;
        }
    }

    // --- Queries ----------------------------------------------------------

    // Every body whose proxy shares a cell with the query box. Duplicates are
    // possible when a body spans several of the queried cells; the caller
    // filters them.
    fn query_box(self, box: AABB, ref out: vector(int)) {
        let low_x = self.cell_of(box.lower.x);
        let low_y = self.cell_of(box.lower.y);
        let high_x = self.cell_of(box.upper.x);
        let high_y = self.cell_of(box.upper.y);
        var cy = low_y;
        while (cy <= high_y) {
            var cx = low_x;
            while (cx <= high_x) {
                let ref bucket: auto = self.buckets[self.bucket_of(cx, cy)];
                var slot: int = 0;
                while (slot < bucket.size()) {
                    let ref entry: auto = bucket[slot];
                    // Reject the far half of a hash collision by checking the
                    // cell coordinates the entry was actually filed under.
                    if (entry.cell_x == cx and entry.cell_y == cy) {
                        out.push_back(entry.body_index);
                    }
                    slot += 1;
                }
                cx += 1;
            }
            cy += 1;
        }
        var extra: int = 0;
        while (extra < self.oversized.size()) {
            out.push_back(self.oversized[extra]);
            extra += 1;
        }
    }

    fn query_point(self, p: Vec2, ref out: vector(int)) {
        self.query_box(make_aabb(p, p), out);
    }

    fn query_circle(self, centre: Vec2, radius: Fixed,
                    ref out: vector(int)) {
        let extent = make_vec2(radius, radius);
        self.query_box(make_aabb(centre - extent, centre + extent), out);
    }

    // --- Pair generation --------------------------------------------------

    // Collect every candidate pair by walking each bucket and emitting the
    // upper triangle of the entries that share a cell. Only entries whose
    // cell coordinates match are considered, so a hash collision costs a
    // comparison rather than a false pair.
    fn collect_pairs(self, bodies: vector(RigidBody),
                     ref out: vector(BodyPair)) {
        var bucket_index: int = 0;
        while (bucket_index < self.buckets.size()) {
            let ref bucket: auto = self.buckets[bucket_index];
            var first: int = 0;
            while (first < bucket.size()) {
                var second = first + 1;
                while (second < bucket.size()) {
                    let ref a: auto = bucket[first];
                    let ref b: auto = bucket[second];
                    if (a.cell_x == b.cell_x and a.cell_y == b.cell_y
                        and a.body_index != b.body_index) {
                        let ref left: auto = bodies[a.body_index];
                        let ref right: auto = bodies[b.body_index];
                        if (should_collide(left, right)
                            and self.proxy_bounds[a.body_index].overlaps(self.proxy_bounds[b.body_index])) {
                            out.push_back(make_pair(a.body_index, b.body_index));
                            broad_phase_pair_count += 1;
                        }
                    }
                    second += 1;
                }
                first += 1;
            }
            bucket_index += 1;
        }
        // Oversized proxies never made it into a bucket, so they are tested
        // against every body directly.
        var big: int = 0;
        while (big < self.oversized.size()) {
            let subject = self.oversized[big];
            var other: int = 0;
            while (other < bodies.size()) {
                if (other != subject) {
                    let ref left: auto = bodies[subject];
                    let ref right: auto = bodies[other];
                    if (should_collide(left, right)
                        and self.proxy_bounds[subject].overlaps(self.proxy_bounds[other])) {
                        out.push_back(make_pair(subject, other));
                        broad_phase_pair_count += 1;
                    }
                }
                other += 1;
            }
            big += 1;
        }
    }

    // --- Statistics -------------------------------------------------------

    fn occupied_buckets(self) -> int {
        var count: int = 0;
        var index: int = 0;
        while (index < self.buckets.size()) {
            if (self.buckets[index].size() > 0) {
                count += 1;
            }
            index += 1;
        }
        return count;
    }

    fn longest_bucket(self) -> int {
        var longest: int = 0;
        var index: int = 0;
        while (index < self.buckets.size()) {
            if (self.buckets[index].size() > longest) {
                longest = self.buckets[index].size();
            }
            index += 1;
        }
        return longest;
    }

    // Average entries per occupied bucket, in fixed point. A load much above
    // four says the cell size is too large for the scene.
    fn average_load(self) -> Fixed {
        let occupied = self.occupied_buckets();
        if (occupied == 0) {
            return zero_fixed();
        }
        return whole(self.entry_count) / whole(occupied);
    }

    var buckets: vector(vector(GridEntry));
    var oversized: vector(int);
    var proxy_bounds: vector(AABB);
    var cell_size: Fixed;
    var inverse_cell_size: Fixed;
    var bucket_count: int = 4096;
    var bucket_mask: int = 4095;
    var entry_count: int = 0;
    var generation: int = 0;
}

fn make_spatial_hash(cell_size: Fixed) -> SpatialHash {
    var result: SpatialHash;
    result.configure(cell_size, DEFAULT_BUCKET_COUNT);
    return result;
}

// Remove duplicate pairs from a list that has already been sorted. The list
// arrives sorted because make_pair normalises the order and the caller sorts
// on the lexicographic operator declared above.
fn deduplicate_pairs(ref pairs: vector(BodyPair)) {
    if (pairs.size() < 2) {
        return;
    }
    var write: int = 1;
    var read: int = 1;
    while (read < pairs.size()) {
        if (pairs[read] != pairs[write - 1]) {
            pairs[write] = pairs[read];
            write += 1;
        }
        read += 1;
    }
    while (pairs.size() > write) {
        pairs.pop_back();
    }
}

// Insertion sort on the pair list. The list is nearly sorted from one step to
// the next because the bucket walk order barely changes, so insertion sort is
// close to linear here and is stable, which keeps the simulation replayable.
fn sort_pairs(ref pairs: vector(BodyPair)) {
    var index: int = 1;
    while (index < pairs.size()) {
        var slot = index;
        while (slot > 0 and pairs[slot] < pairs[slot - 1]) {
            swap(pairs[slot], pairs[slot - 1]);
            slot -= 1;
        }
        index += 1;
    }
}

// --- Narrow phase ---------------------------------------------------------
//
// Every test in this section produces a Manifold: a shared normal pointing
// from A towards B, and up to two contact points, each with its own
// penetration depth and its own accumulated impulses.
//
// Two points is enough in 2D. A face-face contact between convex polygons
// clips to a segment, and a segment has two ends.

// The most contact points a single manifold can hold.
let MAX_MANIFOLD_POINTS: int = 2;

// Contacts closer than this are treated as the same point when matching a new
// manifold against the previous step's manifold for warm starting.
let CONTACT_MATCH_TOLERANCE_RAW: int = 655;

// Penetration below this is left alone: trying to remove the last fraction of
// a unit of overlap is what makes a stack jitter.
let PENETRATION_SLOP_RAW: int = 328;

// Relative normal speed below this is treated as a resting contact and gets no
// restitution, which is what stops a stack of boxes buzzing forever.
let RESTITUTION_THRESHOLD_RAW: int = 65536;

// A single point of contact.
class ContactPoint {

    // Recompute the two lever arms after the bodies have moved. The solver
    // does this once per substep rather than once per iteration.
    fn refresh_anchors(ref self, centre_a: Vec2, centre_b: Vec2) {
        self.anchor_a = self.position - centre_a;
        self.anchor_b = self.position - centre_b;
    }

    fn is_new(self) -> bool {
        return self.match_count == 0;
    }

    // World position of the contact.
    var position: Vec2;
    // Lever arm from each body's centre of mass to the contact.
    var anchor_a: Vec2;
    var anchor_b: Vec2;
    // Local-space anchors, kept so that position correction can recompute the
    // world positions after the bodies have been pushed apart.
    var local_a: Vec2;
    var local_b: Vec2;
    // Overlap along the manifold normal, positive when penetrating.
    var separation: Fixed;
    // Accumulated impulses, carried across steps for warm starting.
    var normal_impulse: Fixed;
    var tangent_impulse: Fixed;
    // Effective masses along the normal and the tangent, computed once per
    // substep because they only depend on the geometry.
    var normal_mass: Fixed;
    var tangent_mass: Fixed;
    // The target separation speed produced by restitution.
    var velocity_bias: Fixed;
    // Which feature pair produced this point, used to match across steps.
    var feature_id: int = 0;
    var match_count: int = 0;
}

fn make_contact_point(position: Vec2, separation: Fixed, feature: int) -> ContactPoint {
    var result: ContactPoint;
    result.position = position + vec2_zero();
    result.separation = separation + zero_fixed();
    result.feature_id = feature;
    return result;
}

// A contact manifold between two bodies.
class Manifold {

    fn point_count(self) -> int {
        return self.points.size();
    }

    fn is_touching(self) -> bool {
        return self.state != ContactState.Separated and self.points.size() > 0;
    }

    fn clear(ref self) {
        self.points.clear();
        self.state = ContactState.Separated;
    }

    // The unit tangent, which is the normal rotated by 90 degrees. Friction
    // acts along this direction.
    fn tangent(self) -> Vec2 {
        return make_vec2(-self.normal.y, self.normal.x);
    }

    // Deepest penetration across all points, which the position solver uses
    // to decide whether this manifold still needs work.
    fn deepest_separation(self) -> Fixed {
        var deepest = zero_fixed();
        var index: int = 0;
        while (index < self.points.size()) {
            deepest = fixed_min(deepest, self.points[index].separation);
            index += 1;
        }
        return deepest;
    }

    // Total normal impulse applied last step, which is what a breakable joint
    // or a sound trigger reads.
    fn total_normal_impulse(self) -> Fixed {
        var total = zero_fixed();
        var index: int = 0;
        while (index < self.points.size()) {
            total = total + self.points[index].normal_impulse;
            index += 1;
        }
        return total;
    }

    fn centre_of_pressure(self) -> Vec2 {
        let total = self.total_normal_impulse();
        if (total.raw == 0) {
            if (self.points.size() == 0) {
                return vec2_zero();
            }
            return self.points[0].position + vec2_zero();
        }
        var weighted = vec2_zero();
        var index: int = 0;
        while (index < self.points.size()) {
            weighted = weighted + self.points[index].position * self.points[index].normal_impulse;
            index += 1;
        }
        return weighted / total;
    }

    // Carry the accumulated impulses from the previous step's manifold onto
    // the matching points of this one. Warm starting is the single change
    // that turns a jittery stack into a stable one, and it costs one pass
    // over at most four point pairs.
    fn warm_start_from(ref self, previous: Manifold) {
        var index: int = 0;
        while (index < self.points.size()) {
            var found: bool = false;
            var other: int = 0;
            while (other < previous.points.size() and not found) {
                let ref old: auto = previous.points[other];
                let same_feature = old.feature_id == self.points[index].feature_id;
                let close = (old.position - self.points[index].position).manhattan_length()
                    <= raw_fixed(CONTACT_MATCH_TOLERANCE_RAW);
                if (same_feature or close) {
                    self.points[index].normal_impulse = old.normal_impulse + zero_fixed();
                    self.points[index].tangent_impulse = old.tangent_impulse + zero_fixed();
                    self.points[index].match_count = old.match_count + 1;
                    found = true;
                }
                other += 1;
            }
            if (not found) {
                self.points[index].normal_impulse = zero_fixed();
                self.points[index].tangent_impulse = zero_fixed();
                self.points[index].match_count = 0;
            }
            index += 1;
        }
    }

    var body_a: int = 0;
    var body_b: int = 0;
    // Unit normal, pointing from body A towards body B.
    var normal: Vec2;
    var points: vector(ContactPoint);
    var state: ContactState = ContactState.Separated;
    var feature: FeatureKind = FeatureKind.FaceA;
    var friction: Fixed;
    var restitution: Fixed;
}

fn make_manifold(body_a: int, body_b: int) -> Manifold {
    var result: Manifold;
    result.body_a = body_a;
    result.body_b = body_b;
    result.normal = vec2_unit_y();
    return result;
}

// --- Circle against circle ------------------------------------------------
//
// The simplest test there is: compare the centre distance against the sum of
// the radii. The only subtlety is the coincident-centres case, where there is
// no direction to separate along and an arbitrary one has to be picked.
fn collide_circle_circle(ref manifold: Manifold,
                         circle_a: Circle, frame_a: Transform,
                         circle_b: Circle, frame_b: Transform) {
    narrow_phase_test_count += 1;
    manifold.clear();
    let centre_a = frame_a.apply(circle_a.centre);
    let centre_b = frame_b.apply(circle_b.centre);
    let offset = centre_b - centre_a;
    let distance_squared = offset.length_squared();
    let combined = circle_a.radius + circle_b.radius;
    if (distance_squared > combined * combined) {
        manifold.state = ContactState.Separated;
        return;
    }
    let distance = distance_squared.square_root();
    if (distance.raw <= LINEAR_EPSILON_RAW) {
        // Concentric circles: separate straight up, which at least keeps the
        // result deterministic.
        manifold.normal = vec2_unit_y();
        manifold.points.push_back(make_contact_point(centre_a, -combined, 0));
        manifold.state = ContactState.Penetrating;
        return;
    }
    manifold.normal = offset / distance;
    let surface_a = centre_a + manifold.normal * circle_a.radius;
    let surface_b = centre_b - manifold.normal * circle_b.radius;
    let midpoint = (surface_a + surface_b) / 2;
    manifold.points.push_back(make_contact_point(midpoint, distance - combined, 0));
    manifold.state = ContactState.Penetrating;
}

// --- Circle against convex polygon ----------------------------------------
//
// Work in the polygon's local frame so that the edge normals are already the
// right ones. Find the edge with the greatest signed separation; if that
// separation exceeds the radius there is no contact. Otherwise the contact is
// either against the face, when the circle centre projects inside the edge,
// or against one of the two endpoints.
fn collide_circle_polygon(ref manifold: Manifold,
                          circle: Circle, circle_frame: Transform,
                          polygon: Polygon, polygon_frame: Transform,
                          flip_normal: bool) {
    narrow_phase_test_count += 1;
    manifold.clear();
    let world_centre = circle_frame.apply(circle.centre);
    let local_centre = polygon_frame.unapply(world_centre);
    let count = polygon.vertices.size();
    if (count == 0) {
        manifold.state = ContactState.Separated;
        return;
    }

    var best_edge: int = 0;
    var best_separation = raw_fixed(FIXED_MIN_RAW);
    var index: int = 0;
    while (index < count) {
        let separation = polygon.normals[index].dot(local_centre - polygon.vertices[index]);
        if (separation > circle.radius) {
            manifold.state = ContactState.Separated;
            return;
        }
        if (separation > best_separation) {
            best_separation = separation;
            best_edge = index;
        }
        index += 1;
    }

    let vertex_a = polygon.vertex(best_edge);
    let vertex_b = polygon.vertex(best_edge + 1);

    // Deeply inside: the centre is behind every edge plane, so the face with
    // the least negative separation is the one to push out of.
    if (best_separation.raw < LINEAR_EPSILON_RAW and best_separation.raw <= 0) {
        let face_normal = polygon.normals[best_edge];
        let world_normal = polygon_frame.apply_direction(face_normal);
        let contact = world_centre - world_normal * circle.radius;
        if (flip_normal) {
            manifold.normal = -world_normal;
        } else {
            manifold.normal = world_normal + vec2_zero();
        }
        manifold.points.push_back(make_contact_point(contact, best_separation - circle.radius, best_edge));
        manifold.state = ContactState.Penetrating;
        return;
    }

    // Otherwise decide between the face region and the two vertex regions by
    // the sign of the projection onto the edge.
    let edge = vertex_b - vertex_a;
    let projection_a = (local_centre - vertex_a).dot(edge);
    let projection_b = (local_centre - vertex_b).dot(edge);
    var local_normal = vec2_zero();
    var local_contact = vec2_zero();
    var feature = best_edge;
    if (projection_a <= zero_fixed()) {
        if ((local_centre - vertex_a).length_squared() > circle.radius * circle.radius) {
            manifold.state = ContactState.Separated;
            return;
        }
        local_normal = (local_centre - vertex_a).normalised();
        local_contact = vertex_a + vec2_zero();
        feature = best_edge * 4 + 1;
    } else {
        if (projection_b >= zero_fixed()) {
            if ((local_centre - vertex_b).length_squared() > circle.radius * circle.radius) {
                manifold.state = ContactState.Separated;
                return;
            }
            local_normal = (local_centre - vertex_b).normalised();
            local_contact = vertex_b + vec2_zero();
            feature = best_edge * 4 + 2;
        } else {
            local_normal = polygon.normals[best_edge] + vec2_zero();
            local_contact = closest_point_on_segment(vertex_a, vertex_b, local_centre);
            feature = best_edge * 4;
        }
    }

    let world_normal = polygon_frame.apply_direction(local_normal);
    let world_contact = polygon_frame.apply(local_contact);
    let separation = (local_centre - local_contact).dot(local_normal) - circle.radius;
    if (flip_normal) {
        manifold.normal = -world_normal;
    } else {
        manifold.normal = world_normal + vec2_zero();
    }
    manifold.points.push_back(make_contact_point(world_contact, separation, feature));
    manifold.state = ContactState.Penetrating;
}

// --- Polygon against polygon: separating axis test ------------------------

// The result of scanning one polygon's faces against the other polygon.
class AxisQuery {
    var edge_index: int = 0;
    var separation: Fixed;
}

// Greatest separation of polygon b from any face plane of polygon a. A
// positive result means a separating axis exists and the shapes are apart.
//
// The support point is taken along the inward normal, which is the vertex of
// b that is deepest into a's face plane.
fn greatest_separation(a: Polygon, frame_a: Transform,
                       b: Polygon, frame_b: Transform) -> AxisQuery {
    var result: AxisQuery;
    result.separation = raw_fixed(FIXED_MIN_RAW);
    let count = a.vertices.size();
    var index: int = 0;
    while (index < count) {
        let world_normal = frame_a.apply_direction(a.normals[index]);
        let local_normal = frame_b.unapply_direction(world_normal);
        let support = b.vertex(b.support_index(-local_normal));
        let world_support = frame_b.apply(support);
        let world_vertex = frame_a.apply(a.vertices[index]);
        let separation = world_normal.dot(world_support - world_vertex);
        if (separation > result.separation) {
            result.separation = separation;
            result.edge_index = index;
        }
        index += 1;
    }
    return result;
}

// One end of a clipped edge, carrying the identifier of the feature pair that
// produced it so that warm starting can match it next step.
class ClipVertex {
    var position: Vec2;
    var identifier: int = 0;
}

fn make_clip_vertex(position: Vec2, identifier: int) -> ClipVertex {
    var result: ClipVertex;
    result.position = position + vec2_zero();
    result.identifier = identifier;
    return result;
}

// The edge of polygon b that is most anti-parallel to the reference normal,
// which is the edge that will be clipped against the reference face.
fn find_incident_edge(reference_normal: Vec2,
                      incident: Polygon, incident_frame: Transform,
                      ref out: vector(ClipVertex)) {
    out.clear();
    let local_normal = incident_frame.unapply_direction(reference_normal);
    let count = incident.normals.size();
    if (count == 0) {
        return;
    }
    var best: int = 0;
    var best_dot = incident.normals[0].dot(local_normal);
    var index: int = 1;
    while (index < count) {
        let value = incident.normals[index].dot(local_normal);
        if (value < best_dot) {
            best_dot = value;
            best = index;
        }
        index += 1;
    }
    out.push_back(make_clip_vertex(incident_frame.apply(incident.vertex(best)), best * 4));
    out.push_back(make_clip_vertex(incident_frame.apply(incident.vertex(best + 1)), best * 4 + 1));
}

// Clip a segment against a half plane, keeping the part with signed distance
// at most offset. Returns the number of surviving points, which is zero, one
// or two; a single crossing produces the intersection point.
fn clip_segment_to_plane(input: vector(ClipVertex), ref output: vector(ClipVertex),
                         normal: Vec2, offset: Fixed,
                         identifier: int) -> int {
    output.clear();
    if (input.size() < 2) {
        return 0;
    }
    let distance_0 = normal.dot(input[0].position) - offset;
    let distance_1 = normal.dot(input[1].position) - offset;
    if (distance_0 <= zero_fixed()) {
        output.push_back(make_clip_vertex(input[0].position, input[0].identifier));
    }
    if (distance_1 <= zero_fixed()) {
        output.push_back(make_clip_vertex(input[1].position, input[1].identifier));
    }
    if (distance_0 * distance_1 < zero_fixed()) {
        let t = distance_0 / (distance_0 - distance_1);
        let crossing = input[0].position + (input[1].position - input[0].position) * t;
        output.push_back(make_clip_vertex(crossing, identifier));
    }
    return output.size();
}

// Full polygon against polygon test.
//
// Scan both polygons' faces, keep the axis of greatest separation, and use the
// owner of that axis as the reference polygon. Clip the other polygon's most
// anti-parallel edge against the reference face's two side planes, and keep
// the clipped points that are behind the reference face.
fn collide_polygon_polygon(ref manifold: Manifold,
                           a: Polygon, frame_a: Transform,
                           b: Polygon, frame_b: Transform) {
    narrow_phase_test_count += 1;
    manifold.clear();
    let query_a = greatest_separation(a, frame_a, b, frame_b);
    if (query_a.separation > zero_fixed()) {
        manifold.state = ContactState.Separated;
        return;
    }
    let query_b = greatest_separation(b, frame_b, a, frame_a);
    if (query_b.separation > zero_fixed()) {
        manifold.state = ContactState.Separated;
        return;
    }

    // Prefer face A unless face B is clearly deeper, which stops the choice
    // of reference face flickering between steps for a near-symmetric contact
    // and so keeps warm starting effective.
    var reference_is_a: bool = true;
    var reference_edge = query_a.edge_index;
    var bias = raw_fixed(PENETRATION_SLOP_RAW);
    if (query_b.separation > query_a.separation + bias) {
        reference_is_a = false;
        reference_edge = query_b.edge_index;
        manifold.feature = FeatureKind.FaceB;
    } else {
        manifold.feature = FeatureKind.FaceA;
    }

    var incident_points: vector(ClipVertex);
    var clipped_once: vector(ClipVertex);
    var clipped_twice: vector(ClipVertex);

    if (reference_is_a) {
        let reference_normal = frame_a.apply_direction(a.normals[reference_edge]);
        let reference_v0 = frame_a.apply(a.vertex(reference_edge));
        let reference_v1 = frame_a.apply(a.vertex(reference_edge + 1));
        let side = (reference_v1 - reference_v0).normalised();
        find_incident_edge(reference_normal, b, frame_b, incident_points);
        let survived_once = clip_segment_to_plane(incident_points, clipped_once,
                                                  -side, -side.dot(reference_v0),
                                                  reference_edge * 4 + 2);
        if (survived_once < 2) {
            manifold.state = ContactState.Touching;
            return;
        }
        let survived_twice = clip_segment_to_plane(clipped_once, clipped_twice,
                                                   side, side.dot(reference_v1),
                                                   reference_edge * 4 + 3);
        if (survived_twice < 2) {
            manifold.state = ContactState.Touching;
            return;
        }
        manifold.normal = reference_normal + vec2_zero();
        let face_offset = reference_normal.dot(reference_v0);
        var index: int = 0;
        while (index < clipped_twice.size() and manifold.points.size() < MAX_MANIFOLD_POINTS) {
            let separation = reference_normal.dot(clipped_twice[index].position) - face_offset;
            if (separation <= zero_fixed()) {
                manifold.points.push_back(make_contact_point(clipped_twice[index].position,
                                                             separation,
                                                             clipped_twice[index].identifier));
            }
            index += 1;
        }
    } else {
        let reference_normal = frame_b.apply_direction(b.normals[reference_edge]);
        let reference_v0 = frame_b.apply(b.vertex(reference_edge));
        let reference_v1 = frame_b.apply(b.vertex(reference_edge + 1));
        let side = (reference_v1 - reference_v0).normalised();
        find_incident_edge(reference_normal, a, frame_a, incident_points);
        let survived_once = clip_segment_to_plane(incident_points, clipped_once,
                                                  -side, -side.dot(reference_v0),
                                                  reference_edge * 4 + 2);
        if (survived_once < 2) {
            manifold.state = ContactState.Touching;
            return;
        }
        let survived_twice = clip_segment_to_plane(clipped_once, clipped_twice,
                                                   side, side.dot(reference_v1),
                                                   reference_edge * 4 + 3);
        if (survived_twice < 2) {
            manifold.state = ContactState.Touching;
            return;
        }
        // The reference face belongs to B, so the manifold normal has to be
        // flipped back to point from A towards B.
        manifold.normal = -reference_normal;
        let face_offset = reference_normal.dot(reference_v0);
        var index: int = 0;
        while (index < clipped_twice.size() and manifold.points.size() < MAX_MANIFOLD_POINTS) {
            let separation = reference_normal.dot(clipped_twice[index].position) - face_offset;
            if (separation <= zero_fixed()) {
                manifold.points.push_back(make_contact_point(clipped_twice[index].position,
                                                             separation,
                                                             clipped_twice[index].identifier));
            }
            index += 1;
        }
    }

    if (manifold.points.size() == 0) {
        manifold.state = ContactState.Touching;
    } else {
        manifold.state = ContactState.Penetrating;
    }
}

// --- Dispatch -------------------------------------------------------------

// Route a body pair to the right narrow-phase routine and fill in the mixed
// material coefficients. The normal always ends up pointing from A to B, so
// the solver never has to care which routine produced it.
fn collide(ref manifold: Manifold,
           a: RigidBody, b: RigidBody) {
    manifold.friction = mix_dynamic_friction(a.material, b.material);
    manifold.restitution = mix_restitution(a.material, b.material);
    if (a.shape.kind == ShapeKind.Circle and b.shape.kind == ShapeKind.Circle) {
        collide_circle_circle(manifold, a.shape.circle, a.frame, b.shape.circle, b.frame);
        return;
    }
    if (a.shape.kind == ShapeKind.Circle) {
        // The polygon routine produces a normal pointing away from the
        // polygon, which is B here, so it has to be flipped.
        collide_circle_polygon(manifold, a.shape.circle, a.frame, b.shape.polygon, b.frame, true);
        return;
    }
    if (b.shape.kind == ShapeKind.Circle) {
        collide_circle_polygon(manifold, b.shape.circle, b.frame, a.shape.polygon, a.frame, false);
        return;
    }
    collide_polygon_polygon(manifold, a.shape.polygon, a.frame, b.shape.polygon, b.frame);
}

// Cheap rejection before the full test, using the two proxy boxes.
fn quick_reject(a: RigidBody, b: RigidBody) -> bool {
    return not a.bounds().overlaps(b.bounds());
}

// --- Sequential impulse solver --------------------------------------------
//
// The velocity solver runs a fixed number of Gauss-Seidel passes over the
// contact list. Each pass computes, for every contact point, the impulse that
// would exactly cancel the relative velocity along the constraint direction,
// clamps the accumulated impulse to its valid range, and applies the change.
//
// Clamping the accumulated total rather than the increment is what makes the
// solver converge instead of oscillating: an individual increment is allowed
// to be negative as long as the running total stays non-negative.

// Fraction of the remaining penetration removed per position pass. Removing
// all of it in one pass overshoots and makes stacks explode.
let BAUMGARTE_RAW: int = 13107;

// Maximum penetration removed in a single position pass, so that a badly
// overlapping pair separates over several steps instead of teleporting.
let MAX_LINEAR_CORRECTION_RAW: int = 13107;

// Default iteration counts.
let DEFAULT_VELOCITY_ITERATIONS: int = 8;
let DEFAULT_POSITION_ITERATIONS: int = 3;

// A resolved constraint, holding everything the inner loop needs so that the
// loop never has to reach back through a body index.
class ContactConstraint {

    // Effective mass along a direction for a contact point: the reciprocal of
    //     1/ma + 1/mb + (ra x d)^2 / Ia + (rb x d)^2 / Ib
    // which is the scalar mass the constraint sees along that direction.
    fn effective_mass(self, anchor_a: Vec2, anchor_b: Vec2,
                      direction: Vec2) -> Fixed {
        let cross_a = anchor_a.x * direction.y - anchor_a.y * direction.x;
        let cross_b = anchor_b.x * direction.y - anchor_b.y * direction.x;
        let total = self.inverse_mass_a + self.inverse_mass_b
            + self.inverse_inertia_a * cross_a * cross_a
            + self.inverse_inertia_b * cross_b * cross_b;
        if (total.raw <= 0) {
            return zero_fixed();
        }
        return total.reciprocal();
    }

    var manifold_index: int = 0;
    var body_a: int = 0;
    var body_b: int = 0;
    var inverse_mass_a: Fixed;
    var inverse_mass_b: Fixed;
    var inverse_inertia_a: Fixed;
    var inverse_inertia_b: Fixed;
    var centre_a: Vec2;
    var centre_b: Vec2;
    var friction: Fixed;
    var restitution: Fixed;
}

class ContactSolver {

    // --- Setup ------------------------------------------------------------

    // Build one constraint per manifold and precompute the effective masses
    // and the restitution bias. Everything here depends only on the geometry
    // and so is hoisted out of the iteration loop.
    fn prepare(ref self, ref bodies: vector(RigidBody),
               ref manifolds: vector(Manifold), dt: Fixed) {
        self.constraints.clear();
        var index: int = 0;
        while (index < manifolds.size()) {
            let ref manifold: auto = manifolds[index];
            if (not manifold.is_touching()) {
                index += 1;
            } else {
                var constraint_: ContactConstraint;
                constraint_.manifold_index = index;
                constraint_.body_a = manifold.body_a;
                constraint_.body_b = manifold.body_b;
                constraint_.friction = manifold.friction + zero_fixed();
                constraint_.restitution = manifold.restitution + zero_fixed();

                let ref body_a: auto = bodies[manifold.body_a];
                let ref body_b: auto = bodies[manifold.body_b];
                constraint_.inverse_mass_a = body_a.inverse_mass + zero_fixed();
                constraint_.inverse_mass_b = body_b.inverse_mass + zero_fixed();
                constraint_.inverse_inertia_a = body_a.inverse_inertia + zero_fixed();
                constraint_.inverse_inertia_b = body_b.inverse_inertia + zero_fixed();
                constraint_.centre_a = body_a.world_centre();
                constraint_.centre_b = body_b.world_centre();

                let tangent = manifold.tangent();
                var point_index: int = 0;
                while (point_index < manifold.points.size()) {
                    let ref point: auto = manifold.points[point_index];
                    point.anchor_a = point.position - constraint_.centre_a;
                    point.anchor_b = point.position - constraint_.centre_b;
                    point.local_a = body_a.to_local(point.position);
                    point.local_b = body_b.to_local(point.position);
                    point.normal_mass = constraint_.effective_mass(point.anchor_a, point.anchor_b,
                                                                  manifold.normal);
                    point.tangent_mass = constraint_.effective_mass(point.anchor_a, point.anchor_b,
                                                                   tangent);

                    // Restitution bias: the approach speed at the contact,
                    // scaled by the coefficient. Slow approaches get none, so
                    // that a resting stack does not buzz.
                    let velocity_a = body_a.velocity_at(point.position);
                    let velocity_b = body_b.velocity_at(point.position);
                    let approach = manifold.normal.x * (velocity_b.x - velocity_a.x)
                        + manifold.normal.y * (velocity_b.y - velocity_a.y);
                    if (approach < -raw_fixed(RESTITUTION_THRESHOLD_RAW)) {
                        point.velocity_bias = -constraint_.restitution * approach;
                    } else {
                        point.velocity_bias = zero_fixed();
                    }
                    point_index += 1;
                }
                self.constraints.push_back(constraint_);
                index += 1;
            }
        }
    }

    // --- Warm starting ----------------------------------------------------

    // Re-apply the impulses accumulated last step before the first iteration.
    // The solver is then starting from a solution that was nearly right,
    // which is worth several iterations of convergence for free.
    fn warm_start(ref self, ref bodies: vector(RigidBody),
                  manifolds: vector(Manifold)) {
        var index: int = 0;
        while (index < self.constraints.size()) {
            let ref constraint_: auto = self.constraints[index];
            let ref manifold: auto = manifolds[constraint_.manifold_index];
            let tangent = manifold.tangent();
            var point_index: int = 0;
            while (point_index < manifold.points.size()) {
                let ref point: auto = manifold.points[point_index];
                let impulse = make_vec2(
                    manifold.normal.x * point.normal_impulse + tangent.x * point.tangent_impulse,
                    manifold.normal.y * point.normal_impulse + tangent.y * point.tangent_impulse);
                let ref body_a: auto = bodies[constraint_.body_a];
                body_a.velocity.x = body_a.velocity.x - impulse.x * constraint_.inverse_mass_a;
                body_a.velocity.y = body_a.velocity.y - impulse.y * constraint_.inverse_mass_a;
                body_a.angular_velocity = body_a.angular_velocity
                    - constraint_.inverse_inertia_a
                    * (point.anchor_a.x * impulse.y - point.anchor_a.y * impulse.x);
                let ref body_b: auto = bodies[constraint_.body_b];
                body_b.velocity.x = body_b.velocity.x + impulse.x * constraint_.inverse_mass_b;
                body_b.velocity.y = body_b.velocity.y + impulse.y * constraint_.inverse_mass_b;
                body_b.angular_velocity = body_b.angular_velocity
                    + constraint_.inverse_inertia_b
                    * (point.anchor_b.x * impulse.y - point.anchor_b.y * impulse.x);
                point_index += 1;
            }
            index += 1;
        }
    }

    // --- Velocity iteration -----------------------------------------------

    // Friction first, then the normal. Solving friction against the previous
    // step's normal impulse rather than this iteration's is the standard
    // ordering and behaves much better on slopes.
    fn solve_velocity_once(ref self, ref bodies: vector(RigidBody),
                           ref manifolds: vector(Manifold)) {
        var index: int = 0;
        while (index < self.constraints.size()) {
            let ref constraint_: auto = self.constraints[index];
            let ref manifold: auto = manifolds[constraint_.manifold_index];
            let tangent = manifold.tangent();

            var point_index: int = 0;
            while (point_index < manifold.points.size()) {
                let ref point: auto = manifold.points[point_index];
                let ref body_a: auto = bodies[constraint_.body_a];
                let ref body_b: auto = bodies[constraint_.body_b];

                // Relative velocity at the contact, written out so that the
                // angular terms are visible: v + omega cross r for each body.
                let relative_x = body_b.velocity.x - body_b.angular_velocity * point.anchor_b.y
                    - body_a.velocity.x + body_a.angular_velocity * point.anchor_a.y;
                let relative_y = body_b.velocity.y + body_b.angular_velocity * point.anchor_b.x
                    - body_a.velocity.y - body_a.angular_velocity * point.anchor_a.x;

                // --- Friction along the tangent ---------------------------
                let tangent_speed = tangent.x * relative_x + tangent.y * relative_y;
                var tangent_delta = -point.tangent_mass * tangent_speed;
                let friction_limit = constraint_.friction * point.normal_impulse;
                let new_tangent = (point.tangent_impulse + tangent_delta)
                    .clamped(-friction_limit, friction_limit);
                tangent_delta = new_tangent - point.tangent_impulse;
                point.tangent_impulse = new_tangent + zero_fixed();

                let friction_impulse = make_vec2(tangent.x * tangent_delta, tangent.y * tangent_delta);
                body_a.velocity.x = body_a.velocity.x - friction_impulse.x * constraint_.inverse_mass_a;
                body_a.velocity.y = body_a.velocity.y - friction_impulse.y * constraint_.inverse_mass_a;
                body_a.angular_velocity = body_a.angular_velocity
                    - constraint_.inverse_inertia_a
                    * (point.anchor_a.x * friction_impulse.y - point.anchor_a.y * friction_impulse.x);
                body_b.velocity.x = body_b.velocity.x + friction_impulse.x * constraint_.inverse_mass_b;
                body_b.velocity.y = body_b.velocity.y + friction_impulse.y * constraint_.inverse_mass_b;
                body_b.angular_velocity = body_b.angular_velocity
                    + constraint_.inverse_inertia_b
                    * (point.anchor_b.x * friction_impulse.y - point.anchor_b.y * friction_impulse.x);

                // --- Normal impulse ---------------------------------------
                let after_x = body_b.velocity.x - body_b.angular_velocity * point.anchor_b.y
                    - body_a.velocity.x + body_a.angular_velocity * point.anchor_a.y;
                let after_y = body_b.velocity.y + body_b.angular_velocity * point.anchor_b.x
                    - body_a.velocity.y - body_a.angular_velocity * point.anchor_a.x;
                let normal_speed = manifold.normal.x * after_x + manifold.normal.y * after_y;
                var normal_delta = -point.normal_mass * (normal_speed - point.velocity_bias);
                // The accumulated total is clamped, not the increment.
                let new_normal = fixed_max(point.normal_impulse + normal_delta, zero_fixed());
                normal_delta = new_normal - point.normal_impulse;
                point.normal_impulse = new_normal + zero_fixed();

                let normal_impulse = make_vec2(manifold.normal.x * normal_delta,
                                               manifold.normal.y * normal_delta);
                body_a.velocity.x = body_a.velocity.x - normal_impulse.x * constraint_.inverse_mass_a;
                body_a.velocity.y = body_a.velocity.y - normal_impulse.y * constraint_.inverse_mass_a;
                body_a.angular_velocity = body_a.angular_velocity
                    - constraint_.inverse_inertia_a
                    * (point.anchor_a.x * normal_impulse.y - point.anchor_a.y * normal_impulse.x);
                body_b.velocity.x = body_b.velocity.x + normal_impulse.x * constraint_.inverse_mass_b;
                body_b.velocity.y = body_b.velocity.y + normal_impulse.y * constraint_.inverse_mass_b;
                body_b.angular_velocity = body_b.angular_velocity
                    + constraint_.inverse_inertia_b
                    * (point.anchor_b.x * normal_impulse.y - point.anchor_b.y * normal_impulse.x);

                solver_iteration_count += 1;
                point_index += 1;
            }
            index += 1;
        }
    }

    fn solve_velocity(ref self, ref bodies: vector(RigidBody),
                      ref manifolds: vector(Manifold), iterations: int) {
        var pass: int = 0;
        while (pass < iterations) {
            self.solve_velocity_once(bodies, manifolds);
            pass += 1;
        }
    }

    // --- Position iteration -----------------------------------------------

    // Non-linear Gauss-Seidel on the positions. Rather than adding a bias to
    // the velocity constraint, the bodies are moved directly, which removes
    // the energy that a Baumgarte velocity bias would otherwise inject.
    //
    // Returns the deepest remaining penetration, so that the caller can stop
    // early once every contact is within the slop.
    fn solve_position_once(ref self, ref bodies: vector(RigidBody),
                           ref manifolds: vector(Manifold)) -> Fixed {
        var deepest = zero_fixed();
        let slop = raw_fixed(PENETRATION_SLOP_RAW);
        let baumgarte = raw_fixed(BAUMGARTE_RAW);
        let max_correction = raw_fixed(MAX_LINEAR_CORRECTION_RAW);
        var index: int = 0;
        while (index < self.constraints.size()) {
            let ref constraint_: auto = self.constraints[index];
            let ref manifold: auto = manifolds[constraint_.manifold_index];
            var point_index: int = 0;
            while (point_index < manifold.points.size()) {
                let ref point: auto = manifold.points[point_index];
                let ref body_a: auto = bodies[constraint_.body_a];
                let ref body_b: auto = bodies[constraint_.body_b];

                // Recompute the world anchors from the local ones, because
                // the bodies have moved since the manifold was built.
                let world_a = body_a.to_world(point.local_a);
                let world_b = body_b.to_world(point.local_b);
                let separation = manifold.normal.x * (world_b.x - world_a.x)
                    + manifold.normal.y * (world_b.y - world_a.y)
                    + point.separation;
                deepest = fixed_min(deepest, separation);

                let correction = (baumgarte * (separation + slop))
                    .clamped(-max_correction, zero_fixed());
                let anchor_a = world_a - body_a.world_centre();
                let anchor_b = world_b - body_b.world_centre();
                let mass = constraint_.effective_mass(anchor_a, anchor_b, manifold.normal);
                let magnitude = -mass * correction;
                let push = make_vec2(manifold.normal.x * magnitude, manifold.normal.y * magnitude);

                body_a.frame.position.x = body_a.frame.position.x - push.x * constraint_.inverse_mass_a;
                body_a.frame.position.y = body_a.frame.position.y - push.y * constraint_.inverse_mass_a;
                body_a.frame.angle = body_a.frame.angle
                    - constraint_.inverse_inertia_a * (anchor_a.x * push.y - anchor_a.y * push.x);
                body_a.frame.refresh();

                body_b.frame.position.x = body_b.frame.position.x + push.x * constraint_.inverse_mass_b;
                body_b.frame.position.y = body_b.frame.position.y + push.y * constraint_.inverse_mass_b;
                body_b.frame.angle = body_b.frame.angle
                    + constraint_.inverse_inertia_b * (anchor_b.x * push.y - anchor_b.y * push.x);
                body_b.frame.refresh();

                point_index += 1;
            }
            index += 1;
        }
        return deepest;
    }

    fn solve_position(ref self, ref bodies: vector(RigidBody),
                      ref manifolds: vector(Manifold), iterations: int) -> bool {
        let target = -raw_fixed(PENETRATION_SLOP_RAW) * 3;
        var pass: int = 0;
        var settled: bool = false;
        while (pass < iterations and not settled) {
            let deepest = self.solve_position_once(bodies, manifolds);
            if (deepest >= target) {
                settled = true;
            }
            pass += 1;
        }
        return settled;
    }

    // --- Diagnostics ------------------------------------------------------

    fn constraint_count(self) -> int {
        return self.constraints.size();
    }

    // Sum of every normal impulse in the solver, which is the total normal
    // force times the timestep and should equal the weight the ground is
    // holding up in a resting stack.
    fn total_normal_impulse(self, manifolds: vector(Manifold)) -> Fixed {
        var total = zero_fixed();
        var index: int = 0;
        while (index < self.constraints.size()) {
            total = total + manifolds[self.constraints[index].manifold_index].total_normal_impulse();
            index += 1;
        }
        return total;
    }

    var constraints: vector(ContactConstraint);
}

// --- Joints ---------------------------------------------------------------
//
// Both joints follow the same shape as the contact solver: an initialise
// step that computes the effective mass and the bias, a warm start that
// re-applies last step's impulse, and an iteration step that computes and
// clamps an impulse increment.

// Fraction of joint position error removed per substep.
let JOINT_BAUMGARTE_RAW: int = 13107;

// A distance joint above this stretch factor reports itself broken.
let JOINT_BREAK_STRETCH_RAW: int = 196608;

// A distance constraint between a point on each of two bodies. With a
// stiffness and a damping ratio it becomes a soft constraint, which is how a
// spring is spelled; with both at zero it is rigid.
class DistanceJoint {

    // Effective mass along the joint axis, which is the same formula as a
    // contact normal constraint.
    fn axial_mass(self, a: RigidBody, b: RigidBody,
                  anchor_a: Vec2, anchor_b: Vec2) -> Fixed {
        let cross_a = anchor_a.x * self.axis.y - anchor_a.y * self.axis.x;
        let cross_b = anchor_b.x * self.axis.y - anchor_b.y * self.axis.x;
        let total = a.inverse_mass + b.inverse_mass
            + a.inverse_inertia * cross_a * cross_a
            + b.inverse_inertia * cross_b * cross_b;
        if (total.raw <= 0) {
            return zero_fixed();
        }
        return total.reciprocal();
    }

    // Compute the axis, the current length and the bias for this substep.
    fn prepare(ref self, ref bodies: vector(RigidBody), dt: Fixed) {
        let ref body_a: auto = bodies[self.body_a];
        let ref body_b: auto = bodies[self.body_b];
        let world_a = body_a.to_world(self.local_anchor_a);
        let world_b = body_b.to_world(self.local_anchor_b);
        self.anchor_a = world_a - body_a.world_centre();
        self.anchor_b = world_b - body_b.world_centre();

        let separation = world_b - world_a;
        self.current_length = separation.length();
        if (self.current_length.raw <= LINEAR_EPSILON_RAW) {
            self.axis = vec2_unit_x();
        } else {
            self.axis = separation / self.current_length;
        }
        self.mass = self.axial_mass(body_a, body_b, self.anchor_a, self.anchor_b);

        let error = self.current_length - self.rest_length;
        if (self.stiffness.raw > 0) {
            // Soft constraint: the bias pulls towards the rest length at a
            // rate set by the stiffness, and the damping term is folded into
            // the effective mass through the gamma softening parameter.
            let omega = self.stiffness;
            let zeta = self.damping;
            let c = dt * omega * (dt * omega + zeta * 2);
            if (c.raw != 0) {
                self.gamma = (dt * (dt * omega * omega + omega * zeta * 2)).reciprocal();
            } else {
                self.gamma = zero_fixed();
            }
            self.bias = error * dt * omega * omega * self.gamma;
            if ((self.mass + self.gamma).raw != 0) {
                self.mass = (self.mass.reciprocal() + self.gamma).reciprocal();
            }
        } else {
            self.gamma = zero_fixed();
            self.bias = error * raw_fixed(JOINT_BAUMGARTE_RAW) / dt;
        }

        if (self.current_length > self.rest_length * 2 + raw_fixed(JOINT_BREAK_STRETCH_RAW)) {
            self.status = JointStatus.Broken;
        } else {
            self.status = JointStatus.Satisfied;
        }
    }

    fn warm_start(ref self, ref bodies: vector(RigidBody)) {
        let impulse = self.axis * self.accumulated_impulse;
        let ref body_a: auto = bodies[self.body_a];
        body_a.velocity.x = body_a.velocity.x - impulse.x * body_a.inverse_mass;
        body_a.velocity.y = body_a.velocity.y - impulse.y * body_a.inverse_mass;
        body_a.angular_velocity = body_a.angular_velocity
            - body_a.inverse_inertia * (self.anchor_a.x * impulse.y - self.anchor_a.y * impulse.x);
        let ref body_b: auto = bodies[self.body_b];
        body_b.velocity.x = body_b.velocity.x + impulse.x * body_b.inverse_mass;
        body_b.velocity.y = body_b.velocity.y + impulse.y * body_b.inverse_mass;
        body_b.angular_velocity = body_b.angular_velocity
            + body_b.inverse_inertia * (self.anchor_b.x * impulse.y - self.anchor_b.y * impulse.x);
    }

    fn solve_velocity(ref self, ref bodies: vector(RigidBody)) {
        if (self.status == JointStatus.Broken) {
            return;
        }
        let ref body_a: auto = bodies[self.body_a];
        let ref body_b: auto = bodies[self.body_b];
        let relative_x = body_b.velocity.x - body_b.angular_velocity * self.anchor_b.y
            - body_a.velocity.x + body_a.angular_velocity * self.anchor_a.y;
        let relative_y = body_b.velocity.y + body_b.angular_velocity * self.anchor_b.x
            - body_a.velocity.y - body_a.angular_velocity * self.anchor_a.x;
        let axial_speed = self.axis.x * relative_x + self.axis.y * relative_y;
        var delta = -self.mass * (axial_speed + self.bias + self.gamma * self.accumulated_impulse);

        // A rope only pulls; a rigid rod both pulls and pushes.
        if (self.rope_only) {
            let total = fixed_min(self.accumulated_impulse + delta, zero_fixed());
            delta = total - self.accumulated_impulse;
            self.accumulated_impulse = total + zero_fixed();
        } else {
            self.accumulated_impulse = self.accumulated_impulse + delta;
        }

        let impulse = make_vec2(self.axis.x * delta, self.axis.y * delta);
        body_a.velocity.x = body_a.velocity.x - impulse.x * body_a.inverse_mass;
        body_a.velocity.y = body_a.velocity.y - impulse.y * body_a.inverse_mass;
        body_a.angular_velocity = body_a.angular_velocity
            - body_a.inverse_inertia * (self.anchor_a.x * impulse.y - self.anchor_a.y * impulse.x);
        body_b.velocity.x = body_b.velocity.x + impulse.x * body_b.inverse_mass;
        body_b.velocity.y = body_b.velocity.y + impulse.y * body_b.inverse_mass;
        body_b.angular_velocity = body_b.angular_velocity
            + body_b.inverse_inertia * (self.anchor_b.x * impulse.y - self.anchor_b.y * impulse.x);
    }

    // Direct position correction for the rigid case. A soft joint skips this,
    // because its whole point is to allow error.
    fn solve_position(ref self, ref bodies: vector(RigidBody)) -> bool {
        if (self.stiffness.raw > 0 or self.status == JointStatus.Broken) {
            return true;
        }
        let ref body_a: auto = bodies[self.body_a];
        let ref body_b: auto = bodies[self.body_b];
        let world_a = body_a.to_world(self.local_anchor_a);
        let world_b = body_b.to_world(self.local_anchor_b);
        let separation = world_b - world_a;
        let length = separation.length();
        if (length.raw <= LINEAR_EPSILON_RAW) {
            return true;
        }
        let unit = separation / length;
        let error = (length - self.rest_length).clamped(-raw_fixed(MAX_LINEAR_CORRECTION_RAW),
                                                    raw_fixed(MAX_LINEAR_CORRECTION_RAW));
        let anchor_a = world_a - body_a.world_centre();
        let anchor_b = world_b - body_b.world_centre();
        let mass = self.axial_mass(body_a, body_b, anchor_a, anchor_b);
        let push = unit * (-mass * error);
        body_a.frame.position = body_a.frame.position - push * body_a.inverse_mass;
        body_b.frame.position = body_b.frame.position + push * body_b.inverse_mass;
        body_a.frame.refresh();
        body_b.frame.refresh();
        if (error.magnitude().raw > PENETRATION_SLOP_RAW) {
            self.status = JointStatus.Corrected;
            return false;
        }
        return true;
    }

    fn stretch_ratio(self) -> Fixed {
        if (self.rest_length.raw == 0) {
            return zero_fixed();
        }
        return self.current_length / self.rest_length;
    }

    var body_a: int = 0;
    var body_b: int = 0;
    var local_anchor_a: Vec2;
    var local_anchor_b: Vec2;
    var anchor_a: Vec2;
    var anchor_b: Vec2;
    var axis: Vec2;
    var rest_length: Fixed;
    var current_length: Fixed;
    var stiffness: Fixed;
    var damping: Fixed;
    var gamma: Fixed;
    var bias: Fixed;
    var mass: Fixed;
    var accumulated_impulse: Fixed;
    var rope_only: bool = false;
    var status: JointStatus = JointStatus.Satisfied;
}

fn make_distance_joint(body_a: int, body_b: int, local_a: Vec2,
                       local_b: Vec2, rest_length: Fixed) -> DistanceJoint {
    var result: DistanceJoint;
    result.body_a = body_a;
    result.body_b = body_b;
    result.local_anchor_a = local_a + vec2_zero();
    result.local_anchor_b = local_b + vec2_zero();
    result.rest_length = rest_length + zero_fixed();
    result.axis = vec2_unit_x();
    return result;
}

fn make_spring_joint(body_a: int, body_b: int, local_a: Vec2,
                     local_b: Vec2, rest_length: Fixed,
                     stiffness: Fixed, damping: Fixed) -> DistanceJoint {
    var result = make_distance_joint(body_a, body_b, local_a, local_b, rest_length);
    result.stiffness = stiffness + zero_fixed();
    result.damping = damping + zero_fixed();
    return result;
}

// A revolute joint pins two points together and lets the bodies spin freely
// about the shared point. The constraint is two-dimensional, so the effective
// mass is a 2x2 matrix and the impulse is a vector, which is exactly what
// Mat2.solve is for.
class RevoluteJoint {

    fn prepare(ref self, ref bodies: vector(RigidBody), dt: Fixed) {
        let ref body_a: auto = bodies[self.body_a];
        let ref body_b: auto = bodies[self.body_b];
        let world_a = body_a.to_world(self.local_anchor_a);
        let world_b = body_b.to_world(self.local_anchor_b);
        self.anchor_a = world_a - body_a.world_centre();
        self.anchor_b = world_b - body_b.world_centre();

        // The effective mass matrix for a point-to-point constraint:
        //
        //     K = (1/ma + 1/mb) I
        //       + 1/Ia [ ra.y^2, -ra.x ra.y ; -ra.x ra.y, ra.x^2 ]
        //       + 1/Ib [ rb.y^2, -rb.x rb.y ; -rb.x rb.y, rb.x^2 ]
        let scalar = body_a.inverse_mass + body_b.inverse_mass;
        let xx = scalar
            + body_a.inverse_inertia * self.anchor_a.y * self.anchor_a.y
            + body_b.inverse_inertia * self.anchor_b.y * self.anchor_b.y;
        let xy = -body_a.inverse_inertia * self.anchor_a.x * self.anchor_a.y
            - body_b.inverse_inertia * self.anchor_b.x * self.anchor_b.y;
        let yy = scalar
            + body_a.inverse_inertia * self.anchor_a.x * self.anchor_a.x
            + body_b.inverse_inertia * self.anchor_b.x * self.anchor_b.x;
        self.mass = make_mat2(make_vec2(xx, xy), make_vec2(xy, yy));

        // Positional drift, fed back as a velocity bias.
        let drift = world_b - world_a;
        self.bias = drift * raw_fixed(JOINT_BAUMGARTE_RAW) / dt;

        // The angular part, if a motor or a limit is active.
        let angular_total = body_a.inverse_inertia + body_b.inverse_inertia;
        if (angular_total.raw > 0) {
            self.angular_mass = angular_total.reciprocal();
        } else {
            self.angular_mass = zero_fixed();
        }
        self.relative_angle = normalise_angle(body_b.frame.angle - body_a.frame.angle - self.reference_angle);
    }

    fn warm_start(ref self, ref bodies: vector(RigidBody)) {
        let ref body_a: auto = bodies[self.body_a];
        body_a.velocity.x = body_a.velocity.x - self.accumulated_impulse.x * body_a.inverse_mass;
        body_a.velocity.y = body_a.velocity.y - self.accumulated_impulse.y * body_a.inverse_mass;
        body_a.angular_velocity = body_a.angular_velocity
            - body_a.inverse_inertia
            * (self.anchor_a.x * self.accumulated_impulse.y - self.anchor_a.y * self.accumulated_impulse.x)
            - body_a.inverse_inertia * self.accumulated_motor_impulse;
        let ref body_b: auto = bodies[self.body_b];
        body_b.velocity.x = body_b.velocity.x + self.accumulated_impulse.x * body_b.inverse_mass;
        body_b.velocity.y = body_b.velocity.y + self.accumulated_impulse.y * body_b.inverse_mass;
        body_b.angular_velocity = body_b.angular_velocity
            + body_b.inverse_inertia
            * (self.anchor_b.x * self.accumulated_impulse.y - self.anchor_b.y * self.accumulated_impulse.x)
            + body_b.inverse_inertia * self.accumulated_motor_impulse;
    }

    fn solve_velocity(ref self, ref bodies: vector(RigidBody), dt: Fixed) {
        let ref body_a: auto = bodies[self.body_a];
        let ref body_b: auto = bodies[self.body_b];

        // --- Motor, if enabled --------------------------------------------
        if (self.motor_enabled) {
            let relative_speed = body_b.angular_velocity - body_a.angular_velocity - self.motor_speed;
            var motor_delta = -self.angular_mass * relative_speed;
            let budget = self.max_motor_torque * dt;
            let total = (self.accumulated_motor_impulse + motor_delta).clamped(-budget, budget);
            motor_delta = total - self.accumulated_motor_impulse;
            self.accumulated_motor_impulse = total + zero_fixed();
            body_a.angular_velocity = body_a.angular_velocity - motor_delta * body_a.inverse_inertia;
            body_b.angular_velocity = body_b.angular_velocity + motor_delta * body_b.inverse_inertia;
        }

        // --- Angular limits, if enabled -----------------------------------
        if (self.limit_enabled) {
            if (self.relative_angle < self.lower_limit) {
                let excess = self.relative_angle - self.lower_limit;
                let speed = body_b.angular_velocity - body_a.angular_velocity;
                var delta = -self.angular_mass * (speed + excess * raw_fixed(JOINT_BAUMGARTE_RAW) / dt);
                let total = fixed_max(self.accumulated_limit_impulse + delta, zero_fixed());
                delta = total - self.accumulated_limit_impulse;
                self.accumulated_limit_impulse = total + zero_fixed();
                body_a.angular_velocity = body_a.angular_velocity - delta * body_a.inverse_inertia;
                body_b.angular_velocity = body_b.angular_velocity + delta * body_b.inverse_inertia;
            } else {
                if (self.relative_angle > self.upper_limit) {
                    let excess = self.relative_angle - self.upper_limit;
                    let speed = body_b.angular_velocity - body_a.angular_velocity;
                    var delta = -self.angular_mass * (speed + excess * raw_fixed(JOINT_BAUMGARTE_RAW) / dt);
                    let total = fixed_min(self.accumulated_limit_impulse + delta, zero_fixed());
                    delta = total - self.accumulated_limit_impulse;
                    self.accumulated_limit_impulse = total + zero_fixed();
                    body_a.angular_velocity = body_a.angular_velocity - delta * body_a.inverse_inertia;
                    body_b.angular_velocity = body_b.angular_velocity + delta * body_b.inverse_inertia;
                }
            }
        }

        // --- The point-to-point constraint itself -------------------------
        let relative_x = body_b.velocity.x - body_b.angular_velocity * self.anchor_b.y
            - body_a.velocity.x + body_a.angular_velocity * self.anchor_a.y;
        let relative_y = body_b.velocity.y + body_b.angular_velocity * self.anchor_b.x
            - body_a.velocity.y - body_a.angular_velocity * self.anchor_a.x;
        let residual = make_vec2(relative_x + self.bias.x, relative_y + self.bias.y);
        let impulse = self.mass.solve(-residual);
        self.accumulated_impulse = self.accumulated_impulse + impulse;

        body_a.velocity.x = body_a.velocity.x - impulse.x * body_a.inverse_mass;
        body_a.velocity.y = body_a.velocity.y - impulse.y * body_a.inverse_mass;
        body_a.angular_velocity = body_a.angular_velocity
            - body_a.inverse_inertia * (self.anchor_a.x * impulse.y - self.anchor_a.y * impulse.x);
        body_b.velocity.x = body_b.velocity.x + impulse.x * body_b.inverse_mass;
        body_b.velocity.y = body_b.velocity.y + impulse.y * body_b.inverse_mass;
        body_b.angular_velocity = body_b.angular_velocity
            + body_b.inverse_inertia * (self.anchor_b.x * impulse.y - self.anchor_b.y * impulse.x);
    }

    fn solve_position(ref self, ref bodies: vector(RigidBody)) -> bool {
        let ref body_a: auto = bodies[self.body_a];
        let ref body_b: auto = bodies[self.body_b];
        let world_a = body_a.to_world(self.local_anchor_a);
        let world_b = body_b.to_world(self.local_anchor_b);
        let drift = world_b - world_a;
        if (drift.length_squared().raw <= LINEAR_EPSILON_SQUARED_RAW) {
            return true;
        }
        let anchor_a = world_a - body_a.world_centre();
        let anchor_b = world_b - body_b.world_centre();
        let scalar = body_a.inverse_mass + body_b.inverse_mass;
        let xx = scalar
            + body_a.inverse_inertia * anchor_a.y * anchor_a.y
            + body_b.inverse_inertia * anchor_b.y * anchor_b.y;
        let xy = -body_a.inverse_inertia * anchor_a.x * anchor_a.y
            - body_b.inverse_inertia * anchor_b.x * anchor_b.y;
        let yy = scalar
            + body_a.inverse_inertia * anchor_a.x * anchor_a.x
            + body_b.inverse_inertia * anchor_b.x * anchor_b.x;
        let matrix = make_mat2(make_vec2(xx, xy), make_vec2(xy, yy));
        let push = matrix.solve(-drift);
        body_a.frame.position = body_a.frame.position - push * body_a.inverse_mass;
        body_a.frame.angle = body_a.frame.angle
            - body_a.inverse_inertia * (anchor_a.x * push.y - anchor_a.y * push.x);
        body_a.frame.refresh();
        body_b.frame.position = body_b.frame.position + push * body_b.inverse_mass;
        body_b.frame.angle = body_b.frame.angle
            + body_b.inverse_inertia * (anchor_b.x * push.y - anchor_b.y * push.x);
        body_b.frame.refresh();
        return drift.manhattan_length().raw <= PENETRATION_SLOP_RAW;
    }

    var body_a: int = 0;
    var body_b: int = 0;
    var local_anchor_a: Vec2;
    var local_anchor_b: Vec2;
    var anchor_a: Vec2;
    var anchor_b: Vec2;
    var mass: Mat2;
    var bias: Vec2;
    var accumulated_impulse: Vec2;
    var angular_mass: Fixed;
    var accumulated_motor_impulse: Fixed;
    var accumulated_limit_impulse: Fixed;
    var reference_angle: Fixed;
    var relative_angle: Fixed;
    var motor_speed: Fixed;
    var max_motor_torque: Fixed;
    var lower_limit: Fixed;
    var upper_limit: Fixed;
    var motor_enabled: bool = false;
    var limit_enabled: bool = false;
}

fn make_revolute_joint(body_a: int, body_b: int, local_a: Vec2,
                       local_b: Vec2) -> RevoluteJoint {
    var result: RevoluteJoint;
    result.body_a = body_a;
    result.body_b = body_b;
    result.local_anchor_a = local_a + vec2_zero();
    result.local_anchor_b = local_b + vec2_zero();
    result.mass = mat2_identity();
    return result;
}

fn make_motorised_joint(body_a: int, body_b: int, local_a: Vec2,
                        local_b: Vec2, speed: Fixed,
                        torque: Fixed) -> RevoluteJoint {
    var result = make_revolute_joint(body_a, body_b, local_a, local_b);
    result.motor_enabled = true;
    result.motor_speed = speed + zero_fixed();
    result.max_motor_torque = torque + zero_fixed();
    return result;
}

// --- Particle system ------------------------------------------------------
//
// Particles are integrated with position Verlet rather than with the
// semi-implicit Euler the rigid bodies use. Verlet stores the previous
// position instead of a velocity, so a positional constraint can be satisfied
// by moving the particle directly and the velocity follows automatically. That
// is what makes a cloth or a rope of a hundred springs stable at stiffnesses
// that would blow up an explicit spring force.
//
//     next = position + (position - previous) * damping + acceleration * dt^2
//
// The velocity is implied by the gap between position and previous, so it must
// never be written directly; use displace() instead, which moves both.

// Constraint relaxation passes per particle step. Verlet constraints converge
// by relaxation, so more passes means a stiffer cloth.
let DEFAULT_RELAXATION_PASSES: int = 4;

// A spring that has stretched beyond this multiple of its rest length snaps.
let SPRING_TEAR_RATIO_RAW: int = 262144;

class Particle {

    // Implied velocity, as a per-second rate rather than a per-step delta.
    fn velocity(self, dt: Fixed) -> Vec2 {
        if (dt.raw == 0) {
            return vec2_zero();
        }
        return (self.position - self.previous) / dt;
    }

    // Move the particle without changing its implied velocity. Every
    // constraint in the system goes through here.
    fn displace(ref self, delta: Vec2) {
        self.position = self.position + delta;
        self.previous = self.previous + delta;
    }

    // Move the particle and let the implied velocity absorb the change, which
    // is what a collision response wants.
    fn shift(ref self, delta: Vec2) {
        self.position = self.position + delta;
    }

    // Set the implied velocity by moving the previous position.
    fn set_velocity(ref self, v: Vec2, dt: Fixed) {
        self.previous = self.position - v * dt;
    }

    fn add_force(ref self, f: Vec2) {
        self.acceleration = self.acceleration + f * self.inverse_mass;
    }

    // One Verlet step. The damping factor multiplies the implied velocity,
    // and the acceleration term is scaled by dt squared because Verlet
    // integrates acceleration to position in one go.
    fn integrate(ref self, gravity: Vec2, dt: Fixed,
                 damping: Fixed) {
        if (self.pinned or self.inverse_mass.raw == 0) {
            self.previous = self.position + vec2_zero();
            self.acceleration = vec2_zero();
            return;
        }
        let implied = (self.position - self.previous) * damping;
        let total_acceleration = self.acceleration + gravity;
        let next = make_vec2(
            self.position.x + implied.x + total_acceleration.x * dt * dt,
            self.position.y + implied.y + total_acceleration.y * dt * dt);
        self.previous = self.position + vec2_zero();
        self.position = next + vec2_zero();
        self.acceleration = vec2_zero();
    }

    fn kinetic_energy(self, dt: Fixed) -> Fixed {
        if (self.inverse_mass.raw == 0) {
            return zero_fixed();
        }
        return self.velocity(dt).length_squared() / (self.inverse_mass * 2);
    }

    var position: Vec2;
    var previous: Vec2;
    var acceleration: Vec2;
    var inverse_mass: Fixed;
    var radius: Fixed;
    var pinned: bool = false;
    var alive: bool = true;
    var group: int = 0;
}

fn make_particle(position: Vec2, mass: Fixed) -> Particle {
    var result: Particle;
    result.position = position + vec2_zero();
    result.previous = position + vec2_zero();
    result.radius = raw_fixed(FIXED_QUARTER);
    if (mass.raw > 0) {
        result.inverse_mass = mass.reciprocal();
    }
    return result;
}

fn make_pinned_particle(position: Vec2) -> Particle {
    var result = make_particle(position, one_fixed());
    result.pinned = true;
    result.inverse_mass = zero_fixed();
    return result;
}

// A distance constraint between two particles, solved by relaxation rather
// than by an impulse. stiffness in [0, 1] is the fraction of the error
// removed per pass.
class Spring {

    fn current_length(self, particles: vector(Particle)) -> Fixed {
        return (particles[self.particle_b].position - particles[self.particle_a].position).length();
    }

    fn strain(self, particles: vector(Particle)) -> Fixed {
        if (self.rest_length.raw == 0) {
            return zero_fixed();
        }
        return (self.current_length(particles) - self.rest_length) / self.rest_length;
    }

    // One relaxation pass. The correction is split between the two particles
    // in proportion to their inverse masses, so a heavy particle barely moves
    // and a pinned one does not move at all.
    fn relax(ref self, ref particles: vector(Particle)) {
        if (self.broken) {
            return;
        }
        let ref a: auto = particles[self.particle_a];
        let ref b: auto = particles[self.particle_b];
        let separation = b.position - a.position;
        let length = separation.length();
        if (length.raw <= LINEAR_EPSILON_RAW) {
            return;
        }
        let total_inverse_mass = a.inverse_mass + b.inverse_mass;
        if (total_inverse_mass.raw == 0) {
            return;
        }
        let error = length - self.rest_length;
        if (self.rest_length.raw > 0 and length > self.rest_length * raw_fixed(SPRING_TEAR_RATIO_RAW)) {
            self.broken = true;
            return;
        }
        let unit = separation / length;
        let correction = unit * (error * self.stiffness / total_inverse_mass);
        self.last_tension = error * self.stiffness;
        let ref mover_a: auto = particles[self.particle_a];
        mover_a.position = mover_a.position + correction * mover_a.inverse_mass;
        let ref mover_b: auto = particles[self.particle_b];
        mover_b.position = mover_b.position - correction * mover_b.inverse_mass;
    }

    // Potential energy stored in the spring, as k x^2 / 2 with k taken as the
    // stiffness. Approximate, but enough for the energy audit below.
    fn potential_energy(self, particles: vector(Particle)) -> Fixed {
        let error = self.current_length(particles) - self.rest_length;
        return self.stiffness * error * error / 2;
    }

    var particle_a: int = 0;
    var particle_b: int = 0;
    var rest_length: Fixed;
    var stiffness: Fixed;
    var last_tension: Fixed;
    var broken: bool = false;
}

fn make_spring(a: int, b: int, rest_length: Fixed,
               stiffness: Fixed) -> Spring {
    var result: Spring;
    result.particle_a = a;
    result.particle_b = b;
    result.rest_length = rest_length + zero_fixed();
    result.stiffness = stiffness + zero_fixed();
    return result;
}

// Ordering by rest length, which the debug tooling uses to find the springs
// most likely to be the stiff ones in a mixed cloth.
impl Spring as Core.OrderedWith(Spring) {
  fn Less(self, other: Spring) -> bool {
      return self.rest_length < other.rest_length;
  }
}

class ParticleSystem {

    // --- Construction -----------------------------------------------------

    fn add_particle(ref self, position: Vec2, mass: Fixed) -> int {
        let index = self.particles.size();
        self.particles.push_back(make_particle(position, mass));
        return index;
    }

    fn add_pinned(ref self, position: Vec2) -> int {
        let index = self.particles.size();
        self.particles.push_back(make_pinned_particle(position));
        return index;
    }

    // Connect two particles with a spring whose rest length is their current
    // separation, which is what building a cloth from a grid wants.
    fn connect(ref self, a: int, b: int, stiffness: Fixed) -> int {
        let rest = (self.particles[b].position - self.particles[a].position).length();
        let index = self.springs.size();
        self.springs.push_back(make_spring(a, b, rest, stiffness));
        return index;
    }

    fn connect_at(ref self, a: int, b: int, rest: Fixed,
                  stiffness: Fixed) -> int {
        let index = self.springs.size();
        self.springs.push_back(make_spring(a, b, rest, stiffness));
        return index;
    }

    // --- Simulation -------------------------------------------------------

    fn integrate(ref self, gravity: Vec2, dt: Fixed) {
        var index: int = 0;
        while (index < self.particles.size()) {
            self.particles[index].integrate(gravity, dt, self.damping);
            index += 1;
        }
    }

    fn relax_springs(ref self) {
        var pass: int = 0;
        while (pass < self.relaxation_passes) {
            var index: int = 0;
            while (index < self.springs.size()) {
                self.springs[index].relax(self.particles);
                index += 1;
            }
            pass += 1;
        }
    }

    // Keep every particle inside the world box, absorbing the normal
    // component of its implied velocity as it goes.
    fn apply_bounds(ref self, bounds: AABB, restitution: Fixed) {
        var index: int = 0;
        while (index < self.particles.size()) {
            let ref particle: auto = self.particles[index];
            if (particle.position.x < bounds.lower.x + particle.radius) {
                particle.position.x = bounds.lower.x + particle.radius;
                particle.previous.x = particle.position.x
                    + (particle.position.x - particle.previous.x) * restitution;
            }
            if (particle.position.x > bounds.upper.x - particle.radius) {
                particle.position.x = bounds.upper.x - particle.radius;
                particle.previous.x = particle.position.x
                    + (particle.position.x - particle.previous.x) * restitution;
            }
            if (particle.position.y < bounds.lower.y + particle.radius) {
                particle.position.y = bounds.lower.y + particle.radius;
                particle.previous.y = particle.position.y
                    + (particle.position.y - particle.previous.y) * restitution;
            }
            if (particle.position.y > bounds.upper.y - particle.radius) {
                particle.position.y = bounds.upper.y - particle.radius;
                particle.previous.y = particle.position.y
                    + (particle.position.y - particle.previous.y) * restitution;
            }
            index += 1;
        }
    }

    // Push overlapping particles apart. Quadratic in the particle count, so
    // this is only for the small systems; a large one would route through the
    // spatial hash the same way the rigid bodies do.
    fn resolve_particle_overlap(ref self) {
        var first: int = 0;
        while (first < self.particles.size()) {
            var second = first + 1;
            while (second < self.particles.size()) {
                let ref a: auto = self.particles[first];
                let ref b: auto = self.particles[second];
                let separation = b.position - a.position;
                let combined = a.radius + b.radius;
                let distance_squared = separation.length_squared();
                if (distance_squared < combined * combined and distance_squared.raw > 0) {
                    let distance = distance_squared.square_root();
                    let overlap = combined - distance;
                    let unit = separation / distance;
                    let total_inverse_mass = a.inverse_mass + b.inverse_mass;
                    if (total_inverse_mass.raw > 0) {
                        let correction = unit * (overlap / total_inverse_mass);
                        let ref mover_a: auto = self.particles[first];
                        mover_a.position = mover_a.position - correction * mover_a.inverse_mass;
                        let ref mover_b: auto = self.particles[second];
                        mover_b.position = mover_b.position + correction * mover_b.inverse_mass;
                    }
                }
                second += 1;
            }
            first += 1;
        }
    }

    // Push particles out of the rigid bodies they have sunk into. Particles
    // do not push back, which keeps the two systems one-way coupled and so
    // keeps the rigid solver's energy audit honest.
    fn resolve_body_overlap(ref self, bodies: vector(RigidBody)) {
        var index: int = 0;
        while (index < self.particles.size()) {
            var body_index: int = 0;
            while (body_index < bodies.size()) {
                let ref body: auto = bodies[body_index];
                let ref particle: auto = self.particles[index];
                if (body.shape.contains_point(body.frame, particle.position)) {
                    let direction = (particle.position - body.world_centre()).normalised();
                    particle.position = particle.position + direction * particle.radius;
                }
                body_index += 1;
            }
            index += 1;
        }
    }

    fn step(ref self, gravity: Vec2, dt: Fixed,
            bounds: AABB) {
        self.integrate(gravity, dt);
        self.relax_springs();
        self.resolve_particle_overlap();
        self.apply_bounds(bounds, self.bounce);
    }

    // --- Energy -----------------------------------------------------------

    fn kinetic_energy(self, dt: Fixed) -> Fixed {
        var total = zero_fixed();
        var index: int = 0;
        while (index < self.particles.size()) {
            total = total + self.particles[index].kinetic_energy(dt);
            index += 1;
        }
        return total;
    }

    fn spring_energy(self) -> Fixed {
        var total = zero_fixed();
        var index: int = 0;
        while (index < self.springs.size()) {
            total = total + self.springs[index].potential_energy(self.particles);
            index += 1;
        }
        return total;
    }

    fn centre_of_mass(self) -> Vec2 {
        var weighted = vec2_zero();
        var total_mass = zero_fixed();
        var index: int = 0;
        while (index < self.particles.size()) {
            let ref particle: auto = self.particles[index];
            if (particle.inverse_mass.raw > 0) {
                let mass = particle.inverse_mass.reciprocal();
                weighted = weighted + particle.position * mass;
                total_mass = total_mass + mass;
            }
            index += 1;
        }
        if (total_mass.raw == 0) {
            return vec2_zero();
        }
        return weighted / total_mass;
    }

    fn broken_spring_count(self) -> int {
        var count: int = 0;
        var index: int = 0;
        while (index < self.springs.size()) {
            if (self.springs[index].broken) {
                count += 1;
            }
            index += 1;
        }
        return count;
    }

    var particles: vector(Particle);
    var springs: vector(Spring);
    var damping: Fixed;
    var bounce: Fixed;
    var relaxation_passes: int = 4;
}

fn make_particle_system() -> ParticleSystem {
    var result: ParticleSystem;
    // 0.99 * 65536 = 64880, a light per-step velocity decay.
    result.damping = raw_fixed(64880);
    result.bounce = ratio(-4, 10);
    result.relaxation_passes = DEFAULT_RELAXATION_PASSES;
    return result;
}

// Build a rectangular cloth of width by height particles, pinned along the
// top edge, with structural springs between neighbours and shear springs
// across each cell's diagonals.
fn build_cloth(ref system: ParticleSystem, origin: Vec2,
               columns: int, rows: int, spacing: Fixed,
               stiffness: Fixed) {
    let first_index = system.particles.size();
    var row: int = 0;
    while (row < rows) {
        var column: int = 0;
        while (column < columns) {
            let position = make_vec2(origin.x + spacing * column, origin.y - spacing * row);
            if (row == 0 and (column == 0 or column == columns - 1)) {
                Discard(system.add_pinned(position));
            } else {
                Discard(system.add_particle(position, one_fixed()));
            }
            column += 1;
        }
        row += 1;
    }
    row = 0;
    while (row < rows) {
        var column: int = 0;
        while (column < columns) {
            let here = first_index + row * columns + column;
            if (column + 1 < columns) {
                Discard(system.connect(here, here + 1, stiffness));
            }
            if (row + 1 < rows) {
                Discard(system.connect(here, here + columns, stiffness));
            }
            if (column + 1 < columns and row + 1 < rows) {
                Discard(system.connect(here, here + columns + 1, stiffness / 2));
                Discard(system.connect(here + 1, here + columns, stiffness / 2));
            }
            column += 1;
        }
        row += 1;
    }
}

// A rope of segment_count links hanging from a pinned first particle.
fn build_rope(ref system: ParticleSystem, anchor: Vec2,
              segment_count: int, segment_length: Fixed,
              stiffness: Fixed) -> int {
    let first_index = system.add_pinned(anchor);
    var previous = first_index;
    var index: int = 1;
    while (index <= segment_count) {
        let position = make_vec2(anchor.x, anchor.y - segment_length * index);
        let current = system.add_particle(position, one_fixed());
        Discard(system.connect_at(previous, current, segment_length, stiffness));
        previous = current;
        index += 1;
    }
    return first_index;
}

// --- World ----------------------------------------------------------------
//
// The world owns every body, joint and manifold, and drives the fixed
// timestep loop. The loop is fixed because a variable timestep makes a
// simulation unreproducible and makes the solver's stiffness depend on the
// frame rate, which is how a physics bug becomes a "it only happens on the
// slow machine" bug.

// The simulation runs at 60 steps per second, so one step is 1/60 of a second
// and its raw fixed-point value is 65536 / 60 = 1092.
let DEFAULT_TIMESTEP_RAW: int = 1092;

// Never advance more than this many steps in one update, no matter how far
// behind the accumulator has fallen. Without the cap a machine that cannot
// keep up spirals: each update takes longer, which leaves more to catch up.
let MAX_STEPS_PER_UPDATE: int = 8;

// Substeps per step. Splitting a step into substeps and running the whole
// solve on each is far more effective per unit of work than running more
// solver iterations on one long step.
let DEFAULT_SUBSTEPS: int = 4;

// Gravity: 9.81 * 65536 = 642877, downward.
let GRAVITY_RAW: int = 642877;

// Broad-phase proxy margin: 0.1 of a unit is 6553 raw.
let PROXY_MARGIN_RAW: int = 6553;

// Sleep thresholds. 0.05 units per second linear, 0.02 radians per second
// angular, half a second of stillness.
let SLEEP_LINEAR_RAW: int = 3276;
let SLEEP_ANGULAR_RAW: int = 1310;
let TIME_TO_SLEEP_RAW: int = 32768;

// One frame's worth of counters, for the profiler.
class StepStatistics {

    fn reset(ref self) {
        self.broad_phase_pairs = 0;
        self.narrow_phase_tests = 0;
        self.manifold_count = 0;
        self.contact_point_count = 0;
        self.solver_iterations = 0;
        self.awake_body_count = 0;
        self.position_passes_used = 0;
    }

    // Contact points per manifold, in fixed point. Consistently near two says
    // the scene is mostly face contacts, which is the healthy case.
    fn average_points_per_manifold(self) -> Fixed {
        if (self.manifold_count == 0) {
            return zero_fixed();
        }
        return whole(self.contact_point_count) / whole(self.manifold_count);
    }

    var broad_phase_pairs: int = 0;
    var narrow_phase_tests: int = 0;
    var manifold_count: int = 0;
    var contact_point_count: int = 0;
    var solver_iterations: int = 0;
    var awake_body_count: int = 0;
    var position_passes_used: int = 0;
}

class World {

    // --- Construction -----------------------------------------------------

    fn configure(ref self) {
        self.gravity = make_vec2(zero_fixed(), -raw_fixed(GRAVITY_RAW));
        self.timestep = raw_fixed(DEFAULT_TIMESTEP_RAW);
        self.accumulator = zero_fixed();
        self.substeps = DEFAULT_SUBSTEPS;
        self.velocity_iterations = DEFAULT_VELOCITY_ITERATIONS;
        self.position_iterations = DEFAULT_POSITION_ITERATIONS;
        self.proxy_margin = raw_fixed(PROXY_MARGIN_RAW);
        self.sleep_linear = raw_fixed(SLEEP_LINEAR_RAW);
        self.sleep_angular = raw_fixed(SLEEP_ANGULAR_RAW);
        self.time_to_sleep = raw_fixed(TIME_TO_SLEEP_RAW);
        self.bounds = make_aabb(vec2_from_ints(-500, -500), vec2_from_ints(500, 500));
        self.grid = make_spatial_hash(whole(4));
        self.particles = make_particle_system();
        self.step_index = 0;
    }

    fn add_body(ref self, body: RigidBody) -> int {
        let index = self.bodies.size();
        var stored = move(body);
        stored.identifier = index;
        stored.recompute_mass();
        self.bodies.push_back(move(stored));
        return index;
    }

    fn add_distance_joint(ref self, joint: DistanceJoint) -> int {
        let index = self.distance_joints.size();
        self.distance_joints.push_back(move(joint));
        return index;
    }

    fn add_revolute_joint(ref self, joint: RevoluteJoint) -> int {
        let index = self.revolute_joints.size();
        self.revolute_joints.push_back(move(joint));
        return index;
    }

    fn body_count(self) -> int {
        return self.bodies.size();
    }

    fn joint_count(self) -> int {
        return self.distance_joints.size() + self.revolute_joints.size();
    }

    // --- Broad and narrow phase -------------------------------------------

    fn run_broad_phase(ref self, dt: Fixed) {
        self.grid.rebuild(self.bodies, self.proxy_margin, dt);
        self.candidate_pairs.clear();
        self.grid.collect_pairs(self.bodies, self.candidate_pairs);
        sort_pairs(self.candidate_pairs);
        deduplicate_pairs(self.candidate_pairs);
        self.statistics.broad_phase_pairs = self.candidate_pairs.size();
    }

    // Build this step's manifolds, carrying the accumulated impulses across
    // from last step's manifolds where the contacts match.
    fn run_narrow_phase(ref self) {
        swap(self.manifolds, self.previous_manifolds);
        self.manifolds.clear();
        var index: int = 0;
        while (index < self.candidate_pairs.size()) {
            let ref pair: auto = self.candidate_pairs[index];
            let ref body_a: auto = self.bodies[pair.low];
            let ref body_b: auto = self.bodies[pair.high];
            var manifold = make_manifold(pair.low, pair.high);
            collide(manifold, body_a, body_b);
            if (manifold.is_touching()) {
                // Find last step's manifold for the same pair and warm start
                // from it. A linear scan is fine because the previous list is
                // sorted the same way this one is being built.
                var previous_index: int = 0;
                while (previous_index < self.previous_manifolds.size()) {
                    let ref old: auto = self.previous_manifolds[previous_index];
                    if (old.body_a == manifold.body_a and old.body_b == manifold.body_b) {
                        manifold.warm_start_from(old);
                        previous_index = self.previous_manifolds.size();
                    } else {
                        previous_index += 1;
                    }
                }
                self.statistics.contact_point_count += manifold.points.size();
                self.manifolds.push_back(move(manifold));
            } else {
                Discard(manifold);
            }
            index += 1;
        }
        self.statistics.manifold_count = self.manifolds.size();
    }

    // --- Integration ------------------------------------------------------

    fn integrate_velocities(ref self, dt: Fixed) {
        var index: int = 0;
        while (index < self.bodies.size()) {
            let ref body: auto = self.bodies[index];
            if (body.awake) {
                body.integrate_velocity(self.gravity, dt);
            }
            index += 1;
        }
    }

    fn integrate_positions(ref self, dt: Fixed) {
        var index: int = 0;
        while (index < self.bodies.size()) {
            let ref body: auto = self.bodies[index];
            if (body.awake) {
                body.integrate_position(dt);
            }
            index += 1;
        }
    }

    fn clear_forces(ref self) {
        var index: int = 0;
        while (index < self.bodies.size()) {
            self.bodies[index].clear_forces();
            index += 1;
        }
    }

    fn update_sleeping(ref self, dt: Fixed) {
        var awake_count: int = 0;
        var index: int = 0;
        while (index < self.bodies.size()) {
            let ref body: auto = self.bodies[index];
            body.update_sleep(dt, self.sleep_linear, self.sleep_angular, self.time_to_sleep);
            if (body.awake) {
                awake_count += 1;
            }
            index += 1;
        }
        self.statistics.awake_body_count = awake_count;
    }

    // --- Joints -----------------------------------------------------------

    fn prepare_joints(ref self, dt: Fixed) {
        var index: int = 0;
        while (index < self.distance_joints.size()) {
            self.distance_joints[index].prepare(self.bodies, dt);
            self.distance_joints[index].warm_start(self.bodies);
            index += 1;
        }
        index = 0;
        while (index < self.revolute_joints.size()) {
            self.revolute_joints[index].prepare(self.bodies, dt);
            self.revolute_joints[index].warm_start(self.bodies);
            index += 1;
        }
    }

    fn solve_joint_velocities(ref self, dt: Fixed) {
        var index: int = 0;
        while (index < self.distance_joints.size()) {
            self.distance_joints[index].solve_velocity(self.bodies);
            index += 1;
        }
        index = 0;
        while (index < self.revolute_joints.size()) {
            self.revolute_joints[index].solve_velocity(self.bodies, dt);
            index += 1;
        }
    }

    fn solve_joint_positions(ref self) -> bool {
        var settled: bool = true;
        var index: int = 0;
        while (index < self.distance_joints.size()) {
            if (not self.distance_joints[index].solve_position(self.bodies)) {
                settled = false;
            }
            index += 1;
        }
        index = 0;
        while (index < self.revolute_joints.size()) {
            if (not self.revolute_joints[index].solve_position(self.bodies)) {
                settled = false;
            }
            index += 1;
        }
        return settled;
    }

    // --- One substep ------------------------------------------------------
    //
    // The order matters. Forces are integrated into velocities first so that
    // the contact solver sees the velocity a body will actually have, then
    // the constraints are solved, then the positions are integrated with the
    // corrected velocities, and only then is the remaining penetration
    // pushed out.
    fn substep(ref self, dt: Fixed) {
        self.integrate_velocities(dt);
        self.solver.prepare(self.bodies, self.manifolds, dt);
        self.solver.warm_start(self.bodies, self.manifolds);
        self.prepare_joints(dt);

        var iteration: int = 0;
        while (iteration < self.velocity_iterations) {
            self.solve_joint_velocities(dt);
            self.solver.solve_velocity_once(self.bodies, self.manifolds);
            iteration += 1;
        }
        self.statistics.solver_iterations += self.velocity_iterations;

        self.integrate_positions(dt);

        var pass: int = 0;
        var settled: bool = false;
        while (pass < self.position_iterations and not settled) {
            let deepest = self.solver.solve_position_once(self.bodies, self.manifolds);
            let joints_settled = self.solve_joint_positions();
            if (deepest >= -raw_fixed(PENETRATION_SLOP_RAW) * 3 and joints_settled) {
                settled = true;
            }
            pass += 1;
        }
        self.statistics.position_passes_used += pass;
    }

    // --- One full step ----------------------------------------------------

    fn step(ref self) {
        self.statistics.reset();
        let substep_dt = self.timestep / self.substeps;

        self.run_broad_phase(self.timestep);
        self.run_narrow_phase();

        var index: int = 0;
        while (index < self.substeps) {
            self.substep(substep_dt);
            index += 1;
        }

        self.particles.step(self.gravity, self.timestep, self.bounds);
        self.particles.resolve_body_overlap(self.bodies);

        self.clear_forces();
        self.update_sleeping(self.timestep);
        self.enforce_bounds();
        self.step_index += 1;
    }

    // --- The fixed timestep loop ------------------------------------------
    //
    // Accumulate real elapsed time and consume it in whole steps. Whatever is
    // left over stays in the accumulator for next time, so the simulation
    // clock never drifts from the wall clock by more than one step.
    //
    // Returns how many steps were actually run.
    fn update(ref self, elapsed: Fixed) -> int {
        self.accumulator = self.accumulator + elapsed;
        var steps: int = 0;
        while (self.accumulator >= self.timestep and steps < MAX_STEPS_PER_UPDATE) {
            self.step();
            self.accumulator = self.accumulator - self.timestep;
            steps += 1;
        }
        // If the cap was hit the accumulator is dropped rather than carried,
        // which is the deliberate choice to run slow instead of spiralling.
        if (self.accumulator >= self.timestep * MAX_STEPS_PER_UPDATE) {
            self.accumulator = zero_fixed();
        }
        return steps;
    }

    // The fraction of a step left in the accumulator, which a renderer uses
    // to interpolate between the last two simulated positions.
    fn interpolation_alpha(self) -> Fixed {
        if (self.timestep.raw == 0) {
            return zero_fixed();
        }
        return (self.accumulator / self.timestep).clamped(zero_fixed(), one_fixed());
    }

    // --- World bounds -----------------------------------------------------

    // Anything that leaves the world box is put to sleep where it stands
    // rather than deleted, so that indices stay stable.
    fn enforce_bounds(ref self) {
        var index: int = 0;
        while (index < self.bodies.size()) {
            let ref body: auto = self.bodies[index];
            if (not self.bounds.contains_point(body.frame.position)) {
                body.velocity = vec2_zero();
                body.angular_velocity = zero_fixed();
                body.awake = false;
                body.frame.position = self.bounds.closest_point(body.frame.position);
                body.frame.refresh();
            }
            index += 1;
        }
    }

    // --- Queries ----------------------------------------------------------

    // Every body containing a world point. The broad phase narrows the search
    // to a handful of candidates before the exact test runs.
    fn query_point(self, p: Vec2, ref out: vector(int)) {
        var candidates: vector(int);
        self.grid.query_point(p, candidates);
        var index: int = 0;
        while (index < candidates.size()) {
            let ref body: auto = self.bodies[candidates[index]];
            if (body.shape.contains_point(body.frame, p)) {
                out.push_back(candidates[index]);
            }
            index += 1;
        }
    }

    fn query_region(self, region: AABB, ref out: vector(int)) {
        var candidates: vector(int);
        self.grid.query_box(region, candidates);
        var index: int = 0;
        while (index < candidates.size()) {
            if (self.bodies[candidates[index]].bounds().overlaps(region)) {
                out.push_back(candidates[index]);
            }
            index += 1;
        }
    }

    // Apply an outward impulse to everything within radius of a point, falling
    // off linearly with distance. The classic explosion.
    fn apply_radial_impulse(ref self, centre: Vec2,
                            radius: Fixed, strength: Fixed) {
        var candidates: vector(int);
        self.grid.query_circle(centre, radius, candidates);
        var index: int = 0;
        while (index < candidates.size()) {
            let ref body: auto = self.bodies[candidates[index]];
            let offset = body.world_centre() - centre;
            let distance = offset.length();
            if (distance < radius and distance.raw > LINEAR_EPSILON_RAW) {
                let falloff = one_fixed() - distance / radius;
                let direction = offset / distance;
                body.wake();
                body.apply_impulse_at(direction * strength * falloff, body.world_centre());
            }
            index += 1;
        }
    }

    // --- Energy audit -----------------------------------------------------

    fn total_kinetic_energy(self) -> Fixed {
        var total = zero_fixed();
        var index: int = 0;
        while (index < self.bodies.size()) {
            total = total + self.bodies[index].kinetic_energy();
            index += 1;
        }
        return total;
    }

    fn total_potential_energy(self) -> Fixed {
        var total = zero_fixed();
        var index: int = 0;
        while (index < self.bodies.size()) {
            total = total + self.bodies[index].potential_energy(self.gravity, self.bounds.lower.y);
            index += 1;
        }
        return total;
    }

    fn total_energy(self) -> Fixed {
        return self.total_kinetic_energy() + self.total_potential_energy()
            + self.particles.kinetic_energy(self.timestep) + self.particles.spring_energy();
    }

    fn total_linear_momentum(self) -> Vec2 {
        var total = vec2_zero();
        var index: int = 0;
        while (index < self.bodies.size()) {
            total = total + self.bodies[index].linear_momentum();
            index += 1;
        }
        return total;
    }

    fn total_angular_momentum(self) -> Fixed {
        var total = zero_fixed();
        let origin = vec2_zero();
        var index: int = 0;
        while (index < self.bodies.size()) {
            total = total + self.bodies[index].angular_momentum_about(origin);
            index += 1;
        }
        return total;
    }

    fn total_mass(self) -> Fixed {
        var total = zero_fixed();
        var index: int = 0;
        while (index < self.bodies.size()) {
            total = total + self.bodies[index].mass;
            index += 1;
        }
        return total;
    }

    fn centre_of_mass(self) -> Vec2 {
        let mass = self.total_mass();
        if (mass.raw == 0) {
            return vec2_zero();
        }
        var weighted = vec2_zero();
        var index: int = 0;
        while (index < self.bodies.size()) {
            weighted = weighted + self.bodies[index].world_centre() * self.bodies[index].mass;
            index += 1;
        }
        return weighted / mass;
    }

    var bodies: vector(RigidBody);
    var distance_joints: vector(DistanceJoint);
    var revolute_joints: vector(RevoluteJoint);
    var manifolds: vector(Manifold);
    var previous_manifolds: vector(Manifold);
    var candidate_pairs: vector(BodyPair);
    var grid: SpatialHash;
    var solver: ContactSolver;
    var particles: ParticleSystem;
    var statistics: StepStatistics;

    var gravity: Vec2;
    var bounds: AABB;
    var timestep: Fixed;
    var accumulator: Fixed;
    var proxy_margin: Fixed;
    var sleep_linear: Fixed;
    var sleep_angular: Fixed;
    var time_to_sleep: Fixed;
    var substeps: int = 4;
    var velocity_iterations: int = 8;
    var position_iterations: int = 3;
    var step_index: int = 0;
}

fn make_world() -> World {
    var result: World;
    result.configure();
    return result;
}

// --- Scene builder --------------------------------------------------------
//
// Convenience constructors on top of add_body. Every one of them returns the
// body index, because that is what a joint needs and what the checks below
// use to reach back into the world.

fn make_body(kind: BodyKind, shape: Shape, material: Material,
             position: Vec2, angle: Fixed) -> RigidBody {
    var body: RigidBody;
    body.kind = kind;
    body.shape = move(shape);
    body.material = material + make_material(zero_fixed(), zero_fixed(), zero_fixed(), zero_fixed());
    body.frame = make_transform(position, angle);
    body.gravity_scale = one_fixed();
    body.linear_damping = ratio(1, 100);
    body.angular_damping = ratio(5, 100);
    body.max_linear_speed = whole(200);
    body.max_angular_speed = whole(60);
    body.recompute_mass();
    return body;
}

// Materials add componentwise, which is only used by make_body above to force
// a copy of the material without naming every field.
impl Material as Core.AddWith(Material) where .Result = Material {
  fn Op(self, other: Material) -> Material {
      return make_material(self.density + other.density,
                           self.restitution + other.restitution,
                           self.static_friction + other.static_friction,
                           self.dynamic_friction + other.dynamic_friction);
  }
}

fn spawn_circle(ref world: World, position: Vec2,
                radius: Fixed, material: Material) -> int {
    let shape = shape_from_circle(make_circle(vec2_zero(), radius));
    return world.add_body(make_body(BodyKind.Dynamic, shape, material, position, zero_fixed()));
}

fn spawn_box(ref world: World, position: Vec2,
             half_width: Fixed, half_height: Fixed,
             angle: Fixed, material: Material) -> int {
    let shape = shape_box(half_width, half_height);
    return world.add_body(make_body(BodyKind.Dynamic, shape, material, position, angle));
}

fn spawn_polygon(ref world: World, position: Vec2, sides: int,
                 circumradius: Fixed, material: Material) -> int {
    let shape = shape_from_polygon(make_regular_polygon(sides, circumradius));
    return world.add_body(make_body(BodyKind.Dynamic, shape, material, position, zero_fixed()));
}

fn spawn_static_box(ref world: World, position: Vec2,
                    half_width: Fixed, half_height: Fixed,
                    angle: Fixed) -> int {
    let shape = shape_box(half_width, half_height);
    let index = world.add_body(make_body(BodyKind.Static, shape, material_steel(), position, angle));
    let ref body: auto = world.bodies[index];
    body.never_sleeps = true;
    body.freeze();
    return index;
}

// A ground plane, a left wall and a right wall, sized to the world bounds.
fn build_container(ref world: World, thickness: Fixed) {
    let extent = world.bounds.half_extents();
    let centre = world.bounds.centre();
    Discard(spawn_static_box(world,
                             make_vec2(centre.x, world.bounds.lower.y + thickness),
                             extent.x, thickness, zero_fixed()));
    Discard(spawn_static_box(world,
                             make_vec2(world.bounds.lower.x + thickness, centre.y),
                             thickness, extent.y, zero_fixed()));
    Discard(spawn_static_box(world,
                             make_vec2(world.bounds.upper.x - thickness, centre.y),
                             thickness, extent.y, zero_fixed()));
}

// A pyramid of boxes, rows tall, resting on the ground. The classic stability
// test: if warm starting is broken this sinks, and if the position solver is
// too aggressive it explodes.
fn build_pyramid(ref world: World, apex: Vec2, rows: int,
                 half_size: Fixed) {
    let spacing = half_size * 2 + raw_fixed(PENETRATION_SLOP_RAW);
    var row: int = 0;
    while (row < rows) {
        var column: int = 0;
        while (column <= row) {
            let position = make_vec2(
                apex.x + spacing * column - spacing * row / 2,
                apex.y - spacing * row);
            Discard(spawn_box(world, position, half_size, half_size, zero_fixed(), material_wood()));
            column += 1;
        }
        row += 1;
    }
}

// A chain of boxes linked by revolute joints, hanging from a static anchor.
fn build_chain(ref world: World, anchor: Vec2, links: int,
               half_length: Fixed) {
    let anchor_index = spawn_static_box(world, anchor, half_length / 4, half_length / 4, zero_fixed());
    var previous = anchor_index;
    var index: int = 1;
    while (index <= links) {
        let position = make_vec2(anchor.x + half_length * 2 * index, anchor.y);
        let current = spawn_box(world, position, half_length, half_length / 4,
                                zero_fixed(), material_wood());
        Discard(world.add_revolute_joint(make_revolute_joint(
            previous, current,
            make_vec2(half_length, zero_fixed()),
            make_vec2(-half_length, zero_fixed()))));
        previous = current;
        index += 1;
    }
}

// A wheel on a motorised revolute joint, which is the smallest interesting
// test of the motor path.
fn build_motorised_wheel(ref world: World, centre: Vec2,
                         radius: Fixed, speed: Fixed) -> int {
    let hub = spawn_static_box(world, centre, radius / 8, radius / 8, zero_fixed());
    let wheel = spawn_circle(world, centre, radius, material_rubber());
    Discard(world.add_revolute_joint(make_motorised_joint(
        hub, wheel, vec2_zero(), vec2_zero(), speed, whole(500))));
    return wheel;
}

// A ragdoll-ish articulated figure: a torso with four limbs, each limb a box
// on a limited revolute joint.
fn build_articulated_figure(ref world: World, origin: Vec2,
                            scale: Fixed) -> int {
    let torso = spawn_box(world, origin, scale, scale * 2, zero_fixed(), material_wood());
    var limb: int = 0;
    while (limb < 4) {
        let side = limb % 2;
        let level = limb / 2;
        var offset_x = -scale;
        if (side == 1) {
            offset_x = scale;
        }
        let offset_y = scale - scale * 2 * level;
        let position = make_vec2(origin.x + offset_x * 2, origin.y + offset_y);
        let arm = spawn_box(world, position, scale, scale / 2, zero_fixed(), material_wood());
        var joint = make_revolute_joint(torso, arm,
                                        make_vec2(raw_fixed(offset_x.raw), raw_fixed(offset_y.raw)),
                                        make_vec2(-offset_x, zero_fixed()));
        joint.limit_enabled = true;
        joint.lower_limit = -raw_fixed(FIXED_QUARTER_PI_RAW);
        joint.upper_limit = raw_fixed(FIXED_QUARTER_PI_RAW);
        Discard(world.add_revolute_joint(move(joint)));
        limb += 1;
    }
    return torso;
}

// A Newton's cradle: five equal balls hung from five distance joints, just
// touching. Momentum should pass straight through the middle three.
fn build_newtons_cradle(ref world: World, anchor: Vec2,
                        count: int, radius: Fixed,
                        cord_length: Fixed) {
    var index: int = 0;
    while (index < count) {
        let offset_x = radius * 2 * index - radius * count;
        let pivot = make_vec2(anchor.x + offset_x, anchor.y);
        let hub = spawn_static_box(world, pivot, radius / 8, radius / 8, zero_fixed());
        let ball = spawn_circle(world, make_vec2(pivot.x, pivot.y - cord_length),
                                radius, material_steel());
        let ref body: auto = world.bodies[ball];
        body.material.restitution = one_fixed();
        body.linear_damping = zero_fixed();
        body.angular_damping = zero_fixed();
        body.never_sleeps = true;
        Discard(world.add_distance_joint(make_distance_joint(hub, ball, vec2_zero(),
                                                             vec2_zero(), cord_length)));
        index += 1;
    }
}

// The full demo scene: a container, a pyramid, a chain, a wheel, a cradle,
// a hanging cloth and a rope.
fn build_demo_scene() -> World {
    var world = make_world();
    world.bounds = make_aabb(vec2_from_ints(-100, -10), vec2_from_ints(100, 120));
    world.grid.configure(whole(4), DEFAULT_BUCKET_COUNT);

    build_container(world, whole(2));
    build_pyramid(world, make_vec2(zero_fixed(), whole(40)), 8, one_fixed());
    build_chain(world, vec2_from_ints(-60, 100), 10, whole(2));
    Discard(build_motorised_wheel(world, vec2_from_ints(50, 30), whole(6), whole(3)));
    build_newtons_cradle(world, vec2_from_ints(0, 110), 5, one_fixed(), whole(20));
    Discard(build_articulated_figure(world, vec2_from_ints(20, 60), one_fixed()));

    build_cloth(world.particles, vec2_from_ints(-40, 110), 12, 10, one_fixed(), ratio(8, 10));
    Discard(build_rope(world.particles, vec2_from_ints(70, 110), 20, one_fixed(), ratio(9, 10)));

    return world;
}

// A minimal two-body scene, which is what the checks below actually run
// because a two-body result is one a reader can verify by hand.
fn build_pair_scene() -> World {
    var world = make_world();
    world.bounds = make_aabb(vec2_from_ints(-50, -5), vec2_from_ints(50, 50));
    Discard(spawn_static_box(world, vec2_from_ints(0, 0), whole(40), one_fixed(), zero_fixed()));
    Discard(spawn_circle(world, vec2_from_ints(0, 20), one_fixed(), material_rubber()));
    Discard(spawn_box(world, vec2_from_ints(10, 20), one_fixed(), one_fixed(),
                      zero_fixed(), material_wood()));
    return world;
}

// --- Invariant checks -----------------------------------------------------
//
// These are the properties the engine is supposed to have. They are written
// as `assert` where the claim is a runtime one about a particular scene, and
// as `prove` where the claim is meant to hold for every input the verifier
// can reach.
//
// A fixed-point solver is not exactly energy conserving. The three sources of
// loss and gain are:
//
//   * rounding in the multiply and divide, which is unbiased and so shows up
//     as noise rather than drift;
//   * restitution below one, which removes energy deliberately;
//   * position correction, which moves bodies without doing work and so can
//     add energy if it is too aggressive.
//
// So the checks are one-sided: energy may fall freely, but it must never rise
// by more than the tolerance below.

// Allowed energy gain per step, as a fraction of the starting energy:
// 0.02 * 65536 = 1310.
let ENERGY_TOLERANCE_RAW: int = 1310;

// Allowed momentum drift per step in absolute units.
let MOMENTUM_TOLERANCE_RAW: int = 655;

// --- Scalar invariants ----------------------------------------------------

// The properties the fixed-point scalar itself has to have for anything above
// to be trustworthy.
fn check_fixed_invariants() {
    let one = one_fixed();
    let two = whole(2);
    let half = half_fixed();

    // The scale constant is what every conversion is built on.
    Assert(FIXED_ONE == 65536);
    Assert(FIXED_HALF * 2 == FIXED_ONE);
    Assert(FIXED_FRACTION_MASK + 1 == FIXED_ONE);
    Prove(one.raw == FIXED_ONE);

    // Multiplication by one is the identity, and by two is a shift.
    Prove((one * one).raw == FIXED_ONE);
    Prove((two * half).raw == FIXED_ONE);
    Assert(one * two == two);

    // Negation is exact, so it is its own inverse with no rounding drift.
    Prove((-(-one)).raw == one.raw);
    Assert((-one) + one == zero_fixed());

    // Ordering agrees with the underlying integers.
    Prove(half < one);
    Prove(one <= one);
    Prove(two > one);
    Prove(one != two);

    // The reciprocal is accurate to within a couple of units in the last
    // place, which is all sixteen fractional bits can promise.
    let inverse_two = two.reciprocal();
    Assert((inverse_two - half).magnitude() <= raw_fixed(4));
    Assert((two * inverse_two - one).magnitude() <= raw_fixed(8));

    // The square root of a perfect square is exact up to the same tolerance.
    let four = whole(4);
    Assert((four.square_root() - two).magnitude() <= raw_fixed(4));
    Assert((whole(9).square_root() - whole(3)).magnitude() <= raw_fixed(4));
    Prove(whole(0).square_root().raw == 0);

    // Rounding never moves a value by as much as one whole unit.
    let awkward = ratio(1, 3);
    Assert((awkward * whole(3) - one).magnitude() < one);
    Assert(awkward.floor_int() == 0);
    Assert((-awkward).floor_int() == -1);
    Assert((-awkward).ceil_int() == 0);
}

// The trigonometric approximations have to satisfy the Pythagorean identity
// well enough that a rotation matrix stays close to orthonormal.
fn check_trigonometry() {
    let one = one_fixed();
    // 0.01 * 65536 = 655, the accuracy the Bhaskara form promises.
    let tolerance = raw_fixed(655);

    Prove(fixed_sin(zero_fixed()).magnitude() <= tolerance);
    Assert((fixed_cos(zero_fixed()) - one).magnitude() <= tolerance);
    Assert((fixed_sin(raw_fixed(FIXED_HALF_PI_RAW)) - one).magnitude() <= tolerance);
    Assert(fixed_cos(raw_fixed(FIXED_HALF_PI_RAW)).magnitude() <= tolerance);

    var step: int = 0;
    while (step < 16) {
        let angle = tau_fixed() * step / 16;
        let s = fixed_sin(angle);
        let c = fixed_cos(angle);
        // sin^2 + cos^2 == 1, to within the approximation's own error.
        Assert((s * s + c * c - one).magnitude() <= tolerance * 4);
        // A rotation matrix built from that pair has unit determinant.
        let rotation = mat2_rotation(angle);
        Assert((rotation.determinant() - one).magnitude() <= tolerance * 4);
        // Rotating a unit vector preserves its length.
        let rotated = rotation * vec2_unit_x();
        Assert((rotated.length() - one).magnitude() <= tolerance * 4);
        step += 1;
    }
}

// --- Vector and matrix invariants -----------------------------------------

fn check_vector_algebra() {
    let a = vec2_from_ints(3, 4);
    let b = vec2_from_ints(-2, 5);
    let tolerance = raw_fixed(655);

    // The 3-4-5 triangle, which the square root should get exactly right.
    Assert((a.length() - whole(5)).magnitude() <= tolerance);
    Prove(a.length_squared().raw == whole(25).raw);

    // Commutativity of the dot product and anticommutativity of the cross.
    Prove(a.dot(b).raw == b.dot(a).raw);
    Prove(a.cross(b).raw == -b.cross(a).raw);
    Assert(a.cross(a) == zero_fixed());

    // The perpendicular really is perpendicular.
    Prove(a.dot(a.perpendicular()).raw == 0);
    Assert(a.perpendicular().perpendicular() == -a);

    // Addition is commutative and negation is its inverse.
    Assert(a + b == b + a);
    Assert(a + (-a) == vec2_zero());
    Assert((a - b) + b == a);

    // Scaling distributes over addition.
    let s = whole(3);
    Assert((a + b) * s == a * s + b * s);

    // A normalised vector has unit length, and normalising twice changes
    // nothing beyond the rounding of the first pass.
    let unit = a.normalised();
    Assert((unit.length() - one_fixed()).magnitude() <= tolerance);
    Assert((unit.normalised() - unit).manhattan_length() <= tolerance);

    // The componentwise operator agrees with doing it by hand.
    let product = a % b;
    Prove(product.x.raw == (a.x * b.x).raw);
    Prove(product.y.raw == (a.y * b.y).raw);
}

fn check_matrix_algebra() {
    let tolerance = raw_fixed(655);
    let identity = mat2_identity();
    let rotation = mat2_rotation(raw_fixed(FIXED_QUARTER_PI_RAW));
    let v = vec2_from_ints(2, -7);

    Prove(identity.is_identity());
    Assert(identity * v == v);
    Assert(identity * identity == identity);

    // Transposing a rotation inverts it.
    let round_trip = rotation.transposed() * (rotation * v);
    Assert((round_trip - v).manhattan_length() <= tolerance * 4);

    // The inverse really is the inverse.
    let inverse = rotation.inverted();
    let recovered = inverse * (rotation * v);
    Assert((recovered - v).manhattan_length() <= tolerance * 8);

    // Cramer's rule agrees with multiplying by the inverse.
    let solved = rotation.solve(v);
    let by_inverse = inverse * v;
    Assert((solved - by_inverse).manhattan_length() <= tolerance * 8);

    // Matrix addition is componentwise and negation is its inverse.
    Assert(rotation + (-rotation) == mat2_zero());
    Assert((rotation - rotation) == mat2_zero());

    // Composition is associative on rotations, which is what keeps a chain of
    // frames from drifting depending on how it is bracketed.
    let other = mat2_rotation(raw_fixed(FIXED_HALF_PI_RAW));
    let left = (rotation * other) * rotation;
    let right = rotation * (other * rotation);
    Assert((left.col_x - right.col_x).manhattan_length() <= tolerance * 8);
    Assert((left.col_y - right.col_y).manhattan_length() <= tolerance * 8);
}

// --- Geometry invariants --------------------------------------------------

fn check_shape_properties() {
    let tolerance = raw_fixed(6553);
    let box_shape = make_box_polygon(whole(2), whole(3));

    // A 4 by 6 box has area 24 and a centroid at its own origin.
    Assert((box_shape.area() - whole(24)).magnitude() <= tolerance);
    Assert(box_shape.centroid().manhattan_length() <= tolerance);
    Prove(box_shape.is_convex());
    Prove(box_shape.vertices.size() == 4);
    Prove(box_shape.normals.size() == 4);

    // Every normal is a unit vector pointing away from the centre.
    var index: int = 0;
    while (index < box_shape.normals.size()) {
        let normal = box_shape.normals[index];
        Assert((normal.length() - one_fixed()).magnitude() <= raw_fixed(655));
        let midpoint = (box_shape.vertex(index) + box_shape.vertex(index + 1)) / 2;
        Assert(normal.dot(midpoint) > zero_fixed());
        index += 1;
    }

    // A regular polygon of many sides approaches its circumscribed circle.
    let ngon = make_regular_polygon(12, whole(5));
    Prove(ngon.is_convex());
    Assert(ngon.area() < pi_fixed() * whole(25));
    Assert(ngon.area() > pi_fixed() * whole(20));

    // A circle's inertia about its own centre is m r^2 / 2.
    let disc = make_circle(vec2_zero(), whole(2));
    let disc_inertia = disc.inertia_for_mass(whole(10));
    Assert((disc_inertia - whole(20)).magnitude() <= whole(1));
}

fn check_bounds_algebra() {
    let a = make_aabb(vec2_from_ints(0, 0), vec2_from_ints(10, 10));
    let b = make_aabb(vec2_from_ints(5, 5), vec2_from_ints(15, 15));
    let far = make_aabb(vec2_from_ints(100, 100), vec2_from_ints(110, 110));

    Prove(a.overlaps(b));
    Prove(b.overlaps(a));
    Prove(not a.overlaps(far));
    Prove(a.contains_point(vec2_from_ints(5, 5)));
    Prove(not a.contains_point(vec2_from_ints(11, 5)));

    // The union contains both operands and the intersection is contained by
    // both, which is the pair of properties the broad phase relies on.
    let merged = a + b;
    Prove(merged.contains_box(a));
    Prove(merged.contains_box(b));
    let overlap = a * b;
    Prove(a.contains_box(overlap));
    Prove(b.contains_box(overlap));

    // Expanding then translating commutes with translating then expanding.
    let offset = vec2_from_ints(3, -4);
    Assert(a.expanded(one_fixed()).translated(offset) == a.translated(offset).expanded(one_fixed()));

    // Area is monotone under expansion.
    Assert(a.expanded(one_fixed()).area() > a.area());
}

// --- Broad-phase invariants -----------------------------------------------

// Every pair the grid reports must have overlapping proxies, and every pair
// with overlapping proxies that share a cell must be reported. The second
// half is checked here by brute force against the same body list.
fn check_broad_phase(ref world: World) {
    world.run_broad_phase(world.timestep);

    var index: int = 0;
    while (index < world.candidate_pairs.size()) {
        let ref pair: auto = world.candidate_pairs[index];
        Assert(pair.low < pair.high);
        Assert(pair.low >= 0);
        Assert(pair.high < world.bodies.size());
        // Reported pairs really do overlap in the fattened proxies.
        let box_a = world.bodies[pair.low].proxy_bounds(world.proxy_margin, world.timestep);
        let box_b = world.bodies[pair.high].proxy_bounds(world.proxy_margin, world.timestep);
        Assert(box_a.overlaps(box_b));
        // And the pair list has no duplicates, because it was sorted and
        // swept before it got here.
        if (index > 0) {
            Assert(world.candidate_pairs[index - 1] < pair);
        }
        index += 1;
    }

    // Brute force the other direction: anything that actually touches and is
    // allowed to collide must be somewhere in the list.
    var first: int = 0;
    var missed: int = 0;
    while (first < world.bodies.size()) {
        var second = first + 1;
        while (second < world.bodies.size()) {
            let ref a: auto = world.bodies[first];
            let ref b: auto = world.bodies[second];
            if (should_collide(a, b) and a.bounds().overlaps(b.bounds())) {
                let wanted = make_pair(first, second);
                var found: bool = false;
                var scan: int = 0;
                while (scan < world.candidate_pairs.size()) {
                    if (world.candidate_pairs[scan] == wanted) {
                        found = true;
                    }
                    scan += 1;
                }
                if (not found) {
                    missed += 1;
                }
            }
            second += 1;
        }
        first += 1;
    }
    Assert(missed == 0);
}

// --- Narrow-phase invariants ----------------------------------------------

fn check_manifold_shape(manifold: Manifold) {
    // The normal is a unit vector.
    Assert((manifold.normal.length() - one_fixed()).magnitude() <= raw_fixed(655));
    // At most two points, each penetrating rather than separated.
    Assert(manifold.points.size() <= MAX_MANIFOLD_POINTS);
    var index: int = 0;
    while (index < manifold.points.size()) {
        let ref point: auto = manifold.points[index];
        Assert(point.separation <= raw_fixed(PENETRATION_SLOP_RAW));
        // Accumulated normal impulse is never negative: contacts push, they
        // never pull.
        Prove(point.normal_impulse >= zero_fixed());
        // Friction stays inside the Coulomb cone.
        Assert(point.tangent_impulse.magnitude()
            <= manifold.friction * point.normal_impulse + raw_fixed(655));
        index += 1;
    }
}

// Two circles of radius one whose centres are one apart overlap by exactly
// one unit, along the axis joining them.
fn check_circle_circle() {
    let tolerance = raw_fixed(655);
    var manifold = make_manifold(0, 1);
    let circle = make_circle(vec2_zero(), one_fixed());
    let frame_a = make_transform(vec2_from_ints(0, 0), zero_fixed());
    let frame_b = make_transform(vec2_from_ints(1, 0), zero_fixed());
    collide_circle_circle(manifold, circle, frame_a, circle, frame_b);

    Assert(manifold.state == ContactState.Penetrating);
    Assert(manifold.points.size() == 1);
    Assert((manifold.normal.x - one_fixed()).magnitude() <= tolerance);
    Assert(manifold.normal.y.magnitude() <= tolerance);
    Assert((manifold.points[0].separation + one_fixed()).magnitude() <= tolerance);
    check_manifold_shape(manifold);

    // Move them apart and there is no contact at all.
    let far_frame = make_transform(vec2_from_ints(10, 0), zero_fixed());
    collide_circle_circle(manifold, circle, frame_a, circle, far_frame);
    Assert(manifold.state == ContactState.Separated);
    Prove(manifold.points.size() == 0);
}

// Two identical axis-aligned boxes overlapping by one unit should produce a
// two-point face manifold with a vertical normal.
fn check_polygon_polygon() {
    let tolerance = raw_fixed(1310);
    var manifold = make_manifold(0, 1);
    let box_shape = make_box_polygon(whole(2), whole(2));
    let lower = make_transform(vec2_from_ints(0, 0), zero_fixed());
    let upper = make_transform(vec2_from_ints(0, 3), zero_fixed());
    collide_polygon_polygon(manifold, box_shape, lower, box_shape, upper);

    Assert(manifold.state == ContactState.Penetrating);
    Assert(manifold.points.size() == 2);
    Assert(manifold.normal.x.magnitude() <= tolerance);
    Assert((manifold.normal.y.magnitude() - one_fixed()).magnitude() <= tolerance);
    check_manifold_shape(manifold);

    // The two points sit on the shared face, so they have equal depth.
    let depth_difference = manifold.points[0].separation - manifold.points[1].separation;
    Assert(depth_difference.magnitude() <= tolerance);

    // Well separated boxes report nothing.
    let distant = make_transform(vec2_from_ints(0, 40), zero_fixed());
    collide_polygon_polygon(manifold, box_shape, lower, box_shape, distant);
    Assert(manifold.state == ContactState.Separated);
}

// A circle resting on the top face of a box touches at one point with the
// normal pointing out of the face.
fn check_circle_polygon() {
    let tolerance = raw_fixed(1310);
    var manifold = make_manifold(0, 1);
    let circle = make_circle(vec2_zero(), one_fixed());
    let box_shape = make_box_polygon(whole(5), whole(1));
    let circle_frame = make_transform(vec2_from_ints(0, 2), zero_fixed());
    let box_frame = make_transform(vec2_from_ints(0, 0), zero_fixed());
    collide_circle_polygon(manifold, circle, circle_frame, box_shape, box_frame, false);

    Assert(manifold.state == ContactState.Penetrating);
    Assert(manifold.points.size() == 1);
    Assert(manifold.normal.x.magnitude() <= tolerance);
    Assert(manifold.normal.y > zero_fixed());
    check_manifold_shape(manifold);
}

// --- Solver invariants ----------------------------------------------------

// After the velocity solver has run, no contact should still be closing
// faster than the tolerance. This is the property the whole sequential
// impulse scheme exists to establish.
fn check_contacts_are_separating(world: World) {
    let tolerance = raw_fixed(1310);
    var index: int = 0;
    while (index < world.manifolds.size()) {
        let ref manifold: auto = world.manifolds[index];
        let ref body_a: auto = world.bodies[manifold.body_a];
        let ref body_b: auto = world.bodies[manifold.body_b];
        var point_index: int = 0;
        while (point_index < manifold.points.size()) {
            let ref point: auto = manifold.points[point_index];
            let velocity_a = body_a.velocity_at(point.position);
            let velocity_b = body_b.velocity_at(point.position);
            // The long form of the relative normal speed, spelled out over
            // the member chains rather than through a helper, because this is
            // exactly the expression the solver drives to zero.
            let closing = manifold.normal.x * (velocity_b.x - velocity_a.x)
                + manifold.normal.y * (velocity_b.y - velocity_a.y);
            Assert(closing >= -tolerance - point.velocity_bias);
            point_index += 1;
        }
        index += 1;
    }
}

// Momentum is conserved by every impulse the solver applies, because every
// impulse is applied equal and opposite to the two bodies. The only thing
// that changes the total is gravity and the static bodies, so the check runs
// on a scene with neither.
fn check_momentum_conservation() {
    let tolerance = raw_fixed(MOMENTUM_TOLERANCE_RAW);
    var world = make_world();
    world.gravity = vec2_zero();
    world.bounds = make_aabb(vec2_from_ints(-200, -200), vec2_from_ints(200, 200));

    let left = spawn_circle(world, vec2_from_ints(-10, 0), one_fixed(), material_steel());
    let right = spawn_circle(world, vec2_from_ints(10, 0), one_fixed(), material_steel());
    world.bodies[left].set_velocity(vec2_from_ints(5, 0));
    world.bodies[right].set_velocity(vec2_from_ints(-5, 0));
    world.bodies[left].never_sleeps = true;
    world.bodies[right].never_sleeps = true;

    let initial_momentum = world.total_linear_momentum();
    let initial_angular = world.total_angular_momentum();

    var step: int = 0;
    while (step < 120) {
        world.step();
        let momentum = world.total_linear_momentum();
        // Linear momentum drifts only by the rounding of the impulses.
        Assert((momentum.x - initial_momentum.x).magnitude() <= tolerance * (step + 1));
        Assert((momentum.y - initial_momentum.y).magnitude() <= tolerance * (step + 1));
        step += 1;
    }

    let final_angular = world.total_angular_momentum();
    Assert((final_angular - initial_angular).magnitude() <= tolerance * 120);
    Destroy(world);
}

// The central energy check. A closed scene with restitution one and no
// damping may lose energy to rounding and to the position solver, but it must
// never gain more than the tolerance.
fn check_energy_conservation() {
    var world = make_world();
    world.bounds = make_aabb(vec2_from_ints(-60, -5), vec2_from_ints(60, 80));
    build_container(world, one_fixed());

    let ball = spawn_circle(world, vec2_from_ints(0, 40), one_fixed(), material_rubber());
    let ref body: auto = world.bodies[ball];
    body.material.restitution = one_fixed();
    body.linear_damping = zero_fixed();
    body.angular_damping = zero_fixed();
    body.never_sleeps = true;

    let initial_energy = world.total_energy();
    var peak_energy = initial_energy + zero_fixed();
    var minimum_energy = initial_energy + zero_fixed();

    var step: int = 0;
    while (step < 240) {
        let before = world.total_energy();
        world.step();
        let after = world.total_energy();

        // The per-step gain bound. ENERGY_TOLERANCE_RAW is a fraction of the
        // energy present, so a scene at rest is held to a tight absolute
        // bound and an energetic one to a proportional bound.
        let allowed = before.magnitude() * raw_fixed(ENERGY_TOLERANCE_RAW) + one_fixed();
        Assert(after <= before + allowed);

        peak_energy = fixed_max(peak_energy, after);
        minimum_energy = fixed_min(minimum_energy, after);
        check_contacts_are_separating(world);
        step += 1;
    }

    // Over the whole run the energy must not have run away, and a perfectly
    // elastic ball must not have come to a complete stop either.
    let cumulative_allowance = initial_energy.magnitude()
        * raw_fixed(ENERGY_TOLERANCE_RAW) * 8 + whole(10);
    Assert(peak_energy <= initial_energy + cumulative_allowance);
    Assert(minimum_energy >= zero_fixed());
    Prove(peak_energy >= minimum_energy);
    Destroy(world);
}

// Damping and a restitution below one must strictly remove energy, which is
// the other half of the same property.
fn check_energy_dissipation() {
    var world = build_pair_scene();
    let initial_energy = world.total_energy();
    var step: int = 0;
    while (step < 300) {
        world.step();
        step += 1;
    }
    let final_energy = world.total_energy();

    // A scene with friction, damping and restitution below one ends with no
    // more energy than it started with, plus the same rounding allowance.
    let allowance = initial_energy.magnitude() * raw_fixed(ENERGY_TOLERANCE_RAW) + whole(1);
    Assert(final_energy <= initial_energy + allowance);

    // And it should have actually settled: everything asleep or nearly still.
    var index: int = 0;
    while (index < world.bodies.size()) {
        let ref body: auto = world.bodies[index];
        if (body.kind == BodyKind.Dynamic) {
            Assert(not body.awake or body.velocity.length_squared() <= one_fixed());
        }
        index += 1;
    }
    Destroy(world);
}

// --- Particle invariants --------------------------------------------------

// A Verlet particle under no forces moves in a straight line at constant
// speed, and a spring at its rest length applies no correction at all.
fn check_particle_integration() {
    let tolerance = raw_fixed(655);
    let dt = raw_fixed(DEFAULT_TIMESTEP_RAW);
    var system = make_particle_system();
    system.damping = one_fixed();

    let index = system.add_particle(vec2_from_ints(0, 0), one_fixed());
    system.particles[index].set_velocity(vec2_from_ints(10, 0), dt);
    let initial_speed = system.particles[index].velocity(dt).length();

    var step: int = 0;
    while (step < 60) {
        system.integrate(vec2_zero(), dt);
        let speed = system.particles[index].velocity(dt).length();
        Assert((speed - initial_speed).magnitude() <= tolerance * 4);
        // No vertical drift without gravity.
        Assert(system.particles[index].position.y.magnitude() <= tolerance);
        step += 1;
    }

    // After a second at ten units per second it has travelled ten units.
    Assert((system.particles[index].position.x - whole(10)).magnitude() <= one_fixed());
    Destroy(system);
}

fn check_spring_relaxation() {
    let tolerance = raw_fixed(6553);
    var system = make_particle_system();
    system.relaxation_passes = 16;

    let anchor = system.add_pinned(vec2_from_ints(0, 0));
    let free = system.add_particle(vec2_from_ints(10, 0), one_fixed());
    let spring = system.connect_at(anchor, free, whole(5), one_fixed());

    // A pinned particle never moves, whatever the spring does.
    let start = system.particles[anchor].position + vec2_zero();
    system.relax_springs();
    Assert(system.particles[anchor].position == start);

    // And the free end has been pulled to the rest length.
    let length = system.springs[spring].current_length(system.particles);
    Assert((length - whole(5)).magnitude() <= tolerance);
    Assert(system.springs[spring].strain(system.particles).magnitude() <= tolerance);
    Prove(not system.springs[spring].broken);
    Destroy(system);
}

// A cloth pinned at two corners must hang without any particle escaping the
// world box or any spring tearing at rest.
fn check_cloth_stability() {
    var system = make_particle_system();
    let bounds = make_aabb(vec2_from_ints(-100, -100), vec2_from_ints(100, 100));
    build_cloth(system, vec2_from_ints(-10, 50), 8, 8, one_fixed(), ratio(9, 10));
    let gravity = make_vec2(zero_fixed(), -raw_fixed(GRAVITY_RAW));
    let dt = raw_fixed(DEFAULT_TIMESTEP_RAW);

    var step: int = 0;
    while (step < 180) {
        system.step(gravity, dt, bounds);
        step += 1;
    }

    Assert(system.broken_spring_count() == 0);
    var index: int = 0;
    while (index < system.particles.size()) {
        let ref particle: auto = system.particles[index];
        Assert(bounds.contains_point(particle.position));
        // No particle has acquired an absurd speed, which is what a diverging
        // relaxation would look like.
        Assert(particle.velocity(dt).length_squared() <= whole(10000));
        index += 1;
    }

    // The pinned corners are exactly where they were put.
    Prove(system.particles[0].pinned);
    Destroy(system);
}

// --- Joint invariants -----------------------------------------------------

// A rigid distance joint holds its rest length to within the position solver's
// tolerance, and a rope only ever pulls.
fn check_distance_joint() {
    let tolerance = raw_fixed(6553);
    var world = make_world();
    world.bounds = make_aabb(vec2_from_ints(-100, -100), vec2_from_ints(100, 100));

    let anchor = spawn_static_box(world, vec2_from_ints(0, 50), one_fixed(), one_fixed(), zero_fixed());
    let bob = spawn_circle(world, vec2_from_ints(10, 50), one_fixed(), material_steel());
    world.bodies[bob].never_sleeps = true;
    let joint = world.add_distance_joint(
        make_distance_joint(anchor, bob, vec2_zero(), vec2_zero(), whole(10)));

    var step: int = 0;
    while (step < 240) {
        world.step();
        let length = (world.bodies[bob].world_centre()
                      - world.bodies[anchor].world_centre()).length();
        Assert((length - whole(10)).magnitude() <= tolerance * 4);
        Assert(world.distance_joints[joint].status != JointStatus.Broken);
        step += 1;
    }

    // A pendulum swinging from a fixed anchor stays on its circle, so the
    // stretch ratio is one to within the same tolerance.
    let ratio_now = world.distance_joints[joint].stretch_ratio();
    Assert((ratio_now - one_fixed()).magnitude() <= tolerance);
    Destroy(world);
}

// A revolute joint holds its two anchor points together.
fn check_revolute_joint() {
    let tolerance = raw_fixed(6553);
    var world = make_world();
    world.bounds = make_aabb(vec2_from_ints(-100, -100), vec2_from_ints(100, 100));
    build_chain(world, vec2_from_ints(0, 60), 6, one_fixed());

    var step: int = 0;
    while (step < 180) {
        world.step();
        step += 1;
    }

    var index: int = 0;
    while (index < world.revolute_joints.size()) {
        let ref joint: auto = world.revolute_joints[index];
        let world_a = world.bodies[joint.body_a].to_world(joint.local_anchor_a);
        let world_b = world.bodies[joint.body_b].to_world(joint.local_anchor_b);
        // The drift between the two anchors is the joint's whole error.
        Assert((world_b - world_a).manhattan_length() <= tolerance * 8);
        index += 1;
    }
    Destroy(world);
}

// --- Determinism ----------------------------------------------------------

// The same scene stepped the same number of times from the same start must
// produce bit-identical results. This is the property fixed point was chosen
// for, so it is checked exactly rather than with a tolerance.
fn check_determinism() {
    var first = build_pair_scene();
    var second = build_pair_scene();

    var step: int = 0;
    while (step < 120) {
        first.step();
        second.step();
        step += 1;
    }

    Assert(first.bodies.size() == second.bodies.size());
    var index: int = 0;
    while (index < first.bodies.size()) {
        let ref a: auto = first.bodies[index];
        let ref b: auto = second.bodies[index];
        // Exact equality on the raw integers, no tolerance at all.
        Prove(a.frame.position.x.raw == b.frame.position.x.raw);
        Prove(a.frame.position.y.raw == b.frame.position.y.raw);
        Prove(a.frame.angle.raw == b.frame.angle.raw);
        Prove(a.velocity.x.raw == b.velocity.x.raw);
        Prove(a.velocity.y.raw == b.velocity.y.raw);
        Prove(a.angular_velocity.raw == b.angular_velocity.raw);
        index += 1;
    }
    Assert(first.step_index == second.step_index);
    Destroy(first);
    Destroy(second);
}

// --- Timestep invariants --------------------------------------------------

// The accumulator loop must consume whole steps only, must never run more
// than the cap, and must leave less than one step behind.
fn check_fixed_timestep() {
    var world = make_world();
    let dt = world.timestep + zero_fixed();

    // Exactly one step's worth of time runs exactly one step.
    let one_step = world.update(dt);
    Assert(one_step == 1);
    Assert(world.accumulator < dt);

    // Half a step runs nothing and is carried.
    let no_steps = world.update(dt / 2);
    Assert(no_steps == 0);
    Assert(world.accumulator >= zero_fixed());
    Assert(world.accumulator < dt);

    // Three and a half steps run three and carry the half.
    let three_steps = world.update(dt * 3);
    Assert(three_steps == 3);
    Prove(world.accumulator < dt);

    // A huge lag is capped rather than spiralling.
    let capped = world.update(dt * 1000);
    Assert(capped <= MAX_STEPS_PER_UPDATE);
    Assert(world.interpolation_alpha() <= one_fixed());
    Assert(world.interpolation_alpha() >= zero_fixed());
    Destroy(world);
}

// --- Entry point ----------------------------------------------------------

// Run the whole check suite in dependency order: the scalar first, because
// everything above it is meaningless if the scalar is wrong, then the
// algebra, then the geometry, then the pipeline.
fn run_all_checks() {
    check_fixed_invariants();
    check_trigonometry();
    check_vector_algebra();
    check_matrix_algebra();
    check_shape_properties();
    check_bounds_algebra();

    check_circle_circle();
    check_circle_polygon();
    check_polygon_polygon();

    var scene = build_demo_scene();
    check_broad_phase(scene);
    Destroy(scene);

    check_momentum_conservation();
    check_energy_conservation();
    check_energy_dissipation();

    check_particle_integration();
    check_spring_relaxation();
    check_cloth_stability();

    check_distance_joint();
    check_revolute_joint();

    check_determinism();
    check_fixed_timestep();

    println("particle_sim: all checks passed");
    println(to_string(fixed_multiply_count));
    println(to_string(narrow_phase_test_count));
    println(to_string(solver_iteration_count));
}

// Step the demo scene for a while and report what the profiler counters saw.
// This is the benchmark's own workload rather than a correctness check.
fn run_demo(step_count: int) -> int {
    var world = build_demo_scene();
    var step: int = 0;
    while (step < step_count) {
        world.step();
        if (step % 60 == 0) {
            // Once a second, poke the scene so that it never fully settles.
            world.apply_radial_impulse(vec2_from_ints(0, 20), whole(15), whole(40));
        }
        step += 1;
    }
    let total = world.statistics.broad_phase_pairs
        + world.statistics.narrow_phase_tests
        + world.statistics.manifold_count;
    Destroy(world);
    return total;
}


// Generic red-black tree providing an ordered map from K to V.
//
// The tree is stored in a flat node arena (`nodes`) and every link is an
// integer index into that arena.  The sentinel index `RB_NIL` (-1) plays the
// role of the traditional NIL leaf, which keeps the structure free of raw
// pointers and makes the whole container trivially relocatable.
//
// Invariants maintained by every mutating operation:
//   1. Every node is either red or black.
//   2. The root is black.
//   3. A red node never has a red child.
//   4. Every path from a node down to a NIL leaf contains the same number of
//      black nodes (the "black height" of that node).
//   5. NIL leaves count as black.
//
// `check_validity` restates those invariants with `assert` and `prove` so the
// verifier can reason about them directly.
namespace red_black_tree;

// --- Colours and helper enums -------------------------------------------

choice Colour {
    Red,
    Black,
}

choice ChildSide {
    LeftChild,
    RightChild,
    NoChild,
}

// Result of a lookup: the slot index plus whether the key was actually there.
choice FindOutcome {
    FoundExact,
    FoundPredecessor,
    FoundSuccessor,
    NotFound,
}

// The sentinel used for "no such node".  Written as a negative literal so the
// arena can never accidentally address it.
let RB_NIL: int = -1;

// A red-black tree of n nodes has height at most 2 * log2(n + 1); this bound
// is only used to size traversal stacks up front.
let RB_MAX_HEIGHT: int = 96;

// Arena capacity used when a tree is created without a size hint.
let RB_INITIAL_CAPACITY: int = 32;

// Growth factor, expressed as a percentage so no floating point is needed.
let RB_GROWTH_PERCENT: int = 200;

// --- Node ----------------------------------------------------------------

class RbNode(K: type, V: type)
{

    fn has_left(self) -> bool {
        return self.left != RB_NIL;
    }

    fn has_right(self) -> bool {
        return self.right != RB_NIL;
    }

    fn is_leaf(self) -> bool {
        return self.left == RB_NIL and self.right == RB_NIL;
    }

    fn child_count(self) -> int {
        var n: int = 0;
        if (self.left != RB_NIL) {
            n += 1;
        }
        if (self.right != RB_NIL) {
            n += 1;
        }
        return n;
    }

    fn reset_links(ref self) {
        self.left = RB_NIL;
        self.right = RB_NIL;
        self.parent = RB_NIL;
    }

    var key: K;
    var value: V;
    var left: int = -1;
    var right: int = -1;
    var parent: int = -1;
    var colour: Colour = Colour.Red;
    var live: bool = true;
}

// --- Tree ----------------------------------------------------------------

class RedBlackTree(K: type, V: type)
{

    // --- Size and shape queries ------------------------------------------

    fn size(self) -> int {
        return self.count;
    }

    fn empty(self) -> bool {
        return self.count == 0;
    }

    fn arena_size(self) -> int {
        return self.nodes.size();
    }

    fn is_nil(self, i: int) -> bool {
        return i == RB_NIL;
    }

    fn alive(self, i: int) -> bool {
        if (i == RB_NIL) {
            return false;
        }
        return self.nodes[i].live;
    }

    // --- Colour helpers ---------------------------------------------------
    //
    // NIL leaves are black by rule 5, so every colour query has to funnel
    // through these helpers rather than touching `.colour` directly.

    fn colour_of(self, i: int) -> Colour {
        if (i == RB_NIL) {
            return Colour.Black;
        }
        return self.nodes[i].colour;
    }

    fn is_red(self, i: int) -> bool {
        if (i == RB_NIL) {
            return false;
        }
        return self.nodes[i].colour == Colour.Red;
    }

    fn is_black(self, i: int) -> bool {
        if (i == RB_NIL) {
            return true;
        }
        return self.nodes[i].colour == Colour.Black;
    }

    fn set_colour(ref self, i: int, c: Colour) {
        if (i != RB_NIL) {
            self.nodes[i].colour = c;
        }
    }

    fn paint_red(ref self, i: int) {
        self.set_colour(i, Colour.Red);
    }

    fn paint_black(ref self, i: int) {
        self.set_colour(i, Colour.Black);
    }

    fn swap_colours(ref self, a: int, b: int) {
        if (a != RB_NIL and b != RB_NIL) {
            swap(self.nodes[a].colour, self.nodes[b].colour);
        }
    }

    // --- Link helpers -----------------------------------------------------

    fn left_of(self, i: int) -> int {
        if (i == RB_NIL) {
            return RB_NIL;
        }
        return self.nodes[i].left;
    }

    fn right_of(self, i: int) -> int {
        if (i == RB_NIL) {
            return RB_NIL;
        }
        return self.nodes[i].right;
    }

    fn parent_of(self, i: int) -> int {
        if (i == RB_NIL) {
            return RB_NIL;
        }
        return self.nodes[i].parent;
    }

    fn grandparent_of(self, i: int) -> int {
        return self.parent_of(self.parent_of(i));
    }

    // Which side of its parent a node hangs off, or NoChild for the root.
    fn side_of(self, i: int) -> ChildSide {
        let p = self.parent_of(i);
        if (p == RB_NIL) {
            return ChildSide.NoChild;
        } else {
            if (self.nodes[p].left == i) {
                return ChildSide.LeftChild;
            } else {
                return ChildSide.RightChild;
            }
        }
    }

    fn sibling_of(self, i: int) -> int {
        let p = self.parent_of(i);
        if (p == RB_NIL) {
            return RB_NIL;
        } else {
            if (self.nodes[p].left == i) {
                return self.nodes[p].right;
            } else {
                return self.nodes[p].left;
            }
        }
    }

    fn uncle_of(self, i: int) -> int {
        return self.sibling_of(self.parent_of(i));
    }

    fn is_left_child(self, i: int) -> bool {
        return self.side_of(i) == ChildSide.LeftChild;
    }

    fn is_right_child(self, i: int) -> bool {
        return self.side_of(i) == ChildSide.RightChild;
    }

    // Re-point whatever used to reference `old` at `fresh`.
    fn attach(ref self, parent: int, child: int, side: ChildSide) {
        if (parent == RB_NIL) {
            self.root = child;
        } else {
            if (side == ChildSide.LeftChild) {
                self.nodes[parent].left = child;
            } else {
                self.nodes[parent].right = child;
            }
        }
        if (child != RB_NIL) {
            self.nodes[child].parent = parent;
        }
    }

    // --- Rotations --------------------------------------------------------
    //
    //        x                y
    //       / \              / \
    //      a   y    ==>     x   c
    //         / \          / \
    //        b   c        a   b

    fn rotate_left(ref self, x: int) {
        if (x == RB_NIL) {
            return;
        }
        let y = self.nodes[x].right;
        if (y == RB_NIL) {
            // Nothing to pivot on; a well-formed caller never gets here.
            return;
        }
        self.nodes[x].right = self.nodes[y].left;
        if (self.nodes[y].left != RB_NIL) {
            self.nodes[self.nodes[y].left].parent = x;
        }
        self.nodes[y].parent = self.nodes[x].parent;
        if (self.nodes[x].parent == RB_NIL) {
            self.root = y;
        } else {
            if (x == self.nodes[self.nodes[x].parent].left) {
                self.nodes[self.nodes[x].parent].left = y;
            } else {
                self.nodes[self.nodes[x].parent].right = y;
            }
        }
        self.nodes[y].left = x;
        self.nodes[x].parent = y;
        self.rotations += 1;
    }

    //        y                x
    //       / \              / \
    //      x   c    ==>     a   y
    //     / \                  / \
    //    a   b                b   c

    fn rotate_right(ref self, y: int) {
        if (y == RB_NIL) {
            return;
        }
        let x = self.nodes[y].left;
        if (x == RB_NIL) {
            return;
        }
        self.nodes[y].left = self.nodes[x].right;
        if (self.nodes[x].right != RB_NIL) {
            self.nodes[self.nodes[x].right].parent = y;
        }
        self.nodes[x].parent = self.nodes[y].parent;
        if (self.nodes[y].parent == RB_NIL) {
            self.root = x;
        } else {
            if (y == self.nodes[self.nodes[y].parent].right) {
                self.nodes[self.nodes[y].parent].right = x;
            } else {
                self.nodes[self.nodes[y].parent].left = x;
            }
        }
        self.nodes[x].right = y;
        self.nodes[y].parent = x;
        self.rotations += 1;
    }

    // Rotate `i` in whichever direction brings its subtree back into balance.
    fn rotate_towards(ref self, i: int, side: ChildSide) {
        if (side == ChildSide.LeftChild) {
            self.rotate_right(i);
        } else {
            if (side == ChildSide.RightChild) {
                self.rotate_left(i);
            } else {
                Discard(i);
            }
        }
    }

    // --- Arena management -------------------------------------------------

    fn reserve(ref self, capacity: int) {
        if (capacity > self.nodes.size()) {
            self.nodes.reserve(capacity);
        }
    }

    fn allocate(ref self, key: K, value: V) -> int {
        if (self.free_list != RB_NIL) {
            // Recycle a slot released by a previous erase.
            let slot = self.free_list;
            self.free_list = self.nodes[slot].right;
            self.nodes[slot].key = key;
            self.nodes[slot].value = value;
            self.nodes[slot].reset_links();
            self.nodes[slot].colour = Colour.Red;
            self.nodes[slot].live = true;
            return slot;
        }
        var fresh = RbNode(K, V)({.key = key, .value = value});
        fresh.colour = Colour.Red;
        self.nodes.push_back(fresh);
        return self.nodes.size() - 1;
    }

    fn release(ref self, i: int) {
        if (i == RB_NIL) {
            return;
        }
        self.nodes[i].live = false;
        self.nodes[i].left = RB_NIL;
        self.nodes[i].parent = RB_NIL;
        self.nodes[i].right = self.free_list;
        self.free_list = i;
    }

    // --- Search -----------------------------------------------------------

    fn find_index(self, key: K) -> int {
        var current = self.root;
        while (current != RB_NIL) {
            let order = compare_keys(self.nodes[current].key, *key);
            if (order == 0) {
                return current;
            } else {
                if (order > 0) {
                    current = self.nodes[current].left;
                } else {
                    current = self.nodes[current].right;
                }
            }
        }
        return RB_NIL;
    }

    fn contains(self, key: K) -> bool {
        return self.find_index(key) != RB_NIL;
    }

    fn at(ref self, key: K) -> ref V {
        let i = self.find_index(key);
        if (i == RB_NIL) {
            return self.missing;
        }
        return self.nodes[i].value;
    }

    // Smallest node whose key is >= `key`, or RB_NIL when none exists.
    fn lower_bound(self, key: K) -> int {
        var current = self.root;
        var best = RB_NIL;
        while (current != RB_NIL) {
            let order = compare_keys(self.nodes[current].key, *key);
            if (order < 0) {
                current = self.nodes[current].right;
            } else {
                best = current;
                if (order == 0) {
                    // Exact hit: nothing to the left can be smaller and still
                    // satisfy the bound.
                    return current;
                } else {
                    current = self.nodes[current].left;
                }
            }
        }
        return best;
    }

    // Smallest node whose key is strictly greater than `key`.
    fn upper_bound(self, key: K) -> int {
        var current = self.root;
        var best = RB_NIL;
        while (current != RB_NIL) {
            let order = compare_keys(self.nodes[current].key, *key);
            if (order > 0) {
                best = current;
                current = self.nodes[current].left;
            } else {
                current = self.nodes[current].right;
            }
        }
        return best;
    }

    // --- Extremes and stepping -------------------------------------------

    fn subtree_minimum(self, start: int) -> int {
        var current = start;
        if (current == RB_NIL) {
            return RB_NIL;
        }
        while (self.nodes[current].left != RB_NIL) {
            current = self.nodes[current].left;
        }
        return current;
    }

    fn subtree_maximum(self, start: int) -> int {
        var current = start;
        if (current == RB_NIL) {
            return RB_NIL;
        }
        while (self.nodes[current].right != RB_NIL) {
            current = self.nodes[current].right;
        }
        return current;
    }

    fn minimum(self) -> int {
        return self.subtree_minimum(self.root);
    }

    fn maximum(self) -> int {
        return self.subtree_maximum(self.root);
    }

    fn successor(self, i: int) -> int {
        if (i == RB_NIL) {
            return RB_NIL;
        }
        if (self.nodes[i].right != RB_NIL) {
            return self.subtree_minimum(self.nodes[i].right);
        }
        var current = i;
        var up = self.nodes[i].parent;
        while (up != RB_NIL and current == self.nodes[up].right) {
            current = up;
            up = self.nodes[up].parent;
        }
        return up;
    }

    fn predecessor(self, i: int) -> int {
        if (i == RB_NIL) {
            return RB_NIL;
        }
        if (self.nodes[i].left != RB_NIL) {
            return self.subtree_maximum(self.nodes[i].left);
        }
        var current = i;
        var up = self.nodes[i].parent;
        while (up != RB_NIL and current == self.nodes[up].left) {
            current = up;
            up = self.nodes[up].parent;
        }
        return up;
    }

    // --- Insertion --------------------------------------------------------
    //
    // Ordinary binary-search-tree descent, then `insert_fixup` restores the
    // colour invariants that the freshly painted red node may have broken.

    fn insert(ref self, key: K, value: V) -> bool {
        if (self.nodes.size() == 0) {
            self.reserve(RB_INITIAL_CAPACITY);
        }

        var parent = RB_NIL;
        var current = self.root;
        var side = ChildSide.NoChild;

        while (current != RB_NIL) {
            parent = current;
            let order = compare_keys(self.nodes[current].key, key);
            if (order == 0) {
                // Key already present: overwrite in place, shape unchanged.
                self.nodes[current].value = value;
                return false;
            } else {
                if (order > 0) {
                    side = ChildSide.LeftChild;
                    current = self.nodes[current].left;
                } else {
                    side = ChildSide.RightChild;
                    current = self.nodes[current].right;
                }
            }
        }

        let fresh = self.allocate(key, value);
        self.nodes[fresh].parent = parent;
        if (parent == RB_NIL) {
            self.root = fresh;
        } else {
            if (side == ChildSide.LeftChild) {
                self.nodes[parent].left = fresh;
            } else {
                self.nodes[parent].right = fresh;
            }
        }
        self.count += 1;
        self.insert_fixup(fresh);
        self.paint_black(self.root);
        return true;
    }

    // Restore rules 2 and 3 after a red node was spliced in at `start`.
    //
    // The case analysis is deliberately written as a nested tree rather than
    // a flat chain: outer level picks the parent's side, the next level
    // distinguishes a red uncle from a black one, and the innermost level
    // separates the "inner" triangle case from the "outer" line case.
    fn insert_fixup(ref self, start: int) {
        var z = start;
        var guard: int = 0;

        while (z != RB_NIL and guard < RB_MAX_HEIGHT) {
            guard += 1;
            let parent = self.nodes[z].parent;

            if (parent == RB_NIL) {
                // z is the root; rule 2 is restored by the caller.
                self.paint_black(z);
                break;
            } else {
                if (self.is_black(parent)) {
                    // No red-red violation left to repair.
                    break;
                } else {
                    let grand = self.nodes[parent].parent;
                    if (grand == RB_NIL) {
                        // A red root with a red child: blacken the root.
                        self.paint_black(parent);
                        break;
                    } else {
                        if (parent == self.nodes[grand].left) {
                            // --- Parent is the LEFT child of grandparent ---
                            let uncle = self.nodes[grand].right;
                            if (uncle != RB_NIL and self.is_red(uncle)) {
                                // Case 1: recolour and push the problem up.
                                self.paint_black(parent);
                                self.paint_black(uncle);
                                self.paint_red(grand);
                                self.recolours += 3;
                                z = grand;
                            } else {
                                // Uncle is black (possibly NIL).
                                if (z == self.nodes[parent].right) {
                                    // Case 2: inner triangle.  Rotate left at
                                    // the parent to turn it into case 3, then
                                    // fall straight through to that case.
                                    z = parent;
                                    self.rotate_left(z);
                                    let np = self.nodes[z].parent;
                                    if (np == RB_NIL) {
                                        self.paint_black(z);
                                        break;
                                    } else {
                                        let ng = self.nodes[np].parent;
                                        if (ng == RB_NIL) {
                                            self.paint_black(np);
                                            break;
                                        } else {
                                            // Case 3 after the pre-rotation.
                                            self.paint_black(np);
                                            self.paint_red(ng);
                                            self.recolours += 2;
                                            self.rotate_right(ng);
                                        }
                                    }
                                } else {
                                    // Case 3: outer line, single rotation.
                                    self.paint_black(parent);
                                    self.paint_red(grand);
                                    self.recolours += 2;
                                    self.rotate_right(grand);
                                }
                            }
                        } else {
                            // --- Parent is the RIGHT child (mirror image) --
                            let uncle = self.nodes[grand].left;
                            if (uncle != RB_NIL and self.is_red(uncle)) {
                                // Case 1 mirrored.
                                self.paint_black(parent);
                                self.paint_black(uncle);
                                self.paint_red(grand);
                                self.recolours += 3;
                                z = grand;
                            } else {
                                if (z == self.nodes[parent].left) {
                                    // Case 2 mirrored: inner triangle.
                                    z = parent;
                                    self.rotate_right(z);
                                    let np = self.nodes[z].parent;
                                    if (np == RB_NIL) {
                                        self.paint_black(z);
                                        break;
                                    } else {
                                        let ng = self.nodes[np].parent;
                                        if (ng == RB_NIL) {
                                            self.paint_black(np);
                                            break;
                                        } else {
                                            // Case 3 mirrored.
                                            self.paint_black(np);
                                            self.paint_red(ng);
                                            self.recolours += 2;
                                            self.rotate_left(ng);
                                        }
                                    }
                                } else {
                                    // Case 3 mirrored: outer line.
                                    self.paint_black(parent);
                                    self.paint_red(grand);
                                    self.recolours += 2;
                                    self.rotate_left(grand);
                                }
                            }
                        }
                    }
                }
            }
        }

        self.paint_black(self.root);
    }

    // --- Deletion ---------------------------------------------------------

    // Replace the subtree rooted at `target` with the subtree rooted at
    // `replacement`.  The replacement's own children are left untouched.
    fn transplant(ref self, target: int, replacement: int) {
        let parent = self.parent_of(target);
        if (parent == RB_NIL) {
            self.root = replacement;
        } else {
            if (target == self.nodes[parent].left) {
                self.nodes[parent].left = replacement;
            } else {
                self.nodes[parent].right = replacement;
            }
        }
        if (replacement != RB_NIL) {
            self.nodes[replacement].parent = parent;
        }
    }

    fn erase(ref self, key: K) -> bool {
        let victim = self.find_index(key);
        if (victim == RB_NIL) {
            return false;
        }
        self.erase_index(victim);
        return true;
    }

    fn erase_index(ref self, victim: int) {
        if (victim == RB_NIL) {
            return;
        }

        // `removed` is the node that physically leaves its position, which
        // for a two-child victim is the in-order successor rather than the
        // victim itself.
        var removed = victim;
        var removed_colour = self.nodes[victim].colour;
        var fixup_at = RB_NIL;
        var fixup_parent = RB_NIL;

        if (self.nodes[victim].left == RB_NIL) {
            // At most a right child: splice it up directly.
            fixup_at = self.nodes[victim].right;
            fixup_parent = self.nodes[victim].parent;
            self.transplant(victim, self.nodes[victim].right);
        } else {
            if (self.nodes[victim].right == RB_NIL) {
                // At most a left child.
                fixup_at = self.nodes[victim].left;
                fixup_parent = self.nodes[victim].parent;
                self.transplant(victim, self.nodes[victim].left);
            } else {
                // Two children: hoist the in-order successor into place.
                removed = self.subtree_minimum(self.nodes[victim].right);
                removed_colour = self.nodes[removed].colour;
                fixup_at = self.nodes[removed].right;
                if (self.nodes[removed].parent == victim) {
                    // Successor is the victim's direct right child.
                    fixup_parent = removed;
                    if (fixup_at != RB_NIL) {
                        self.nodes[fixup_at].parent = removed;
                    }
                } else {
                    fixup_parent = self.nodes[removed].parent;
                    self.transplant(removed, self.nodes[removed].right);
                    self.nodes[removed].right = self.nodes[victim].right;
                    self.nodes[self.nodes[removed].right].parent = removed;
                }
                self.transplant(victim, removed);
                self.nodes[removed].left = self.nodes[victim].left;
                self.nodes[self.nodes[removed].left].parent = removed;
                self.nodes[removed].colour = self.nodes[victim].colour;
            }
        }

        self.release(victim);
        self.count -= 1;

        if (removed_colour == Colour.Black) {
            // Removing a black node shortens one path by one black link, so
            // rule 4 has to be repaired.
            self.delete_fixup(fixup_at, fixup_parent);
        }
        self.paint_black(self.root);
    }

    // Rebalance after a black node was removed from below `parent`.
    //
    // `x` carries an extra conceptual "black token"; the loop pushes that
    // token up the tree until it can be absorbed.  `x` may legitimately be
    // RB_NIL, which is why the parent is threaded through explicitly.
    fn delete_fixup(ref self, start: int, start_parent: int) {
        var x = start;
        var parent = start_parent;
        var guard: int = 0;

        while (x != self.root and guard < RB_MAX_HEIGHT) {
            guard += 1;
            if (self.is_red(x)) {
                // Absorb the extra black into a red node.
                self.paint_black(x);
                break;
            } else {
                if (parent == RB_NIL) {
                    // Reached the root through the parent chain.
                    break;
                } else {
                    if (x == self.nodes[parent].left) {
                        // --- x is the LEFT child ---------------------------
                        var w = self.nodes[parent].right;
                        if (self.is_red(w)) {
                            // Case 1: red sibling.  Rotate it out of the way
                            // so the remaining cases see a black sibling.
                            self.paint_black(w);
                            self.paint_red(parent);
                            self.recolours += 2;
                            self.rotate_left(parent);
                            w = self.nodes[parent].right;
                        }
                        if (w == RB_NIL) {
                            // Degenerate shape: push the token upwards.
                            x = parent;
                            parent = self.nodes[x].parent;
                        } else {
                            if (self.is_black(self.nodes[w].left) and self.is_black(self.nodes[w].right)) {
                                // Case 2: both of the sibling's children are
                                // black.  Recolour and move the token up.
                                self.paint_red(w);
                                self.recolours += 1;
                                x = parent;
                                parent = self.nodes[x].parent;
                            } else {
                                if (self.is_black(self.nodes[w].right)) {
                                    // Case 3: the sibling's far child is
                                    // black but its near child is red.
                                    // Rotate right to convert into case 4.
                                    if (self.nodes[w].left != RB_NIL) {
                                        self.paint_black(self.nodes[w].left);
                                        self.recolours += 1;
                                    }
                                    self.paint_red(w);
                                    self.rotate_right(w);
                                    w = self.nodes[parent].right;
                                }
                                if (w == RB_NIL) {
                                    x = parent;
                                    parent = self.nodes[x].parent;
                                } else {
                                    // Case 4: the sibling's far child is red.
                                    // One rotation finishes the repair.
                                    self.set_colour(w, self.colour_of(parent));
                                    self.paint_black(parent);
                                    if (self.nodes[w].right != RB_NIL) {
                                        self.paint_black(self.nodes[w].right);
                                        self.recolours += 1;
                                    }
                                    self.rotate_left(parent);
                                    x = self.root;
                                    parent = RB_NIL;
                                }
                            }
                        }
                    } else {
                        // --- x is the RIGHT child (mirror image) -----------
                        var w = self.nodes[parent].left;
                        if (self.is_red(w)) {
                            // Case 1 mirrored.
                            self.paint_black(w);
                            self.paint_red(parent);
                            self.recolours += 2;
                            self.rotate_right(parent);
                            w = self.nodes[parent].left;
                        }
                        if (w == RB_NIL) {
                            x = parent;
                            parent = self.nodes[x].parent;
                        } else {
                            if (self.is_black(self.nodes[w].left) and self.is_black(self.nodes[w].right)) {
                                // Case 2 mirrored.
                                self.paint_red(w);
                                self.recolours += 1;
                                x = parent;
                                parent = self.nodes[x].parent;
                            } else {
                                if (self.is_black(self.nodes[w].left)) {
                                    // Case 3 mirrored.
                                    if (self.nodes[w].right != RB_NIL) {
                                        self.paint_black(self.nodes[w].right);
                                        self.recolours += 1;
                                    }
                                    self.paint_red(w);
                                    self.rotate_left(w);
                                    w = self.nodes[parent].left;
                                }
                                if (w == RB_NIL) {
                                    x = parent;
                                    parent = self.nodes[x].parent;
                                } else {
                                    // Case 4 mirrored.
                                    self.set_colour(w, self.colour_of(parent));
                                    self.paint_black(parent);
                                    if (self.nodes[w].left != RB_NIL) {
                                        self.paint_black(self.nodes[w].left);
                                        self.recolours += 1;
                                    }
                                    self.rotate_right(parent);
                                    x = self.root;
                                    parent = RB_NIL;
                                }
                            }
                        }
                    }
                }
            }
        }

        self.paint_black(x);
    }

    // --- Traversals -------------------------------------------------------
    //
    // Both traversals are iterative: the arena representation makes an
    // explicit index stack cheaper than recursion, and it keeps the worst
    // case stack depth bounded by RB_MAX_HEIGHT.

    fn in_order(self, ref out: vector(int)) {
        var stack = vector(int)();
        stack.reserve(RB_MAX_HEIGHT);
        var current = self.root;
        while (current != RB_NIL or stack.size() > 0) {
            if (current != RB_NIL) {
                stack.push_back(current);
                current = self.nodes[current].left;
            } else {
                let top = stack.back();
                stack.pop_back();
                out.push_back(top);
                current = self.nodes[top].right;
            }
        }
        Destroy(stack);
    }

    fn pre_order(self, ref out: vector(int)) {
        if (self.root == RB_NIL) {
            return;
        }
        var stack = vector(int)();
        stack.reserve(RB_MAX_HEIGHT);
        stack.push_back(self.root);
        while (stack.size() > 0) {
            let top = stack.back();
            stack.pop_back();
            out.push_back(top);
            // Right first so the left child is popped next.
            if (self.nodes[top].right != RB_NIL) {
                stack.push_back(self.nodes[top].right);
            }
            if (self.nodes[top].left != RB_NIL) {
                stack.push_back(self.nodes[top].left);
            }
        }
        Destroy(stack);
    }

    fn keys_in_order(self, ref out: vector(K)) {
        var order = vector(int)();
        self.in_order(order);
        for (i in order) {
            out.push_back(self.nodes[i].key);
        }
        Destroy(order);
    }

    // --- Height and shape metrics ----------------------------------------

    fn height(self) -> int {
        return self.subtree_height(self.root);
    }

    fn subtree_height(self, start: int) -> int {
        if (start == RB_NIL) {
            return 0;
        }
        var stack = vector(int)();
        var depths = vector(int)();
        stack.push_back(start);
        depths.push_back(1);
        var best: int = 0;
        while (stack.size() > 0) {
            let node = stack.back();
            let depth = depths.back();
            stack.pop_back();
            depths.pop_back();
            if (depth > best) {
                best = depth;
            }
            if (self.nodes[node].left != RB_NIL) {
                stack.push_back(self.nodes[node].left);
                depths.push_back(depth + 1);
            }
            if (self.nodes[node].right != RB_NIL) {
                stack.push_back(self.nodes[node].right);
                depths.push_back(depth + 1);
            }
        }
        Destroy(stack);
        Destroy(depths);
        return best;
    }

    // Number of black nodes on the leftmost spine, which by rule 4 equals the
    // black height of every other root-to-leaf path.
    fn black_height(self) -> int {
        var current = self.root;
        var blacks: int = 0;
        while (current != RB_NIL) {
            if (self.is_black(current)) {
                blacks += 1;
            }
            current = self.nodes[current].left;
        }
        // The NIL leaf itself counts as black.
        return blacks + 1;
    }

    // Recomputes the black height of a subtree, returning -1 when the paths
    // below `start` disagree.  Used only by the validity checker.
    fn measured_black_height(self, start: int) -> int {
        if (start == RB_NIL) {
            return 1;
        }
        let left = self.measured_black_height(self.nodes[start].left);
        if (left < 0) {
            return -1;
        } else {
            let right = self.measured_black_height(self.nodes[start].right);
            if (right < 0) {
                return -1;
            } else {
                if (left != right) {
                    return -1;
                } else {
                    if (self.is_black(start)) {
                        return left + 1;
                    } else {
                        return left;
                    }
                }
            }
        }
    }

    fn min_key(ref self) -> ref K {
        let i = self.minimum();
        if (i == RB_NIL) {
            return self.missing_key;
        }
        return self.nodes[i].key;
    }

    fn max_key(ref self) -> ref K {
        let i = self.maximum();
        if (i == RB_NIL) {
            return self.missing_key;
        }
        return self.nodes[i].key;
    }

    // --- Validity checker -------------------------------------------------
    //
    // Every red-black rule is restated here so the verifier has the
    // invariants available as explicit propositions.

    fn check_validity(self) -> bool {
        Assert(self.count >= 0);
        Assert(self.count <= self.nodes.size());

        if (self.root == RB_NIL) {
            // An empty tree trivially satisfies every rule.
            Assert(self.count == 0);
            Prove(self.count == 0);
            return true;
        }

        // Rule 2: the root is black.
        Assert(self.is_black(self.root));
        Prove(self.colour_of(self.root) == Colour.Black);

        // Rule 5: the sentinel leaf is black.
        Assert(self.is_black(RB_NIL));
        Prove(self.colour_of(RB_NIL) == Colour.Black);

        var order = vector(int)();
        self.in_order(order);

        // The in-order walk must visit exactly the live nodes.
        Assert(order.size() == self.count);
        Prove(order.size() == self.count);

        var index: int = 0;
        while (index < order.size()) {
            let node = order[index];
            Assert(self.nodes[node].live);

            // Rule 1: the colour is one of exactly two values.
            Assert(self.colour_of(node) == Colour.Red or self.colour_of(node) == Colour.Black);

            // Rule 3: a red node has no red child.
            if (self.is_red(node)) {
                Assert(self.is_black(self.nodes[node].left));
                Assert(self.is_black(self.nodes[node].right));
                Prove(self.is_black(self.left_of(node)) and self.is_black(self.right_of(node)));
            } else {
                // Black nodes constrain nothing about their children's colour,
                // but the parent links must still be consistent.
                if (self.nodes[node].left != RB_NIL) {
                    Assert(self.parent_of(self.nodes[node].left) == node);
                }
                if (self.nodes[node].right != RB_NIL) {
                    Assert(self.parent_of(self.nodes[node].right) == node);
                }
            }

            // Search-tree ordering: the walk is strictly increasing.
            if (index > 0) {
                let previous = order[index - 1];
                Assert(compare_keys(self.nodes[previous].key, self.nodes[node].key) < 0);
                Prove(compare_keys(self.nodes[previous].key, self.nodes[node].key) < 0);
            }

            index += 1;
        }
        Destroy(order);

        // Rule 4: every root-to-leaf path carries the same black count.
        let measured = self.measured_black_height(self.root);
        Assert(measured > 0);
        Assert(measured == self.black_height());
        Prove(measured == self.black_height());

        // The classic height bound follows from rules 3 and 4.
        Assert(self.height() <= 2 * measured);
        Prove(self.height() <= 2 * self.black_height());

        return true;
    }

    // --- Bulk operations --------------------------------------------------

    fn clear(ref self) {
        for (node in self.nodes) {
            node.live = false;
            node.reset_links();
        }
        self.nodes.clear();
        self.root = RB_NIL;
        self.free_list = RB_NIL;
        self.count = 0;
        self.rotations = 0;
        self.recolours = 0;
    }

    var nodes: vector(RbNode(K, V));
    var root: int = -1;
    var free_list: int = -1;
    var count: int = 0;
    var rotations: int = 0;
    var recolours: int = 0;
    var missing: V;
    var missing_key: K;
}

// --- Free functions -------------------------------------------------------

// Three-way comparison used by every ordered operation above.
fn compare_keys[T: type]
    (a: T, b: T) -> int {
    if (a < b) {
        return -1;
    } else {
        if (b < a) {
            return 1;
        } else {
            return 0;
        }
    }
}

// Copies every key/value pair of `source` into `target`, preserving order.
fn merge_into[K: type, V: type]
    (ref target: RedBlackTree(K, V), source: RedBlackTree(K, V)) {
    var order = vector(int)();
    source.in_order(order);
    for (i in order) {
        target.insert(source.nodes[i].key, source.nodes[i].value);
    }
    Destroy(order);
}

// Removes every key in the half-open range [low, high).
fn erase_range[K: type, V: type]
    (ref tree: RedBlackTree(K, V), low: K, high: K) -> int {
    var removed: int = 0;
    while (true) {
        let node = tree.lower_bound(low);
        if (node == RB_NIL) {
            break;
        } else {
            if (compare_keys(tree.nodes[node].key, *high) >= 0) {
                break;
            } else {
                tree.erase_index(node);
                removed += 1;
            }
        }
    }
    return removed;
}

fn describe_tree() {
    var tree = RedBlackTree(int, string)();
    tree.reserve(RB_INITIAL_CAPACITY);
    for (i in range(0, 32)) {
        tree.insert((i * 7) % 32, to_string(i));
    }
    println(to_string(tree.size()));
    println(to_string(tree.height()));
    println(to_string(tree.black_height()));
    if (not tree.check_validity()) {
        panic("red-black invariants violated after bulk insert");
    }
    var index: int = 0;
    while (index < 32) {
        if (index % 2 == 0) {
            Discard(tree.erase(index));
        }
        index += 1;
    }
    if (not tree.check_validity()) {
        panic("red-black invariants violated after bulk erase");
    }
    Destroy(tree);
}


// Open-addressing hash map with Robin Hood probing.
namespace containers;

choice SlotState {
    Empty,
    Occupied,
    Tombstone,
}

let DEFAULT_CAPACITY: int = 16;
let MAX_LOAD_PERCENT: int = 75;

class Slot(K: type, V: type)
{
    var key: K;
    var value: V;
    var hash: int = 0;
    var distance: int = 0;
    var state: SlotState = SlotState.Empty;
}

class HashMap(K: type, V: type)
{

    fn size(self) -> int {
        return self.count;
    }

    fn empty(self) -> bool {
        return self.count == 0;
    }

    fn slot_index(self, h: int) -> int {
        return h & (self.slots.size() - 1);
    }

    fn should_grow(self) -> bool {
        let limit = self.slots.size() * MAX_LOAD_PERCENT;
        return self.count * 100 >= limit;
    }

    fn find(ref self, key: K) -> ref V {
        let h = hash_of(key);
        var index = self.slot_index(h);
        var probe: int = 0;
        while (true) {
            let ref slot: auto = self.slots[index];
            if (slot.state == SlotState.Empty) {
                break;
            }
            if (slot.state == SlotState.Occupied and slot.hash == h) {
                if (slot.key == *key) {
                    return slot.value;
                }
            }
            if (probe > slot.distance) {
                break;
            }
            index = self.slot_index(index + 1);
            probe += 1;
        }
        return self.missing;
    }

    fn insert(ref self, key: K, value: V) -> bool {
        if (self.should_grow()) {
            self.rehash(self.slots.size() * 2);
        }
        let h = hash_of(key);
        var index = self.slot_index(h);
        var distance: int = 0;
        var pending = Slot(K, V)({.key = key, .value = value, .hash = h});
        while (true) {
            let ref slot: auto = self.slots[index];
            if (slot.state != SlotState.Occupied) {
                slot.key = pending.key;
                slot.value = pending.value;
                slot.hash = pending.hash;
                slot.distance = distance;
                slot.state = SlotState.Occupied;
                self.count += 1;
                return true;
            }
            if (slot.hash == h and slot.key == pending.key) {
                slot.value = pending.value;
                return false;
            }
            if (slot.distance < distance) {
                swap(slot.key, pending.key);
                swap(slot.value, pending.value);
                swap(slot.distance, distance);
            }
            index = self.slot_index(index + 1);
            distance += 1;
        }
    }

    fn erase(ref self, key: K) -> bool {
        var index = self.slot_index(hash_of(key));
        var probe: int = 0;
        while (probe < self.slots.size()) {
            let ref slot: auto = self.slots[index];
            if (slot.state == SlotState.Empty) {
                return false;
            }
            if (slot.state == SlotState.Occupied and slot.key == *key) {
                slot.state = SlotState.Tombstone;
                self.count -= 1;
                return true;
            }
            index = self.slot_index(index + 1);
            probe += 1;
        }
        return false;
    }

    fn rehash(ref self, capacity: int) {
        var old = move(self.slots);
        self.slots = vector(Slot(K, V))(capacity);
        self.count = 0;
        for (entry in old) {
            if (entry.state == SlotState.Occupied) {
                self.insert(entry.key, entry.value);
            } else {
                Discard(entry);
            }
        }
        Destroy(old);
    }

    fn clear(ref self) {
        for (slot in self.slots) {
            slot.state = SlotState.Empty;
            slot.distance = 0;
        }
        self.count = 0;
    }

    var slots: vector(Slot(K, V));
    var count: int = 0;
    var missing: V;
}


// A complete regular expression engine: pattern lexer, recursive descent
// pattern parser, Thompson NFA construction, NFA simulation over a state set,
// a backtracking matcher with capture groups, a compiled instruction program
// with a small optimiser, and the user facing match/search/replace/split API.
//
// The engine works on `string` values and addresses them by integer offsets.
// Every structure that would normally hold pointers instead holds indices into
// a flat arena, so patterns are trivially copyable and can be serialised.
//
// Supported syntax:
//
//     literal        a  b  \+  \{
//     any            .
//     class          [abc]  [^abc]  [a-z0-9_]  [[:alpha:]]
//     shorthand      \d \D \w \W \s \S \h \u{0B}
//     group          (...)  (?:...)  (?<name>...)
//     alternation    a|b|c
//     repetition     a*  a+  a?  a{2}  a{2,}  a{2,5}  and lazy forms a*?
//     anchors        ^  $  \u{08}  \B  \A  \z
//     backreference  \1 .. \9  \k<name>
//
// Nothing here needs floating point: all counters, bounds and scores are plain
// integers, and where a fraction is required it is expressed in per-mille.
namespace regex;

// --- Character constants -------------------------------------------------
//
// The lexer and the class parser compare raw characters on almost every line,
// so each significant character is given a name once and referred to by that
// name afterwards.  Spelling them out at every use site would make the
// character-level logic below far harder to read.

let CHAR_NUL: char = '\0';
let CHAR_TAB: char = '\t';
let CHAR_NEWLINE: char = '\n';
let CHAR_RETURN: char = '\r';
let CHAR_FORMFEED: char = '\u{0C}';
let CHAR_BACKSPACE: char = '\u{08}';
let CHAR_SPACE: char = ' ';

// Metacharacters.
let CHAR_BACKSLASH: char = '\\';
let CHAR_CARET: char = '^';
let CHAR_DOLLAR: char = '$';
let CHAR_DOT: char = '.';
let CHAR_STAR: char = '*';
let CHAR_PLUS: char = '+';
let CHAR_QUESTION: char = '?';
let CHAR_PIPE: char = '|';
let CHAR_LPAREN: char = '(';
let CHAR_RPAREN: char = ')';
let CHAR_LBRACKET: char = '[';
let CHAR_RBRACKET: char = ']';
let CHAR_LBRACE: char = '{';
let CHAR_RBRACE: char = '}';
let CHAR_COMMA: char = ',';
let CHAR_MINUS: char = '-';
let CHAR_COLON: char = ':';
let CHAR_LESS: char = '<';
let CHAR_GREATER: char = '>';
let CHAR_EQUALS: char = '=';
let CHAR_BANG: char = '!';
let CHAR_UNDERSCORE: char = '_';
let CHAR_SLASH: char = '/';
let CHAR_QUOTE: char = '"';

// Digits and the letter ranges, used by the classification helpers.
let CHAR_ZERO: char = '0';
let CHAR_ONE: char = '1';
let CHAR_SEVEN: char = '7';
let CHAR_NINE: char = '9';
let CHAR_LOWER_A: char = 'a';
let CHAR_LOWER_B: char = 'b';
let CHAR_LOWER_D: char = 'd';
let CHAR_LOWER_E: char = 'e';
let CHAR_LOWER_F: char = 'f';
let CHAR_LOWER_H: char = 'h';
let CHAR_LOWER_K: char = 'k';
let CHAR_LOWER_N: char = 'n';
let CHAR_LOWER_R: char = 'r';
let CHAR_LOWER_S: char = 's';
let CHAR_LOWER_T: char = 't';
let CHAR_LOWER_U: char = 'u';
let CHAR_LOWER_V: char = 'v';
let CHAR_LOWER_W: char = 'w';
let CHAR_LOWER_X: char = 'x';
let CHAR_LOWER_Z: char = 'z';
let CHAR_UPPER_A: char = 'A';
let CHAR_UPPER_B: char = 'B';
let CHAR_UPPER_D: char = 'D';
let CHAR_UPPER_F: char = 'F';
let CHAR_UPPER_S: char = 'S';
let CHAR_UPPER_W: char = 'W';
let CHAR_UPPER_Z: char = 'Z';

// The apostrophe cannot be written as a character escape in this dialect, so
// it is kept as a one character string and read out of it when needed.
let TEXT_APOSTROPHE: string = "'";

fn apostrophe() -> char {
    return TEXT_APOSTROPHE.at(0);
}

// --- Numeric limits ------------------------------------------------------

// Character codes are treated as a byte alphabet.
let ALPHABET_SIZE: int = 256;
let CODE_MIN: int = 0;
let CODE_MAX: int = 255;

// Sentinel used wherever "no such index" must be expressed.
let NONE: int = -1;

// The largest repetition count a `{n,m}` bound may name.  Larger bounds are
// rejected by the parser rather than expanded, because expansion is linear in
// the bound and a hostile pattern could otherwise blow up the program.
let MAX_REPEAT: int = 1000;

// Upper bound on the number of nested groups the recursive descent parser
// will accept.  This keeps the recursion depth, and therefore the native
// stack usage, bounded for arbitrary input.
let MAX_GROUP_DEPTH: int = 64;

// Capture groups are numbered from 1; group 0 is the whole match.
let MAX_CAPTURES: int = 32;

// Budget for the backtracking matcher, counted in step units.  A pathological
// pattern such as (a+)+$ against a long run of a's will exhaust it and the
// matcher reports MatchStatus::Exhausted instead of running forever.
let BACKTRACK_BUDGET: int = 1000000;

// The optimiser gives up on a pass once it has rewritten this many
// instructions, so compilation stays linear even for very large programs.
let OPTIMISER_BUDGET: int = 4096;

// --- Text constants ------------------------------------------------------

let TEXT_EMPTY: string = "";
let TEXT_DOT: string = ".";
let TEXT_STAR: string = "*";
let TEXT_PLUS: string = "+";
let TEXT_QUESTION: string = "?";
let TEXT_PIPE: string = "|";
let TEXT_CARET: string = "^";
let TEXT_DOLLAR: string = "$";
let TEXT_LPAREN: string = "(";
let TEXT_RPAREN: string = ")";
let TEXT_LBRACKET: string = "[";
let TEXT_RBRACKET: string = "]";
let TEXT_LBRACE: string = "{";
let TEXT_RBRACE: string = "}";
let TEXT_COMMA: string = ",";
let TEXT_MINUS: string = "-";
let TEXT_LAZY_SUFFIX: string = "?";

// Escape spellings.  The doubled backslash in the source produces a single
// real backslash in the value.
let ESCAPE_DIGIT: string = "\\d";
let ESCAPE_NOT_DIGIT: string = "\\D";
let ESCAPE_WORD: string = "\\w";
let ESCAPE_NOT_WORD: string = "\\W";
let ESCAPE_SPACE: string = "\\s";
let ESCAPE_NOT_SPACE: string = "\\S";
let ESCAPE_HORIZONTAL: string = "\\h";
let ESCAPE_VERTICAL: string = "\\v";
let ESCAPE_WORD_BOUNDARY: string = "\\b";
let ESCAPE_NOT_WORD_BOUNDARY: string = "\\B";
let ESCAPE_TEXT_START: string = "\\A";
let ESCAPE_TEXT_END: string = "\\z";
let ESCAPE_TAB: string = "\\t";
let ESCAPE_NEWLINE: string = "\\n";
let ESCAPE_RETURN: string = "\\r";
let ESCAPE_FORMFEED: string = "\\f";
let ESCAPE_BACKSLASH: string = "\\\\";

// POSIX style class names, spelled without their bracket-colon wrapper.
let POSIX_ALPHA: string = "alpha";
let POSIX_DIGIT: string = "digit";
let POSIX_ALNUM: string = "alnum";
let POSIX_UPPER: string = "upper";
let POSIX_LOWER: string = "lower";
let POSIX_SPACE: string = "space";
let POSIX_BLANK: string = "blank";
let POSIX_PUNCT: string = "punct";
let POSIX_PRINT: string = "print";
let POSIX_GRAPH: string = "graph";
let POSIX_CNTRL: string = "cntrl";
let POSIX_XDIGIT: string = "xdigit";
let POSIX_WORD: string = "word";

// Diagnostic message texts.
let ERROR_NONE: string = "";
let ERROR_UNEXPECTED_END: string = "unexpected end of pattern";
let ERROR_UNBALANCED_PAREN: string = "unbalanced parenthesis";
let ERROR_UNCLOSED_CLASS: string = "unterminated character class";
let ERROR_BAD_RANGE: string = "character class range is reversed";
let ERROR_BAD_REPEAT: string = "repetition bound is malformed";
let ERROR_REPEAT_TOO_LARGE: string = "repetition bound exceeds the limit";
let ERROR_NOTHING_TO_REPEAT: string = "nothing to repeat";
let ERROR_TRAILING_BACKSLASH: string = "pattern ends with a backslash";
let ERROR_BAD_ESCAPE: string = "unrecognised escape sequence";
let ERROR_BAD_GROUP: string = "malformed group opening";
let ERROR_DEPTH_EXCEEDED: string = "group nesting is too deep";
let ERROR_BAD_BACKREF: string = "backreference names an unknown group";
let ERROR_UNKNOWN_CLASS: string = "unknown POSIX class name";

// --- Character classification -------------------------------------------
//
// Everything downstream of the lexer asks these questions constantly, so they
// live as free functions rather than as methods on some helper object.  They
// are written as explicit range tests instead of table lookups because the
// alphabet is small and the branch layout is what the compiler benchmark is
// actually meant to measure.

fn is_digit(c: char) -> bool {
    if (c < CHAR_ZERO) {
        return false;
    }
    if (c > CHAR_NINE) {
        return false;
    }
    return true;
}

fn is_octal_digit(c: char) -> bool {
    if (c < CHAR_ZERO) {
        return false;
    }
    if (c > CHAR_SEVEN) {
        return false;
    }
    return true;
}

fn is_lower(c: char) -> bool {
    if (c < CHAR_LOWER_A) {
        return false;
    }
    if (c > CHAR_LOWER_Z) {
        return false;
    }
    return true;
}

fn is_upper(c: char) -> bool {
    if (c < CHAR_UPPER_A) {
        return false;
    }
    if (c > CHAR_UPPER_Z) {
        return false;
    }
    return true;
}

fn is_alpha(c: char) -> bool {
    if (is_lower(c)) {
        return true;
    }
    if (is_upper(c)) {
        return true;
    }
    return false;
}

fn is_alnum(c: char) -> bool {
    if (is_alpha(c)) {
        return true;
    }
    return is_digit(c);
}

// The word alphabet is the one \w selects: letters, digits and underscore.
fn is_word_char(c: char) -> bool {
    if (is_alnum(c)) {
        return true;
    }
    if (c == CHAR_UNDERSCORE) {
        return true;
    }
    return false;
}

fn is_hex_digit(c: char) -> bool {
    if (is_digit(c)) {
        return true;
    }
    if (c >= CHAR_LOWER_A and c <= CHAR_LOWER_F) {
        return true;
    }
    if (c >= CHAR_UPPER_A and c <= CHAR_UPPER_F) {
        return true;
    }
    return false;
}

// Horizontal whitespace only: space and tab.
fn is_horizontal_space(c: char) -> bool {
    if (c == CHAR_SPACE) {
        return true;
    }
    if (c == CHAR_TAB) {
        return true;
    }
    return false;
}

// Vertical whitespace: the line terminators plus form feed.
fn is_vertical_space(c: char) -> bool {
    if (c == CHAR_NEWLINE) {
        return true;
    }
    if (c == CHAR_RETURN) {
        return true;
    }
    if (c == CHAR_FORMFEED) {
        return true;
    }
    return false;
}

fn is_space_char(c: char) -> bool {
    if (is_horizontal_space(c)) {
        return true;
    }
    if (is_vertical_space(c)) {
        return true;
    }
    return false;
}

// Control characters are everything below space, plus the delete code.
fn is_control(c: char) -> bool {
    let code = char_code(c);
    if (code < 32) {
        return true;
    }
    if (code == 127) {
        return true;
    }
    return false;
}

fn is_printable(c: char) -> bool {
    let code = char_code(c);
    if (code < 32) {
        return false;
    }
    if (code > 126) {
        return false;
    }
    return true;
}

// Graphic characters are the printable ones minus the space itself.
fn is_graphic(c: char) -> bool {
    if (not is_printable(c)) {
        return false;
    }
    return c != CHAR_SPACE;
}

fn is_punctuation(c: char) -> bool {
    if (not is_graphic(c)) {
        return false;
    }
    if (is_alnum(c)) {
        return false;
    }
    return true;
}

// The characters that carry a special meaning outside a bracket expression.
fn is_metacharacter(c: char) -> bool {
    if (c == CHAR_BACKSLASH) {
        return true;
    }
    if (c == CHAR_CARET) {
        return true;
    }
    if (c == CHAR_DOLLAR) {
        return true;
    }
    if (c == CHAR_DOT) {
        return true;
    }
    if (c == CHAR_STAR) {
        return true;
    }
    if (c == CHAR_PLUS) {
        return true;
    }
    if (c == CHAR_QUESTION) {
        return true;
    }
    if (c == CHAR_PIPE) {
        return true;
    }
    if (c == CHAR_LPAREN) {
        return true;
    }
    if (c == CHAR_RPAREN) {
        return true;
    }
    if (c == CHAR_LBRACKET) {
        return true;
    }
    if (c == CHAR_RBRACKET) {
        return true;
    }
    if (c == CHAR_LBRACE) {
        return true;
    }
    if (c == CHAR_RBRACE) {
        return true;
    }
    return false;
}

// Inside a bracket expression only a handful of characters keep a meaning.
fn is_class_metacharacter(c: char) -> bool {
    if (c == CHAR_BACKSLASH) {
        return true;
    }
    if (c == CHAR_RBRACKET) {
        return true;
    }
    if (c == CHAR_MINUS) {
        return true;
    }
    if (c == CHAR_CARET) {
        return true;
    }
    if (c == CHAR_LBRACKET) {
        return true;
    }
    return false;
}

// --- Case and code conversions ------------------------------------------

fn to_lower(c: char) -> char {
    if (is_upper(c)) {
        return code_char(char_code(c) + 32);
    }
    return c;
}

fn to_upper(c: char) -> char {
    if (is_lower(c)) {
        return code_char(char_code(c) - 32);
    }
    return c;
}

// Numeric value of a hexadecimal digit, or NONE when the character is not one.
fn hex_value(c: char) -> int {
    if (is_digit(c)) {
        return char_code(c) - char_code(CHAR_ZERO);
    }
    if (c >= CHAR_LOWER_A and c <= CHAR_LOWER_F) {
        return 10 + char_code(c) - char_code(CHAR_LOWER_A);
    }
    if (c >= CHAR_UPPER_A and c <= CHAR_UPPER_F) {
        return 10 + char_code(c) - char_code(CHAR_UPPER_A);
    }
    return NONE;
}

fn digit_value(c: char) -> int {
    if (not is_digit(c)) {
        return NONE;
    }
    return char_code(c) - char_code(CHAR_ZERO);
}

// The two bridges between the character and integer views of the alphabet.
fn char_code(c: char) -> int {
    var code: int = 0;
    code = c;
    return code;
}

fn code_char(code: int) -> char {
    var c: char = CHAR_NUL;
    c = code;
    return c;
}

// Case-insensitive comparison of two characters, used when the
// MatchFlags::IgnoreCase flag is set on a compiled program.
fn same_char_folded(a: char, b: char) -> bool {
    if (a == b) {
        return true;
    }
    return to_lower(a) == to_lower(b);
}

// --- Pattern tokens ------------------------------------------------------
//
// The lexer turns the raw pattern text into a token stream.  It deliberately
// does *not* understand bracket expressions: a `[` produces a single
// ClassOpen token and the parser then drives the lexer character by character
// until the matching `]`.  Bracket expressions have their own tiny grammar in
// which almost nothing is a metacharacter, and folding it into the main token
// rules would make both harder to follow.

choice TokenKind {
    EndOfPattern,
    Literal,            // an ordinary character, or an escaped one
    AnyChar,            // .
    AlternationBar,     // |
    GroupOpen,          // ( or (?: or (?<name>
    GroupClose,         // )
    ClassOpen,          // [ or [^
    ClassClose,         // ]
    Star,               // *
    Plus,               // +
    Question,           // ?
    RepeatOpen,         // {n} {n,} {n,m}
    CaretAnchor,        // ^
    DollarAnchor,       // $
    TextStartAnchor,    // \A
    TextEndAnchor,      // \z
    WordBoundary,       // \u{08}
    NotWordBoundary,    // \B
    ShorthandClass,     // \d \D \w \W \s \S \h \u{0B}
    Backreference,      // \1 .. \9 or \k<name>
    Invalid,
}

// Which shorthand a ShorthandClass token stands for.
choice Shorthand {
    ShortDigit,
    ShortNotDigit,
    ShortWord,
    ShortNotWord,
    ShortSpace,
    ShortNotSpace,
    ShortHorizontal,
    ShortVertical,
    ShortNone,
}

// How a group opening was spelled.
choice GroupKind {
    Capturing,          // (
    NonCapturing,       // (?:
    Named,              // (?<name>
    Atomic,         // (?>
}

class Token {

    fn is_end(self) -> bool {
        return self.kind == TokenKind.EndOfPattern;
    }

    fn is_literal(self) -> bool {
        return self.kind == TokenKind.Literal;
    }

    // Quantifiers all bind to the preceding atom, so the parser asks this
    // question rather than testing three kinds at every call site.
    fn is_quantifier(self) -> bool {
        if (self.kind == TokenKind.Star) {
            return true;
        }
        if (self.kind == TokenKind.Plus) {
            return true;
        }
        if (self.kind == TokenKind.Question) {
            return true;
        }
        if (self.kind == TokenKind.RepeatOpen) {
            return true;
        }
        return false;
    }

    fn is_anchor(self) -> bool {
        if (self.kind == TokenKind.CaretAnchor) {
            return true;
        }
        if (self.kind == TokenKind.DollarAnchor) {
            return true;
        }
        if (self.kind == TokenKind.TextStartAnchor) {
            return true;
        }
        if (self.kind == TokenKind.TextEndAnchor) {
            return true;
        }
        if (self.kind == TokenKind.WordBoundary) {
            return true;
        }
        if (self.kind == TokenKind.NotWordBoundary) {
            return true;
        }
        return false;
    }

    // True when the token can begin an atom.  Used for error recovery and by
    // the optimiser when it scans for a literal prefix.
    fn starts_atom(self) -> bool {
        if (self.is_literal()) {
            return true;
        }
        if (self.kind == TokenKind.AnyChar) {
            return true;
        }
        if (self.kind == TokenKind.ClassOpen) {
            return true;
        }
        if (self.kind == TokenKind.GroupOpen) {
            return true;
        }
        if (self.kind == TokenKind.ShorthandClass) {
            return true;
        }
        if (self.kind == TokenKind.Backreference) {
            return true;
        }
        return self.is_anchor();
    }

    var kind: TokenKind = TokenKind.Invalid;
    var value: char = '\0';
    var text: string;
    var shorthand: Shorthand = Shorthand.ShortNone;
    var group_kind: GroupKind = GroupKind.Capturing;
    var lower: int = 0;
    var upper: int = -1;
    var position: int = 0;
    // Set when the character came from an escape, so `\*` is a literal star
    // rather than a quantifier even though the value is identical.
    var escaped: bool = false;
}

// --- Pattern lexer -------------------------------------------------------

class PatternLexer {

    fn at_end(self) -> bool {
        return self.pos >= self.source.size();
    }

    fn remaining(self) -> int {
        return self.source.size() - self.pos;
    }

    fn peek(self) -> char {
        if (self.at_end()) {
            return CHAR_NUL;
        }
        return self.source.at(self.pos);
    }

    fn peek_at(self, offset: int) -> char {
        let index = self.pos + offset;
        if (index < 0) {
            return CHAR_NUL;
        }
        if (index >= self.source.size()) {
            return CHAR_NUL;
        }
        return self.source.at(index);
    }

    fn advance(ref self) -> char {
        if (self.at_end()) {
            return CHAR_NUL;
        }
        let c = self.source.at(self.pos);
        self.pos += 1;
        return c;
    }

    fn accept(ref self, expected: char) -> bool {
        if (self.peek() != expected) {
            return false;
        }
        self.pos += 1;
        return true;
    }

    fn fail(ref self, message: string) {
        if (self.ok) {
            self.ok = false;
            self.error = message;
            self.error_position = self.pos;
        }
    }

    // --- Token construction ----------------------------------------------

    fn make_token(self, kind: TokenKind, at: int) -> Token {
        var t = Token({.kind = kind, .position = at});
        return t;
    }

    fn make_literal(self, c: char, at: int, escaped: bool) -> Token {
        var t = Token({.kind = TokenKind.Literal, .value = c, .position = at});
        t.escaped = escaped;
        return t;
    }

    fn make_shorthand(self, which: Shorthand, at: int) -> Token {
        var t = Token({.kind = TokenKind.ShorthandClass, .position = at});
        t.shorthand = which;
        return t;
    }

    // --- Driving loop -----------------------------------------------------

    fn tokenize(ref self) -> bool {
        self.tokens.clear();
        self.pos = 0;
        self.ok = true;
        self.error = ERROR_NONE;
        while (not self.at_end()) {
            let t = self.next_token();
            if (not self.ok) {
                return false;
            }
            self.tokens.push_back(t);
        }
        self.tokens.push_back(self.make_token(TokenKind.EndOfPattern, self.source.size()));
        return true;
    }

    // One token.  The big branch tree below is the heart of the lexer: each
    // metacharacter is checked in turn and anything that survives is an
    // ordinary literal.
    fn next_token(ref self) -> Token {
        let at = self.pos;
        let c = self.advance();
        if (c == CHAR_BACKSLASH) {
            return self.lex_escape(at);
        }
        if (c == CHAR_DOT) {
            return self.make_token(TokenKind.AnyChar, at);
        }
        if (c == CHAR_PIPE) {
            return self.make_token(TokenKind.AlternationBar, at);
        }
        if (c == CHAR_LPAREN) {
            return self.lex_group_open(at);
        }
        if (c == CHAR_RPAREN) {
            return self.make_token(TokenKind.GroupClose, at);
        }
        if (c == CHAR_LBRACKET) {
            return self.make_token(TokenKind.ClassOpen, at);
        }
        if (c == CHAR_RBRACKET) {
            // A stray `]` outside a bracket expression is an ordinary
            // character; only the class parser gives it a meaning.
            return self.make_literal(c, at, false);
        }
        if (c == CHAR_STAR) {
            return self.make_token(TokenKind.Star, at);
        }
        if (c == CHAR_PLUS) {
            return self.make_token(TokenKind.Plus, at);
        }
        if (c == CHAR_QUESTION) {
            return self.make_token(TokenKind.Question, at);
        }
        if (c == CHAR_LBRACE) {
            return self.lex_repeat_bound(at);
        }
        if (c == CHAR_RBRACE) {
            return self.make_literal(c, at, false);
        }
        if (c == CHAR_CARET) {
            return self.make_token(TokenKind.CaretAnchor, at);
        }
        if (c == CHAR_DOLLAR) {
            return self.make_token(TokenKind.DollarAnchor, at);
        }
        return self.make_literal(c, at, false);
    }

    // --- Escapes ----------------------------------------------------------
    //
    // Called with the backslash already consumed.  Escapes fall into four
    // families: shorthand classes, anchors, backreferences and single
    // character substitutions.

    fn lex_escape(ref self, at: int) -> Token {
        if (self.at_end()) {
            self.fail(ERROR_TRAILING_BACKSLASH);
            return self.make_token(TokenKind.Invalid, at);
        }
        let c = self.advance();
        if (c == CHAR_LOWER_D) {
            return self.make_shorthand(Shorthand.ShortDigit, at);
        }
        if (c == CHAR_UPPER_D) {
            return self.make_shorthand(Shorthand.ShortNotDigit, at);
        }
        if (c == CHAR_LOWER_W) {
            return self.make_shorthand(Shorthand.ShortWord, at);
        }
        if (c == CHAR_UPPER_W) {
            return self.make_shorthand(Shorthand.ShortNotWord, at);
        }
        if (c == CHAR_LOWER_S) {
            return self.make_shorthand(Shorthand.ShortSpace, at);
        }
        if (c == CHAR_UPPER_S) {
            return self.make_shorthand(Shorthand.ShortNotSpace, at);
        }
        if (c == CHAR_LOWER_H) {
            return self.make_shorthand(Shorthand.ShortHorizontal, at);
        }
        if (c == CHAR_LOWER_V) {
            return self.make_shorthand(Shorthand.ShortVertical, at);
        }
        if (c == CHAR_LOWER_B) {
            return self.make_token(TokenKind.WordBoundary, at);
        }
        if (c == CHAR_UPPER_B) {
            return self.make_token(TokenKind.NotWordBoundary, at);
        }
        if (c == CHAR_UPPER_A) {
            return self.make_token(TokenKind.TextStartAnchor, at);
        }
        if (c == CHAR_LOWER_Z) {
            return self.make_token(TokenKind.TextEndAnchor, at);
        }
        if (c == CHAR_LOWER_K) {
            return self.lex_named_backreference(at);
        }
        if (is_digit(c) and c != CHAR_ZERO) {
            return self.lex_numeric_backreference(c, at);
        }
        if (c == CHAR_LOWER_X) {
            return self.lex_hex_escape(at);
        }
        return self.make_literal(decode_escape(c), at, true);
    }

    // \k<name> refers to a named group.  The name is stored on the token and
    // resolved to an index by the parser, which owns the name table.
    fn lex_named_backreference(ref self, at: int) -> Token {
        var t = self.make_token(TokenKind.Backreference, at);
        if (not self.accept(CHAR_LESS)) {
            self.fail(ERROR_BAD_BACKREF);
            return self.make_token(TokenKind.Invalid, at);
        }
        var name = TEXT_EMPTY;
        while (not self.at_end()) {
            let c = self.peek();
            if (c == CHAR_GREATER) {
                break;
            }
            if (not is_word_char(c)) {
                self.fail(ERROR_BAD_BACKREF);
                return self.make_token(TokenKind.Invalid, at);
            }
            name.push_back(c);
            self.pos += 1;
        }
        if (not self.accept(CHAR_GREATER)) {
            self.fail(ERROR_BAD_BACKREF);
            return self.make_token(TokenKind.Invalid, at);
        }
        if (name.empty()) {
            self.fail(ERROR_BAD_BACKREF);
            return self.make_token(TokenKind.Invalid, at);
        }
        t.text = name;
        t.lower = NONE;
        return t;
    }

    // \1 .. \9, and multi-digit forms such as \12 when that many groups are
    // plausible.  The parser rejects references past the group count.
    fn lex_numeric_backreference(ref self, first: char, at: int) -> Token {
        var value = digit_value(first);
        while (not self.at_end()) {
            let c = self.peek();
            if (not is_digit(c)) {
                break;
            }
            let next = value * 10 + digit_value(c);
            if (next >= MAX_CAPTURES) {
                break;
            }
            value = next;
            self.pos += 1;
        }
        var t = self.make_token(TokenKind.Backreference, at);
        t.lower = value;
        return t;
    }

    // \xNN.  Exactly two hexadecimal digits; anything else is an error rather
    // than a silent fallback, because a typo there is almost never intended.
    fn lex_hex_escape(ref self, at: int) -> Token {
        if (self.remaining() < 2) {
            self.fail(ERROR_BAD_ESCAPE);
            return self.make_token(TokenKind.Invalid, at);
        }
        let high = self.advance();
        let low = self.advance();
        if (not is_hex_digit(high)) {
            self.fail(ERROR_BAD_ESCAPE);
            return self.make_token(TokenKind.Invalid, at);
        }
        if (not is_hex_digit(low)) {
            self.fail(ERROR_BAD_ESCAPE);
            return self.make_token(TokenKind.Invalid, at);
        }
        let code = hex_value(high) * 16 + hex_value(low);
        return self.make_literal(code_char(code), at, true);
    }

    // --- Group openings ---------------------------------------------------

    fn lex_group_open(ref self, at: int) -> Token {
        var t = self.make_token(TokenKind.GroupOpen, at);
        if (self.peek() != CHAR_QUESTION) {
            t.group_kind = GroupKind.Capturing;
            return t;
        }
        self.pos += 1;
        let c = self.advance();
        if (c == CHAR_COLON) {
            t.group_kind = GroupKind.NonCapturing;
            return t;
        }
        if (c == CHAR_GREATER) {
            t.group_kind = GroupKind.Atomic;
            return t;
        }
        if (c == CHAR_LESS) {
            var name = TEXT_EMPTY;
            while (not self.at_end()) {
                let n = self.peek();
                if (n == CHAR_GREATER) {
                    break;
                }
                if (not is_word_char(n)) {
                    self.fail(ERROR_BAD_GROUP);
                    return self.make_token(TokenKind.Invalid, at);
                }
                name.push_back(n);
                self.pos += 1;
            }
            if (not self.accept(CHAR_GREATER)) {
                self.fail(ERROR_BAD_GROUP);
                return self.make_token(TokenKind.Invalid, at);
            }
            if (name.empty()) {
                self.fail(ERROR_BAD_GROUP);
                return self.make_token(TokenKind.Invalid, at);
            }
            t.group_kind = GroupKind.Named;
            t.text = name;
            return t;
        }
        self.fail(ERROR_BAD_GROUP);
        return self.make_token(TokenKind.Invalid, at);
    }

    // --- Repetition bounds ------------------------------------------------
    //
    // Called with the `{` consumed.  A brace that does not open a well formed
    // bound is treated as a literal brace, which is what every practical
    // engine does; only a bound that parses but is out of range is an error.

    fn lex_repeat_bound(ref self, at: int) -> Token {
        let save = self.pos;
        if (not is_digit(self.peek())) {
            self.pos = save;
            return self.make_literal(CHAR_LBRACE, at, false);
        }
        var lower: int = 0;
        var digits: int = 0;
        while (is_digit(self.peek())) {
            lower = lower * 10 + digit_value(self.peek());
            digits += 1;
            self.pos += 1;
            if (lower > MAX_REPEAT) {
                self.fail(ERROR_REPEAT_TOO_LARGE);
                return self.make_token(TokenKind.Invalid, at);
            }
        }
        var t = self.make_token(TokenKind.RepeatOpen, at);
        t.lower = lower;
        if (self.accept(CHAR_RBRACE)) {
            t.upper = lower;
            return t;
        }
        if (not self.accept(CHAR_COMMA)) {
            self.pos = save;
            return self.make_literal(CHAR_LBRACE, at, false);
        }
        if (self.accept(CHAR_RBRACE)) {
            // `{n,}` is an open ended bound.
            t.upper = NONE;
            return t;
        }
        if (not is_digit(self.peek())) {
            self.pos = save;
            return self.make_literal(CHAR_LBRACE, at, false);
        }
        var upper: int = 0;
        while (is_digit(self.peek())) {
            upper = upper * 10 + digit_value(self.peek());
            self.pos += 1;
            if (upper > MAX_REPEAT) {
                self.fail(ERROR_REPEAT_TOO_LARGE);
                return self.make_token(TokenKind.Invalid, at);
            }
        }
        if (not self.accept(CHAR_RBRACE)) {
            self.pos = save;
            return self.make_literal(CHAR_LBRACE, at, false);
        }
        if (upper < lower) {
            self.fail(ERROR_BAD_REPEAT);
            return self.make_token(TokenKind.Invalid, at);
        }
        t.upper = upper;
        return t;
    }

    var source: string;
    var tokens: vector(Token);
    var pos: int = 0;
    var error: string;
    var error_position: int = 0;
    var ok: bool = true;
}

// Single character escapes that stand for a control character.  Anything not
// listed keeps its own value, so `\+` is a plus and `\/` is a slash.
fn decode_escape(marker: char) -> char {
    if (marker == CHAR_LOWER_N) {
        return CHAR_NEWLINE;
    }
    if (marker == CHAR_LOWER_T) {
        return CHAR_TAB;
    }
    if (marker == CHAR_LOWER_R) {
        return CHAR_RETURN;
    }
    if (marker == CHAR_LOWER_F) {
        return CHAR_FORMFEED;
    }
    if (marker == CHAR_ZERO) {
        return CHAR_NUL;
    }
    if (marker == CHAR_LOWER_E) {
        return code_char(27);
    }
    return marker;
}

// The inverse mapping, used when a pattern is printed back out.
fn escape_spelling(c: char) -> string {
    if (c == CHAR_NEWLINE) {
        return ESCAPE_NEWLINE;
    }
    if (c == CHAR_TAB) {
        return ESCAPE_TAB;
    }
    if (c == CHAR_RETURN) {
        return ESCAPE_RETURN;
    }
    if (c == CHAR_FORMFEED) {
        return ESCAPE_FORMFEED;
    }
    if (c == CHAR_BACKSLASH) {
        return ESCAPE_BACKSLASH;
    }
    var out = TEXT_EMPTY;
    if (is_metacharacter(c)) {
        out.push_back(CHAR_BACKSLASH);
    }
    out.push_back(c);
    return out;
}

// --- Character classes ---------------------------------------------------
//
// A class is stored as a sorted list of inclusive code ranges plus a negation
// flag.  Ranges are kept normalised - sorted by low bound, non-overlapping and
// non-adjacent - which makes membership a short scan and lets the optimiser
// merge two classes by concatenating and re-normalising.

class ClassRange {

    fn contains(self, code: int) -> bool {
        if (code < self.low) {
            return false;
        }
        if (code > self.high) {
            return false;
        }
        return true;
    }

    fn width(self) -> int {
        return self.high - self.low + 1;
    }

    fn is_single(self) -> bool {
        return self.low == self.high;
    }

    // Two ranges may be fused when they overlap or merely touch.
    fn touches(self, other: ClassRange) -> bool {
        if (other.low > self.high + 1) {
            return false;
        }
        if (self.low > other.high + 1) {
            return false;
        }
        return true;
    }

    fn fuse(ref self, other: ClassRange) {
        if (other.low < self.low) {
            self.low = other.low;
        }
        if (other.high > self.high) {
            self.high = other.high;
        }
    }

    var low: int = 0;
    var high: int = 0;
}

fn make_range(low: int, high: int) -> ClassRange {
    var r = ClassRange({.low = low, .high = high});
    if (high < low) {
        r.low = high;
        r.high = low;
    }
    return r;
}

fn single_range(c: char) -> ClassRange {
    let code = char_code(c);
    return make_range(code, code);
}

class CharClass {

    fn empty(self) -> bool {
        return self.ranges.empty();
    }

    fn range_count(self) -> int {
        return self.ranges.size();
    }

    fn add_range(ref self, low: int, high: int) {
        self.ranges.push_back(make_range(low, high));
        self.normalised = false;
    }

    fn add_char(ref self, c: char) {
        let code = char_code(c);
        self.add_range(code, code);
    }

    fn add_char_range(ref self, low: char, high: char) {
        self.add_range(char_code(low), char_code(high));
    }

    // Pull every range of `other` in.  Used both by the class parser, when it
    // expands a shorthand inside brackets, and by the optimiser when it merges
    // sibling classes under an alternation.
    fn add_class(ref self, other: CharClass) {
        for (r in other.ranges) {
            self.add_range(r.low, r.high);
        }
        self.normalised = false;
    }

    fn negate(ref self) {
        self.negated = not self.negated;
    }

    // Insertion sort over the range list.  Classes are tiny - a dozen ranges
    // at the very worst - so the quadratic bound never matters and the code
    // stays obvious.
    fn sort_ranges(ref self) {
        var i: int = 1;
        while (i < self.ranges.size()) {
            var j = i;
            while (j > 0) {
                let ref left: auto = self.ranges[j - 1];
                let ref right: auto = self.ranges[j];
                if (left.low <= right.low) {
                    break;
                }
                swap(self.ranges[j - 1], self.ranges[j]);
                j -= 1;
            }
            i += 1;
        }
    }

    // Sort, then fuse every pair that touches.  Afterwards the list is a
    // canonical description of the set, so two classes are equal exactly when
    // their range lists are.
    fn normalise(ref self) {
        if (self.normalised) {
            return;
        }
        if (self.ranges.empty()) {
            self.normalised = true;
            return;
        }
        self.sort_ranges();
        var merged = vector(ClassRange)();
        merged.push_back(self.ranges[0]);
        var i: int = 1;
        while (i < self.ranges.size()) {
            let ref next: auto = self.ranges[i];
            let ref last: auto = merged.back();
            if (last.touches(next)) {
                last.fuse(next);
            } else {
                merged.push_back(next);
            }
            i += 1;
        }
        self.ranges = move(merged);
        self.normalised = true;
    }

    fn contains_code(self, code: int) -> bool {
        var found = false;
        for (r in self.ranges) {
            if (r.contains(code)) {
                found = true;
                break;
            }
        }
        if (self.negated) {
            return not found;
        }
        return found;
    }

    fn matches(self, c: char) -> bool {
        return self.contains_code(char_code(c));
    }

    // Case-insensitive membership: try the character as written and then its
    // opposite case.  Folding the class itself would be faster but would lose
    // the original spelling, which the printer wants.
    fn matches_folded(self, c: char) -> bool {
        if (self.matches(c)) {
            return true;
        }
        if (is_lower(c)) {
            return self.matches(to_upper(c));
        }
        if (is_upper(c)) {
            return self.matches(to_lower(c));
        }
        return false;
    }

    // How many distinct codes the class accepts.  The optimiser uses this to
    // decide whether a class is worth turning into a single-character test.
    fn cardinality(self) -> int {
        var total: int = 0;
        for (r in self.ranges) {
            total += r.width();
        }
        if (self.negated) {
            return ALPHABET_SIZE - total;
        }
        return total;
    }

    fn is_single_char(self) -> bool {
        if (self.negated) {
            return false;
        }
        if (self.ranges.size() != 1) {
            return false;
        }
        let ref only: auto = self.ranges[0];
        return only.is_single();
    }

    fn single_char(self) -> char {
        let ref only: auto = self.ranges[0];
        return code_char(only.low);
    }

    fn equals(self, other: CharClass) -> bool {
        if (self.negated != other.negated) {
            return false;
        }
        if (self.ranges.size() != other.ranges.size()) {
            return false;
        }
        var i: int = 0;
        while (i < self.ranges.size()) {
            let ref a: auto = self.ranges[i];
            let ref b: auto = other.ranges[i];
            if (a.low != b.low) {
                return false;
            }
            if (a.high != b.high) {
                return false;
            }
            i += 1;
        }
        return true;
    }

    // Render the class back into bracket notation.
    fn spell(self) -> string {
        var out = TEXT_LBRACKET;
        if (self.negated) {
            out.push_back(CHAR_CARET);
        }
        for (r in self.ranges) {
            out.append(escape_spelling(code_char(r.low)));
            if (not r.is_single()) {
                out.push_back(CHAR_MINUS);
                out.append(escape_spelling(code_char(r.high)));
            }
        }
        out.append(TEXT_RBRACKET);
        return out;
    }

    var ranges: vector(ClassRange);
    var negated: bool = false;
    var normalised: bool = true;
}

// --- Shorthand and POSIX class tables ------------------------------------
//
// Both families are built from the same primitive: fill a class with ranges
// and optionally flip its negation flag.

fn class_of_digits() -> CharClass {
    var c = CharClass();
    c.add_char_range(CHAR_ZERO, CHAR_NINE);
    return c;
}

fn class_of_word() -> CharClass {
    var c = CharClass();
    c.add_char_range(CHAR_LOWER_A, CHAR_LOWER_Z);
    c.add_char_range(CHAR_UPPER_A, CHAR_UPPER_Z);
    c.add_char_range(CHAR_ZERO, CHAR_NINE);
    c.add_char(CHAR_UNDERSCORE);
    return c;
}

fn class_of_space() -> CharClass {
    var c = CharClass();
    c.add_char(CHAR_SPACE);
    c.add_char(CHAR_TAB);
    c.add_char(CHAR_NEWLINE);
    c.add_char(CHAR_RETURN);
    c.add_char(CHAR_FORMFEED);
    c.add_char(code_char(11));
    return c;
}

fn class_of_horizontal() -> CharClass {
    var c = CharClass();
    c.add_char(CHAR_SPACE);
    c.add_char(CHAR_TAB);
    return c;
}

fn class_of_vertical() -> CharClass {
    var c = CharClass();
    c.add_char(CHAR_NEWLINE);
    c.add_char(CHAR_RETURN);
    c.add_char(CHAR_FORMFEED);
    c.add_char(code_char(11));
    return c;
}

fn class_of_alpha() -> CharClass {
    var c = CharClass();
    c.add_char_range(CHAR_LOWER_A, CHAR_LOWER_Z);
    c.add_char_range(CHAR_UPPER_A, CHAR_UPPER_Z);
    return c;
}

fn class_of_alnum() -> CharClass {
    var c = class_of_alpha();
    c.add_char_range(CHAR_ZERO, CHAR_NINE);
    return c;
}

fn class_of_upper() -> CharClass {
    var c = CharClass();
    c.add_char_range(CHAR_UPPER_A, CHAR_UPPER_Z);
    return c;
}

fn class_of_lower() -> CharClass {
    var c = CharClass();
    c.add_char_range(CHAR_LOWER_A, CHAR_LOWER_Z);
    return c;
}

fn class_of_xdigit() -> CharClass {
    var c = class_of_digits();
    c.add_char_range(CHAR_LOWER_A, CHAR_LOWER_F);
    c.add_char_range(CHAR_UPPER_A, CHAR_UPPER_F);
    return c;
}

fn class_of_punct() -> CharClass {
    var c = CharClass();
    c.add_range(33, 47);
    c.add_range(58, 64);
    c.add_range(91, 96);
    c.add_range(123, 126);
    return c;
}

fn class_of_print() -> CharClass {
    var c = CharClass();
    c.add_range(32, 126);
    return c;
}

fn class_of_graph() -> CharClass {
    var c = CharClass();
    c.add_range(33, 126);
    return c;
}

fn class_of_cntrl() -> CharClass {
    var c = CharClass();
    c.add_range(0, 31);
    c.add_range(127, 127);
    return c;
}

fn class_of_any(dot_matches_newline: bool) -> CharClass {
    var c = CharClass();
    if (dot_matches_newline) {
        c.add_range(CODE_MIN, CODE_MAX);
        return c;
    }
    c.add_char(CHAR_NEWLINE);
    c.negate();
    return c;
}

// Expand `\d`, `\W` and friends.  Negated shorthands are the positive class
// with the flag flipped, which keeps the two spellings in step.
fn class_of_shorthand(which: Shorthand) -> CharClass {
    if (which == Shorthand.ShortDigit) {
        return class_of_digits();
    }
    if (which == Shorthand.ShortNotDigit) {
        var c = class_of_digits();
        c.negate();
        return c;
    }
    if (which == Shorthand.ShortWord) {
        return class_of_word();
    }
    if (which == Shorthand.ShortNotWord) {
        var c = class_of_word();
        c.negate();
        return c;
    }
    if (which == Shorthand.ShortSpace) {
        return class_of_space();
    }
    if (which == Shorthand.ShortNotSpace) {
        var c = class_of_space();
        c.negate();
        return c;
    }
    if (which == Shorthand.ShortHorizontal) {
        return class_of_horizontal();
    }
    if (which == Shorthand.ShortVertical) {
        return class_of_vertical();
    }
    return CharClass();
}

// `[[:name:]]`.  `found` is set to false when the name is not one of the
// thirteen POSIX classes, and the caller raises ERROR_UNKNOWN_CLASS.
fn class_of_posix_name(name: string, ref found: bool) -> CharClass {
    found = true;
    if (name.compare(POSIX_ALPHA) == 0) {
        return class_of_alpha();
    }
    if (name.compare(POSIX_DIGIT) == 0) {
        return class_of_digits();
    }
    if (name.compare(POSIX_ALNUM) == 0) {
        return class_of_alnum();
    }
    if (name.compare(POSIX_UPPER) == 0) {
        return class_of_upper();
    }
    if (name.compare(POSIX_LOWER) == 0) {
        return class_of_lower();
    }
    if (name.compare(POSIX_SPACE) == 0) {
        return class_of_space();
    }
    if (name.compare(POSIX_BLANK) == 0) {
        return class_of_horizontal();
    }
    if (name.compare(POSIX_PUNCT) == 0) {
        return class_of_punct();
    }
    if (name.compare(POSIX_PRINT) == 0) {
        return class_of_print();
    }
    if (name.compare(POSIX_GRAPH) == 0) {
        return class_of_graph();
    }
    if (name.compare(POSIX_CNTRL) == 0) {
        return class_of_cntrl();
    }
    if (name.compare(POSIX_XDIGIT) == 0) {
        return class_of_xdigit();
    }
    if (name.compare(POSIX_WORD) == 0) {
        return class_of_word();
    }
    found = false;
    return CharClass();
}

// --- Abstract syntax tree ------------------------------------------------
//
// Nodes live in a flat arena on the parser and refer to each other by index.
// A node keeps at most two direct children plus a list, which covers every
// shape the grammar can produce: concatenation and alternation use the list,
// repetition uses `first`, and the leaves use neither.

choice NodeKind {
    NodeEmpty,          // matches the empty string
    NodeLiteral,        // one character
    NodeString,         // a run of characters, produced by the optimiser
    NodeAny,            // .
    NodeClass,          // [...] or a shorthand
    NodeConcat,         // e1 e2 ...
    NodeAlternate,      // e1 | e2 | ...
    NodeRepeat,         // e{lower,upper}
    NodeGroup,          // ( e )
    NodeAnchor,         // ^ $ \u{08} \B \A \z
    NodeBackreference,  // \1 or \k<name>
    NodeInvalid,
}

choice AnchorKind {
    AnchorLineStart,
    AnchorLineEnd,
    AnchorTextStart,
    AnchorTextEnd,
    AnchorWordBoundary,
    AnchorNotWordBoundary,
}

// Whether a quantifier prefers to consume or to stop.
choice Greediness {
    Greedy,
    Lazy,
    Possessive,
}

class Node {

    fn is_leaf(self) -> bool {
        if (self.kind == NodeKind.NodeLiteral) {
            return true;
        }
        if (self.kind == NodeKind.NodeString) {
            return true;
        }
        if (self.kind == NodeKind.NodeAny) {
            return true;
        }
        if (self.kind == NodeKind.NodeClass) {
            return true;
        }
        if (self.kind == NodeKind.NodeAnchor) {
            return true;
        }
        if (self.kind == NodeKind.NodeBackreference) {
            return true;
        }
        if (self.kind == NodeKind.NodeEmpty) {
            return true;
        }
        return false;
    }

    fn has_children(self) -> bool {
        if (not self.children.empty()) {
            return true;
        }
        return self.first != NONE;
    }

    fn child_count(self) -> int {
        if (self.first != NONE) {
            return 1;
        }
        return self.children.size();
    }

    // An anchor consumes nothing, and neither does an empty node or a
    // repetition whose lower bound is zero.
    fn is_zero_width(self) -> bool {
        if (self.kind == NodeKind.NodeAnchor) {
            return true;
        }
        if (self.kind == NodeKind.NodeEmpty) {
            return true;
        }
        return false;
    }

    fn is_unbounded(self) -> bool {
        return self.upper == NONE;
    }

    fn is_optional(self) -> bool {
        return self.lower == 0;
    }

    var kind: NodeKind = NodeKind.NodeInvalid;
    var value: char = '\0';
    var text: string;
    var charclass: CharClass;
    var anchor: AnchorKind = AnchorKind.AnchorLineStart;
    var greed: Greediness = Greediness.Greedy;
    var group_kind: GroupKind = GroupKind.Capturing;
    var group_index: int = -1;
    var reference: int = -1;
    var lower: int = 0;
    var upper: int = -1;
    var first: int = -1;
    var children: vector(int);
    var position: int = 0;
}

// --- Recursive descent pattern parser ------------------------------------
//
// The grammar the parser implements, in the order the functions appear:
//
//     alternation   := concatenation ( '|' concatenation )*
//     concatenation := quantified*
//     quantified    := atom quantifier*
//     quantifier    := ( '*' | '+' | '?' | '{' bound '}' ) '?'?
//     atom          := literal | '.' | class | group | shorthand
//                    | anchor | backreference
//     group         := '(' alternation ')'
//
// `parse_alternation` and `parse_atom` are mutually recursive through
// `parse_group`, which is what gives the parser its depth; `depth` is tracked
// explicitly so a pattern of ten thousand nested groups fails cleanly rather
// than exhausting the native stack.
//
// Bracket expressions are not tokenised in advance.  When the token stream
// offers a ClassOpen the parser drops to character mode over the original
// source text, parses the bracket expression there, and then resynchronises
// the token index to the offset it stopped at.  Bracket expressions have
// their own rules for `-`, `^` and `]`, and running them through the outer
// lexer would mean undoing half of its work.

class GroupName {
    var name: string;
    var index: int = 0;
}

class PatternParser {

    // --- Token stream helpers ---------------------------------------------

    fn token_count(self) -> int {
        return self.tokens.size();
    }

    fn at_end(self) -> bool {
        if (self.index >= self.tokens.size()) {
            return true;
        }
        let ref t: auto = self.tokens[self.index];
        return t.is_end();
    }

    fn current(ref self) -> ref Token {
        return self.tokens[self.index];
    }

    fn current_kind(self) -> TokenKind {
        if (self.index >= self.tokens.size()) {
            return TokenKind.EndOfPattern;
        }
        let ref t: auto = self.tokens[self.index];
        return t.kind;
    }

    fn peek_kind(self, offset: int) -> TokenKind {
        let at = self.index + offset;
        if (at >= self.tokens.size()) {
            return TokenKind.EndOfPattern;
        }
        let ref t: auto = self.tokens[at];
        return t.kind;
    }

    fn current_offset(self) -> int {
        if (self.index >= self.tokens.size()) {
            return self.source.size();
        }
        let ref t: auto = self.tokens[self.index];
        return t.position;
    }

    fn step(ref self) {
        if (self.index < self.tokens.size()) {
            self.index += 1;
        }
    }

    fn accept_kind(ref self, kind: TokenKind) -> bool {
        if (self.current_kind() != kind) {
            return false;
        }
        self.step();
        return true;
    }

    // Skip forward until the token stream is positioned at or after `offset`.
    // Called after the character-mode class parser has consumed a stretch of
    // the source that the lexer had already turned into tokens.
    fn sync_to_offset(ref self, offset: int) {
        while (self.index < self.tokens.size()) {
            let ref t: auto = self.tokens[self.index];
            if (t.position >= offset) {
                break;
            }
            if (t.is_end()) {
                break;
            }
            self.index += 1;
        }
    }

    fn fail(ref self, message: string) -> int {
        if (self.ok) {
            self.ok = false;
            self.error = message;
            self.error_position = self.current_offset();
        }
        return NONE;
    }

    // --- Arena ------------------------------------------------------------

    fn node_count(self) -> int {
        return self.nodes.size();
    }

    fn node_at(ref self, index: int) -> ref Node {
        return self.nodes[index];
    }

    fn new_node(ref self, kind: NodeKind) -> int {
        let index = self.nodes.size();
        var n = Node({.kind = kind});
        n.position = self.current_offset();
        self.nodes.push_back(n);
        return index;
    }

    fn new_literal(ref self, c: char) -> int {
        let index = self.new_node(NodeKind.NodeLiteral);
        let ref n: auto = self.nodes[index];
        n.value = c;
        n.charclass.add_char(c);
        return index;
    }

    fn new_class(ref self, cls: CharClass) -> int {
        let index = self.new_node(NodeKind.NodeClass);
        let ref n: auto = self.nodes[index];
        n.charclass = cls;
        n.charclass.normalise();
        return index;
    }

    fn new_anchor(ref self, which: AnchorKind) -> int {
        let index = self.new_node(NodeKind.NodeAnchor);
        let ref n: auto = self.nodes[index];
        n.anchor = which;
        return index;
    }

    // --- Group name table -------------------------------------------------

    fn find_group_named(self, name: string) -> int {
        for (entry in self.names) {
            if (entry.name.compare(name) == 0) {
                return entry.index;
            }
        }
        return NONE;
    }

    fn register_group_name(ref self, name: string, index: int) {
        var entry = GroupName({.index = index});
        entry.name = name;
        self.names.push_back(entry);
    }

    // --- Entry point ------------------------------------------------------

    fn parse(ref self, pattern: string) -> int {
        self.source = pattern;
        self.nodes.clear();
        self.names.clear();
        self.index = 0;
        self.depth = 0;
        self.group_count = 0;
        self.ok = true;
        self.error = ERROR_NONE;

        var lexer = PatternLexer();
        lexer.source = pattern;
        if (not lexer.tokenize()) {
            self.ok = false;
            self.error = lexer.error;
            self.error_position = lexer.error_position;
            return NONE;
        }
        self.tokens = move(lexer.tokens);

        let root = self.parse_alternation();
        if (not self.ok) {
            return NONE;
        }
        if (not self.at_end()) {
            // The only way to stop early with tokens left is a `)` with no
            // matching `(`, because every other token starts an atom.
            return self.fail(ERROR_UNBALANCED_PAREN);
        }
        self.root = root;
        return root;
    }

    // --- alternation := concatenation ( '|' concatenation )* --------------

    fn parse_alternation(ref self) -> int {
        let first = self.parse_concatenation();
        if (not self.ok) {
            return NONE;
        }
        if (self.current_kind() != TokenKind.AlternationBar) {
            return first;
        }
        let index = self.new_node(NodeKind.NodeAlternate);
        var branches = vector(int)();
        branches.push_back(first);
        while (self.accept_kind(TokenKind.AlternationBar)) {
            let branch = self.parse_concatenation();
            if (not self.ok) {
                return NONE;
            }
            branches.push_back(branch);
        }
        let ref n: auto = self.nodes[index];
        n.children = move(branches);
        return index;
    }

    // --- concatenation := quantified* -------------------------------------
    //
    // Stops at `|`, at `)` and at the end of the token stream.  An empty
    // concatenation is legal - it is how `(|a)` and `a||b` get their empty
    // branches - and yields a NodeEmpty.

    fn parse_concatenation(ref self) -> int {
        var items = vector(int)();
        while (true) {
            if (self.at_end()) {
                break;
            }
            if (self.current_kind() == TokenKind.AlternationBar) {
                break;
            }
            if (self.current_kind() == TokenKind.GroupClose) {
                break;
            }
            let item = self.parse_quantified();
            if (not self.ok) {
                return NONE;
            }
            if (item == NONE) {
                break;
            }
            items.push_back(item);
        }
        if (items.empty()) {
            return self.new_node(NodeKind.NodeEmpty);
        }
        if (items.size() == 1) {
            return items[0];
        }
        let index = self.new_node(NodeKind.NodeConcat);
        let ref n: auto = self.nodes[index];
        n.children = move(items);
        return index;
    }

    // --- quantified := atom quantifier* -----------------------------------
    //
    // Quantifiers are applied left to right, so `a*+` is `(a*)+`.  Each one
    // wraps the node produced so far in a fresh NodeRepeat.

    fn parse_quantified(ref self) -> int {
        var atom = self.parse_atom();
        if (not self.ok) {
            return NONE;
        }
        if (atom == NONE) {
            return NONE;
        }
        while (true) {
            let ref t: auto = self.tokens[self.index];
            if (not t.is_quantifier()) {
                break;
            }
            let ref inner: auto = self.nodes[atom];
            if (inner.kind == NodeKind.NodeAnchor) {
                // `^*` is meaningless and almost always a typo.
                return self.fail(ERROR_NOTHING_TO_REPEAT);
            }
            atom = self.parse_quantifier(atom);
            if (not self.ok) {
                return NONE;
            }
        }
        return atom;
    }

    // Consume one quantifier token and wrap `target` in the repetition it
    // describes.  A trailing `?` makes the repetition lazy; a trailing `+`
    // makes it possessive, which the backtracking matcher honours by
    // discarding the alternatives it would otherwise keep.
    fn parse_quantifier(ref self, target: int) -> int {
        let kind = self.current_kind();
        var lower: int = 0;
        var upper: int = NONE;
        if (kind == TokenKind.Star) {
            lower = 0;
            upper = NONE;
        } else {
            if (kind == TokenKind.Plus) {
                lower = 1;
                upper = NONE;
            } else {
                if (kind == TokenKind.Question) {
                    lower = 0;
                    upper = 1;
                } else {
                    let ref t: auto = self.tokens[self.index];
                    lower = t.lower;
                    upper = t.upper;
                    if (upper != NONE and upper < lower) {
                        return self.fail(ERROR_BAD_REPEAT);
                    }
                    if (lower > MAX_REPEAT) {
                        return self.fail(ERROR_REPEAT_TOO_LARGE);
                    }
                }
            }
        }
        self.step();
        var greed = Greediness.Greedy;
        if (self.current_kind() == TokenKind.Question) {
            greed = Greediness.Lazy;
            self.step();
        } else {
            if (self.current_kind() == TokenKind.Plus) {
                greed = Greediness.Possessive;
                self.step();
            }
        }
        let index = self.new_node(NodeKind.NodeRepeat);
        let ref n: auto = self.nodes[index];
        n.first = target;
        n.lower = lower;
        n.upper = upper;
        n.greed = greed;
        return index;
    }

    // --- atom -------------------------------------------------------------
    //
    // The dispatch point of the parser.  Every branch either produces a node
    // or reports an error; returning NONE without an error set means "this
    // token does not begin an atom", which only `)` can do.

    fn parse_atom(ref self) -> int {
        if (self.at_end()) {
            return NONE;
        }
        let kind = self.current_kind();
        if (kind == TokenKind.Literal) {
            let ref t: auto = self.tokens[self.index];
            let c = t.value;
            self.step();
            return self.new_literal(c);
        }
        if (kind == TokenKind.AnyChar) {
            self.step();
            let index = self.new_node(NodeKind.NodeAny);
            let ref n: auto = self.nodes[index];
            n.charclass = class_of_any(self.dot_matches_newline);
            return index;
        }
        if (kind == TokenKind.ShorthandClass) {
            let ref t: auto = self.tokens[self.index];
            let which = t.shorthand;
            self.step();
            return self.new_class(class_of_shorthand(which));
        }
        if (kind == TokenKind.ClassOpen) {
            return self.parse_class();
        }
        if (kind == TokenKind.GroupOpen) {
            return self.parse_group();
        }
        if (kind == TokenKind.Backreference) {
            return self.parse_backreference();
        }
        if (kind == TokenKind.CaretAnchor) {
            self.step();
            return self.new_anchor(AnchorKind.AnchorLineStart);
        }
        if (kind == TokenKind.DollarAnchor) {
            self.step();
            return self.new_anchor(AnchorKind.AnchorLineEnd);
        }
        if (kind == TokenKind.TextStartAnchor) {
            self.step();
            return self.new_anchor(AnchorKind.AnchorTextStart);
        }
        if (kind == TokenKind.TextEndAnchor) {
            self.step();
            return self.new_anchor(AnchorKind.AnchorTextEnd);
        }
        if (kind == TokenKind.WordBoundary) {
            self.step();
            return self.new_anchor(AnchorKind.AnchorWordBoundary);
        }
        if (kind == TokenKind.NotWordBoundary) {
            self.step();
            return self.new_anchor(AnchorKind.AnchorNotWordBoundary);
        }
        if (kind == TokenKind.Star) {
            return self.fail(ERROR_NOTHING_TO_REPEAT);
        }
        if (kind == TokenKind.Plus) {
            return self.fail(ERROR_NOTHING_TO_REPEAT);
        }
        if (kind == TokenKind.RepeatOpen) {
            return self.fail(ERROR_NOTHING_TO_REPEAT);
        }
        if (kind == TokenKind.Invalid) {
            return self.fail(ERROR_BAD_ESCAPE);
        }
        return NONE;
    }

    // --- group := '(' alternation ')' -------------------------------------
    //
    // The recursive step.  Capturing groups take the next free index before
    // their body is parsed, so `(a(b))` numbers the outer group 1 and the
    // inner group 2 - the order the spelling suggests.

    fn parse_group(ref self) -> int {
        let ref t: auto = self.tokens[self.index];
        let group_kind = t.group_kind;
        var name = t.text;
        self.step();
        self.depth += 1;
        if (self.depth > MAX_GROUP_DEPTH) {
            self.depth -= 1;
            return self.fail(ERROR_DEPTH_EXCEEDED);
        }
        var number = NONE;
        if (group_kind == GroupKind.Capturing) {
            self.group_count += 1;
            number = self.group_count;
        }
        if (group_kind == GroupKind.Named) {
            self.group_count += 1;
            number = self.group_count;
            self.register_group_name(name, number);
        }
        let body = self.parse_alternation();
        if (not self.ok) {
            self.depth -= 1;
            return NONE;
        }
        if (not self.accept_kind(TokenKind.GroupClose)) {
            self.depth -= 1;
            return self.fail(ERROR_UNBALANCED_PAREN);
        }
        self.depth -= 1;
        let index = self.new_node(NodeKind.NodeGroup);
        let ref n: auto = self.nodes[index];
        n.first = body;
        n.group_kind = group_kind;
        n.group_index = number;
        n.text = name;
        return index;
    }

    // --- backreference ----------------------------------------------------

    fn parse_backreference(ref self) -> int {
        let ref t: auto = self.tokens[self.index];
        var target = t.lower;
        if (target == NONE) {
            target = self.find_group_named(t.text);
            if (target == NONE) {
                return self.fail(ERROR_BAD_BACKREF);
            }
        }
        if (target > self.group_count) {
            // Forward references are rejected: a group can only be recalled
            // once it has been opened, and a group that is still open has no
            // captured text yet.
            return self.fail(ERROR_BAD_BACKREF);
        }
        self.step();
        let index = self.new_node(NodeKind.NodeBackreference);
        let ref n: auto = self.nodes[index];
        n.reference = target;
        return index;
    }

    // --- Bracket expressions ----------------------------------------------
    //
    // Character mode.  On entry the token stream sits on the ClassOpen token
    // and `offset` addresses the `[` itself in the source text.  The routine
    // walks the source directly and resynchronises the token index on the way
    // out.
    //
    // The rules a bracket expression obeys:
    //   * a leading `^` negates the whole class
    //   * a `]` in first position - after any `^` - is an ordinary character
    //   * `-` is a range operator except in first or last position
    //   * `[:name:]` names a POSIX class, but a bare `[` is just a bracket
    //   * a shorthand such as `\d` contributes all of its ranges

    fn parse_class(ref self) -> int {
        let open = self.current_offset();
        var at = open + 1;
        var cls = CharClass();
        if (at < self.source.size()) {
            if (self.source.at(at) == CHAR_CARET) {
                cls.negate();
                at += 1;
            }
        }
        var first = true;
        var closed = false;
        while (true) {
            if (at >= self.source.size()) {
                break;
            }
            let c = self.source.at(at);
            if (c == CHAR_RBRACKET and not first) {
                at += 1;
                closed = true;
                break;
            }
            first = false;
            if (c == CHAR_RBRACKET) {
                // Leading `]`: an ordinary member of the class.
                cls.add_char(c);
                at += 1;
                continue;
            }
            if (c == CHAR_LBRACKET and self.looks_like_posix(at)) {
                at = self.parse_posix_class(at, cls);
                if (not self.ok) {
                    return NONE;
                }
                continue;
            }
            if (c == CHAR_BACKSLASH) {
                at = self.parse_class_escape(at, cls);
                if (not self.ok) {
                    return NONE;
                }
                continue;
            }
            // An ordinary character.  It may be the low end of a range, which
            // is decided by what follows it.
            let low = c;
            at += 1;
            if (not self.class_range_follows(at)) {
                cls.add_char(low);
                continue;
            }
            // Step over the hyphen and read the upper bound.
            at += 1;
            let high_char = self.source.at(at);
            if (high_char == CHAR_BACKSLASH) {
                var scratch = CharClass();
                let after = self.parse_class_escape(at, scratch);
                if (not self.ok) {
                    return NONE;
                }
                if (not scratch.is_single_char()) {
                    // `a-\d` has no sensible reading; treat the three parts
                    // as separate members instead of guessing.
                    cls.add_char(low);
                    cls.add_char(CHAR_MINUS);
                    cls.add_class(scratch);
                    at = after;
                    continue;
                }
                let high = scratch.single_char();
                if (char_code(high) < char_code(low)) {
                    return self.fail(ERROR_BAD_RANGE);
                }
                cls.add_char_range(low, high);
                at = after;
                continue;
            }
            if (char_code(high_char) < char_code(low)) {
                return self.fail(ERROR_BAD_RANGE);
            }
            cls.add_char_range(low, high_char);
            at += 1;
        }
        if (not closed) {
            return self.fail(ERROR_UNCLOSED_CLASS);
        }
        self.sync_to_offset(at);
        cls.normalise();
        return self.new_class(cls);
    }

    // True when a `-` at `at` really is a range operator: it must exist, and
    // it must not be the last character before the closing bracket.
    fn class_range_follows(self, at: int) -> bool {
        if (at >= self.source.size()) {
            return false;
        }
        if (self.source.at(at) != CHAR_MINUS) {
            return false;
        }
        let next = at + 1;
        if (next >= self.source.size()) {
            return false;
        }
        if (self.source.at(next) == CHAR_RBRACKET) {
            return false;
        }
        return true;
    }

    // A `[` inside a class opens a POSIX name only when it is followed by a
    // colon and a closing `:]` appears before the class ends.
    fn looks_like_posix(self, at: int) -> bool {
        let colon = at + 1;
        if (colon >= self.source.size()) {
            return false;
        }
        if (self.source.at(colon) != CHAR_COLON) {
            return false;
        }
        var scan = colon + 1;
        if (scan < self.source.size()) {
            if (self.source.at(scan) == CHAR_CARET) {
                scan += 1;
            }
        }
        while (scan < self.source.size()) {
            let c = self.source.at(scan);
            if (c == CHAR_COLON) {
                let close = scan + 1;
                if (close >= self.source.size()) {
                    return false;
                }
                return self.source.at(close) == CHAR_RBRACKET;
            }
            if (not is_alpha(c)) {
                return false;
            }
            scan += 1;
        }
        return false;
    }

    // Consume `[:name:]` and add its ranges to `into`.  `[:^name:]` adds the
    // complement, which is spelled by expanding the class and inverting each
    // gap rather than by flipping the whole class - the surrounding class may
    // already carry a negation of its own.
    fn parse_posix_class(ref self, at: int, ref into: CharClass) -> int {
        var scan = at + 2;
        var complement = false;
        if (scan < self.source.size()) {
            if (self.source.at(scan) == CHAR_CARET) {
                complement = true;
                scan += 1;
            }
        }
        var name = TEXT_EMPTY;
        while (scan < self.source.size()) {
            let c = self.source.at(scan);
            if (c == CHAR_COLON) {
                break;
            }
            name.push_back(c);
            scan += 1;
        }
        // Step over the `:]` pair.
        scan += 2;
        var known = false;
        var expanded = class_of_posix_name(name, known);
        if (not known) {
            Discard(self.fail(ERROR_UNKNOWN_CLASS));
            return scan;
        }
        if (complement) {
            expanded.normalise();
            var inverted = complement_of(expanded);
            into.add_class(inverted);
            return scan;
        }
        into.add_class(expanded);
        return scan;
    }

    // Consume one `\x` sequence inside a bracket expression and add whatever
    // it denotes to `into`.  Shorthands contribute their ranges; everything
    // else contributes a single character.
    fn parse_class_escape(ref self, at: int, ref into: CharClass) -> int {
        let marker_at = at + 1;
        if (marker_at >= self.source.size()) {
            Discard(self.fail(ERROR_TRAILING_BACKSLASH));
            return self.source.size();
        }
        let marker = self.source.at(marker_at);
        if (marker == CHAR_LOWER_D) {
            into.add_class(class_of_digits());
            return marker_at + 1;
        }
        if (marker == CHAR_UPPER_D) {
            into.add_class(complement_of(class_of_digits()));
            return marker_at + 1;
        }
        if (marker == CHAR_LOWER_W) {
            into.add_class(class_of_word());
            return marker_at + 1;
        }
        if (marker == CHAR_UPPER_W) {
            into.add_class(complement_of(class_of_word()));
            return marker_at + 1;
        }
        if (marker == CHAR_LOWER_S) {
            into.add_class(class_of_space());
            return marker_at + 1;
        }
        if (marker == CHAR_UPPER_S) {
            into.add_class(complement_of(class_of_space()));
            return marker_at + 1;
        }
        if (marker == CHAR_LOWER_H) {
            into.add_class(class_of_horizontal());
            return marker_at + 1;
        }
        if (marker == CHAR_LOWER_V) {
            into.add_class(class_of_vertical());
            return marker_at + 1;
        }
        if (marker == CHAR_LOWER_X) {
            let high_at = marker_at + 1;
            let low_at = marker_at + 2;
            if (low_at >= self.source.size()) {
                Discard(self.fail(ERROR_BAD_ESCAPE));
                return self.source.size();
            }
            let high = self.source.at(high_at);
            let low = self.source.at(low_at);
            if (not is_hex_digit(high) or not is_hex_digit(low)) {
                Discard(self.fail(ERROR_BAD_ESCAPE));
                return low_at + 1;
            }
            into.add_range(hex_value(high) * 16 + hex_value(low), hex_value(high) * 16 + hex_value(low));
            return low_at + 1;
        }
        if (marker == CHAR_LOWER_B) {
            // `\u{08}` is a backspace inside a class, not a word boundary.
            into.add_char(CHAR_BACKSPACE);
            return marker_at + 1;
        }
        into.add_char(decode_escape(marker));
        return marker_at + 1;
    }

    var source: string;
    var tokens: vector(Token);
    var nodes: vector(Node);
    var names: vector(GroupName);
    var index: int = 0;
    var depth: int = 0;
    var group_count: int = 0;
    var root: int = -1;
    var error: string;
    var error_position: int = 0;
    var ok: bool = true;
    var dot_matches_newline: bool = false;
    var ignore_case: bool = false;
}

// Build the set complement of a normalised class as an explicit range list.
// Flipping the `negated` flag would be cheaper, but a complement built this
// way can be unioned with other classes, which the bracket parser needs.
fn complement_of(cls: CharClass) -> CharClass {
    var source = cls;
    source.normalise();
    var out = CharClass();
    var cursor = CODE_MIN;
    for (r in source.ranges) {
        if (r.low > cursor) {
            out.add_range(cursor, r.low - 1);
        }
        if (r.high + 1 > cursor) {
            cursor = r.high + 1;
        }
    }
    if (cursor <= CODE_MAX) {
        out.add_range(cursor, CODE_MAX);
    }
    out.normalise();
    return out;
}

// --- Thompson NFA construction -------------------------------------------
//
// Every AST node is turned into a fragment: a start state plus a list of
// dangling exits that the caller patches to whatever comes next.  The
// construction is the classical one, so the resulting automaton has at most
// two transitions out of any state and no more states than the pattern has
// characters.
//
// Backreferences have no NFA form - they are not regular - so the builder
// emits a Backref state that only the backtracking matcher understands.  A
// program containing one is marked `has_backreference` and the simulator
// refuses to run it.

choice StateKind {
    StateChar,          // consume one character from a class
    StateSplit,         // epsilon to both `out` and `alternate`
    StateJump,          // epsilon to `out`
    StateSave,          // record the current offset in capture slot `slot`
    StateAssert,        // zero width assertion
    StateBackref,       // re-match the text captured by a group
    StateMatch,     // accept
}

class NfaState {

    fn consumes(self) -> bool {
        return self.kind == StateKind.StateChar;
    }

    fn is_epsilon(self) -> bool {
        if (self.kind == StateKind.StateSplit) {
            return true;
        }
        if (self.kind == StateKind.StateJump) {
            return true;
        }
        if (self.kind == StateKind.StateSave) {
            return true;
        }
        if (self.kind == StateKind.StateAssert) {
            return true;
        }
        return false;
    }

    fn is_accepting(self) -> bool {
        return self.kind == StateKind.StateMatch;
    }

    fn accepts(self, c: char, folded: bool) -> bool {
        if (self.kind != StateKind.StateChar) {
            return false;
        }
        if (folded) {
            return self.charclass.matches_folded(c);
        }
        return self.charclass.matches(c);
    }

    var kind: StateKind = StateKind.StateJump;
    var charclass: CharClass;
    var anchor: AnchorKind = AnchorKind.AnchorLineStart;
    var slot: int = 0;
    var reference: int = 0;
    var out: int = -1;
    var alternate: int = -1;
}

// A dangling exit: state `state`, and which of its two out edges is unset.
class Patch {
    var state: int = 0;
    var second: bool = false;
}

// A partially built automaton.
class Fragment {

    fn valid(self) -> bool {
        return self.start != NONE;
    }

    fn exit_count(self) -> int {
        return self.exits.size();
    }

    fn absorb(ref self, other: Fragment) {
        for (p in other.exits) {
            self.exits.push_back(p);
        }
    }

    var start: int = -1;
    var exits: vector(Patch);
}

class NfaBuilder {

    fn state_count(self) -> int {
        return self.states.size();
    }

    fn new_state(ref self, kind: StateKind) -> int {
        let index = self.states.size();
        self.states.push_back(NfaState({.kind = kind}));
        return index;
    }

    // Point every exit of `frag` at `target`.
    fn patch(ref self, frag: Fragment, target: int) {
        for (p in frag.exits) {
            let ref s: auto = self.states[p.state];
            if (p.second) {
                s.alternate = target;
            } else {
                s.out = target;
            }
        }
    }

    fn single_exit(self, state: int, second: bool) -> Fragment {
        var frag = Fragment({.start = state});
        frag.exits.push_back(Patch({.state = state, .second = second}));
        return frag;
    }

    // --- Entry point ------------------------------------------------------

    fn build(ref self, ref parser: PatternParser, root: int) -> bool {
        self.states.clear();
        self.has_backreference = false;
        self.ok = true;
        let frag = self.build_node(parser, root);
        if (not self.ok) {
            return false;
        }
        let accept = self.new_state(StateKind.StateMatch);
        self.patch(frag, accept);
        self.start = frag.start;
        self.accept = accept;
        return true;
    }

    // --- The recursive core -----------------------------------------------

    fn build_node(ref self, ref parser: PatternParser, index: int) -> Fragment {
        if (index == NONE) {
            return self.build_empty();
        }
        let ref n: auto = parser.nodes[index];
        if (n.kind == NodeKind.NodeEmpty) {
            return self.build_empty();
        }
        if (n.kind == NodeKind.NodeLiteral) {
            return self.build_class(n.charclass);
        }
        if (n.kind == NodeKind.NodeAny) {
            return self.build_class(n.charclass);
        }
        if (n.kind == NodeKind.NodeClass) {
            return self.build_class(n.charclass);
        }
        if (n.kind == NodeKind.NodeString) {
            return self.build_string(n.text);
        }
        if (n.kind == NodeKind.NodeAnchor) {
            return self.build_anchor(n.anchor);
        }
        if (n.kind == NodeKind.NodeBackreference) {
            return self.build_backreference(n.reference);
        }
        if (n.kind == NodeKind.NodeConcat) {
            return self.build_concat(parser, index);
        }
        if (n.kind == NodeKind.NodeAlternate) {
            return self.build_alternate(parser, index);
        }
        if (n.kind == NodeKind.NodeRepeat) {
            return self.build_repeat(parser, index);
        }
        if (n.kind == NodeKind.NodeGroup) {
            return self.build_group(parser, index);
        }
        self.ok = false;
        return Fragment();
    }

    fn build_empty(ref self) -> Fragment {
        let s = self.new_state(StateKind.StateJump);
        return self.single_exit(s, false);
    }

    fn build_class(ref self, cls: CharClass) -> Fragment {
        let s = self.new_state(StateKind.StateChar);
        let ref state: auto = self.states[s];
        state.charclass = cls;
        state.charclass.normalise();
        return self.single_exit(s, false);
    }

    // A literal run compiles to a chain of single character states.  The
    // simulator has no special case for it, but the compiled program does.
    fn build_string(ref self, text: string) -> Fragment {
        if (text.empty()) {
            return self.build_empty();
        }
        var head = NONE;
        var previous = NONE;
        var i: int = 0;
        while (i < text.size()) {
            let s = self.new_state(StateKind.StateChar);
            let ref state: auto = self.states[s];
            state.charclass.add_char(text.at(i));
            if (head == NONE) {
                head = s;
            } else {
                let ref prior: auto = self.states[previous];
                prior.out = s;
            }
            previous = s;
            i += 1;
        }
        var frag = Fragment({.start = head});
        frag.exits.push_back(Patch({.state = previous, .second = false}));
        return frag;
    }

    fn build_anchor(ref self, which: AnchorKind) -> Fragment {
        let s = self.new_state(StateKind.StateAssert);
        let ref state: auto = self.states[s];
        state.anchor = which;
        return self.single_exit(s, false);
    }

    fn build_backreference(ref self, group: int) -> Fragment {
        self.has_backreference = true;
        let s = self.new_state(StateKind.StateBackref);
        let ref state: auto = self.states[s];
        state.reference = group;
        return self.single_exit(s, false);
    }

    // e1 e2 ... : chain the fragments, patching each one's exits to the next
    // fragment's start.  The exits of the last fragment become the exits of
    // the whole.
    fn build_concat(ref self, ref parser: PatternParser, index: int) -> Fragment {
        let ref n: auto = parser.nodes[index];
        var result = Fragment();
        var started = false;
        for (child in n.children) {
            let piece = self.build_node(parser, child);
            if (not self.ok) {
                return Fragment();
            }
            if (not started) {
                result = piece;
                started = true;
            } else {
                self.patch(result, piece.start);
                result.exits.clear();
                result.absorb(piece);
            }
        }
        if (not started) {
            return self.build_empty();
        }
        return result;
    }

    // e1 | e2 | ... : a chain of Split states, each preferring its left
    // branch.  The last branch takes the final split's alternate edge, so no
    // split is ever left with a dangling second edge.
    fn build_alternate(ref self, ref parser: PatternParser, index: int) -> Fragment {
        let ref n: auto = parser.nodes[index];
        var result = Fragment();
        var previous_split = NONE;
        var count: int = 0;
        let total = n.children.size();
        for (child in n.children) {
            let piece = self.build_node(parser, child);
            if (not self.ok) {
                return Fragment();
            }
            count += 1;
            if (count == total) {
                if (previous_split == NONE) {
                    return piece;
                }
                let ref split: auto = self.states[previous_split];
                split.alternate = piece.start;
                result.absorb(piece);
                return result;
            }
            let split = self.new_state(StateKind.StateSplit);
            let ref s: auto = self.states[split];
            s.out = piece.start;
            if (previous_split == NONE) {
                result.start = split;
            } else {
                let ref prior: auto = self.states[previous_split];
                prior.alternate = split;
            }
            result.absorb(piece);
            previous_split = split;
        }
        return result;
    }

    fn build_group(ref self, ref parser: PatternParser, index: int) -> Fragment {
        let ref n: auto = parser.nodes[index];
        let group = n.group_index;
        if (group == NONE) {
            return self.build_node(parser, n.first);
        }
        let open = self.new_state(StateKind.StateSave);
        let ref open_state: auto = self.states[open];
        open_state.slot = group * 2;
        let body = self.build_node(parser, n.first);
        if (not self.ok) {
            return Fragment();
        }
        open_state.out = body.start;
        let close = self.new_state(StateKind.StateSave);
        let ref close_state: auto = self.states[close];
        close_state.slot = group * 2 + 1;
        self.patch(body, close);
        return self.single_exit_from(open, close);
    }

    // Helper for fragments whose start and exit are different states.
    fn single_exit_from(self, start: int, exit: int) -> Fragment {
        var frag = Fragment({.start = start});
        frag.exits.push_back(Patch({.state = exit, .second = false}));
        return frag;
    }

    // --- Repetition -------------------------------------------------------
    //
    // `e{lower,upper}` is expanded into copies of `e`: `lower` mandatory ones
    // followed by either an unbounded star, when `upper` is NONE, or by
    // `upper - lower` optional ones.  Expansion keeps the automaton a plain
    // Thompson NFA with no counters, at the cost of size - which is why the
    // parser caps the bound at MAX_REPEAT.

    fn build_repeat(ref self, ref parser: PatternParser, index: int) -> Fragment {
        let ref n: auto = parser.nodes[index];
        let lower = n.lower;
        let upper = n.upper;
        let body = n.first;
        let lazy = n.greed == Greediness.Lazy;
        if (lower == 0 and upper == NONE) {
            return self.build_star(parser, body, lazy);
        }
        if (lower == 1 and upper == NONE) {
            return self.build_plus(parser, body, lazy);
        }
        if (lower == 0 and upper == 1) {
            return self.build_optional(parser, body, lazy);
        }
        var result = Fragment();
        var started = false;
        var i: int = 0;
        while (i < lower) {
            let piece = self.build_node(parser, body);
            if (not self.ok) {
                return Fragment();
            }
            if (not started) {
                result = piece;
                started = true;
            } else {
                self.patch(result, piece.start);
                result.exits.clear();
                result.absorb(piece);
            }
            i += 1;
        }
        if (upper == NONE) {
            let tail = self.build_star(parser, body, lazy);
            if (not started) {
                return tail;
            }
            self.patch(result, tail.start);
            result.exits.clear();
            result.absorb(tail);
            return result;
        }
        var extra = upper - lower;
        while (extra > 0) {
            let piece = self.build_optional(parser, body, lazy);
            if (not self.ok) {
                return Fragment();
            }
            if (not started) {
                result = piece;
                started = true;
            } else {
                self.patch(result, piece.start);
                result.exits.clear();
                result.absorb(piece);
            }
            extra -= 1;
        }
        if (not started) {
            return self.build_empty();
        }
        return result;
    }

    // e* : a split that either enters the body - which loops back - or skips
    // it.  A lazy star simply swaps the two edges so the skip is preferred.
    fn build_star(ref self, ref parser: PatternParser, body: int, lazy: bool) -> Fragment {
        let split = self.new_state(StateKind.StateSplit);
        let piece = self.build_node(parser, body);
        if (not self.ok) {
            return Fragment();
        }
        self.patch(piece, split);
        let ref s: auto = self.states[split];
        if (lazy) {
            s.alternate = piece.start;
            return self.single_exit(split, false);
        }
        s.out = piece.start;
        return self.single_exit(split, true);
    }

    // e+ : the body first, then a split that loops back or falls through.
    fn build_plus(ref self, ref parser: PatternParser, body: int, lazy: bool) -> Fragment {
        let piece = self.build_node(parser, body);
        if (not self.ok) {
            return Fragment();
        }
        let split = self.new_state(StateKind.StateSplit);
        self.patch(piece, split);
        let ref s: auto = self.states[split];
        if (lazy) {
            s.alternate = piece.start;
            return self.single_exit_from(piece.start, split);
        }
        s.out = piece.start;
        var frag = Fragment({.start = piece.start});
        frag.exits.push_back(Patch({.state = split, .second = true}));
        return frag;
    }

    // e? : one split, no loop.
    fn build_optional(ref self, ref parser: PatternParser, body: int, lazy: bool) -> Fragment {
        let split = self.new_state(StateKind.StateSplit);
        let piece = self.build_node(parser, body);
        if (not self.ok) {
            return Fragment();
        }
        let ref s: auto = self.states[split];
        var frag = Fragment({.start = split});
        if (lazy) {
            s.alternate = piece.start;
            frag.exits.push_back(Patch({.state = split, .second = false}));
        } else {
            s.out = piece.start;
            frag.exits.push_back(Patch({.state = split, .second = true}));
        }
        frag.absorb(piece);
        return frag;
    }

    var states: vector(NfaState);
    var start: int = -1;
    var accept: int = -1;
    var has_backreference: bool = false;
    var ok: bool = true;
}

// --- NFA simulation ------------------------------------------------------
//
// The simulator runs every alternative at once: it keeps a set of NFA states
// and advances the whole set one input character at a time.  That gives a
// running time of O(text * states) with no backtracking at all, which is the
// point of the construction - but it cannot report capture groups, and it
// cannot handle backreferences, so the backtracking matcher below still earns
// its keep.
//
// The state set is a sparse set: `dense` lists the members in insertion order
// and `stamp` records, per state, the generation in which it was added.
// Clearing the set is then a single increment.

class StateSet {

    fn size(self) -> int {
        return self.dense.size();
    }

    fn empty(self) -> bool {
        return self.dense.empty();
    }

    fn prepare(ref self, capacity: int) {
        self.stamp.resize(capacity);
        self.generation = 1;
        var i: int = 0;
        while (i < capacity) {
            self.stamp[i] = 0;
            i += 1;
        }
        self.dense.clear();
    }

    fn clear(ref self) {
        self.generation += 1;
        self.dense.clear();
    }

    fn contains(self, state: int) -> bool {
        if (state < 0) {
            return false;
        }
        if (state >= self.stamp.size()) {
            return false;
        }
        return self.stamp[state] == self.generation;
    }

    // Returns false when the state was already present, which is what stops
    // the epsilon closure below from looping forever.
    fn insert(ref self, state: int) -> bool {
        if (self.contains(state)) {
            return false;
        }
        self.stamp[state] = self.generation;
        self.dense.push_back(state);
        return true;
    }

    fn at(self, i: int) -> int {
        return self.dense[i];
    }

    var dense: vector(int);
    var stamp: vector(int);
    var generation: int = 1;
}

// The zero width assertions, evaluated against a position in the subject.
fn assertion_holds(which: AnchorKind, text: string, pos: int, multiline: bool) -> bool {
    if (which == AnchorKind.AnchorTextStart) {
        return pos == 0;
    }
    if (which == AnchorKind.AnchorTextEnd) {
        return pos == text.size();
    }
    if (which == AnchorKind.AnchorLineStart) {
        if (pos == 0) {
            return true;
        }
        if (not multiline) {
            return false;
        }
        return text.at(pos - 1) == CHAR_NEWLINE;
    }
    if (which == AnchorKind.AnchorLineEnd) {
        if (pos == text.size()) {
            return true;
        }
        if (not multiline) {
            return false;
        }
        return text.at(pos) == CHAR_NEWLINE;
    }
    let before = word_char_before(text, pos);
    let after = word_char_at(text, pos);
    if (which == AnchorKind.AnchorWordBoundary) {
        return before != after;
    }
    return before == after;
}

fn word_char_before(text: string, pos: int) -> bool {
    if (pos <= 0) {
        return false;
    }
    return is_word_char(text.at(pos - 1));
}

fn word_char_at(text: string, pos: int) -> bool {
    if (pos >= text.size()) {
        return false;
    }
    return is_word_char(text.at(pos));
}

class NfaSimulator {

    fn ready(self) -> bool {
        if (self.states.empty()) {
            return false;
        }
        return self.start != NONE;
    }

    fn load(ref self, builder: NfaBuilder) {
        self.states = builder.states;
        self.start = builder.start;
        self.accept = builder.accept;
        self.current.prepare(self.states.size());
        self.next.prepare(self.states.size());
    }

    // Add `state` and everything reachable from it without consuming input.
    // Splits fan out, jumps and saves fall through, and assertions are
    // evaluated on the spot against `pos`.
    fn add_state(ref self, ref set: StateSet, state: int, pos: int) {
        if (state == NONE) {
            return;
        }
        if (not set.insert(state)) {
            return;
        }
        let ref s: auto = self.states[state];
        if (s.kind == StateKind.StateSplit) {
            self.add_state(set, s.out, pos);
            self.add_state(set, s.alternate, pos);
            return;
        }
        if (s.kind == StateKind.StateJump) {
            self.add_state(set, s.out, pos);
            return;
        }
        if (s.kind == StateKind.StateSave) {
            // The simulator does not record captures, so a save is a jump.
            self.add_state(set, s.out, pos);
            return;
        }
        if (s.kind == StateKind.StateAssert) {
            if (assertion_holds(s.anchor, self.text, pos, self.multiline)) {
                self.add_state(set, s.out, pos);
            }
            return;
        }
    }

    fn set_contains_accept(self, set: StateSet) -> bool {
        var i: int = 0;
        while (i < set.size()) {
            let index = set.at(i);
            let ref s: auto = self.states[index];
            if (s.is_accepting()) {
                return true;
            }
            i += 1;
        }
        return false;
    }

    // Advance the whole set across one character.
    fn step(ref self, c: char, pos: int) {
        self.next.clear();
        var i: int = 0;
        while (i < self.current.size()) {
            let index = self.current.at(i);
            let ref s: auto = self.states[index];
            if (s.consumes()) {
                if (s.accepts(c, self.ignore_case)) {
                    self.add_state(self.next, s.out, pos + 1);
                }
            }
            i += 1;
        }
        swap(self.current, self.next);
    }

    // Run from `from` and report the offset just past the longest match that
    // begins there, or NONE when nothing matches.
    fn run_from(ref self, from: int) -> int {
        self.current.clear();
        self.add_state(self.current, self.start, from);
        var best = NONE;
        if (self.set_contains_accept(self.current)) {
            best = from;
        }
        var pos = from;
        while (pos < self.text.size()) {
            if (self.current.empty()) {
                break;
            }
            self.step(self.text.at(pos), pos);
            pos += 1;
            if (self.set_contains_accept(self.current)) {
                best = pos;
            }
            self.steps += 1;
        }
        return best;
    }

    // Leftmost match: try every starting offset in turn.  A pattern anchored
    // at the text start could skip the loop entirely, and the optimiser marks
    // such programs so the API can do exactly that.
    fn search_from(ref self, from: int) -> bool {
        var start = from;
        while (start <= self.text.size()) {
            let end = self.run_from(start);
            if (end != NONE) {
                self.match_begin = start;
                self.match_end = end;
                return true;
            }
            start += 1;
        }
        self.match_begin = NONE;
        self.match_end = NONE;
        return false;
    }

    fn matches_whole(ref self) -> bool {
        let end = self.run_from(0);
        if (end == NONE) {
            return false;
        }
        return end == self.text.size();
    }

    var states: vector(NfaState);
    var current: StateSet;
    var next: StateSet;
    var text: string;
    var start: int = -1;
    var accept: int = -1;
    var match_begin: int = -1;
    var match_end: int = -1;
    var steps: int = 0;
    var ignore_case: bool = false;
    var multiline: bool = false;
}

// --- Backtracking matcher ------------------------------------------------
//
// The simulator above is the fast path, but it reports only where a match
// ended.  This matcher walks the AST directly, keeps a capture table, honours
// greedy, lazy and possessive quantifiers, and can re-match captured text for
// a backreference.  In exchange it can backtrack exponentially, so every step
// is counted against a budget.
//
// Continuations are explicit.  Rather than passing a closure - which the
// language has no form for - the matcher stores frames in a list and passes
// the index of the head.  A frame says what is still to be matched after the
// current node succeeds, so `run_continuation` is the "what comes next" half
// of the recursion and `match_node` is the "what is here" half.  The two call
// each other, which is exactly the shape a continuation passing matcher has
// in any language.

choice MatchStatus {
    Matched,
    NoMatch,
    Exhausted,
}

choice ContKind {
    ContNode,           // match `node`, then continue with `next`
    ContGroupEnd,       // close capture group `slot`, then continue
    ContRepeat,         // resume a repetition at iteration `count`
    ContDone,       // the whole pattern has been matched
}

class Capture {

    fn valid(self) -> bool {
        if (self.begin < 0) {
            return false;
        }
        return self.end >= self.begin;
    }

    fn length(self) -> int {
        if (not self.valid()) {
            return 0;
        }
        return self.end - self.begin;
    }

    fn text_of(self, subject: string) -> string {
        if (not self.valid()) {
            return TEXT_EMPTY;
        }
        return subject.substr(self.begin, self.length());
    }

    var begin: int = -1;
    var end: int = -1;
}

class ContFrame {
    var kind: ContKind = ContKind.ContDone;
    var node: int = -1;
    var next: int = -1;
    var slot: int = -1;
    var mark: int = 0;
    var count: int = 0;
}

class BacktrackMatcher {

    // --- Set up -----------------------------------------------------------

    fn load(ref self, parser: PatternParser) {
        self.nodes = parser.nodes;
        self.root = parser.root;
        self.group_count = parser.group_count;
        self.names = parser.names;
    }

    fn reset(ref self) {
        self.frames.clear();
        self.steps = 0;
        self.status = MatchStatus.NoMatch;
        self.captures.clear();
        var i: int = 0;
        while (i <= self.group_count) {
            self.captures.push_back(Capture());
            i += 1;
        }
    }

    fn capture_count(self) -> int {
        return self.captures.size();
    }

    fn capture_at(ref self, index: int) -> ref Capture {
        return self.captures[index];
    }

    fn group_named(self, name: string) -> int {
        for (entry in self.names) {
            if (entry.name.compare(name) == 0) {
                return entry.index;
            }
        }
        return NONE;
    }

    // Charge every recursive step so a runaway pattern stops rather than
    // hanging.  `spend` returns false once the budget is gone, and every
    // caller treats that as an immediate failure.
    fn spend(ref self) -> bool {
        self.steps += 1;
        if (self.steps > self.budget) {
            self.status = MatchStatus.Exhausted;
            return false;
        }
        return true;
    }

    fn exhausted(self) -> bool {
        return self.status == MatchStatus.Exhausted;
    }

    // --- Frame allocation -------------------------------------------------

    fn push_frame(ref self, frame: ContFrame) -> int {
        let index = self.frames.size();
        self.frames.push_back(frame);
        return index;
    }

    fn push_node(ref self, node: int, next: int) -> int {
        var f = ContFrame({.kind = ContKind.ContNode, .node = node, .next = next});
        return self.push_frame(f);
    }

    fn push_group_end(ref self, slot: int, mark: int, next: int) -> int {
        var f = ContFrame({.kind = ContKind.ContGroupEnd, .next = next});
        f.slot = slot;
        f.mark = mark;
        return self.push_frame(f);
    }

    fn push_repeat(ref self, node: int, count: int, mark: int, next: int) -> int {
        var f = ContFrame({.kind = ContKind.ContRepeat, .node = node, .next = next});
        f.count = count;
        f.mark = mark;
        return self.push_frame(f);
    }

    // --- The continuation half --------------------------------------------
    //
    // Returns the offset the whole match reached, or NONE on failure.

    fn run_continuation(ref self, cont: int, pos: int) -> int {
        if (not self.spend()) {
            return NONE;
        }
        if (cont == NONE) {
            // Nothing left to match: the pattern has succeeded here.
            return pos;
        }
        let kind = self.frames[cont].kind;
        if (kind == ContKind.ContDone) {
            return pos;
        }
        if (kind == ContKind.ContNode) {
            let node = self.frames[cont].node;
            let next = self.frames[cont].next;
            return self.match_node(node, pos, next);
        }
        if (kind == ContKind.ContGroupEnd) {
            let slot = self.frames[cont].slot;
            let mark = self.frames[cont].mark;
            let next = self.frames[cont].next;
            var saved_begin = NONE;
            var saved_end = NONE;
            if (slot < self.captures.size()) {
                let ref existing: auto = self.captures[slot];
                saved_begin = existing.begin;
                saved_end = existing.end;
                let ref cap: auto = self.captures[slot];
                cap.begin = mark;
                cap.end = pos;
            }
            let result = self.run_continuation(next, pos);
            if (result == NONE) {
                // Undo the capture: a group that took part in a failed
                // attempt must not leak its text into the final table.
                if (slot < self.captures.size()) {
                    let ref cap: auto = self.captures[slot];
                    cap.begin = saved_begin;
                    cap.end = saved_end;
                }
            }
            return result;
        }
        let node = self.frames[cont].node;
        let count = self.frames[cont].count;
        let mark = self.frames[cont].mark;
        let next = self.frames[cont].next;
        if (pos == mark) {
            // The body matched the empty string.  Repeating it again would
            // never terminate, so the repetition ends here.
            let ref n: auto = self.nodes[node];
            if (count >= n.lower) {
                return self.run_continuation(next, pos);
            }
            return NONE;
        }
        return self.match_repeat(node, pos, count, next);
    }

    // --- The node half ----------------------------------------------------

    fn match_node(ref self, node: int, pos: int, cont: int) -> int {
        if (not self.spend()) {
            return NONE;
        }
        if (node == NONE) {
            return self.run_continuation(cont, pos);
        }
        let kind = self.nodes[node].kind;
        if (kind == NodeKind.NodeEmpty) {
            return self.run_continuation(cont, pos);
        }
        if (kind == NodeKind.NodeLiteral) {
            return self.match_literal(node, pos, cont);
        }
        if (kind == NodeKind.NodeString) {
            return self.match_string(node, pos, cont);
        }
        if (kind == NodeKind.NodeAny) {
            return self.match_class(node, pos, cont);
        }
        if (kind == NodeKind.NodeClass) {
            return self.match_class(node, pos, cont);
        }
        if (kind == NodeKind.NodeAnchor) {
            return self.match_anchor(node, pos, cont);
        }
        if (kind == NodeKind.NodeBackreference) {
            return self.match_backreference(node, pos, cont);
        }
        if (kind == NodeKind.NodeConcat) {
            return self.match_concat(node, pos, cont);
        }
        if (kind == NodeKind.NodeAlternate) {
            return self.match_alternate(node, pos, cont);
        }
        if (kind == NodeKind.NodeGroup) {
            return self.match_group(node, pos, cont);
        }
        if (kind == NodeKind.NodeRepeat) {
            return self.match_repeat(node, pos, 0, cont);
        }
        return NONE;
    }

    fn match_literal(ref self, node: int, pos: int, cont: int) -> int {
        if (pos >= self.text.size()) {
            return NONE;
        }
        let expected = self.nodes[node].value;
        let actual = self.text.at(pos);
        if (self.ignore_case) {
            if (not same_char_folded(expected, actual)) {
                return NONE;
            }
        } else {
            if (expected != actual) {
                return NONE;
            }
        }
        return self.run_continuation(cont, pos + 1);
    }

    // A literal run, produced by the optimiser when it fuses adjacent
    // literals.  Matching it in one go saves a continuation hop per
    // character, which is the whole reason the optimisation exists.
    fn match_string(ref self, node: int, pos: int, cont: int) -> int {
        let ref text: auto = self.nodes[node].text;
        if (pos + text.size() > self.text.size()) {
            return NONE;
        }
        var i: int = 0;
        while (i < text.size()) {
            let expected = text.at(i);
            let actual = self.text.at(pos + i);
            if (self.ignore_case) {
                if (not same_char_folded(expected, actual)) {
                    return NONE;
                }
            } else {
                if (expected != actual) {
                    return NONE;
                }
            }
            i += 1;
        }
        return self.run_continuation(cont, pos + text.size());
    }

    fn match_class(ref self, node: int, pos: int, cont: int) -> int {
        if (pos >= self.text.size()) {
            return NONE;
        }
        let c = self.text.at(pos);
        let ref cls: auto = self.nodes[node].charclass;
        var hit = false;
        if (self.ignore_case) {
            hit = cls.matches_folded(c);
        } else {
            hit = cls.matches(c);
        }
        if (not hit) {
            return NONE;
        }
        return self.run_continuation(cont, pos + 1);
    }

    fn match_anchor(ref self, node: int, pos: int, cont: int) -> int {
        let which = self.nodes[node].anchor;
        if (not assertion_holds(which, self.text, pos, self.multiline)) {
            return NONE;
        }
        return self.run_continuation(cont, pos);
    }

    // Re-match the exact text a group captured earlier.  An unset group
    // matches the empty string, which is what most engines do.
    fn match_backreference(ref self, node: int, pos: int, cont: int) -> int {
        let group = self.nodes[node].reference;
        if (group >= self.captures.size()) {
            return NONE;
        }
        let ref cap: auto = self.captures[group];
        if (not cap.valid()) {
            return self.run_continuation(cont, pos);
        }
        let length = cap.length();
        if (pos + length > self.text.size()) {
            return NONE;
        }
        var i: int = 0;
        while (i < length) {
            let expected = self.text.at(cap.begin + i);
            let actual = self.text.at(pos + i);
            if (self.ignore_case) {
                if (not same_char_folded(expected, actual)) {
                    return NONE;
                }
            } else {
                if (expected != actual) {
                    return NONE;
                }
            }
            i += 1;
        }
        return self.run_continuation(cont, pos + length);
    }

    // Chain the children onto the continuation from the right, so the first
    // child is matched first and every later child is waiting in a frame.
    fn match_concat(ref self, node: int, pos: int, cont: int) -> int {
        let count = self.nodes[node].children.size();
        if (count == 0) {
            return self.run_continuation(cont, pos);
        }
        var chain = cont;
        var i = count - 1;
        while (i >= 0) {
            let child = self.nodes[node].children[i];
            chain = self.push_node(child, chain);
            i -= 1;
        }
        return self.run_continuation(chain, pos);
    }

    // Try each branch in order with the same continuation.  Ordering is what
    // makes alternation leftmost-biased, so `a|ab` matches just `a`.
    fn match_alternate(ref self, node: int, pos: int, cont: int) -> int {
        let count = self.nodes[node].children.size();
        var i: int = 0;
        while (i < count) {
            let child = self.nodes[node].children[i];
            let result = self.match_node(child, pos, cont);
            if (result != NONE) {
                return result;
            }
            if (self.exhausted()) {
                return NONE;
            }
            i += 1;
        }
        return NONE;
    }

    fn match_group(ref self, node: int, pos: int, cont: int) -> int {
        let body = self.nodes[node].first;
        let group = self.nodes[node].group_index;
        if (group == NONE) {
            return self.match_node(body, pos, cont);
        }
        let closing = self.push_group_end(group, pos, cont);
        return self.match_node(body, pos, closing);
    }

    // --- Repetition -------------------------------------------------------
    //
    // `count` is how many iterations have already succeeded.  A greedy
    // repetition tries one more iteration before it tries the continuation; a
    // lazy one tries the continuation first.  A possessive repetition takes
    // as many iterations as it can and never gives one back.

    fn match_repeat(ref self, node: int, pos: int, count: int, cont: int) -> int {
        if (not self.spend()) {
            return NONE;
        }
        let lower = self.nodes[node].lower;
        let upper = self.nodes[node].upper;
        let body = self.nodes[node].first;
        let greed = self.nodes[node].greed;
        var may_continue = count >= lower;
        var may_repeat = true;
        if (upper != NONE) {
            if (count >= upper) {
                may_repeat = false;
            }
        }
        if (greed == Greediness.Possessive) {
            return self.match_possessive(node, pos, count, cont);
        }
        if (greed == Greediness.Lazy) {
            if (may_continue) {
                let stop = self.run_continuation(cont, pos);
                if (stop != NONE) {
                    return stop;
                }
                if (self.exhausted()) {
                    return NONE;
                }
            }
            if (not may_repeat) {
                return NONE;
            }
            let resume = self.push_repeat(node, count + 1, pos, cont);
            return self.match_node(body, pos, resume);
        }
        if (may_repeat) {
            let resume = self.push_repeat(node, count + 1, pos, cont);
            let more = self.match_node(body, pos, resume);
            if (more != NONE) {
                return more;
            }
            if (self.exhausted()) {
                return NONE;
            }
        }
        if (may_continue) {
            return self.run_continuation(cont, pos);
        }
        return NONE;
    }

    // Consume iterations with an empty continuation until the body stops
    // matching, then hand the final position to the real continuation.  No
    // iteration is ever undone, which is the defining property.
    fn match_possessive(ref self, node: int, pos: int, count: int, cont: int) -> int {
        let lower = self.nodes[node].lower;
        let upper = self.nodes[node].upper;
        let body = self.nodes[node].first;
        var taken = count;
        var cursor = pos;
        while (true) {
            if (upper != NONE) {
                if (taken >= upper) {
                    break;
                }
            }
            let advanced = self.match_node(body, cursor, NONE);
            if (advanced == NONE) {
                break;
            }
            if (advanced == cursor) {
                // An empty iteration adds nothing and would loop forever.
                break;
            }
            cursor = advanced;
            taken += 1;
            if (self.exhausted()) {
                return NONE;
            }
        }
        if (taken < lower) {
            return NONE;
        }
        return self.run_continuation(cont, cursor);
    }

    // --- Public entry points ----------------------------------------------

    fn match_at(ref self, start: int) -> bool {
        self.reset();
        let end = self.match_node(self.root, start, NONE);
        if (end == NONE) {
            if (not self.exhausted()) {
                self.status = MatchStatus.NoMatch;
            }
            return false;
        }
        self.status = MatchStatus.Matched;
        let ref whole: auto = self.captures[0];
        whole.begin = start;
        whole.end = end;
        return true;
    }

    fn search_from(ref self, from: int) -> bool {
        var start = from;
        while (start <= self.text.size()) {
            if (self.match_at(start)) {
                return true;
            }
            if (self.exhausted()) {
                return false;
            }
            start += 1;
        }
        return false;
    }

    fn match_whole(ref self) -> bool {
        if (not self.match_at(0)) {
            return false;
        }
        let ref whole: auto = self.captures[0];
        return whole.end == self.text.size();
    }

    var nodes: vector(Node);
    var names: vector(GroupName);
    var frames: vector(ContFrame);
    var captures: vector(Capture);
    var text: string;
    var root: int = -1;
    var group_count: int = 0;
    var steps: int = 0;
    var budget: int = 1000000;
    var status: MatchStatus = MatchStatus.NoMatch;
    var ignore_case: bool = false;
    var multiline: bool = false;
}

// --- Compiled program ----------------------------------------------------
//
// The third representation, after the AST and the NFA.  A program is a flat
// instruction array in which control flow is expressed by absolute indices,
// which makes it cheap to store, cheap to copy and easy to rewrite - the
// optimiser below works on programs, not on trees.
//
// The instruction set is deliberately small.  OpString and OpClassSet do not
// add expressive power; they exist so the optimiser has something to fuse
// runs of OpChar and adjacent OpClass instructions into.

choice OpCode {
    OpChar,             // consume one specific character
    OpString,           // consume a fixed run of characters
    OpClass,            // consume one character of a class
    OpAny,              // consume any character
    OpSplit,            // try `x`, then `y`
    OpJump,             // continue at `x`
    OpSave,             // record the offset in capture slot `slot`
    OpAssert,           // zero width assertion
    OpBackref,          // re-match capture group `slot`
    OpMatch,            // accept
    OpFail,        // never matches; left behind by the optimiser
}

class Instruction {

    fn consumes_input(self) -> bool {
        if (self.op == OpCode.OpChar) {
            return true;
        }
        if (self.op == OpCode.OpString) {
            return true;
        }
        if (self.op == OpCode.OpClass) {
            return true;
        }
        if (self.op == OpCode.OpAny) {
            return true;
        }
        return false;
    }

    fn is_branch(self) -> bool {
        if (self.op == OpCode.OpSplit) {
            return true;
        }
        if (self.op == OpCode.OpJump) {
            return true;
        }
        return false;
    }

    fn is_terminal(self) -> bool {
        if (self.op == OpCode.OpMatch) {
            return true;
        }
        return self.op == OpCode.OpFail;
    }

    // How much input the instruction always consumes.  OpString reports its
    // whole length, which is what the prefix scanner wants.
    fn minimum_width(self) -> int {
        if (self.op == OpCode.OpString) {
            return self.text.size();
        }
        if (self.consumes_input()) {
            return 1;
        }
        return 0;
    }

    var op: OpCode = OpCode.OpFail;
    var value: char = '\0';
    var text: string;
    var charclass: CharClass;
    var anchor: AnchorKind = AnchorKind.AnchorLineStart;
    var slot: int = 0;
    var x: int = -1;
    var y: int = -1;
}

class Program {

    fn size(self) -> int {
        return self.code.size();
    }

    fn empty(self) -> bool {
        return self.code.empty();
    }

    fn at(ref self, pc: int) -> ref Instruction {
        return self.code[pc];
    }

    fn op_at(self, pc: int) -> OpCode {
        if (pc < 0) {
            return OpCode.OpFail;
        }
        if (pc >= self.code.size()) {
            return OpCode.OpFail;
        }
        return self.code[pc].op;
    }

    fn emit(ref self, inst: Instruction) -> int {
        let at = self.code.size();
        self.code.push_back(inst);
        return at;
    }

    fn emit_op(ref self, op: OpCode) -> int {
        return self.emit(Instruction({.op = op}));
    }

    fn emit_char(ref self, c: char) -> int {
        var inst = Instruction({.op = OpCode.OpChar, .value = c});
        inst.charclass.add_char(c);
        return self.emit(inst);
    }

    fn emit_class(ref self, cls: CharClass) -> int {
        var inst = Instruction({.op = OpCode.OpClass});
        inst.charclass = cls;
        inst.charclass.normalise();
        return self.emit(inst);
    }

    fn emit_save(ref self, slot: int) -> int {
        var inst = Instruction({.op = OpCode.OpSave});
        inst.slot = slot;
        return self.emit(inst);
    }

    fn emit_assert(ref self, which: AnchorKind) -> int {
        var inst = Instruction({.op = OpCode.OpAssert});
        inst.anchor = which;
        return self.emit(inst);
    }

    fn emit_backref(ref self, slot: int) -> int {
        var inst = Instruction({.op = OpCode.OpBackref});
        inst.slot = slot;
        return self.emit(inst);
    }

    fn set_target(ref self, pc: int, target: int) {
        let ref inst: auto = self.code[pc];
        inst.x = target;
    }

    fn set_alternate(ref self, pc: int, target: int) {
        let ref inst: auto = self.code[pc];
        inst.y = target;
    }

    fn instruction_count_of(self, op: OpCode) -> int {
        var total: int = 0;
        for (inst in self.code) {
            if (inst.op == op) {
                total += 1;
            }
        }
        return total;
    }

    // Shortest possible match, used to reject subjects that are too short
    // before any real work happens.  Splits take the smaller of the two
    // arms, which is a lower bound and therefore always safe.
    fn minimum_length(self) -> int {
        var total: int = 0;
        for (inst in self.code) {
            if (inst.op == OpCode.OpSplit) {
                return total;
            }
            total += inst.minimum_width();
            if (inst.op == OpCode.OpMatch) {
                break;
            }
        }
        return total;
    }

    fn disassemble(self) -> string {
        var out = TEXT_EMPTY;
        var pc: int = 0;
        while (pc < self.code.size()) {
            let ref inst: auto = self.code[pc];
            out.append(to_string(pc));
            out.append(TEXT_SPACE_ARROW);
            out.append(opcode_name(inst.op));
            if (inst.op == OpCode.OpChar) {
                out.append(TEXT_SPACE);
                out.append(escape_spelling(inst.value));
            }
            if (inst.op == OpCode.OpString) {
                out.append(TEXT_SPACE);
                out.append(inst.text);
            }
            if (inst.op == OpCode.OpClass) {
                out.append(TEXT_SPACE);
                out.append(inst.charclass.spell());
            }
            if (inst.is_branch()) {
                out.append(TEXT_SPACE);
                out.append(to_string(inst.x));
            }
            if (inst.op == OpCode.OpSplit) {
                out.append(TEXT_COMMA_SPACE);
                out.append(to_string(inst.y));
            }
            out.append(TEXT_NEWLINE);
            pc += 1;
        }
        return out;
    }

    var code: vector(Instruction);
    var names: vector(GroupName);
    var prefix: string;
    var group_count: int = 0;
    var start: int = 0;
    var anchored: bool = false;
    var has_backreference: bool = false;
    var ignore_case: bool = false;
    var multiline: bool = false;
    var dot_matches_newline: bool = false;
}

let TEXT_SPACE: string = " ";
let TEXT_NEWLINE: string = "\n";
let TEXT_COMMA_SPACE: string = ", ";
let TEXT_SPACE_ARROW: string = ": ";

fn opcode_name(op: OpCode) -> string {
    if (op == OpCode.OpChar) {
        return "char";
    }
    if (op == OpCode.OpString) {
        return "string";
    }
    if (op == OpCode.OpClass) {
        return "class";
    }
    if (op == OpCode.OpAny) {
        return "any";
    }
    if (op == OpCode.OpSplit) {
        return "split";
    }
    if (op == OpCode.OpJump) {
        return "jump";
    }
    if (op == OpCode.OpSave) {
        return "save";
    }
    if (op == OpCode.OpAssert) {
        return "assert_at";
    }
    if (op == OpCode.OpBackref) {
        return "backref";
    }
    if (op == OpCode.OpMatch) {
        return "match";
    }
    return "fail";
}

// --- Compiler ------------------------------------------------------------
//
// A straight recursive walk of the AST, emitting instructions as it goes.
// Because targets are absolute indices and a forward branch does not know
// where it lands, the compiler emits a placeholder and patches it once the
// destination is known - the same hole-and-patch discipline the NFA builder
// uses, expressed in indices instead of exit lists.

class Compiler {

    fn compile(ref self, parser: PatternParser) -> bool {
        self.program = Program();
        self.nodes = parser.nodes;
        self.program.group_count = parser.group_count;
        self.program.names = parser.names;
        self.ok = true;
        Discard(self.program.emit_save(0));
        self.compile_node(parser.root);
        if (not self.ok) {
            return false;
        }
        Discard(self.program.emit_save(1));
        Discard(self.program.emit_op(OpCode.OpMatch));
        self.program.anchored = self.starts_anchored(parser.root);
        return true;
    }

    fn here(self) -> int {
        return self.program.code.size();
    }

    fn compile_node(ref self, index: int) {
        if (index == NONE) {
            return;
        }
        if (not self.ok) {
            return;
        }
        let kind = self.nodes[index].kind;
        if (kind == NodeKind.NodeEmpty) {
            return;
        }
        if (kind == NodeKind.NodeLiteral) {
            Discard(self.program.emit_char(self.nodes[index].value));
            return;
        }
        if (kind == NodeKind.NodeString) {
            var inst = Instruction({.op = OpCode.OpString});
            inst.text = self.nodes[index].text;
            Discard(self.program.emit(inst));
            return;
        }
        if (kind == NodeKind.NodeAny) {
            Discard(self.program.emit_class(self.nodes[index].charclass));
            return;
        }
        if (kind == NodeKind.NodeClass) {
            Discard(self.program.emit_class(self.nodes[index].charclass));
            return;
        }
        if (kind == NodeKind.NodeAnchor) {
            Discard(self.program.emit_assert(self.nodes[index].anchor));
            return;
        }
        if (kind == NodeKind.NodeBackreference) {
            self.program.has_backreference = true;
            Discard(self.program.emit_backref(self.nodes[index].reference));
            return;
        }
        if (kind == NodeKind.NodeConcat) {
            self.compile_concat(index);
            return;
        }
        if (kind == NodeKind.NodeAlternate) {
            self.compile_alternate(index);
            return;
        }
        if (kind == NodeKind.NodeGroup) {
            self.compile_group(index);
            return;
        }
        if (kind == NodeKind.NodeRepeat) {
            self.compile_repeat(index);
            return;
        }
        self.ok = false;
    }

    fn compile_concat(ref self, index: int) {
        let count = self.nodes[index].children.size();
        var i: int = 0;
        while (i < count) {
            self.compile_node(self.nodes[index].children[i]);
            if (not self.ok) {
                return;
            }
            i += 1;
        }
    }

    // Each branch but the last is guarded by a split and followed by a jump
    // to the join point.  The jumps are collected and patched together once
    // the last branch has been emitted.
    fn compile_alternate(ref self, index: int) {
        let count = self.nodes[index].children.size();
        if (count == 0) {
            return;
        }
        var jumps = vector(int)();
        var i: int = 0;
        while (i < count) {
            let child = self.nodes[index].children[i];
            if (i + 1 == count) {
                self.compile_node(child);
                i += 1;
                continue;
            }
            let split = self.program.emit_op(OpCode.OpSplit);
            self.program.set_target(split, self.here());
            self.compile_node(child);
            if (not self.ok) {
                return;
            }
            let jump = self.program.emit_op(OpCode.OpJump);
            jumps.push_back(jump);
            self.program.set_alternate(split, self.here());
            i += 1;
        }
        let join = self.here();
        for (jump in jumps) {
            self.program.set_target(jump, join);
        }
    }

    fn compile_group(ref self, index: int) {
        let group = self.nodes[index].group_index;
        if (group == NONE) {
            self.compile_node(self.nodes[index].first);
            return;
        }
        Discard(self.program.emit_save(group * 2));
        self.compile_node(self.nodes[index].first);
        if (not self.ok) {
            return;
        }
        Discard(self.program.emit_save(group * 2 + 1));
    }

    fn compile_repeat(ref self, index: int) {
        let lower = self.nodes[index].lower;
        let upper = self.nodes[index].upper;
        let body = self.nodes[index].first;
        let lazy = self.nodes[index].greed == Greediness.Lazy;
        var i: int = 0;
        while (i < lower) {
            self.compile_node(body);
            if (not self.ok) {
                return;
            }
            i += 1;
        }
        if (upper == NONE) {
            self.compile_star(body, lazy);
            return;
        }
        var extra = upper - lower;
        var splits = vector(int)();
        while (extra > 0) {
            let split = self.program.emit_op(OpCode.OpSplit);
            splits.push_back(split);
            if (lazy) {
                self.program.set_alternate(split, self.here());
            } else {
                self.program.set_target(split, self.here());
            }
            self.compile_node(body);
            if (not self.ok) {
                return;
            }
            extra -= 1;
        }
        let after = self.here();
        for (split in splits) {
            if (lazy) {
                self.program.set_target(split, after);
            } else {
                self.program.set_alternate(split, after);
            }
        }
    }

    // The star loop: split, body, jump back, and the split's other arm points
    // past the jump.  Swapping the arms turns the loop lazy.
    fn compile_star(ref self, body: int, lazy: bool) {
        let split = self.program.emit_op(OpCode.OpSplit);
        let body_at = self.here();
        self.compile_node(body);
        if (not self.ok) {
            return;
        }
        let jump = self.program.emit_op(OpCode.OpJump);
        self.program.set_target(jump, split);
        let after = self.here();
        if (lazy) {
            self.program.set_target(split, after);
            self.program.set_alternate(split, body_at);
        } else {
            self.program.set_target(split, body_at);
            self.program.set_alternate(split, after);
        }
    }

    // True when every path through the pattern begins with an anchor that
    // pins it to the start of the subject.  Such a program never needs to be
    // retried at later offsets.
    fn starts_anchored(self, index: int) -> bool {
        if (index == NONE) {
            return false;
        }
        let kind = self.nodes[index].kind;
        if (kind == NodeKind.NodeAnchor) {
            let which = self.nodes[index].anchor;
            if (which == AnchorKind.AnchorTextStart) {
                return true;
            }
            return which == AnchorKind.AnchorLineStart;
        }
        if (kind == NodeKind.NodeGroup) {
            return self.starts_anchored(self.nodes[index].first);
        }
        if (kind == NodeKind.NodeConcat) {
            if (self.nodes[index].children.empty()) {
                return false;
            }
            return self.starts_anchored(self.nodes[index].children[0]);
        }
        if (kind == NodeKind.NodeAlternate) {
            // Every branch must be anchored, or the pattern can still match
            // somewhere in the middle of the subject.
            if (self.nodes[index].children.empty()) {
                return false;
            }
            for (child in self.nodes[index].children) {
                if (not self.starts_anchored(child)) {
                    return false;
                }
            }
            return true;
        }
        return false;
    }

    var program: Program;
    var nodes: vector(Node);
    var ok: bool = true;
}

// --- Optimiser -----------------------------------------------------------
//
// Two families of rewrites, both optional: nothing here changes what a
// pattern matches, only how much work matching it costs.
//
// On the tree:
//   * runs of adjacent literals become one NodeString
//   * an alternation of single character branches becomes one NodeClass
//   * degenerate repetitions - {1,1}, {0,0} - collapse
//
// On the program:
//   * a jump to a jump is threaded through to its final destination
//   * instructions no branch can reach are replaced with OpFail
//
// Every pass reports how many rewrites it made, and the driver repeats the
// set until a round changes nothing or the budget runs out.

class OptimiserStats {

    fn total(self) -> int {
        var sum = self.literal_runs + self.merged_classes;
        sum += self.collapsed_repeats;
        sum += self.threaded_jumps;
        sum += self.dead_instructions;
        return sum;
    }

    fn describe(self) -> string {
        var out = TEXT_EMPTY;
        out.append("literal runs: ");
        out.append(to_string(self.literal_runs));
        out.append(TEXT_COMMA_SPACE);
        out.append("merged classes: ");
        out.append(to_string(self.merged_classes));
        out.append(TEXT_COMMA_SPACE);
        out.append("collapsed repeats: ");
        out.append(to_string(self.collapsed_repeats));
        out.append(TEXT_COMMA_SPACE);
        out.append("threaded jumps: ");
        out.append(to_string(self.threaded_jumps));
        out.append(TEXT_COMMA_SPACE);
        out.append("dead instructions: ");
        out.append(to_string(self.dead_instructions));
        return out;
    }

    var literal_runs: int = 0;
    var merged_classes: int = 0;
    var collapsed_repeats: int = 0;
    var threaded_jumps: int = 0;
    var dead_instructions: int = 0;
    var rounds: int = 0;
}

class Optimiser {

    fn changed(self) -> bool {
        return self.rewrites > 0;
    }

    fn spend(ref self) -> bool {
        self.work += 1;
        return self.work <= OPTIMISER_BUDGET;
    }

    // --- Tree passes ------------------------------------------------------

    fn optimise_tree(ref self, ref parser: PatternParser) -> int {
        self.rewrites = 0;
        var round: int = 0;
        while (round < 4) {
            let before = self.rewrites;
            self.fuse_literals(parser, parser.root);
            self.merge_alternate_classes(parser, parser.root);
            self.collapse_repeats(parser, parser.root);
            self.stats.rounds += 1;
            if (self.rewrites == before) {
                break;
            }
            round += 1;
        }
        return self.rewrites;
    }

    // Walk the tree bottom up, replacing every run of two or more adjacent
    // NodeLiteral children of a concatenation with a single NodeString.  A
    // run of one is left alone: OpChar is already the cheapest form.
    fn fuse_literals(ref self, ref parser: PatternParser, index: int) {
        if (index == NONE) {
            return;
        }
        if (not self.spend()) {
            return;
        }
        let kind = parser.nodes[index].kind;
        if (kind == NodeKind.NodeRepeat) {
            self.fuse_literals(parser, parser.nodes[index].first);
            return;
        }
        if (kind == NodeKind.NodeGroup) {
            self.fuse_literals(parser, parser.nodes[index].first);
            return;
        }
        if (kind == NodeKind.NodeAlternate) {
            let count = parser.nodes[index].children.size();
            var i: int = 0;
            while (i < count) {
                self.fuse_literals(parser, parser.nodes[index].children[i]);
                i += 1;
            }
            return;
        }
        if (kind != NodeKind.NodeConcat) {
            return;
        }
        let count = parser.nodes[index].children.size();
        var i: int = 0;
        while (i < count) {
            self.fuse_literals(parser, parser.nodes[index].children[i]);
            i += 1;
        }
        var rebuilt = vector(int)();
        var run = TEXT_EMPTY;
        var run_start = NONE;
        i = 0;
        while (i < count) {
            let child = parser.nodes[index].children[i];
            let child_kind = parser.nodes[child].kind;
            var literal = child_kind == NodeKind.NodeLiteral;
            if (literal and i + 1 < count) {
                // A literal followed by a quantifier must stay separate: the
                // quantifier binds to that one character, not to the run.
                let next = parser.nodes[index].children[i + 1];
                if (parser.nodes[next].kind == NodeKind.NodeRepeat) {
                    if (parser.nodes[next].first == child) {
                        literal = false;
                    }
                }
            }
            if (literal) {
                if (run_start == NONE) {
                    run_start = child;
                }
                run.push_back(parser.nodes[child].value);
            } else {
                if (run.size() >= 2) {
                    let fused = self.make_string_node(parser, run);
                    rebuilt.push_back(fused);
                    self.rewrites += 1;
                    self.stats.literal_runs += 1;
                } else {
                    if (run_start != NONE) {
                        rebuilt.push_back(run_start);
                    }
                }
                run = TEXT_EMPTY;
                run_start = NONE;
                rebuilt.push_back(child);
            }
            i += 1;
        }
        if (run.size() >= 2) {
            let fused = self.make_string_node(parser, run);
            rebuilt.push_back(fused);
            self.rewrites += 1;
            self.stats.literal_runs += 1;
        } else {
            if (run_start != NONE) {
                rebuilt.push_back(run_start);
            }
        }
        let ref n: auto = parser.nodes[index];
        n.children = move(rebuilt);
    }

    fn make_string_node(ref self, ref parser: PatternParser, text: string) -> int {
        let index = parser.nodes.size();
        var n = Node({.kind = NodeKind.NodeString});
        n.text = text;
        parser.nodes.push_back(n);
        return index;
    }

    // `a|b|c` and `[ab]|[cd]` both describe a set of single characters, and a
    // single class test is far cheaper than a chain of splits.  The rewrite
    // only fires when *every* branch is a single character or a class, since
    // a mixed alternation still needs its control flow.
    fn merge_alternate_classes(ref self, ref parser: PatternParser, index: int) {
        if (index == NONE) {
            return;
        }
        if (not self.spend()) {
            return;
        }
        let kind = parser.nodes[index].kind;
        if (kind == NodeKind.NodeRepeat) {
            self.merge_alternate_classes(parser, parser.nodes[index].first);
            return;
        }
        if (kind == NodeKind.NodeGroup) {
            self.merge_alternate_classes(parser, parser.nodes[index].first);
            return;
        }
        if (kind == NodeKind.NodeConcat) {
            let count = parser.nodes[index].children.size();
            var i: int = 0;
            while (i < count) {
                self.merge_alternate_classes(parser, parser.nodes[index].children[i]);
                i += 1;
            }
            return;
        }
        if (kind != NodeKind.NodeAlternate) {
            return;
        }
        let count = parser.nodes[index].children.size();
        var i: int = 0;
        while (i < count) {
            self.merge_alternate_classes(parser, parser.nodes[index].children[i]);
            i += 1;
        }
        if (count < 2) {
            return;
        }
        var mergeable = true;
        i = 0;
        while (i < count) {
            let child = parser.nodes[index].children[i];
            let child_kind = parser.nodes[child].kind;
            var fine = false;
            if (child_kind == NodeKind.NodeLiteral) {
                fine = true;
            }
            if (child_kind == NodeKind.NodeClass) {
                // A negated class cannot be unioned by concatenating ranges;
                // it would have to be complemented first, and that is not
                // worth doing inside a pass meant to be cheap.
                if (not parser.nodes[child].charclass.negated) {
                    fine = true;
                }
            }
            if (not fine) {
                mergeable = false;
                break;
            }
            i += 1;
        }
        if (not mergeable) {
            return;
        }
        var merged = CharClass();
        i = 0;
        while (i < count) {
            let child = parser.nodes[index].children[i];
            merged.add_class(parser.nodes[child].charclass);
            i += 1;
        }
        merged.normalise();
        let ref n: auto = parser.nodes[index];
        n.kind = NodeKind.NodeClass;
        n.charclass = merged;
        n.children.clear();
        self.rewrites += 1;
        self.stats.merged_classes += 1;
    }

    // `e{1,1}` is `e`, and `e{0,0}` is the empty string.  Both turn up
    // constantly in generated patterns.
    fn collapse_repeats(ref self, ref parser: PatternParser, index: int) {
        if (index == NONE) {
            return;
        }
        if (not self.spend()) {
            return;
        }
        let kind = parser.nodes[index].kind;
        if (kind == NodeKind.NodeConcat) {
            let count = parser.nodes[index].children.size();
            var i: int = 0;
            while (i < count) {
                self.collapse_repeats(parser, parser.nodes[index].children[i]);
                i += 1;
            }
            return;
        }
        if (kind == NodeKind.NodeAlternate) {
            let count = parser.nodes[index].children.size();
            var i: int = 0;
            while (i < count) {
                self.collapse_repeats(parser, parser.nodes[index].children[i]);
                i += 1;
            }
            return;
        }
        if (kind == NodeKind.NodeGroup) {
            self.collapse_repeats(parser, parser.nodes[index].first);
            return;
        }
        if (kind != NodeKind.NodeRepeat) {
            return;
        }
        self.collapse_repeats(parser, parser.nodes[index].first);
        let lower = parser.nodes[index].lower;
        let upper = parser.nodes[index].upper;
        if (lower == 0 and upper == 0) {
            let ref n: auto = parser.nodes[index];
            n.kind = NodeKind.NodeEmpty;
            n.first = NONE;
            self.rewrites += 1;
            self.stats.collapsed_repeats += 1;
            return;
        }
        if (lower == 1 and upper == 1) {
            let body = parser.nodes[index].first;
            let ref source: auto = parser.nodes[body];
            var copy = source;
            let ref n: auto = parser.nodes[index];
            n.kind = copy.kind;
            n.value = copy.value;
            n.text = copy.text;
            n.charclass = copy.charclass;
            n.anchor = copy.anchor;
            n.group_kind = copy.group_kind;
            n.group_index = copy.group_index;
            n.reference = copy.reference;
            n.lower = copy.lower;
            n.upper = copy.upper;
            n.first = copy.first;
            n.children = copy.children;
            self.rewrites += 1;
            self.stats.collapsed_repeats += 1;
        }
    }

    // --- Literal prefix extraction ----------------------------------------
    //
    // Walk the front of the pattern collecting characters that every match
    // must begin with.  A search can then skip to the next occurrence of that
    // prefix instead of retrying the whole machine at every offset, which is
    // the single most valuable optimisation for patterns like `error: .*`.

    fn extract_prefix(ref self, parser: PatternParser, index: int) -> string {
        var out = TEXT_EMPTY;
        self.collect_prefix(parser, index, out);
        return out;
    }

    fn collect_prefix(ref self, parser: PatternParser, index: int, ref out: string) {
        if (index == NONE) {
            return;
        }
        if (not self.spend()) {
            return;
        }
        let kind = parser.nodes[index].kind;
        if (kind == NodeKind.NodeLiteral) {
            out.push_back(parser.nodes[index].value);
            return;
        }
        if (kind == NodeKind.NodeString) {
            out.append(parser.nodes[index].text);
            return;
        }
        if (kind == NodeKind.NodeGroup) {
            if (parser.nodes[index].group_kind == GroupKind.NonCapturing) {
                self.collect_prefix(parser, parser.nodes[index].first, out);
            }
            return;
        }
        if (kind == NodeKind.NodeAnchor) {
            // Anchors consume nothing, so the prefix continues past them.
            return;
        }
        if (kind == NodeKind.NodeRepeat) {
            if (parser.nodes[index].lower >= 1) {
                // The first mandatory iteration contributes its own prefix,
                // but nothing after it is certain.
                var inner = TEXT_EMPTY;
                self.collect_prefix(parser, parser.nodes[index].first, inner);
                out.append(inner);
            }
            return;
        }
        if (kind != NodeKind.NodeConcat) {
            return;
        }
        let count = parser.nodes[index].children.size();
        var i: int = 0;
        while (i < count) {
            let child = parser.nodes[index].children[i];
            let child_kind = parser.nodes[child].kind;
            if (child_kind == NodeKind.NodeLiteral) {
                out.push_back(parser.nodes[child].value);
                i += 1;
                continue;
            }
            if (child_kind == NodeKind.NodeString) {
                out.append(parser.nodes[child].text);
                i += 1;
                continue;
            }
            if (child_kind == NodeKind.NodeAnchor) {
                i += 1;
                continue;
            }
            break;
        }
    }

    // --- Program passes ---------------------------------------------------

    fn optimise_program(ref self, ref program: Program) -> int {
        self.rewrites = 0;
        var round: int = 0;
        while (round < 3) {
            let before = self.rewrites;
            self.thread_jumps(program);
            self.mark_dead(program);
            if (self.rewrites == before) {
                break;
            }
            round += 1;
        }
        return self.rewrites;
    }

    // A branch that lands on an unconditional jump can point at the jump's
    // own destination instead.  Chains are followed with a hop limit so a
    // loop of jumps - which the compiler cannot emit, but a rewritten program
    // might - cannot spin forever.
    fn thread_jumps(ref self, ref program: Program) {
        var pc: int = 0;
        while (pc < program.code.size()) {
            if (not self.spend()) {
                return;
            }
            let ref inst: auto = program.code[pc];
            if (inst.is_branch()) {
                let target = self.final_target(program, inst.x);
                if (target != inst.x) {
                    program.set_target(pc, target);
                    self.rewrites += 1;
                    self.stats.threaded_jumps += 1;
                }
            }
            let ref again: auto = program.code[pc];
            if (again.op == OpCode.OpSplit) {
                let target = self.final_target(program, again.y);
                if (target != again.y) {
                    program.set_alternate(pc, target);
                    self.rewrites += 1;
                    self.stats.threaded_jumps += 1;
                }
            }
            pc += 1;
        }
    }

    fn final_target(ref self, program: Program, start: int) -> int {
        var target = start;
        var hops: int = 0;
        while (hops < 32) {
            if (target < 0) {
                return start;
            }
            if (target >= program.code.size()) {
                return start;
            }
            let ref inst: auto = program.code[target];
            if (inst.op != OpCode.OpJump) {
                return target;
            }
            if (inst.x == target) {
                return target;
            }
            target = inst.x;
            hops += 1;
        }
        return target;
    }

    // Reachability from the entry point.  Anything unvisited is replaced with
    // OpFail, which keeps the indices stable - renumbering would mean
    // rewriting every branch in the program.
    fn mark_dead(ref self, ref program: Program) {
        var reachable = vector(bool)();
        reachable.resize(program.code.size());
        var i: int = 0;
        while (i < program.code.size()) {
            reachable[i] = false;
            i += 1;
        }
        var stack = vector(int)();
        stack.push_back(program.start);
        while (not stack.empty()) {
            if (not self.spend()) {
                return;
            }
            let pc = stack.back();
            stack.pop_back();
            if (pc < 0) {
                continue;
            }
            if (pc >= program.code.size()) {
                continue;
            }
            if (reachable[pc]) {
                continue;
            }
            reachable[pc] = true;
            let ref inst: auto = program.code[pc];
            if (inst.op == OpCode.OpMatch) {
                continue;
            }
            if (inst.op == OpCode.OpFail) {
                continue;
            }
            if (inst.op == OpCode.OpJump) {
                stack.push_back(inst.x);
                continue;
            }
            if (inst.op == OpCode.OpSplit) {
                stack.push_back(inst.x);
                stack.push_back(inst.y);
                continue;
            }
            stack.push_back(pc + 1);
        }
        i = 0;
        while (i < program.code.size()) {
            if (not reachable[i]) {
                let ref inst: auto = program.code[i];
                if (inst.op != OpCode.OpFail) {
                    inst.op = OpCode.OpFail;
                    self.rewrites += 1;
                    self.stats.dead_instructions += 1;
                }
            }
            i += 1;
        }
    }

    var stats: OptimiserStats;
    var rewrites: int = 0;
    var work: int = 0;
}

// --- Match results -------------------------------------------------------

class MatchResult {

    fn matched(self) -> bool {
        return self.found;
    }

    fn begin(self) -> int {
        let ref whole: auto = self.groups[0];
        return whole.begin;
    }

    fn end(self) -> int {
        let ref whole: auto = self.groups[0];
        return whole.end;
    }

    fn length(self) -> int {
        return self.end() - self.begin();
    }

    fn group_count(self) -> int {
        return self.groups.size();
    }

    fn group(self, index: int) -> string {
        if (index < 0) {
            return TEXT_EMPTY;
        }
        if (index >= self.groups.size()) {
            return TEXT_EMPTY;
        }
        let ref cap: auto = self.groups[index];
        return cap.text_of(self.subject);
    }

    fn group_begin(self, index: int) -> int {
        if (index >= self.groups.size()) {
            return NONE;
        }
        let ref cap: auto = self.groups[index];
        return cap.begin;
    }

    fn has_group(self, index: int) -> bool {
        if (index >= self.groups.size()) {
            return false;
        }
        let ref cap: auto = self.groups[index];
        return cap.valid();
    }

    fn text(self) -> string {
        return self.group(0);
    }

    fn prefix_text(self) -> string {
        return self.subject.substr(0, self.begin());
    }

    fn suffix_text(self) -> string {
        let from = self.end();
        return self.subject.substr(from, self.subject.size() - from);
    }

    var subject: string;
    var groups: vector(Capture);
    var names: vector(GroupName);
    var found: bool = false;
    var steps: int = 0;
    var status: MatchStatus = MatchStatus.NoMatch;
}

fn empty_result(subject: string) -> MatchResult {
    var r = MatchResult();
    r.subject = subject;
    r.groups.push_back(Capture());
    return r;
}

// --- The engine facade ---------------------------------------------------
//
// `Regex` owns every representation at once: the AST for the backtracker, the
// NFA for the simulator and the compiled program for inspection.  Which one
// runs is decided per call - a pattern with a backreference or a capture
// request has to backtrack, anything else can be simulated in linear time.

choice EngineChoice {
    ChooseAutomatic,
    ForceBacktrack,
    ForceSimulation,
}

class Regex {

    fn valid(self) -> bool {
        return self.ok;
    }

    fn error_text(self) -> string {
        return self.error;
    }

    fn error_offset(self) -> int {
        return self.error_position;
    }

    fn group_count(self) -> int {
        return self.parser.group_count;
    }

    fn pattern_text(self) -> string {
        return self.pattern;
    }

    fn program_size(self) -> int {
        return self.compiler.program.size();
    }

    fn state_count(self) -> int {
        return self.builder.state_count();
    }

    fn literal_prefix(self) -> string {
        return self.prefix;
    }

    // --- Compilation ------------------------------------------------------

    fn compile(ref self, pattern: string) -> bool {
        self.pattern = pattern;
        self.ok = true;
        self.error = ERROR_NONE;
        self.parser = PatternParser();
        self.parser.dot_matches_newline = self.dot_matches_newline;
        self.parser.ignore_case = self.ignore_case;
        let root = self.parser.parse(pattern);
        if (root == NONE) {
            self.ok = false;
            self.error = self.parser.error;
            self.error_position = self.parser.error_position;
            return false;
        }
        self.optimiser = Optimiser();
        Discard(self.optimiser.optimise_tree(self.parser));
        self.prefix = self.optimiser.extract_prefix(self.parser, self.parser.root);
        if (not self.builder.build(self.parser, self.parser.root)) {
            self.ok = false;
            self.error = ERROR_BAD_GROUP;
            return false;
        }
        if (not self.compiler.compile(self.parser)) {
            self.ok = false;
            self.error = ERROR_BAD_GROUP;
            return false;
        }
        Discard(self.optimiser.optimise_program(self.compiler.program));
        self.compiler.program.prefix = self.prefix;
        self.compiler.program.ignore_case = self.ignore_case;
        self.compiler.program.multiline = self.multiline;
        self.anchored = self.compiler.program.anchored;
        return true;
    }

    fn prepare_backtracker(ref self, subject: string) {
        self.matcher = BacktrackMatcher();
        self.matcher.load(self.parser);
        self.matcher.text = subject;
        self.matcher.ignore_case = self.ignore_case;
        self.matcher.multiline = self.multiline;
        self.matcher.budget = BACKTRACK_BUDGET;
    }

    fn prepare_simulator(ref self, subject: string) {
        self.simulator = NfaSimulator();
        self.simulator.load(self.builder);
        self.simulator.text = subject;
        self.simulator.ignore_case = self.ignore_case;
        self.simulator.multiline = self.multiline;
    }

    // The simulator is only usable when the caller does not need captures and
    // the pattern has no backreference.
    fn may_simulate(self, want_captures: bool) -> bool {
        if (self.engine == EngineChoice.ForceBacktrack) {
            return false;
        }
        if (self.engine == EngineChoice.ForceSimulation) {
            return true;
        }
        if (self.builder.has_backreference) {
            return false;
        }
        if (want_captures) {
            return false;
        }
        return true;
    }

    // --- Prefix acceleration ----------------------------------------------
    //
    // Find the next offset at or after `from` where the literal prefix occurs.
    // With no prefix every offset qualifies, so the scan degenerates to the
    // naive one.

    fn next_candidate(self, subject: string, from: int) -> int {
        if (self.prefix.empty()) {
            return from;
        }
        var start = from;
        let limit = subject.size() - self.prefix.size();
        while (start <= limit) {
            var i: int = 0;
            var hit = true;
            while (i < self.prefix.size()) {
                let expected = self.prefix.at(i);
                let actual = subject.at(start + i);
                if (self.ignore_case) {
                    if (not same_char_folded(expected, actual)) {
                        hit = false;
                        break;
                    }
                } else {
                    if (expected != actual) {
                        hit = false;
                        break;
                    }
                }
                i += 1;
            }
            if (hit) {
                return start;
            }
            start += 1;
        }
        return NONE;
    }

    // --- match ------------------------------------------------------------
    //
    // Anchored at both ends: the pattern must describe the whole subject.

    fn match_text(ref self, subject: string) -> MatchResult {
        var result = empty_result(subject);
        if (not self.ok) {
            return result;
        }
        self.prepare_backtracker(subject);
        if (not self.matcher.match_whole()) {
            result.status = self.matcher.status;
            result.steps = self.matcher.steps;
            return result;
        }
        result.found = true;
        result.groups = self.matcher.captures;
        result.names = self.parser.names;
        result.steps = self.matcher.steps;
        result.status = MatchStatus.Matched;
        return result;
    }

    // --- search -----------------------------------------------------------
    //
    // Leftmost match anywhere in the subject.

    fn search(ref self, subject: string) -> MatchResult {
        return self.search_from(subject, 0);
    }

    fn search_from(ref self, subject: string, from: int) -> MatchResult {
        var result = empty_result(subject);
        if (not self.ok) {
            return result;
        }
        if (from > subject.size()) {
            return result;
        }
        self.prepare_backtracker(subject);
        var start = from;
        while (true) {
            if (start > subject.size()) {
                break;
            }
            let candidate = self.next_candidate(subject, start);
            if (candidate == NONE) {
                break;
            }
            if (self.matcher.match_at(candidate)) {
                result.found = true;
                result.groups = self.matcher.captures;
                result.names = self.parser.names;
                result.steps = self.matcher.steps;
                result.status = MatchStatus.Matched;
                return result;
            }
            if (self.matcher.exhausted()) {
                result.status = MatchStatus.Exhausted;
                return result;
            }
            if (self.anchored) {
                // An anchored pattern that failed at the first candidate can
                // never succeed later, unless multiline mode makes every line
                // start a candidate.
                if (not self.multiline) {
                    break;
                }
            }
            start = candidate + 1;
        }
        result.steps = self.matcher.steps;
        return result;
    }

    // Linear time containment test: does the pattern occur at all?  Uses the
    // simulator when it can, because that is where the asymptotic win is.
    fn contains(ref self, subject: string) -> bool {
        if (not self.ok) {
            return false;
        }
        if (self.may_simulate(false)) {
            self.prepare_simulator(subject);
            return self.simulator.search_from(0);
        }
        let found = self.search(subject);
        return found.matched();
    }

    // --- find_all ---------------------------------------------------------
    //
    // Every non-overlapping match, left to right.  An empty match advances
    // the cursor by one so the loop always terminates.

    fn find_all(ref self, subject: string) -> vector(MatchResult) {
        var out = vector(MatchResult)();
        if (not self.ok) {
            return out;
        }
        var cursor: int = 0;
        var guard: int = 0;
        while (cursor <= subject.size()) {
            guard += 1;
            if (guard > subject.size() + 2) {
                break;
            }
            let hit = self.search_from(subject, cursor);
            if (not hit.matched()) {
                break;
            }
            let stop = hit.end();
            let begin = hit.begin();
            out.push_back(hit);
            if (stop == begin) {
                cursor = stop + 1;
            } else {
                cursor = stop;
            }
        }
        return out;
    }

    fn count_matches(ref self, subject: string) -> int {
        let all = self.find_all(subject);
        return all.size();
    }

    // --- replace ----------------------------------------------------------
    //
    // The replacement text may contain `$0` .. `$9`, which stand for the
    // corresponding capture group, and `$$` for a literal dollar.

    fn replace_first(ref self, subject: string, replacement: string) -> string {
        var out = TEXT_EMPTY;
        if (not self.ok) {
            return subject;
        }
        let hit = self.search(subject);
        if (not hit.matched()) {
            return subject;
        }
        out.append(subject.substr(0, hit.begin()));
        out.append(expand_replacement(replacement, hit));
        let tail = hit.end();
        out.append(subject.substr(tail, subject.size() - tail));
        return out;
    }

    fn replace_all(ref self, subject: string, replacement: string) -> string {
        var out = TEXT_EMPTY;
        if (not self.ok) {
            return subject;
        }
        var cursor: int = 0;
        var guard: int = 0;
        while (cursor <= subject.size()) {
            guard += 1;
            if (guard > subject.size() + 2) {
                break;
            }
            let hit = self.search_from(subject, cursor);
            if (not hit.matched()) {
                break;
            }
            let begin = hit.begin();
            let stop = hit.end();
            out.append(subject.substr(cursor, begin - cursor));
            out.append(expand_replacement(replacement, hit));
            if (stop == begin) {
                if (begin < subject.size()) {
                    out.push_back(subject.at(begin));
                }
                cursor = begin + 1;
            } else {
                cursor = stop;
            }
        }
        if (cursor < subject.size()) {
            out.append(subject.substr(cursor, subject.size() - cursor));
        }
        return out;
    }

    // --- split ------------------------------------------------------------
    //
    // Cut the subject at every match.  A limit of zero means "no limit"; any
    // other value caps the number of pieces, with the remainder of the
    // subject forming the last one.

    fn split(ref self, subject: string, limit: int) -> vector(string) {
        var out = vector(string)();
        if (not self.ok) {
            out.push_back(subject);
            return out;
        }
        var cursor: int = 0;
        var guard: int = 0;
        while (cursor <= subject.size()) {
            guard += 1;
            if (guard > subject.size() + 2) {
                break;
            }
            if (limit > 0) {
                if (out.size() + 1 >= limit) {
                    break;
                }
            }
            let hit = self.search_from(subject, cursor);
            if (not hit.matched()) {
                break;
            }
            let begin = hit.begin();
            let stop = hit.end();
            if (stop == begin) {
                // A zero width separator would split between every pair of
                // characters; step over one character instead.
                if (begin >= subject.size()) {
                    break;
                }
                out.push_back(subject.substr(cursor, begin + 1 - cursor));
                cursor = begin + 1;
                continue;
            }
            out.push_back(subject.substr(cursor, begin - cursor));
            cursor = stop;
        }
        out.push_back(subject.substr(cursor, subject.size() - cursor));
        return out;
    }

    // Split and keep only the pieces that are not empty, which is what most
    // tokenising callers actually want.
    fn split_nonempty(ref self, subject: string, limit: int) -> vector(string) {
        let pieces = self.split(subject, limit);
        var out = vector(string)();
        for (piece in pieces) {
            if (not piece.empty()) {
                out.push_back(piece);
            }
        }
        return out;
    }

    // --- Diagnostics ------------------------------------------------------

    fn describe(self) -> string {
        var out = TEXT_EMPTY;
        out.append("pattern ");
        out.append(self.pattern);
        out.append(TEXT_NEWLINE);
        if (not self.ok) {
            out.append("error: ");
            out.append(self.error);
            out.append(" at ");
            out.append(to_string(self.error_position));
            out.append(TEXT_NEWLINE);
            return out;
        }
        out.append("groups: ");
        out.append(to_string(self.parser.group_count));
        out.append(TEXT_NEWLINE);
        out.append("nfa states: ");
        out.append(to_string(self.builder.state_count()));
        out.append(TEXT_NEWLINE);
        out.append("program: ");
        out.append(to_string(self.compiler.program.size()));
        out.append(TEXT_NEWLINE);
        out.append("prefix: ");
        out.append(self.prefix);
        out.append(TEXT_NEWLINE);
        out.append(self.optimiser.stats.describe());
        out.append(TEXT_NEWLINE);
        return out;
    }

    var pattern: string;
    var prefix: string;
    var error: string;
    var parser: PatternParser;
    var builder: NfaBuilder;
    var compiler: Compiler;
    var optimiser: Optimiser;
    var matcher: BacktrackMatcher;
    var simulator: NfaSimulator;
    var engine: EngineChoice = EngineChoice.ChooseAutomatic;
    var error_position: int = 0;
    var ok: bool = false;
    var anchored: bool = false;
    var ignore_case: bool = false;
    var multiline: bool = false;
    var dot_matches_newline: bool = false;
}

// Substitute `$n` references in a replacement template.
fn expand_replacement(template_text: string, hit: MatchResult) -> string {
    var out = TEXT_EMPTY;
    var i: int = 0;
    while (i < template_text.size()) {
        let c = template_text.at(i);
        if (c != CHAR_DOLLAR) {
            out.push_back(c);
            i += 1;
            continue;
        }
        let next = i + 1;
        if (next >= template_text.size()) {
            out.push_back(c);
            i += 1;
            continue;
        }
        let marker = template_text.at(next);
        if (marker == CHAR_DOLLAR) {
            out.push_back(CHAR_DOLLAR);
            i += 2;
            continue;
        }
        if (is_digit(marker)) {
            out.append(hit.group(digit_value(marker)));
            i += 2;
            continue;
        }
        if (marker == CHAR_LBRACE) {
            // `${name}` refers to a named group.
            var scan = next + 1;
            var name = TEXT_EMPTY;
            while (scan < template_text.size()) {
                let n = template_text.at(scan);
                if (n == CHAR_RBRACE) {
                    break;
                }
                name.push_back(n);
                scan += 1;
            }
            var index = NONE;
            for (entry in hit.names) {
                if (entry.name.compare(name) == 0) {
                    index = entry.index;
                    break;
                }
            }
            if (index != NONE) {
                out.append(hit.group(index));
            }
            i = scan + 1;
            continue;
        }
        out.push_back(c);
        i += 1;
    }
    return out;
}

// --- Convenience wrappers ------------------------------------------------
//
// One shot helpers for callers that do not want to keep a compiled pattern
// around.  Each of them pays for compilation, so a loop should build a
// `Regex` once instead.

fn quick_match(pattern: string, subject: string) -> bool {
    var re = Regex();
    if (not re.compile(pattern)) {
        return false;
    }
    let hit = re.match_text(subject);
    return hit.matched();
}

fn quick_search(pattern: string, subject: string) -> bool {
    var re = Regex();
    if (not re.compile(pattern)) {
        return false;
    }
    return re.contains(subject);
}

fn quick_replace(pattern: string, subject: string, replacement: string) -> string {
    var re = Regex();
    if (not re.compile(pattern)) {
        return subject;
    }
    return re.replace_all(subject, replacement);
}

fn quick_split(pattern: string, subject: string) -> vector(string) {
    var re = Regex();
    var out = vector(string)();
    if (not re.compile(pattern)) {
        out.push_back(subject);
        return out;
    }
    return re.split(subject, 0);
}

// Escape every metacharacter in `text` so the result matches it literally.
fn quote_literal(text: string) -> string {
    var out = TEXT_EMPTY;
    var i: int = 0;
    while (i < text.size()) {
        let c = text.at(i);
        if (is_metacharacter(c)) {
            out.push_back(CHAR_BACKSLASH);
        }
        out.push_back(c);
        i += 1;
    }
    return out;
}

// --- Worked examples -----------------------------------------------------
//
// These are not tests - nothing here asserts - but they pin down what the API
// is meant to look like from the outside, and they exercise every entry point
// at least once.

fn example_tokenise_words(subject: string) -> vector(string) {
    var re = Regex();
    if (not re.compile("[a-zA-Z_][a-zA-Z_0-9]*")) {
        return vector(string)();
    }
    var out = vector(string)();
    let hits = re.find_all(subject);
    for (hit in hits) {
        out.push_back(hit.text());
    }
    return out;
}

fn example_strip_comments(subject: string) -> string {
    var re = Regex();
    if (not re.compile("//[^\n]*")) {
        return subject;
    }
    return re.replace_all(subject, TEXT_EMPTY);
}

fn example_parse_date(subject: string) -> vector(int) {
    var out = vector(int)();
    var re = Regex();
    if (not re.compile("(\\d{4})-(\\d{2})-(\\d{2})")) {
        return out;
    }
    let hit = re.match_text(subject);
    if (not hit.matched()) {
        return out;
    }
    out.push_back(parse_int(hit.group(1)));
    out.push_back(parse_int(hit.group(2)));
    out.push_back(parse_int(hit.group(3)));
    return out;
}

fn example_named_groups(subject: string) -> string {
    var re = Regex();
    if (not re.compile("(?<key>\\w+)\\s*=\\s*(?<value>[^;]+);")) {
        return TEXT_EMPTY;
    }
    return re.replace_all(subject, "${value} -> ${key}\n");
}

fn example_split_csv(subject: string) -> vector(string) {
    return quick_split(",\\s*", subject);
}

fn example_repeated_word(subject: string) -> bool {
    var re = Regex();
    // A backreference, so this one has to run on the backtracking matcher.
    if (not re.compile("\\b(\\w+)\\s+\\1\\b")) {
        return false;
    }
    return re.contains(subject);
}

fn example_report(pattern: string) {
    var re = Regex();
    if (not re.compile(pattern)) {
        println(re.error_text());
        return;
    }
    println(re.describe());
    println(re.compiler.program.disassemble());
}

// A rough sanity sweep over the whole engine, written as a function so the
// benchmark corpus contains at least one caller of everything above.
fn self_check() {
    var re = Regex();
    if (not re.compile("^(a|b)+c{2,4}[[:digit:]]*$")) {
        panic(re.error_text());
        return;
    }
    Assert(re.group_count() == 1);
    Assert(re.program_size() > 0);
    Prove(re.state_count() > 0);

    let hit = re.match_text("abbacc42");
    if (hit.matched()) {
        println(hit.text());
    }
    let pieces = quick_split("\\s+", "one two   three");
    for (piece in pieces) {
        println(piece);
    }
    println(quick_replace("[aeiou]", "regular expressions", "*"));
    if (quick_match("\\d+", "12345")) {
        println("all digits");
    }
    if (example_repeated_word("the the end")) {
        println("repeated word found");
    }
    println(quote_literal("1 + 2 * (3 - 4)"));
}

// Slab and free-list memory allocator.
//
// The allocator is organised in three layers:
//
//   * an Arena owns a run of pages and hands out raw, page-aligned extents,
//   * a Slab carves one extent into equally sized blocks tracked by a bitmap,
//   * a FreeList recycles individual blocks and coalesces adjacent neighbours.
//
// Every hot path is written against explicit reference categories so that the
// borrow checker can see exactly which layer owns which byte range at any
// point in time.
namespace memory;

// --- Tuning constants ----------------------------------------------------

let PAGE_SIZE: int = 4096;
let PAGE_SHIFT: int = 12;
let PAGE_MASK: int = 4095;              // 0xFFF
let WORD_BITS: int = 64;
let WORD_SHIFT: int = 6;
let WORD_MASK: int = 63;                // 0x3F
let ALL_ONES: int = -1;                 // every bit set

let MIN_ALIGNMENT: int = 8;
let MAX_ALIGNMENT: int = 4096;
let MIN_BLOCK_SIZE: int = 16;
let MAX_SMALL_SIZE: int = 2048;

let SLAB_TARGET_BLOCKS: int = 64;
let SLAB_MIN_BLOCKS: int = 4;
let SLAB_MAX_BLOCKS: int = 1024;

let ARENA_INITIAL_PAGES: int = 64;
let ARENA_GROWTH_NUMERATOR: int = 3;
let ARENA_GROWTH_DENOMINATOR: int = 2;

// Fixed-point scale for every ratio in this file. A value of 1000 means
// "1.000", a value of 875 means "0.875". No floating point is used anywhere.
let PERMILLE: int = 1000;

// A slab is evicted once its occupancy drops below this permille value and
// the owning cache already holds more than EVICT_KEEP_SLABS partial slabs.
let EVICT_THRESHOLD_PERMILLE: int = 125;
let EVICT_KEEP_SLABS: int = 2;

// Poison patterns written over freed payloads when debug fill is enabled.
let POISON_FREED: int = 221;            // 0xDD
let POISON_FRESH: int = 205;            // 0xCD
let GUARD_MAGIC: int = 3735928559;      // 0xDEADBEEF

let INVALID_INDEX: int = -1;

// --- Enumerations --------------------------------------------------------

choice BlockState {
    Free,
    Allocated,
    Split,
    Quarantined,
}

choice SlabState {
    Fresh,
    Partial,
    Full,
    Retired,
}

choice ClassKind {
    Tiny,
    Small,
    Medium,
    Large,
}

choice ValidationCode {
    Ok,
    BitmapCountMismatch,
    OverlappingBlocks,
    UnalignedBase,
    DanglingFreeNode,
    GuardCorrupted,
    OccupancyOutOfRange,
    ClassSizeMismatch,
}

choice RefillOutcome {
    Reused,
    GrewArena,
    Failed,
}

// --- Alignment helpers ---------------------------------------------------

// Round `value` up to the next multiple of `alignment`. The alignment is
// assumed to be a power of two; callers go through `normalize_alignment`.
fn align_up(value: int, alignment: int) -> int {
    Assert(alignment > 0);
    let mask = alignment - 1;
    return (value + mask) & ^mask;
}

fn align_down(value: int, alignment: int) -> int {
    Assert(alignment > 0);
    let mask = alignment - 1;
    return value & ^mask;
}

fn is_aligned(value: int, alignment: int) -> bool {
    let mask = alignment - 1;
    return (value & mask) == 0;
}

fn alignment_mask(alignment: int) => alignment - 1;

fn is_power_of_two(value: int) -> bool {
    if (value <= 0) {
        return false;
    }
    return (value & (value - 1)) == 0;
}

// Smallest power of two that is greater than or equal to `value`.
fn next_power_of_two(value: int) -> int {
    var result: int = 1;
    while (result < value) {
        result <<= 1;
    }
    return result;
}

fn normalize_alignment(requested: int) -> int {
    if (requested < MIN_ALIGNMENT) {
        return MIN_ALIGNMENT;
    }
    if (requested > MAX_ALIGNMENT) {
        return MAX_ALIGNMENT;
    }
    if (is_power_of_two(requested)) {
        return requested;
    }
    return next_power_of_two(requested);
}

fn page_of(offset: int) => offset >> PAGE_SHIFT;

fn page_base(offset: int) -> int {
    return offset & ^PAGE_MASK;
}

fn pages_for(bytes: int) -> int {
    return (bytes + PAGE_MASK) >> PAGE_SHIFT;
}

// Fixed-point ratio helper: returns `part / whole` scaled by PERMILLE.
fn permille_of(part: int, whole: int) -> int {
    if (whole <= 0) {
        return 0;
    }
    return (part * PERMILLE) / whole;
}

fn word_index(bit: int) => bit >> WORD_SHIFT;

fn bit_within_word(bit: int) => bit & WORD_MASK;

// Population count over a single machine word, using the classic shift and
// mask reduction rather than an intrinsic.
fn popcount_word(word: int) -> int {
    var value = word;
    var count: int = 0;
    while (value != 0) {
        value &= value - 1;
        count += 1;
    }
    return count;
}

fn trailing_zeros(word: int) -> int {
    if (word == 0) {
        return WORD_BITS;
    }
    var value = word;
    var count: int = 0;
    while ((value & 1) == 0) {
        value >>= 1;
        count += 1;
    }
    return count;
}

// --- Size classes --------------------------------------------------------

// One row of the size-class table. `stride` is the distance between two
// consecutive block starts and already accounts for the header guard, while
// `payload` is what the caller actually gets to use.
class SizeClass {

    fn stride_of(self) -> int {
        return self.stride;
    }

    fn payload_of(self) -> int {
        return self.payload;
    }

    fn waste_per_block(self) -> int {
        return self.stride - self.payload;
    }

    fn waste_permille(self) -> int {
        return permille_of(self.waste_per_block(), self.stride);
    }

    fn slab_bytes(self) -> int {
        return align_up(self.stride * self.blocks_per_slab, PAGE_SIZE);
    }

    fn slab_pages(self) -> int {
        return pages_for(self.stride * self.blocks_per_slab);
    }

    fn accepts(self, bytes: int, alignment: int) -> bool {
        if (bytes > self.payload) {
            return false;
        }
        return alignment <= self.alignment;
    }

    fn describe(self) -> string {
        var text = to_string(self.index);
        text.append(": ");
        text.append(to_string(self.payload));
        text.append(" bytes, stride ");
        text.append(to_string(self.stride));
        return text;
    }

    var index: int = 0;
    var payload: int = 0;
    var stride: int = 0;
    var alignment: int = 8;
    var blocks_per_slab: int = 0;
    var kind: ClassKind = ClassKind.Tiny;
}

// The size-class table is immutable once built; every lookup therefore takes
// `&const shared` and returns a `&const` borrow tied to the table itself.
class SizeClassTable {

    fn count(self) -> int {
        return self.classes.size();
    }

    fn largest_payload(self) -> int {
        if (self.classes.empty()) {
            return 0;
        }
        return self.classes.back().payload;
    }

    // Borrow a row out of the table. The returned reference lives exactly as
    // long as the table it came from.
    fn row(self, index: int) -> ref const SizeClass {
        Assert(index >= 0);
        Assert(index < self.classes.size());
        return self.classes[index];
    }

    // Linear scan over a table that is deliberately kept short; the branchy
    // version below beats a binary search for the tiny classes.
    fn class_for(self, bytes: int, alignment: int) -> int {
        if (bytes <= 0) {
            return INVALID_INDEX;
        }
        if (bytes > MAX_SMALL_SIZE) {
            return INVALID_INDEX;
        }
        var index: int = 0;
        while (index < self.classes.size()) {
            let ref candidate: auto = self.classes[index];
            if (candidate.accepts(bytes, alignment)) {
                return index;
            }
            index += 1;
        }
        return INVALID_INDEX;
    }

    // Pick the row directly, returning a borrow rather than an index. Callers
    // that already hold the table alive prefer this form.
    fn best_fit(self, bytes: int) -> ref const SizeClass {
        var index = self.class_for(bytes, MIN_ALIGNMENT);
        if (index == INVALID_INDEX) {
            index = self.classes.size() - 1;
        }
        return self.classes[index];
    }

    fn build(ref self) {
        self.classes.clear();
        var payload = MIN_BLOCK_SIZE;
        var index: int = 0;
        while (payload <= MAX_SMALL_SIZE) {
            var row = SizeClass();
            row.index = index;
            row.payload = payload;
            row.stride = align_up(payload + 8, MIN_ALIGNMENT);
            row.alignment = self.alignment_for(payload);
            row.blocks_per_slab = self.blocks_for(row.stride);
            row.kind = self.kind_for(payload);
            self.classes.push_back(row);
            index += 1;
            payload = self.next_payload(payload);
        }
        Prove(self.classes.size() == index);
    }

    fn next_payload(self, payload: int) -> int {
        if (payload < 128) {
            return payload + 16;
        }
        if (payload < 512) {
            return payload + 64;
        }
        return payload * 2;
    }

    fn alignment_for(self, payload: int) -> int {
        if (payload <= 32) {
            return 8;
        }
        if (payload <= 256) {
            return 16;
        }
        return 64;
    }

    fn kind_for(self, payload: int) -> ClassKind {
        if (payload <= 64) {
            return ClassKind.Tiny;
        }
        if (payload <= 512) {
            return ClassKind.Small;
        }
        if (payload <= MAX_SMALL_SIZE) {
            return ClassKind.Medium;
        }
        return ClassKind.Large;
    }

    fn blocks_for(self, stride: int) -> int {
        var blocks = SLAB_TARGET_BLOCKS;
        if (stride * blocks < PAGE_SIZE) {
            blocks = PAGE_SIZE / stride;
        }
        if (blocks < SLAB_MIN_BLOCKS) {
            blocks = SLAB_MIN_BLOCKS;
        }
        if (blocks > SLAB_MAX_BLOCKS) {
            blocks = SLAB_MAX_BLOCKS;
        }
        return blocks;
    }

    fn total_stride(self) -> int {
        var sum: int = 0;
        for (row in self.classes) {
            sum += row.stride;
        }
        return sum;
    }

    var classes: vector(SizeClass);
}

// --- Free bitmap ---------------------------------------------------------

// Dense bit vector: a set bit means "block in use". The inverse convention
// would make `find_first_free` cheaper but makes the occupancy statistics
// read backwards, and those are consulted far more often in practice.
class Bitmap {

    fn bit_count(self) -> int {
        return self.bits;
    }

    fn word_count(self) -> int {
        return self.words.size();
    }

    fn reset(ref self, bits: int) {
        self.bits = bits;
        self.words.clear();
        self.words.resize(word_index(bits + WORD_MASK));
        for (word in self.words) {
            *word = 0;
        }
        self.set_bits = 0;
        Prove(self.set_bits == 0);
    }

    fn test(self, bit: int) -> bool {
        Assert(bit >= 0);
        Assert(bit < self.bits);
        let word = self.words[word_index(bit)];
        return ((word >> bit_within_word(bit)) & 1) == 1;
    }

    fn mark(ref self, bit: int) {
        Assert(bit < self.bits);
        let ref slot: auto = self.words[word_index(bit)];
        let before = *slot;
        *slot = before | (1 << bit_within_word(bit));
        if (*slot != before) {
            self.set_bits += 1;
        }
        Prove(self.set_bits <= self.bits);
    }

    fn unmark(ref self, bit: int) {
        Assert(bit < self.bits);
        let ref slot: auto = self.words[word_index(bit)];
        let before = *slot;
        *slot = before & ^(1 << bit_within_word(bit));
        if (*slot != before) {
            self.set_bits -= 1;
        }
        Prove(self.set_bits >= 0);
    }

    // Returns the index of the first zero bit, or INVALID_INDEX when the
    // bitmap is saturated.
    fn find_first_free(self) -> int {
        var index: int = 0;
        while (index < self.words.size()) {
            let word = self.words[index];
            if (word != ALL_ONES) {
                let bit = trailing_zeros(^word);
                let absolute = (index << WORD_SHIFT) + bit;
                if (absolute < self.bits) {
                    return absolute;
                }
            }
            index += 1;
        }
        return INVALID_INDEX;
    }

    // Scan for a run of `length` consecutive free bits. Used by the medium
    // classes, where a single request can span several blocks.
    fn find_free_run(self, length: int) -> int {
        var start: int = 0;
        var run: int = 0;
        var index: int = 0;
        while (index < self.bits) {
            if (self.test(index)) {
                run = 0;
                start = index + 1;
            } else {
                run += 1;
                if (run >= length) {
                    return start;
                }
            }
            index += 1;
        }
        return INVALID_INDEX;
    }

    fn mark_run(ref self, start: int, length: int) {
        var index = start;
        while (index < start + length) {
            self.mark(index);
            index += 1;
        }
    }

    fn unmark_run(ref self, start: int, length: int) {
        var index = start;
        while (index < start + length) {
            self.unmark(index);
            index += 1;
        }
    }

    fn popcount(self) -> int {
        var total: int = 0;
        for (word in self.words) {
            total += popcount_word(*word);
        }
        return total;
    }

    fn free_count(self) -> int {
        return self.bits - self.set_bits;
    }

    fn saturated(self) -> bool {
        return self.set_bits >= self.bits;
    }

    fn drained(self) -> bool {
        return self.set_bits == 0;
    }

    // Cheap self-check used by the debug validation pass: the cached counter
    // and the real population count must agree.
    fn counter_is_consistent(self) -> bool {
        return self.popcount() == self.set_bits;
    }

    fn clone_into(self, ref target: Bitmap) {
        target.reset(self.bits);
        var index: int = 0;
        while (index < self.bits) {
            if (self.test(index)) {
                target.mark(index);
            }
            index += 1;
        }
    }

    var words: vector(int);
    var bits: int = 0;
    var set_bits: int = 0;
}

// --- Blocks and the recycled free list -----------------------------------

// A single tracked extent inside an arena. Blocks form an implicit doubly
// linked list ordered by offset so that `coalesce` can merge neighbours in
// constant time.
class Block {

    fn end_offset(self) -> int {
        return self.offset + self.size;
    }

    fn contains(self, address: int) -> bool {
        if (address < self.offset) {
            return false;
        }
        return address < self.end_offset();
    }

    fn adjacent_to(self, other: Block) -> bool {
        if (self.end_offset() == other.offset) {
            return true;
        }
        return other.end_offset() == self.offset;
    }

    fn is_free(self) -> bool {
        return self.state == BlockState.Free;
    }

    fn guard_is_intact(self) -> bool {
        return self.guard == GUARD_MAGIC;
    }

    fn stamp_guard(ref self) {
        self.guard = GUARD_MAGIC;
    }

    fn absorb(ref self, ref other: const Block) {
        Assert(self.adjacent_to(other));
        if (other.offset < self.offset) {
            self.offset = other.offset;
        }
        self.size += other.size;
        self.next = other.next;
    }

    var offset: int = 0;
    var size: int = 0;
    var state: BlockState = BlockState.Free;
    var class_index: int = INVALID_INDEX;
    var slab_index: int = INVALID_INDEX;
    var prev: int = INVALID_INDEX;
    var next: int = INVALID_INDEX;
    var guard: int = 0;
}

// Recycled blocks live here between a `deallocate` and the next matching
// `allocate`. The list is kept sorted by offset, which is what makes the
// adjacent-neighbour coalescing pass a single linear sweep.
class FreeList {

    fn size(self) -> int {
        return self.nodes.size();
    }

    fn empty(self) -> bool {
        return self.nodes.empty();
    }

    fn total_bytes(self) -> int {
        var sum: int = 0;
        for (node in self.nodes) {
            sum += node.size;
        }
        return sum;
    }

    fn largest_block(self) -> int {
        var best: int = 0;
        for (node in self.nodes) {
            if (node.size > best) {
                best = node.size;
            }
        }
        return best;
    }

    // Borrow the node at `index`. The borrow keeps the whole list pinned
    // because the backing vector may reallocate on the next push.
    fn node_at(ref self, index: int) -> ref Block {
        Assert(index >= 0);
        Assert(index < self.nodes.size());
        return self.nodes[index];
    }

    // Mutable variant: exclusive access to one node, still tied to the list.
    fn node_mut(ref self, index: int) -> ref Block {
        Assert(index < self.nodes.size());
        return self.nodes[index];
    }

    // The head is the lowest-addressed free block, so it is the one the
    // bump path prefers.
    fn head(ref self) -> ref Block {
        Assert(self.nodes.empty() == false);
        return self.nodes.front();
    }

    fn tail(ref self) -> ref Block {
        Assert(self.nodes.empty() == false);
        return self.nodes.back();
    }

    fn insertion_point(self, offset: int) -> int {
        var index: int = 0;
        while (index < self.nodes.size()) {
            let ref node: auto = self.nodes[index];
            if (node.offset > offset) {
                return index;
            }
            index += 1;
        }
        return self.nodes.size();
    }

    fn push_sorted(ref self, block: Block) {
        let at = self.insertion_point(block.offset);
        self.nodes.insert(at, block);
        self.bytes += block.size;
        Prove(self.bytes >= 0);
    }

    fn push_back_raw(ref self, block: Block) {
        self.bytes += block.size;
        self.nodes.push_back(block);
    }

    fn pop_front(ref self) -> Block {
        Assert(self.nodes.empty() == false);
        var result = self.nodes.front();
        self.bytes -= result.size;
        self.nodes.erase(0);
        return move(result);
    }

    fn remove_at(ref self, index: int) -> Block {
        Assert(index < self.nodes.size());
        var result = self.nodes[index];
        self.bytes -= result.size;
        self.nodes.erase(index);
        return move(result);
    }

    // First-fit search. Returns an index rather than a borrow so that the
    // caller stays free to mutate the list immediately afterwards.
    fn find_fit(self, bytes: int, alignment: int) -> int {
        var index: int = 0;
        while (index < self.nodes.size()) {
            let ref node: auto = self.nodes[index];
            if (node.is_free()) {
                let aligned = align_up(node.offset, alignment);
                let overhead = aligned - node.offset;
                if (node.size >= bytes + overhead) {
                    return index;
                }
            }
            index += 1;
        }
        return INVALID_INDEX;
    }

    // Best-fit search: smallest block that still satisfies the request.
    fn find_best(self, bytes: int) -> int {
        var best = INVALID_INDEX;
        var best_size: int = 0;
        var index: int = 0;
        while (index < self.nodes.size()) {
            let ref node: auto = self.nodes[index];
            if (node.is_free() and node.size >= bytes) {
                if (best == INVALID_INDEX or node.size < best_size) {
                    best = index;
                    best_size = node.size;
                }
            }
            index += 1;
        }
        return best;
    }

    // Split `index` into an allocated prefix of `bytes` and a free remainder.
    // The remainder is only kept when it is large enough to ever be handed
    // out again; otherwise the slack is charged to the allocation.
    fn split_at(ref self, index: int, bytes: int) -> Block {
        var node = self.remove_at(index);
        let leftover = node.size - bytes;
        if (leftover >= MIN_BLOCK_SIZE) {
            var remainder = Block();
            remainder.offset = node.offset + bytes;
            remainder.size = leftover;
            remainder.state = BlockState.Free;
            remainder.slab_index = node.slab_index;
            remainder.class_index = node.class_index;
            remainder.stamp_guard();
            node.size = bytes;
            self.push_sorted(remainder);
        }
        node.state = BlockState.Allocated;
        return move(node);
    }

    // Single linear sweep merging every pair of touching free blocks. The
    // list is sorted, so one pass is enough; the returned count feeds the
    // fragmentation statistics.
    fn coalesce(ref self) -> int {
        if (self.nodes.size() < 2) {
            return 0;
        }
        var merged: int = 0;
        var index: int = 0;
        while (index + 1 < self.nodes.size()) {
            let ref left: auto = self.nodes[index];
            let ref right: auto = self.nodes[index + 1];
            var can_merge = left.is_free() and right.is_free();
            if (can_merge) {
                can_merge = left.end_offset() == right.offset;
            }
            if (can_merge) {
                can_merge = left.slab_index == right.slab_index;
            }
            if (can_merge) {
                var absorbed = self.remove_at(index + 1);
                let ref target: auto = self.nodes[index];
                target.size += absorbed.size;
                target.next = absorbed.next;
                self.bytes += absorbed.size;
                Destroy(absorbed);
                merged += 1;
            } else {
                index += 1;
            }
        }
        self.merge_events += merged;
        Prove(self.merge_events >= merged);
        return merged;
    }

    // Drop every node that belongs to a slab which is going away.
    fn evict_slab(ref self, slab_index: int) -> int {
        var removed: int = 0;
        var index: int = 0;
        while (index < self.nodes.size()) {
            let ref node: auto = self.nodes[index];
            if (node.slab_index == slab_index) {
                var dead = self.remove_at(index);
                Discard(dead);
                removed += 1;
            } else {
                index += 1;
            }
        }
        return removed;
    }

    fn quarantine(ref self, index: int) {
        let ref node: auto = self.nodes[index];
        node.state = BlockState.Quarantined;
        self.quarantined += 1;
    }

    fn release_quarantine(ref self) -> int {
        var released: int = 0;
        for (node in self.nodes) {
            if (node.state == BlockState.Quarantined) {
                node.state = BlockState.Free;
                released += 1;
            }
        }
        self.quarantined -= released;
        Prove(self.quarantined >= 0);
        return released;
    }

    fn clear(ref self) {
        self.nodes.clear();
        self.bytes = 0;
        self.quarantined = 0;
    }

    var nodes: vector(Block);
    var bytes: int = 0;
    var quarantined: int = 0;
    var merge_events: int = 0;
}

// --- Slabs ---------------------------------------------------------------

// One slab owns a contiguous run of blocks of a single size class. The
// bitmap is the authority on which blocks are live; the free list only ever
// holds blocks that were handed back out of order.
class Slab {

    fn block_count(self) -> int {
        return self.blocks;
    }

    fn free_count(self) -> int {
        return self.blocks - self.used;
    }

    fn used_count(self) -> int {
        return self.used;
    }

    fn is_empty(self) -> bool {
        return self.used == 0;
    }

    fn is_full(self) -> bool {
        return self.used >= self.blocks;
    }

    fn base_(self) -> int {
        return self.base_offset;
    }

    fn limit(self) -> int {
        return self.base_offset + self.blocks * self.stride;
    }

    fn owns(self, offset: int) -> bool {
        if (offset < self.base_offset) {
            return false;
        }
        return offset < self.limit();
    }

    fn block_index_of(self, offset: int) -> int {
        Assert(self.owns(offset));
        return (offset - self.base_offset) / self.stride;
    }

    fn offset_of_block(self, index: int) -> int {
        Assert(index >= 0);
        Assert(index < self.blocks);
        return self.base_offset + index * self.stride;
    }

    fn occupancy_permille(self) -> int {
        return permille_of(self.used, self.blocks);
    }

    fn bytes_live(self) -> int {
        return self.used * self.payload;
    }

    fn bytes_reserved(self) -> int {
        return self.blocks * self.stride;
    }

    fn internal_waste(self) -> int {
        return self.used * (self.stride - self.payload);
    }

    // Borrow the bitmap for reading. Statistics code walks it without ever
    // needing write access.
    fn map(ref self) -> ref Bitmap {
        return self.bitmap;
    }

    // Exclusive borrow used by the allocation fast path.
    fn map_mut(ref self) -> ref Bitmap {
        return self.bitmap;
    }

    fn recycled(ref self) -> ref FreeList {
        return self.local_free;
    }

    fn initialize(ref self, base_: int, row: SizeClass, index: int) {
        self.base_offset = align_up(base_, row.alignment);
        self.stride = row.stride;
        self.payload = row.payload;
        self.alignment = row.alignment;
        self.class_index = row.index;
        self.slab_index = index;
        self.blocks = row.blocks_per_slab;
        self.used = 0;
        self.state = SlabState.Fresh;
        self.bitmap.reset(self.blocks);
        self.local_free.clear();
        Assert(is_aligned(self.base_offset, self.alignment));
        Prove(self.used <= self.blocks);
    }

    // Fast path: take the lowest free bit. Returns the byte offset, or
    // INVALID_INDEX when the slab is saturated.
    fn take_block(ref self) -> int {
        if (self.is_full()) {
            return INVALID_INDEX;
        }
        if (self.local_free.empty() == false) {
            var recycled_block = self.local_free.pop_front();
            let offset = recycled_block.offset;
            let index = self.block_index_of(offset);
            self.bitmap.mark(index);
            self.used += 1;
            self.hits += 1;
            Destroy(recycled_block);
            return offset;
        }
        let index = self.bitmap.find_first_free();
        if (index == INVALID_INDEX) {
            self.state = SlabState.Full;
            return INVALID_INDEX;
        }
        self.bitmap.mark(index);
        self.used += 1;
        self.misses += 1;
        if (self.is_full()) {
            self.state = SlabState.Full;
        } else {
            self.state = SlabState.Partial;
        }
        Prove(self.used <= self.blocks);
        return self.offset_of_block(index);
    }

    // Multi-block reservation for the medium classes.
    fn take_run(ref self, count: int) -> int {
        if (self.free_count() < count) {
            return INVALID_INDEX;
        }
        let start = self.bitmap.find_free_run(count);
        if (start == INVALID_INDEX) {
            return INVALID_INDEX;
        }
        self.bitmap.mark_run(start, count);
        self.used += count;
        Prove(self.used <= self.blocks);
        return self.offset_of_block(start);
    }

    fn give_block(ref self, offset: int) {
        Assert(self.owns(offset));
        let index = self.block_index_of(offset);
        if (self.bitmap.test(index) == false) {
            panic("double free detected in slab");
            return;
        }
        self.bitmap.unmark(index);
        self.used -= 1;
        if (self.used == 0) {
            self.state = SlabState.Fresh;
        } else {
            self.state = SlabState.Partial;
        }
        Prove(self.used >= 0);
    }

    // Hand the block back through the local free list instead of clearing
    // the bit immediately. Keeps recently freed blocks hot in cache.
    fn defer_block(ref self, offset: int) {
        Assert(self.owns(offset));
        var node = Block();
        node.offset = offset;
        node.size = self.stride;
        node.state = BlockState.Free;
        node.slab_index = self.slab_index;
        node.class_index = self.class_index;
        node.stamp_guard();
        self.bitmap.unmark(self.block_index_of(offset));
        self.used -= 1;
        self.local_free.push_sorted(node);
        Prove(self.used >= 0);
    }

    fn give_run(ref self, offset: int, count: int) {
        let start = self.block_index_of(offset);
        self.bitmap.unmark_run(start, count);
        self.used -= count;
        Prove(self.used >= 0);
    }

    fn drain_local(ref self) -> int {
        let merged = self.local_free.coalesce();
        self.local_free.clear();
        return merged;
    }

    fn retire(ref self) {
        Assert(self.is_empty());
        self.state = SlabState.Retired;
        self.local_free.clear();
        self.bitmap.reset(0);
        self.blocks = 0;
    }

    fn should_evict(self) -> bool {
        if (self.state == SlabState.Retired) {
            return false;
        }
        if (self.is_empty()) {
            return true;
        }
        return self.occupancy_permille() < EVICT_THRESHOLD_PERMILLE;
    }

    fn hit_ratio_permille(self) -> int {
        return permille_of(self.hits, self.hits + self.misses);
    }

    fn describe(self) -> string {
        var text = "slab ";
        text.append(to_string(self.slab_index));
        text.append(" class ");
        text.append(to_string(self.class_index));
        text.append(" used ");
        text.append(to_string(self.used));
        text.append("/");
        text.append(to_string(self.blocks));
        return text;
    }

    var bitmap: Bitmap;
    var local_free: FreeList;
    var base_offset: int = 0;
    var stride: int = 0;
    var payload: int = 0;
    var alignment: int = 8;
    var blocks: int = 0;
    var used: int = 0;
    var class_index: int = INVALID_INDEX;
    var slab_index: int = INVALID_INDEX;
    var state: SlabState = SlabState.Fresh;
    var hits: int = 0;
    var misses: int = 0;
}


// Prefix-tree text index.
//
// This file collects the four data structures that a practical text index is
// usually built out of, plus the query layers that sit on top of them:
//
//   * `Trie{V, ALPHABET}`        -- a classic array-mapped trie.  Every node
//                                   owns a dense child slot table of exactly
//                                   `ALPHABET` entries plus a sparse
//                                   `map{char, int}` overflow map for symbols
//                                   that fall outside the dense alphabet.
//   * `RadixTree{V, ALPHABET}`   -- the path-compressed (Patricia) variant.
//                                   Each edge carries a whole label rather
//                                   than a single character, so insertion has
//                                   to split labels and deletion has to merge
//                                   them back together again.
//   * `TernaryTree{V}`           -- a ternary search tree, which trades the
//                                   fan-out of a trie for three-way branching
//                                   and a much smaller memory footprint.
//   * `Autocomplete{V, ALPHABET}`-- the ranking layer.  Completions are drawn
//                                   from a trie, scored by a stored weight,
//                                   and reduced to the best `k` by a bounded
//                                   selection pass.
//
// Every structure is arena based: nodes live in a flat
// `vector{TrieNode{V, ALPHABET}}` and every link is an integer index into that
// arena, with `TRIE_NIL` (-1) standing for "no such node".  Index links keep
// the whole index relocatable, which is what makes the flat-array
// serialisation at the bottom of the file a straight copy rather than a
// pointer fix-up pass.
//
// Two parameters are threaded through nearly every declaration:
//
//   * `V`        -- the payload type stored at terminal nodes,
//   * `ALPHABET` -- a non-type parameter giving the width of the dense child
//                   table.  26 indexes lowercase ASCII, 128 indexes the whole
//                   ASCII range, and 256 indexes raw bytes.
//
// Weights and scores are fixed-point integers scaled by `WEIGHT_SCALE`
// (1000), so a weight of `2500` means 2.5.  No floating point appears
// anywhere in this file.
namespace trie;

// --- Enumerations ---------------------------------------------------------

// What an insertion did to the index.
choice TrieOutcome {
    Inserted,
    Replaced,
    Rejected,
    Overflowed,
}

// The role a node plays in the structure it belongs to.
choice NodeKind {
    Branch,
    Terminal,
    Compressed,
    Pruned,
}

// What happened to an edge label during a radix-tree mutation.
choice EdgeAction {
    NoAction,
    LabelSplit,
    LabelMerged,
    ChildAdopted,
    EdgeRemoved,
}

// How a query result was obtained.
choice MatchKind {
    ExactMatch,
    PrefixMatch,
    FuzzyMatch,
    NoMatch,
}

// Ordering applied by the ranking layer before top-k selection.
choice RankOrder {
    ByWeightDescending,
    ByWeightAscending,
    Lexicographic,
    ByDepth,
}

// Record tags used by the flat-array serialisation.
choice SerialTag {
    TagEmpty,
    TagBranch,
    TagLeaf,
    TagEdge,
    TagPayload,
}

// Result of a visitor callback during a traversal.
choice WalkState {
    Continue,
    Skip,
    Stop,
}

// Which of the three ternary-search-tree links to follow next.
choice TernaryLink {
    LowLink,
    EqualLink,
    HighLink,
}

// --- Tuning constants -----------------------------------------------------

// Sentinel index meaning "no node".  Negative so it can never index an arena.
let TRIE_NIL: int = -1;

// Dense alphabet widths that the file instantiates.
let ALPHABET_LOWER: int = 26;
let ALPHABET_ASCII: int = 128;
let ALPHABET_BYTE: int = 256;

// Arena capacity used when an index is built without a size hint.
let TRIE_INITIAL_CAPACITY: int = 64;

// Growth factor for the node arena, as a percentage, so no floating point is
// required to resize.
let TRIE_GROWTH_PERCENT: int = 200;

// Hard cap on how deep any walk is allowed to go.  Traversal stacks are sized
// from this up front so they never reallocate mid-walk.
let TRIE_MAX_DEPTH: int = 256;

// Longest key the index will accept.  Keys past this are rejected rather than
// silently truncated.
let TRIE_MAX_KEY_LENGTH: int = 192;

// Fixed-point scale for weights and scores: a stored weight of 1000 is 1.0.
let WEIGHT_SCALE: int = 1000;

// Default weight given to a key inserted without one.
let WEIGHT_DEFAULT: int = 1000;

// Weight floor, so a decayed entry never becomes exactly zero and drops out
// of the ranking entirely.
let WEIGHT_FLOOR: int = 1;

// Percentage of its weight an entry keeps when the whole index is decayed.
let WEIGHT_DECAY_PERCENT: int = 90;

// Bonus, in scaled units, applied to a completion that matched exactly.
let SCORE_EXACT_BONUS: int = 5000;

// Penalty, in scaled units, charged per edit in a fuzzy match.
let SCORE_EDIT_PENALTY: int = 1200;

// Penalty per character of unmatched suffix, so short completions rank above
// long ones when the weights tie.
let SCORE_LENGTH_PENALTY: int = 40;

// Default number of completions returned by the ranking layer.
let DEFAULT_TOP_K: int = 8;

// Upper bound on `k` regardless of what the caller asks for.
let MAX_TOP_K: int = 64;

// Default edit-distance budget for the fuzzy walk.
let DEFAULT_EDIT_BUDGET: int = 2;

// Hard cap on the edit budget; beyond this the walk degenerates into a full
// scan and the ranking is meaningless.
let MAX_EDIT_BUDGET: int = 4;

// Number of sampled completions the statistics pass is allowed to retain.
let TRIE_SAMPLE_LIMIT: int = 8;

// Radix labels shorter than this are never split further; the child is
// adopted wholesale instead.
let RADIX_MIN_LABEL: int = 1;

// Histogram bucket count for the fan-out distribution.
let FANOUT_BUCKETS: int = 9;

// --- Character constants --------------------------------------------------

// Character-level code compares raw symbols on nearly every line, so each
// significant character is named once here and referred to by name below.
let CHAR_NUL: char = '\0';
let CHAR_TAB: char = '\t';
let CHAR_NEWLINE: char = '\n';
let CHAR_RETURN: char = '\r';
let CHAR_SPACE: char = ' ';
let CHAR_MINUS: char = '-';
let CHAR_UNDERSCORE: char = '_';
let CHAR_DOT: char = '.';
let CHAR_SLASH: char = '/';
let CHAR_STAR: char = '*';
let CHAR_QUESTION: char = '?';
let CHAR_HASH: char = '#';
let CHAR_ZERO: char = '0';
let CHAR_NINE: char = '9';
let CHAR_LOWER_A: char = 'a';
let CHAR_LOWER_Z: char = 'z';
let CHAR_UPPER_A: char = 'A';
let CHAR_UPPER_Z: char = 'Z';

// The apostrophe has to be spelled as a one-character string: the escaped
// character literal form is not accepted by the lexer.
let APOSTROPHE: string = "'";

// Sentinel appended to a key before it is written into the flat serialised
// form, marking the end of one record.
let SERIAL_TERMINATOR: char = '\0';

// --- Character classification ---------------------------------------------

// True for the 26 lowercase ASCII letters, which is the dense alphabet used
// by every `ALPHABET_LOWER` instantiation.
fn is_lower(c: char) -> bool {
    return c >= CHAR_LOWER_A and c <= CHAR_LOWER_Z;
}

fn is_upper(c: char) -> bool {
    return c >= CHAR_UPPER_A and c <= CHAR_UPPER_Z;
}

fn is_digit(c: char) -> bool {
    return c >= CHAR_ZERO and c <= CHAR_NINE;
}

fn is_letter(c: char) -> bool {
    return is_lower(c) or is_upper(c);
}

// Word characters are what the tokeniser keeps; everything else is a break.
fn is_word_char(c: char) -> bool {
    if (is_letter(c)) {
        return true;
    }
    if (is_digit(c)) {
        return true;
    }
    if (c == CHAR_UNDERSCORE) {
        return true;
    }
    if (c == CHAR_MINUS) {
        return true;
    }
    return false;
}

fn is_space(c: char) -> bool {
    if (c == CHAR_SPACE) {
        return true;
    }
    if (c == CHAR_TAB) {
        return true;
    }
    if (c == CHAR_NEWLINE) {
        return true;
    }
    if (c == CHAR_RETURN) {
        return true;
    }
    return false;
}

// Case folding.  Only ASCII is handled; anything else passes through.
fn to_lower(c: char) -> char {
    if (is_upper(c)) {
        return c + (CHAR_LOWER_A - CHAR_UPPER_A);
    }
    return c;
}

fn to_upper(c: char) -> char {
    if (is_lower(c)) {
        return c - (CHAR_LOWER_A - CHAR_UPPER_A);
    }
    return c;
}

// --- Alphabet mapping -----------------------------------------------------

// Maps a character onto a dense child slot, or `TRIE_NIL` when the character
// falls outside the dense range and has to live in the sparse overflow map.
//
// The mapping depends on the alphabet width, which is why it is a template
// over the non-type parameter rather than a plain function.
fn slot_of[ALPHABET: int]
    (c: char) -> int {
    if (ALPHABET == 26) {
        if (is_lower(c)) {
            return c - CHAR_LOWER_A;
        }
        if (is_upper(c)) {
            return to_lower(c) - CHAR_LOWER_A;
        }
        return TRIE_NIL;
    }
    if (c < 0) {
        return TRIE_NIL;
    }
    if (c >= ALPHABET) {
        return TRIE_NIL;
    }
    return c;
}

// Inverse of `slot_of`: turns a dense slot back into the character it stands
// for.  Used by every routine that has to rebuild a key from a path.
fn char_of_slot[ALPHABET: int]
    (slot: int) -> char {
    if (ALPHABET == 26) {
        return CHAR_LOWER_A + slot;
    }
    return slot;
}

// True when `c` can be stored in a dense slot at this alphabet width.
fn in_alphabet[ALPHABET: int]
    (c: char) -> bool {
    return slot_of(ALPHABET)(c) != TRIE_NIL;
}

// Normalises a whole key: case folded, with every character outside the
// alphabet dropped.  Returns the folded key and the number of characters that
// were discarded.
fn normalize_key[ALPHABET: int]
    (key: string) -> pair(string, int) {
    var out = string();
    var dropped: int = 0;
    var index: int = 0;
    while (index < key.size()) {
        let c = to_lower(key.at(index));
        if (in_alphabet(ALPHABET)(c)) {
            out.push_back(c);
        } else {
            dropped += 1;
        }
        index += 1;
    }
    return pair(string, int)({.first = out, .second = dropped});
}

// --- String helpers -------------------------------------------------------

// Length of the longest common prefix of two strings, in characters.
fn common_prefix_length(a: string, b: string) -> int {
    var index: int = 0;
    let limit = min(a.size(), b.size());
    while (index < limit) {
        if (a.at(index) != b.at(index)) {
            return index;
        }
        index += 1;
    }
    return limit;
}

// True when `whole` begins with `prefix`.
fn starts_with(whole: string, prefix: string) -> bool {
    if (prefix.size() > whole.size()) {
        return false;
    }
    return common_prefix_length(whole, prefix) == prefix.size();
}

// Lexicographic three-way comparison, so the ranking layer has a total order
// to fall back on when two weights tie.
fn compare_strings(a: string, b: string) -> int {
    let shared_len = common_prefix_length(a, b);
    if (shared_len < a.size() and shared_len < b.size()) {
        if (a.at(shared_len) < b.at(shared_len)) {
            return -1;
        }
        return 1;
    }
    if (a.size() < b.size()) {
        return -1;
    }
    if (a.size() > b.size()) {
        return 1;
    }
    return 0;
}

// Concatenation that does not disturb either operand.
fn concat(a: string, b: string) -> string {
    var out = string();
    out.append(a);
    out.append(b);
    return out;
}

// `text` with one character appended, returned by value.
fn push_char(text: string, c: char) -> string {
    var out = string();
    out.append(text);
    out.push_back(c);
    return out;
}

// Splits `text` on every run of non-word characters, which is how a document
// is turned into the key stream an index is built from.
fn tokenize(text: string) -> vector(string) {
    var out = vector(string)();
    var current = string();
    var index: int = 0;
    while (index < text.size()) {
        let c = to_lower(text.at(index));
        if (is_word_char(c)) {
            current.push_back(c);
        } else {
            if (current.size() > 0) {
                out.push_back(current);
                current.clear();
            }
        }
        index += 1;
    }
    if (current.size() > 0) {
        out.push_back(current);
    }
    Destroy(current);
    return out;
}

// --- Trie node ------------------------------------------------------------

// One node of the array-mapped trie.
//
// The dense `children` vector always has exactly `ALPHABET` entries, each of
// them a node index or `TRIE_NIL`.  Characters that do not map into the dense
// range go into `overflow`, a `map{char, int}` that is empty for the vast
// majority of nodes.  Keeping both means the structure stays exact for
// arbitrary input without paying 256 slots per node when the input happens to
// be lowercase words.
class TrieNode(V: type, ALPHABET: int)
{

    // --- Capacity ---------------------------------------------------------

    fn width(self) -> int {
        return ALPHABET;
    }

    fn is_terminal(self) -> bool {
        return self.terminal;
    }

    fn is_leaf(self) -> bool {
        return self.degree() == 0;
    }

    // Number of dense slots that are occupied.
    fn dense_degree(self) -> int {
        var found: int = 0;
        var slot: int = 0;
        while (slot < ALPHABET) {
            if (self.children[slot] != TRIE_NIL) {
                found += 1;
            }
            slot += 1;
        }
        return found;
    }

    fn sparse_degree(self) -> int {
        return self.overflow.size();
    }

    fn degree(self) -> int {
        return self.dense_degree() + self.sparse_degree();
    }

    // A node can be pruned once it holds no payload and has no children left.
    fn prunable(self) -> bool {
        if (self.terminal) {
            return false;
        }
        return self.degree() == 0;
    }

    // --- Child access -----------------------------------------------------

    // Child reached by following `c`, or `TRIE_NIL`.  Dense slots are checked
    // first because that is the overwhelmingly common case.
    fn child_for(self, c: char) -> int {
        let slot = slot_of(ALPHABET)(c);
        if (slot != TRIE_NIL) {
            return self.children[slot];
        }
        if (self.overflow.contains(c)) {
            return self.overflow.at(c);
        }
        return TRIE_NIL;
    }

    fn child_at_slot(self, slot: int) -> int {
        if (slot < 0) {
            return TRIE_NIL;
        }
        if (slot >= ALPHABET) {
            return TRIE_NIL;
        }
        return self.children[slot];
    }

    // Installs `node` as the child reached by `c`, routing through whichever
    // of the two tables can hold it.
    fn attach(ref self, c: char, node: int) -> bool {
        let slot = slot_of(ALPHABET)(c);
        if (slot != TRIE_NIL) {
            let existed = self.children[slot] != TRIE_NIL;
            self.children[slot] = node;
            if (not existed) {
                self.live_children += 1;
            }
            return not existed;
        }
        let fresh = not self.overflow.contains(c);
        Discard(self.overflow.insert(c, node));
        if (fresh) {
            self.live_children += 1;
        }
        return fresh;
    }

    // Removes the link for `c` without touching the child node itself.
    fn detach(ref self, c: char) -> bool {
        let slot = slot_of(ALPHABET)(c);
        if (slot != TRIE_NIL) {
            if (self.children[slot] == TRIE_NIL) {
                return false;
            }
            self.children[slot] = TRIE_NIL;
            self.live_children -= 1;
            return true;
        }
        if (not self.overflow.contains(c)) {
            return false;
        }
        Discard(self.overflow.erase(c));
        self.live_children -= 1;
        return true;
    }

    // Every outgoing edge as a (character, node index) pair, dense slots in
    // alphabet order first and overflow entries after them.
    fn edges(self) -> vector(pair(char, int)) {
        var out = vector(pair(char, int))();
        var slot: int = 0;
        while (slot < ALPHABET) {
            if (self.children[slot] != TRIE_NIL) {
                out.push_back(pair(char, int)({.first = char_of_slot(ALPHABET)(slot),
                                              .second = self.children[slot]}));
            }
            slot += 1;
        }
        for (entry in self.overflow) {
            out.push_back(pair(char, int)({.first = entry.first, .second = entry.second}));
        }
        return out;
    }

    // First occupied dense slot at or after `from`, or `TRIE_NIL`.
    fn next_slot(self, from: int) -> int {
        var slot = from;
        while (slot < ALPHABET) {
            if (self.children[slot] != TRIE_NIL) {
                return slot;
            }
            slot += 1;
        }
        return TRIE_NIL;
    }

    // --- Bookkeeping ------------------------------------------------------

    // Returns the node to its post-construction state, keeping the dense
    // table allocated so a recycled node does not have to resize it again.
    fn reset(ref self) {
        var slot: int = 0;
        while (slot < ALPHABET) {
            self.children[slot] = TRIE_NIL;
            slot += 1;
        }
        self.overflow.clear();
        self.terminal = false;
        self.weight = 0;
        self.subtree_weight = 0;
        self.subtree_keys = 0;
        self.live_children = 0;
        self.parent = TRIE_NIL;
        self.edge_char = CHAR_NUL;
        self.depth = 0;
        self.kind = NodeKind.Branch;
    }

    // Grows the dense table to the full alphabet width.  Called once when a
    // node is handed out by the arena.
    fn initialize(ref self, parent: int, edge: char, depth: int) {
        self.children.resize(ALPHABET);
        var slot: int = 0;
        while (slot < ALPHABET) {
            self.children[slot] = TRIE_NIL;
            slot += 1;
        }
        self.parent = parent;
        self.edge_char = edge;
        self.depth = depth;
        self.kind = NodeKind.Branch;
        self.live = true;
    }

    fn mark_terminal(ref self, value: V, weight: int) {
        self.payload = value;
        self.weight = weight;
        self.terminal = true;
        self.kind = NodeKind.Terminal;
    }

    fn clear_terminal(ref self) {
        self.terminal = false;
        self.weight = 0;
        self.kind = NodeKind.Branch;
    }

    // Dense child slots.  Always exactly `ALPHABET` entries once initialised.
    var children: vector(int);

    // Sparse spill-over for characters outside the dense alphabet.
    var overflow: map(char, int);

    // Payload, meaningful only when `terminal` is set.
    var payload: V;

    // Scaled weight of this key, and the aggregate weight of the subtree
    // rooted here.  The aggregate is what the ranking layer prunes against.
    var weight: int = 0;
    var subtree_weight: int = 0;
    var subtree_keys: int = 0;

    var live_children: int = 0;
    var parent: int = -1;
    var edge_char: char = '\0';
    var depth: int = 0;
    var terminal: bool = false;
    var live: bool = false;
    var kind: NodeKind = NodeKind.Branch;
}

// --- Query results --------------------------------------------------------

// One completion produced by a prefix or fuzzy query, before ranking.
class Completion(V: type)
{

    fn better_than(self, other: Completion(V)) -> bool {
        if (self.score != other.score) {
            return self.score > other.score;
        }
        return compare_strings(self.key, other.key) < 0;
    }

    fn describe(self) -> string {
        var text = string();
        text.append(self.key);
        text.append(" score=");
        text.append(to_string(self.score));
        text.append(" edits=");
        text.append(to_string(self.edits));
        return text;
    }

    var key: string;
    var value: V;
    var score: int = 0;
    var weight: int = 0;
    var edits: int = 0;
    var node: int = -1;
    var kind: MatchKind = MatchKind.NoMatch;
}

// Result of walking a key as far as the index allows.
class WalkResult(V: type)
{

    fn complete(self) -> bool {
        return self.consumed == self.requested;
    }

    fn describe(self) -> string {
        var text = string();
        text.append("consumed=");
        text.append(to_string(self.consumed));
        text.append(" of ");
        text.append(to_string(self.requested));
        return text;
    }

    // Payload of the deepest terminal the walk passed through.
    var payload: V;

    var node: int = -1;
    var consumed: int = 0;
    var requested: int = 0;
    var last_terminal: int = -1;
    var last_terminal_length: int = 0;
    var kind: MatchKind = MatchKind.NoMatch;
}

// --- The trie -------------------------------------------------------------

// Array-mapped trie mapping `string` keys onto `V` payloads.
//
// The arena is a `vector{TrieNode{V, ALPHABET}}`; node zero is the root and is
// never released.  Freed nodes are threaded onto `free_list` through their
// `parent` field so that a long-lived index does not grow without bound as
// keys come and go.
class Trie(V: type, ALPHABET: int)
{

    // --- Basic accessors --------------------------------------------------

    fn size(self) -> int {
        return self.count;
    }

    fn empty(self) -> bool {
        return self.count == 0;
    }

    fn node_count(self) -> int {
        return self.nodes.size() - self.free_count;
    }

    fn alphabet_width(self) -> int {
        return ALPHABET;
    }

    fn root_index(self) -> int {
        return self.root;
    }

    // Borrowed view of one node, so callers can inspect fan-out without
    // copying the dense child table.
    fn node_at(ref self, index: int) -> ref TrieNode(V, ALPHABET) {
        return self.nodes[index];
    }

    // --- Arena ------------------------------------------------------------

    fn reserve(ref self, capacity: int) {
        self.nodes.reserve(capacity);
    }

    // Makes sure the root exists.  Every mutating entry point calls this
    // first, so a default-constructed index is usable straight away.
    fn ensure_root(ref self) {
        if (self.root != TRIE_NIL) {
            return;
        }
        self.nodes.push_back(TrieNode(V, ALPHABET)());
        self.root = self.nodes.size() - 1;
        self.nodes[self.root].initialize(TRIE_NIL, CHAR_NUL, 0);
    }

    // Hands out a node, recycling from the free list when possible.
    fn allocate_node(ref self, parent: int, edge: char, depth: int) -> int {
        if (self.free_list != TRIE_NIL) {
            let recycled = self.free_list;
            self.free_list = self.nodes[recycled].parent;
            self.free_count -= 1;
            self.nodes[recycled].reset();
            self.nodes[recycled].initialize(parent, edge, depth);
            self.allocations += 1;
            return recycled;
        }
        self.nodes.push_back(TrieNode(V, ALPHABET)());
        let fresh = self.nodes.size() - 1;
        self.nodes[fresh].initialize(parent, edge, depth);
        self.allocations += 1;
        return fresh;
    }

    // Returns a node to the free list.  The caller is responsible for having
    // already detached it from its parent.
    fn release_node(ref self, index: int) {
        if (index == self.root) {
            return;
        }
        self.nodes[index].reset();
        self.nodes[index].live = false;
        self.nodes[index].kind = NodeKind.Pruned;
        self.nodes[index].parent = self.free_list;
        self.free_list = index;
        self.free_count += 1;
        self.releases += 1;
    }

    // --- Insertion --------------------------------------------------------

    // Inserts `key`, creating any missing nodes along the way.
    //
    // Returns `Inserted` for a new key, `Replaced` when an existing payload
    // was overwritten, and `Rejected` when the key was empty or too long.
    fn insert(ref self, key: string, value: V, weight: int) -> TrieOutcome {
        if (key.size() == 0) {
            return TrieOutcome.Rejected;
        }
        if (key.size() > TRIE_MAX_KEY_LENGTH) {
            return TrieOutcome.Rejected;
        }
        self.ensure_root();

        var current = self.root;
        var index: int = 0;
        while (index < key.size()) {
            let c = key.at(index);
            var next = self.nodes[current].child_for(c);
            if (next == TRIE_NIL) {
                next = self.allocate_node(current, c, index + 1);
                Discard(self.nodes[current].attach(c, next));
                self.edges_created += 1;
            }
            current = next;
            index += 1;
        }

        let was_terminal = self.nodes[current].terminal;
        self.nodes[current].mark_terminal(value, weight);
        if (was_terminal) {
            self.replacements += 1;
            self.refresh_path(current);
            return TrieOutcome.Replaced;
        }
        self.count += 1;
        self.refresh_path(current);
        return TrieOutcome.Inserted;
    }

    // Convenience overload spelling: insert with the default weight.
    fn add(ref self, key: string, value: V) -> TrieOutcome {
        return self.insert(key, value, WEIGHT_DEFAULT);
    }

    // Bulk insertion from a `vector{pair{string, V}}` run.  Returns how many
    // keys were genuinely new.
    fn insert_all(ref self, entries: vector(pair(string, V))) -> int {
        var added: int = 0;
        for (entry in entries) {
            if (self.insert(entry.first, entry.second, WEIGHT_DEFAULT) == TrieOutcome.Inserted) {
                added += 1;
            }
        }
        return added;
    }

    // Bulk insertion from a weighted run, which is the shape the autocomplete
    // layer feeds in.
    fn insert_weighted(ref self,
                       entries: vector(pair(string, pair(V, int)))) -> int {
        var added: int = 0;
        for (entry in entries) {
            let outcome = self.insert(entry.first, entry.second.first, entry.second.second);
            if (outcome == TrieOutcome.Inserted) {
                added += 1;
            }
        }
        return added;
    }

    // Recomputes the aggregate weight and key count on the path from `node`
    // back to the root.  Called after every mutation so the ranking layer can
    // prune subtrees by their best possible score.
    fn refresh_path(ref self, node: int) {
        var current = node;
        var guard: int = 0;
        while (current != TRIE_NIL and guard < TRIE_MAX_DEPTH) {
            self.recompute_node(current);
            current = self.nodes[current].parent;
            guard += 1;
        }
    }

    // Aggregate of one node from its own payload plus its children.
    fn recompute_node(ref self, node: int) {
        var best = 0;
        var keys = 0;
        if (self.nodes[node].terminal) {
            best = self.nodes[node].weight;
            keys = 1;
        }
        var edges = self.nodes[node].edges();
        for (edge in edges) {
            let child = edge.second;
            if (self.nodes[child].subtree_weight > best) {
                best = self.nodes[child].subtree_weight;
            }
            keys += self.nodes[child].subtree_keys;
        }
        Destroy(edges);
        self.nodes[node].subtree_weight = best;
        self.nodes[node].subtree_keys = keys;
    }

    // --- Lookup -----------------------------------------------------------

    // Walks `key` as far as the structure allows, recording the deepest
    // terminal node seen on the way.  Every other query is phrased in terms
    // of this one walk.
    fn walk(self, key: string) -> WalkResult(V) {
        var result = WalkResult(V)();
        result.requested = key.size();
        if (self.root == TRIE_NIL) {
            return result;
        }

        var current = self.root;
        var index: int = 0;
        while (index < key.size()) {
            let next = self.nodes[current].child_for(key.at(index));
            if (next == TRIE_NIL) {
                result.node = current;
                result.consumed = index;
                result.kind = MatchKind.NoMatch;
                return result;
            }
            current = next;
            index += 1;
            if (self.nodes[current].terminal) {
                result.last_terminal = current;
                result.last_terminal_length = index;
            }
        }

        result.node = current;
        result.consumed = key.size();
        if (self.nodes[current].terminal) {
            result.kind = MatchKind.ExactMatch;
            result.payload = self.nodes[current].payload;
        } else {
            result.kind = MatchKind.PrefixMatch;
        }
        return result;
    }

    // Node reached by following the whole of `key`, or `TRIE_NIL`.
    fn find_node(self, key: string) -> int {
        let result = self.walk(key);
        if (result.consumed != key.size()) {
            return TRIE_NIL;
        }
        return result.node;
    }

    fn contains(self, key: string) -> bool {
        let node = self.find_node(key);
        if (node == TRIE_NIL) {
            return false;
        }
        return self.nodes[node].terminal;
    }

    // True when any stored key begins with `prefix`.
    fn contains_prefix(self, prefix: string) -> bool {
        return self.find_node(prefix) != TRIE_NIL;
    }

    // Borrowed payload for `key`, falling back to the shared `missing` value
    // so the signature stays total.
    fn at(ref self, key: string) -> ref V {
        let node = self.find_node(key);
        if (node == TRIE_NIL) {
            return self.missing;
        }
        if (not self.nodes[node].terminal) {
            return self.missing;
        }
        return self.nodes[node].payload;
    }

    // Stored weight of `key`, or zero.
    fn weight_of(self, key: string) -> int {
        let node = self.find_node(key);
        if (node == TRIE_NIL) {
            return 0;
        }
        return self.nodes[node].weight;
    }

    // Bumps the weight of an existing key, saturating at the scaled maximum.
    fn bump(ref self, key: string, delta: int) -> bool {
        let node = self.find_node(key);
        if (node == TRIE_NIL) {
            return false;
        }
        if (not self.nodes[node].terminal) {
            return false;
        }
        self.nodes[node].weight += delta;
        if (self.nodes[node].weight < WEIGHT_FLOOR) {
            self.nodes[node].weight = WEIGHT_FLOOR;
        }
        self.refresh_path(node);
        return true;
    }

    // --- Prefix queries ---------------------------------------------------

    // Longest stored key that is a prefix of `text`.  This is the query a
    // dictionary-based tokeniser runs on every position of its input.
    fn longest_matching_prefix(self, text: string) -> pair(string, int) {
        let result = self.walk(text);
        if (result.last_terminal == TRIE_NIL) {
            return pair(string, int)({.first = string(), .second = 0});
        }
        return pair(string, int)({.first = text.substr(0, result.last_terminal_length),
                                 .second = result.last_terminal});
    }

    // Longest common prefix shared by every key in the index.  Walks down
    // while each node has exactly one edge and holds no payload of its own.
    fn longest_common_prefix(self) -> string {
        var out = string();
        if (self.root == TRIE_NIL) {
            return out;
        }
        var current = self.root;
        var guard: int = 0;
        while (guard < TRIE_MAX_DEPTH) {
            if (self.nodes[current].terminal) {
                return out;
            }
            var edges = self.nodes[current].edges();
            if (edges.size() != 1) {
                Destroy(edges);
                return out;
            }
            out.push_back(edges[0].first);
            current = edges[0].second;
            Destroy(edges);
            guard += 1;
        }
        return out;
    }

    // Longest common prefix of the keys stored under `prefix`, which is what
    // an editor uses to complete as far as it unambiguously can.
    fn extend_unambiguously(self, prefix: string) -> string {
        var out = string();
        out.append(prefix);
        let start = self.find_node(prefix);
        if (start == TRIE_NIL) {
            return out;
        }
        var current = start;
        var guard: int = 0;
        while (guard < TRIE_MAX_DEPTH) {
            if (self.nodes[current].terminal) {
                return out;
            }
            var edges = self.nodes[current].edges();
            if (edges.size() != 1) {
                Destroy(edges);
                return out;
            }
            out.push_back(edges[0].first);
            current = edges[0].second;
            Destroy(edges);
            guard += 1;
        }
        return out;
    }

    // Every key stored beneath `node`, with `prefix` already prepended.  The
    // walk is iterative over an explicit stack of
    // `pair{int, string}` frames rather than recursive, so a pathological key
    // length cannot blow the machine stack.
    fn collect_under(self, node: int, prefix: string,
                     limit: int) -> vector(pair(string, V)) {
        var out = vector(pair(string, V))();
        if (node == TRIE_NIL) {
            return out;
        }
        var stack = vector(pair(int, string))();
        stack.reserve(TRIE_MAX_DEPTH);
        stack.push_back(pair(int, string)({.first = node, .second = prefix}));

        while (stack.size() > 0) {
            let frame = stack.back();
            let here = frame.first;
            var path = frame.second;
            stack.pop_back();

            if (self.nodes[here].terminal) {
                out.push_back(pair(string, V)({.first = path, .second = self.nodes[here].payload}));
                if (limit > 0 and out.size() >= limit) {
                    Destroy(stack);
                    Destroy(path);
                    return out;
                }
            }

            // Push in reverse alphabet order so the pops come out ascending.
            var edges = self.nodes[here].edges();
            var index = edges.size() - 1;
            while (index >= 0) {
                var child_path = push_char(path, edges[index].first);
                stack.push_back(pair(int, string)({.first = edges[index].second,
                                                  .second = child_path}));
                Destroy(child_path);
                index -= 1;
            }
            Destroy(edges);
            Destroy(path);
        }
        Destroy(stack);
        return out;
    }

    // Every key beginning with `prefix`.
    fn keys_with_prefix(self, prefix: string,
                        limit: int) -> vector(pair(string, V)) {
        let start = self.find_node(prefix);
        return self.collect_under(start, prefix, limit);
    }

    // Same query, but keeping the stored weight alongside the payload.  The
    // nested pair is what the ranking layer consumes directly.
    fn weighted_with_prefix(self,
                            prefix: string) -> vector(pair(string, pair(V, int))) {
        var out = vector(pair(string, pair(V, int)))();
        var plain = self.keys_with_prefix(prefix, 0);
        for (entry in plain) {
            let w = self.weight_of(entry.first);
            var boxed = pair(V, int)({.first = entry.second, .second = w});
            out.push_back(pair(string, pair(V, int))({.first = entry.first, .second = boxed}));
            Destroy(boxed);
        }
        Destroy(plain);
        return out;
    }

    // Every key in the index, in lexicographic order.
    fn to_pairs(self) -> vector(pair(string, V)) {
        var empty_prefix = string();
        var out = self.collect_under(self.root, empty_prefix, 0);
        Destroy(empty_prefix);
        return out;
    }

    // Keys grouped by their first character.  The deeply nested return type
    // is exactly what a per-letter completion cache wants.
    fn group_by_initial(self) -> map(char, vector(pair(string, V))) {
        var groups = map(char, vector(pair(string, V)))();
        var entries = self.to_pairs();
        for (entry in entries) {
            if (entry.first.size() == 0) {
                Discard(entry);
            } else {
                let initial = entry.first.at(0);
                if (not groups.contains(initial)) {
                    var bucket = vector(pair(string, V))();
                    Discard(groups.insert(initial, bucket));
                    Destroy(bucket);
                }
                groups.at(initial).push_back(entry);
            }
        }
        Destroy(entries);
        return groups;
    }

    // --- Deletion ---------------------------------------------------------

    // Removes `key` and prunes every node that the removal made redundant.
    //
    // Pruning walks back towards the root and stops at the first node that is
    // either terminal in its own right or still has another child, because
    // that node is still needed by some other key.
    fn erase(ref self, key: string) -> bool {
        let node = self.find_node(key);
        if (node == TRIE_NIL) {
            return false;
        }
        if (not self.nodes[node].terminal) {
            return false;
        }

        self.nodes[node].clear_terminal();
        self.count -= 1;
        self.prune_from(node);
        return true;
    }

    // Releases `start` and as many of its ancestors as have become useless.
    fn prune_from(ref self, start: int) -> int {
        var current = start;
        var pruned: int = 0;
        var guard: int = 0;
        while (current != TRIE_NIL and guard < TRIE_MAX_DEPTH) {
            if (current == self.root) {
                self.recompute_node(current);
                return pruned;
            }
            if (not self.nodes[current].prunable()) {
                self.refresh_path(current);
                return pruned;
            }
            let parent = self.nodes[current].parent;
            let edge = self.nodes[current].edge_char;
            Discard(self.nodes[parent].detach(edge));
            self.release_node(current);
            pruned += 1;
            current = parent;
            guard += 1;
        }
        return pruned;
    }

    // Removes every key beginning with `prefix`.  The whole subtree below the
    // prefix node is released in one pass and only then is the spine pruned.
    fn erase_prefix(ref self, prefix: string) -> int {
        let start = self.find_node(prefix);
        if (start == TRIE_NIL) {
            return 0;
        }
        let removed = self.release_subtree(start);
        self.count -= removed;

        if (start == self.root) {
            self.recompute_node(self.root);
            return removed;
        }
        let parent = self.nodes[start].parent;
        let edge = self.nodes[start].edge_char;
        Discard(self.nodes[parent].detach(edge));
        self.release_node(start);
        Discard(self.prune_from(parent));
        return removed;
    }

    // Releases everything strictly below `start`, returning the number of
    // stored keys that went with it.  `start` itself survives.
    fn release_subtree(ref self, start: int) -> int {
        var removed: int = 0;
        var stack = vector(int)();
        stack.reserve(TRIE_MAX_DEPTH);

        var seed = self.nodes[start].edges();
        for (edge in seed) {
            stack.push_back(edge.second);
        }
        Destroy(seed);

        while (stack.size() > 0) {
            let here = stack.back();
            stack.pop_back();
            if (self.nodes[here].terminal) {
                removed += 1;
            }
            var edges = self.nodes[here].edges();
            for (edge in edges) {
                stack.push_back(edge.second);
            }
            Destroy(edges);
            self.release_node(here);
        }
        Destroy(stack);

        if (self.nodes[start].terminal) {
            removed += 1;
            self.nodes[start].clear_terminal();
        }
        return removed;
    }

    // Drops every key whose weight has fallen below `threshold`.  Returns the
    // number of keys evicted.
    fn evict_below(ref self, threshold: int) -> int {
        var doomed = vector(string)();
        var entries = self.to_pairs();
        for (entry in entries) {
            if (self.weight_of(entry.first) < threshold) {
                doomed.push_back(entry.first);
            }
        }
        Destroy(entries);

        var evicted: int = 0;
        for (key in doomed) {
            if (self.erase(key)) {
                evicted += 1;
            }
        }
        Destroy(doomed);
        return evicted;
    }

    // Multiplies every stored weight by `WEIGHT_DECAY_PERCENT`, which is how
    // a long-running suggestion index forgets stale queries.
    fn decay(ref self) -> int {
        var touched: int = 0;
        var index: int = 0;
        while (index < self.nodes.size()) {
            if (self.nodes[index].live and self.nodes[index].terminal) {
                var scaled = self.nodes[index].weight * WEIGHT_DECAY_PERCENT / 100;
                if (scaled < WEIGHT_FLOOR) {
                    scaled = WEIGHT_FLOOR;
                }
                self.nodes[index].weight = scaled;
                touched += 1;
            }
            index += 1;
        }
        if (self.root != TRIE_NIL) {
            self.rebuild_aggregates();
        }
        return touched;
    }

    // Recomputes every subtree aggregate from the leaves upwards.  Cheaper
    // than calling `refresh_path` once per key after a bulk mutation.
    fn rebuild_aggregates(ref self) {
        var order = self.post_order();
        for (node in order) {
            self.recompute_node(node);
        }
        Destroy(order);
    }

    // Node indices in post order, so children always precede their parent.
    fn post_order(self) -> vector(int) {
        var out = vector(int)();
        if (self.root == TRIE_NIL) {
            return out;
        }
        var stack = vector(int)();
        stack.push_back(self.root);
        while (stack.size() > 0) {
            let here = stack.back();
            stack.pop_back();
            out.push_back(here);
            var edges = self.nodes[here].edges();
            for (edge in edges) {
                stack.push_back(edge.second);
            }
            Destroy(edges);
        }
        Destroy(stack);

        // The stack walk produced a reversed post order; flip it in place.
        var low: int = 0;
        var high = out.size() - 1;
        while (low < high) {
            swap(out[low], out[high]);
            low += 1;
            high -= 1;
        }
        return out;
    }

    // Node indices grouped by depth, which the statistics pass walks.
    fn level_order(self) -> vector(vector(int)) {
        var levels = vector(vector(int))();
        if (self.root == TRIE_NIL) {
            return levels;
        }
        var frontier = vector(int)();
        frontier.push_back(self.root);
        var depth: int = 0;
        while (frontier.size() > 0 and depth < TRIE_MAX_DEPTH) {
            levels.push_back(frontier);
            var next = vector(int)();
            for (node in frontier) {
                var edges = self.nodes[node].edges();
                for (edge in edges) {
                    next.push_back(edge.second);
                }
                Destroy(edges);
            }
            frontier.clear();
            for (node in next) {
                frontier.push_back(node);
            }
            Destroy(next);
            depth += 1;
        }
        Destroy(frontier);
        return levels;
    }

    fn height(self) -> int {
        var levels = self.level_order();
        let depth = levels.size();
        Destroy(levels);
        return depth;
    }

    // --- Wholesale operations ---------------------------------------------

    fn clear(ref self) {
        for (node in self.nodes) {
            node.reset();
            node.live = false;
        }
        self.nodes.clear();
        self.root = TRIE_NIL;
        self.free_list = TRIE_NIL;
        self.free_count = 0;
        self.count = 0;
        self.allocations = 0;
        self.releases = 0;
        self.edges_created = 0;
        self.replacements = 0;
    }

    // Copies every key of this index into `target`.
    fn copy_into(self, ref target: Trie(V, ALPHABET)) -> int {
        var entries = self.weighted_with_prefix(string());
        let added = target.insert_weighted(entries);
        Destroy(entries);
        return added;
    }

    // --- Validation -------------------------------------------------------

    // Structural invariants, restated for the verifier:
    //
    //   1. Every live node except the root has a parent that links back to it
    //      through `edge_char`.
    //   2. A node's depth is one more than its parent's.
    //   3. `count` equals the number of terminal nodes.
    //   4. No node is both pruned and reachable.
    fn check_validity(self) -> bool {
        Assert(self.count >= 0);
        Assert(self.free_count >= 0);
        Assert(ALPHABET > 0);

        if (self.root == TRIE_NIL) {
            Assert(self.count == 0);
            Prove(self.count == 0);
            return true;
        }

        Assert(self.nodes[self.root].parent == TRIE_NIL);
        Assert(self.nodes[self.root].depth == 0);
        Prove(self.nodes[self.root].depth == 0);

        var terminals: int = 0;
        var order = self.post_order();
        for (node in order) {
            Assert(self.nodes[node].live);
            if (self.nodes[node].terminal) {
                terminals += 1;
                Assert(self.nodes[node].weight >= 0);
            }
            if (node != self.root) {
                let parent = self.nodes[node].parent;
                Assert(parent != TRIE_NIL);
                Assert(self.nodes[parent].child_for(self.nodes[node].edge_char) == node);
                Assert(self.nodes[node].depth == self.nodes[parent].depth + 1);
                Prove(self.nodes[node].depth == self.nodes[parent].depth + 1);
            }
            Assert(self.nodes[node].subtree_keys >= 0);
        }
        Destroy(order);

        Assert(terminals == self.count);
        Prove(terminals == self.count);

        let measured = self.height();
        Assert(measured <= TRIE_MAX_DEPTH);
        Prove(measured <= TRIE_MAX_DEPTH);
        return true;
    }

    // --- State ------------------------------------------------------------

    // Flat arena of nodes.  Index zero is the root once `ensure_root` has run.
    var nodes: vector(TrieNode(V, ALPHABET));

    // Per-prefix completion cache, invalidated wholesale on any mutation.
    // The nesting is deliberate: a prefix maps onto a ranked run of
    // (completion, score) pairs.
    var cache: map(string, vector(pair(string, int)));

    // Keys deferred by `insert_weighted` when the arena was momentarily full.
    var pending: vector(pair(string, pair(V, int)));

    var root: int = -1;
    var free_list: int = -1;
    var free_count: int = 0;
    var count: int = 0;
    var allocations: int = 0;
    var releases: int = 0;
    var edges_created: int = 0;
    var replacements: int = 0;
    var missing: V;
}

// --- Radix tree (Patricia) ------------------------------------------------

// One node of the path-compressed trie.
//
// Unlike `TrieNode`, the edge into this node carries a whole `label` rather
// than a single character, so a chain of single-child nodes collapses into one
// node with a long label.  Children are keyed by the *first* character of
// their label, which is enough to pick a branch because no two siblings may
// share a leading character -- that is exactly the invariant `split_edge`
// restores after every insertion.
class RadixNode(V: type, ALPHABET: int)
{

    fn is_terminal(self) -> bool {
        return self.terminal;
    }

    fn degree(self) -> int {
        return self.children.size();
    }

    fn is_leaf(self) -> bool {
        return self.children.size() == 0;
    }

    fn label_length(self) -> int {
        return self.label.size();
    }

    // A node with exactly one child and no payload of its own is redundant:
    // its label can be folded into that child's.
    fn mergeable(self) -> bool {
        if (self.terminal) {
            return false;
        }
        return self.children.size() == 1;
    }

    fn first_char(self) -> char {
        if (self.label.size() == 0) {
            return CHAR_NUL;
        }
        return self.label.at(0);
    }

    fn child_for(self, c: char) -> int {
        if (self.children.contains(c)) {
            return self.children.at(c);
        }
        return TRIE_NIL;
    }

    fn attach(ref self, c: char, node: int) -> bool {
        return self.children.insert(c, node);
    }

    fn detach(ref self, c: char) -> bool {
        return self.children.erase(c);
    }

    // Outgoing edges as (leading character, node) pairs.
    fn edges(self) -> vector(pair(char, int)) {
        var out = vector(pair(char, int))();
        for (entry in self.children) {
            out.push_back(pair(char, int)({.first = entry.first, .second = entry.second}));
        }
        return out;
    }

    fn reset(ref self) {
        self.label.clear();
        self.children.clear();
        self.terminal = false;
        self.weight = 0;
        self.subtree_weight = 0;
        self.parent = TRIE_NIL;
        self.depth = 0;
        self.kind = NodeKind.Compressed;
        self.live = false;
    }

    // Compressed edge label leading into this node from its parent.
    var label: string;

    // Leading character of each child's label mapped onto the child index.
    var children: map(char, int);

    var payload: V;
    var weight: int = 0;
    var subtree_weight: int = 0;
    var parent: int = -1;
    var depth: int = 0;
    var terminal: bool = false;
    var live: bool = false;
    var kind: NodeKind = NodeKind.Compressed;
}

// Result of trying to place a key against one compressed edge.
class EdgeMatch {

    fn exhausted_label(self) -> bool {
        return self.shared_len == self.label_len;
    }

    fn exhausted_key(self) -> bool {
        return self.shared_len == self.key_len;
    }

    fn needs_split(self) -> bool {
        if (self.shared_len == 0) {
            return false;
        }
        return self.shared_len < self.label_len;
    }

    var shared_len: int = 0;
    var label_len: int = 0;
    var key_len: int = 0;
    var node: int = -1;
    var action: EdgeAction = EdgeAction.NoAction;
}

// Path-compressed prefix tree over `string` keys.
//
// The API mirrors `Trie{V, ALPHABET}` so the two can be swapped underneath the
// autocomplete layer without touching it; the difference is purely in the
// node count, which is bounded by twice the number of stored keys rather than
// by their total length.
class RadixTree(V: type, ALPHABET: int)
{

    fn size(self) -> int {
        return self.count;
    }

    fn empty(self) -> bool {
        return self.count == 0;
    }

    fn node_count(self) -> int {
        return self.nodes.size() - self.free_count;
    }

    fn node_at(ref self, index: int) -> ref RadixNode(V, ALPHABET) {
        return self.nodes[index];
    }

    fn ensure_root(ref self) {
        if (self.root != TRIE_NIL) {
            return;
        }
        self.nodes.push_back(RadixNode(V, ALPHABET)());
        self.root = self.nodes.size() - 1;
        self.nodes[self.root].live = true;
        self.nodes[self.root].parent = TRIE_NIL;
        self.nodes[self.root].depth = 0;
    }

    fn allocate_node(ref self, parent: int, label: string) -> int {
        if (self.free_list != TRIE_NIL) {
            let recycled = self.free_list;
            self.free_list = self.nodes[recycled].parent;
            self.free_count -= 1;
            self.nodes[recycled].reset();
            self.nodes[recycled].label.append(label);
            self.nodes[recycled].parent = parent;
            self.nodes[recycled].live = true;
            return recycled;
        }
        self.nodes.push_back(RadixNode(V, ALPHABET)());
        let fresh = self.nodes.size() - 1;
        self.nodes[fresh].label.append(label);
        self.nodes[fresh].parent = parent;
        self.nodes[fresh].live = true;
        return fresh;
    }

    fn release_node(ref self, index: int) {
        if (index == self.root) {
            return;
        }
        self.nodes[index].reset();
        self.nodes[index].parent = self.free_list;
        self.free_list = index;
        self.free_count += 1;
    }

    // --- Edge splitting ---------------------------------------------------

    // Splits the edge into `node` after `at` characters.
    //
    // Before:   parent --"abcdef"--> node
    // After:    parent --"abc"--> fresh --"def"--> node
    //
    // The freshly interposed node inherits nothing but the shared prefix, so
    // it is a plain branch until the caller marks it terminal or hangs another
    // child off it.
    fn split_edge(ref self, node: int, at: int) -> int {
        let parent = self.nodes[node].parent;
        var head = self.nodes[node].label.substr(0, at);
        var tail = self.nodes[node].label.substr(at, self.nodes[node].label.size() - at);

        let fresh = self.allocate_node(parent, head);
        self.nodes[fresh].depth = self.nodes[node].depth;
        self.nodes[fresh].kind = NodeKind.Compressed;

        // Re-point the parent at the new head node.
        Discard(self.nodes[parent].detach(head.at(0)));
        Discard(self.nodes[parent].attach(head.at(0), fresh));

        // The old node keeps only the tail of its former label.
        self.nodes[node].label.clear();
        self.nodes[node].label.append(tail);
        self.nodes[node].parent = fresh;
        self.nodes[node].depth = self.nodes[fresh].depth + 1;
        Discard(self.nodes[fresh].attach(tail.at(0), node));

        Destroy(head);
        Destroy(tail);
        self.splits += 1;
        return fresh;
    }

    // Folds a redundant single-child node into that child, which is the
    // inverse of `split_edge` and the step that keeps deletion from leaving
    // long chains of one-child nodes behind.
    fn merge_edge(ref self, node: int) -> bool {
        if (node == self.root) {
            return false;
        }
        if (not self.nodes[node].mergeable()) {
            return false;
        }
        var edges = self.nodes[node].edges();
        if (edges.size() != 1) {
            Destroy(edges);
            return false;
        }
        let child = edges[0].second;
        Destroy(edges);

        let parent = self.nodes[node].parent;
        var combined = concat(self.nodes[node].label, self.nodes[child].label);

        Discard(self.nodes[parent].detach(self.nodes[node].label.at(0)));
        self.nodes[child].label.clear();
        self.nodes[child].label.append(combined);
        self.nodes[child].parent = parent;
        self.nodes[child].depth = self.nodes[parent].depth + 1;
        Discard(self.nodes[parent].attach(combined.at(0), child));

        Destroy(combined);
        self.release_node(node);
        self.merges += 1;
        return true;
    }

    // --- Insertion --------------------------------------------------------

    // Inserts `key`, splitting whatever edges stand in the way.
    fn insert(ref self, key: string, value: V, weight: int) -> TrieOutcome {
        if (key.size() == 0) {
            return TrieOutcome.Rejected;
        }
        if (key.size() > TRIE_MAX_KEY_LENGTH) {
            return TrieOutcome.Rejected;
        }
        self.ensure_root();

        var current = self.root;
        var offset: int = 0;
        var guard: int = 0;
        while (guard < TRIE_MAX_DEPTH) {
            guard += 1;
            if (offset == key.size()) {
                // The key ended exactly on a node boundary.
                let was = self.nodes[current].terminal;
                self.nodes[current].terminal = true;
                self.nodes[current].payload = value;
                self.nodes[current].weight = weight;
                if (was) {
                    return TrieOutcome.Replaced;
                }
                self.count += 1;
                return TrieOutcome.Inserted;
            }

            let lead = key.at(offset);
            let child = self.nodes[current].child_for(lead);
            if (child == TRIE_NIL) {
                // No edge starts with this character: hang the whole
                // remaining suffix off `current` as one compressed edge.
                var suffix = key.substr(offset, key.size() - offset);
                let fresh = self.allocate_node(current, suffix);
                self.nodes[fresh].depth = self.nodes[current].depth + 1;
                self.nodes[fresh].terminal = true;
                self.nodes[fresh].payload = value;
                self.nodes[fresh].weight = weight;
                Discard(self.nodes[current].attach(lead, fresh));
                Destroy(suffix);
                self.count += 1;
                return TrieOutcome.Inserted;
            }

            var remainder = key.substr(offset, key.size() - offset);
            let shared_len = common_prefix_length(remainder, self.nodes[child].label);
            let label_len = self.nodes[child].label.size();
            Destroy(remainder);

            if (shared_len == label_len) {
                // The whole label was consumed; descend and keep going.
                current = child;
                offset += shared_len;
            } else {
                // Partial overlap: interpose a node at the divergence point
                // and retry from there.
                let interposed = self.split_edge(child, shared_len);
                current = interposed;
                offset += shared_len;
            }
        }
        return TrieOutcome.Overflowed;
    }

    fn add(ref self, key: string, value: V) -> TrieOutcome {
        return self.insert(key, value, WEIGHT_DEFAULT);
    }

    fn insert_all(ref self, entries: vector(pair(string, V))) -> int {
        var added: int = 0;
        for (entry in entries) {
            if (self.insert(entry.first, entry.second, WEIGHT_DEFAULT) == TrieOutcome.Inserted) {
                added += 1;
            }
        }
        return added;
    }

    // --- Lookup -----------------------------------------------------------

    // Node whose accumulated label spells exactly `key`, or `TRIE_NIL`.
    fn find_node(self, key: string) -> int {
        if (self.root == TRIE_NIL) {
            return TRIE_NIL;
        }
        var current = self.root;
        var offset: int = 0;
        var guard: int = 0;
        while (offset < key.size() and guard < TRIE_MAX_DEPTH) {
            guard += 1;
            let child = self.nodes[current].child_for(key.at(offset));
            if (child == TRIE_NIL) {
                return TRIE_NIL;
            }
            var remainder = key.substr(offset, key.size() - offset);
            let shared_len = common_prefix_length(remainder, self.nodes[child].label);
            Destroy(remainder);
            if (shared_len != self.nodes[child].label.size()) {
                return TRIE_NIL;
            }
            current = child;
            offset += shared_len;
        }
        return current;
    }

    // Node covering `prefix`, even when the prefix stops in the middle of a
    // compressed label.  Prefix queries need this looser walk.
    fn find_prefix_node(self, prefix: string) -> int {
        if (self.root == TRIE_NIL) {
            return TRIE_NIL;
        }
        var current = self.root;
        var offset: int = 0;
        var guard: int = 0;
        while (offset < prefix.size() and guard < TRIE_MAX_DEPTH) {
            guard += 1;
            let child = self.nodes[current].child_for(prefix.at(offset));
            if (child == TRIE_NIL) {
                return TRIE_NIL;
            }
            var remainder = prefix.substr(offset, prefix.size() - offset);
            let shared_len = common_prefix_length(remainder, self.nodes[child].label);
            let label_len = self.nodes[child].label.size();
            let rest_len = remainder.size();
            Destroy(remainder);
            if (shared_len == rest_len) {
                // The prefix ran out inside this label: the child covers it.
                return child;
            }
            if (shared_len != label_len) {
                return TRIE_NIL;
            }
            current = child;
            offset += shared_len;
        }
        return current;
    }

    fn contains(self, key: string) -> bool {
        let node = self.find_node(key);
        if (node == TRIE_NIL) {
            return false;
        }
        return self.nodes[node].terminal;
    }

    fn at(ref self, key: string) -> ref V {
        let node = self.find_node(key);
        if (node == TRIE_NIL) {
            return self.missing;
        }
        return self.nodes[node].payload;
    }

    // Full key spelled by the path from the root down to `node`.
    fn path_of(self, node: int) -> string {
        var parts = vector(string)();
        var current = node;
        var guard: int = 0;
        while (current != TRIE_NIL and current != self.root and guard < TRIE_MAX_DEPTH) {
            parts.push_back(self.nodes[current].label);
            current = self.nodes[current].parent;
            guard += 1;
        }
        var out = string();
        var index = parts.size() - 1;
        while (index >= 0) {
            out.append(parts[index]);
            index -= 1;
        }
        Destroy(parts);
        return out;
    }

    // Every key stored beneath `node`, prefixed by `base`.
    fn collect_under(self, node: int,
                     base_: string) -> vector(pair(string, V)) {
        var out = vector(pair(string, V))();
        if (node == TRIE_NIL) {
            return out;
        }
        var stack = vector(pair(int, string))();
        stack.push_back(pair(int, string)({.first = node, .second = base_}));
        while (stack.size() > 0) {
            let frame = stack.back();
            let here = frame.first;
            var path = frame.second;
            stack.pop_back();

            if (self.nodes[here].terminal) {
                out.push_back(pair(string, V)({.first = path, .second = self.nodes[here].payload}));
            }
            var edges = self.nodes[here].edges();
            for (edge in edges) {
                var child_path = concat(path, self.nodes[edge.second].label);
                stack.push_back(pair(int, string)({.first = edge.second, .second = child_path}));
                Destroy(child_path);
            }
            Destroy(edges);
            Destroy(path);
        }
        Destroy(stack);
        return out;
    }

    fn keys_with_prefix(self,
                        prefix: string) -> vector(pair(string, V)) {
        let node = self.find_prefix_node(prefix);
        if (node == TRIE_NIL) {
            return vector(pair(string, V))();
        }
        var base_ = self.path_of(node);
        var out = self.collect_under(node, base_);
        Destroy(base_);
        return out;
    }

    fn to_pairs(self) -> vector(pair(string, V)) {
        var base_ = string();
        var out = self.collect_under(self.root, base_);
        Destroy(base_);
        return out;
    }

    // Longest stored key that prefixes `text`, walked label by label.
    fn longest_matching_prefix(self,
                               text: string) -> pair(string, int) {
        var best = string();
        var best_node: int = -1;
        if (self.root == TRIE_NIL) {
            return pair(string, int)({.first = best, .second = best_node});
        }
        var current = self.root;
        var offset: int = 0;
        var guard: int = 0;
        while (offset < text.size() and guard < TRIE_MAX_DEPTH) {
            guard += 1;
            let child = self.nodes[current].child_for(text.at(offset));
            if (child == TRIE_NIL) {
                return pair(string, int)({.first = best, .second = best_node});
            }
            var remainder = text.substr(offset, text.size() - offset);
            let shared_len = common_prefix_length(remainder, self.nodes[child].label);
            Destroy(remainder);
            if (shared_len != self.nodes[child].label.size()) {
                return pair(string, int)({.first = best, .second = best_node});
            }
            current = child;
            offset += shared_len;
            if (self.nodes[current].terminal) {
                best.clear();
                best.append(text.substr(0, offset));
                best_node = current;
            }
        }
        return pair(string, int)({.first = best, .second = best_node});
    }

    // --- Deletion ---------------------------------------------------------

    // Removes `key` and merges away any node the removal made redundant.
    fn erase(ref self, key: string) -> bool {
        let node = self.find_node(key);
        if (node == TRIE_NIL) {
            return false;
        }
        if (not self.nodes[node].terminal) {
            return false;
        }
        self.nodes[node].terminal = false;
        self.nodes[node].weight = 0;
        self.count -= 1;

        var current = node;
        var guard: int = 0;
        while (current != TRIE_NIL and current != self.root and guard < TRIE_MAX_DEPTH) {
            guard += 1;
            if (self.nodes[current].is_leaf() and not self.nodes[current].terminal) {
                let parent = self.nodes[current].parent;
                Discard(self.nodes[parent].detach(self.nodes[current].label.at(0)));
                self.release_node(current);
                current = parent;
            } else {
                Discard(self.merge_edge(current));
                current = TRIE_NIL;
            }
        }
        if (current != TRIE_NIL and current != self.root) {
            Discard(self.merge_edge(current));
        }
        return true;
    }

    fn clear(ref self) {
        for (node in self.nodes) {
            node.reset();
        }
        self.nodes.clear();
        self.root = TRIE_NIL;
        self.free_list = TRIE_NIL;
        self.free_count = 0;
        self.count = 0;
        self.splits = 0;
        self.merges = 0;
    }

    // --- Validation -------------------------------------------------------

    // 1. No two siblings share a leading character.
    // 2. Every non-root node has a non-empty label.
    // 3. No node is redundant, i.e. no non-terminal node has exactly one
    //    child, because `merge_edge` would have folded it away.
    fn check_validity(self) -> bool {
        Assert(self.count >= 0);
        if (self.root == TRIE_NIL) {
            Assert(self.count == 0);
            Prove(self.count == 0);
            return true;
        }
        var stack = vector(int)();
        stack.push_back(self.root);
        var terminals: int = 0;
        while (stack.size() > 0) {
            let here = stack.back();
            stack.pop_back();
            if (self.nodes[here].terminal) {
                terminals += 1;
            }
            if (here != self.root) {
                Assert(self.nodes[here].label.size() >= RADIX_MIN_LABEL);
                Prove(self.nodes[here].label.size() >= RADIX_MIN_LABEL);
                Assert(not self.nodes[here].mergeable());
            }
            var seen = set(char)();
            var edges = self.nodes[here].edges();
            for (edge in edges) {
                Assert(seen.insert(edge.first));
                Assert(self.nodes[edge.second].parent == here);
                Assert(self.nodes[edge.second].label.at(0) == edge.first);
                stack.push_back(edge.second);
            }
            Destroy(edges);
            Destroy(seen);
        }
        Destroy(stack);
        Assert(terminals == self.count);
        Prove(terminals == self.count);
        return true;
    }

    var nodes: vector(RadixNode(V, ALPHABET));

    // Cached expansions, keyed by prefix, exactly as in `Trie`.
    var cache: map(string, vector(pair(string, int)));

    var root: int = -1;
    var free_list: int = -1;
    var free_count: int = 0;
    var count: int = 0;
    var splits: int = 0;
    var merges: int = 0;
    var missing: V;
}

// --- Ternary search tree --------------------------------------------------

// One node of a ternary search tree.
//
// Each node stores a single split character and three links: `low` for keys
// whose next character sorts before it, `high` for keys that sort after, and
// `equal` for keys that matched and therefore continue at the next character.
// The result is a binary search tree of characters layered over a trie, which
// is why it needs no per-node child table at all and stays compact for sparse
// alphabets where `Trie{V, 256}` would waste most of its slots.
class TernaryNode(V: type)
{

    fn is_terminal(self) -> bool {
        return self.terminal;
    }

    fn is_leaf(self) -> bool {
        if (self.low != TRIE_NIL) {
            return false;
        }
        if (self.equal != TRIE_NIL) {
            return false;
        }
        return self.high == TRIE_NIL;
    }

    fn degree(self) -> int {
        var found: int = 0;
        if (self.low != TRIE_NIL) {
            found += 1;
        }
        if (self.equal != TRIE_NIL) {
            found += 1;
        }
        if (self.high != TRIE_NIL) {
            found += 1;
        }
        return found;
    }

    // Link selected by comparing `c` against this node's split character.
    fn link_for(self, c: char) -> TernaryLink {
        if (c < self.split) {
            return TernaryLink.LowLink;
        }
        if (c > self.split) {
            return TernaryLink.HighLink;
        }
        return TernaryLink.EqualLink;
    }

    fn follow(self, which: TernaryLink) -> int {
        if (which == TernaryLink.LowLink) {
            return self.low;
        }
        if (which == TernaryLink.HighLink) {
            return self.high;
        }
        return self.equal;
    }

    fn set_link(ref self, which: TernaryLink, node: int) {
        if (which == TernaryLink.LowLink) {
            self.low = node;
        } else {
            if (which == TernaryLink.HighLink) {
                self.high = node;
            } else {
                self.equal = node;
            }
        }
    }

    fn reset(ref self) {
        self.split = CHAR_NUL;
        self.low = TRIE_NIL;
        self.equal = TRIE_NIL;
        self.high = TRIE_NIL;
        self.terminal = false;
        self.weight = 0;
        self.live = false;
    }

    var split: char = '\0';
    var payload: V;
    var weight: int = 0;
    var low: int = -1;
    var equal: int = -1;
    var high: int = -1;
    var depth: int = 0;
    var terminal: bool = false;
    var live: bool = false;
}

// Ternary search tree mapping `string` keys onto `V` payloads.
//
// Kept deliberately un-parameterised on the alphabet: three-way branching does
// not care how wide the character set is, which is the whole point of picking
// this representation over `Trie{V, ALPHABET}`.
class TernaryTree(V: type)
{

    fn size(self) -> int {
        return self.count;
    }

    fn empty(self) -> bool {
        return self.count == 0;
    }

    fn node_count(self) -> int {
        return self.nodes.size();
    }

    fn node_at(ref self, index: int) -> ref TernaryNode(V) {
        return self.nodes[index];
    }

    fn allocate_node(ref self, c: char, depth: int) -> int {
        self.nodes.push_back(TernaryNode(V)());
        let fresh = self.nodes.size() - 1;
        self.nodes[fresh].split = c;
        self.nodes[fresh].depth = depth;
        self.nodes[fresh].live = true;
        return fresh;
    }

    // --- Insertion --------------------------------------------------------

    // Iterative insertion.  The tricky part is that the first character of a
    // key may have to become the root, so the root link is patched after the
    // walk rather than during it.
    fn insert(ref self, key: string, value: V, weight: int) -> TrieOutcome {
        if (key.size() == 0) {
            return TrieOutcome.Rejected;
        }
        if (self.root == TRIE_NIL) {
            self.root = self.allocate_node(key.at(0), 0);
        }

        var current = self.root;
        var index: int = 0;
        var guard: int = 0;
        while (guard < TRIE_MAX_DEPTH * 4) {
            guard += 1;
            let c = key.at(index);
            let which = self.nodes[current].link_for(c);

            if (which == TernaryLink.EqualLink) {
                if (index + 1 == key.size()) {
                    let was = self.nodes[current].terminal;
                    self.nodes[current].terminal = true;
                    self.nodes[current].payload = value;
                    self.nodes[current].weight = weight;
                    if (was) {
                        return TrieOutcome.Replaced;
                    }
                    self.count += 1;
                    return TrieOutcome.Inserted;
                }
                if (self.nodes[current].equal == TRIE_NIL) {
                    let fresh = self.allocate_node(key.at(index + 1),
                                               self.nodes[current].depth + 1);
                    self.nodes[current].equal = fresh;
                }
                current = self.nodes[current].equal;
                index += 1;
            } else {
                let next = self.nodes[current].follow(which);
                if (next == TRIE_NIL) {
                    let fresh = self.allocate_node(c, self.nodes[current].depth);
                    self.nodes[current].set_link(which, fresh);
                    current = fresh;
                } else {
                    current = next;
                }
            }
        }
        return TrieOutcome.Overflowed;
    }

    fn add(ref self, key: string, value: V) -> TrieOutcome {
        return self.insert(key, value, WEIGHT_DEFAULT);
    }

    fn insert_all(ref self, entries: vector(pair(string, V))) -> int {
        var added: int = 0;
        for (entry in entries) {
            if (self.insert(entry.first, entry.second, WEIGHT_DEFAULT) == TrieOutcome.Inserted) {
                added += 1;
            }
        }
        return added;
    }

    // --- Lookup -----------------------------------------------------------

    // Node whose `equal` chain spells exactly `key`, or `TRIE_NIL`.
    fn find_node(self, key: string) -> int {
        if (self.root == TRIE_NIL) {
            return TRIE_NIL;
        }
        if (key.size() == 0) {
            return TRIE_NIL;
        }
        var current = self.root;
        var index: int = 0;
        var guard: int = 0;
        while (current != TRIE_NIL and guard < TRIE_MAX_DEPTH * 4) {
            guard += 1;
            let c = key.at(index);
            if (c < self.nodes[current].split) {
                current = self.nodes[current].low;
            } else {
                if (c > self.nodes[current].split) {
                    current = self.nodes[current].high;
                } else {
                    if (index + 1 == key.size()) {
                        return current;
                    }
                    current = self.nodes[current].equal;
                    index += 1;
                }
            }
        }
        return TRIE_NIL;
    }

    fn contains(self, key: string) -> bool {
        let node = self.find_node(key);
        if (node == TRIE_NIL) {
            return false;
        }
        return self.nodes[node].terminal;
    }

    fn at(ref self, key: string) -> ref V {
        let node = self.find_node(key);
        if (node == TRIE_NIL) {
            return self.missing;
        }
        return self.nodes[node].payload;
    }

    // Every key stored in the subtree rooted at `node`, with `prefix` already
    // spelled out.  Walked with an explicit frame stack, like everywhere else
    // in this file.
    fn collect_under(self, node: int,
                     prefix: string) -> vector(pair(string, V)) {
        var out = vector(pair(string, V))();
        if (node == TRIE_NIL) {
            return out;
        }
        var stack = vector(pair(int, string))();
        stack.push_back(pair(int, string)({.first = node, .second = prefix}));
        while (stack.size() > 0) {
            let frame = stack.back();
            let here = frame.first;
            var path = frame.second;
            stack.pop_back();

            if (self.nodes[here].high != TRIE_NIL) {
                stack.push_back(pair(int, string)({.first = self.nodes[here].high, .second = path}));
            }
            if (self.nodes[here].low != TRIE_NIL) {
                stack.push_back(pair(int, string)({.first = self.nodes[here].low, .second = path}));
            }

            var extended = push_char(path, self.nodes[here].split);
            if (self.nodes[here].terminal) {
                out.push_back(pair(string, V)({.first = extended,
                                              .second = self.nodes[here].payload}));
            }
            if (self.nodes[here].equal != TRIE_NIL) {
                stack.push_back(pair(int, string)({.first = self.nodes[here].equal,
                                                  .second = extended}));
            }
            Destroy(extended);
            Destroy(path);
        }
        Destroy(stack);
        return out;
    }

    // Every key beginning with `prefix`.  The prefix node's `equal` subtree
    // holds the continuations; the prefix itself is reported separately when
    // it happens to be a stored key.
    fn keys_with_prefix(self,
                        prefix: string) -> vector(pair(string, V)) {
        var out = vector(pair(string, V))();
        let node = self.find_node(prefix);
        if (node == TRIE_NIL) {
            return out;
        }
        if (self.nodes[node].terminal) {
            out.push_back(pair(string, V)({.first = prefix, .second = self.nodes[node].payload}));
        }
        var deeper = self.collect_under(self.nodes[node].equal, prefix);
        for (entry in deeper) {
            out.push_back(entry);
        }
        Destroy(deeper);
        return out;
    }

    fn to_pairs(self) -> vector(pair(string, V)) {
        var base_ = string();
        var out = self.collect_under(self.root, base_);
        Destroy(base_);
        return out;
    }

    // Longest stored key that prefixes `text`.
    fn longest_matching_prefix(self, text: string) -> string {
        var best = string();
        if (self.root == TRIE_NIL) {
            return best;
        }
        var current = self.root;
        var index: int = 0;
        var guard: int = 0;
        while (current != TRIE_NIL and index < text.size() and guard < TRIE_MAX_DEPTH * 4) {
            guard += 1;
            let c = text.at(index);
            if (c < self.nodes[current].split) {
                current = self.nodes[current].low;
            } else {
                if (c > self.nodes[current].split) {
                    current = self.nodes[current].high;
                } else {
                    index += 1;
                    if (self.nodes[current].terminal) {
                        best.clear();
                        best.append(text.substr(0, index));
                    }
                    current = self.nodes[current].equal;
                }
            }
        }
        return best;
    }

    // --- Deletion ---------------------------------------------------------

    // Marks `key` as no longer stored.  Nodes are only unlinked when they
    // become wholly unreachable, which for a ternary tree means all three
    // links are nil and the node carries no payload.
    fn erase(ref self, key: string) -> bool {
        let node = self.find_node(key);
        if (node == TRIE_NIL) {
            return false;
        }
        if (not self.nodes[node].terminal) {
            return false;
        }
        self.nodes[node].terminal = false;
        self.nodes[node].weight = 0;
        self.count -= 1;
        self.pending_prune += 1;
        if (self.pending_prune >= 16) {
            Discard(self.compact());
        }
        return true;
    }

    // Rebuilds the tree from its surviving keys, which is the simplest way to
    // reclaim the nodes that repeated erasures left dangling.  The rebuild
    // inserts in median-first order so the resulting tree is balanced.
    fn compact(ref self) -> int {
        var entries = self.to_pairs();
        let before = self.nodes.size();
        self.nodes.clear();
        self.root = TRIE_NIL;
        self.count = 0;
        self.pending_prune = 0;

        var ordered = sort_pairs_by_key(V)(entries);
        self.insert_balanced(ordered, 0, ordered.size() - 1);
        Destroy(ordered);
        Destroy(entries);
        return before - self.nodes.size();
    }

    // Inserts the half-open run `[low, high]` median first, which keeps the
    // low/high links of the rebuilt tree balanced.
    fn insert_balanced(ref self, entries: vector(pair(string, V)),
                       low: int, high: int) {
        if (low > high) {
            return;
        }
        var stack = vector(pair(int, int))();
        stack.push_back(pair(int, int)({.first = low, .second = high}));
        while (stack.size() > 0) {
            let frame = stack.back();
            stack.pop_back();
            let begin = frame.first;
            let end = frame.second;
            if (begin > end) {
                Discard(frame);
            } else {
                let middle = begin + (end - begin) / 2;
                Discard(self.insert(entries[middle].first, entries[middle].second,
                                WEIGHT_DEFAULT));
                stack.push_back(pair(int, int)({.first = begin, .second = middle - 1}));
                stack.push_back(pair(int, int)({.first = middle + 1, .second = end}));
            }
        }
        Destroy(stack);
    }

    fn clear(ref self) {
        for (node in self.nodes) {
            node.reset();
        }
        self.nodes.clear();
        self.root = TRIE_NIL;
        self.count = 0;
        self.pending_prune = 0;
    }

    // --- Validation -------------------------------------------------------

    // 1. Low links hold strictly smaller split characters, high links
    //    strictly larger.
    // 2. `count` equals the number of terminal nodes.
    fn check_validity(self) -> bool {
        Assert(self.count >= 0);
        if (self.root == TRIE_NIL) {
            Assert(self.count == 0);
            Prove(self.count == 0);
            return true;
        }
        var stack = vector(int)();
        stack.push_back(self.root);
        var terminals: int = 0;
        while (stack.size() > 0) {
            let here = stack.back();
            stack.pop_back();
            if (self.nodes[here].terminal) {
                terminals += 1;
            }
            if (self.nodes[here].low != TRIE_NIL) {
                Assert(self.nodes[self.nodes[here].low].split < self.nodes[here].split);
                Prove(self.nodes[self.nodes[here].low].split < self.nodes[here].split);
                stack.push_back(self.nodes[here].low);
            }
            if (self.nodes[here].high != TRIE_NIL) {
                Assert(self.nodes[self.nodes[here].high].split > self.nodes[here].split);
                Prove(self.nodes[self.nodes[here].high].split > self.nodes[here].split);
                stack.push_back(self.nodes[here].high);
            }
            if (self.nodes[here].equal != TRIE_NIL) {
                stack.push_back(self.nodes[here].equal);
            }
        }
        Destroy(stack);
        Assert(terminals == self.count);
        Prove(terminals == self.count);
        return true;
    }

    var nodes: vector(TernaryNode(V));
    var root: int = -1;
    var count: int = 0;
    var pending_prune: int = 0;
    var missing: V;
}

// --- Bounded top-k selection ----------------------------------------------

// A fixed-capacity best-of collection over `Completion{V}` values.
//
// Completions arrive in trie order, which is lexicographic and has nothing to
// do with their score, so the ranking layer needs a running "best k so far".
// Keeping the run sorted by insertion is cheap because `k` is small -- eight
// by default -- and it means the caller never has to sort the whole candidate
// set, which for a one-character prefix can be the entire index.
class TopK(V: type)
{

    fn size(self) -> int {
        return self.entries.size();
    }

    fn empty(self) -> bool {
        return self.entries.size() == 0;
    }

    fn full(self) -> bool {
        return self.entries.size() >= self.capacity;
    }

    fn configure(ref self, k: int) {
        var bounded = k;
        if (bounded < 1) {
            bounded = 1;
        }
        if (bounded > MAX_TOP_K) {
            bounded = MAX_TOP_K;
        }
        self.capacity = bounded;
        self.entries.reserve(bounded);
    }

    // Score of the weakest entry currently held, or a very negative sentinel
    // while the collection has room to spare.  Callers prune their search
    // against this, which is what makes the whole thing worth having.
    fn cutoff(self) -> int {
        if (self.entries.size() < self.capacity) {
            return -2147483647;
        }
        return self.entries[self.entries.size() - 1].score;
    }

    // True when a candidate scoring `score` could still make the cut.
    fn admits(self, score: int) -> bool {
        if (self.entries.size() < self.capacity) {
            return true;
        }
        return score > self.cutoff();
    }

    // Inserts `candidate` in score order, dropping the weakest entry when the
    // collection is already at capacity.
    fn offer(ref self, candidate: Completion(V)) -> bool {
        self.considered += 1;
        if (not self.admits(candidate.score)) {
            self.rejected += 1;
            return false;
        }

        var position = self.entries.size();
        var index: int = 0;
        while (index < self.entries.size()) {
            if (candidate.better_than(self.entries[index])) {
                position = index;
                index = self.entries.size();
            } else {
                index += 1;
            }
        }

        self.entries.insert(position, candidate);
        if (self.entries.size() > self.capacity) {
            self.entries.pop_back();
            self.evicted += 1;
        }
        self.accepted += 1;
        return true;
    }

    // The ranked run, best first.
    fn ranked(self) -> vector(Completion(V)) {
        var out = vector(Completion(V))();
        for (entry in self.entries) {
            out.push_back(entry);
        }
        return out;
    }

    // The same run reduced to (key, score) pairs, which is the shape the
    // per-prefix cache stores.
    fn as_scored_keys(self) -> vector(pair(string, int)) {
        var out = vector(pair(string, int))();
        for (entry in self.entries) {
            out.push_back(pair(string, int)({.first = entry.key, .second = entry.score}));
        }
        return out;
    }

    fn clear(ref self) {
        self.entries.clear();
        self.considered = 0;
        self.accepted = 0;
        self.rejected = 0;
        self.evicted = 0;
    }

    // Ranked entries, best first, never longer than `capacity`.
    var entries: vector(Completion(V));

    var capacity: int = 8;
    var considered: int = 0;
    var accepted: int = 0;
    var rejected: int = 0;
    var evicted: int = 0;
}

// --- Fuzzy matching -------------------------------------------------------

// One row of the edit-distance table, paired with the node it was computed at.
//
// The fuzzy walk carries a single dynamic-programming row down the trie: at
// each node the row is extended by one character, and the whole subtree is
// abandoned as soon as every cell in the row exceeds the budget.  That is the
// entire trick -- it turns `O(keys * length)` into something closer to
// `O(reachable nodes)`.
class EditRow {

    fn width(self) -> int {
        return self.cells.size();
    }

    fn last(self) -> int {
        return self.cells[self.cells.size() - 1];
    }

    // Smallest value anywhere in the row: the best any descendant could
    // possibly do, and therefore the pruning bound.
    fn best(self) -> int {
        var lowest = TRIE_MAX_KEY_LENGTH;
        for (cell in self.cells) {
            if (cell < lowest) {
                lowest = cell;
            }
        }
        return lowest;
    }

    fn exceeds(self, budget: int) -> bool {
        return self.best() > budget;
    }

    fn describe(self) -> string {
        var text = string();
        text.append("row depth=");
        text.append(to_string(self.depth));
        text.append(" best=");
        text.append(to_string(self.best()));
        return text;
    }

    var cells: vector(int);
    var node: int = -1;
    var depth: int = 0;
    var edge: char = '\0';
}

// Bounded-edit-distance search over a `Trie{V, ALPHABET}`.
//
// Kept as its own struct rather than a method so the budget, the counters and
// the seed row can be configured once and reused across queries.
class FuzzyMatcher(V: type, ALPHABET: int)
{

    fn configure(ref self, budget: int) {
        var bounded = budget;
        if (bounded < 0) {
            bounded = 0;
        }
        if (bounded > MAX_EDIT_BUDGET) {
            bounded = MAX_EDIT_BUDGET;
        }
        self.budget = bounded;
    }

    // The row for the root: distance `i` from the empty string to the first
    // `i` characters of the pattern.
    fn seed_row(self, pattern: string) -> EditRow {
        var row = EditRow();
        var index: int = 0;
        while (index <= pattern.size()) {
            row.cells.push_back(index);
            index += 1;
        }
        row.depth = 0;
        row.edge = CHAR_NUL;
        return row;
    }

    // Extends `previous` by the character `c`, which is the standard
    // Levenshtein recurrence with the three costs spelled out.
    fn step_row(self, previous: EditRow, c: char,
                pattern: string) -> EditRow {
        var row = EditRow();
        row.depth = previous.depth + 1;
        row.edge = c;
        row.cells.push_back(previous.cells[0] + 1);

        var index: int = 1;
        while (index <= pattern.size()) {
            let deletion = row.cells[index - 1] + 1;
            let insertion = previous.cells[index] + 1;
            var substitution = previous.cells[index - 1];
            if (pattern.at(index - 1) != c) {
                substitution += 1;
            }

            var best = deletion;
            if (insertion < best) {
                best = insertion;
            }
            if (substitution < best) {
                best = substitution;
            }
            row.cells.push_back(best);
            index += 1;
        }
        self.rows_built += 1;
        return row;
    }

    // Walks `index` collecting every key within `budget` edits of `pattern`.
    //
    // The frame stack carries `pair{EditRow, string}` values: the row computed
    // at that node and the key spelled by the path taken to reach it.
    fn search(ref self, index: Trie(V, ALPHABET),
              pattern: string) -> vector(Completion(V)) {
        var out = vector(Completion(V))();
        self.rows_built = 0;
        self.nodes_visited = 0;
        self.subtrees_pruned = 0;
        if (index.size() == 0) {
            return out;
        }

        var stack = vector(pair(EditRow, string))();
        var root_row = self.seed_row(pattern);
        root_row.node = index.root_index();
        var empty_path = string();
        stack.push_back(pair(EditRow, string)({.first = root_row, .second = empty_path}));
        Destroy(root_row);
        Destroy(empty_path);

        while (stack.size() > 0) {
            let frame = stack.back();
            var row = frame.first;
            var path = frame.second;
            stack.pop_back();
            self.nodes_visited += 1;

            let here = row.node;
            let distance = row.last();
            if (distance <= self.budget and index.node_at(here).is_terminal()) {
                var found = Completion(V)();
                found.key.append(path);
                found.value = index.node_at(here).payload;
                found.weight = index.node_at(here).weight;
                found.edits = distance;
                found.node = here;
                if (distance == 0) {
                    found.kind = MatchKind.ExactMatch;
                } else {
                    found.kind = MatchKind.FuzzyMatch;
                }
                found.score = fuzzy_score(found.weight, distance, path.size(),
                                          pattern.size());
                out.push_back(found);
                Destroy(found);
            }

            var edges = index.node_at(here).edges();
            for (edge in edges) {
                var child_row = self.step_row(row, edge.first, pattern);
                child_row.node = edge.second;
                if (child_row.exceeds(self.budget)) {
                    self.subtrees_pruned += 1;
                } else {
                    var child_path = push_char(path, edge.first);
                    stack.push_back(pair(EditRow, string)({.first = child_row,
                                                          .second = child_path}));
                    Destroy(child_path);
                }
                Destroy(child_row);
            }
            Destroy(edges);
            Destroy(row);
            Destroy(path);
        }
        Destroy(stack);
        return out;
    }

    // Fuzzy search reduced to the best `k` results.
    fn search_top(ref self, index: Trie(V, ALPHABET),
                  pattern: string, k: int) -> vector(Completion(V)) {
        var picker = TopK(V)();
        picker.configure(k);
        var candidates = self.search(index, pattern);
        for (candidate in candidates) {
            Discard(picker.offer(candidate));
        }
        Destroy(candidates);
        var out = picker.ranked();
        Destroy(picker);
        return out;
    }

    // Per-query counters, useful for confirming that pruning is doing its job.
    var budget: int = 2;
    var rows_built: int = 0;
    var nodes_visited: int = 0;
    var subtrees_pruned: int = 0;
}

// --- Autocomplete layer ---------------------------------------------------

// One learned query, kept so the ranking layer can prefer things the user has
// actually typed over things that merely exist in the dictionary.
class QueryRecord {

    fn describe(self) -> string {
        var text = string();
        text.append(self.text);
        text.append(" hits=");
        text.append(to_string(self.hits));
        text.append(" weight=");
        text.append(to_string(self.weight));
        return text;
    }

    // Reinforcement: each new hit raises the weight, with diminishing returns
    // so a single runaway query cannot dominate the ranking forever.
    fn reinforce(ref self, amount: int) {
        self.hits += 1;
        var gain = amount;
        if (self.hits > 8) {
            gain = amount / 2;
        }
        if (self.hits > 64) {
            gain = amount / 4;
        }
        self.weight += gain;
    }

    var text: string;
    var hits: int = 0;
    var weight: int = 0;
    var last_seen: int = 0;
}

// The ranking layer.
//
// It owns three views of the same key set:
//
//   * `index`  -- the array-mapped trie, used for prefix and fuzzy queries,
//   * `mirror` -- the radix tree, used for longest-prefix queries where the
//                 compressed representation walks far fewer nodes,
//   * `history`-- the learned query weights.
//
// Keeping both tree representations live is deliberate: it doubles the
// mutation cost but it makes every query cheap, and for a suggestion index
// reads outnumber writes by orders of magnitude.
class Autocomplete(V: type, ALPHABET: int)
{

    fn size(self) -> int {
        return self.index.size();
    }

    fn empty(self) -> bool {
        return self.index.empty();
    }

    fn alphabet_width(self) -> int {
        return ALPHABET;
    }

    // Borrowed view of the underlying trie, so callers can run their own
    // walks without the layer having to proxy every method.
    fn trie(ref self) -> ref Trie(V, ALPHABET) {
        return self.index;
    }

    fn radix(ref self) -> ref RadixTree(V, ALPHABET) {
        return self.mirror;
    }

    // --- Population -------------------------------------------------------

    // Adds one term to both representations.
    fn learn(ref self, key: string, value: V, weight: int) -> TrieOutcome {
        var folded = normalize_key(ALPHABET)(key);
        if (folded.first.size() == 0) {
            Destroy(folded);
            return TrieOutcome.Rejected;
        }
        let outcome = self.index.insert(folded.first, value, weight);
        Discard(self.mirror.insert(folded.first, value, weight));
        self.dropped_characters += folded.second;
        self.invalidate(folded.first);
        Destroy(folded);
        return outcome;
    }

    fn learn_default(ref self, key: string, value: V) -> TrieOutcome {
        return self.learn(key, value, WEIGHT_DEFAULT);
    }

    // Bulk population from a weighted run.
    fn learn_all(ref self,
                 entries: vector(pair(string, pair(V, int)))) -> int {
        var added: int = 0;
        for (entry in entries) {
            if (self.learn(entry.first, entry.second.first,
                      entry.second.second) == TrieOutcome.Inserted) {
                added += 1;
            }
        }
        return added;
    }

    // Records that the user actually selected `key`, raising its weight in
    // the index and in the history table alike.
    fn record_selection(ref self, key: string) -> bool {
        var folded = normalize_key(ALPHABET)(key);
        if (not self.history.contains(folded.first)) {
            var record = QueryRecord();
            record.text.append(folded.first);
            record.weight = WEIGHT_DEFAULT;
            Discard(self.history.insert(folded.first, record));
            Destroy(record);
        }
        self.history.at(folded.first).reinforce(WEIGHT_DEFAULT / 4);
        self.history.at(folded.first).last_seen = self.clock;
        self.clock += 1;

        let bumped = self.index.bump(folded.first, WEIGHT_DEFAULT / 4);
        self.invalidate(folded.first);
        Destroy(folded);
        return bumped;
    }

    // Registers `alias` as another spelling of `canonical`.  Aliases are
    // expanded at query time rather than being inserted as real keys, so they
    // cost nothing until somebody actually types one.
    fn add_alias(ref self, alias_: string,
                 canonical: string) {
        if (not self.synonyms.contains(alias_)) {
            var bucket = vector(string)();
            Discard(self.synonyms.insert(alias_, bucket));
            Destroy(bucket);
        }
        self.synonyms.at(alias_).push_back(canonical);
    }

    fn remove(ref self, key: string) -> bool {
        var folded = normalize_key(ALPHABET)(key);
        let gone = self.index.erase(folded.first);
        Discard(self.mirror.erase(folded.first));
        Discard(self.history.erase(folded.first));
        self.invalidate(folded.first);
        Destroy(folded);
        return gone;
    }

    // --- Cache ------------------------------------------------------------

    // Drops every cached expansion that could be affected by a change to
    // `key`, which is every prefix of it plus every prefix it is a prefix of.
    fn invalidate(ref self, key: string) {
        var doomed = vector(string)();
        for (entry in self.cache) {
            if (starts_with(key, entry.first) or starts_with(entry.first, key)) {
                doomed.push_back(entry.first);
            }
        }
        for (prefix in doomed) {
            Discard(self.cache.erase(prefix));
        }
        Destroy(doomed);
        self.invalidations += 1;
    }

    fn clear_cache(ref self) {
        self.cache.clear();
        self.cache_hits = 0;
        self.cache_misses = 0;
    }

    // --- Scoring ----------------------------------------------------------

    // Score for a completion drawn from the trie under `prefix`.
    //
    // The weight dominates; the length penalty only breaks ties between
    // equally popular completions, and the exact-match bonus makes sure that
    // typing a whole key ranks it first.
    fn score_for(self, key: string,
                 prefix: string, weight: int) -> int {
        var score = weight;
        let extra = key.size() - prefix.size();
        score -= extra * SCORE_LENGTH_PENALTY;
        if (extra == 0) {
            score += SCORE_EXACT_BONUS;
        }
        if (self.history.contains(key)) {
            score += self.history.at(key).weight / 2;
        }
        if (score < WEIGHT_FLOOR) {
            score = WEIGHT_FLOOR;
        }
        return score;
    }

    // --- Queries ----------------------------------------------------------

    // The best `k` completions of `prefix`, ranked by score.
    //
    // The walk is a bounded top-k selection over the trie subtree, pruned by
    // the running cutoff: a subtree whose aggregate weight cannot beat the
    // weakest entry already held is skipped without being entered.
    fn suggest(ref self, prefix: string, k: int) -> vector(Completion(V)) {
        var folded = normalize_key(ALPHABET)(prefix);
        var picker = TopK(V)();
        picker.configure(k);

        let start = self.index.find_node(folded.first);
        if (start == TRIE_NIL) {
            self.misses += 1;
            var empty_result = picker.ranked();
            Destroy(picker);
            Destroy(folded);
            return empty_result;
        }

        var stack = vector(pair(int, string))();
        stack.push_back(pair(int, string)({.first = start, .second = folded.first}));
        var visited: int = 0;
        var pruned: int = 0;

        while (stack.size() > 0) {
            let frame = stack.back();
            let here = frame.first;
            var path = frame.second;
            stack.pop_back();
            visited += 1;

            if (self.index.node_at(here).is_terminal()) {
                var found = Completion(V)();
                found.key.append(path);
                found.value = self.index.node_at(here).payload;
                found.weight = self.index.node_at(here).weight;
                found.node = here;
                found.edits = 0;
                if (path.size() == folded.first.size()) {
                    found.kind = MatchKind.ExactMatch;
                } else {
                    found.kind = MatchKind.PrefixMatch;
                }
                found.score = self.score_for(found.key, folded.first, found.weight);
                Discard(picker.offer(found));
                Destroy(found);
            }

            var edges = self.index.node_at(here).edges();
            for (edge in edges) {
                // Best score any key in this subtree could possibly reach.
                let ceiling = self.index.node_at(edge.second).subtree_weight;
                if (picker.admits(ceiling)) {
                    var child_path = push_char(path, edge.first);
                    stack.push_back(pair(int, string)({.first = edge.second,
                                                      .second = child_path}));
                    Destroy(child_path);
                } else {
                    pruned += 1;
                }
            }
            Destroy(edges);
            Destroy(path);
        }
        Destroy(stack);

        self.nodes_visited += visited;
        self.subtrees_pruned += pruned;
        self.queries += 1;

        // Memoise the ranked keys so an identical prefix is answered from the
        // cache next time.
        var scored = picker.as_scored_keys();
        Discard(self.cache.insert(folded.first, scored));
        Destroy(scored);

        var out = picker.ranked();
        Destroy(picker);
        Destroy(folded);
        return out;
    }

    fn suggest_default(ref self, prefix: string) -> vector(Completion(V)) {
        return self.suggest(prefix, DEFAULT_TOP_K);
    }

    // Cached variant: returns the memoised (key, score) run when the prefix
    // has been asked for before, and only walks the trie otherwise.
    fn suggest_cached(ref self, prefix: string,
                      k: int) -> vector(pair(string, int)) {
        var folded = normalize_key(ALPHABET)(prefix);
        if (self.cache.contains(folded.first)) {
            self.cache_hits += 1;
            var hit = vector(pair(string, int))();
            for (entry in self.cache.at(folded.first)) {
                hit.push_back(entry);
            }
            Destroy(folded);
            return hit;
        }
        self.cache_misses += 1;
        var fresh = self.suggest(folded.first, k);
        var out = vector(pair(string, int))();
        for (entry in fresh) {
            out.push_back(pair(string, int)({.first = entry.key, .second = entry.score}));
        }
        Destroy(fresh);
        Destroy(folded);
        return out;
    }

    // Completions of `prefix` allowing up to `budget` edits, which is what a
    // search box falls back to when the exact prefix has no hits.
    fn suggest_fuzzy(ref self, prefix: string, k: int,
                     budget: int) -> vector(Completion(V)) {
        var folded = normalize_key(ALPHABET)(prefix);
        var matcher = FuzzyMatcher(V, ALPHABET)();
        matcher.configure(budget);
        var out = matcher.search_top(self.index, folded.first, k);
        self.fuzzy_queries += 1;
        self.nodes_visited += matcher.nodes_visited;
        self.subtrees_pruned += matcher.subtrees_pruned;
        Destroy(matcher);
        Destroy(folded);
        return out;
    }

    // Exact prefix hits first, falling back to a fuzzy pass only when the
    // exact query came up short.  This is the query an editor actually runs.
    fn suggest_or_correct(ref self, prefix: string,
                          k: int) -> vector(Completion(V)) {
        var exact = self.suggest(prefix, k);
        if (exact.size() >= k) {
            return exact;
        }
        var corrected = self.suggest_fuzzy(prefix, k, DEFAULT_EDIT_BUDGET);
        var seen = set(string)();
        var out = vector(Completion(V))();
        for (entry in exact) {
            Discard(seen.insert(entry.key));
            out.push_back(entry);
        }
        for (entry in corrected) {
            if (not seen.contains(entry.key)) {
                Discard(seen.insert(entry.key));
                out.push_back(entry);
            }
        }
        Destroy(seen);
        Destroy(corrected);
        Destroy(exact);
        return out;
    }

    // Aliases expanded, then each expansion completed.  The nested return
    // type maps each alias onto its own ranked run.
    fn suggest_with_aliases(ref self, prefix: string,
                            k: int) -> map(string, vector(pair(string, int))) {
        var out = map(string, vector(pair(string, int)))();
        var direct = self.suggest_cached(prefix, k);
        Discard(out.insert(prefix, direct));
        Destroy(direct);

        if (self.synonyms.contains(prefix)) {
            for (alias_ in self.synonyms.at(prefix)) {
                var expansion = self.suggest_cached(alias_, k);
                Discard(out.insert(alias_, expansion));
                Destroy(expansion);
            }
        }
        return out;
    }

    // The inline completion an editor greys out after the cursor: the longest
    // unambiguous extension of what has been typed so far.
    fn inline_completion(self, prefix: string) -> string {
        return self.index.extend_unambiguously(prefix);
    }

    // Longest stored term that prefixes `text`, answered from the compressed
    // mirror because that walk touches far fewer nodes.
    fn longest_term_in(self, text: string) -> string {
        var found = self.mirror.longest_matching_prefix(text);
        var out = string();
        out.append(found.first);
        Destroy(found);
        return out;
    }

    // Greedy left-to-right segmentation of `text` into stored terms.  Each
    // step takes the longest term that matches at the cursor, and skips one
    // character when nothing matches at all.
    fn segment(self, text: string) -> vector(pair(string, int)) {
        var out = vector(pair(string, int))();
        var cursor: int = 0;
        var guard: int = 0;
        while (cursor < text.size() and guard < TRIE_MAX_KEY_LENGTH) {
            guard += 1;
            var tail = text.substr(cursor, text.size() - cursor);
            var term = self.longest_term_in(tail);
            if (term.size() == 0) {
                cursor += 1;
            } else {
                out.push_back(pair(string, int)({.first = term, .second = cursor}));
                cursor += term.size();
            }
            Destroy(term);
            Destroy(tail);
        }
        return out;
    }

    // --- Maintenance ------------------------------------------------------

    // Ages every weight and drops whatever fell through the floor.
    fn age(ref self) -> int {
        Discard(self.index.decay());
        let evicted = self.index.evict_below(WEIGHT_FLOOR + 1);
        self.clear_cache();
        return evicted;
    }

    fn clear(ref self) {
        self.index.clear();
        self.mirror.clear();
        self.history.clear();
        self.synonyms.clear();
        self.cache.clear();
        self.queries = 0;
        self.fuzzy_queries = 0;
        self.misses = 0;
        self.nodes_visited = 0;
        self.subtrees_pruned = 0;
        self.invalidations = 0;
        self.dropped_characters = 0;
        self.clock = 0;
    }

    fn describe(self) -> string {
        var text = string();
        text.append("autocomplete terms=");
        text.append(to_string(self.index.size()));
        text.append(" nodes=");
        text.append(to_string(self.index.node_count()));
        text.append(" queries=");
        text.append(to_string(self.queries));
        text.append(" pruned=");
        text.append(to_string(self.subtrees_pruned));
        text.append(" cache=");
        text.append(to_string(self.cache_hits));
        text.append("/");
        text.append(to_string(self.cache_hits + self.cache_misses));
        return text;
    }

    // Primary index.
    var index: Trie(V, ALPHABET);

    // Compressed mirror, kept in step with `index` on every mutation.
    var mirror: RadixTree(V, ALPHABET);

    // Learned query weights.
    var history: map(string, QueryRecord);

    // Alias expansions, one prefix mapping onto many canonical spellings.
    var synonyms: map(string, vector(string));

    // Memoised ranked expansions, keyed by prefix.
    var cache: map(string, vector(pair(string, int)));

    var queries: int = 0;
    var fuzzy_queries: int = 0;
    var misses: int = 0;
    var cache_hits: int = 0;
    var cache_misses: int = 0;
    var nodes_visited: int = 0;
    var subtrees_pruned: int = 0;
    var invalidations: int = 0;
    var dropped_characters: int = 0;
    var clock: int = 0;
}

// --- Flat-array serialisation ---------------------------------------------

// One record of the serialised form.
//
// Records are emitted in breadth-first order, so a record's parent always
// appears before it and the whole array can be replayed in a single forward
// pass with no back-patching.
class FlatRecord {

    fn is_leaf(self) -> bool {
        return self.child_count == 0;
    }

    fn describe(self) -> string {
        var text = string();
        text.append("record parent=");
        text.append(to_string(self.parent));
        text.append(" edge=");
        text.push_back(self.edge);
        text.append(" children=");
        text.append(to_string(self.child_count));
        return text;
    }

    var parent: int = -1;
    var edge: char = '\0';
    var depth: int = 0;
    var weight: int = 0;
    var child_count: int = 0;
    var payload_slot: int = -1;
    var tag: SerialTag = SerialTag.TagBranch;
}

// The flat form of a whole index.
//
// Everything is stored in parallel arrays of plain values, so the structure
// can be written to disk, hashed, or compared for equality without walking a
// single link.  `payloads` is kept separate from `records` because payload
// types are frequently much larger than a record and most nodes have none.
class FlatTrie(V: type, ALPHABET: int)
{

    fn size(self) -> int {
        return self.records.size();
    }

    fn empty(self) -> bool {
        return self.records.size() == 0;
    }

    fn key_count(self) -> int {
        return self.payloads.size();
    }

    fn alphabet_width(self) -> int {
        return ALPHABET;
    }

    // Header validation: the version and alphabet width have to match what
    // this build expects before any record is trusted.
    fn header_valid(self) -> bool {
        if (self.version != 1) {
            return false;
        }
        if (self.alphabet != ALPHABET) {
            return false;
        }
        return self.records.size() >= self.payloads.size();
    }

    // Rebuilds the key spelled by record `index` by walking the parent chain.
    fn key_of(self, index: int) -> string {
        var reversed = vector(char)();
        var current = index;
        var guard: int = 0;
        while (current > 0 and guard < TRIE_MAX_DEPTH) {
            reversed.push_back(self.records[current].edge);
            current = self.records[current].parent;
            guard += 1;
        }
        var out = string();
        var cursor = reversed.size() - 1;
        while (cursor >= 0) {
            out.push_back(reversed[cursor]);
            cursor -= 1;
        }
        Destroy(reversed);
        return out;
    }

    // Every stored key with its payload, recovered straight from the flat
    // form without rebuilding a tree first.
    fn entries(self) -> vector(pair(string, V)) {
        var out = vector(pair(string, V))();
        for (slot in self.payloads) {
            var key = self.key_of(slot.first);
            out.push_back(pair(string, V)({.first = key, .second = slot.second}));
            Destroy(key);
        }
        return out;
    }

    fn describe(self) -> string {
        var text = string();
        text.append("flat records=");
        text.append(to_string(self.records.size()));
        text.append(" payloads=");
        text.append(to_string(self.payloads.size()));
        text.append(" alphabet=");
        text.append(to_string(self.alphabet));
        return text;
    }

    fn clear(ref self) {
        self.records.clear();
        self.payloads.clear();
        self.edge_table.clear();
        self.version = 1;
        self.alphabet = ALPHABET;
    }

    // Breadth-first record array.
    var records: vector(FlatRecord);

    // (record index, payload) pairs, one per terminal node.
    var payloads: vector(pair(int, V));

    // Redundant edge index: parent record onto its (character, child) list.
    // Not needed to replay the array, but it makes a random-access reader
    // possible without a full scan.
    var edge_table: map(int, vector(pair(char, int)));

    var version: int = 1;
    var alphabet: int = 0;
}

// Serialises `source` into its flat form.
//
// Nodes are numbered by the order they come out of the breadth-first walk,
// which is not the same as their arena index, so `mapping` translates between
// the two while the records are being emitted.
fn serialize_trie[V: type, ALPHABET: int]
    (source: Trie(V, ALPHABET)) -> FlatTrie(V, ALPHABET) {
    var flat = FlatTrie(V, ALPHABET)();
    flat.version = 1;
    flat.alphabet = ALPHABET;
    if (source.size() == 0) {
        return flat;
    }

    var mapping = map(int, int)();
    var frontier = vector(int)();
    frontier.push_back(source.root_index());
    Discard(mapping.insert(source.root_index(), 0));

    var root_record = FlatRecord();
    root_record.parent = TRIE_NIL;
    root_record.edge = CHAR_NUL;
    root_record.depth = 0;
    root_record.tag = SerialTag.TagBranch;
    flat.records.push_back(root_record);
    Destroy(root_record);

    var cursor: int = 0;
    while (cursor < frontier.size()) {
        let here = frontier[cursor];
        let record_index = mapping.at(here);
        cursor += 1;

        if (source.node_at(here).is_terminal()) {
            flat.records[record_index].tag = SerialTag.TagLeaf;
            flat.records[record_index].weight = source.node_at(here).weight;
            flat.records[record_index].payload_slot = flat.payloads.size();
            flat.payloads.push_back(pair(int, V)({.first = record_index,
                                                 .second = source.node_at(here).payload}));
        }

        var edges = source.node_at(here).edges();
        flat.records[record_index].child_count = edges.size();

        var listing = vector(pair(char, int))();
        for (edge in edges) {
            var child_record = FlatRecord();
            child_record.parent = record_index;
            child_record.edge = edge.first;
            child_record.depth = flat.records[record_index].depth + 1;
            child_record.tag = SerialTag.TagEdge;
            flat.records.push_back(child_record);
            let child_index = flat.records.size() - 1;
            Destroy(child_record);

            Discard(mapping.insert(edge.second, child_index));
            frontier.push_back(edge.second);
            listing.push_back(pair(char, int)({.first = edge.first, .second = child_index}));
        }
        if (listing.size() > 0) {
            Discard(flat.edge_table.insert(record_index, listing));
        }
        Destroy(listing);
        Destroy(edges);
    }

    Destroy(frontier);
    Destroy(mapping);
    return flat;
}

// Replays a flat form back into a live trie.
//
// Because records are in breadth-first order, one forward pass suffices: by
// the time a record is read, its parent has already been created.
fn deserialize_trie[V: type, ALPHABET: int]
    (flat: FlatTrie(V, ALPHABET),
                    ref target: Trie(V, ALPHABET)) -> bool {
    target.clear();
    if (not flat.header_valid()) {
        return false;
    }
    if (flat.empty()) {
        return true;
    }

    var entries = flat.entries();
    var index: int = 0;
    while (index < entries.size()) {
        let record_index = flat.payloads[index].first;
        let weight = flat.records[record_index].weight;
        Discard(target.insert(entries[index].first, entries[index].second, weight));
        index += 1;
    }
    Destroy(entries);
    target.rebuild_aggregates();
    return true;
}

// Round-trip check: serialise, replay, and confirm the key sets agree.
fn round_trip_ok[V: type, ALPHABET: int]
    (source: Trie(V, ALPHABET)) -> bool {
    var flat = serialize_trie(V, ALPHABET)(source);
    var rebuilt = Trie(V, ALPHABET)();
    if (not deserialize_trie(V, ALPHABET)(flat, rebuilt)) {
        Destroy(flat);
        Destroy(rebuilt);
        return false;
    }
    let same = rebuilt.size() == source.size();
    Assert(same);
    Prove(rebuilt.size() == source.size());
    Destroy(flat);
    Destroy(rebuilt);
    return same;
}

// --- Statistics -----------------------------------------------------------

// Shape summary for one index.
//
// Everything here is derived, never maintained incrementally, because the
// numbers are only ever looked at by a human or a test and paying for them on
// every insertion would be absurd.
class TrieStatistics(V: type, ALPHABET: int)
{

    // Mean depth of a terminal node, in hundredths so the fixed-point result
    // still carries two useful digits.
    fn average_depth(self) -> int {
        if (self.terminals == 0) {
            return 0;
        }
        return self.depth_total * 100 / self.terminals;
    }

    // Mean number of children over the branch nodes, also in hundredths.
    fn average_fanout(self) -> int {
        let branches = self.nodes - self.leaves;
        if (branches == 0) {
            return 0;
        }
        return self.fanout_total * 100 / branches;
    }

    fn leaf_percent(self) -> int {
        if (self.nodes == 0) {
            return 0;
        }
        return self.leaves * 100 / self.nodes;
    }

    // Nodes per stored key.  A well-shared dictionary sits well below 100;
    // a set of unrelated keys approaches their average length.
    fn nodes_per_key(self) -> int {
        if (self.terminals == 0) {
            return 0;
        }
        return self.nodes * 100 / self.terminals;
    }

    // How much the path-compressed mirror saved, as a percentage of the
    // uncompressed node count.
    fn compression_percent(self) -> int {
        if (self.nodes == 0) {
            return 0;
        }
        return (self.nodes - self.compressed_nodes) * 100 / self.nodes;
    }

    // A tree is considered well-shaped when no terminal sits more than twice
    // the average depth down.
    fn balanced(self) -> bool {
        if (self.terminals == 0) {
            return true;
        }
        return self.max_depth * 100 <= self.average_depth() * 2 + 100;
    }

    // Number of nodes recorded at exactly `depth`.
    fn at_depth(self, depth: int) -> int {
        for (bucket in self.depth_histogram) {
            if (bucket.first == depth) {
                return bucket.second;
            }
        }
        return 0;
    }

    // Number of nodes whose fan-out fell into bucket `slot`.
    fn fanout_bucket(self, slot: int) -> int {
        for (bucket in self.fanout_histogram) {
            if (bucket.first == slot) {
                return bucket.second;
            }
        }
        return 0;
    }

    fn record_depth(ref self, depth: int) {
        var index: int = 0;
        while (index < self.depth_histogram.size()) {
            if (self.depth_histogram[index].first == depth) {
                self.depth_histogram[index].second += 1;
                return;
            }
            index += 1;
        }
        self.depth_histogram.push_back(pair(int, int)({.first = depth, .second = 1}));
    }

    fn record_fanout(ref self, fanout: int) {
        var slot = fanout;
        if (slot >= FANOUT_BUCKETS) {
            slot = FANOUT_BUCKETS - 1;
        }
        var index: int = 0;
        while (index < self.fanout_histogram.size()) {
            if (self.fanout_histogram[index].first == slot) {
                self.fanout_histogram[index].second += 1;
                return;
            }
            index += 1;
        }
        self.fanout_histogram.push_back(pair(int, int)({.first = slot, .second = 1}));
    }

    fn describe(self) -> string {
        var text = string();
        text.append("nodes=");
        text.append(to_string(self.nodes));
        text.append(" keys=");
        text.append(to_string(self.terminals));
        text.append(" leaves=");
        text.append(to_string(self.leaves));
        text.append(" maxdepth=");
        text.append(to_string(self.max_depth));
        text.append(" avgdepth=");
        text.append(to_string(self.average_depth()));
        text.append(" avgfanout=");
        text.append(to_string(self.average_fanout()));
        text.append(" nodesperkey=");
        text.append(to_string(self.nodes_per_key()));
        return text;
    }

    // Node count at each depth.
    var depth_histogram: vector(pair(int, int));

    // Node count in each fan-out bucket, the last bucket being "or more".
    var fanout_histogram: vector(pair(int, int));

    // How many keys start with each initial character.
    var initial_counts: map(char, int);

    // Keys grouped by length, retained only up to the sample limit so the
    // summary itself stays small.
    var length_groups: map(int, vector(string));

    // A handful of representative (key, weight) pairs.
    var samples: vector(pair(string, int));

    var nodes: int = 0;
    var terminals: int = 0;
    var leaves: int = 0;
    var branches: int = 0;
    var overflow_nodes: int = 0;
    var compressed_nodes: int = 0;
    var max_depth: int = 0;
    var depth_total: int = 0;
    var fanout_total: int = 0;
    var max_fanout: int = 0;
    var weight_total: int = 0;
    var key_length_total: int = 0;
}

// Single pass over an index collecting every shape number at once.
fn collect_statistics[V: type, ALPHABET: int]
    (index: Trie(V, ALPHABET)) -> TrieStatistics(V, ALPHABET) {
    var stats = TrieStatistics(V, ALPHABET)();
    if (index.size() == 0) {
        return stats;
    }

    var levels = index.level_order();
    var depth: int = 0;
    while (depth < levels.size()) {
        for (node in levels[depth]) {
            stats.nodes += 1;
            stats.record_depth(depth);

            let fanout = index.node_at(node).degree();
            stats.fanout_total += fanout;
            stats.record_fanout(fanout);
            if (fanout > stats.max_fanout) {
                stats.max_fanout = fanout;
            }
            if (fanout == 0) {
                stats.leaves += 1;
            } else {
                stats.branches += 1;
            }
            if (index.node_at(node).sparse_degree() > 0) {
                stats.overflow_nodes += 1;
            }
            if (index.node_at(node).is_terminal()) {
                stats.terminals += 1;
                stats.depth_total += depth;
                stats.weight_total += index.node_at(node).weight;
                if (depth > stats.max_depth) {
                    stats.max_depth = depth;
                }
            }
        }
        depth += 1;
    }
    Destroy(levels);

    // Second pass over the key set for the per-key groupings.
    var entries = index.to_pairs();
    for (entry in entries) {
        stats.key_length_total += entry.first.size();

        if (entry.first.size() > 0) {
            let initial = entry.first.at(0);
            if (not stats.initial_counts.contains(initial)) {
                Discard(stats.initial_counts.insert(initial, 0));
            }
            stats.initial_counts.at(initial) += 1;
        }

        let length = entry.first.size();
        if (not stats.length_groups.contains(length)) {
            var bucket = vector(string)();
            Discard(stats.length_groups.insert(length, bucket));
            Destroy(bucket);
        }
        if (stats.length_groups.at(length).size() < TRIE_SAMPLE_LIMIT) {
            stats.length_groups.at(length).push_back(entry.first);
        }

        if (stats.samples.size() < TRIE_SAMPLE_LIMIT) {
            stats.samples.push_back(pair(string, int)({.first = entry.first,
                                                      .second = index.weight_of(entry.first)}));
        }
    }
    Destroy(entries);
    return stats;
}

// Statistics with the compressed node count filled in from a radix mirror, so
// `compression_percent` becomes meaningful.
fn collect_statistics_paired[V: type, ALPHABET: int]
    (index: Trie(V, ALPHABET),
                             mirror: RadixTree(V, ALPHABET))
        -> TrieStatistics(V, ALPHABET) {
    var stats = collect_statistics(V, ALPHABET)(index);
    stats.compressed_nodes = mirror.node_count();
    return stats;
}

// --- Free functions -------------------------------------------------------

// Score for a fuzzy hit: the stored weight, less a penalty per edit and per
// character of length mismatch.  Kept free so the fuzzy walker does not have
// to know anything about the ranking policy.
fn fuzzy_score(weight: int, edits: int, key_length: int, pattern_length: int) -> int {
    var score = weight;
    score -= edits * SCORE_EDIT_PENALTY;
    let spread = abs(key_length - pattern_length);
    score -= spread * SCORE_LENGTH_PENALTY;
    if (edits == 0) {
        score += SCORE_EXACT_BONUS;
    }
    if (score < WEIGHT_FLOOR) {
        score = WEIGHT_FLOOR;
    }
    return score;
}

// Plain Levenshtein distance between two strings, used as the reference the
// trie walk is checked against.
fn edit_distance(a: string, b: string) -> int {
    var previous = vector(int)();
    var index: int = 0;
    while (index <= b.size()) {
        previous.push_back(index);
        index += 1;
    }

    var row: int = 1;
    while (row <= a.size()) {
        var current = vector(int)();
        current.push_back(row);
        var column: int = 1;
        while (column <= b.size()) {
            let deletion = current[column - 1] + 1;
            let insertion = previous[column] + 1;
            var substitution = previous[column - 1];
            if (a.at(row - 1) != b.at(column - 1)) {
                substitution += 1;
            }
            var best = deletion;
            if (insertion < best) {
                best = insertion;
            }
            if (substitution < best) {
                best = substitution;
            }
            current.push_back(best);
            column += 1;
        }
        previous.clear();
        for (cell in current) {
            previous.push_back(cell);
        }
        Destroy(current);
        row += 1;
    }

    let answer = previous[b.size()];
    Destroy(previous);
    return answer;
}

// Insertion sort of a `vector{pair{string, V}}` run by key.  Insertion sort is
// the right choice here because the runs it is handed come out of a trie and
// are therefore already almost sorted.
fn sort_pairs_by_key[V: type]
    (entries: vector(pair(string, V))) -> vector(pair(string, V)) {
    var out = vector(pair(string, V))();
    for (entry in entries) {
        var position = out.size();
        var index: int = 0;
        while (index < out.size()) {
            if (compare_strings(entry.first, out[index].first) < 0) {
                position = index;
                index = out.size();
            } else {
                index += 1;
            }
        }
        out.insert(position, entry);
    }
    return out;
}

// Same shape, ordered by descending score instead.
fn sort_completions[V: type]
    (entries: vector(Completion(V))) -> vector(Completion(V)) {
    var out = vector(Completion(V))();
    for (entry in entries) {
        var position = out.size();
        var index: int = 0;
        while (index < out.size()) {
            if (entry.better_than(out[index])) {
                position = index;
                index = out.size();
            } else {
                index += 1;
            }
        }
        out.insert(position, entry);
    }
    return out;
}

// Drops repeated keys, keeping the first occurrence, which after
// `sort_completions` is the highest scoring one.
fn dedupe_completions[V: type]
    (entries: vector(Completion(V))) -> vector(Completion(V)) {
    var out = vector(Completion(V))();
    var seen = set(string)();
    for (entry in entries) {
        if (seen.contains(entry.key)) {
            Discard(entry);
        } else {
            Discard(seen.insert(entry.key));
            out.push_back(entry);
        }
    }
    Destroy(seen);
    return out;
}

// Best `k` of an already-collected candidate run, via the same bounded
// selection the trie walk uses.
fn take_top_k[V: type]
    (entries: vector(Completion(V)), k: int) -> vector(Completion(V)) {
    var picker = TopK(V)();
    picker.configure(k);
    for (entry in entries) {
        Discard(picker.offer(entry));
    }
    var out = picker.ranked();
    Destroy(picker);
    return out;
}

// Longest common prefix of a whole run of strings, computed pairwise.
fn common_prefix_of_all(keys: vector(string)) -> string {
    var out = string();
    if (keys.size() == 0) {
        return out;
    }
    out.append(keys[0]);
    var index: int = 1;
    while (index < keys.size()) {
        let shared_len = common_prefix_length(out, keys[index]);
        var trimmed = out.substr(0, shared_len);
        out.clear();
        out.append(trimmed);
        Destroy(trimmed);
        if (out.size() == 0) {
            return out;
        }
        index += 1;
    }
    return out;
}

// Builds a trie from a plain word list, weighting every term equally.
fn trie_from_words[V: type, ALPHABET: int]
    (words: vector(string), value: V) -> Trie(V, ALPHABET) {
    var index = Trie(V, ALPHABET)();
    index.reserve(TRIE_INITIAL_CAPACITY);
    for (word in words) {
        var folded = normalize_key(ALPHABET)(word);
        Discard(index.insert(folded.first, value, WEIGHT_DEFAULT));
        Destroy(folded);
    }
    return index;
}

// Builds a trie from a document, weighting each term by how often it occurs.
// This is the one place the whole pipeline runs end to end: tokenise, count,
// insert, aggregate.
fn trie_from_text[V: type, ALPHABET: int]
    (text: string, value: V) -> Trie(V, ALPHABET) {
    var counts = map(string, int)();
    var words = tokenize(text);
    for (word in words) {
        if (not counts.contains(word)) {
            Discard(counts.insert(word, 0));
        }
        counts.at(word) += 1;
    }
    Destroy(words);

    var index = Trie(V, ALPHABET)();
    index.reserve(TRIE_INITIAL_CAPACITY);
    for (entry in counts) {
        Discard(index.insert(entry.first, value, entry.second * WEIGHT_SCALE));
    }
    Destroy(counts);
    index.rebuild_aggregates();
    return index;
}

// Copies every key of `source` into `target`, keeping the larger weight when
// a key is present in both.
fn merge_tries[V: type, ALPHABET: int]
    (ref target: Trie(V, ALPHABET),
               source: Trie(V, ALPHABET)) -> int {
    var entries = source.weighted_with_prefix(string());
    var added: int = 0;
    for (entry in entries) {
        let existing = target.weight_of(entry.first);
        if (existing >= entry.second.second) {
            Discard(entry);
        } else {
            if (target.insert(entry.first, entry.second.first,
                             entry.second.second) == TrieOutcome.Inserted) {
                added += 1;
            }
        }
    }
    Destroy(entries);
    target.rebuild_aggregates();
    return added;
}

// Keys present in both indexes, with the left index's payload.
fn intersect_tries[V: type, ALPHABET: int]
    (left: Trie(V, ALPHABET),
                   right: Trie(V, ALPHABET)) -> vector(pair(string, V)) {
    var out = vector(pair(string, V))();
    var entries = left.to_pairs();
    for (entry in entries) {
        if (right.contains(entry.first)) {
            out.push_back(entry);
        }
    }
    Destroy(entries);
    return out;
}

// True when two indexes hold exactly the same key set.
fn tries_equal[V: type, ALPHABET: int]
    (left: Trie(V, ALPHABET),
               right: Trie(V, ALPHABET)) -> bool {
    if (left.size() != right.size()) {
        return false;
    }
    var a = left.to_pairs();
    var b = right.to_pairs();
    var same: bool = true;
    var index: int = 0;
    while (index < a.size()) {
        if (compare_strings(a[index].first, b[index].first) != 0) {
            same = false;
            index = a.size();
        } else {
            index += 1;
        }
    }
    Destroy(a);
    Destroy(b);
    return same;
}

// Cross-checks the array-mapped trie against the compressed mirror: both must
// agree on every key.
fn mirrors_agree[V: type, ALPHABET: int]
    (index: Trie(V, ALPHABET),
                 mirror: RadixTree(V, ALPHABET)) -> bool {
    if (index.size() != mirror.size()) {
        return false;
    }
    var entries = index.to_pairs();
    var agreed: bool = true;
    for (entry in entries) {
        if (not mirror.contains(entry.first)) {
            agreed = false;
        }
    }
    Assert(agreed);
    Prove(index.size() == mirror.size());
    Destroy(entries);
    return agreed;
}

// Cross-checks the trie against a ternary search tree holding the same keys.
fn ternary_agrees[V: type, ALPHABET: int]
    (index: Trie(V, ALPHABET),
                  ternary: TernaryTree(V)) -> bool {
    if (index.size() != ternary.size()) {
        return false;
    }
    var entries = index.to_pairs();
    var agreed: bool = true;
    for (entry in entries) {
        if (not ternary.contains(entry.first)) {
            agreed = false;
        }
    }
    Destroy(entries);
    return agreed;
}

// One-line shape summary, mirroring `describe_shape` in the B-tree file.
fn describe_index[V: type, ALPHABET: int]
    (index: Trie(V, ALPHABET)) -> string {
    var stats = collect_statistics(V, ALPHABET)(index);
    var text = stats.describe();
    text.append(" alphabet=");
    text.append(to_string(ALPHABET));
    text.append(" balanced=");
    if (stats.balanced()) {
        text.append("yes");
    } else {
        text.append("no");
    }
    Destroy(stats);
    return text;
}

// Renders a ranked run as one line per completion.
fn render_completions[V: type]
    (entries: vector(Completion(V))) -> vector(string) {
    var out = vector(string)();
    var rank: int = 1;
    for (entry in entries) {
        var line = string();
        line.append(to_string(rank));
        line.append(". ");
        line.append(entry.describe());
        out.push_back(line);
        Destroy(line);
        rank += 1;
    }
    return out;
}

// --- Demo -----------------------------------------------------------------

// A small fixed vocabulary, built by hand so the demo does not depend on
// reading a file.  The words deliberately share long prefixes, which is what
// makes the path-compressed mirror measurably smaller than the plain trie.
fn demo_vocabulary() -> vector(string) {
    var words = vector(string)();
    words.push_back("auto");
    words.push_back("autocomplete");
    words.push_back("autocorrect");
    words.push_back("automatic");
    words.push_back("automaton");
    words.push_back("automobile");
    words.push_back("autonomy");
    words.push_back("bank");
    words.push_back("banker");
    words.push_back("banking");
    words.push_back("bankrupt");
    words.push_back("banner");
    words.push_back("banquet");
    words.push_back("prefix");
    words.push_back("prefixed");
    words.push_back("prefixes");
    words.push_back("preface");
    words.push_back("prefer");
    words.push_back("preference");
    words.push_back("present");
    words.push_back("presenter");
    words.push_back("pressure");
    words.push_back("trie");
    words.push_back("tries");
    words.push_back("trigger");
    words.push_back("trigonometry");
    words.push_back("trim");
    words.push_back("trimmed");
    words.push_back("trivial");
    words.push_back("trivia");
    return words;
}

// Weights chosen so the ranking has something to actually rank: the shorter,
// more common words are heavier.
fn demo_weights() -> map(string, int) {
    var weights = map(string, int)();
    Discard(weights.insert("auto", 9000));
    Discard(weights.insert("autocomplete", 7500));
    Discard(weights.insert("automatic", 6000));
    Discard(weights.insert("bank", 8800));
    Discard(weights.insert("banking", 5200));
    Discard(weights.insert("prefix", 7100));
    Discard(weights.insert("present", 6400));
    Discard(weights.insert("trie", 9500));
    Discard(weights.insert("trigger", 4300));
    Discard(weights.insert("trivial", 3900));
    return weights;
}

// Exercises the whole file end to end at two different alphabet widths, which
// is also the cheapest way to force both instantiations to be checked.
fn demo_trie_autocomplete() {
    var words = demo_vocabulary();
    var weights = demo_weights();

    // --- Plain trie over the 26-letter alphabet ---------------------------

    var index = Trie(int, 26)();
    index.reserve(TRIE_INITIAL_CAPACITY);
    var rank: int = 0;
    for (word in words) {
        var weight = WEIGHT_DEFAULT;
        if (weights.contains(word)) {
            weight = weights.at(word);
        }
        Discard(index.insert(word, rank, weight));
        rank += 1;
    }
    index.rebuild_aggregates();
    println(describe_index(int, 26)(index));

    if (not index.check_validity()) {
        panic("trie invariants violated after bulk insert");
    }

    // Exact and prefix lookups.
    Assert(index.contains("automaton"));
    Assert(index.contains_prefix("auto"));
    Assert(not index.contains("automat"));
    println(to_string(index.weight_of("trie")));

    // Longest common prefix of everything under "auto".
    var extended = index.extend_unambiguously("auto");
    println(extended);
    Destroy(extended);

    // Longest stored key that prefixes a longer word.
    var longest = index.longest_matching_prefix("automobiles");
    println(longest.first);
    Destroy(longest);

    // Every completion of "ban", unranked.
    var raw = index.keys_with_prefix("ban", 0);
    for (entry in raw) {
        println(entry.first);
    }
    Destroy(raw);

    // Keys grouped by initial letter, exercising the nested map return type.
    var grouped = index.group_by_initial();
    println(to_string(grouped.size()));
    for (bucket in grouped) {
        println(to_string(bucket.second.size()));
    }
    Destroy(grouped);

    // --- Deletion with pruning --------------------------------------------

    let before_nodes = index.node_count();
    Assert(index.erase("trigonometry"));
    let after_nodes = index.node_count();
    Assert(after_nodes < before_nodes);
    Prove(after_nodes <= before_nodes);
    println(to_string(before_nodes - after_nodes));

    // Prefix deletion takes a whole subtree at once.
    let dropped = index.erase_prefix("pre");
    println(to_string(dropped));
    if (not index.check_validity()) {
        panic("trie invariants violated after prefix erase");
    }

    // --- Radix mirror ------------------------------------------------------

    var compressed = RadixTree(int, 26)();
    var surviving = index.to_pairs();
    Discard(compressed.insert_all(surviving));
    Destroy(surviving);

    if (not compressed.check_validity()) {
        panic("radix invariants violated after bulk insert");
    }
    if (not mirrors_agree(int, 26)(index, compressed)) {
        panic("radix mirror disagrees with the trie");
    }
    println(to_string(index.node_count()));
    println(to_string(compressed.node_count()));

    // Splitting and merging, driven by an insertion that diverges mid-label
    // followed by the deletion that puts the label back together.
    Discard(compressed.add("bankruptcy", 900));
    Assert(compressed.contains("bankrupt"));
    Assert(compressed.contains("bankruptcy"));
    Assert(compressed.erase("bankruptcy"));
    Assert(compressed.contains("bankrupt"));
    if (not compressed.check_validity()) {
        panic("radix invariants violated after split and merge");
    }
    println(to_string(compressed.splits));
    println(to_string(compressed.merges));

    // Longest matching prefix from the compressed side.
    var matched = compressed.longest_matching_prefix("bankers");
    println(matched.first);
    Destroy(matched);

    // --- Ternary search tree ----------------------------------------------

    var ternary = TernaryTree(int)();
    var again = index.to_pairs();
    Discard(ternary.insert_all(again));
    Destroy(again);

    if (not ternary.check_validity()) {
        panic("ternary invariants violated after bulk insert");
    }
    if (not ternary_agrees(int, 26)(index, ternary)) {
        panic("ternary tree disagrees with the trie");
    }

    var ternary_hits = ternary.keys_with_prefix("tri");
    for (entry in ternary_hits) {
        println(entry.first);
    }
    Destroy(ternary_hits);

    var ternary_longest = ternary.longest_matching_prefix("triggered");
    println(ternary_longest);
    Destroy(ternary_longest);

    // Erasing enough keys forces a compaction rebuild.
    var index_of_erase: int = 0;
    while (index_of_erase < words.size()) {
        if (index_of_erase % 3 == 0) {
            Discard(ternary.erase(words[index_of_erase]));
        }
        index_of_erase += 1;
    }
    println(to_string(ternary.compact()));
    if (not ternary.check_validity()) {
        panic("ternary invariants violated after compaction");
    }

    // --- Autocomplete layer -----------------------------------------------

    var engine = Autocomplete(string, 26)();
    for (word in words) {
        var weight = WEIGHT_DEFAULT;
        if (weights.contains(word)) {
            weight = weights.at(word);
        }
        var payload = string();
        payload.append(word);
        Discard(engine.learn(word, payload, weight));
        Destroy(payload);
    }

    engine.add_alias("auto", "automatic");
    engine.add_alias("auto", "autocomplete");
    Discard(engine.record_selection("autocomplete"));
    Discard(engine.record_selection("autocomplete"));
    Discard(engine.record_selection("trie"));

    var ranked = engine.suggest("auto", DEFAULT_TOP_K);
    var lines = render_completions(string)(ranked);
    for (line in lines) {
        println(line);
    }
    Destroy(lines);
    Destroy(ranked);

    // The cached path answers the same query without walking the trie.
    var first_pass = engine.suggest_cached("ban", 4);
    var second_pass = engine.suggest_cached("ban", 4);
    Assert(first_pass.size() == second_pass.size());
    Prove(first_pass.size() == second_pass.size());
    Destroy(first_pass);
    Destroy(second_pass);
    println(engine.describe());

    // Alias expansion, one ranked run per spelling.
    var expanded = engine.suggest_with_aliases("auto", 3);
    for (entry in expanded) {
        println(entry.first);
        println(to_string(entry.second.size()));
    }
    Destroy(expanded);

    // Inline completion: the longest unambiguous extension.
    var inline_text = engine.inline_completion("banq");
    println(inline_text);
    Destroy(inline_text);

    // Greedy segmentation of a run-together string.
    var segments = engine.segment("autotrieprefix");
    for (segment in segments) {
        println(segment.first);
        println(to_string(segment.second));
    }
    Destroy(segments);

    // --- Fuzzy matching ----------------------------------------------------

    var matcher = FuzzyMatcher(string, 26)();
    matcher.configure(DEFAULT_EDIT_BUDGET);
    var fuzzy = matcher.search_top(engine.trie(), "automatik", 5);
    for (entry in fuzzy) {
        println(entry.describe());
        // The walk's own distance must agree with the reference computation.
        Assert(entry.edits == edit_distance(entry.key, "automatik"));
        Prove(entry.edits <= DEFAULT_EDIT_BUDGET);
    }
    println(to_string(matcher.nodes_visited));
    println(to_string(matcher.subtrees_pruned));
    Destroy(fuzzy);
    Destroy(matcher);

    // A misspelling with no exact hits falls through to the fuzzy path.
    var corrected = engine.suggest_or_correct("bnk", 4);
    var corrected_lines = render_completions(string)(corrected);
    for (line in corrected_lines) {
        println(line);
    }
    Destroy(corrected_lines);
    Destroy(corrected);

    // --- Serialisation ------------------------------------------------------

    var flat = serialize_trie(int, 26)(index);
    println(flat.describe());
    Assert(flat.header_valid());

    var replayed = Trie(int, 26)();
    if (not deserialize_trie(int, 26)(flat, replayed)) {
        panic("failed to replay the serialised trie");
    }
    if (not tries_equal(int, 26)(index, replayed)) {
        panic("serialisation round trip lost keys");
    }
    Assert(round_trip_ok(int, 26)(index));
    println(to_string(replayed.size()));

    // Every key recovered straight from the flat array, no tree involved.
    var recovered = flat.entries();
    println(to_string(recovered.size()));
    Destroy(recovered);
    Destroy(flat);

    // --- Statistics ---------------------------------------------------------

    var stats = collect_statistics_paired(int, 26)(index, compressed);
    println(stats.describe());
    println(to_string(stats.compression_percent()));
    println(to_string(stats.leaf_percent()));
    println(to_string(stats.max_fanout));
    for (bucket in stats.depth_histogram) {
        println(to_string(bucket.first));
        println(to_string(bucket.second));
    }
    for (bucket in stats.fanout_histogram) {
        println(to_string(bucket.second));
    }
    for (sample in stats.samples) {
        println(sample.first);
        println(to_string(sample.second));
    }
    for (group in stats.length_groups) {
        println(to_string(group.first));
        println(to_string(group.second.size()));
    }
    Destroy(stats);

    // --- A second instantiation at full ASCII width -------------------------

    // The same code at `ALPHABET_ASCII` has to cope with punctuation, which
    // the 26-letter instantiation folds away entirely.
    var wide = trie_from_words(int, 128)(words, 0);
    Discard(wide.add("read-only", 1));
    Discard(wide.add("read_write", 2));
    Discard(wide.add("read.me", 3));
    wide.rebuild_aggregates();
    println(describe_index(int, 128)(wide));
    Assert(wide.contains("read-only"));
    Assert(wide.contains_prefix("read"));

    var wide_hits = wide.keys_with_prefix("read", 0);
    println(to_string(wide_hits.size()));
    Destroy(wide_hits);

    // Merging the narrow index into the wide one keeps the heavier weights.
    println(to_string(merge_tries(int, 128)(wide, index)));
    if (not wide.check_validity()) {
        panic("wide trie invariants violated after merge");
    }

    // Intersection of the two key sets.
    var shared_keys = intersect_tries(int, 128)(wide, wide);
    println(to_string(shared_keys.size()));
    Destroy(shared_keys);

    // --- Text pipeline -------------------------------------------------------

    var document = string();
    document.append("the trie indexes the text; ");
    document.append("the text indexes the trie.\n");
    document.append("prefix queries over the trie beat scanning the text.");
    var from_text = trie_from_text(int, 26)(document, 0);
    println(describe_index(int, 26)(from_text));

    var vocabulary = from_text.to_pairs();
    var just_keys = vector(string)();
    for (entry in vocabulary) {
        just_keys.push_back(entry.first);
    }
    var shared_prefix = common_prefix_of_all(just_keys);
    println(to_string(shared_prefix.size()));
    Destroy(shared_prefix);
    Destroy(just_keys);
    Destroy(vocabulary);

    // Ageing decays every weight and evicts whatever fell through the floor.
    println(to_string(engine.age()));
    println(engine.describe());

    Destroy(from_text);
    Destroy(document);
    Destroy(wide);
    Destroy(replayed);
    Destroy(engine);
    Destroy(ternary);
    Destroy(compressed);
    Destroy(index);
    Destroy(weights);
    Destroy(words);
}


// A Unicode text library: UTF-8 encoding and decoding with full validation,
// UTF-16 and UTF-32 conversion, code point classification, case mapping,
// grapheme cluster segmentation, a canonical normalisation sketch, display
// width calculation and byte order mark handling.
//
// Every numeric constant is written in plain decimal because the charge lexer
// only accepts that notation. Where a value is conventionally written in
// hexadecimal the hexadecimal spelling follows in a comment, so the tables
// below can still be checked against the Unicode data files by eye.
//
// The library is deliberately table driven: classification, decomposition and
// width are all expressed as explicit range entries pushed into vectors at
// start up, and the hot paths are bit manipulations over those tables.
namespace unicode;

// --- Scalar bounds -------------------------------------------------------
//
// The Unicode code space is 0 .. 10FFFF with the surrogate block carved out of
// the middle of the basic multilingual plane.

let CODE_POINT_MAX: int = 1114111;          // 0x10FFFF
let CODE_POINT_COUNT: int = 1114112;        // 0x110000
let BMP_MAX: int = 65535;                   // 0xFFFF
let PLANE_SIZE: int = 65536;                // 0x10000
let PLANE_COUNT: int = 17;
let REPLACEMENT: int = 65533;               // 0xFFFD
let MAX_ASCII: int = 127;                   // 0x7F
let MAX_LATIN1: int = 255;                  // 0xFF

let SURROGATE_FIRST: int = 55296;           // 0xD800
let SURROGATE_LAST: int = 57343;            // 0xDFFF
let HIGH_SURROGATE_FIRST: int = 55296;      // 0xD800
let HIGH_SURROGATE_LAST: int = 56319;       // 0xDBFF
let LOW_SURROGATE_FIRST: int = 56320;       // 0xDC00
let LOW_SURROGATE_LAST: int = 57343;        // 0xDFFF
let SURROGATE_BLOCK_SIZE: int = 1024;       // 0x400
let SURROGATE_BASE: int = 65536;            // 0x10000

// The two-word form of a supplementary code point subtracts this bias before
// splitting the remainder into ten high bits and ten low bits.
let SURROGATE_BIAS: int = 65536;            // 0x10000
let SURROGATE_MASK: int = 1023;             // 0x3FF
let SURROGATE_SHIFT: int = 10;

// --- UTF-8 bit layout ----------------------------------------------------
//
//   0xxxxxxx                                one byte,    7 payload bits
//   110xxxxx 10xxxxxx                       two bytes,  11 payload bits
//   1110xxxx 10xxxxxx 10xxxxxx              three bytes,16 payload bits
//   11110xxx 10xxxxxx 10xxxxxx 10xxxxxx     four bytes, 21 payload bits

let UTF8_MAX_LENGTH: int = 4;
let UTF8_ONE_MAX: int = 127;                // 0x7F
let UTF8_TWO_MAX: int = 2047;               // 0x7FF
let UTF8_THREE_MAX: int = 65535;            // 0xFFFF
let UTF8_FOUR_MAX: int = 1114111;           // 0x10FFFF

let CONT_MARK: int = 128;                   // 0x80
let CONT_MASK: int = 192;                   // 0xC0
let CONT_PAYLOAD_MASK: int = 63;            // 0x3F
let CONT_BITS: int = 6;

let LEAD_TWO_MARK: int = 192;               // 0xC0
let LEAD_TWO_MASK: int = 224;               // 0xE0
let LEAD_TWO_PAYLOAD: int = 31;             // 0x1F

let LEAD_THREE_MARK: int = 224;             // 0xE0
let LEAD_THREE_MASK: int = 240;             // 0xF0
let LEAD_THREE_PAYLOAD: int = 15;           // 0x0F

let LEAD_FOUR_MARK: int = 240;              // 0xF0
let LEAD_FOUR_MASK: int = 248;              // 0xF8
let LEAD_FOUR_PAYLOAD: int = 7;             // 0x07

let ASCII_MASK: int = 128;                  // 0x80
let BYTE_MASK: int = 255;                   // 0xFF
let NIBBLE_MASK: int = 15;                  // 0x0F
let WORD_MASK: int = 65535;                 // 0xFFFF
let DWORD_MASK: int = 4294967295;           // 0xFFFFFFFF
let QWORD_MASK: int = 18446744073709551615; // 0xFFFFFFFFFFFFFFFF

// A whole machine word of bytes at a time: these constants let the fast ASCII
// scan test eight bytes with two operations.
let HIGH_BIT_EACH_BYTE: int = 9259542123273814144;   // 0x8080808080808080
let LOW_BIT_EACH_BYTE: int = 72340172838076673;      // 0x0101010101010101
let SEVEN_BITS_EACH_BYTE: int = 9187201950435737471; // 0x7F7F7F7F7F7F7F7F

// --- Byte order marks ----------------------------------------------------

let BOM_CODE_POINT: int = 65279;            // 0xFEFF
let BOM_SWAPPED: int = 65534;               // 0xFFFE, never a valid scalar
let BOM_UTF8_LENGTH: int = 3;
let BOM_UTF16_LENGTH: int = 2;
let BOM_UTF32_LENGTH: int = 4;

let BOM_UTF8_BYTE_0: int = 239;             // 0xEF
let BOM_UTF8_BYTE_1: int = 187;             // 0xBB
let BOM_UTF8_BYTE_2: int = 191;             // 0xBF

let BOM_UTF16_BE_BYTE_0: int = 254;         // 0xFE
let BOM_UTF16_BE_BYTE_1: int = 255;         // 0xFF
let BOM_UTF16_LE_BYTE_0: int = 255;         // 0xFF
let BOM_UTF16_LE_BYTE_1: int = 254;         // 0xFE

// --- Named characters ----------------------------------------------------
//
// The scanners compare raw characters constantly, so each one gets a name.
// The escaped apostrophe character literal is not spelled here; the library
// keeps it as a one character string instead.

let CHAR_NUL: char = '\0';
let CHAR_TAB: char = '\t';
let CHAR_NEWLINE: char = '\n';
let CHAR_RETURN: char = '\r';
let CHAR_SPACE: char = ' ';
let CHAR_QUOTE: char = '"';
let CHAR_BACKSLASH: char = '\\';
let CHAR_SLASH: char = '/';
let CHAR_MINUS: char = '-';
let CHAR_PLUS: char = '+';
let CHAR_DOT: char = '.';
let CHAR_COMMA: char = ',';
let CHAR_COLON: char = ':';
let CHAR_SEMICOLON: char = ';';
let CHAR_UNDERSCORE: char = '_';
let CHAR_QUESTION: char = '?';
let CHAR_BANG: char = '!';
let CHAR_STAR: char = '*';
let CHAR_PERCENT: char = '%';
let CHAR_AMPERSAND: char = '&';
let CHAR_AT: char = '@';
let CHAR_HASH: char = '#';
let CHAR_DOLLAR: char = '$';
let CHAR_CARET: char = '^';
let CHAR_TILDE: char = '~';
let CHAR_PIPE: char = '|';
let CHAR_EQUALS: char = '=';
let CHAR_LESS: char = '<';
let CHAR_GREATER: char = '>';
let CHAR_LPAREN: char = '(';
let CHAR_RPAREN: char = ')';
let CHAR_LBRACKET: char = '[';
let CHAR_RBRACKET: char = ']';
let CHAR_LBRACE: char = '{';
let CHAR_RBRACE: char = '}';
let CHAR_BACKTICK: char = '`';

let CHAR_ZERO: char = '0';
let CHAR_ONE: char = '1';
let CHAR_SEVEN: char = '7';
let CHAR_NINE: char = '9';
let CHAR_LOWER_A: char = 'a';
let CHAR_LOWER_F: char = 'f';
let CHAR_LOWER_X: char = 'x';
let CHAR_LOWER_Z: char = 'z';
let CHAR_UPPER_A: char = 'A';
let CHAR_UPPER_F: char = 'F';
let CHAR_UPPER_X: char = 'X';
let CHAR_UPPER_Z: char = 'Z';

// The single quote and a few other awkward spellings live as strings.
let APOSTROPHE: string = "'";
let TEXT_EMPTY: string = "";
let TEXT_SPACE: string = " ";
let TEXT_NEWLINE: string = "\n";
let TEXT_TAB: string = "\t";
let TEXT_ELLIPSIS: string = "...";
let TEXT_REPLACEMENT: string = "<U+FFFD>";
let TEXT_PREFIX: string = "U+";

// --- Error and status codes ----------------------------------------------

// Every way a byte sequence can fail to be UTF-8. The decoder reports the
// most specific code it can, because "invalid UTF-8" alone is useless in a
// diagnostic.
choice DecodeError {
    None,
    TruncatedSequence,          // ran out of bytes mid sequence
    UnexpectedContinuation,     // a 10xxxxxx byte where a lead was expected
    InvalidLeadByte,            // 0xC0, 0xC1, 0xF5 .. 0xFF
    MissingContinuation,        // a lead byte followed by a non continuation
    OverlongEncoding,           // a scalar spelled with more bytes than needed
    SurrogateCodePoint,         // D800 .. DFFF encoded directly, CESU-8 style
    CodePointTooLarge,          // beyond 10FFFF
    UnpairedHighSurrogate,
    UnpairedLowSurrogate,
    BufferTooSmall,
    EmptyInput,
}

// The decoder is a small deterministic automaton. Accept is the only state in
// which a code point may be handed to the caller.
choice DecodeState {
    Accept,
    Reject,
    NeedOne,
    NeedTwo,
    NeedThree,
    NeedTwoOfThreeLow,          // three byte form, lead was 0xE0
    NeedTwoOfThreeHigh,         // three byte form, lead was 0xED
    NeedThreeOfFourLow,         // four byte form, lead was 0xF0
    NeedThreeOfFourHigh,        // four byte form, lead was 0xF4
}

// What a lead byte says about the sequence that follows it.
choice ByteClass {
    Ascii,
    Continuation,
    LeadTwo,
    LeadThree,
    LeadThreeLowBound,
    LeadThreeSurrogate,
    LeadFour,
    LeadFourLowBound,
    LeadFourHighBound,
    Illegal,
}

// Result of sniffing the first few bytes of a stream.
choice Encoding {
    Unknown,
    Utf8,
    Utf8WithBom,
    Utf16Big,
    Utf16Little,
    Utf32Big,
    Utf32Little,
    Ascii,
}

// General category, collapsed to the groups this library actually needs.
choice Category {
    Unassigned,
    UppercaseLetter,
    LowercaseLetter,
    TitlecaseLetter,
    ModifierLetter,
    OtherLetter,
    NonspacingMark,
    SpacingMark,
    EnclosingMark,
    DecimalNumber,
    LetterNumber,
    OtherNumber,
    ConnectorPunctuation,
    DashPunctuation,
    OpenPunctuation,
    ClosePunctuation,
    InitialPunctuation,
    FinalPunctuation,
    OtherPunctuation,
    MathSymbol,
    CurrencySymbol,
    ModifierSymbol,
    OtherSymbol,
    SpaceSeparator,
    LineSeparator,
    ParagraphSeparator,
    Control,
    Format,
    Surrogate,
    PrivateUse,
}

// Grapheme cluster break property, the subset needed for the extended rules.
choice GraphemeBreak {
    Other,
    ControlBreak,
    CarriageReturn,
    LineFeed,
    Extend,
    ZeroWidthJoiner,
    RegionalIndicator,
    Prepend,
    SpacingMarkBreak,
    HangulL,
    HangulV,
    HangulT,
    HangulLV,
    HangulLVT,
    ExtendedPictographic,
}

// Word break property, again reduced to what the word iterator uses.
choice WordBreak {
    Any,
    CarriageReturnWord,
    LineFeedWord,
    NewlineWord,
    ExtendWord,
    ZeroWidthJoinerWord,
    RegionalWord,
    FormatWord,
    Katakana,
    HebrewLetter,
    ALetter,
    SingleQuoteWord,
    DoubleQuoteWord,
    MidNumLet,
    MidLetter,
    MidNum,
    Numeric,
    ExtendNumLet,
    WhiteSpaceWord,
}

// East Asian width, which drives the terminal column count.
choice WidthClass {
    Neutral,
    Narrow,
    HalfWidth,
    Wide,
    FullWidth,
    Ambiguous,
    ZeroWidth,
}

// Canonical combining class buckets. The real property is an integer from 0 to
// 240; only the values that appear in the small table below are named.
choice CombiningClass {
    NotReordered,
    Overlay,
    Nukta,
    KanaVoicing,
    Virama,
    AttachedBelow,
    AttachedAbove,
    AttachedAboveRight,
    BelowLeft,
    Below,
    BelowRight,
    Left,
    Right,
    AboveLeft,
    Above,
    AboveRight,
    DoubleBelow,
    DoubleAbove,
    IotaSubscript,
}

// Which normal form a transformation targets.
choice NormalForm {
    None,
    Nfd,
    Nfc,
    Nfkd,
    Nfkc,
}

// Endianness of a 16 or 32 bit code unit stream.
choice ByteOrder {
    Big,
    Little,
    Native,
}

// --- Core value types ----------------------------------------------------

// A decoded scalar together with how many bytes it consumed. A length of zero
// always means the error field is set.
class Decoded {

    fn ok(self) -> bool {
        return self.error == DecodeError.None;
    }

    fn failed(self) -> bool {
        return self.error != DecodeError.None;
    }

    fn is_ascii(self) -> bool {
        return self.value >= 0 and self.value <= MAX_ASCII;
    }

    fn is_bmp(self) -> bool {
        return self.value >= 0 and self.value <= BMP_MAX;
    }

    fn needs_surrogate_pair(self) -> bool {
        return self.value > BMP_MAX and self.value <= CODE_POINT_MAX;
    }

    var value: int = 0;
    var length: int = 0;
    var error: DecodeError = DecodeError.None;
}

// The four byte staging buffer an encoder writes into. Keeping the bytes in a
// struct rather than a vector avoids an allocation for the common case.
class Encoded {

    fn at(self, index: int) -> int {
        if (index == 0) {
            return self.byte0;
        }
        if (index == 1) {
            return self.byte1;
        }
        if (index == 2) {
            return self.byte2;
        }
        if (index == 3) {
            return self.byte3;
        }
        return 0;
    }

    fn set(ref self, index: int, value: int) {
        let masked = value & BYTE_MASK;
        if (index == 0) {
            self.byte0 = masked;
        } else {
            if (index == 1) {
                self.byte1 = masked;
            } else {
                if (index == 2) {
                    self.byte2 = masked;
                } else {
                    self.byte3 = masked;
                }
            }
        }
    }

    // Pack the sequence into one integer, most significant byte first. Handy
    // for table driven tests and for hashing short sequences.
    fn packed(self) -> int {
        var out: int = 0;
        for (i in range(0, self.length)) {
            out = (out << 8) | (self.at(i) & BYTE_MASK);
        }
        return out;
    }

    fn ok(self) -> bool {
        return self.error == DecodeError.None and self.length > 0;
    }

    var byte0: int = 0;
    var byte1: int = 0;
    var byte2: int = 0;
    var byte3: int = 0;
    var length: int = 0;
    var error: DecodeError = DecodeError.None;
}

// A byte offset paired with the line and column it lands on, so that a codec
// error can be reported the way a compiler would report it.
class Position {

    fn advance_byte(ref self, value: int) {
        self.offset += 1;
        if (value == 10) {
            self.line += 1;
            self.column = 1;
        } else {
            if ((value & CONT_MASK) != CONT_MARK) {
                self.column += 1;
            }
        }
    }

    fn advance_scalar(ref self, scalar: int, length: int) {
        self.offset += length;
        if (scalar == 10) {
            self.line += 1;
            self.column = 1;
        } else {
            self.column += 1;
        }
    }

    fn describe(self) -> string {
        var out: string = "line ";
        out.append(to_string(self.line));
        out.append(", column ");
        out.append(to_string(self.column));
        out.append(" (byte ");
        out.append(to_string(self.offset));
        out.append(")");
        return out;
    }

    var offset: int = 0;
    var line: int = 1;
    var column: int = 1;
}

// A half open range of code points carrying one property value. Every table in
// this file is a vector of one of the range structs below.
class CategoryRange {
    var first: int = 0;
    var last: int = 0;
    var category: Category = Category.Unassigned;
}

class WidthRange {
    var first: int = 0;
    var last: int = 0;
    var width: WidthClass = WidthClass.Neutral;
}

class BreakRange {
    var first: int = 0;
    var last: int = 0;
    var property: GraphemeBreak = GraphemeBreak.Other;
}

class WordRange {
    var first: int = 0;
    var last: int = 0;
    var property: WordBreak = WordBreak.Any;
}

class CombiningRange {
    var first: int = 0;
    var last: int = 0;
    var combining: int = 0;
}

// One row of the case mapping table. A delta of zero with a target of minus
// one means "no mapping"; special casing lives in a separate table because a
// single code point can expand to three.
class CaseRow {
    var first: int = 0;
    var last: int = 0;
    var step: int = 1;
    var lower_delta: int = 0;
    var upper_delta: int = 0;
    var title_delta: int = 0;
}

// A code point whose case mapping is longer than one code point.
class SpecialCaseRow {
    var source: int = 0;
    var upper0: int = 0;
    var upper1: int = 0;
    var upper2: int = 0;
    var lower0: int = 0;
    var lower1: int = 0;
    var lower2: int = 0;
    var note: string;
}

// One canonical decomposition: source expands to first plus second. A second
// of zero marks a singleton decomposition.
class DecompositionRow {
    var source: int = 0;
    var first: int = 0;
    var second: int = 0;
    var compatibility: bool = false;
    var note: string;
}

// The result of one grapheme, word or code point step over a buffer.
class Step {
    var begin: int = 0;
    var end: int = 0;
    var valid: bool = true;
}

// --- Raw byte predicates -------------------------------------------------
//
// These are the primitives every other layer is built from. They are written
// as masked comparisons rather than range tests because that is what the
// generated code should look like.

fn is_ascii_byte(b: int) => (b & ASCII_MASK) == 0;

fn is_continuation_byte(b: int) => (b & CONT_MASK) == CONT_MARK;

fn is_lead_two(b: int) => (b & LEAD_TWO_MASK) == LEAD_TWO_MARK;

fn is_lead_three(b: int) => (b & LEAD_THREE_MASK) == LEAD_THREE_MARK;

fn is_lead_four(b: int) => (b & LEAD_FOUR_MASK) == LEAD_FOUR_MARK;

// 0xC0 and 0xC1 can only ever begin an overlong two byte form, and anything
// from 0xF5 up would decode past 0x10FFFF. Both are rejected at the lead byte
// so the decoder never has to build the scalar first.
fn is_illegal_byte(b: int) -> bool {
    if (b == 192 or b == 193) {                 // 0xC0, 0xC1
        return true;
    }
    if (b >= 245 and b <= 255) {                 // 0xF5 .. 0xFF
        return true;
    }
    return b < 0 or b > BYTE_MASK;
}

fn continuation_payload(b: int) => b & CONT_PAYLOAD_MASK;

fn make_continuation(payload: int) => CONT_MARK | (payload & CONT_PAYLOAD_MASK);

// How many bytes the sequence starting with this lead byte occupies. Zero
// means the byte cannot start a sequence at all.
fn sequence_length(lead: int) -> int {
    if ((lead & ASCII_MASK) == 0) {
        return 1;
    }
    if ((lead & CONT_MASK) == CONT_MARK) {
        return 0;
    }
    if ((lead & LEAD_TWO_MASK) == LEAD_TWO_MARK) {
        return 2;
    }
    if ((lead & LEAD_THREE_MASK) == LEAD_THREE_MARK) {
        return 3;
    }
    if ((lead & LEAD_FOUR_MASK) == LEAD_FOUR_MARK) {
        return 4;
    }
    return 0;
}

// The payload bits carried by a lead byte, once its marker prefix is stripped.
fn lead_payload(lead: int, length: int) -> int {
    if (length == 1) {
        return lead & MAX_ASCII;
    }
    if (length == 2) {
        return lead & LEAD_TWO_PAYLOAD;
    }
    if (length == 3) {
        return lead & LEAD_THREE_PAYLOAD;
    }
    if (length == 4) {
        return lead & LEAD_FOUR_PAYLOAD;
    }
    return 0;
}

// Classify a lead byte into the buckets the state machine switches on. The
// four boundary classes exist because 0xE0, 0xED, 0xF0 and 0xF4 each constrain
// the range of their first continuation byte.
fn classify_byte(b: int) -> ByteClass {
    if (b >= 0 and b <= 127) {                   // 0x00 .. 0x7F
        return ByteClass.Ascii;
    }
    if (b >= 128 and b <= 191) {                 // 0x80 .. 0xBF
        return ByteClass.Continuation;
    }
    if (b >= 192 and b <= 193) {                 // 0xC0 .. 0xC1
        return ByteClass.Illegal;
    }
    if (b >= 194 and b <= 223) {                 // 0xC2 .. 0xDF
        return ByteClass.LeadTwo;
    }
    if (b == 224) {                             // 0xE0
        return ByteClass.LeadThreeLowBound;
    }
    if (b >= 225 and b <= 236) {                 // 0xE1 .. 0xEC
        return ByteClass.LeadThree;
    }
    if (b == 237) {                             // 0xED
        return ByteClass.LeadThreeSurrogate;
    }
    if (b >= 238 and b <= 239) {                 // 0xEE .. 0xEF
        return ByteClass.LeadThree;
    }
    if (b == 240) {                             // 0xF0
        return ByteClass.LeadFourLowBound;
    }
    if (b >= 241 and b <= 243) {                 // 0xF1 .. 0xF3
        return ByteClass.LeadFour;
    }
    if (b == 244) {                             // 0xF4
        return ByteClass.LeadFourHighBound;
    }
    return ByteClass.Illegal;
}

// The legal range of the first continuation byte, given the lead class. Both
// bounds are inclusive.
fn continuation_low_bound(class_: ByteClass) -> int {
    if (class_ == ByteClass.LeadThreeLowBound) {
        return 160;                            // 0xA0, blocks overlong 3 byte
    }
    if (class_ == ByteClass.LeadFourLowBound) {
        return 144;                            // 0x90, blocks overlong 4 byte
    }
    return 128;                                // 0x80
}

fn continuation_high_bound(class_: ByteClass) -> int {
    if (class_ == ByteClass.LeadThreeSurrogate) {
        return 159;                            // 0x9F, blocks D800 .. DFFF
    }
    if (class_ == ByteClass.LeadFourHighBound) {
        return 143;                            // 0x8F, blocks above 0x10FFFF
    }
    return 191;                                // 0xBF
}

// --- Encoding ------------------------------------------------------------

// How many bytes this scalar needs in UTF-8. Returns zero for values that must
// not be encoded at all: surrogates and anything past the code space.
fn encoded_length(scalar: int) -> int {
    if (scalar < 0) {
        return 0;
    }
    if (scalar <= UTF8_ONE_MAX) {
        return 1;
    }
    if (scalar <= UTF8_TWO_MAX) {
        return 2;
    }
    if (scalar >= SURROGATE_FIRST and scalar <= SURROGATE_LAST) {
        return 0;
    }
    if (scalar <= UTF8_THREE_MAX) {
        return 3;
    }
    if (scalar <= UTF8_FOUR_MAX) {
        return 4;
    }
    return 0;
}

// The same question asked of UTF-16: one code unit, or a surrogate pair.
fn utf16_length(scalar: int) -> int {
    if (scalar < 0 or scalar > CODE_POINT_MAX) {
        return 0;
    }
    if (scalar >= SURROGATE_FIRST and scalar <= SURROGATE_LAST) {
        return 0;
    }
    if (scalar <= BMP_MAX) {
        return 1;
    }
    return 2;
}

fn is_valid_scalar(scalar: int) -> bool {
    if (scalar < 0 or scalar > CODE_POINT_MAX) {
        return false;
    }
    return scalar < SURROGATE_FIRST or scalar > SURROGATE_LAST;
}

fn is_surrogate(scalar: int) => scalar >= SURROGATE_FIRST and scalar <= SURROGATE_LAST;

fn is_high_surrogate(scalar: int) => scalar >= HIGH_SURROGATE_FIRST and scalar <= HIGH_SURROGATE_LAST;

fn is_low_surrogate(scalar: int) => scalar >= LOW_SURROGATE_FIRST and scalar <= LOW_SURROGATE_LAST;

// A noncharacter is a valid scalar that no interchange format should carry.
// The block at FDD0 .. FDEF plus the last two of every plane.
fn is_noncharacter(scalar: int) -> bool {
    if (scalar >= 64976 and scalar <= 65007) {   // 0xFDD0 .. 0xFDEF
        return true;
    }
    let low = scalar & WORD_MASK;
    return low == 65534 or low == 65535;       // 0xFFFE, 0xFFFF
}

// Encode one scalar into the staging buffer. Every branch writes the marker
// bits and the payload bits separately so the layout stays readable.
fn encode(scalar: int) -> Encoded {
    var out: Encoded;
    if (scalar < 0) {
        out.error = DecodeError.CodePointTooLarge;
        return out;
    }
    if (scalar > CODE_POINT_MAX) {
        out.error = DecodeError.CodePointTooLarge;
        return out;
    }
    if (scalar >= SURROGATE_FIRST and scalar <= SURROGATE_LAST) {
        out.error = DecodeError.SurrogateCodePoint;
        return out;
    }
    if (scalar <= UTF8_ONE_MAX) {
        out.byte0 = scalar & MAX_ASCII;
        out.length = 1;
        return out;
    }
    if (scalar <= UTF8_TWO_MAX) {
        out.byte0 = LEAD_TWO_MARK | ((scalar >> 6) & LEAD_TWO_PAYLOAD);
        out.byte1 = CONT_MARK | (scalar & CONT_PAYLOAD_MASK);
        out.length = 2;
        return out;
    }
    if (scalar <= UTF8_THREE_MAX) {
        out.byte0 = LEAD_THREE_MARK | ((scalar >> 12) & LEAD_THREE_PAYLOAD);
        out.byte1 = CONT_MARK | ((scalar >> 6) & CONT_PAYLOAD_MASK);
        out.byte2 = CONT_MARK | (scalar & CONT_PAYLOAD_MASK);
        out.length = 3;
        return out;
    }
    out.byte0 = LEAD_FOUR_MARK | ((scalar >> 18) & LEAD_FOUR_PAYLOAD);
    out.byte1 = CONT_MARK | ((scalar >> 12) & CONT_PAYLOAD_MASK);
    out.byte2 = CONT_MARK | ((scalar >> 6) & CONT_PAYLOAD_MASK);
    out.byte3 = CONT_MARK | (scalar & CONT_PAYLOAD_MASK);
    out.length = 4;
    return out;
}

// Append one scalar to a byte vector, substituting the replacement character
// when the scalar is not encodable. Returns the number of bytes written.
fn encode_into(ref sink: vector(int), scalar: int) -> int {
    var packet = encode(scalar);
    if (packet.error != DecodeError.None) {
        packet = encode(REPLACEMENT);
    }
    for (i in range(0, packet.length)) {
        sink.push_back(packet.at(i));
    }
    return packet.length;
}

// Encode a whole vector of scalars. Invalid scalars become U+FFFD rather than
// aborting the whole run, which is what a text pipeline usually wants.
fn encode_all(scalars: vector(int)) -> vector(int) {
    var out: vector(int);
    out.reserve(scalars.size() * 2);
    for (scalar in scalars) {
        Discard(encode_into(out, scalar));
    }
    return out;
}

// The lossless variant: the first bad scalar stops the run and is reported.
fn encode_strict(scalars: vector(int), ref sink: vector(int)) -> Decoded {
    var report: Decoded;
    var index: int = 0;
    for (scalar in scalars) {
        let packet = encode(scalar);
        if (packet.error != DecodeError.None) {
            report.error = packet.error;
            report.value = scalar;
            report.length = index;
            return report;
        }
        for (i in range(0, packet.length)) {
            sink.push_back(packet.at(i));
        }
        index += 1;
    }
    report.length = index;
    return report;
}

// --- Decoding ------------------------------------------------------------

// The smallest scalar that a sequence of the given length is allowed to carry.
// A decoded value below this bound means the encoder padded the sequence, and
// the whole point of the overlong check is that such padding is a security
// hole rather than a harmless variation.
fn minimum_for_length(length: int) -> int {
    if (length == 1) {
        return 0;
    }
    if (length == 2) {
        return 128;                            // 0x80
    }
    if (length == 3) {
        return 2048;                           // 0x800
    }
    if (length == 4) {
        return 65536;                          // 0x10000
    }
    return CODE_POINT_MAX + 1;
}

fn maximum_for_length(length: int) -> int {
    if (length == 1) {
        return UTF8_ONE_MAX;
    }
    if (length == 2) {
        return UTF8_TWO_MAX;
    }
    if (length == 3) {
        return UTF8_THREE_MAX;
    }
    if (length == 4) {
        return UTF8_FOUR_MAX;
    }
    return -1;
}

// Decode one sequence beginning at offset. This is the reference decoder: the
// state machine further down must agree with it byte for byte.
fn decode_at(bytes: vector(int), offset: int) -> Decoded {
    var out: Decoded;
    if (offset < 0 or offset >= bytes.size()) {
        out.error = DecodeError.EmptyInput;
        return out;
    }

    let lead = bytes.at(offset) & BYTE_MASK;

    // The overwhelmingly common case, kept first and kept short.
    if ((lead & ASCII_MASK) == 0) {
        out.value = lead;
        out.length = 1;
        return out;
    }

    if ((lead & CONT_MASK) == CONT_MARK) {
        out.error = DecodeError.UnexpectedContinuation;
        out.length = 1;
        return out;
    }

    if (is_illegal_byte(lead)) {
        out.error = DecodeError.InvalidLeadByte;
        out.length = 1;
        return out;
    }

    let length = sequence_length(lead);
    if (length == 0) {
        out.error = DecodeError.InvalidLeadByte;
        out.length = 1;
        return out;
    }

    if (offset + length > bytes.size()) {
        out.error = DecodeError.TruncatedSequence;
        out.length = bytes.size() - offset;
        return out;
    }

    var scalar = lead_payload(lead, length);
    var consumed: int = 1;
    while (consumed < length) {
        let next = bytes.at(offset + consumed) & BYTE_MASK;
        if ((next & CONT_MASK) != CONT_MARK) {
            out.error = DecodeError.MissingContinuation;
            out.length = consumed;
            return out;
        }
        scalar = (scalar << CONT_BITS) | (next & CONT_PAYLOAD_MASK);
        consumed += 1;
    }

    if (scalar < minimum_for_length(length)) {
        out.error = DecodeError.OverlongEncoding;
        out.value = scalar;
        out.length = length;
        return out;
    }

    if (scalar >= SURROGATE_FIRST and scalar <= SURROGATE_LAST) {
        out.error = DecodeError.SurrogateCodePoint;
        out.value = scalar;
        out.length = length;
        return out;
    }

    if (scalar > CODE_POINT_MAX) {
        out.error = DecodeError.CodePointTooLarge;
        out.value = scalar;
        out.length = length;
        return out;
    }

    out.value = scalar;
    out.length = length;
    return out;
}

// Decode the whole buffer, replacing every ill formed subsequence with a
// single U+FFFD. The maximal subpart rule says one replacement per maximal
// prefix of a valid sequence, which is what the length field of the failed
// result gives us.
fn decode_all_lossy(bytes: vector(int)) -> vector(int) {
    var out: vector(int);
    var offset: int = 0;
    while (offset < bytes.size()) {
        let step = decode_at(bytes, offset);
        if (step.error == DecodeError.None) {
            out.push_back(step.value);
            offset += step.length;
        } else {
            out.push_back(REPLACEMENT);
            if (step.length > 0) {
                offset += step.length;
            } else {
                offset += 1;
            }
        }
    }
    return out;
}

// The strict variant stops at the first defect and reports where it was.
fn decode_all_strict(bytes: vector(int), ref sink: vector(int)) -> Decoded {
    var report: Decoded;
    var offset: int = 0;
    while (offset < bytes.size()) {
        let step = decode_at(bytes, offset);
        if (step.error != DecodeError.None) {
            report.error = step.error;
            report.value = step.value;
            report.length = offset;
            return report;
        }
        sink.push_back(step.value);
        offset += step.length;
    }
    report.length = offset;
    return report;
}

// Validate without materialising any scalars. This is the function a network
// layer calls on every inbound frame, so it avoids the vector entirely.
fn validate(bytes: vector(int)) -> Decoded {
    var report: Decoded;
    var offset: int = 0;
    let size = bytes.size();
    while (offset < size) {
        let lead = bytes.at(offset) & BYTE_MASK;
        if ((lead & ASCII_MASK) == 0) {
            offset += 1;
        } else {
            let step = decode_at(bytes, offset);
            if (step.error != DecodeError.None) {
                report.error = step.error;
                report.value = step.value;
                report.length = offset;
                return report;
            }
            offset += step.length;
        }
    }
    report.length = offset;
    return report;
}

fn is_valid_utf8(bytes: vector(int)) -> bool {
    let report = validate(bytes);
    return report.error == DecodeError.None;
}

// Count scalars without decoding them: every byte that is not a continuation
// byte starts exactly one scalar. Only correct on a validated buffer, which is
// why the assertion is here.
fn count_scalars(bytes: vector(int)) -> int {
    Assert(bytes.size() >= 0);
    var count: int = 0;
    for (b in bytes) {
        if ((b & CONT_MASK) != CONT_MARK) {
            count += 1;
        }
    }
    return count;
}

// Walk backwards to the start of the sequence containing this offset. At most
// three steps, because no sequence is longer than four bytes.
fn sequence_start(bytes: vector(int), offset: int) -> int {
    var index = offset;
    var steps: int = 0;
    while (index > 0 and steps < UTF8_MAX_LENGTH) {
        let b = bytes.at(index) & BYTE_MASK;
        if ((b & CONT_MASK) != CONT_MARK) {
            return index;
        }
        index -= 1;
        steps += 1;
    }
    return index;
}

fn is_boundary(bytes: vector(int), offset: int) -> bool {
    if (offset <= 0 or offset >= bytes.size()) {
        return true;
    }
    return (bytes.at(offset) & CONT_MASK) != CONT_MARK;
}

// --- The decoder state machine -------------------------------------------
//
// A byte at a time decoder for stream input, where a sequence may be split
// across two reads. The automaton is the classic nine state one: each step
// folds six payload bits into the accumulator and moves to the next state.
class StreamDecoder {

    fn reset(ref self) {
        self.state = DecodeState.Accept;
        self.accumulator = 0;
        self.remaining = 0;
        self.lower_bound = CONT_MARK;
        self.upper_bound = 191;                    // 0xBF
        self.consumed = 0;
        self.error = DecodeError.None;
    }

    fn idle(self) -> bool {
        return self.state == DecodeState.Accept and self.remaining == 0;
    }

    fn failed(self) -> bool {
        return self.state == DecodeState.Reject;
    }

    // Begin a new sequence. Sets the accumulator to the lead payload and the
    // continuation bounds implied by the lead class.
    fn begin(ref self, lead: int) -> bool {
        let class_ = classify_byte(lead);
        self.lower_bound = continuation_low_bound(class_);
        self.upper_bound = continuation_high_bound(class_);

        if (class_ == ByteClass.Ascii) {
            self.accumulator = lead & MAX_ASCII;
            self.remaining = 0;
            self.state = DecodeState.Accept;
            return true;
        }
        if (class_ == ByteClass.Continuation) {
            self.error = DecodeError.UnexpectedContinuation;
            self.state = DecodeState.Reject;
            return false;
        }
        if (class_ == ByteClass.Illegal) {
            self.error = DecodeError.InvalidLeadByte;
            self.state = DecodeState.Reject;
            return false;
        }
        if (class_ == ByteClass.LeadTwo) {
            self.accumulator = lead & LEAD_TWO_PAYLOAD;
            self.remaining = 1;
            self.state = DecodeState.NeedOne;
            return true;
        }
        if (class_ == ByteClass.LeadThreeLowBound) {
            self.accumulator = lead & LEAD_THREE_PAYLOAD;
            self.remaining = 2;
            self.state = DecodeState.NeedTwoOfThreeLow;
            return true;
        }
        if (class_ == ByteClass.LeadThreeSurrogate) {
            self.accumulator = lead & LEAD_THREE_PAYLOAD;
            self.remaining = 2;
            self.state = DecodeState.NeedTwoOfThreeHigh;
            return true;
        }
        if (class_ == ByteClass.LeadThree) {
            self.accumulator = lead & LEAD_THREE_PAYLOAD;
            self.remaining = 2;
            self.state = DecodeState.NeedTwo;
            return true;
        }
        if (class_ == ByteClass.LeadFourLowBound) {
            self.accumulator = lead & LEAD_FOUR_PAYLOAD;
            self.remaining = 3;
            self.state = DecodeState.NeedThreeOfFourLow;
            return true;
        }
        if (class_ == ByteClass.LeadFourHighBound) {
            self.accumulator = lead & LEAD_FOUR_PAYLOAD;
            self.remaining = 3;
            self.state = DecodeState.NeedThreeOfFourHigh;
            return true;
        }
        self.accumulator = lead & LEAD_FOUR_PAYLOAD;
        self.remaining = 3;
        self.state = DecodeState.NeedThree;
        return true;
    }

    // Feed one byte. Returns true when a complete scalar is now available in
    // the accumulator; false means either "need more" or "rejected", which the
    // caller separates by asking failed().
    fn feed(ref self, raw: int) -> bool {
        let b = raw & BYTE_MASK;
        self.consumed += 1;

        if (self.remaining == 0) {
            self.error = DecodeError.None;
            if (self.begin(b) == false) {
                return false;
            }
            return self.remaining == 0;
        }

        if (b < self.lower_bound or b > self.upper_bound) {
            // The bound violation tells us exactly which rule was broken.
            if (self.lower_bound > CONT_MARK) {
                self.error = DecodeError.OverlongEncoding;
            } else {
                if (self.upper_bound < 191) {
                    self.error = DecodeError.SurrogateCodePoint;
                } else {
                    self.error = DecodeError.MissingContinuation;
                }
            }
            if ((b & CONT_MASK) != CONT_MARK) {
                self.error = DecodeError.MissingContinuation;
            }
            self.state = DecodeState.Reject;
            self.remaining = 0;
            return false;
        }

        self.accumulator = (self.accumulator << CONT_BITS) | (b & CONT_PAYLOAD_MASK);
        self.remaining -= 1;

        // After the first continuation byte the bounds relax back to the full
        // 0x80 .. 0xBF window.
        self.lower_bound = CONT_MARK;
        self.upper_bound = 191;                    // 0xBF

        if (self.remaining == 0) {
            self.state = DecodeState.Accept;
            return true;
        }
        if (self.remaining == 1) {
            self.state = DecodeState.NeedOne;
        } else {
            self.state = DecodeState.NeedTwo;
        }
        return false;
    }

    fn value(self) -> int {
        return self.accumulator;
    }

    // Called at end of input: a sequence still in progress is a truncation.
    fn finish(ref self) -> DecodeError {
        if (self.remaining > 0) {
            self.error = DecodeError.TruncatedSequence;
            self.state = DecodeState.Reject;
            self.remaining = 0;
        }
        return self.error;
    }

    var state: DecodeState = DecodeState.Accept;
    var accumulator: int = 0;
    var remaining: int = 0;
    var lower_bound: int = 128;                    // 0x80
    var upper_bound: int = 191;                    // 0xBF
    var consumed: int = 0;
    var error: DecodeError = DecodeError.None;
}

// Drive the state machine over a whole buffer. Used by the test suite to check
// that the streaming decoder and the reference decoder never disagree.
fn decode_streaming(bytes: vector(int)) -> vector(int) {
    var out: vector(int);
    var machine: StreamDecoder;
    machine.reset();
    for (b in bytes) {
        if (machine.feed(b)) {
            out.push_back(machine.value());
        } else {
            if (machine.failed()) {
                out.push_back(REPLACEMENT);
                machine.reset();
            }
        }
    }
    if (machine.finish() != DecodeError.None) {
        out.push_back(REPLACEMENT);
    }
    return out;
}

// --- UTF-16 --------------------------------------------------------------
//
// A supplementary scalar is stored as a pair: subtract 0x10000, then take the
// top ten bits into 0xD800 .. 0xDBFF and the bottom ten into 0xDC00 .. 0xDFFF.

fn high_surrogate_of(scalar: int) -> int {
    let biased = scalar - SURROGATE_BIAS;
    return HIGH_SURROGATE_FIRST | ((biased >> SURROGATE_SHIFT) & SURROGATE_MASK);
}

fn low_surrogate_of(scalar: int) -> int {
    let biased = scalar - SURROGATE_BIAS;
    return LOW_SURROGATE_FIRST | (biased & SURROGATE_MASK);
}

fn combine_surrogates(high: int, low: int) -> int {
    let high_bits = (high - HIGH_SURROGATE_FIRST) & SURROGATE_MASK;
    let low_bits = (low - LOW_SURROGATE_FIRST) & SURROGATE_MASK;
    return SURROGATE_BIAS + (high_bits << SURROGATE_SHIFT) + low_bits;
}

// Encode one scalar into a UTF-16 code unit vector. Returns the number of code
// units appended, or zero when the scalar is not encodable.
fn utf16_encode_into(ref sink: vector(int), scalar: int) -> int {
    if (is_valid_scalar(scalar) == false) {
        sink.push_back(REPLACEMENT);
        return 1;
    }
    if (scalar <= BMP_MAX) {
        sink.push_back(scalar & WORD_MASK);
        return 1;
    }
    sink.push_back(high_surrogate_of(scalar));
    sink.push_back(low_surrogate_of(scalar));
    return 2;
}

fn utf16_encode(scalars: vector(int)) -> vector(int) {
    var out: vector(int);
    out.reserve(scalars.size() + scalars.size() / 4);
    for (scalar in scalars) {
        Discard(utf16_encode_into(out, scalar));
    }
    return out;
}

// Decode one scalar from a UTF-16 code unit sequence. Unpaired surrogates are
// reported rather than silently passed through, which is the difference
// between UTF-16 and the looser WTF-16 that filesystems use.
fn utf16_decode_at(units: vector(int), offset: int) -> Decoded {
    var out: Decoded;
    if (offset < 0 or offset >= units.size()) {
        out.error = DecodeError.EmptyInput;
        return out;
    }
    let unit = units.at(offset) & WORD_MASK;

    if (unit < SURROGATE_FIRST or unit > SURROGATE_LAST) {
        out.value = unit;
        out.length = 1;
        return out;
    }
    if (unit >= LOW_SURROGATE_FIRST) {
        out.error = DecodeError.UnpairedLowSurrogate;
        out.value = unit;
        out.length = 1;
        return out;
    }
    if (offset + 1 >= units.size()) {
        out.error = DecodeError.UnpairedHighSurrogate;
        out.value = unit;
        out.length = 1;
        return out;
    }
    let trail = units.at(offset + 1) & WORD_MASK;
    if (trail < LOW_SURROGATE_FIRST or trail > LOW_SURROGATE_LAST) {
        out.error = DecodeError.UnpairedHighSurrogate;
        out.value = unit;
        out.length = 1;
        return out;
    }
    out.value = combine_surrogates(unit, trail);
    out.length = 2;
    return out;
}

fn utf16_decode(units: vector(int)) -> vector(int) {
    var out: vector(int);
    var offset: int = 0;
    while (offset < units.size()) {
        let step = utf16_decode_at(units, offset);
        if (step.error == DecodeError.None) {
            out.push_back(step.value);
        } else {
            out.push_back(REPLACEMENT);
        }
        offset += step.length;
        if (step.length == 0) {
            offset += 1;
        }
    }
    return out;
}

// Direct UTF-8 to UTF-16 transcoding, without building the intermediate
// scalar vector. This is the path a Windows API shim takes.
fn utf8_to_utf16(bytes: vector(int)) -> vector(int) {
    var out: vector(int);
    var offset: int = 0;
    while (offset < bytes.size()) {
        let step = decode_at(bytes, offset);
        if (step.error == DecodeError.None) {
            Discard(utf16_encode_into(out, step.value));
            offset += step.length;
        } else {
            out.push_back(REPLACEMENT);
            if (step.length > 0) {
                offset += step.length;
            } else {
                offset += 1;
            }
        }
    }
    return out;
}

fn utf16_to_utf8(units: vector(int)) -> vector(int) {
    var out: vector(int);
    var offset: int = 0;
    while (offset < units.size()) {
        let step = utf16_decode_at(units, offset);
        if (step.error == DecodeError.None) {
            Discard(encode_into(out, step.value));
        } else {
            Discard(encode_into(out, REPLACEMENT));
        }
        if (step.length > 0) {
            offset += step.length;
        } else {
            offset += 1;
        }
    }
    return out;
}

// How many UTF-16 code units a UTF-8 buffer will need. Every four byte
// sequence becomes a pair, everything else becomes a single unit.
fn utf16_units_needed(bytes: vector(int)) -> int {
    var units: int = 0;
    for (b in bytes) {
        if ((b & CONT_MASK) != CONT_MARK) {
            units += 1;
        }
        if ((b & LEAD_FOUR_MASK) == LEAD_FOUR_MARK) {
            units += 1;
        }
    }
    return units;
}

// --- UTF-32 --------------------------------------------------------------

fn utf32_encode(scalars: vector(int)) -> vector(int) {
    var out: vector(int);
    for (scalar in scalars) {
        if (is_valid_scalar(scalar)) {
            out.push_back(scalar);
        } else {
            out.push_back(REPLACEMENT);
        }
    }
    return out;
}

fn utf32_decode(units: vector(int)) -> vector(int) {
    var out: vector(int);
    for (unit in units) {
        if (is_valid_scalar(unit)) {
            out.push_back(unit);
        } else {
            out.push_back(REPLACEMENT);
        }
    }
    return out;
}

fn utf32_validate(units: vector(int)) -> Decoded {
    var report: Decoded;
    var index: int = 0;
    for (unit in units) {
        if (unit < 0 or unit > CODE_POINT_MAX) {
            report.error = DecodeError.CodePointTooLarge;
            report.value = unit;
            report.length = index;
            return report;
        }
        if (unit >= SURROGATE_FIRST and unit <= SURROGATE_LAST) {
            report.error = DecodeError.SurrogateCodePoint;
            report.value = unit;
            report.length = index;
            return report;
        }
        index += 1;
    }
    report.length = index;
    return report;
}

fn utf8_to_utf32(bytes: vector(int)) -> vector(int) {
    return decode_all_lossy(bytes);
}

fn utf32_to_utf8(units: vector(int)) -> vector(int) {
    var out: vector(int);
    for (unit in units) {
        Discard(encode_into(out, unit));
    }
    return out;
}

// --- Byte order ----------------------------------------------------------

fn swap16(unit: int) -> int {
    let low = (unit & BYTE_MASK) << 8;
    let high = (unit >> 8) & BYTE_MASK;
    return (low | high) & WORD_MASK;
}

fn swap32(unit: int) -> int {
    let b0 = (unit & BYTE_MASK) << 24;
    let b1 = ((unit >> 8) & BYTE_MASK) << 16;
    let b2 = ((unit >> 16) & BYTE_MASK) << 8;
    let b3 = (unit >> 24) & BYTE_MASK;
    return (b0 | b1 | b2 | b3) & DWORD_MASK;
}

fn read16(bytes: vector(int), offset: int, order: ByteOrder) -> int {
    let first = bytes.at(offset) & BYTE_MASK;
    let second = bytes.at(offset + 1) & BYTE_MASK;
    if (order == ByteOrder.Big) {
        return (first << 8) | second;
    }
    return (second << 8) | first;
}

fn read32(bytes: vector(int), offset: int, order: ByteOrder) -> int {
    let b0 = bytes.at(offset) & BYTE_MASK;
    let b1 = bytes.at(offset + 1) & BYTE_MASK;
    let b2 = bytes.at(offset + 2) & BYTE_MASK;
    let b3 = bytes.at(offset + 3) & BYTE_MASK;
    if (order == ByteOrder.Big) {
        return (b0 << 24) | (b1 << 16) | (b2 << 8) | b3;
    }
    return (b3 << 24) | (b2 << 16) | (b1 << 8) | b0;
}

fn write16(ref sink: vector(int), unit: int, order: ByteOrder) {
    if (order == ByteOrder.Big) {
        sink.push_back((unit >> 8) & BYTE_MASK);
        sink.push_back(unit & BYTE_MASK);
    } else {
        sink.push_back(unit & BYTE_MASK);
        sink.push_back((unit >> 8) & BYTE_MASK);
    }
}

fn write32(ref sink: vector(int), unit: int, order: ByteOrder) {
    if (order == ByteOrder.Big) {
        sink.push_back((unit >> 24) & BYTE_MASK);
        sink.push_back((unit >> 16) & BYTE_MASK);
        sink.push_back((unit >> 8) & BYTE_MASK);
        sink.push_back(unit & BYTE_MASK);
    } else {
        sink.push_back(unit & BYTE_MASK);
        sink.push_back((unit >> 8) & BYTE_MASK);
        sink.push_back((unit >> 16) & BYTE_MASK);
        sink.push_back((unit >> 24) & BYTE_MASK);
    }
}

// --- Byte order marks ----------------------------------------------------

fn has_utf8_bom(bytes: vector(int)) -> bool {
    if (bytes.size() < BOM_UTF8_LENGTH) {
        return false;
    }
    if ((bytes.at(0) & BYTE_MASK) != BOM_UTF8_BYTE_0) {
        return false;
    }
    if ((bytes.at(1) & BYTE_MASK) != BOM_UTF8_BYTE_1) {
        return false;
    }
    return (bytes.at(2) & BYTE_MASK) == BOM_UTF8_BYTE_2;
}

fn has_utf16_be_bom(bytes: vector(int)) -> bool {
    if (bytes.size() < BOM_UTF16_LENGTH) {
        return false;
    }
    let first = bytes.at(0) & BYTE_MASK;
    let second = bytes.at(1) & BYTE_MASK;
    return first == BOM_UTF16_BE_BYTE_0 and second == BOM_UTF16_BE_BYTE_1;
}

fn has_utf16_le_bom(bytes: vector(int)) -> bool {
    if (bytes.size() < BOM_UTF16_LENGTH) {
        return false;
    }
    let first = bytes.at(0) & BYTE_MASK;
    let second = bytes.at(1) & BYTE_MASK;
    return first == BOM_UTF16_LE_BYTE_0 and second == BOM_UTF16_LE_BYTE_1;
}

// The 32 bit marks have to be tested before the 16 bit ones, because a UTF-32
// little endian mark begins with the same two bytes as a UTF-16 little endian
// mark and would otherwise be misread.
fn has_utf32_be_bom(bytes: vector(int)) -> bool {
    if (bytes.size() < BOM_UTF32_LENGTH) {
        return false;
    }
    if ((bytes.at(0) & BYTE_MASK) != 0) {
        return false;
    }
    if ((bytes.at(1) & BYTE_MASK) != 0) {
        return false;
    }
    if ((bytes.at(2) & BYTE_MASK) != 254) {     // 0xFE
        return false;
    }
    return (bytes.at(3) & BYTE_MASK) == 255;   // 0xFF
}

fn has_utf32_le_bom(bytes: vector(int)) -> bool {
    if (bytes.size() < BOM_UTF32_LENGTH) {
        return false;
    }
    if ((bytes.at(0) & BYTE_MASK) != 255) {     // 0xFF
        return false;
    }
    if ((bytes.at(1) & BYTE_MASK) != 254) {     // 0xFE
        return false;
    }
    if ((bytes.at(2) & BYTE_MASK) != 0) {
        return false;
    }
    return (bytes.at(3) & BYTE_MASK) == 0;
}

fn bom_length(encoding: Encoding) -> int {
    if (encoding == Encoding.Utf8WithBom) {
        return BOM_UTF8_LENGTH;
    }
    if (encoding == Encoding.Utf16Big or encoding == Encoding.Utf16Little) {
        return BOM_UTF16_LENGTH;
    }
    if (encoding == Encoding.Utf32Big or encoding == Encoding.Utf32Little) {
        return BOM_UTF32_LENGTH;
    }
    return 0;
}

// Sniff the encoding of a buffer. Marks first, then the zero byte pattern that
// a 16 or 32 bit stream of mostly ASCII text produces, then a validity test.
fn detect_encoding(bytes: vector(int)) -> Encoding {
    if (bytes.empty()) {
        return Encoding.Unknown;
    }
    if (has_utf32_be_bom(bytes)) {
        return Encoding.Utf32Big;
    }
    if (has_utf32_le_bom(bytes)) {
        return Encoding.Utf32Little;
    }
    if (has_utf8_bom(bytes)) {
        return Encoding.Utf8WithBom;
    }
    if (has_utf16_be_bom(bytes)) {
        return Encoding.Utf16Big;
    }
    if (has_utf16_le_bom(bytes)) {
        return Encoding.Utf16Little;
    }

    // No mark. Count zero bytes at even and odd positions; ASCII text encoded
    // as UTF-16 leaves a zero in every other slot and the side it lands on
    // gives the byte order away.
    var even_zeros: int = 0;
    var odd_zeros: int = 0;
    var high_bytes: int = 0;
    let limit = min(bytes.size(), 512);
    for (i in range(0, limit)) {
        let b = bytes.at(i) & BYTE_MASK;
        if (b == 0) {
            if ((i & 1) == 0) {
                even_zeros += 1;
            } else {
                odd_zeros += 1;
            }
        }
        if ((b & ASCII_MASK) != 0) {
            high_bytes += 1;
        }
    }

    if (even_zeros > limit / 4 and odd_zeros == 0) {
        return Encoding.Utf16Big;
    }
    if (odd_zeros > limit / 4 and even_zeros == 0) {
        return Encoding.Utf16Little;
    }
    if (high_bytes == 0) {
        return Encoding.Ascii;
    }
    if (is_valid_utf8(bytes)) {
        return Encoding.Utf8;
    }
    return Encoding.Unknown;
}

// Strip a leading mark, if any, and report what was stripped.
fn strip_bom(ref bytes: vector(int)) -> Encoding {
    let encoding = detect_encoding(bytes);
    let length = bom_length(encoding);
    for (i in range(0, length)) {
        bytes.erase(0);
    }
    return encoding;
}

fn prepend_utf8_bom(ref bytes: vector(int)) {
    bytes.insert(0, BOM_UTF8_BYTE_2);
    bytes.insert(0, BOM_UTF8_BYTE_1);
    bytes.insert(0, BOM_UTF8_BYTE_0);
}

fn encoding_name(encoding: Encoding) -> string {
    if (encoding == Encoding.Utf8) {
        return "UTF-8";
    }
    if (encoding == Encoding.Utf8WithBom) {
        return "UTF-8 with byte order mark";
    }
    if (encoding == Encoding.Utf16Big) {
        return "UTF-16 big endian";
    }
    if (encoding == Encoding.Utf16Little) {
        return "UTF-16 little endian";
    }
    if (encoding == Encoding.Utf32Big) {
        return "UTF-32 big endian";
    }
    if (encoding == Encoding.Utf32Little) {
        return "UTF-32 little endian";
    }
    if (encoding == Encoding.Ascii) {
        return "US-ASCII";
    }
    return "unknown";
}

// --- ASCII classification bitset -----------------------------------------
//
// The first 128 code points are classified with a bit per property rather than
// with a table lookup, because the whole set fits in one integer per
// character and the compiler can fold the tests.

let FLAG_LETTER: int = 1;                   // bit 0
let FLAG_UPPER: int = 2;                    // bit 1
let FLAG_LOWER: int = 4;                    // bit 2
let FLAG_DIGIT: int = 8;                    // bit 3
let FLAG_HEX_DIGIT: int = 16;               // bit 4
let FLAG_WHITESPACE: int = 32;              // bit 5
let FLAG_CONTROL: int = 64;                 // bit 6
let FLAG_PUNCTUATION: int = 128;            // bit 7
let FLAG_SYMBOL: int = 256;                 // bit 8
let FLAG_PRINTABLE: int = 512;              // bit 9
let FLAG_GRAPHIC: int = 1024;               // bit 10
let FLAG_BLANK: int = 2048;                 // bit 11
let FLAG_WORD: int = 4096;                  // bit 12
let FLAG_IDENTIFIER_START: int = 8192;      // bit 13
let FLAG_IDENTIFIER_PART: int = 16384;      // bit 14
let FLAG_COMBINING: int = 32768;            // bit 15
let FLAG_LINE_BREAK: int = 65536;           // bit 16
let FLAG_QUOTE: int = 131072;               // bit 17
let FLAG_BRACKET: int = 262144;             // bit 18
let FLAG_SIGN: int = 524288;                // bit 19

// Common combinations, precomputed so the predicates below stay one line.
let MASK_ALPHANUMERIC: int = 9;             // LETTER | DIGIT
let MASK_UPPER_LETTER: int = 11267;         // LETTER | UPPER | PRINTABLE | ...
let MASK_LOWER_LETTER: int = 5;             // LETTER | LOWER
let MASK_SPACE_LIKE: int = 2080;            // WHITESPACE | BLANK
let MASK_IDENTIFIER: int = 24576;           // START | PART
let MASK_TEXTUAL: int = 1545;               // LETTER | DIGIT | GRAPHIC | PRINTABLE
let MASK_ANY_PUNCT: int = 393344;           // PUNCTUATION | SYMBOL | BRACKET

// The classification of one ASCII character, as a bit union. Written out as a
// chain of range tests over character literals so that the source reads like
// the table it represents.
fn ascii_flags(c: char) -> int {
    if (c >= 'a' and c <= 'z') {
        return FLAG_LETTER | FLAG_LOWER | FLAG_PRINTABLE | FLAG_GRAPHIC | FLAG_WORD | FLAG_IDENTIFIER_START | FLAG_IDENTIFIER_PART;
    }
    if (c >= 'A' and c <= 'Z') {
        return FLAG_LETTER | FLAG_UPPER | FLAG_PRINTABLE | FLAG_GRAPHIC | FLAG_WORD | FLAG_IDENTIFIER_START | FLAG_IDENTIFIER_PART;
    }
    if (c >= '0' and c <= '9') {
        return FLAG_DIGIT | FLAG_HEX_DIGIT | FLAG_PRINTABLE | FLAG_GRAPHIC | FLAG_WORD | FLAG_IDENTIFIER_PART;
    }
    if (c == ' ') {
        return FLAG_WHITESPACE | FLAG_BLANK | FLAG_PRINTABLE;
    }
    if (c == '\t') {
        return FLAG_WHITESPACE | FLAG_BLANK | FLAG_CONTROL;
    }
    if (c == '\n') {
        return FLAG_WHITESPACE | FLAG_CONTROL | FLAG_LINE_BREAK;
    }
    if (c == '\r') {
        return FLAG_WHITESPACE | FLAG_CONTROL | FLAG_LINE_BREAK;
    }
    if (c == '\u{0C}') {
        return FLAG_WHITESPACE | FLAG_CONTROL | FLAG_LINE_BREAK;
    }
    if (c == '\u{0B}') {
        return FLAG_WHITESPACE | FLAG_CONTROL | FLAG_LINE_BREAK;
    }
    if (c == '_') {
        return FLAG_PUNCTUATION | FLAG_PRINTABLE | FLAG_GRAPHIC | FLAG_WORD | FLAG_IDENTIFIER_START | FLAG_IDENTIFIER_PART;
    }
    if (c == '"') {
        return FLAG_PUNCTUATION | FLAG_QUOTE | FLAG_PRINTABLE | FLAG_GRAPHIC;
    }
    if (c == '(' or c == ')') {
        return FLAG_PUNCTUATION | FLAG_BRACKET | FLAG_PRINTABLE | FLAG_GRAPHIC;
    }
    if (c == '[' or c == ']') {
        return FLAG_PUNCTUATION | FLAG_BRACKET | FLAG_PRINTABLE | FLAG_GRAPHIC;
    }
    if (c == '{' or c == '}') {
        return FLAG_PUNCTUATION | FLAG_BRACKET | FLAG_PRINTABLE | FLAG_GRAPHIC;
    }
    if (c == '+' or c == '-') {
        return FLAG_SYMBOL | FLAG_SIGN | FLAG_PRINTABLE | FLAG_GRAPHIC;
    }
    if (c == '<' or c == '>' or c == '=') {
        return FLAG_SYMBOL | FLAG_PRINTABLE | FLAG_GRAPHIC;
    }
    if (c == '|' or c == '~' or c == '^') {
        return FLAG_SYMBOL | FLAG_PRINTABLE | FLAG_GRAPHIC;
    }
    if (c == '$') {
        return FLAG_SYMBOL | FLAG_PRINTABLE | FLAG_GRAPHIC | FLAG_IDENTIFIER_START | FLAG_IDENTIFIER_PART;
    }
    if (c == '`') {
        return FLAG_SYMBOL | FLAG_QUOTE | FLAG_PRINTABLE | FLAG_GRAPHIC;
    }
    if (c == '!' or c == '?' or c == '.' or c == ',') {
        return FLAG_PUNCTUATION | FLAG_PRINTABLE | FLAG_GRAPHIC;
    }
    if (c == ':' or c == ';') {
        return FLAG_PUNCTUATION | FLAG_PRINTABLE | FLAG_GRAPHIC;
    }
    if (c == '*' or c == '/' or c == '%' or c == '&' or c == '#' or c == '@') {
        return FLAG_PUNCTUATION | FLAG_PRINTABLE | FLAG_GRAPHIC;
    }
    if (c == '\0') {
        return FLAG_CONTROL;
    }
    if (int(c) < 32) {
        return FLAG_CONTROL;
    }
    if (int(c) == 127) {
        return FLAG_CONTROL;
    }
    return FLAG_PRINTABLE;
}

// Hexadecimal digits pick up their own bit on top of whatever else they carry.
fn hex_flags(c: char) -> int {
    let base_ = ascii_flags(c);
    if (c >= 'a' and c <= 'f') {
        return base_ | FLAG_HEX_DIGIT;
    }
    if (c >= 'A' and c <= 'F') {
        return base_ | FLAG_HEX_DIGIT;
    }
    return base_;
}

fn has_flag(flags: int, wanted: int) => (flags & wanted) != 0;

fn has_all_flags(flags: int, wanted: int) => (flags & wanted) == wanted;

fn ascii_is_letter(c: char) => (ascii_flags(c) & FLAG_LETTER) != 0;

fn ascii_is_digit(c: char) => c >= '0' and c <= '9';

fn ascii_is_hex(c: char) => (hex_flags(c) & FLAG_HEX_DIGIT) != 0;

fn ascii_is_space(c: char) => (ascii_flags(c) & FLAG_WHITESPACE) != 0;

fn ascii_is_control(c: char) => (ascii_flags(c) & FLAG_CONTROL) != 0;

fn ascii_is_punct(c: char) => (ascii_flags(c) & MASK_ANY_PUNCT) != 0;

fn ascii_is_identifier_start(c: char) => (ascii_flags(c) & FLAG_IDENTIFIER_START) != 0;

fn ascii_is_identifier_part(c: char) => (ascii_flags(c) & FLAG_IDENTIFIER_PART) != 0;

fn ascii_digit_value(c: char) -> int {
    if (c >= '0' and c <= '9') {
        return int(c) - int('0');
    }
    return -1;
}

fn ascii_hex_value(c: char) -> int {
    if (c >= '0' and c <= '9') {
        return int(c) - int('0');
    }
    if (c >= 'a' and c <= 'f') {
        return int(c) - int('a') + 10;
    }
    if (c >= 'A' and c <= 'F') {
        return int(c) - int('A') + 10;
    }
    return -1;
}

fn hex_digit_char(value: int) -> char {
    if (value == 0) { return '0'; }
    if (value == 1) { return '1'; }
    if (value == 2) { return '2'; }
    if (value == 3) { return '3'; }
    if (value == 4) { return '4'; }
    if (value == 5) { return '5'; }
    if (value == 6) { return '6'; }
    if (value == 7) { return '7'; }
    if (value == 8) { return '8'; }
    if (value == 9) { return '9'; }
    if (value == 10) { return 'A'; }
    if (value == 11) { return 'B'; }
    if (value == 12) { return 'C'; }
    if (value == 13) { return 'D'; }
    if (value == 14) { return 'E'; }
    if (value == 15) { return 'F'; }
    return '?';
}

// Format a scalar the way the Unicode standard does: U+0041, U+1F600.
fn format_code_point(scalar: int) -> string {
    var out: string = "U+";
    var digits: int = 4;
    if (scalar > 65535) {                       // 0xFFFF
        digits = 6;
    }
    if (scalar > 16777215) {                    // 0xFFFFFF
        digits = 8;
    }
    var shift = (digits - 1) * 4;
    while (shift >= 0) {
        let nibble = (scalar >> shift) & NIBBLE_MASK;
        out.push_back(hex_digit_char(nibble));
        shift -= 4;
    }
    return out;
}

// --- General category table ----------------------------------------------
//
// A sorted, non overlapping list of half open ranges. It is deliberately a
// coarse sample of the real UnicodeData table: the blocks that a text editor
// touches most, plus enough of the supplementary planes to exercise the four
// byte decode path. Ranges are stored inclusive on both ends.
fn category_table() -> vector(CategoryRange) {
    var rows: vector(CategoryRange);

    // C0 controls and basic Latin.
    rows.push_back(CategoryRange({.first = 0, .last = 31, .category = Category.Control}));                    // 0x0000 .. 0x001F
    rows.push_back(CategoryRange({.first = 32, .last = 32, .category = Category.SpaceSeparator}));            // space
    rows.push_back(CategoryRange({.first = 33, .last = 35, .category = Category.OtherPunctuation}));          // ! " #
    rows.push_back(CategoryRange({.first = 36, .last = 36, .category = Category.CurrencySymbol}));            // $
    rows.push_back(CategoryRange({.first = 37, .last = 39, .category = Category.OtherPunctuation}));          // % & apostrophe
    rows.push_back(CategoryRange({.first = 40, .last = 40, .category = Category.OpenPunctuation}));           // (
    rows.push_back(CategoryRange({.first = 41, .last = 41, .category = Category.ClosePunctuation}));          // )
    rows.push_back(CategoryRange({.first = 42, .last = 42, .category = Category.OtherPunctuation}));          // *
    rows.push_back(CategoryRange({.first = 43, .last = 43, .category = Category.MathSymbol}));                // +
    rows.push_back(CategoryRange({.first = 44, .last = 44, .category = Category.OtherPunctuation}));          // ,
    rows.push_back(CategoryRange({.first = 45, .last = 45, .category = Category.DashPunctuation}));           // -
    rows.push_back(CategoryRange({.first = 46, .last = 47, .category = Category.OtherPunctuation}));          // . /
    rows.push_back(CategoryRange({.first = 48, .last = 57, .category = Category.DecimalNumber}));             // 0 .. 9
    rows.push_back(CategoryRange({.first = 58, .last = 59, .category = Category.OtherPunctuation}));          // : ;
    rows.push_back(CategoryRange({.first = 60, .last = 62, .category = Category.MathSymbol}));                // < = >
    rows.push_back(CategoryRange({.first = 63, .last = 64, .category = Category.OtherPunctuation}));          // ? @
    rows.push_back(CategoryRange({.first = 65, .last = 90, .category = Category.UppercaseLetter}));           // A .. Z
    rows.push_back(CategoryRange({.first = 91, .last = 91, .category = Category.OpenPunctuation}));           // [
    rows.push_back(CategoryRange({.first = 92, .last = 92, .category = Category.OtherPunctuation}));          // backslash
    rows.push_back(CategoryRange({.first = 93, .last = 93, .category = Category.ClosePunctuation}));          // ]
    rows.push_back(CategoryRange({.first = 94, .last = 94, .category = Category.ModifierSymbol}));            // ^
    rows.push_back(CategoryRange({.first = 95, .last = 95, .category = Category.ConnectorPunctuation}));      // _
    rows.push_back(CategoryRange({.first = 96, .last = 96, .category = Category.ModifierSymbol}));            // backtick
    rows.push_back(CategoryRange({.first = 97, .last = 122, .category = Category.LowercaseLetter}));          // a .. z
    rows.push_back(CategoryRange({.first = 123, .last = 123, .category = Category.OpenPunctuation}));         // {
    rows.push_back(CategoryRange({.first = 124, .last = 124, .category = Category.MathSymbol}));              // |
    rows.push_back(CategoryRange({.first = 125, .last = 125, .category = Category.ClosePunctuation}));        // }
    rows.push_back(CategoryRange({.first = 126, .last = 126, .category = Category.MathSymbol}));              // ~
    rows.push_back(CategoryRange({.first = 127, .last = 159, .category = Category.Control}));                 // DEL and C1

    // Latin-1 supplement.
    rows.push_back(CategoryRange({.first = 160, .last = 160, .category = Category.SpaceSeparator}));          // 0x00A0 no break space
    rows.push_back(CategoryRange({.first = 161, .last = 161, .category = Category.OtherPunctuation}));        // 0x00A1
    rows.push_back(CategoryRange({.first = 162, .last = 165, .category = Category.CurrencySymbol}));          // 0x00A2 .. 0x00A5
    rows.push_back(CategoryRange({.first = 166, .last = 166, .category = Category.OtherSymbol}));             // 0x00A6
    rows.push_back(CategoryRange({.first = 167, .last = 167, .category = Category.OtherPunctuation}));        // 0x00A7
    rows.push_back(CategoryRange({.first = 168, .last = 168, .category = Category.ModifierSymbol}));          // 0x00A8
    rows.push_back(CategoryRange({.first = 169, .last = 169, .category = Category.OtherSymbol}));             // 0x00A9
    rows.push_back(CategoryRange({.first = 170, .last = 170, .category = Category.OtherLetter}));             // 0x00AA
    rows.push_back(CategoryRange({.first = 171, .last = 171, .category = Category.InitialPunctuation}));      // 0x00AB
    rows.push_back(CategoryRange({.first = 172, .last = 172, .category = Category.MathSymbol}));              // 0x00AC
    rows.push_back(CategoryRange({.first = 173, .last = 173, .category = Category.Format}));                  // 0x00AD soft hyphen
    rows.push_back(CategoryRange({.first = 174, .last = 174, .category = Category.OtherSymbol}));             // 0x00AE
    rows.push_back(CategoryRange({.first = 175, .last = 175, .category = Category.ModifierSymbol}));          // 0x00AF
    rows.push_back(CategoryRange({.first = 176, .last = 176, .category = Category.OtherSymbol}));             // 0x00B0 degree
    rows.push_back(CategoryRange({.first = 177, .last = 177, .category = Category.MathSymbol}));              // 0x00B1
    rows.push_back(CategoryRange({.first = 178, .last = 179, .category = Category.OtherNumber}));             // 0x00B2 .. 0x00B3
    rows.push_back(CategoryRange({.first = 180, .last = 180, .category = Category.ModifierSymbol}));          // 0x00B4
    rows.push_back(CategoryRange({.first = 181, .last = 181, .category = Category.LowercaseLetter}));         // 0x00B5 micro
    rows.push_back(CategoryRange({.first = 182, .last = 183, .category = Category.OtherPunctuation}));        // 0x00B6 .. 0x00B7
    rows.push_back(CategoryRange({.first = 184, .last = 184, .category = Category.ModifierSymbol}));          // 0x00B8
    rows.push_back(CategoryRange({.first = 185, .last = 185, .category = Category.OtherNumber}));             // 0x00B9
    rows.push_back(CategoryRange({.first = 186, .last = 186, .category = Category.OtherLetter}));             // 0x00BA
    rows.push_back(CategoryRange({.first = 187, .last = 187, .category = Category.FinalPunctuation}));        // 0x00BB
    rows.push_back(CategoryRange({.first = 188, .last = 190, .category = Category.OtherNumber}));             // 0x00BC .. 0x00BE
    rows.push_back(CategoryRange({.first = 191, .last = 191, .category = Category.OtherPunctuation}));        // 0x00BF
    rows.push_back(CategoryRange({.first = 192, .last = 214, .category = Category.UppercaseLetter}));         // 0x00C0 .. 0x00D6
    rows.push_back(CategoryRange({.first = 215, .last = 215, .category = Category.MathSymbol}));              // 0x00D7 multiply
    rows.push_back(CategoryRange({.first = 216, .last = 222, .category = Category.UppercaseLetter}));         // 0x00D8 .. 0x00DE
    rows.push_back(CategoryRange({.first = 223, .last = 246, .category = Category.LowercaseLetter}));         // 0x00DF .. 0x00F6
    rows.push_back(CategoryRange({.first = 247, .last = 247, .category = Category.MathSymbol}));              // 0x00F7 divide
    rows.push_back(CategoryRange({.first = 248, .last = 255, .category = Category.LowercaseLetter}));         // 0x00F8 .. 0x00FF

    // Latin extended, collapsed: the alternating upper and lower runs are far
    // too long to spell out, so the whole block is marked as letters and the
    // case table below carries the finer detail.
    rows.push_back(CategoryRange({.first = 256, .last = 383, .category = Category.OtherLetter}));             // 0x0100 .. 0x017F
    rows.push_back(CategoryRange({.first = 384, .last = 591, .category = Category.OtherLetter}));             // 0x0180 .. 0x024F
    rows.push_back(CategoryRange({.first = 592, .last = 687, .category = Category.LowercaseLetter}));         // IPA extensions
    rows.push_back(CategoryRange({.first = 688, .last = 767, .category = Category.ModifierLetter}));          // spacing modifiers
    rows.push_back(CategoryRange({.first = 768, .last = 879, .category = Category.NonspacingMark}));          // combining diacriticals

    // Greek and Coptic.
    rows.push_back(CategoryRange({.first = 880, .last = 883, .category = Category.OtherLetter}));             // 0x0370 .. 0x0373
    rows.push_back(CategoryRange({.first = 884, .last = 885, .category = Category.ModifierLetter}));          // 0x0374 .. 0x0375
    rows.push_back(CategoryRange({.first = 890, .last = 890, .category = Category.ModifierLetter}));          // 0x037A
    rows.push_back(CategoryRange({.first = 891, .last = 893, .category = Category.LowercaseLetter}));         // 0x037B .. 0x037D
    rows.push_back(CategoryRange({.first = 894, .last = 894, .category = Category.OtherPunctuation}));        // 0x037E
    rows.push_back(CategoryRange({.first = 902, .last = 902, .category = Category.UppercaseLetter}));         // 0x0386
    rows.push_back(CategoryRange({.first = 903, .last = 903, .category = Category.OtherPunctuation}));        // 0x0387
    rows.push_back(CategoryRange({.first = 904, .last = 929, .category = Category.UppercaseLetter}));         // 0x0388 .. 0x03A1
    rows.push_back(CategoryRange({.first = 931, .last = 939, .category = Category.UppercaseLetter}));         // 0x03A3 .. 0x03AB
    rows.push_back(CategoryRange({.first = 940, .last = 974, .category = Category.LowercaseLetter}));         // 0x03AC .. 0x03CE
    rows.push_back(CategoryRange({.first = 975, .last = 1023, .category = Category.OtherLetter}));            // 0x03CF .. 0x03FF

    // Cyrillic.
    rows.push_back(CategoryRange({.first = 1024, .last = 1071, .category = Category.UppercaseLetter}));       // 0x0400 .. 0x042F
    rows.push_back(CategoryRange({.first = 1072, .last = 1119, .category = Category.LowercaseLetter}));       // 0x0430 .. 0x045F
    rows.push_back(CategoryRange({.first = 1120, .last = 1279, .category = Category.OtherLetter}));           // 0x0460 .. 0x04FF
    rows.push_back(CategoryRange({.first = 1280, .last = 1327, .category = Category.OtherLetter}));           // 0x0500 .. 0x052F

    // Hebrew and Arabic.
    rows.push_back(CategoryRange({.first = 1425, .last = 1469, .category = Category.NonspacingMark}));        // 0x0591 .. 0x05BD
    rows.push_back(CategoryRange({.first = 1471, .last = 1471, .category = Category.NonspacingMark}));        // 0x05BF
    rows.push_back(CategoryRange({.first = 1473, .last = 1474, .category = Category.NonspacingMark}));        // 0x05C1 .. 0x05C2
    rows.push_back(CategoryRange({.first = 1488, .last = 1514, .category = Category.OtherLetter}));           // 0x05D0 .. 0x05EA
    rows.push_back(CategoryRange({.first = 1536, .last = 1541, .category = Category.Format}));                // 0x0600 .. 0x0605
    rows.push_back(CategoryRange({.first = 1542, .last = 1544, .category = Category.MathSymbol}));            // 0x0606 .. 0x0608
    rows.push_back(CategoryRange({.first = 1548, .last = 1549, .category = Category.OtherPunctuation}));      // 0x060C .. 0x060D
    rows.push_back(CategoryRange({.first = 1552, .last = 1562, .category = Category.NonspacingMark}));        // 0x0610 .. 0x061A
    rows.push_back(CategoryRange({.first = 1569, .last = 1610, .category = Category.OtherLetter}));           // 0x0621 .. 0x064A
    rows.push_back(CategoryRange({.first = 1611, .last = 1631, .category = Category.NonspacingMark}));        // 0x064B .. 0x065F
    rows.push_back(CategoryRange({.first = 1632, .last = 1641, .category = Category.DecimalNumber}));         // 0x0660 .. 0x0669
    rows.push_back(CategoryRange({.first = 1642, .last = 1645, .category = Category.OtherPunctuation}));      // 0x066A .. 0x066D

    // Devanagari, enough of it to exercise the spacing mark rules.
    rows.push_back(CategoryRange({.first = 2304, .last = 2306, .category = Category.NonspacingMark}));        // 0x0900 .. 0x0902
    rows.push_back(CategoryRange({.first = 2307, .last = 2307, .category = Category.SpacingMark}));           // 0x0903
    rows.push_back(CategoryRange({.first = 2308, .last = 2361, .category = Category.OtherLetter}));           // 0x0904 .. 0x0939
    rows.push_back(CategoryRange({.first = 2362, .last = 2362, .category = Category.NonspacingMark}));        // 0x093A
    rows.push_back(CategoryRange({.first = 2363, .last = 2363, .category = Category.SpacingMark}));           // 0x093B
    rows.push_back(CategoryRange({.first = 2364, .last = 2364, .category = Category.NonspacingMark}));        // 0x093C nukta
    rows.push_back(CategoryRange({.first = 2366, .last = 2368, .category = Category.SpacingMark}));           // 0x093E .. 0x0940
    rows.push_back(CategoryRange({.first = 2369, .last = 2376, .category = Category.NonspacingMark}));        // 0x0941 .. 0x0948
    rows.push_back(CategoryRange({.first = 2377, .last = 2380, .category = Category.SpacingMark}));           // 0x0949 .. 0x094C
    rows.push_back(CategoryRange({.first = 2381, .last = 2381, .category = Category.NonspacingMark}));        // 0x094D virama
    rows.push_back(CategoryRange({.first = 2406, .last = 2415, .category = Category.DecimalNumber}));         // 0x0966 .. 0x096F

    // Thai, which is the classic zero width mark test case.
    rows.push_back(CategoryRange({.first = 3585, .last = 3632, .category = Category.OtherLetter}));           // 0x0E01 .. 0x0E30
    rows.push_back(CategoryRange({.first = 3633, .last = 3633, .category = Category.NonspacingMark}));        // 0x0E31
    rows.push_back(CategoryRange({.first = 3634, .last = 3635, .category = Category.OtherLetter}));           // 0x0E32 .. 0x0E33
    rows.push_back(CategoryRange({.first = 3636, .last = 3642, .category = Category.NonspacingMark}));        // 0x0E34 .. 0x0E3A
    rows.push_back(CategoryRange({.first = 3648, .last = 3653, .category = Category.OtherLetter}));           // 0x0E40 .. 0x0E45
    rows.push_back(CategoryRange({.first = 3654, .last = 3654, .category = Category.ModifierLetter}));        // 0x0E46
    rows.push_back(CategoryRange({.first = 3655, .last = 3662, .category = Category.NonspacingMark}));        // 0x0E47 .. 0x0E4E
    rows.push_back(CategoryRange({.first = 3664, .last = 3673, .category = Category.DecimalNumber}));         // 0x0E50 .. 0x0E59

    // Hangul jamo, split by the L, V and T groups the composition rules need.
    rows.push_back(CategoryRange({.first = 4352, .last = 4447, .category = Category.OtherLetter}));           // 0x1100 .. 0x115F leading
    rows.push_back(CategoryRange({.first = 4448, .last = 4519, .category = Category.OtherLetter}));           // 0x1160 .. 0x11A7 vowel
    rows.push_back(CategoryRange({.first = 4520, .last = 4607, .category = Category.OtherLetter}));           // 0x11A8 .. 0x11FF trailing

    // General punctuation and the invisible formatting characters.
    rows.push_back(CategoryRange({.first = 8192, .last = 8202, .category = Category.SpaceSeparator}));        // 0x2000 .. 0x200A
    rows.push_back(CategoryRange({.first = 8203, .last = 8207, .category = Category.Format}));                // 0x200B .. 0x200F
    rows.push_back(CategoryRange({.first = 8208, .last = 8213, .category = Category.DashPunctuation}));       // 0x2010 .. 0x2015
    rows.push_back(CategoryRange({.first = 8214, .last = 8215, .category = Category.OtherPunctuation}));      // 0x2016 .. 0x2017
    rows.push_back(CategoryRange({.first = 8216, .last = 8216, .category = Category.InitialPunctuation}));    // 0x2018
    rows.push_back(CategoryRange({.first = 8217, .last = 8217, .category = Category.FinalPunctuation}));      // 0x2019
    rows.push_back(CategoryRange({.first = 8220, .last = 8220, .category = Category.InitialPunctuation}));    // 0x201C
    rows.push_back(CategoryRange({.first = 8221, .last = 8221, .category = Category.FinalPunctuation}));      // 0x201D
    rows.push_back(CategoryRange({.first = 8224, .last = 8231, .category = Category.OtherPunctuation}));      // 0x2020 .. 0x2027
    rows.push_back(CategoryRange({.first = 8232, .last = 8232, .category = Category.LineSeparator}));         // 0x2028
    rows.push_back(CategoryRange({.first = 8233, .last = 8233, .category = Category.ParagraphSeparator}));    // 0x2029
    rows.push_back(CategoryRange({.first = 8234, .last = 8238, .category = Category.Format}));                // 0x202A .. 0x202E
    rows.push_back(CategoryRange({.first = 8239, .last = 8239, .category = Category.SpaceSeparator}));        // 0x202F
    rows.push_back(CategoryRange({.first = 8240, .last = 8248, .category = Category.OtherPunctuation}));      // 0x2030 .. 0x2038
    rows.push_back(CategoryRange({.first = 8287, .last = 8287, .category = Category.SpaceSeparator}));        // 0x205F
    rows.push_back(CategoryRange({.first = 8288, .last = 8303, .category = Category.Format}));                // 0x2060 .. 0x206F
    rows.push_back(CategoryRange({.first = 8352, .last = 8399, .category = Category.CurrencySymbol}));        // 0x20A0 .. 0x20CF
    rows.push_back(CategoryRange({.first = 8400, .last = 8432, .category = Category.NonspacingMark}));        // 0x20D0 .. 0x20F0

    // Letterlike symbols, arrows and mathematical operators.
    rows.push_back(CategoryRange({.first = 8448, .last = 8527, .category = Category.OtherSymbol}));           // 0x2100 .. 0x214F
    rows.push_back(CategoryRange({.first = 8528, .last = 8585, .category = Category.OtherNumber}));           // 0x2150 .. 0x2189
    rows.push_back(CategoryRange({.first = 8592, .last = 8703, .category = Category.MathSymbol}));            // 0x2190 .. 0x21FF
    rows.push_back(CategoryRange({.first = 8704, .last = 8959, .category = Category.MathSymbol}));            // 0x2200 .. 0x22FF
    rows.push_back(CategoryRange({.first = 9312, .last = 9371, .category = Category.OtherNumber}));           // 0x2460 .. 0x249B
    rows.push_back(CategoryRange({.first = 9472, .last = 9599, .category = Category.OtherSymbol}));           // 0x2500 .. 0x257F box drawing
    rows.push_back(CategoryRange({.first = 9600, .last = 9631, .category = Category.OtherSymbol}));           // 0x2580 .. 0x259F blocks
    rows.push_back(CategoryRange({.first = 9632, .last = 9727, .category = Category.OtherSymbol}));           // 0x25A0 .. 0x25FF shapes
    rows.push_back(CategoryRange({.first = 9728, .last = 9983, .category = Category.OtherSymbol}));           // 0x2600 .. 0x26FF misc
    rows.push_back(CategoryRange({.first = 9984, .last = 10175, .category = Category.OtherSymbol}));          // 0x2700 .. 0x27BF dingbats

    // CJK.
    rows.push_back(CategoryRange({.first = 11904, .last = 12031, .category = Category.OtherSymbol}));         // 0x2E80 .. 0x2EFF radicals
    rows.push_back(CategoryRange({.first = 12288, .last = 12288, .category = Category.SpaceSeparator}));      // 0x3000 ideographic space
    rows.push_back(CategoryRange({.first = 12289, .last = 12291, .category = Category.OtherPunctuation}));    // 0x3001 .. 0x3003
    rows.push_back(CategoryRange({.first = 12296, .last = 12296, .category = Category.OpenPunctuation}));     // 0x3008
    rows.push_back(CategoryRange({.first = 12297, .last = 12297, .category = Category.ClosePunctuation}));    // 0x3009
    rows.push_back(CategoryRange({.first = 12352, .last = 12447, .category = Category.OtherLetter}));         // 0x3040 .. 0x309F hiragana
    rows.push_back(CategoryRange({.first = 12448, .last = 12543, .category = Category.OtherLetter}));         // 0x30A0 .. 0x30FF katakana
    rows.push_back(CategoryRange({.first = 13312, .last = 19903, .category = Category.OtherLetter}));         // 0x3400 .. 0x4DBF ext A
    rows.push_back(CategoryRange({.first = 19968, .last = 40959, .category = Category.OtherLetter}));         // 0x4E00 .. 0x9FFF unified
    rows.push_back(CategoryRange({.first = 44032, .last = 55203, .category = Category.OtherLetter}));         // 0xAC00 .. 0xD7A3 hangul

    // Surrogates and private use, present so that a lookup never falls through
    // to Unassigned for a code point that is merely unusable.
    rows.push_back(CategoryRange({.first = 55296, .last = 57343, .category = Category.Surrogate}));           // 0xD800 .. 0xDFFF
    rows.push_back(CategoryRange({.first = 57344, .last = 63743, .category = Category.PrivateUse}));          // 0xE000 .. 0xF8FF

    // Compatibility forms and the specials block.
    rows.push_back(CategoryRange({.first = 64256, .last = 64262, .category = Category.LowercaseLetter}));     // 0xFB00 .. 0xFB06 ligatures
    rows.push_back(CategoryRange({.first = 65024, .last = 65039, .category = Category.NonspacingMark}));      // 0xFE00 .. 0xFE0F variation
    rows.push_back(CategoryRange({.first = 65056, .last = 65071, .category = Category.NonspacingMark}));      // 0xFE20 .. 0xFE2F half marks
    rows.push_back(CategoryRange({.first = 65279, .last = 65279, .category = Category.Format}));              // 0xFEFF byte order mark
    rows.push_back(CategoryRange({.first = 65281, .last = 65374, .category = Category.OtherPunctuation}));    // 0xFF01 .. 0xFF5E full width
    rows.push_back(CategoryRange({.first = 65529, .last = 65531, .category = Category.Format}));              // 0xFFF9 .. 0xFFFB

    // Supplementary planes: the four byte decode path.
    rows.push_back(CategoryRange({.first = 65536, .last = 65663, .category = Category.OtherLetter}));         // 0x10000 linear B
    rows.push_back(CategoryRange({.first = 66560, .last = 66599, .category = Category.UppercaseLetter}));     // 0x10400 deseret upper
    rows.push_back(CategoryRange({.first = 66600, .last = 66639, .category = Category.LowercaseLetter}));     // 0x10428 deseret lower
    rows.push_back(CategoryRange({.first = 119808, .last = 119892, .category = Category.UppercaseLetter}));   // 0x1D400 math bold
    rows.push_back(CategoryRange({.first = 127462, .last = 127487, .category = Category.OtherSymbol}));       // 0x1F1E6 regional
    rows.push_back(CategoryRange({.first = 127744, .last = 128511, .category = Category.OtherSymbol}));       // 0x1F300 .. 0x1F5FF
    rows.push_back(CategoryRange({.first = 128512, .last = 128591, .category = Category.OtherSymbol}));       // 0x1F600 .. 0x1F64F
    rows.push_back(CategoryRange({.first = 129280, .last = 129535, .category = Category.OtherSymbol}));       // 0x1F980 .. 0x1FA7F
    rows.push_back(CategoryRange({.first = 131072, .last = 173791, .category = Category.OtherLetter}));       // 0x20000 ext B
    rows.push_back(CategoryRange({.first = 983040, .last = 1048573, .category = Category.PrivateUse}));       // 0xF0000 plane 15
    rows.push_back(CategoryRange({.first = 1048576, .last = 1114109, .category = Category.PrivateUse}));      // 0x100000 plane 16

    return rows;
}

// Binary search over a sorted range table. The tables are built once and never
// mutated, so the invariant the search relies on is easy to state.
fn find_category(rows: vector(CategoryRange), scalar: int) -> Category {
    var low: int = 0;
    var high = rows.size() - 1;
    while (low <= high) {
        let middle = low + ((high - low) >> 1);
        let ref row: auto = rows.at(middle);
        if (scalar < row.first) {
            high = middle - 1;
        } else {
            if (scalar > row.last) {
                low = middle + 1;
            } else {
                return row.category;
            }
        }
    }
    return Category.Unassigned;
}

// --- Category predicates -------------------------------------------------

fn is_letter_category(category: Category) -> bool {
    if (category == Category.UppercaseLetter) {
        return true;
    }
    if (category == Category.LowercaseLetter) {
        return true;
    }
    if (category == Category.TitlecaseLetter) {
        return true;
    }
    if (category == Category.ModifierLetter) {
        return true;
    }
    return category == Category.OtherLetter;
}

fn is_mark_category(category: Category) -> bool {
    if (category == Category.NonspacingMark) {
        return true;
    }
    if (category == Category.SpacingMark) {
        return true;
    }
    return category == Category.EnclosingMark;
}

fn is_number_category(category: Category) -> bool {
    if (category == Category.DecimalNumber) {
        return true;
    }
    if (category == Category.LetterNumber) {
        return true;
    }
    return category == Category.OtherNumber;
}

fn is_punctuation_category(category: Category) -> bool {
    if (category == Category.ConnectorPunctuation) {
        return true;
    }
    if (category == Category.DashPunctuation) {
        return true;
    }
    if (category == Category.OpenPunctuation) {
        return true;
    }
    if (category == Category.ClosePunctuation) {
        return true;
    }
    if (category == Category.InitialPunctuation) {
        return true;
    }
    if (category == Category.FinalPunctuation) {
        return true;
    }
    return category == Category.OtherPunctuation;
}

fn is_symbol_category(category: Category) -> bool {
    if (category == Category.MathSymbol) {
        return true;
    }
    if (category == Category.CurrencySymbol) {
        return true;
    }
    if (category == Category.ModifierSymbol) {
        return true;
    }
    return category == Category.OtherSymbol;
}

fn is_separator_category(category: Category) -> bool {
    if (category == Category.SpaceSeparator) {
        return true;
    }
    if (category == Category.LineSeparator) {
        return true;
    }
    return category == Category.ParagraphSeparator;
}

fn category_name(category: Category) -> string {
    if (category == Category.UppercaseLetter) { return "Lu"; }
    if (category == Category.LowercaseLetter) { return "Ll"; }
    if (category == Category.TitlecaseLetter) { return "Lt"; }
    if (category == Category.ModifierLetter) { return "Lm"; }
    if (category == Category.OtherLetter) { return "Lo"; }
    if (category == Category.NonspacingMark) { return "Mn"; }
    if (category == Category.SpacingMark) { return "Mc"; }
    if (category == Category.EnclosingMark) { return "Me"; }
    if (category == Category.DecimalNumber) { return "Nd"; }
    if (category == Category.LetterNumber) { return "Nl"; }
    if (category == Category.OtherNumber) { return "No"; }
    if (category == Category.ConnectorPunctuation) { return "Pc"; }
    if (category == Category.DashPunctuation) { return "Pd"; }
    if (category == Category.OpenPunctuation) { return "Ps"; }
    if (category == Category.ClosePunctuation) { return "Pe"; }
    if (category == Category.InitialPunctuation) { return "Pi"; }
    if (category == Category.FinalPunctuation) { return "Pf"; }
    if (category == Category.OtherPunctuation) { return "Po"; }
    if (category == Category.MathSymbol) { return "Sm"; }
    if (category == Category.CurrencySymbol) { return "Sc"; }
    if (category == Category.ModifierSymbol) { return "Sk"; }
    if (category == Category.OtherSymbol) { return "So"; }
    if (category == Category.SpaceSeparator) { return "Zs"; }
    if (category == Category.LineSeparator) { return "Zl"; }
    if (category == Category.ParagraphSeparator) { return "Zp"; }
    if (category == Category.Control) { return "Cc"; }
    if (category == Category.Format) { return "Cf"; }
    if (category == Category.Surrogate) { return "Cs"; }
    if (category == Category.PrivateUse) { return "Co"; }
    return "Cn";
}

// --- Whitespace and combining tables -------------------------------------

// Every code point with White_Space=Yes. Short enough to spell out in full.
fn whitespace_table() -> vector(CategoryRange) {
    var rows: vector(CategoryRange);
    rows.push_back(CategoryRange({.first = 9, .last = 13, .category = Category.Control}));                    // tab .. carriage return
    rows.push_back(CategoryRange({.first = 32, .last = 32, .category = Category.SpaceSeparator}));            // space
    rows.push_back(CategoryRange({.first = 133, .last = 133, .category = Category.Control}));                 // 0x0085 next line
    rows.push_back(CategoryRange({.first = 160, .last = 160, .category = Category.SpaceSeparator}));          // 0x00A0
    rows.push_back(CategoryRange({.first = 5760, .last = 5760, .category = Category.SpaceSeparator}));        // 0x1680 ogham
    rows.push_back(CategoryRange({.first = 8192, .last = 8202, .category = Category.SpaceSeparator}));        // 0x2000 .. 0x200A
    rows.push_back(CategoryRange({.first = 8232, .last = 8232, .category = Category.LineSeparator}));         // 0x2028
    rows.push_back(CategoryRange({.first = 8233, .last = 8233, .category = Category.ParagraphSeparator}));    // 0x2029
    rows.push_back(CategoryRange({.first = 8239, .last = 8239, .category = Category.SpaceSeparator}));        // 0x202F narrow
    rows.push_back(CategoryRange({.first = 8287, .last = 8287, .category = Category.SpaceSeparator}));        // 0x205F medium math
    rows.push_back(CategoryRange({.first = 12288, .last = 12288, .category = Category.SpaceSeparator}));      // 0x3000 ideographic
    return rows;
}

// Canonical combining classes for the marks this library composes. The value
// is the raw property number, not the enumeration, because the reordering
// algorithm compares magnitudes.
fn combining_table() -> vector(CombiningRange) {
    var rows: vector(CombiningRange);
    rows.push_back(CombiningRange({.first = 768, .last = 788, .combining = 230}));      // 0x0300 .. 0x0314 above
    rows.push_back(CombiningRange({.first = 789, .last = 789, .combining = 232}));      // 0x0315 above right
    rows.push_back(CombiningRange({.first = 790, .last = 793, .combining = 220}));      // 0x0316 .. 0x0319 below
    rows.push_back(CombiningRange({.first = 794, .last = 795, .combining = 232}));      // 0x031A .. 0x031B
    rows.push_back(CombiningRange({.first = 796, .last = 803, .combining = 220}));      // 0x031C .. 0x0323
    rows.push_back(CombiningRange({.first = 804, .last = 806, .combining = 220}));      // 0x0324 .. 0x0326
    rows.push_back(CombiningRange({.first = 807, .last = 808, .combining = 202}));      // 0x0327 .. 0x0328 attached below
    rows.push_back(CombiningRange({.first = 809, .last = 819, .combining = 220}));      // 0x0329 .. 0x0333
    rows.push_back(CombiningRange({.first = 820, .last = 824, .combining = 1}));        // 0x0334 .. 0x0338 overlay
    rows.push_back(CombiningRange({.first = 825, .last = 828, .combining = 220}));      // 0x0339 .. 0x033C
    rows.push_back(CombiningRange({.first = 829, .last = 836, .combining = 230}));      // 0x033D .. 0x0344
    rows.push_back(CombiningRange({.first = 837, .last = 837, .combining = 240}));      // 0x0345 iota subscript
    rows.push_back(CombiningRange({.first = 838, .last = 841, .combining = 230}));      // 0x0346 .. 0x0349
    rows.push_back(CombiningRange({.first = 842, .last = 844, .combining = 230}));      // 0x034A .. 0x034C
    rows.push_back(CombiningRange({.first = 845, .last = 846, .combining = 220}));      // 0x034D .. 0x034E
    rows.push_back(CombiningRange({.first = 848, .last = 855, .combining = 230}));      // 0x0350 .. 0x0357
    rows.push_back(CombiningRange({.first = 856, .last = 859, .combining = 230}));      // 0x0358 .. 0x035B
    rows.push_back(CombiningRange({.first = 860, .last = 860, .combining = 233}));      // 0x035C double below
    rows.push_back(CombiningRange({.first = 861, .last = 862, .combining = 234}));      // 0x035D .. 0x035E double above
    rows.push_back(CombiningRange({.first = 863, .last = 863, .combining = 233}));      // 0x035F
    rows.push_back(CombiningRange({.first = 864, .last = 865, .combining = 234}));      // 0x0360 .. 0x0361
    rows.push_back(CombiningRange({.first = 866, .last = 866, .combining = 233}));      // 0x0362
    rows.push_back(CombiningRange({.first = 867, .last = 879, .combining = 230}));      // 0x0363 .. 0x036F
    rows.push_back(CombiningRange({.first = 1425, .last = 1425, .combining = 220}));    // 0x0591 hebrew
    rows.push_back(CombiningRange({.first = 1426, .last = 1426, .combining = 230}));    // 0x0592
    rows.push_back(CombiningRange({.first = 1443, .last = 1444, .combining = 220}));    // 0x05A3 .. 0x05A4
    rows.push_back(CombiningRange({.first = 1456, .last = 1465, .combining = 10}));     // 0x05B0 .. 0x05B9 points
    rows.push_back(CombiningRange({.first = 1471, .last = 1471, .combining = 23}));     // 0x05BF
    rows.push_back(CombiningRange({.first = 1473, .last = 1474, .combining = 24}));     // 0x05C1 .. 0x05C2
    rows.push_back(CombiningRange({.first = 1611, .last = 1621, .combining = 230}));    // 0x064B .. 0x0655 arabic
    rows.push_back(CombiningRange({.first = 1648, .last = 1648, .combining = 230}));    // 0x0670
    rows.push_back(CombiningRange({.first = 2364, .last = 2364, .combining = 7}));      // 0x093C nukta
    rows.push_back(CombiningRange({.first = 2381, .last = 2381, .combining = 9}));      // 0x094D virama
    rows.push_back(CombiningRange({.first = 3633, .last = 3633, .combining = 0}));      // 0x0E31 thai
    rows.push_back(CombiningRange({.first = 3636, .last = 3642, .combining = 0}));      // 0x0E34 .. 0x0E3A
    rows.push_back(CombiningRange({.first = 12330, .last = 12331, .combining = 218}));  // 0x302A .. 0x302B
    rows.push_back(CombiningRange({.first = 12332, .last = 12333, .combining = 228}));  // 0x302C .. 0x302D
    rows.push_back(CombiningRange({.first = 12441, .last = 12442, .combining = 8}));    // 0x3099 .. 0x309A kana voicing
    return rows;
}

fn find_combining(rows: vector(CombiningRange), scalar: int) -> int {
    var low: int = 0;
    var high = rows.size() - 1;
    while (low <= high) {
        let middle = low + ((high - low) >> 1);
        let ref row: auto = rows.at(middle);
        if (scalar < row.first) {
            high = middle - 1;
        } else {
            if (scalar > row.last) {
                low = middle + 1;
            } else {
                return row.combining;
            }
        }
    }
    return 0;
}

// --- The shared property database ----------------------------------------
//
// One instance holds every table. Building the tables costs a few hundred
// vector pushes, so the caller is expected to build it once and pass a
// reference around.
class Properties {

    fn build(ref self) {
        self.categories = category_table();
        self.whitespace = whitespace_table();
        self.combining = combining_table();
        self.widths = width_table();
        self.breaks = grapheme_break_table();
        self.words = word_break_table();
        self.cases = case_table();
        self.specials = special_case_table();
        self.decompositions = decomposition_table();
        self.ready = true;
    }

    fn category_of(self, scalar: int) -> Category {
        if (scalar >= 0 and scalar <= MAX_ASCII) {
            return ascii_category(scalar);
        }
        return find_category(self.categories, scalar);
    }

    fn combining_of(self, scalar: int) -> int {
        if (scalar <= MAX_ASCII) {
            return 0;
        }
        return find_combining(self.combining, scalar);
    }

    fn is_letter(self, scalar: int) -> bool {
        return is_letter_category(self.category_of(scalar));
    }

    fn is_digit(self, scalar: int) -> bool {
        return self.category_of(scalar) == Category.DecimalNumber;
    }

    fn is_number(self, scalar: int) -> bool {
        return is_number_category(self.category_of(scalar));
    }

    fn is_mark(self, scalar: int) -> bool {
        return is_mark_category(self.category_of(scalar));
    }

    fn is_punctuation(self, scalar: int) -> bool {
        return is_punctuation_category(self.category_of(scalar));
    }

    fn is_symbol(self, scalar: int) -> bool {
        return is_symbol_category(self.category_of(scalar));
    }

    fn is_control(self, scalar: int) -> bool {
        if (scalar < 32) {
            return true;
        }
        if (scalar >= 127 and scalar <= 159) {   // 0x7F .. 0x9F
            return true;
        }
        return self.category_of(scalar) == Category.Control;
    }

    fn is_format(self, scalar: int) -> bool {
        return self.category_of(scalar) == Category.Format;
    }

    fn is_whitespace(self, scalar: int) -> bool {
        if (scalar >= 9 and scalar <= 13) {
            return true;
        }
        if (scalar == 32) {
            return true;
        }
        return find_category(self.whitespace, scalar) != Category.Unassigned;
    }

    fn is_combining(self, scalar: int) -> bool {
        return self.combining_of(scalar) != 0 or self.is_mark(scalar);
    }

    fn is_printable(self, scalar: int) -> bool {
        if (self.is_control(scalar)) {
            return false;
        }
        if (self.is_format(scalar)) {
            return false;
        }
        let category = self.category_of(scalar);
        if (category == Category.Surrogate) {
            return false;
        }
        return category != Category.Unassigned;
    }

    // A code point that may begin an identifier under the default rules: a
    // letter, a letter number, or the connector underscore.
    fn is_identifier_start(self, scalar: int) -> bool {
        if (scalar == 95) {                     // underscore
            return true;
        }
        let category = self.category_of(scalar);
        if (category == Category.LetterNumber) {
            return true;
        }
        return is_letter_category(category);
    }

    fn is_identifier_part(self, scalar: int) -> bool {
        if (self.is_identifier_start(scalar)) {
            return true;
        }
        let category = self.category_of(scalar);
        if (category == Category.NonspacingMark) {
            return true;
        }
        if (category == Category.SpacingMark) {
            return true;
        }
        if (category == Category.DecimalNumber) {
            return true;
        }
        if (category == Category.ConnectorPunctuation) {
            return true;
        }
        return category == Category.Format;
    }

    var categories: vector(CategoryRange);
    var whitespace: vector(CategoryRange);
    var combining: vector(CombiningRange);
    var widths: vector(WidthRange);
    var breaks: vector(BreakRange);
    var words: vector(WordRange);
    var cases: vector(CaseRow);
    var specials: vector(SpecialCaseRow);
    var decompositions: vector(DecompositionRow);
    var ready: bool = false;
}

// ASCII is answered without touching the range table at all.
fn ascii_category(scalar: int) -> Category {
    let c = char(scalar);
    if (c >= 'A' and c <= 'Z') {
        return Category.UppercaseLetter;
    }
    if (c >= 'a' and c <= 'z') {
        return Category.LowercaseLetter;
    }
    if (c >= '0' and c <= '9') {
        return Category.DecimalNumber;
    }
    if (c == ' ') {
        return Category.SpaceSeparator;
    }
    if (scalar < 32 or scalar == 127) {
        return Category.Control;
    }
    if (c == '$') {
        return Category.CurrencySymbol;
    }
    if (c == '+' or c == '<' or c == '=' or c == '>' or c == '|' or c == '~') {
        return Category.MathSymbol;
    }
    if (c == '^' or c == '`') {
        return Category.ModifierSymbol;
    }
    if (c == '-') {
        return Category.DashPunctuation;
    }
    if (c == '_') {
        return Category.ConnectorPunctuation;
    }
    if (c == '(' or c == '[' or c == '{') {
        return Category.OpenPunctuation;
    }
    if (c == ')' or c == ']' or c == '}') {
        return Category.ClosePunctuation;
    }
    return Category.OtherPunctuation;
}

// --- Case mapping --------------------------------------------------------
//
// Most case mappings are a constant delta over a run of code points, and many
// of those runs alternate upper and lower on consecutive code points. A row
// therefore carries a step: step one covers a solid run, step two covers the
// alternating Latin Extended-A pattern where each uppercase letter is
// immediately followed by its lowercase partner.
fn case_table() -> vector(CaseRow) {
    var rows: vector(CaseRow);

    // Basic Latin.
    rows.push_back(CaseRow({.first = 65, .last = 90, .step = 1, .lower_delta = 32, .upper_delta = 0, .title_delta = 0}));       // A .. Z
    rows.push_back(CaseRow({.first = 97, .last = 122, .step = 1, .lower_delta = 0, .upper_delta = -32, .title_delta = -32}));   // a .. z

    // Latin-1 supplement. The multiply and divide signs sit inside the runs
    // and are excluded by splitting each run in two.
    rows.push_back(CaseRow({.first = 192, .last = 214, .step = 1, .lower_delta = 32, .upper_delta = 0, .title_delta = 0}));     // 0x00C0 .. 0x00D6
    rows.push_back(CaseRow({.first = 216, .last = 222, .step = 1, .lower_delta = 32, .upper_delta = 0, .title_delta = 0}));     // 0x00D8 .. 0x00DE
    rows.push_back(CaseRow({.first = 224, .last = 246, .step = 1, .lower_delta = 0, .upper_delta = -32, .title_delta = -32}));  // 0x00E0 .. 0x00F6
    rows.push_back(CaseRow({.first = 248, .last = 254, .step = 1, .lower_delta = 0, .upper_delta = -32, .title_delta = -32}));  // 0x00F8 .. 0x00FE
    rows.push_back(CaseRow({.first = 255, .last = 255, .step = 1, .lower_delta = 0, .upper_delta = -121, .title_delta = -121}));// 0x00FF y diaeresis

    // Latin Extended-A: alternating pairs, so a step of two with the uppercase
    // rows starting on the even code points.
    rows.push_back(CaseRow({.first = 256, .last = 302, .step = 2, .lower_delta = 1, .upper_delta = 0, .title_delta = 0}));      // 0x0100 .. 0x012E
    rows.push_back(CaseRow({.first = 257, .last = 303, .step = 2, .lower_delta = 0, .upper_delta = -1, .title_delta = -1}));    // 0x0101 .. 0x012F
    rows.push_back(CaseRow({.first = 306, .last = 310, .step = 2, .lower_delta = 1, .upper_delta = 0, .title_delta = 0}));      // 0x0132 .. 0x0136
    rows.push_back(CaseRow({.first = 307, .last = 311, .step = 2, .lower_delta = 0, .upper_delta = -1, .title_delta = -1}));    // 0x0133 .. 0x0137
    rows.push_back(CaseRow({.first = 313, .last = 327, .step = 2, .lower_delta = 1, .upper_delta = 0, .title_delta = 0}));      // 0x0139 .. 0x0147
    rows.push_back(CaseRow({.first = 314, .last = 328, .step = 2, .lower_delta = 0, .upper_delta = -1, .title_delta = -1}));    // 0x013A .. 0x0148
    rows.push_back(CaseRow({.first = 330, .last = 374, .step = 2, .lower_delta = 1, .upper_delta = 0, .title_delta = 0}));      // 0x014A .. 0x0176
    rows.push_back(CaseRow({.first = 331, .last = 375, .step = 2, .lower_delta = 0, .upper_delta = -1, .title_delta = -1}));    // 0x014B .. 0x0177
    rows.push_back(CaseRow({.first = 376, .last = 376, .step = 1, .lower_delta = -121, .upper_delta = 0, .title_delta = 0}));   // 0x0178
    rows.push_back(CaseRow({.first = 377, .last = 381, .step = 2, .lower_delta = 1, .upper_delta = 0, .title_delta = 0}));      // 0x0179 .. 0x017D
    rows.push_back(CaseRow({.first = 378, .last = 382, .step = 2, .lower_delta = 0, .upper_delta = -1, .title_delta = -1}));    // 0x017A .. 0x017E
    rows.push_back(CaseRow({.first = 383, .last = 383, .step = 1, .lower_delta = 0, .upper_delta = -268, .title_delta = -268}));// 0x017F long s

    // A handful of Latin Extended-B rows with the title case column actually
    // different from the upper case column.
    rows.push_back(CaseRow({.first = 452, .last = 452, .step = 1, .lower_delta = 2, .upper_delta = 0, .title_delta = 1}));      // 0x01C4 DZ
    rows.push_back(CaseRow({.first = 453, .last = 453, .step = 1, .lower_delta = 1, .upper_delta = -1, .title_delta = 0}));     // 0x01C5 Dz
    rows.push_back(CaseRow({.first = 454, .last = 454, .step = 1, .lower_delta = 0, .upper_delta = -2, .title_delta = -1}));    // 0x01C6 dz
    rows.push_back(CaseRow({.first = 455, .last = 455, .step = 1, .lower_delta = 2, .upper_delta = 0, .title_delta = 1}));      // 0x01C7 LJ
    rows.push_back(CaseRow({.first = 456, .last = 456, .step = 1, .lower_delta = 1, .upper_delta = -1, .title_delta = 0}));     // 0x01C8 Lj
    rows.push_back(CaseRow({.first = 457, .last = 457, .step = 1, .lower_delta = 0, .upper_delta = -2, .title_delta = -1}));    // 0x01C9 lj
    rows.push_back(CaseRow({.first = 458, .last = 458, .step = 1, .lower_delta = 2, .upper_delta = 0, .title_delta = 1}));      // 0x01CA NJ
    rows.push_back(CaseRow({.first = 459, .last = 459, .step = 1, .lower_delta = 1, .upper_delta = -1, .title_delta = 0}));     // 0x01CB Nj
    rows.push_back(CaseRow({.first = 460, .last = 460, .step = 1, .lower_delta = 0, .upper_delta = -2, .title_delta = -1}));    // 0x01CC nj

    // Greek.
    rows.push_back(CaseRow({.first = 902, .last = 902, .step = 1, .lower_delta = 38, .upper_delta = 0, .title_delta = 0}));     // 0x0386
    rows.push_back(CaseRow({.first = 904, .last = 906, .step = 1, .lower_delta = 37, .upper_delta = 0, .title_delta = 0}));     // 0x0388 .. 0x038A
    rows.push_back(CaseRow({.first = 908, .last = 908, .step = 1, .lower_delta = 64, .upper_delta = 0, .title_delta = 0}));     // 0x038C
    rows.push_back(CaseRow({.first = 910, .last = 911, .step = 1, .lower_delta = 63, .upper_delta = 0, .title_delta = 0}));     // 0x038E .. 0x038F
    rows.push_back(CaseRow({.first = 913, .last = 929, .step = 1, .lower_delta = 32, .upper_delta = 0, .title_delta = 0}));     // 0x0391 .. 0x03A1
    rows.push_back(CaseRow({.first = 931, .last = 939, .step = 1, .lower_delta = 32, .upper_delta = 0, .title_delta = 0}));     // 0x03A3 .. 0x03AB
    rows.push_back(CaseRow({.first = 945, .last = 961, .step = 1, .lower_delta = 0, .upper_delta = -32, .title_delta = -32}));  // 0x03B1 .. 0x03C1
    rows.push_back(CaseRow({.first = 962, .last = 962, .step = 1, .lower_delta = 0, .upper_delta = -31, .title_delta = -31}));  // 0x03C2 final sigma
    rows.push_back(CaseRow({.first = 963, .last = 971, .step = 1, .lower_delta = 0, .upper_delta = -32, .title_delta = -32}));  // 0x03C3 .. 0x03CB

    // Cyrillic: one solid run of 32 plus the shifted archaic block.
    rows.push_back(CaseRow({.first = 1024, .last = 1039, .step = 1, .lower_delta = 80, .upper_delta = 0, .title_delta = 0}));   // 0x0400 .. 0x040F
    rows.push_back(CaseRow({.first = 1040, .last = 1071, .step = 1, .lower_delta = 32, .upper_delta = 0, .title_delta = 0}));   // 0x0410 .. 0x042F
    rows.push_back(CaseRow({.first = 1072, .last = 1103, .step = 1, .lower_delta = 0, .upper_delta = -32, .title_delta = -32}));// 0x0430 .. 0x044F
    rows.push_back(CaseRow({.first = 1104, .last = 1119, .step = 1, .lower_delta = 0, .upper_delta = -80, .title_delta = -80}));// 0x0450 .. 0x045F
    rows.push_back(CaseRow({.first = 1120, .last = 1152, .step = 2, .lower_delta = 1, .upper_delta = 0, .title_delta = 0}));    // 0x0460 .. 0x0480
    rows.push_back(CaseRow({.first = 1121, .last = 1153, .step = 2, .lower_delta = 0, .upper_delta = -1, .title_delta = -1}));  // 0x0461 .. 0x0481

    // Armenian and Georgian.
    rows.push_back(CaseRow({.first = 1329, .last = 1366, .step = 1, .lower_delta = 48, .upper_delta = 0, .title_delta = 0}));   // 0x0531 .. 0x0556
    rows.push_back(CaseRow({.first = 1377, .last = 1414, .step = 1, .lower_delta = 0, .upper_delta = -48, .title_delta = -48}));// 0x0561 .. 0x0586
    rows.push_back(CaseRow({.first = 4256, .last = 4293, .step = 1, .lower_delta = 7264, .upper_delta = 0, .title_delta = 0})); // 0x10A0 .. 0x10C5

    // Halfwidth and fullwidth Latin.
    rows.push_back(CaseRow({.first = 65313, .last = 65338, .step = 1, .lower_delta = 32, .upper_delta = 0, .title_delta = 0})); // 0xFF21 .. 0xFF3A
    rows.push_back(CaseRow({.first = 65345, .last = 65370, .step = 1, .lower_delta = 0, .upper_delta = -32, .title_delta = -32})); // 0xFF41 .. 0xFF5A

    // Supplementary plane: Deseret, which is the standard test that a case
    // mapper does not silently truncate to sixteen bits.
    rows.push_back(CaseRow({.first = 66560, .last = 66599, .step = 1, .lower_delta = 40, .upper_delta = 0, .title_delta = 0})); // 0x10400 .. 0x10427
    rows.push_back(CaseRow({.first = 66600, .last = 66639, .step = 1, .lower_delta = 0, .upper_delta = -40, .title_delta = -40})); // 0x10428 .. 0x1044F

    return rows;
}

// Mappings that are not one to one. The German sharp s uppercases to two
// letters, the ligatures expand, and the Greek iota subscript forms grow a
// letter when they are uppercased.
fn special_case_table() -> vector(SpecialCaseRow) {
    var rows: vector(SpecialCaseRow);
    rows.push_back(SpecialCaseRow({.source = 223, .upper0 = 83, .upper1 = 83, .upper2 = 0, .lower0 = 223, .lower1 = 0, .lower2 = 0, .note = "sharp s becomes SS"}));            // 0x00DF
    rows.push_back(SpecialCaseRow({.source = 305, .upper0 = 73, .upper1 = 0, .upper2 = 0, .lower0 = 305, .lower1 = 0, .lower2 = 0, .note = "dotless i uppercases to I"}));      // 0x0131
    rows.push_back(SpecialCaseRow({.source = 329, .upper0 = 700, .upper1 = 78, .upper2 = 0, .lower0 = 329, .lower1 = 0, .lower2 = 0, .note = "n preceded by apostrophe"}));     // 0x0149
    rows.push_back(SpecialCaseRow({.source = 496, .upper0 = 74, .upper1 = 780, .upper2 = 0, .lower0 = 496, .lower1 = 0, .lower2 = 0, .note = "j with caron"}));                 // 0x01F0
    rows.push_back(SpecialCaseRow({.source = 912, .upper0 = 921, .upper1 = 776, .upper2 = 769, .lower0 = 912, .lower1 = 0, .lower2 = 0, .note = "iota with dialytika tonos"})); // 0x0390
    rows.push_back(SpecialCaseRow({.source = 944, .upper0 = 933, .upper1 = 776, .upper2 = 769, .lower0 = 944, .lower1 = 0, .lower2 = 0, .note = "upsilon dialytika tonos"}));   // 0x03B0
    rows.push_back(SpecialCaseRow({.source = 64256, .upper0 = 70, .upper1 = 70, .upper2 = 0, .lower0 = 64256, .lower1 = 0, .lower2 = 0, .note = "ligature ff"}));               // 0xFB00
    rows.push_back(SpecialCaseRow({.source = 64257, .upper0 = 70, .upper1 = 73, .upper2 = 0, .lower0 = 64257, .lower1 = 0, .lower2 = 0, .note = "ligature fi"}));               // 0xFB01
    rows.push_back(SpecialCaseRow({.source = 64258, .upper0 = 70, .upper1 = 76, .upper2 = 0, .lower0 = 64258, .lower1 = 0, .lower2 = 0, .note = "ligature fl"}));               // 0xFB02
    rows.push_back(SpecialCaseRow({.source = 64259, .upper0 = 70, .upper1 = 70, .upper2 = 73, .lower0 = 64259, .lower1 = 0, .lower2 = 0, .note = "ligature ffi"}));             // 0xFB03
    rows.push_back(SpecialCaseRow({.source = 64260, .upper0 = 70, .upper1 = 70, .upper2 = 76, .lower0 = 64260, .lower1 = 0, .lower2 = 0, .note = "ligature ffl"}));             // 0xFB04
    rows.push_back(SpecialCaseRow({.source = 64261, .upper0 = 83, .upper1 = 84, .upper2 = 0, .lower0 = 64261, .lower1 = 0, .lower2 = 0, .note = "ligature long s t"}));         // 0xFB05
    rows.push_back(SpecialCaseRow({.source = 64262, .upper0 = 83, .upper1 = 84, .upper2 = 0, .lower0 = 64262, .lower1 = 0, .lower2 = 0, .note = "ligature st"}));               // 0xFB06
    return rows;
}

fn find_case_row(rows: vector(CaseRow), scalar: int) -> int {
    var index: int = 0;
    for (row in rows) {
        if (scalar >= row.first and scalar <= row.last) {
            if (row.step == 1) {
                return index;
            }
            // A stepped row only covers every other code point, so the offset
            // from the start of the row has to be a multiple of the step.
            if (((scalar - row.first) % row.step) == 0) {
                return index;
            }
        }
        index += 1;
    }
    return -1;
}

fn find_special_case(rows: vector(SpecialCaseRow), scalar: int) -> int {
    var index: int = 0;
    for (row in rows) {
        if (row.source == scalar) {
            return index;
        }
        index += 1;
    }
    return -1;
}

fn to_lower_scalar(props: Properties, scalar: int) -> int {
    if (scalar >= int('A') and scalar <= int('Z')) {
        return scalar + 32;
    }
    if (scalar <= MAX_ASCII) {
        return scalar;
    }
    let index = find_case_row(props.cases, scalar);
    if (index < 0) {
        return scalar;
    }
    let ref row: auto = props.cases.at(index);
    return scalar + row.lower_delta;
}

fn to_upper_scalar(props: Properties, scalar: int) -> int {
    if (scalar >= int('a') and scalar <= int('z')) {
        return scalar - 32;
    }
    if (scalar <= MAX_ASCII) {
        return scalar;
    }
    let index = find_case_row(props.cases, scalar);
    if (index < 0) {
        return scalar;
    }
    let ref row: auto = props.cases.at(index);
    return scalar + row.upper_delta;
}

fn to_title_scalar(props: Properties, scalar: int) -> int {
    if (scalar >= int('a') and scalar <= int('z')) {
        return scalar - 32;
    }
    if (scalar <= MAX_ASCII) {
        return scalar;
    }
    let index = find_case_row(props.cases, scalar);
    if (index < 0) {
        return scalar;
    }
    let ref row: auto = props.cases.at(index);
    return scalar + row.title_delta;
}

// Case folding for caseless comparison. Simple folding only: it maps to lower
// case with the handful of exceptions that would otherwise compare unequal.
fn fold_scalar(props: Properties, scalar: int) -> int {
    if (scalar == 304) {                        // 0x0130 capital I with dot
        return int('i');
    }
    if (scalar == 305) {                        // 0x0131 dotless i
        return int('i');
    }
    if (scalar == 383) {                        // 0x017F long s
        return int('s');
    }
    if (scalar == 962) {                        // 0x03C2 final sigma
        return 963;                            // 0x03C3
    }
    if (scalar == 976) {                        // 0x03D0 beta symbol
        return 946;                            // 0x03B2
    }
    if (scalar == 977) {                        // 0x03D1 theta symbol
        return 952;                            // 0x03B8
    }
    if (scalar == 981) {                        // 0x03D5 phi symbol
        return 966;                            // 0x03C6
    }
    if (scalar == 982) {                        // 0x03D6 pi symbol
        return 960;                            // 0x03C0
    }
    if (scalar == 8486) {                       // 0x2126 ohm sign
        return 969;                            // 0x03C9
    }
    if (scalar == 8490) {                       // 0x212A kelvin sign
        return int('k');
    }
    if (scalar == 8491) {                       // 0x212B angstrom sign
        return 229;                            // 0x00E5
    }
    return to_lower_scalar(props, scalar);
}

// Uppercase one scalar, expanding it when the special case table says so.
// Returns how many scalars were appended.
fn upper_expand(props: Properties, scalar: int, ref sink: vector(int)) -> int {
    let index = find_special_case(props.specials, scalar);
    if (index < 0) {
        sink.push_back(to_upper_scalar(props, scalar));
        return 1;
    }
    let ref row: auto = props.specials.at(index);
    sink.push_back(row.upper0);
    if (row.upper1 == 0) {
        return 1;
    }
    sink.push_back(row.upper1);
    if (row.upper2 == 0) {
        return 2;
    }
    sink.push_back(row.upper2);
    return 3;
}

fn lower_expand(props: Properties, scalar: int, ref sink: vector(int)) -> int {
    let index = find_special_case(props.specials, scalar);
    if (index < 0) {
        sink.push_back(to_lower_scalar(props, scalar));
        return 1;
    }
    let ref row: auto = props.specials.at(index);
    sink.push_back(row.lower0);
    if (row.lower1 == 0) {
        return 1;
    }
    sink.push_back(row.lower1);
    if (row.lower2 == 0) {
        return 2;
    }
    sink.push_back(row.lower2);
    return 3;
}

fn to_upper(props: Properties, scalars: vector(int)) -> vector(int) {
    var out: vector(int);
    out.reserve(scalars.size());
    for (scalar in scalars) {
        Discard(upper_expand(props, scalar, out));
    }
    return out;
}

fn to_lower(props: Properties, scalars: vector(int)) -> vector(int) {
    var out: vector(int);
    out.reserve(scalars.size());
    for (scalar in scalars) {
        Discard(lower_expand(props, scalar, out));
    }
    return out;
}

// Title case a run: the first cased scalar of every word is titled and the
// rest are lowered. Word boundaries here are the simple ones, which is all a
// display routine needs.
fn to_title(props: Properties, scalars: vector(int)) -> vector(int) {
    var out: vector(int);
    var at_word_start: bool = true;
    for (scalar in scalars) {
        if (props.is_letter(scalar)) {
            if (at_word_start) {
                out.push_back(to_title_scalar(props, scalar));
            } else {
                out.push_back(to_lower_scalar(props, scalar));
            }
            at_word_start = false;
        } else {
            out.push_back(scalar);
            if (props.is_whitespace(scalar) or props.is_punctuation(scalar)) {
                at_word_start = true;
            }
        }
    }
    return out;
}

fn case_fold(props: Properties, scalars: vector(int)) -> vector(int) {
    var out: vector(int);
    for (scalar in scalars) {
        out.push_back(fold_scalar(props, scalar));
    }
    return out;
}

// Compare two scalar runs ignoring case. Returns a negative number, zero or a
// positive number in the usual way.
fn compare_folded(props: Properties, left: vector(int), right: vector(int)) -> int {
    let limit = min(left.size(), right.size());
    for (i in range(0, limit)) {
        let a = fold_scalar(props, left.at(i));
        let b = fold_scalar(props, right.at(i));
        if (a < b) {
            return -1;
        }
        if (a > b) {
            return 1;
        }
    }
    if (left.size() < right.size()) {
        return -1;
    }
    if (left.size() > right.size()) {
        return 1;
    }
    return 0;
}

// --- Grapheme cluster segmentation ---------------------------------------
//
// Hangul syllables are composed algorithmically rather than by table: the
// block at 0xAC00 holds L * 21 * 28 + V * 28 + T for every combination, so the
// LV and LVT distinction falls out of one modulo.

let HANGUL_SYLLABLE_FIRST: int = 44032;     // 0xAC00
let HANGUL_SYLLABLE_LAST: int = 55203;      // 0xD7A3
let HANGUL_SYLLABLE_COUNT: int = 11172;
let HANGUL_L_FIRST: int = 4352;             // 0x1100
let HANGUL_L_COUNT: int = 19;
let HANGUL_V_FIRST: int = 4449;             // 0x1161
let HANGUL_V_COUNT: int = 21;
let HANGUL_T_FIRST: int = 4519;             // 0x11A7
let HANGUL_T_COUNT: int = 28;
let HANGUL_NV_COUNT: int = 588;             // V_COUNT * T_COUNT

let ZERO_WIDTH_JOINER: int = 8205;          // 0x200D
let ZERO_WIDTH_NON_JOINER: int = 8204;      // 0x200C
let COMBINING_ENCLOSING_KEYCAP: int = 8419; // 0x20E3
let REGIONAL_INDICATOR_FIRST: int = 127462; // 0x1F1E6
let REGIONAL_INDICATOR_LAST: int = 127487;  // 0x1F1FF
let VARIATION_SELECTOR_FIRST: int = 65024;  // 0xFE00
let VARIATION_SELECTOR_LAST: int = 65039;   // 0xFE0F

fn is_hangul_syllable(scalar: int) => scalar >= HANGUL_SYLLABLE_FIRST and scalar <= HANGUL_SYLLABLE_LAST;

fn hangul_is_lv(scalar: int) -> bool {
    if (is_hangul_syllable(scalar) == false) {
        return false;
    }
    return ((scalar - HANGUL_SYLLABLE_FIRST) % HANGUL_T_COUNT) == 0;
}

fn hangul_is_lvt(scalar: int) -> bool {
    if (is_hangul_syllable(scalar) == false) {
        return false;
    }
    return ((scalar - HANGUL_SYLLABLE_FIRST) % HANGUL_T_COUNT) != 0;
}

// Grapheme cluster break property table. Everything not listed is Other.
fn grapheme_break_table() -> vector(BreakRange) {
    var rows: vector(BreakRange);
    rows.push_back(BreakRange({.first = 0, .last = 9, .property = GraphemeBreak.ControlBreak}));                 // 0x00 .. 0x09
    rows.push_back(BreakRange({.first = 10, .last = 10, .property = GraphemeBreak.LineFeed}));                   // line feed
    rows.push_back(BreakRange({.first = 11, .last = 12, .property = GraphemeBreak.ControlBreak}));               // 0x0B .. 0x0C
    rows.push_back(BreakRange({.first = 13, .last = 13, .property = GraphemeBreak.CarriageReturn}));             // carriage return
    rows.push_back(BreakRange({.first = 14, .last = 31, .property = GraphemeBreak.ControlBreak}));               // 0x0E .. 0x1F
    rows.push_back(BreakRange({.first = 127, .last = 159, .property = GraphemeBreak.ControlBreak}));             // 0x7F .. 0x9F
    rows.push_back(BreakRange({.first = 173, .last = 173, .property = GraphemeBreak.ControlBreak}));             // 0x00AD soft hyphen
    rows.push_back(BreakRange({.first = 768, .last = 879, .property = GraphemeBreak.Extend}));                   // 0x0300 .. 0x036F
    rows.push_back(BreakRange({.first = 1155, .last = 1161, .property = GraphemeBreak.Extend}));                 // 0x0483 .. 0x0489
    rows.push_back(BreakRange({.first = 1425, .last = 1469, .property = GraphemeBreak.Extend}));                 // 0x0591 .. 0x05BD
    rows.push_back(BreakRange({.first = 1471, .last = 1471, .property = GraphemeBreak.Extend}));                 // 0x05BF
    rows.push_back(BreakRange({.first = 1473, .last = 1474, .property = GraphemeBreak.Extend}));                 // 0x05C1 .. 0x05C2
    rows.push_back(BreakRange({.first = 1552, .last = 1562, .property = GraphemeBreak.Extend}));                 // 0x0610 .. 0x061A
    rows.push_back(BreakRange({.first = 1611, .last = 1631, .property = GraphemeBreak.Extend}));                 // 0x064B .. 0x065F
    rows.push_back(BreakRange({.first = 1648, .last = 1648, .property = GraphemeBreak.Extend}));                 // 0x0670
    rows.push_back(BreakRange({.first = 2304, .last = 2306, .property = GraphemeBreak.Extend}));                 // 0x0900 .. 0x0902
    rows.push_back(BreakRange({.first = 2307, .last = 2307, .property = GraphemeBreak.SpacingMarkBreak}));       // 0x0903
    rows.push_back(BreakRange({.first = 2362, .last = 2362, .property = GraphemeBreak.Extend}));                 // 0x093A
    rows.push_back(BreakRange({.first = 2363, .last = 2363, .property = GraphemeBreak.SpacingMarkBreak}));       // 0x093B
    rows.push_back(BreakRange({.first = 2364, .last = 2364, .property = GraphemeBreak.Extend}));                 // 0x093C
    rows.push_back(BreakRange({.first = 2366, .last = 2368, .property = GraphemeBreak.SpacingMarkBreak}));       // 0x093E .. 0x0940
    rows.push_back(BreakRange({.first = 2369, .last = 2376, .property = GraphemeBreak.Extend}));                 // 0x0941 .. 0x0948
    rows.push_back(BreakRange({.first = 2377, .last = 2380, .property = GraphemeBreak.SpacingMarkBreak}));       // 0x0949 .. 0x094C
    rows.push_back(BreakRange({.first = 2381, .last = 2381, .property = GraphemeBreak.Extend}));                 // 0x094D
    rows.push_back(BreakRange({.first = 3633, .last = 3633, .property = GraphemeBreak.Extend}));                 // 0x0E31
    rows.push_back(BreakRange({.first = 3636, .last = 3642, .property = GraphemeBreak.Extend}));                 // 0x0E34 .. 0x0E3A
    rows.push_back(BreakRange({.first = 3655, .last = 3662, .property = GraphemeBreak.Extend}));                 // 0x0E47 .. 0x0E4E
    rows.push_back(BreakRange({.first = 4352, .last = 4447, .property = GraphemeBreak.HangulL}));                // 0x1100 .. 0x115F
    rows.push_back(BreakRange({.first = 4448, .last = 4519, .property = GraphemeBreak.HangulV}));                // 0x1160 .. 0x11A7
    rows.push_back(BreakRange({.first = 4520, .last = 4607, .property = GraphemeBreak.HangulT}));                // 0x11A8 .. 0x11FF
    rows.push_back(BreakRange({.first = 6068, .last = 6069, .property = GraphemeBreak.Prepend}));                // 0x17B4 .. 0x17B5
    rows.push_back(BreakRange({.first = 8203, .last = 8203, .property = GraphemeBreak.ControlBreak}));           // 0x200B
    rows.push_back(BreakRange({.first = 8204, .last = 8204, .property = GraphemeBreak.Extend}));                 // 0x200C
    rows.push_back(BreakRange({.first = 8205, .last = 8205, .property = GraphemeBreak.ZeroWidthJoiner}));        // 0x200D
    rows.push_back(BreakRange({.first = 8206, .last = 8207, .property = GraphemeBreak.ControlBreak}));           // 0x200E .. 0x200F
    rows.push_back(BreakRange({.first = 8232, .last = 8233, .property = GraphemeBreak.ControlBreak}));           // 0x2028 .. 0x2029
    rows.push_back(BreakRange({.first = 8234, .last = 8238, .property = GraphemeBreak.ControlBreak}));           // 0x202A .. 0x202E
    rows.push_back(BreakRange({.first = 8288, .last = 8303, .property = GraphemeBreak.ControlBreak}));           // 0x2060 .. 0x206F
    rows.push_back(BreakRange({.first = 8400, .last = 8432, .property = GraphemeBreak.Extend}));                 // 0x20D0 .. 0x20F0
    rows.push_back(BreakRange({.first = 9757, .last = 9757, .property = GraphemeBreak.ExtendedPictographic}));   // 0x261D
    rows.push_back(BreakRange({.first = 9977, .last = 9977, .property = GraphemeBreak.ExtendedPictographic}));   // 0x26F9
    rows.push_back(BreakRange({.first = 12330, .last = 12335, .property = GraphemeBreak.Extend}));               // 0x302A .. 0x302F
    rows.push_back(BreakRange({.first = 12441, .last = 12442, .property = GraphemeBreak.Extend}));               // 0x3099 .. 0x309A
    rows.push_back(BreakRange({.first = 65024, .last = 65039, .property = GraphemeBreak.Extend}));               // 0xFE00 .. 0xFE0F
    rows.push_back(BreakRange({.first = 65056, .last = 65071, .property = GraphemeBreak.Extend}));               // 0xFE20 .. 0xFE2F
    rows.push_back(BreakRange({.first = 65279, .last = 65279, .property = GraphemeBreak.ControlBreak}));         // 0xFEFF
    rows.push_back(BreakRange({.first = 65529, .last = 65531, .property = GraphemeBreak.ControlBreak}));         // 0xFFF9 .. 0xFFFB
    rows.push_back(BreakRange({.first = 127462, .last = 127487, .property = GraphemeBreak.RegionalIndicator}));  // 0x1F1E6 .. 0x1F1FF
    rows.push_back(BreakRange({.first = 127744, .last = 128511, .property = GraphemeBreak.ExtendedPictographic})); // 0x1F300 .. 0x1F5FF
    rows.push_back(BreakRange({.first = 128512, .last = 128591, .property = GraphemeBreak.ExtendedPictographic})); // 0x1F600 .. 0x1F64F
    rows.push_back(BreakRange({.first = 128640, .last = 128767, .property = GraphemeBreak.ExtendedPictographic})); // 0x1F680 .. 0x1F6FF
    rows.push_back(BreakRange({.first = 129280, .last = 129535, .property = GraphemeBreak.ExtendedPictographic})); // 0x1F980 .. 0x1FA7F
    rows.push_back(BreakRange({.first = 917504, .last = 921599, .property = GraphemeBreak.Extend}));             // 0xE0000 .. 0xE0FFF tags
    return rows;
}

fn find_break(rows: vector(BreakRange), scalar: int) -> GraphemeBreak {
    var low: int = 0;
    var high = rows.size() - 1;
    while (low <= high) {
        let middle = low + ((high - low) >> 1);
        let ref row: auto = rows.at(middle);
        if (scalar < row.first) {
            high = middle - 1;
        } else {
            if (scalar > row.last) {
                low = middle + 1;
            } else {
                return row.property;
            }
        }
    }
    return GraphemeBreak.Other;
}

// The Hangul syllable block is not in the table because it is computed.
fn grapheme_property(props: Properties, scalar: int) -> GraphemeBreak {
    if (is_hangul_syllable(scalar)) {
        if (hangul_is_lv(scalar)) {
            return GraphemeBreak.HangulLV;
        }
        return GraphemeBreak.HangulLVT;
    }
    return find_break(props.breaks, scalar);
}

// The state a cluster walker carries between code points, which is what makes
// the regional indicator and emoji sequence rules expressible.
class BreakState {

    fn reset(ref self) {
        self.previous = GraphemeBreak.Other;
        self.regional_run = 0;
        self.in_emoji_sequence = false;
        self.started = false;
    }

    var previous: GraphemeBreak = GraphemeBreak.Other;
    var regional_run: int = 0;
    var in_emoji_sequence: bool = false;
    var started: bool = false;
}

// Decide whether a cluster boundary falls between two code points. The rules
// are applied in the order the standard gives them, and the numbering in the
// comments matches the standard so the two can be diffed.
fn breaks_between(props: Properties, ref state: BreakState, before: int, after: int) -> bool {
    let left = grapheme_property(props, before);
    let right = grapheme_property(props, after);

    // GB3: do not break inside a carriage return line feed pair.
    if (left == GraphemeBreak.CarriageReturn and right == GraphemeBreak.LineFeed) {
        state.regional_run = 0;
        return false;
    }

    // GB4: break after any control, carriage return or line feed.
    if (left == GraphemeBreak.ControlBreak) {
        state.regional_run = 0;
        return true;
    }
    if (left == GraphemeBreak.CarriageReturn) {
        state.regional_run = 0;
        return true;
    }
    if (left == GraphemeBreak.LineFeed) {
        state.regional_run = 0;
        return true;
    }

    // GB5: break before any control, carriage return or line feed.
    if (right == GraphemeBreak.ControlBreak) {
        state.regional_run = 0;
        return true;
    }
    if (right == GraphemeBreak.CarriageReturn) {
        state.regional_run = 0;
        return true;
    }
    if (right == GraphemeBreak.LineFeed) {
        state.regional_run = 0;
        return true;
    }

    // GB6, GB7, GB8: do not break inside a Hangul syllable sequence.
    if (left == GraphemeBreak.HangulL) {
        if (right == GraphemeBreak.HangulL) {
            return false;
        }
        if (right == GraphemeBreak.HangulV) {
            return false;
        }
        if (right == GraphemeBreak.HangulLV) {
            return false;
        }
        if (right == GraphemeBreak.HangulLVT) {
            return false;
        }
    }
    if (left == GraphemeBreak.HangulLV or left == GraphemeBreak.HangulV) {
        if (right == GraphemeBreak.HangulV) {
            return false;
        }
        if (right == GraphemeBreak.HangulT) {
            return false;
        }
    }
    if (left == GraphemeBreak.HangulLVT or left == GraphemeBreak.HangulT) {
        if (right == GraphemeBreak.HangulT) {
            return false;
        }
    }

    // GB9: do not break before extending characters or the joiner.
    if (right == GraphemeBreak.Extend) {
        return false;
    }
    if (right == GraphemeBreak.ZeroWidthJoiner) {
        state.in_emoji_sequence = left == GraphemeBreak.ExtendedPictographic;
        return false;
    }

    // GB9a: do not break before a spacing mark.
    if (right == GraphemeBreak.SpacingMarkBreak) {
        return false;
    }

    // GB9b: do not break after a prepending character.
    if (left == GraphemeBreak.Prepend) {
        return false;
    }

    // GB11: do not break within an emoji joiner sequence.
    if (left == GraphemeBreak.ZeroWidthJoiner) {
        if (right == GraphemeBreak.ExtendedPictographic) {
            if (state.in_emoji_sequence) {
                state.in_emoji_sequence = false;
                return false;
            }
        }
    }

    // GB12 and GB13: break between a pair of regional indicators, but not in
    // the middle of one flag.
    if (left == GraphemeBreak.RegionalIndicator and right == GraphemeBreak.RegionalIndicator) {
        state.regional_run += 1;
        if ((state.regional_run % 2) == 1) {
            return false;
        }
        state.regional_run = 0;
        return true;
    }
    state.regional_run = 0;

    // GB999: otherwise break everywhere.
    return true;
}

// Split a scalar run into clusters, each described by a half open index range.
fn grapheme_steps(props: Properties, scalars: vector(int)) -> vector(Step) {
    var out: vector(Step);
    if (scalars.empty()) {
        return out;
    }
    var state: BreakState;
    state.reset();
    var begin: int = 0;
    var index: int = 1;
    while (index < scalars.size()) {
        let before = scalars.at(index - 1);
        let after = scalars.at(index);
        if (breaks_between(props, state, before, after)) {
            out.push_back(Step({.begin = begin, .end = index, .valid = true}));
            begin = index;
        }
        index += 1;
    }
    out.push_back(Step({.begin = begin, .end = scalars.size(), .valid = true}));
    return out;
}

fn count_graphemes(props: Properties, scalars: vector(int)) -> int {
    if (scalars.empty()) {
        return 0;
    }
    var state: BreakState;
    state.reset();
    var count: int = 1;
    var index: int = 1;
    while (index < scalars.size()) {
        if (breaks_between(props, state, scalars.at(index - 1), scalars.at(index))) {
            count += 1;
        }
        index += 1;
    }
    return count;
}

// The index just past the cluster that starts at from.
fn next_grapheme(props: Properties, scalars: vector(int), from: int) -> int {
    if (from >= scalars.size()) {
        return scalars.size();
    }
    var state: BreakState;
    state.reset();
    var index = from + 1;
    while (index < scalars.size()) {
        if (breaks_between(props, state, scalars.at(index - 1), scalars.at(index))) {
            return index;
        }
        index += 1;
    }
    return scalars.size();
}

// Walking backwards is harder because the rules are not symmetric; the honest
// implementation rescans from the start of a bounded window.
fn previous_grapheme(props: Properties, scalars: vector(int), from: int) -> int {
    if (from <= 0) {
        return 0;
    }
    var window = from - 64;
    if (window < 0) {
        window = 0;
    }
    var candidate = window;
    var cursor = window;
    while (cursor < from) {
        let step = next_grapheme(props, scalars, cursor);
        if (step >= from) {
            return cursor;
        }
        candidate = cursor;
        cursor = step;
    }
    return candidate;
}

// --- Word segmentation ---------------------------------------------------

fn word_break_table() -> vector(WordRange) {
    var rows: vector(WordRange);
    rows.push_back(WordRange({.first = 9, .last = 9, .property = WordBreak.WhiteSpaceWord}));                // tab
    rows.push_back(WordRange({.first = 10, .last = 10, .property = WordBreak.LineFeedWord}));                // line feed
    rows.push_back(WordRange({.first = 11, .last = 12, .property = WordBreak.NewlineWord}));                 // 0x0B .. 0x0C
    rows.push_back(WordRange({.first = 13, .last = 13, .property = WordBreak.CarriageReturnWord}));          // carriage return
    rows.push_back(WordRange({.first = 32, .last = 32, .property = WordBreak.WhiteSpaceWord}));              // space
    rows.push_back(WordRange({.first = 34, .last = 34, .property = WordBreak.DoubleQuoteWord}));             // 0x0022
    rows.push_back(WordRange({.first = 39, .last = 39, .property = WordBreak.SingleQuoteWord}));             // 0x0027 apostrophe
    rows.push_back(WordRange({.first = 44, .last = 44, .property = WordBreak.MidNum}));                      // comma
    rows.push_back(WordRange({.first = 46, .last = 46, .property = WordBreak.MidNumLet}));                   // full stop
    rows.push_back(WordRange({.first = 48, .last = 57, .property = WordBreak.Numeric}));                     // 0 .. 9
    rows.push_back(WordRange({.first = 58, .last = 58, .property = WordBreak.MidLetter}));                   // colon
    rows.push_back(WordRange({.first = 59, .last = 59, .property = WordBreak.MidNum}));                      // semicolon
    rows.push_back(WordRange({.first = 65, .last = 90, .property = WordBreak.ALetter}));                     // A .. Z
    rows.push_back(WordRange({.first = 95, .last = 95, .property = WordBreak.ExtendNumLet}));                // underscore
    rows.push_back(WordRange({.first = 97, .last = 122, .property = WordBreak.ALetter}));                    // a .. z
    rows.push_back(WordRange({.first = 133, .last = 133, .property = WordBreak.NewlineWord}));               // 0x0085
    rows.push_back(WordRange({.first = 160, .last = 160, .property = WordBreak.WhiteSpaceWord}));            // 0x00A0
    rows.push_back(WordRange({.first = 173, .last = 173, .property = WordBreak.FormatWord}));                // 0x00AD
    rows.push_back(WordRange({.first = 183, .last = 183, .property = WordBreak.MidLetter}));                 // 0x00B7 middle dot
    rows.push_back(WordRange({.first = 192, .last = 214, .property = WordBreak.ALetter}));                   // 0x00C0 .. 0x00D6
    rows.push_back(WordRange({.first = 216, .last = 246, .property = WordBreak.ALetter}));                   // 0x00D8 .. 0x00F6
    rows.push_back(WordRange({.first = 248, .last = 591, .property = WordBreak.ALetter}));                   // 0x00F8 .. 0x024F
    rows.push_back(WordRange({.first = 768, .last = 879, .property = WordBreak.ExtendWord}));                // 0x0300 .. 0x036F
    rows.push_back(WordRange({.first = 894, .last = 894, .property = WordBreak.MidNum}));                    // 0x037E greek semicolon
    rows.push_back(WordRange({.first = 902, .last = 1023, .property = WordBreak.ALetter}));                  // greek
    rows.push_back(WordRange({.first = 1024, .last = 1327, .property = WordBreak.ALetter}));                 // cyrillic
    rows.push_back(WordRange({.first = 1425, .last = 1474, .property = WordBreak.ExtendWord}));              // hebrew marks
    rows.push_back(WordRange({.first = 1488, .last = 1514, .property = WordBreak.HebrewLetter}));            // 0x05D0 .. 0x05EA
    rows.push_back(WordRange({.first = 1536, .last = 1541, .property = WordBreak.FormatWord}));              // 0x0600 .. 0x0605
    rows.push_back(WordRange({.first = 1548, .last = 1548, .property = WordBreak.MidNum}));                  // 0x060C
    rows.push_back(WordRange({.first = 1569, .last = 1610, .property = WordBreak.ALetter}));                 // arabic letters
    rows.push_back(WordRange({.first = 1611, .last = 1631, .property = WordBreak.ExtendWord}));              // arabic marks
    rows.push_back(WordRange({.first = 1632, .last = 1641, .property = WordBreak.Numeric}));                 // arabic digits
    rows.push_back(WordRange({.first = 2304, .last = 2381, .property = WordBreak.ALetter}));                 // devanagari
    rows.push_back(WordRange({.first = 2406, .last = 2415, .property = WordBreak.Numeric}));                 // devanagari digits
    rows.push_back(WordRange({.first = 8192, .last = 8202, .property = WordBreak.WhiteSpaceWord}));          // 0x2000 .. 0x200A
    rows.push_back(WordRange({.first = 8203, .last = 8203, .property = WordBreak.FormatWord}));              // 0x200B
    rows.push_back(WordRange({.first = 8204, .last = 8204, .property = WordBreak.ExtendWord}));              // 0x200C
    rows.push_back(WordRange({.first = 8205, .last = 8205, .property = WordBreak.ZeroWidthJoinerWord}));     // 0x200D
    rows.push_back(WordRange({.first = 8206, .last = 8207, .property = WordBreak.FormatWord}));              // 0x200E .. 0x200F
    rows.push_back(WordRange({.first = 8216, .last = 8217, .property = WordBreak.MidNumLet}));               // 0x2018 .. 0x2019
    rows.push_back(WordRange({.first = 8228, .last = 8228, .property = WordBreak.MidNumLet}));               // 0x2024
    rows.push_back(WordRange({.first = 8232, .last = 8233, .property = WordBreak.NewlineWord}));             // 0x2028 .. 0x2029
    rows.push_back(WordRange({.first = 8255, .last = 8256, .property = WordBreak.ExtendNumLet}));            // 0x203F .. 0x2040
    rows.push_back(WordRange({.first = 8287, .last = 8287, .property = WordBreak.WhiteSpaceWord}));          // 0x205F
    rows.push_back(WordRange({.first = 8288, .last = 8303, .property = WordBreak.FormatWord}));              // 0x2060 .. 0x206F
    rows.push_back(WordRange({.first = 8400, .last = 8432, .property = WordBreak.ExtendWord}));              // 0x20D0 .. 0x20F0
    rows.push_back(WordRange({.first = 12288, .last = 12288, .property = WordBreak.WhiteSpaceWord}));        // 0x3000
    rows.push_back(WordRange({.first = 12441, .last = 12442, .property = WordBreak.ExtendWord}));            // 0x3099 .. 0x309A
    rows.push_back(WordRange({.first = 12448, .last = 12543, .property = WordBreak.Katakana}));              // 0x30A0 .. 0x30FF
    rows.push_back(WordRange({.first = 65024, .last = 65039, .property = WordBreak.ExtendWord}));            // 0xFE00 .. 0xFE0F
    rows.push_back(WordRange({.first = 65075, .last = 65076, .property = WordBreak.ExtendNumLet}));          // 0xFE33 .. 0xFE34
    rows.push_back(WordRange({.first = 65279, .last = 65279, .property = WordBreak.FormatWord}));            // 0xFEFF
    rows.push_back(WordRange({.first = 65296, .last = 65305, .property = WordBreak.Numeric}));               // 0xFF10 .. 0xFF19
    rows.push_back(WordRange({.first = 65313, .last = 65338, .property = WordBreak.ALetter}));               // 0xFF21 .. 0xFF3A
    rows.push_back(WordRange({.first = 65345, .last = 65370, .property = WordBreak.ALetter}));               // 0xFF41 .. 0xFF5A
    rows.push_back(WordRange({.first = 127462, .last = 127487, .property = WordBreak.RegionalWord}));        // 0x1F1E6 .. 0x1F1FF
    return rows;
}

fn find_word_property(rows: vector(WordRange), scalar: int) -> WordBreak {
    var low: int = 0;
    var high = rows.size() - 1;
    while (low <= high) {
        let middle = low + ((high - low) >> 1);
        let ref row: auto = rows.at(middle);
        if (scalar < row.first) {
            high = middle - 1;
        } else {
            if (scalar > row.last) {
                low = middle + 1;
            } else {
                return row.property;
            }
        }
    }
    return WordBreak.Any;
}

fn word_property(props: Properties, scalar: int) -> WordBreak {
    return find_word_property(props.words, scalar);
}

fn is_word_letter(property: WordBreak) -> bool {
    if (property == WordBreak.ALetter) {
        return true;
    }
    return property == WordBreak.HebrewLetter;
}

fn is_mid_letter(property: WordBreak) -> bool {
    if (property == WordBreak.MidLetter) {
        return true;
    }
    if (property == WordBreak.MidNumLet) {
        return true;
    }
    return property == WordBreak.SingleQuoteWord;
}

fn is_mid_number(property: WordBreak) -> bool {
    if (property == WordBreak.MidNum) {
        return true;
    }
    return property == WordBreak.MidNumLet;
}

fn is_ignorable_word_property(property: WordBreak) -> bool {
    if (property == WordBreak.ExtendWord) {
        return true;
    }
    if (property == WordBreak.FormatWord) {
        return true;
    }
    return property == WordBreak.ZeroWidthJoinerWord;
}

// Word boundary test with one code point of lookahead on each side, which is
// what rules WB6, WB7, WB11 and WB12 need in order to keep a mid letter glued
// to the letters around it.
fn word_breaks_between(props: Properties, before2: int, before: int, after: int, after2: int) -> bool {
    let left = word_property(props, before);
    let right = word_property(props, after);
    let far_left = word_property(props, before2);
    let far_right = word_property(props, after2);

    // WB3: do not break inside a carriage return line feed pair.
    if (left == WordBreak.CarriageReturnWord and right == WordBreak.LineFeedWord) {
        return false;
    }
    // WB3a and WB3b: break before and after newlines.
    if (left == WordBreak.NewlineWord or left == WordBreak.CarriageReturnWord or left == WordBreak.LineFeedWord) {
        return true;
    }
    if (right == WordBreak.NewlineWord or right == WordBreak.CarriageReturnWord or right == WordBreak.LineFeedWord) {
        return true;
    }
    // WB4: ignore format and extend characters entirely.
    if (is_ignorable_word_property(right)) {
        return false;
    }
    // WB5: do not break between letters.
    if (is_word_letter(left) and is_word_letter(right)) {
        return false;
    }
    // WB6 and WB7: a mid letter between two letters does not break.
    if (is_word_letter(left) and is_mid_letter(right) and is_word_letter(far_right)) {
        return false;
    }
    if (is_mid_letter(left) and is_word_letter(right) and is_word_letter(far_left)) {
        return false;
    }
    // WB7a, WB7b and WB7c: the Hebrew apostrophe and quotation rules.
    if (left == WordBreak.HebrewLetter and right == WordBreak.SingleQuoteWord) {
        return false;
    }
    if (left == WordBreak.HebrewLetter and right == WordBreak.DoubleQuoteWord and far_right == WordBreak.HebrewLetter) {
        return false;
    }
    if (left == WordBreak.DoubleQuoteWord and right == WordBreak.HebrewLetter and far_left == WordBreak.HebrewLetter) {
        return false;
    }
    // WB8 to WB10: digits and letters cling together.
    if (left == WordBreak.Numeric and right == WordBreak.Numeric) {
        return false;
    }
    if (is_word_letter(left) and right == WordBreak.Numeric) {
        return false;
    }
    if (left == WordBreak.Numeric and is_word_letter(right)) {
        return false;
    }
    // WB11 and WB12: a mid number between two digits does not break.
    if (left == WordBreak.Numeric and is_mid_number(right) and far_right == WordBreak.Numeric) {
        return false;
    }
    if (is_mid_number(left) and right == WordBreak.Numeric and far_left == WordBreak.Numeric) {
        return false;
    }
    // WB13: katakana runs together.
    if (left == WordBreak.Katakana and right == WordBreak.Katakana) {
        return false;
    }
    // WB13a and WB13b: the connector punctuation rules.
    if (left == WordBreak.ExtendNumLet) {
        if (is_word_letter(right) or right == WordBreak.Numeric or right == WordBreak.Katakana) {
            return false;
        }
        if (right == WordBreak.ExtendNumLet) {
            return false;
        }
    }
    if (right == WordBreak.ExtendNumLet) {
        if (is_word_letter(left) or left == WordBreak.Numeric or left == WordBreak.Katakana) {
            return false;
        }
    }
    // WB15 and WB16: a flag is two regional indicators.
    if (left == WordBreak.RegionalWord and right == WordBreak.RegionalWord) {
        return false;
    }
    // WB999: otherwise break.
    return true;
}

fn peek_scalar(scalars: vector(int), index: int) -> int {
    if (index < 0 or index >= scalars.size()) {
        return 0;
    }
    return scalars.at(index);
}

fn word_steps(props: Properties, scalars: vector(int)) -> vector(Step) {
    var out: vector(Step);
    if (scalars.empty()) {
        return out;
    }
    var begin: int = 0;
    var index: int = 1;
    while (index < scalars.size()) {
        let before2 = peek_scalar(scalars, index - 2);
        let before = peek_scalar(scalars, index - 1);
        let after = peek_scalar(scalars, index);
        let after2 = peek_scalar(scalars, index + 1);
        if (word_breaks_between(props, before2, before, after, after2)) {
            out.push_back(Step({.begin = begin, .end = index, .valid = true}));
            begin = index;
        }
        index += 1;
    }
    out.push_back(Step({.begin = begin, .end = scalars.size(), .valid = true}));
    return out;
}

// Only the runs that contain at least one letter or digit, which is what a
// word count or a spell checker wants.
fn word_steps_filtered(props: Properties, scalars: vector(int)) -> vector(Step) {
    var out: vector(Step);
    let candidates = word_steps(props, scalars);
    for (step in candidates) {
        var interesting: bool = false;
        for (i in range(step.begin, step.end)) {
            let scalar = scalars.at(i);
            if (props.is_letter(scalar) or props.is_number(scalar)) {
                interesting = true;
            }
        }
        if (interesting) {
            out.push_back(Step({.begin = step.begin, .end = step.end, .valid = true}));
        }
    }
    return out;
}

fn count_words(props: Properties, scalars: vector(int)) -> int {
    let steps = word_steps_filtered(props, scalars);
    return steps.size();
}


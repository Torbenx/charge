    rows.push_back(DecompositionRow({.source = 1118, .first = 1091, .second = 774, .compatibility = false, .note = "short u"}));     // 0x045E

    // Singleton canonical decompositions: the second field is zero.
    rows.push_back(DecompositionRow({.source = 8486, .first = 937, .second = 0, .compatibility = false, .note = "ohm to Omega"}));   // 0x2126

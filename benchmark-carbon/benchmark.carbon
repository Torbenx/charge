// Generic B-tree implementing an ordered map from K to V.
//
// The tree is parameterised three ways:
//
//   * `K`     -- the key type, ordered by `compare_keys`,
//   * `V`     -- the mapped value type,
//   * `ORDER` -- the branching factor, i.e. the maximum number of children a
//                single node may have.  A node therefore stores at most
//                `ORDER - 1` keys and, unless it is the root, at least
//                `ORDER / 2 - 1` keys.
//
// Every node lives in a flat arena (`nodes`) and every link is an integer
// index into that arena; `BTREE_NIL` (-1) stands for "no such node".  Keeping
// the links as indices means a whole tree can be copied, serialised or
// relocated without touching a single pointer.
//
// The structural invariants, restated by `check_validity` with `assert` and
// `prove`, are:
//
//   1. Keys inside a node are strictly increasing.
//   2. A node with `n` keys has either `0` or `n + 1` children.
//   3. Every non-root node holds between `min_keys()` and `max_keys()` keys.
//   4. All leaves sit at exactly the same depth.
//   5. The subtree hanging off child `i` contains only keys that are greater
//      than key `i - 1` and smaller than key `i`.
//
// Insertion splits full nodes on the way down (proactive splitting), so a
// split never has to propagate back towards the root.  Deletion mirrors that
// by refilling any child that is about to become minimal *before* descending
// into it, either by borrowing a separator from a sibling or by merging with
// one.
namespace b_tree;

// --- Enumerations ---------------------------------------------------------

// What happened while making room for a new key.
choice SplitOutcome {
    NoSplit,
    SplitPerformed,
    RootGrew,
}

// How a child was rescued from dropping below the minimum occupancy.
choice RebalanceAction {
    BorrowedFromLeft,
    BorrowedFromRight,
    MergedWithLeft,
    MergedWithRight,
    NoActionNeeded,
}

// Result classification for a search inside a single node.
choice SlotKind {
    ExactMatch,
    DescendLeft,
    DescendRight,
    MissingSlot,
}

// Direction of a traversal or of a range scan.
choice ScanOrder {
    Ascending,
    Descending,
}

// --- Tuning constants -----------------------------------------------------

// Sentinel index meaning "no node".  Negative so it can never index the arena.
let BTREE_NIL: int = -1;

// Branching factor used when a tree is created without an explicit order.
let BTREE_DEFAULT_ORDER: int = 6;

// Upper bound on the height of any tree we are willing to build.  Only used
// to size traversal stacks up front so they never reallocate.
let BTREE_MAX_HEIGHT: int = 48;

// Arena capacity used when a tree is created without a size hint.
let BTREE_INITIAL_CAPACITY: int = 32;

// Growth factor for the arena, expressed as a percentage so that no floating
// point is required anywhere in the container.
let BTREE_GROWTH_PERCENT: int = 200;

// Target fill level, in percent, used by `bulk_load` when it decides how many
// keys to pack into each freshly built leaf.  Leaving a little slack means the
// first few insertions after a bulk load do not immediately split anything.
let BTREE_BULK_FILL_PERCENT: int = 75;

// Number of key/value samples the statistics pass is allowed to retain.
let BTREE_SAMPLE_LIMIT: int = 8;

// --- Node -----------------------------------------------------------------

// A single B-tree node.
//
// `keys` and `values` are parallel arrays of length `count`; `children` is
// either empty (a leaf) or of length `count + 1` (an internal node).  The node
// is generic over the branching factor as well as the key and value types, so
// `max_keys()` and `min_keys()` are compile-time constants rather than fields.
class BTreeNode(K: type, V: type, ORDER: int)
{

    // --- Capacity ---------------------------------------------------------

    fn max_children(self) -> int {
        return ORDER;
    }

    fn max_keys(self) -> int {
        return ORDER - 1;
    }

    // Minimum occupancy for every node except the root.  Written as a
    // division so that both even and odd branching factors behave.
    fn min_keys(self) -> int {
        return ORDER / 2 - 1;
    }

    fn min_children(self) -> int {
        return ORDER / 2;
    }

    fn is_full(self) -> bool {
        return self.count >= ORDER - 1;
    }

    fn is_minimal(self) -> bool {
        return self.count <= ORDER / 2 - 1;
    }

    // True when a key can be taken away without violating rule 3.
    fn has_spare_key(self) -> bool {
        return self.count > ORDER / 2 - 1;
    }

    fn is_leaf(self) -> bool {
        return self.leaf;
    }

    fn key_count(self) -> int {
        return self.count;
    }

    fn child_count(self) -> int {
        if (self.leaf) {
            return 0;
        }
        return self.count + 1;
    }

    fn occupancy_percent(self) -> int {
        if (ORDER <= 1) {
            return 0;
        }
        return self.count * 100 / (ORDER - 1);
    }

    // --- Slot access ------------------------------------------------------

    fn key_at(ref self, index: int) -> ref K {
        return self.keys[index];
    }

    fn value_at(ref self, index: int) -> ref V {
        return self.values[index];
    }

    fn child_at(self, index: int) -> int {
        if (self.leaf) {
            return BTREE_NIL;
        }
        if (index < 0 or index > self.count) {
            return BTREE_NIL;
        }
        return self.children[index];
    }

    // Materialises slot `index` as a `pair{K, V}`; the pair is the unit every
    // bulk operation in this file trades in.
    fn entry_at(self, index: int) -> pair(K, V) {
        return pair(K, V)({.first = self.keys[index], .second = self.values[index]});
    }

    // Copies the whole node out as a vector of pairs.  Used by the bulk
    // loader, by `in_order` and by the statistics pass.
    fn entries(self) -> vector(pair(K, V)) {
        var out = vector(pair(K, V))();
        out.reserve(self.count);
        var i: int = 0;
        while (i < self.count) {
            out.push_back(pair(K, V)({.first = self.keys[i], .second = self.values[i]}));
            i += 1;
        }
        return out;
    }

    // The node's separator keys paired with the child that sits to their left.
    fn separators(self) -> vector(pair(K, int)) {
        var out = vector(pair(K, int))();
        if (self.leaf) {
            return out;
        }
        var i: int = 0;
        while (i < self.count) {
            out.push_back(pair(K, int)({.first = self.keys[i], .second = self.children[i]}));
            i += 1;
        }
        return out;
    }

    // --- Search inside one node -------------------------------------------

    // Index of the first key that is not smaller than `key`.  This is the
    // classic branch point: on an exact hit it is the matching slot, otherwise
    // it is the index of the child that must be descended into.
    fn lower_bound(self, key: K) -> int {
        var lo: int = 0;
        var hi: int = self.count;
        while (lo < hi) {
            let mid = lo + (hi - lo) / 2;
            if (compare_keys(self.keys[mid], *key) < 0) {
                lo = mid + 1;
            } else {
                hi = mid;
            }
        }
        return lo;
    }

    // Index of the first key that is strictly greater than `key`.
    fn upper_bound(self, key: K) -> int {
        var lo: int = 0;
        var hi: int = self.count;
        while (lo < hi) {
            let mid = lo + (hi - lo) / 2;
            if (compare_keys(self.keys[mid], *key) <= 0) {
                lo = mid + 1;
            } else {
                hi = mid;
            }
        }
        return lo;
    }

    // A linear scan, kept because it is what the validity checker uses: the
    // binary search above is only correct if rule 1 holds, and the checker
    // must not assume the invariant it is trying to prove.
    fn linear_find(self, key: K) -> int {
        var i: int = 0;
        while (i < self.count) {
            if (compare_keys(self.keys[i], *key) == 0) {
                return i;
            }
            i += 1;
        }
        return -1;
    }

    fn contains_key(self, key: K) -> bool {
        let slot = self.lower_bound(key);
        if (slot >= self.count) {
            return false;
        }
        return compare_keys(self.keys[slot], *key) == 0;
    }

    // Classifies a search without performing it, so callers can branch on an
    // enum rather than on a pair of integers.
    fn classify(self, key: K) -> SlotKind {
        if (self.count == 0) {
            return SlotKind.MissingSlot;
        }
        let slot = self.lower_bound(key);
        if (slot < self.count) {
            if (compare_keys(self.keys[slot], *key) == 0) {
                return SlotKind.ExactMatch;
            } else {
                return SlotKind.DescendLeft;
            }
        } else {
            return SlotKind.DescendRight;
        }
    }

    // Search returning both the slot and whether it was a hit.  The `pair`
    // return type is what every caller in `BTree` destructures.
    fn probe(self, key: K) -> pair(int, bool) {
        let slot = self.lower_bound(key);
        if (slot < self.count) {
            if (compare_keys(self.keys[slot], *key) == 0) {
                return pair(int, bool)({.first = slot, .second = true});
            }
        }
        return pair(int, bool)({.first = slot, .second = false});
    }

    // --- Array shuffling --------------------------------------------------
    //
    // Every mutation below moves elements by hand instead of calling
    // `vector::insert` / `vector::erase`, because the key, value and child
    // arrays have to stay in step with each other and with `count`.

    // Opens a hole at `at` by shifting keys and values one slot to the right.
    fn shift_keys_right(ref self, at: int) {
        self.keys.push_back(self.keys[self.count - 1]);
        self.values.push_back(self.values[self.count - 1]);
        var i = self.count - 1;
        while (i > at) {
            self.keys[i] = self.keys[i - 1];
            self.values[i] = self.values[i - 1];
            i -= 1;
        }
    }

    // Closes the hole at `at` by shifting keys and values one slot left.
    fn shift_keys_left(ref self, at: int) {
        var i = at;
        while (i + 1 < self.count) {
            self.keys[i] = self.keys[i + 1];
            self.values[i] = self.values[i + 1];
            i += 1;
        }
        self.keys.pop_back();
        self.values.pop_back();
    }

    fn shift_children_right(ref self, at: int) {
        if (self.leaf) {
            return;
        }
        self.children.push_back(self.children[self.count]);
        var i = self.count;
        while (i > at) {
            self.children[i] = self.children[i - 1];
            i -= 1;
        }
    }

    fn shift_children_left(ref self, at: int) {
        if (self.leaf) {
            return;
        }
        var i = at;
        while (i + 1 <= self.count) {
            self.children[i] = self.children[i + 1];
            i += 1;
        }
        self.children.pop_back();
    }

    // --- Primitive edits --------------------------------------------------

    fn insert_entry_at(ref self, at: int, key: K, value: V) {
        if (self.count == 0) {
            self.keys.push_back(key);
            self.values.push_back(value);
            self.count = 1;
            return;
        }
        if (at >= self.count) {
            self.keys.push_back(key);
            self.values.push_back(value);
            self.count += 1;
            return;
        }
        self.shift_keys_right(at);
        self.keys[at] = key;
        self.values[at] = value;
        self.count += 1;
    }

    fn remove_entry_at(ref self, at: int) -> pair(K, V) {
        let taken = pair(K, V)({.first = self.keys[at], .second = self.values[at]});
        self.shift_keys_left(at);
        self.count -= 1;
        return taken;
    }

    fn insert_child_at(ref self, at: int, child: int) {
        if (self.leaf) {
            return;
        }
        if (at > self.count) {
            self.children.push_back(child);
            return;
        }
        self.shift_children_right(at);
        self.children[at] = child;
    }

    fn remove_child_at(ref self, at: int) -> int {
        if (self.leaf) {
            return BTREE_NIL;
        }
        let taken = self.children[at];
        self.shift_children_left(at);
        return taken;
    }

    fn push_entry(ref self, key: K, value: V) {
        self.keys.push_back(key);
        self.values.push_back(value);
        self.count += 1;
    }

    fn push_pair(ref self, entry: pair(K, V)) {
        self.keys.push_back(entry.first);
        self.values.push_back(entry.second);
        self.count += 1;
    }

    fn pop_entry(ref self) -> pair(K, V) {
        let taken = pair(K, V)({.first = self.keys[self.count - 1], .second = self.values[self.count - 1]});
        self.keys.pop_back();
        self.values.pop_back();
        self.count -= 1;
        return taken;
    }

    fn reset_slots(ref self) {
        self.keys.clear();
        self.values.clear();
        self.children.clear();
        self.count = 0;
        self.leaf = true;
        self.parent = BTREE_NIL;
        self.depth = 0;
    }

    var keys: vector(K);
    var values: vector(V);
    var children: vector(int);
    var count: int = 0;
    var leaf: bool = true;
    var parent: int = -1;
    var depth: int = 0;
    var live: bool = true;
}

// --- Statistics -----------------------------------------------------------

// Everything the shape pass measures.  It is generic over K and V purely so
// that it can carry a handful of sampled entries alongside the numbers, which
// makes the struct useful for debugging as well as for testing.
class BTreeStats(K: type, V: type)
{

    fn average_occupancy(self) -> int {
        if (self.node_count == 0) {
            return 0;
        }
        return self.key_count * 100 / self.node_count;
    }

    fn leaf_fraction_percent(self) -> int {
        if (self.node_count == 0) {
            return 0;
        }
        return self.leaf_count * 100 / self.node_count;
    }

    fn balanced(self) -> bool {
        return self.min_leaf_depth == self.max_leaf_depth;
    }

    fn record_sample(ref self, entry: pair(K, V)) {
        if (self.samples.size() < BTREE_SAMPLE_LIMIT) {
            self.samples.push_back(entry);
        }
    }

    // One `(depth, node count)` pair per level, in increasing depth order.
    fn level_widths(self) -> vector(pair(int, int)) {
        var out = vector(pair(int, int))();
        for (row in self.per_depth) {
            out.push_back(pair(int, int)({.first = row.first, .second = row.second}));
        }
        return out;
    }

    fn describe(self) -> string {
        var text = string();
        text.append("height=");
        text.append(to_string(self.height));
        text.append(" nodes=");
        text.append(to_string(self.node_count));
        text.append(" keys=");
        text.append(to_string(self.key_count));
        text.append(" fill=");
        text.append(to_string(self.average_occupancy()));
        return text;
    }

    var height: int = 0;
    var node_count: int = 0;
    var leaf_count: int = 0;
    var key_count: int = 0;
    var min_occupancy: int = 0;
    var max_occupancy: int = 0;
    var min_leaf_depth: int = 0;
    var max_leaf_depth: int = 0;
    var splits_seen: int = 0;
    var merges_seen: int = 0;
    var per_depth: vector(pair(int, int));
    var occupancy_histogram: vector(pair(int, int));
    var samples: vector(pair(K, V));
}

// --- Cursor ---------------------------------------------------------------

// A position inside a tree: the node, the slot within that node, and the full
// root-to-node path as `(node, child index)` pairs.  Predecessor and successor
// are both implemented on top of this.
class BTreeCursor(K: type, V: type, ORDER: int)
{

    fn valid(self) -> bool {
        return self.node != BTREE_NIL and self.slot >= 0;
    }

    fn depth(self) -> int {
        return self.path.size();
    }

    fn push_step(ref self, node: int, child: int) {
        self.path.push_back(pair(int, int)({.first = node, .second = child}));
    }

    fn pop_step(ref self) -> pair(int, int) {
        if (self.path.size() == 0) {
            return pair(int, int)({.first = BTREE_NIL, .second = -1});
        }
        let top = self.path.back();
        self.path.pop_back();
        return pair(int, int)({.first = top.first, .second = top.second});
    }

    fn parent_step(self) -> pair(int, int) {
        if (self.path.size() == 0) {
            return pair(int, int)({.first = BTREE_NIL, .second = -1});
        }
        return self.path[self.path.size() - 1];
    }

    fn invalidate(ref self) {
        self.node = BTREE_NIL;
        self.slot = -1;
        self.path.clear();
    }

    var node: int = -1;
    var slot: int = -1;
    var order: ScanOrder = ScanOrder.Ascending;
    var path: vector(pair(int, int));
    var pending: vector(pair(K, V));
}

// --- Tree -----------------------------------------------------------------

class BTree(K: type, V: type, ORDER: int)
{

    // --- Size and shape queries -------------------------------------------

    fn size(self) -> int {
        return self.count;
    }

    fn empty(self) -> bool {
        return self.count == 0;
    }

    fn order(self) -> int {
        return ORDER;
    }

    fn max_keys(self) -> int {
        return ORDER - 1;
    }

    fn min_keys(self) -> int {
        return ORDER / 2 - 1;
    }

    fn arena_size(self) -> int {
        return self.nodes.size();
    }

    fn is_nil(self, i: int) -> bool {
        return i == BTREE_NIL;
    }

    fn alive(self, i: int) -> bool {
        if (i == BTREE_NIL) {
            return false;
        }
        return self.nodes[i].live;
    }

    fn node_at(ref self, i: int) -> ref BTreeNode(K, V, ORDER) {
        return self.nodes[i];
    }

    fn root_node(ref self) -> ref BTreeNode(K, V, ORDER) {
        return self.nodes[self.root];
    }

    // --- Arena management --------------------------------------------------

    fn reserve(ref self, capacity: int) {
        self.nodes.reserve(capacity);
    }

    fn grow_if_needed(ref self) {
        if (self.nodes.size() >= self.nodes.capacity()) {
            let target = self.nodes.capacity() * BTREE_GROWTH_PERCENT / 100;
            if (target <= self.nodes.size()) {
                self.nodes.reserve(self.nodes.size() + BTREE_INITIAL_CAPACITY);
            } else {
                self.nodes.reserve(target);
            }
        }
    }

    // Hands back a fresh node, recycling a released slot when one exists.
    fn allocate_node(ref self, leaf: bool, depth: int) -> int {
        if (self.free_list != BTREE_NIL) {
            let recycled = self.free_list;
            self.free_list = self.nodes[recycled].parent;
            self.nodes[recycled].reset_slots();
            self.nodes[recycled].leaf = leaf;
            self.nodes[recycled].depth = depth;
            self.nodes[recycled].live = true;
            return recycled;
        }
        self.grow_if_needed();
        var fresh = BTreeNode(K, V, ORDER)({.leaf = leaf, .depth = depth});
        self.nodes.push_back(fresh);
        return self.nodes.size() - 1;
    }

    // Returns a node to the free list.  The free list threads itself through
    // the `parent` field, which is unused while a node is dead.
    fn release_node(ref self, i: int) {
        if (i == BTREE_NIL) {
            return;
        }
        self.nodes[i].reset_slots();
        self.nodes[i].live = false;
        self.nodes[i].parent = self.free_list;
        self.free_list = i;
    }

    fn set_parent(ref self, child: int, parent: int) {
        if (child != BTREE_NIL) {
            self.nodes[child].parent = parent;
        }
    }

    // Re-stamps `depth` on a whole subtree.  Called after a merge or a root
    // change, both of which move entire subtrees one level up or down.
    fn restamp_depths(ref self, start: int, depth: int) {
        if (start == BTREE_NIL) {
            return;
        }
        var stack = vector(pair(int, int))();
        stack.reserve(BTREE_MAX_HEIGHT);
        stack.push_back(pair(int, int)({.first = start, .second = depth}));
        while (stack.size() > 0) {
            let top = stack.back();
            stack.pop_back();
            self.nodes[top.first].depth = top.second;
            if (not self.nodes[top.first].leaf) {
                var c: int = 0;
                while (c <= self.nodes[top.first].count) {
                    let child = self.nodes[top.first].children[c];
                    if (child != BTREE_NIL) {
                        stack.push_back(pair(int, int)({.first = child, .second = top.second + 1}));
                    }
                    c += 1;
                }
            }
        }
        Destroy(stack);
    }

    // --- Search ------------------------------------------------------------

    // Search within a single node, delegated so callers can stay index-free.
    fn find_in_node(self, node: int, key: K) -> pair(int, bool) {
        if (node == BTREE_NIL) {
            return pair(int, bool)({.first = -1, .second = false});
        }
        return self.nodes[node].probe(key);
    }

    // Walks down the tree and returns `(node, slot)` for an exact hit, or
    // `(BTREE_NIL, -1)` when the key is absent.
    fn locate(self, key: K) -> pair(int, int) {
        var current = self.root;
        while (current != BTREE_NIL) {
            let hit = self.nodes[current].probe(key);
            if (hit.second) {
                return pair(int, int)({.first = current, .second = hit.first});
            }
            if (self.nodes[current].leaf) {
                return pair(int, int)({.first = BTREE_NIL, .second = -1});
            }
            current = self.nodes[current].children[hit.first];
        }
        return pair(int, int)({.first = BTREE_NIL, .second = -1});
    }

    // Same walk as `locate`, but recording every step so the caller can climb
    // back up afterwards.  This is what feeds `BTreeCursor`.
    fn locate_with_path(self, key: K) -> BTreeCursor(K, V, ORDER) {
        var cursor = BTreeCursor(K, V, ORDER)();
        var current = self.root;
        while (current != BTREE_NIL) {
            let hit = self.nodes[current].probe(key);
            if (hit.second) {
                cursor.node = current;
                cursor.slot = hit.first;
                return cursor;
            }
            if (self.nodes[current].leaf) {
                cursor.node = BTREE_NIL;
                cursor.slot = -1;
                return cursor;
            }
            cursor.push_step(current, hit.first);
            current = self.nodes[current].children[hit.first];
        }
        cursor.invalidate();
        return cursor;
    }

    fn contains(self, key: K) -> bool {
        let found = self.locate(key);
        return found.first != BTREE_NIL;
    }

    fn find(ref self, key: K) -> ref V {
        let found = self.locate(key);
        if (found.first == BTREE_NIL) {
            return self.missing;
        }
        return self.nodes[found.first].values[found.second];
    }

    // Depth at which `key` lives, or -1 when it is absent.  Cheap proxy for
    // "how many comparisons did that lookup cost".
    fn depth_of(self, key: K) -> int {
        var current = self.root;
        var depth: int = 0;
        while (current != BTREE_NIL) {
            let hit = self.nodes[current].probe(key);
            if (hit.second) {
                return depth;
            }
            if (self.nodes[current].leaf) {
                return -1;
            }
            current = self.nodes[current].children[hit.first];
            depth += 1;
        }
        return -1;
    }

    // --- Minimum and maximum ------------------------------------------------

    fn minimum_in(self, start: int) -> pair(int, int) {
        var current = start;
        while (current != BTREE_NIL) {
            if (self.nodes[current].leaf) {
                if (self.nodes[current].count == 0) {
                    return pair(int, int)({.first = BTREE_NIL, .second = -1});
                }
                return pair(int, int)({.first = current, .second = 0});
            }
            current = self.nodes[current].children[0];
        }
        return pair(int, int)({.first = BTREE_NIL, .second = -1});
    }

    fn maximum_in(self, start: int) -> pair(int, int) {
        var current = start;
        while (current != BTREE_NIL) {
            if (self.nodes[current].leaf) {
                if (self.nodes[current].count == 0) {
                    return pair(int, int)({.first = BTREE_NIL, .second = -1});
                }
                return pair(int, int)({.first = current, .second = self.nodes[current].count - 1});
            }
            current = self.nodes[current].children[self.nodes[current].count];
        }
        return pair(int, int)({.first = BTREE_NIL, .second = -1});
    }

    fn minimum(self) -> pair(int, int) {
        return self.minimum_in(self.root);
    }

    fn maximum(self) -> pair(int, int) {
        return self.maximum_in(self.root);
    }

    fn min_key(ref self) -> ref K {
        let at = self.minimum();
        if (at.first == BTREE_NIL) {
            return self.missing_key;
        }
        return self.nodes[at.first].keys[at.second];
    }

    fn max_key(ref self) -> ref K {
        let at = self.maximum();
        if (at.first == BTREE_NIL) {
            return self.missing_key;
        }
        return self.nodes[at.first].keys[at.second];
    }

    fn min_entry(self) -> pair(K, V) {
        let at = self.minimum();
        if (at.first == BTREE_NIL) {
            return pair(K, V)({.first = self.missing_key, .second = self.missing});
        }
        return self.nodes[at.first].entry_at(at.second);
    }

    fn max_entry(self) -> pair(K, V) {
        let at = self.maximum();
        if (at.first == BTREE_NIL) {
            return pair(K, V)({.first = self.missing_key, .second = self.missing});
        }
        return self.nodes[at.first].entry_at(at.second);
    }

    // --- Insertion ----------------------------------------------------------
    //
    // Proactive splitting: on the way down, any full node is split before it
    // is entered, which guarantees the node a new key lands in always has room
    // and removes the need to propagate a split upwards.

    // Splits `.nodes[parent].children[index]`, which must be full.  The median
    // key moves up into `parent` at slot `index`, and the upper half of the
    // child becomes a brand new sibling at `index + 1`.
    fn split_child(ref self, parent: int, index: int) -> int {
        let full = self.nodes[parent].children[index];
        let median = (ORDER - 1) / 2;
        let sibling = self.allocate_node(self.nodes[full].leaf, self.nodes[full].depth);

        // Move everything above the median into the new sibling.
        var i = median + 1;
        while (i < self.nodes[full].count) {
            self.nodes[sibling].push_entry(self.nodes[full].keys[i], self.nodes[full].values[i]);
            i += 1;
        }

        // Internal nodes carry one more child than they carry keys.
        if (not self.nodes[full].leaf) {
            var c = median + 1;
            while (c <= self.nodes[full].count) {
                let moved = self.nodes[full].children[c];
                self.nodes[sibling].children.push_back(moved);
                self.set_parent(moved, sibling);
                c += 1;
            }
            var trim = self.nodes[full].count;
            while (trim > median) {
                self.nodes[full].children.pop_back();
                trim -= 1;
            }
        }

        // The median itself is promoted, so the left half keeps `median` keys.
        let promoted_key = self.nodes[full].keys[median];
        let promoted_value = self.nodes[full].values[median];
        var drop = self.nodes[full].count;
        while (drop > median) {
            self.nodes[full].keys.pop_back();
            self.nodes[full].values.pop_back();
            drop -= 1;
        }
        self.nodes[full].count = median;

        self.nodes[parent].insert_entry_at(index, promoted_key, promoted_value);
        self.nodes[parent].insert_child_at(index + 1, sibling);
        self.set_parent(sibling, parent);
        self.set_parent(full, parent);
        self.splits += 1;
        return sibling;
    }

    // Grows the tree by one level.  Only ever called when the root is full.
    fn grow_root(ref self) -> int {
        let old_root = self.root;
        let fresh = self.allocate_node(false, 0);
        self.nodes[fresh].children.push_back(old_root);
        self.set_parent(old_root, fresh);
        self.root = fresh;
        self.restamp_depths(fresh, 0);
        let sibling = self.split_child(fresh, 0);
        Discard(sibling);
        self.height_hint += 1;
        return fresh;
    }

    // Inserts into a subtree whose root is known not to be full.
    fn insert_non_full(ref self, start: int, key: K, value: V) -> bool {
        var current = start;
        while (true) {
            let hit = self.nodes[current].probe(key);
            if (hit.second) {
                // Existing key: overwrite the mapped value in place.
                self.nodes[current].values[hit.first] = value;
                return false;
            }
            if (self.nodes[current].leaf) {
                self.nodes[current].insert_entry_at(hit.first, key, value);
                self.count += 1;
                return true;
            } else {
                var slot = hit.first;
                let child = self.nodes[current].children[slot];
                if (self.nodes[child].is_full()) {
                    let sibling = self.split_child(current, slot);
                    Discard(sibling);
                    // The promoted separator may itself be the key we want.
                    if (compare_keys(self.nodes[current].keys[slot], key) == 0) {
                        self.nodes[current].values[slot] = value;
                        return false;
                    }
                    if (compare_keys(key, self.nodes[current].keys[slot]) > 0) {
                        slot += 1;
                    }
                }
                current = self.nodes[current].children[slot];
            }
        }
    }

    fn insert(ref self, key: K, value: V) -> bool {
        if (self.root == BTREE_NIL) {
            self.root = self.allocate_node(true, 0);
            self.nodes[self.root].push_entry(key, value);
            self.count += 1;
            self.height_hint = 1;
            return true;
        }
        if (self.nodes[self.root].is_full()) {
            let grown = self.grow_root();
            Discard(grown);
        }
        return self.insert_non_full(self.root, key, value);
    }

    fn insert_pair(ref self, entry: pair(K, V)) -> bool {
        return self.insert(entry.first, entry.second);
    }

    // Inserts every element of a `vector{pair{K, V}}` and reports how many of
    // them were genuinely new keys.
    fn insert_all(ref self, entries: vector(pair(K, V))) -> int {
        var added: int = 0;
        for (entry in entries) {
            if (self.insert(entry.first, entry.second)) {
                added += 1;
            }
        }
        return added;
    }

    // Insert-or-append semantics for a multimap-flavoured tree whose values
    // are themselves vectors.
    fn append_value(ref self, key: K, value: V) -> bool {
        let found = self.locate(key);
        if (found.first == BTREE_NIL) {
            return self.insert(key, value);
        }
        self.nodes[found.first].values[found.second] = value;
        return false;
    }

    // --- Deletion -----------------------------------------------------------
    //
    // Deletion is the mirror image of insertion: on the way down, any child
    // that is already minimal is refilled *before* it is entered, so the node
    // a key is finally removed from always has a key to spare.

    // Moves the parent separator at `index - 1` down into child `index` and
    // pulls the left sibling's last key up to replace it.
    fn borrow_from_left(ref self, parent: int, index: int) {
        let child = self.nodes[parent].children[index];
        let left = self.nodes[parent].children[index - 1];

        // Separator comes down to the front of the child.
        self.nodes[child].insert_entry_at(0, self.nodes[parent].keys[index - 1],
                                      self.nodes[parent].values[index - 1]);

        // The left sibling's last key goes up into the separator slot.
        let lifted = self.nodes[left].pop_entry();
        self.nodes[parent].keys[index - 1] = lifted.first;
        self.nodes[parent].values[index - 1] = lifted.second;

        // Internal nodes also hand over the corresponding child pointer.
        if (not self.nodes[child].leaf) {
            let moved = self.nodes[left].children[self.nodes[left].count + 1];
            self.nodes[left].children.pop_back();
            self.nodes[child].insert_child_at(0, moved);
            self.set_parent(moved, child);
            self.restamp_depths(moved, self.nodes[child].depth + 1);
        }
        self.borrows += 1;
    }

    // The symmetric operation on the right-hand sibling.
    fn borrow_from_right(ref self, parent: int, index: int) {
        let child = self.nodes[parent].children[index];
        let right = self.nodes[parent].children[index + 1];

        // Separator comes down to the back of the child.
        self.nodes[child].push_entry(self.nodes[parent].keys[index], self.nodes[parent].values[index]);

        // The right sibling's first key goes up into the separator slot.
        let lifted = self.nodes[right].remove_entry_at(0);
        self.nodes[parent].keys[index] = lifted.first;
        self.nodes[parent].values[index] = lifted.second;

        if (not self.nodes[child].leaf) {
            let moved = self.nodes[right].remove_child_at(0);
            self.nodes[child].children.push_back(moved);
            self.set_parent(moved, child);
            self.restamp_depths(moved, self.nodes[child].depth + 1);
        }
        self.borrows += 1;
    }

    // Folds child `index + 1` into child `index`, pulling the separator at
    // `index` down between them.  The right-hand child is released.
    fn merge_children(ref self, parent: int, index: int) -> int {
        let left = self.nodes[parent].children[index];
        let right = self.nodes[parent].children[index + 1];

        // The separator becomes the first of the merged keys.
        let separator = self.nodes[parent].remove_entry_at(index);
        self.nodes[left].push_entry(separator.first, separator.second);

        // Then everything the right sibling was holding.
        var i: int = 0;
        while (i < self.nodes[right].count) {
            self.nodes[left].push_entry(self.nodes[right].keys[i], self.nodes[right].values[i]);
            i += 1;
        }

        if (not self.nodes[right].leaf) {
            var c: int = 0;
            while (c <= self.nodes[right].count) {
                let moved = self.nodes[right].children[c];
                if (moved != BTREE_NIL) {
                    self.nodes[left].children.push_back(moved);
                    self.set_parent(moved, left);
                    self.restamp_depths(moved, self.nodes[left].depth + 1);
                }
                c += 1;
            }
        }

        // Drop the now-empty right child from the parent's child array.
        let dropped = self.nodes[parent].remove_child_at(index + 1);
        Discard(dropped);
        self.release_node(right);
        self.merges += 1;

        // Merging away the last separator of the root shrinks the tree.
        if (parent == self.root and self.nodes[parent].count == 0) {
            self.release_node(self.root);
            self.root = left;
            self.set_parent(left, BTREE_NIL);
            self.restamp_depths(left, 0);
            if (self.height_hint > 0) {
                self.height_hint -= 1;
            }
        }
        return left;
    }

    // Guarantees child `index` has more than the minimum number of keys, by
    // borrowing from whichever sibling can spare one and merging otherwise.
    // Returns both the action taken and the index the child now lives at.
    fn fill_child(ref self, parent: int, index: int) -> pair(RebalanceAction, int) {
        let child = self.nodes[parent].children[index];
        if (self.nodes[child].has_spare_key()) {
            return pair(RebalanceAction, int)({.first = RebalanceAction.NoActionNeeded,
                                              .second = index});
        }

        if (index > 0) {
            let left = self.nodes[parent].children[index - 1];
            if (self.nodes[left].has_spare_key()) {
                self.borrow_from_left(parent, index);
                return pair(RebalanceAction, int)({.first = RebalanceAction.BorrowedFromLeft,
                                                  .second = index});
            } else {
                if (index < self.nodes[parent].count) {
                    let right = self.nodes[parent].children[index + 1];
                    if (self.nodes[right].has_spare_key()) {
                        self.borrow_from_right(parent, index);
                        return pair(RebalanceAction, int)({
                            .first = RebalanceAction.BorrowedFromRight, .second = index});
                    } else {
                        // Neither sibling can spare a key, so merge with the
                        // left one; the child slides one slot to the left.
                        let merged = self.merge_children(parent, index - 1);
                        Discard(merged);
                        return pair(RebalanceAction, int)({
                            .first = RebalanceAction.MergedWithLeft, .second = index - 1});
                    }
                } else {
                    let merged = self.merge_children(parent, index - 1);
                    Discard(merged);
                    return pair(RebalanceAction, int)({
                        .first = RebalanceAction.MergedWithLeft, .second = index - 1});
                }
            }
        } else {
            // Leftmost child: the right sibling is the only candidate.
            if (index < self.nodes[parent].count) {
                let right = self.nodes[parent].children[index + 1];
                if (self.nodes[right].has_spare_key()) {
                    self.borrow_from_right(parent, index);
                    return pair(RebalanceAction, int)({
                        .first = RebalanceAction.BorrowedFromRight, .second = index});
                } else {
                    let merged = self.merge_children(parent, index);
                    Discard(merged);
                    return pair(RebalanceAction, int)({
                        .first = RebalanceAction.MergedWithRight, .second = index});
                }
            } else {
                return pair(RebalanceAction, int)({.first = RebalanceAction.NoActionNeeded,
                                                  .second = index});
            }
        }
    }

    // Removes slot `slot` of a leaf.  The caller has already ensured the leaf
    // is either the root or holds more than the minimum number of keys.
    fn remove_from_leaf(ref self, node: int, slot: int) -> pair(K, V) {
        let taken = self.nodes[node].remove_entry_at(slot);
        self.count -= 1;
        return taken;
    }

    // Removes slot `slot` of an internal node by replacing it with either its
    // in-order predecessor or its in-order successor, whichever comes from the
    // side that can afford to lose a key, then deleting that key recursively.
    fn remove_from_branch(ref self, node: int, slot: int) -> bool {
        let left = self.nodes[node].children[slot];
        let right = self.nodes[node].children[slot + 1];

        if (self.nodes[left].has_spare_key()) {
            let at = self.maximum_in(left);
            let replacement = self.nodes[at.first].entry_at(at.second);
            self.nodes[node].keys[slot] = replacement.first;
            self.nodes[node].values[slot] = replacement.second;
            return self.erase_from(left, replacement.first);
        } else {
            if (self.nodes[right].has_spare_key()) {
                let at = self.minimum_in(right);
                let replacement = self.nodes[at.first].entry_at(at.second);
                self.nodes[node].keys[slot] = replacement.first;
                self.nodes[node].values[slot] = replacement.second;
                return self.erase_from(right, replacement.first);
            } else {
                // Both children are minimal: fold them together and delete the
                // key from the merged node instead.
                let doomed_key = self.nodes[node].keys[slot];
                let merged = self.merge_children(node, slot);
                return self.erase_from(merged, doomed_key);
            }
        }
    }

    // Deletes `key` from the subtree rooted at `start`, refilling children on
    // the way down so no node ever underflows behind us.
    fn erase_from(ref self, start: int, key: K) -> bool {
        var current = start;
        while (true) {
            if (current == BTREE_NIL) {
                return false;
            }
            let hit = self.nodes[current].probe(key);
            if (hit.second) {
                if (self.nodes[current].leaf) {
                    let taken = self.remove_from_leaf(current, hit.first);
                    Discard(taken);
                    return true;
                } else {
                    return self.remove_from_branch(current, hit.first);
                }
            }
            if (self.nodes[current].leaf) {
                return false;
            }
            var slot = hit.first;
            let child = self.nodes[current].children[slot];
            if (self.nodes[child].is_minimal()) {
                let action = self.fill_child(current, slot);
                slot = action.second;
                if (action.first == RebalanceAction.MergedWithLeft) {
                    // The merge may have collapsed the root beneath us.
                    if (self.nodes[current].count == 0 and current == self.root) {
                        current = self.root;
                        slot = 0;
                    }
                }
                if (slot > self.nodes[current].count) {
                    slot = self.nodes[current].count;
                }
            }
            current = self.nodes[current].children[slot];
        }
    }

    fn erase(ref self, key: K) -> bool {
        if (self.root == BTREE_NIL) {
            return false;
        }
        let removed = self.erase_from(self.root, key);
        if (self.root != BTREE_NIL) {
            if (self.nodes[self.root].count == 0 and self.nodes[self.root].leaf) {
                self.release_node(self.root);
                self.root = BTREE_NIL;
                self.height_hint = 0;
            }
        }
        return removed;
    }

    fn erase_min(ref self) -> pair(K, V) {
        let at = self.minimum();
        if (at.first == BTREE_NIL) {
            return pair(K, V)({.first = self.missing_key, .second = self.missing});
        }
        let entry = self.nodes[at.first].entry_at(at.second);
        Discard(self.erase(entry.first));
        return entry;
    }

    fn erase_max(ref self) -> pair(K, V) {
        let at = self.maximum();
        if (at.first == BTREE_NIL) {
            return pair(K, V)({.first = self.missing_key, .second = self.missing});
        }
        let entry = self.nodes[at.first].entry_at(at.second);
        Discard(self.erase(entry.first));
        return entry;
    }

    // --- Predecessor and successor ------------------------------------------
    //
    // Both walk down to the key first, recording the path, and then either
    // dive into the neighbouring subtree or climb back up until the step they
    // came from was not the extreme child.

    fn predecessor(self, key: K) -> pair(K, V) {
        var cursor = self.locate_with_path(key);
        if (not cursor.valid()) {
            // The key is absent: fall back to the largest key below it.
            return self.largest_below(key);
        }
        if (not self.nodes[cursor.node].leaf) {
            let at = self.maximum_in(self.nodes[cursor.node].children[cursor.slot]);
            if (at.first != BTREE_NIL) {
                return self.nodes[at.first].entry_at(at.second);
            }
        }
        if (cursor.slot > 0) {
            return self.nodes[cursor.node].entry_at(cursor.slot - 1);
        }
        // Climb: the predecessor is the separator left of the child we
        // descended through, at the first level where that index was non-zero.
        while (cursor.depth() > 0) {
            let step = cursor.pop_step();
            if (step.second > 0) {
                return self.nodes[step.first].entry_at(step.second - 1);
            }
        }
        return pair(K, V)({.first = self.missing_key, .second = self.missing});
    }

    fn successor(self, key: K) -> pair(K, V) {
        var cursor = self.locate_with_path(key);
        if (not cursor.valid()) {
            return self.smallest_above(key);
        }
        if (not self.nodes[cursor.node].leaf) {
            let at = self.minimum_in(self.nodes[cursor.node].children[cursor.slot + 1]);
            if (at.first != BTREE_NIL) {
                return self.nodes[at.first].entry_at(at.second);
            }
        }
        if (cursor.slot + 1 < self.nodes[cursor.node].count) {
            return self.nodes[cursor.node].entry_at(cursor.slot + 1);
        }
        while (cursor.depth() > 0) {
            let step = cursor.pop_step();
            if (step.second < self.nodes[step.first].count) {
                return self.nodes[step.first].entry_at(step.second);
            }
        }
        return pair(K, V)({.first = self.missing_key, .second = self.missing});
    }

    // Largest key strictly smaller than `key`, for keys that are not present.
    fn largest_below(self, key: K) -> pair(K, V) {
        var current = self.root;
        var best = pair(K, V)({.first = self.missing_key, .second = self.missing});
        var found: bool = false;
        while (current != BTREE_NIL) {
            let slot = self.nodes[current].lower_bound(key);
            if (slot > 0) {
                best = self.nodes[current].entry_at(slot - 1);
                found = true;
            }
            if (self.nodes[current].leaf) {
                current = BTREE_NIL;
            } else {
                current = self.nodes[current].children[slot];
            }
        }
        if (not found) {
            return pair(K, V)({.first = self.missing_key, .second = self.missing});
        }
        return best;
    }

    // Smallest key strictly greater than `key`.
    fn smallest_above(self, key: K) -> pair(K, V) {
        var current = self.root;
        var best = pair(K, V)({.first = self.missing_key, .second = self.missing});
        var found: bool = false;
        while (current != BTREE_NIL) {
            let slot = self.nodes[current].upper_bound(key);
            if (slot < self.nodes[current].count) {
                best = self.nodes[current].entry_at(slot);
                found = true;
            }
            if (self.nodes[current].leaf) {
                current = BTREE_NIL;
            } else {
                current = self.nodes[current].children[slot];
            }
        }
        if (not found) {
            return pair(K, V)({.first = self.missing_key, .second = self.missing});
        }
        return best;
    }

    // --- Traversal ------------------------------------------------------------
    //
    // The in-order walk keeps an explicit `(node, child index)` stack instead
    // of recursing, which bounds the stack depth by BTREE_MAX_HEIGHT and makes
    // the ordering of the interleaved key/child visits obvious.

    fn in_order(self, ref out: vector(pair(K, V))) {
        if (self.root == BTREE_NIL) {
            return;
        }
        var stack = vector(pair(int, int))();
        stack.reserve(BTREE_MAX_HEIGHT);
        stack.push_back(pair(int, int)({.first = self.root, .second = 0}));
        while (stack.size() > 0) {
            let top = stack.back();
            stack.pop_back();
            let node = top.first;
            let step = top.second;
            if (self.nodes[node].leaf) {
                var i: int = 0;
                while (i < self.nodes[node].count) {
                    out.push_back(self.nodes[node].entry_at(i));
                    i += 1;
                }
            } else {
                if (step <= self.nodes[node].count) {
                    // Come back to this node once the child has been walked.
                    stack.push_back(pair(int, int)({.first = node, .second = step + 1}));
                    if (step > 0) {
                        // Emit the separator that precedes the upcoming child.
                        out.push_back(self.nodes[node].entry_at(step - 1));
                    }
                    let child = self.nodes[node].children[step];
                    if (child != BTREE_NIL) {
                        stack.push_back(pair(int, int)({.first = child, .second = 0}));
                    }
                }
            }
        }
        Destroy(stack);
    }

    fn keys_in_order(self, ref out: vector(K)) {
        var entries = vector(pair(K, V))();
        self.in_order(entries);
        for (entry in entries) {
            out.push_back(entry.first);
        }
        Destroy(entries);
    }

    fn values_in_order(self, ref out: vector(V)) {
        var entries = vector(pair(K, V))();
        self.in_order(entries);
        for (entry in entries) {
            out.push_back(entry.second);
        }
        Destroy(entries);
    }

    fn to_pairs(self) -> vector(pair(K, V)) {
        var out = vector(pair(K, V))();
        out.reserve(self.count);
        self.in_order(out);
        return out;
    }

    // Level order, returned as one `vector{int}` of node indices per level.
    fn level_order(self) -> vector(vector(int)) {
        var levels = vector(vector(int))();
        if (self.root == BTREE_NIL) {
            return levels;
        }
        var frontier = vector(int)();
        frontier.push_back(self.root);
        while (frontier.size() > 0) {
            var next = vector(int)();
            var row = vector(int)();
            for (node in frontier) {
                row.push_back(node);
                if (not self.nodes[node].leaf) {
                    var c: int = 0;
                    while (c <= self.nodes[node].count) {
                        let child = self.nodes[node].children[c];
                        if (child != BTREE_NIL) {
                            next.push_back(child);
                        }
                        c += 1;
                    }
                }
            }
            levels.push_back(row);
            frontier = next;
        }
        return levels;
    }

    // Every leaf, left to right.
    fn leaves(self) -> vector(int) {
        var out = vector(int)();
        if (self.root == BTREE_NIL) {
            return out;
        }
        var stack = vector(int)();
        stack.reserve(BTREE_MAX_HEIGHT);
        stack.push_back(self.root);
        while (stack.size() > 0) {
            let node = stack.back();
            stack.pop_back();
            if (self.nodes[node].leaf) {
                out.push_back(node);
            } else {
                var c = self.nodes[node].count;
                while (c >= 0) {
                    let child = self.nodes[node].children[c];
                    if (child != BTREE_NIL) {
                        stack.push_back(child);
                    }
                    c -= 1;
                }
            }
        }
        Destroy(stack);
        return out;
    }

    // --- Range queries --------------------------------------------------------

    // Collects every entry whose key lies in the half-open range
    // `[low, high)`.  The walk prunes any subtree that cannot intersect the
    // range, which is the whole point of doing it on the tree rather than on
    // the flattened `to_pairs()` output.
    fn range_query(self, low: K, high: K,
                   ref out: vector(pair(K, V))) -> int {
        if (self.root == BTREE_NIL) {
            return 0;
        }
        var emitted: int = 0;
        var stack = vector(int)();
        stack.reserve(BTREE_MAX_HEIGHT);
        stack.push_back(self.root);
        while (stack.size() > 0) {
            let node = stack.back();
            stack.pop_back();
            let first = self.nodes[node].lower_bound(low);
            var i = first;
            while (i < self.nodes[node].count) {
                if (compare_keys(self.nodes[node].keys[i], *high) >= 0) {
                    i = self.nodes[node].count;
                } else {
                    out.push_back(self.nodes[node].entry_at(i));
                    emitted += 1;
                    i += 1;
                }
            }
            if (not self.nodes[node].leaf) {
                let last = self.nodes[node].upper_bound(high);
                var c = first;
                while (c <= last) {
                    if (c <= self.nodes[node].count) {
                        let child = self.nodes[node].children[c];
                        if (child != BTREE_NIL) {
                            stack.push_back(child);
                        }
                    }
                    c += 1;
                }
            }
        }
        Destroy(stack);
        return emitted;
    }

    // How many keys fall in `[low, high)`, without materialising them.
    fn count_range(self, low: K, high: K) -> int {
        var scratch = vector(pair(K, V))();
        let total = self.range_query(low, high, scratch);
        Destroy(scratch);
        return total;
    }

    // Range query that buckets its results by the leaf they came from, giving
    // one `vector{pair{K, V}}` per leaf index.
    fn range_by_leaf(self, low: K,
                     high: K) -> map(int, vector(pair(K, V))) {
        var buckets = map(int, vector(pair(K, V)))();
        let leaf_list = self.leaves();
        for (leaf in leaf_list) {
            var row = vector(pair(K, V))();
            var i: int = 0;
            while (i < self.nodes[leaf].count) {
                let entry = self.nodes[leaf].entry_at(i);
                if (compare_keys(entry.first, *low) >= 0 and
                   compare_keys(entry.first, *high) < 0) {
                    row.push_back(entry);
                }
                i += 1;
            }
            if (row.size() > 0) {
                Discard(buckets.insert(leaf, row));
            }
            Destroy(row);
        }
        return buckets;
    }

    // Every key in the range, grouped under the separator key of the subtree
    // it was found in.  Deliberately built as a
    // `map{K, vector{pair{K, vector{V}}}}` to exercise nested value types.
    fn range_grouped(self, low: K,
                     high: K) -> map(K, vector(pair(K, vector(V)))) {
        var grouped = map(K, vector(pair(K, vector(V))))();
        var hits = vector(pair(K, V))();
        let total = self.range_query(low, high, hits);
        if (total == 0) {
            Destroy(hits);
            return grouped;
        }
        var current_group = vector(pair(K, vector(V)))();
        var group_key = hits[0].first;
        var index: int = 0;
        while (index < hits.size()) {
            let entry = hits[index];
            var bag = vector(V)();
            bag.push_back(entry.second);
            current_group.push_back(pair(K, vector(V))({.first = entry.first, .second = bag}));
            if (current_group.size() >= ORDER - 1) {
                Discard(grouped.insert(group_key, current_group));
                current_group.clear();
                if (index + 1 < hits.size()) {
                    group_key = hits[index + 1].first;
                }
            }
            Destroy(bag);
            index += 1;
        }
        if (current_group.size() > 0) {
            Discard(grouped.insert(group_key, current_group));
        }
        Destroy(current_group);
        Destroy(hits);
        return grouped;
    }

    // Classic lower/upper bound over the whole tree rather than one node.
    fn lower_bound(self, key: K) -> pair(K, V) {
        let found = self.locate(key);
        if (found.first != BTREE_NIL) {
            return self.nodes[found.first].entry_at(found.second);
        }
        return self.smallest_above(key);
    }

    fn upper_bound(self, key: K) -> pair(K, V) {
        return self.smallest_above(key);
    }

    // --- Bulk loading ---------------------------------------------------------
    //
    // Building bottom-up from an already sorted input is much cheaper than
    // repeated insertion: each level is packed to `BTREE_BULK_FILL_PERCENT` of
    // capacity and then the separators are lifted into a freshly built parent
    // level, repeating until a single node remains.

    fn bulk_fill_width(self) -> int {
        let width = (ORDER - 1) * BTREE_BULK_FILL_PERCENT / 100;
        if (width < 1) {
            return 1;
        }
        return width;
    }

    // Packs a sorted run of entries into a row of leaves, returning the leaf
    // indices together with the separator that must sit above each gap.
    fn build_leaf_level(ref self, sorted: vector(pair(K, V)),
                        ref out_separators: vector(pair(K, V))) -> vector(int) {
        var level = vector(int)();
        let width = self.bulk_fill_width();
        var index: int = 0;
        while (index < sorted.size()) {
            let leaf = self.allocate_node(true, 0);
            var packed: int = 0;
            while (packed < width and index < sorted.size()) {
                self.nodes[leaf].push_pair(sorted[index]);
                self.count += 1;
                packed += 1;
                index += 1;
            }
            level.push_back(leaf);
            // The next entry becomes the separator between this leaf and the
            // one that follows it, unless the input is exhausted.
            if (index < sorted.size()) {
                out_separators.push_back(sorted[index]);
                index += 1;
            }
        }
        return level;
    }

    // Lifts one finished level into the level above it.
    fn build_branch_level(ref self, children: vector(int),
                          separators: vector(pair(K, V)),
                          ref out_separators: vector(pair(K, V))) -> vector(int) {
        var level = vector(int)();
        let width = self.bulk_fill_width();
        var index: int = 0;
        var sep_index: int = 0;
        while (index < children.size()) {
            let branch = self.allocate_node(false, 0);
            self.nodes[branch].children.push_back(children[index]);
            self.set_parent(children[index], branch);
            index += 1;
            var packed: int = 0;
            while (packed < width and index < children.size()) {
                if (sep_index < separators.size()) {
                    self.nodes[branch].push_pair(separators[sep_index]);
                    sep_index += 1;
                }
                self.nodes[branch].children.push_back(children[index]);
                self.set_parent(children[index], branch);
                packed += 1;
                index += 1;
            }
            level.push_back(branch);
            // One separator is consumed by the gap between two branch nodes.
            if (index < children.size() and sep_index < separators.size()) {
                out_separators.push_back(separators[sep_index]);
                sep_index += 1;
            }
        }
        return level;
    }

    // Replaces the whole tree with one built from `sorted`, which must already
    // be in increasing key order.
    fn bulk_load(ref self, sorted: vector(pair(K, V))) -> bool {
        self.clear();
        if (sorted.size() == 0) {
            return true;
        }
        var separators = vector(pair(K, V))();
        var level = self.build_leaf_level(sorted, separators);
        var depth: int = 1;
        while (level.size() > 1) {
            var next_separators = vector(pair(K, V))();
            let parents = self.build_branch_level(level, separators, next_separators);
            separators = next_separators;
            level = parents;
            depth += 1;
            if (depth > BTREE_MAX_HEIGHT) {
                // Defensive stop; a correctly shrinking level list can never
                // reach this, but bailing out beats looping forever.
                panic("bulk load exceeded the maximum supported height");
            }
            Destroy(next_separators);
        }
        self.root = level[0];
        self.set_parent(self.root, BTREE_NIL);
        self.restamp_depths(self.root, 0);
        self.height_hint = depth;
        Destroy(separators);
        Destroy(level);
        return true;
    }

    // Convenience wrapper: sort-free rebuild from the tree's own contents,
    // used after a long run of deletions has left the tree sparse.
    fn compact(ref self) -> bool {
        var entries = self.to_pairs();
        let ok = self.bulk_load(entries);
        Destroy(entries);
        return ok;
    }

    // --- Height and occupancy statistics -------------------------------------

    fn height(self) -> int {
        if (self.root == BTREE_NIL) {
            return 0;
        }
        var current = self.root;
        var levels: int = 0;
        while (current != BTREE_NIL) {
            levels += 1;
            if (self.nodes[current].leaf) {
                current = BTREE_NIL;
            } else {
                current = self.nodes[current].children[0];
            }
        }
        return levels;
    }

    // Depth of every leaf, which rule 4 says must all be equal.
    fn leaf_depths(self) -> vector(pair(int, int)) {
        var out = vector(pair(int, int))();
        if (self.root == BTREE_NIL) {
            return out;
        }
        var stack = vector(pair(int, int))();
        stack.reserve(BTREE_MAX_HEIGHT);
        stack.push_back(pair(int, int)({.first = self.root, .second = 0}));
        while (stack.size() > 0) {
            let top = stack.back();
            stack.pop_back();
            if (self.nodes[top.first].leaf) {
                out.push_back(pair(int, int)({.first = top.first, .second = top.second}));
            } else {
                var c: int = 0;
                while (c <= self.nodes[top.first].count) {
                    let child = self.nodes[top.first].children[c];
                    if (child != BTREE_NIL) {
                        stack.push_back(pair(int, int)({.first = child, .second = top.second + 1}));
                    }
                    c += 1;
                }
            }
        }
        Destroy(stack);
        return out;
    }

    // One `(occupancy, node count)` bucket per distinct key count seen.
    fn occupancy_histogram(self) -> vector(pair(int, int)) {
        var buckets = vector(pair(int, int))();
        var slot: int = 0;
        while (slot < ORDER) {
            buckets.push_back(pair(int, int)({.first = slot, .second = 0}));
            slot += 1;
        }
        let levels = self.level_order();
        for (row in levels) {
            for (node in row) {
                let filled = self.nodes[node].count;
                if (filled >= 0 and filled < buckets.size()) {
                    buckets[filled].second += 1;
                }
            }
        }
        return buckets;
    }

    // Single pass collecting everything `BTreeStats` reports.
    fn statistics(self) -> BTreeStats(K, V) {
        var stats = BTreeStats(K, V)();
        stats.splits_seen = self.splits;
        stats.merges_seen = self.merges;
        if (self.root == BTREE_NIL) {
            return stats;
        }

        let levels = self.level_order();
        stats.height = levels.size();
        var depth: int = 0;
        var lowest = ORDER;
        var highest: int = 0;
        while (depth < levels.size()) {
            let row = levels[depth];
            var row_keys: int = 0;
            for (node in row) {
                stats.node_count += 1;
                row_keys += self.nodes[node].count;
                stats.key_count += self.nodes[node].count;
                if (self.nodes[node].leaf) {
                    stats.leaf_count += 1;
                }
                if (self.nodes[node].count < lowest) {
                    lowest = self.nodes[node].count;
                }
                if (self.nodes[node].count > highest) {
                    highest = self.nodes[node].count;
                }
            }
            stats.per_depth.push_back(pair(int, int)({.first = depth, .second = row.size()}));
            depth += 1;
        }
        stats.min_occupancy = lowest;
        stats.max_occupancy = highest;

        let depths = self.leaf_depths();
        var shallowest = BTREE_MAX_HEIGHT;
        var deepest: int = 0;
        for (row in depths) {
            if (row.second < shallowest) {
                shallowest = row.second;
            }
            if (row.second > deepest) {
                deepest = row.second;
            }
        }
        stats.min_leaf_depth = shallowest;
        stats.max_leaf_depth = deepest;
        stats.occupancy_histogram = self.occupancy_histogram();

        // A handful of entries for eyeballing in a debugger.
        var entries = vector(pair(K, V))();
        self.in_order(entries);
        var taken: int = 0;
        while (taken < entries.size() and taken < BTREE_SAMPLE_LIMIT) {
            stats.record_sample(entries[taken]);
            taken += 1;
        }
        Destroy(entries);
        return stats;
    }

    // --- Validity -------------------------------------------------------------
    //
    // Every B-tree rule from the file header is restated here as an explicit
    // proposition so the verifier can reason about it directly.

    fn check_node_ordering(self, node: int) -> bool {
        var i: int = 1;
        while (i < self.nodes[node].count) {
            // Rule 1: keys inside a node strictly increase.
            Assert(compare_keys(self.nodes[node].keys[i - 1], self.nodes[node].keys[i]) < 0);
            Prove(compare_keys(self.nodes[node].keys[i - 1], self.nodes[node].keys[i]) < 0);
            i += 1;
        }
        return true;
    }

    fn check_node_arity(self, node: int) -> bool {
        // Rule 2: a node has either no children at all or exactly one more
        // child than it has keys.
        if (self.nodes[node].leaf) {
            Assert(self.nodes[node].children.size() == 0);
            Prove(self.nodes[node].child_count() == 0);
        } else {
            Assert(self.nodes[node].children.size() == self.nodes[node].count + 1);
            Prove(self.nodes[node].child_count() == self.nodes[node].key_count() + 1);
        }
        return true;
    }

    fn check_occupancy(self, node: int) -> bool {
        // Rule 3: occupancy bounds, relaxed for the root.
        Assert(self.nodes[node].count <= ORDER - 1);
        Prove(self.nodes[node].count <= self.nodes[node].max_keys());
        if (node == self.root) {
            Assert(self.nodes[node].count >= 1 or self.count == 0);
        } else {
            Assert(self.nodes[node].count >= ORDER / 2 - 1);
            Prove(self.nodes[node].count >= self.nodes[node].min_keys());
        }
        return true;
    }

    fn check_separator_bounds(self, node: int) -> bool {
        if (self.nodes[node].leaf) {
            return true;
        }
        var slot: int = 0;
        while (slot <= self.nodes[node].count) {
            let child = self.nodes[node].children[slot];
            Assert(child != BTREE_NIL);
            Assert(self.nodes[child].parent == node);
            Assert(self.nodes[child].depth == self.nodes[node].depth + 1);

            // Rule 5: the subtree below child `slot` sits strictly between the
            // separators on either side of it.
            if (slot > 0) {
                let lower = self.nodes[node].keys[slot - 1];
                let least = self.minimum_in(child);
                if (least.first != BTREE_NIL) {
                    Assert(compare_keys(lower, self.nodes[least.first].keys[least.second]) < 0);
                    Prove(compare_keys(lower, self.nodes[least.first].keys[least.second]) < 0);
                }
            }
            if (slot < self.nodes[node].count) {
                let upper = self.nodes[node].keys[slot];
                let greatest = self.maximum_in(child);
                if (greatest.first != BTREE_NIL) {
                    Assert(compare_keys(self.nodes[greatest.first].keys[greatest.second],
                                        upper) < 0);
                    Prove(compare_keys(self.nodes[greatest.first].keys[greatest.second],
                                       upper) < 0);
                }
            }
            slot += 1;
        }
        return true;
    }

    fn check_validity(self) -> bool {
        Assert(self.count >= 0);
        Assert(self.count <= self.nodes.size() * (ORDER - 1));
        Assert(ORDER >= 3);

        if (self.root == BTREE_NIL) {
            // An empty tree trivially satisfies every rule.
            Assert(self.count == 0);
            Prove(self.count == 0);
            return true;
        }

        Assert(self.nodes[self.root].live);
        Assert(self.nodes[self.root].parent == BTREE_NIL);
        Assert(self.nodes[self.root].depth == 0);
        Prove(self.nodes[self.root].parent == BTREE_NIL);

        let levels = self.level_order();
        var depth: int = 0;
        while (depth < levels.size()) {
            let row = levels[depth];
            for (node in row) {
                Assert(self.nodes[node].live);
                Assert(self.nodes[node].depth == depth);
                Discard(self.check_node_ordering(node));
                Discard(self.check_node_arity(node));
                Discard(self.check_occupancy(node));
                Discard(self.check_separator_bounds(node));
            }
            depth += 1;
        }

        // Rule 4: every leaf sits at the same depth.
        let depths = self.leaf_depths();
        Assert(depths.size() > 0);
        var index: int = 1;
        while (index < depths.size()) {
            Assert(depths[index].second == depths[0].second);
            Prove(depths[index].second == depths[0].second);
            index += 1;
        }
        Prove(depths.size() > 0);

        // The in-order walk must be strictly increasing and must visit every
        // live key exactly once.
        var entries = vector(pair(K, V))();
        self.in_order(entries);
        Assert(entries.size() == self.count);
        Prove(entries.size() == self.count);
        var walk: int = 1;
        while (walk < entries.size()) {
            Assert(compare_keys(entries[walk - 1].first, entries[walk].first) < 0);
            Prove(compare_keys(entries[walk - 1].first, entries[walk].first) < 0);
            walk += 1;
        }
        Destroy(entries);

        // Height bound: a tree of `count` keys and branching factor ORDER can
        // be no taller than log base (ORDER / 2) of the key count.
        let measured = self.height();
        Assert(measured > 0);
        Assert(measured <= BTREE_MAX_HEIGHT);
        Prove(measured <= BTREE_MAX_HEIGHT);
        return true;
    }

    // --- Wholesale operations -------------------------------------------------

    fn clear(ref self) {
        for (node in self.nodes) {
            node.reset_slots();
            node.live = false;
        }
        self.nodes.clear();
        self.root = BTREE_NIL;
        self.free_list = BTREE_NIL;
        self.count = 0;
        self.height_hint = 0;
        self.splits = 0;
        self.merges = 0;
        self.borrows = 0;
    }

    fn copy_into(self, ref target: BTree(K, V, ORDER)) -> int {
        var entries = self.to_pairs();
        let added = target.insert_all(entries);
        Destroy(entries);
        return added;
    }

    var nodes: vector(BTreeNode(K, V, ORDER));
    var overflow: map(K, vector(pair(K, V)));
    var pending: vector(pair(K, vector(V)));
    var root: int = -1;
    var free_list: int = -1;
    var count: int = 0;
    var height_hint: int = 0;
    var splits: int = 0;
    var merges: int = 0;
    var borrows: int = 0;
    var missing: V;
    var missing_key: K;
}

// --- Free functions ---------------------------------------------------------

// Three-way comparison used by every ordered operation above.  Free rather
// than a method so it can be specialised per key type without touching the
// container.
fn compare_keys[T: type]
    (a: T, b: T) -> int {
    if (a < b) {
        return -1;
    } else {
        if (b < a) {
            return 1;
        } else {
            return 0;
        }
    }
}

// True when `entries` is sorted strictly increasing, which is the precondition
// `bulk_load` relies on.
fn is_sorted_by_key[K: type, V: type]
    (entries: vector(pair(K, V))) -> bool {
    var i: int = 1;
    while (i < entries.size()) {
        if (compare_keys(entries[i - 1].first, entries[i].first) >= 0) {
            return false;
        }
        i += 1;
    }
    return true;
}

// Merge of two sorted `vector{pair{K, V}}` runs, dropping duplicates in favour
// of the left-hand side.  Used to prepare input for `bulk_load`.
fn merge_sorted[K: type, V: type]
    (left: vector(pair(K, V)),
                right: vector(pair(K, V))) -> vector(pair(K, V)) {
    var out = vector(pair(K, V))();
    out.reserve(left.size() + right.size());
    var i: int = 0;
    var j: int = 0;
    while (i < left.size() and j < right.size()) {
        let order = compare_keys(left[i].first, right[j].first);
        if (order < 0) {
            out.push_back(left[i]);
            i += 1;
        } else {
            if (order > 0) {
                out.push_back(right[j]);
                j += 1;
            } else {
                out.push_back(left[i]);
                i += 1;
                j += 1;
            }
        }
    }
    while (i < left.size()) {
        out.push_back(left[i]);
        i += 1;
    }
    while (j < right.size()) {
        out.push_back(right[j]);
        j += 1;
    }
    return out;
}

// Copies every entry of `source` into `target`, preserving order.
fn merge_into[K: type, V: type, ORDER: int]
    (ref target: BTree(K, V, ORDER),
              source: BTree(K, V, ORDER)) -> int {
    var entries = source.to_pairs();
    let added = target.insert_all(entries);
    Destroy(entries);
    return added;
}

// Builds a fresh tree holding the union of two trees.  The result is bulk
// loaded from the merged run rather than inserted key by key.
fn union_of[K: type, V: type, ORDER: int]
    (left: BTree(K, V, ORDER),
            right: BTree(K, V, ORDER)) -> BTree(K, V, ORDER) {
    var out = BTree(K, V, ORDER)();
    var a = left.to_pairs();
    var b = right.to_pairs();
    var merged = merge_sorted(K, V)(a, b);
    Discard(out.bulk_load(merged));
    Destroy(merged);
    Destroy(a);
    Destroy(b);
    return out;
}

// Keys present in both trees, paired with the left tree's value.
fn intersection_of[K: type, V: type, ORDER: int]
    (left: BTree(K, V, ORDER),
                   right: BTree(K, V, ORDER)) -> vector(pair(K, V)) {
    var out = vector(pair(K, V))();
    var entries = left.to_pairs();
    for (entry in entries) {
        if (right.contains(entry.first)) {
            out.push_back(entry);
        }
    }
    Destroy(entries);
    return out;
}

// Removes every key in the half-open range `[low, high)`, returning the number
// of entries that were actually erased.
fn erase_range[K: type, V: type, ORDER: int]
    (ref tree: BTree(K, V, ORDER), low: K, high: K) -> int {
    var doomed = vector(pair(K, V))();
    let found = tree.range_query(low, high, doomed);
    var removed: int = 0;
    if (found == 0) {
        Destroy(doomed);
        return 0;
    }
    for (entry in doomed) {
        if (tree.erase(entry.first)) {
            removed += 1;
        }
    }
    Destroy(doomed);
    return removed;
}

// Groups the whole tree into buckets of at most `width` consecutive entries,
// keyed by the first key of each bucket.  The deeply nested return type is
// what makes this useful as a stress case for the generic machinery.
fn chunk_by_width[K: type, V: type, ORDER: int]
    (tree: BTree(K, V, ORDER),
                  width: int) -> map(K, vector(pair(K, vector(V)))) {
    var chunks = map(K, vector(pair(K, vector(V))))();
    var entries = tree.to_pairs();
    if (entries.size() == 0) {
        Destroy(entries);
        return chunks;
    }
    var bucket = vector(pair(K, vector(V)))();
    var bucket_key = entries[0].first;
    var index: int = 0;
    while (index < entries.size()) {
        var values = vector(V)();
        values.push_back(entries[index].second);
        bucket.push_back(pair(K, vector(V))({.first = entries[index].first, .second = values}));
        Destroy(values);
        if (bucket.size() >= width) {
            Discard(chunks.insert(bucket_key, bucket));
            bucket.clear();
            if (index + 1 < entries.size()) {
                bucket_key = entries[index + 1].first;
            }
        }
        index += 1;
    }
    if (bucket.size() > 0) {
        Discard(chunks.insert(bucket_key, bucket));
    }
    Destroy(bucket);
    Destroy(entries);
    return chunks;
}

// Flattens the nested grouping above back into a flat run of pairs.
fn flatten_groups[K: type, V: type]
    (groups: vector(pair(K, vector(V)))) -> vector(pair(K, V)) {
    var out = vector(pair(K, V))();
    for (group in groups) {
        for (value in group.second) {
            out.push_back(pair(K, V)({.first = group.first, .second = value}));
        }
    }
    return out;
}

// Structural equality: same size and the same in-order key sequence.
fn tree_equal[K: type, V: type, ORDER: int]
    (left: BTree(K, V, ORDER),
              right: BTree(K, V, ORDER)) -> bool {
    if (left.size() != right.size()) {
        return false;
    }
    var a = left.to_pairs();
    var b = right.to_pairs();
    var index: int = 0;
    var same: bool = true;
    while (index < a.size()) {
        if (compare_keys(a[index].first, b[index].first) != 0) {
            same = false;
            index = a.size();
        } else {
            index += 1;
        }
    }
    Destroy(a);
    Destroy(b);
    return same;
}

// Rebuilds `tree` at a different branching factor by streaming its contents
// through a sorted run.  The two branching factors are independent template
// parameters, so this is the one place both instantiations meet.
fn rebalance_to_order[K: type, V: type, FROM: int, TO: int]
    (source: BTree(K, V, FROM),
                      ref target: BTree(K, V, TO)) -> bool {
    var entries = source.to_pairs();
    if (not is_sorted_by_key(K, V)(entries)) {
        Destroy(entries);
        return false;
    }
    let ok = target.bulk_load(entries);
    Destroy(entries);
    return ok;
}

// Summarises a tree's shape as a single line of text.
fn describe_shape[K: type, V: type, ORDER: int]
    (tree: BTree(K, V, ORDER)) -> string {
    var stats = tree.statistics();
    var text = stats.describe();
    text.append(" order=");
    text.append(to_string(ORDER));
    text.append(" balanced=");
    if (stats.balanced()) {
        text.append("yes");
    } else {
        text.append("no");
    }
    return text;
}

// --- Demo -------------------------------------------------------------------

// Exercises the container end to end at two different branching factors, which
// is also the cheapest way to force both instantiations to be checked.
fn demo_b_tree() {
    var tree = BTree(int, string, 6)();
    tree.reserve(BTREE_INITIAL_CAPACITY);

    // Insert a pseudo-random permutation of [0, 64).
    for (i in range(0, 64)) {
        Discard(tree.insert((i * 37) % 64, to_string(i)));
    }
    println(describe_shape(int, string, 6)(tree));
    if (not tree.check_validity()) {
        panic("B-tree invariants violated after bulk insert");
    }

    // Delete every third key and re-check.
    var index: int = 0;
    while (index < 64) {
        if (index % 3 == 0) {
            Discard(tree.erase(index));
        }
        index += 1;
    }
    if (not tree.check_validity()) {
        panic("B-tree invariants violated after bulk erase");
    }

    // Range query over the middle half of the key space.
    var window = vector(pair(int, string))();
    let hits = tree.range_query(16, 48, window);
    println(to_string(hits));
    for (entry in window) {
        println(entry.second);
    }
    Destroy(window);

    // Grouped range query, exercising the nested map/vector/pair return type.
    var grouped = tree.range_grouped(0, 64);
    println(to_string(grouped.size()));
    Destroy(grouped);

    // Bulk load a wider tree from the narrow one's sorted contents.
    var wide = BTree(int, string, 16)();
    if (not rebalance_to_order(int, string, 6, 16)(tree, wide)) {
        panic("rebalance produced an unsorted run");
    }
    if (not wide.check_validity()) {
        panic("B-tree invariants violated after bulk load");
    }
    println(describe_shape(int, string, 16)(wide));

    // Predecessor and successor around a key that is definitely present.
    let before = tree.predecessor(32);
    let after = tree.successor(32);
    println(to_string(before.first));
    println(to_string(after.first));

    // Statistics pass.
    var stats = tree.statistics();
    println(to_string(stats.height));
    println(to_string(stats.average_occupancy()));
    println(to_string(stats.leaf_fraction_percent()));
    for (bucket in stats.occupancy_histogram) {
        println(to_string(bucket.second));
    }
    Destroy(stats);

    Destroy(wide);
    Destroy(tree);
}


// Arbitrary-precision signed integers.
//
// A BigInt is a sign flag plus a little-endian vector of limbs. Limb zero is
// the least significant. Every limb holds LIMB_BITS bits, so a limb value is
// always in the half-open range [0, LIMB_BASE). Products of two limbs plus a
// carry stay inside the machine word, which is what lets the inner loops be
// written as single long expressions instead of a ladder of temporaries.
namespace bignum;

// --- Representation constants --------------------------------------------

// Bits per limb. Chosen so that LIMB_BASE * LIMB_BASE plus two carries still
// fits comfortably in a 64 bit accumulator.
let LIMB_BITS: int = 30;

// 2^30. Written in decimal because the lexer only accepts decimal literals.
let LIMB_BASE: int = 1073741824;

// 2^30 - 1, the mask that reduces an accumulator down to one limb.
let LIMB_MASK: int = 1073741823;

// Half of LIMB_BASE, used by the rounding helpers.
let LIMB_HALF: int = 536870912;

// Decimal conversion works nine digits at a time: 10^9 < 2^30 is false, so we
// use eight digits per chunk to keep the chunk strictly below LIMB_BASE.
let DECIMAL_DIGITS_PER_CHUNK: int = 8;

// 10^8, the base of one decimal chunk.
let DECIMAL_CHUNK_BASE: int = 100000000;

// Below this limb count schoolbook multiplication beats Karatsuba because the
// recursion bookkeeping dominates the limb products.
let KARATSUBA_THRESHOLD: int = 24;

// Guard so that a runaway division loop reports instead of spinning forever.
let DIVISION_ITERATION_LIMIT: int = 100000;

// ASCII code points, spelled in decimal.
let CHAR_ZERO: int = 48;      // '0'
let CHAR_NINE: int = 57;      // '9'
let CHAR_MINUS: int = 45;     // '-'
let CHAR_PLUS: int = 43;      // '+'
let CHAR_UNDERSCORE: int = 95; // '_'

// Instrumentation: how many limb multiplications the library has performed.
var limb_product_count: int = 0;

// --- Small enums ----------------------------------------------------------

// Three-way comparison result, returned by compare and compare_magnitude.
choice Ordering {
    Less,
    Equal,
    Greater,
}

// Sign of a normalised BigInt. Zero is always stored with negative == false.
choice Sign {
    Negative,
    Zero,
    Positive,
}

// How parse_decimal failed, if it did.
choice ParseStatus {
    Ok,
    EmptyInput,
    BadDigit,
    Overflow,
}

// --- The number itself ----------------------------------------------------

class BigInt {

    // --- Basic queries ----------------------------------------------------

    // A normalised BigInt has no leading zero limbs, so an empty limb vector
    // is the unique representation of zero.
    fn is_zero(self) -> bool {
        return self.limbs.size() == 0;
    }

    fn limb_count(self) -> int {
        return self.limbs.size();
    }

    // Reading past the top of the number yields zero, which removes almost
    // every length check from the arithmetic loops below.
    fn limb_at(self, index: int) -> int {
        if (index < 0 or index >= self.limbs.size()) {
            return 0;
        }
        return self.limbs[index];
    }

    fn sign(self) -> Sign {
        if (self.limbs.size() == 0) {
            return Sign.Zero;
        }
        if (self.negative) {
            return Sign.Negative;
        }
        return Sign.Positive;
    }

    fn is_negative(self) -> bool {
        return self.negative and self.limbs.size() > 0;
    }

    fn is_positive(self) -> bool {
        return not self.negative and self.limbs.size() > 0;
    }

    fn is_even(self) -> bool {
        return self.limbs.size() == 0 or (self.limbs[0] & 1) == 0;
    }

    fn is_odd(self) -> bool {
        return self.limbs.size() > 0 and (self.limbs[0] & 1) == 1;
    }

    // True when the value fits in a single limb, sign ignored.
    fn fits_in_limb(self) -> bool {
        return self.limbs.size() <= 1;
    }

    // --- Mutation helpers -------------------------------------------------

    // Grow the limb vector with zeros until it can address `index`.
    fn ensure_limb(ref self, index: int) {
        while (self.limbs.size() <= index) {
            self.limbs.push_back(0);
        }
    }

    fn set_limb(ref self, index: int, value: int) {
        self.ensure_limb(index);
        self.limbs[index] = value & LIMB_MASK;
    }

    // Drop leading zero limbs and collapse the sign of zero. Every public
    // operation ends with a call to this so the representation stays unique.
    fn normalise(ref self) {
        while (self.limbs.size() > 0 and self.limbs[self.limbs.size() - 1] == 0) {
            self.limbs.pop_back();
        }
        if (self.limbs.size() == 0) {
            self.negative = false;
        }
    }

    fn set_zero(ref self) {
        self.limbs.clear();
        self.negative = false;
    }

    // Load a machine integer, splitting it across as many limbs as needed.
    fn assign_small(ref self, value: int) {
        self.limbs.clear();
        self.negative = value < 0;
        var magnitude = abs(value);
        while (magnitude > 0) {
            self.limbs.push_back(magnitude & LIMB_MASK);
            magnitude = magnitude >> LIMB_BITS;
        }
        self.normalise();
    }

    fn clone(self) -> BigInt {
        var out = BigInt();
        out.negative = self.negative;
        for (limb in self.limbs) {
            out.limbs.push_back(limb);
        }
        return out;
    }

    // In-place sign flip. Zero is left alone so the invariant holds.
    fn negate(ref self) {
        if (self.limbs.size() > 0) {
            self.negative = not self.negative;
        }
    }

    fn absolute(self) -> BigInt {
        var out = self.clone();
        out.negative = false;
        return out;
    }

    // --- Bit level access -------------------------------------------------

    // Number of significant bits, zero for zero.
    fn bit_length(self) -> int {
        if (self.limbs.size() == 0) {
            return 0;
        }
        var top = self.limbs[self.limbs.size() - 1];
        var bits: int = 0;
        while (top > 0) {
            bits += 1;
            top = top >> 1;
        }
        return (self.limbs.size() - 1) * LIMB_BITS + bits;
    }

    fn get_bit(self, position: int) -> int {
        if (position < 0) {
            return 0;
        }
        return (self.limb_at(position / LIMB_BITS) >> (position % LIMB_BITS)) & 1;
    }

    fn set_bit(ref self, position: int) {
        let index = position / LIMB_BITS;
        self.ensure_limb(index);
        self.limbs[index] = self.limbs[index] | (1 << (position % LIMB_BITS));
    }

    fn clear_bit(ref self, position: int) {
        let index = position / LIMB_BITS;
        if (index < self.limbs.size()) {
            self.limbs[index] = self.limbs[index] & (LIMB_MASK ^ (1 << (position % LIMB_BITS)));
            self.normalise();
        }
    }

    // Count of set bits across the whole magnitude.
    fn population_count(self) -> int {
        var total: int = 0;
        for (limb in self.limbs) {
            var word = limb;
            while (word > 0) {
                total += word & 1;
                word = word >> 1;
            }
        }
        return total;
    }

    // Index of the lowest set bit, or -1 for zero. Used by binary GCD.
    fn lowest_set_bit(self) -> int {
        var index: int = 0;
        while (index < self.limbs.size()) {
            if (self.limbs[index] != 0) {
                var word = self.limbs[index];
                var offset: int = 0;
                while ((word & 1) == 0) {
                    word = word >> 1;
                    offset += 1;
                }
                return index * LIMB_BITS + offset;
            }
            index += 1;
        }
        return -1;
    }

    // --- Comparison -------------------------------------------------------

    // Compare magnitudes only. Longer normalised number wins immediately;
    // otherwise scan from the top limb down.
    fn compare_magnitude(self, other: BigInt) -> Ordering {
        if (self.limbs.size() != other.limbs.size()) {
            if (self.limbs.size() < other.limbs.size()) {
                return Ordering.Less;
            }
            return Ordering.Greater;
        }
        var index = self.limbs.size() - 1;
        while (index >= 0) {
            if (self.limbs[index] != other.limbs[index]) {
                if (self.limbs[index] < other.limbs[index]) {
                    return Ordering.Less;
                }
                return Ordering.Greater;
            }
            index -= 1;
        }
        return Ordering.Equal;
    }

    // Full signed comparison built on top of the magnitude comparison.
    fn compare(self, other: BigInt) -> Ordering {
        if (self.is_negative() and not other.is_negative()) {
            return Ordering.Less;
        }
        if (not self.is_negative() and other.is_negative()) {
            return Ordering.Greater;
        }
        let magnitude = self.compare_magnitude(other);
        if (not self.is_negative()) {
            return magnitude;
        }
        if (magnitude == Ordering.Less) {
            return Ordering.Greater;
        }
        if (magnitude == Ordering.Greater) {
            return Ordering.Less;
        }
        return Ordering.Equal;
    }

    fn equals(self, other: BigInt) -> bool {
        return self.compare(other) == Ordering.Equal;
    }

    fn less_than(self, other: BigInt) -> bool {
        return self.compare(other) == Ordering.Less;
    }

    // Compare against a machine integer without allocating a temporary when
    // the value obviously does not fit in one limb.
    fn compare_small(self, value: int) -> Ordering {
        var scratch = BigInt();
        scratch.assign_small(value);
        return self.compare(scratch);
    }

    var limbs: vector(int);
    var negative: bool = false;
}

// --- Construction helpers -------------------------------------------------

// The canonical zero.
fn make_zero() -> BigInt {
    var out = BigInt();
    out.negative = false;
    return out;
}

fn make_one() -> BigInt {
    var out = BigInt();
    out.limbs.push_back(1);
    return out;
}

fn make_from_int(value: int) -> BigInt {
    var out = BigInt();
    out.assign_small(value);
    return out;
}

// Build directly from limbs that are already reduced. Used by the division
// and Karatsuba routines, which produce normalised limbs by construction.
fn make_from_limbs(source: vector(int), negative: bool) -> BigInt {
    var out = BigInt();
    out.negative = negative;
    for (limb in source) {
        out.limbs.push_back(limb & LIMB_MASK);
    }
    out.normalise();
    return out;
}

// --- Magnitude addition ---------------------------------------------------

// |a| + |b|, ignoring both signs.
//
// The carry chain is written as one expression per limb: the accumulator is
// the previous carry plus both limbs, and the same accumulator feeds both the
// stored limb and the next carry.
fn add_magnitude(a: BigInt, b: BigInt) -> BigInt {
    var out = BigInt();
    let length = max(a.limb_count(), b.limb_count());
    var carry: int = 0;
    var index: int = 0;
    while (index < length) {
        let total = carry + a.limb_at(index) + b.limb_at(index);
        out.limbs.push_back(total & LIMB_MASK);
        carry = total >> LIMB_BITS;
        index += 1;
    }
    if (carry > 0) {
        out.limbs.push_back(carry & LIMB_MASK);
    }
    out.normalise();
    return out;
}

// |a| - |b|, and the caller must guarantee |a| >= |b|.
//
// The borrow is folded into the same accumulator as the difference: adding
// LIMB_BASE before subtracting keeps the intermediate non-negative, and the
// resulting quotient by LIMB_BASE is one exactly when no borrow was needed.
fn sub_magnitude(a: BigInt, b: BigInt) -> BigInt {
    var out = BigInt();
    var borrow: int = 0;
    var index: int = 0;
    while (index < a.limb_count()) {
        let difference = a.limb_at(index) - b.limb_at(index) - borrow + LIMB_BASE;
        out.limbs.push_back(difference & LIMB_MASK);
        borrow = 1 - (difference >> LIMB_BITS);
        index += 1;
    }
    out.normalise();
    return out;
}

// |a| + small, where small is a non-negative machine integer below LIMB_BASE.
fn add_small_magnitude(a: BigInt, small: int) -> BigInt {
    var out = a.absolute();
    var carry = small;
    var index: int = 0;
    while (carry > 0) {
        out.ensure_limb(index);
        let total = out.limbs[index] + (carry & LIMB_MASK);
        out.limbs[index] = total & LIMB_MASK;
        carry = (carry >> LIMB_BITS) + (total >> LIMB_BITS);
        index += 1;
    }
    out.normalise();
    return out;
}

// --- Signed addition and subtraction --------------------------------------

// Signed addition. Same signs add magnitudes and keep the sign; mixed signs
// subtract the smaller magnitude from the larger and inherit its sign.
fn add(a: BigInt, b: BigInt) -> BigInt {
    if (a.is_negative() == b.is_negative()) {
        var out = add_magnitude(a, b);
        out.negative = a.is_negative() and out.limbs.size() > 0;
        return out;
    }
    let ordering = a.compare_magnitude(b);
    if (ordering == Ordering.Equal) {
        return make_zero();
    }
    if (ordering == Ordering.Greater) {
        var out = sub_magnitude(a, b);
        out.negative = a.is_negative() and out.limbs.size() > 0;
        return out;
    }
    var out = sub_magnitude(b, a);
    out.negative = b.is_negative() and out.limbs.size() > 0;
    return out;
}

// Signed subtraction expressed as addition of the negation, but without
// materialising the negated operand twice.
fn subtract(a: BigInt, b: BigInt) -> BigInt {
    var flipped = b.clone();
    flipped.negate();
    let out = add(a, flipped);
    Destroy(flipped);
    return out;
}

fn negated(a: BigInt) -> BigInt {
    var out = a.clone();
    out.negate();
    return out;
}

// a + small without building a BigInt for the small operand when the signs
// already agree.
fn add_small(a: BigInt, small: int) -> BigInt {
    if (small == 0) {
        return a.clone();
    }
    if (a.is_negative() == (small < 0)) {
        var out = add_small_magnitude(a, abs(small));
        out.negative = a.is_negative() or small < 0;
        out.normalise();
        return out;
    }
    let other = make_from_int(small);
    return add(a, other);
}

// --- Schoolbook multiplication --------------------------------------------

// The classic O(n*m) algorithm. The inner accumulator carries the running
// carry, the fresh limb product and the partial result already sitting in the
// destination, all in one expression -- this is the shape the whole file is
// built around.
fn schoolbook_multiply(a: BigInt, b: BigInt) -> BigInt {
    var result = BigInt();
    if (a.is_zero() or b.is_zero()) {
        return result;
    }
    result.limbs.resize(a.limb_count() + b.limb_count());
    var i: int = 0;
    while (i < a.limb_count()) {
        var carry: int = 0;
        var j: int = 0;
        while (j < b.limb_count()) {
            let total = carry + a.limbs[i] * b.limbs[j] + result.limbs[i + j];
            result.limbs[i + j] = total & LIMB_MASK;
            carry = total >> LIMB_BITS;
            limb_product_count += 1;
            j += 1;
        }
        // Flush the carry out through the remaining high limbs. The loop body
        // is again a single accumulate-mask-shift expression triple.
        var k = i + b.limb_count();
        while (carry > 0) {
            let total = carry + result.limbs[k];
            result.limbs[k] = total & LIMB_MASK;
            carry = total >> LIMB_BITS;
            k += 1;
        }
        i += 1;
    }
    result.negative = a.is_negative() != b.is_negative();
    result.normalise();
    return result;
}

// Multiply by a single limb-sized value. The magnitude only; the caller
// applies the sign.
fn multiply_small(a: BigInt, small: int) -> BigInt {
    var result = BigInt();
    if (a.is_zero() or small == 0) {
        return result;
    }
    let magnitude = abs(small);
    var carry: int = 0;
    var index: int = 0;
    while (index < a.limb_count()) {
        let total = carry + a.limbs[index] * (magnitude & LIMB_MASK);
        result.limbs.push_back(total & LIMB_MASK);
        carry = total >> LIMB_BITS;
        index += 1;
    }
    while (carry > 0) {
        result.limbs.push_back(carry & LIMB_MASK);
        carry = carry >> LIMB_BITS;
    }
    result.negative = a.is_negative() != (small < 0);
    result.normalise();
    return result;
}

// Square via the schoolbook route, exploiting symmetry: every off-diagonal
// product appears twice, so it is computed once and doubled inside the same
// accumulator expression.
fn square(a: BigInt) -> BigInt {
    var result = BigInt();
    if (a.is_zero()) {
        return result;
    }
    result.limbs.resize(a.limb_count() * 2 + 1);
    var i: int = 0;
    while (i < a.limb_count()) {
        let diagonal = result.limbs[i + i] + a.limbs[i] * a.limbs[i];
        result.limbs[i + i] = diagonal & LIMB_MASK;
        var carry = diagonal >> LIMB_BITS;
        var j = i + 1;
        while (j < a.limb_count()) {
            let total = carry + result.limbs[i + j] + a.limbs[i] * a.limbs[j] * 2;
            result.limbs[i + j] = total & LIMB_MASK;
            carry = total >> LIMB_BITS;
            limb_product_count += 1;
            j += 1;
        }
        var k = i + a.limb_count();
        while (carry > 0) {
            let total = carry + result.limbs[k];
            result.limbs[k] = total & LIMB_MASK;
            carry = total >> LIMB_BITS;
            k += 1;
        }
        i += 1;
    }
    result.negative = false;
    result.normalise();
    return result;
}

// --- Limb and bit shifts --------------------------------------------------

// Shift the magnitude up by whole limbs, i.e. multiply by LIMB_BASE^count.
fn shift_left_limbs(a: BigInt, count: int) -> BigInt {
    var out = BigInt();
    if (a.is_zero() or count < 0) {
        return out;
    }
    for (i in range(0, count)) {
        out.limbs.push_back(0);
    }
    for (limb in a.limbs) {
        out.limbs.push_back(limb);
    }
    out.negative = a.is_negative();
    out.normalise();
    return out;
}

// Shift the magnitude down by whole limbs, discarding the low ones. This is
// floor division towards zero on the magnitude, not an arithmetic shift.
fn shift_right_limbs(a: BigInt, count: int) -> BigInt {
    var out = BigInt();
    var index = count;
    while (index < a.limb_count()) {
        out.limbs.push_back(a.limbs[index]);
        index += 1;
    }
    out.negative = a.is_negative();
    out.normalise();
    return out;
}

// General left shift by an arbitrary bit count. The whole-limb part is a
// prefix of zeros; the residual bit part folds the tail of the previous limb
// into the head of the current one inside a single expression.
fn shift_left(a: BigInt, bits: int) -> BigInt {
    if (bits <= 0 or a.is_zero()) {
        return a.clone();
    }
    let whole = bits / LIMB_BITS;
    let partial_ = bits % LIMB_BITS;
    var out = BigInt();
    for (i in range(0, whole)) {
        out.limbs.push_back(0);
    }
    if (partial_ == 0) {
        for (limb in a.limbs) {
            out.limbs.push_back(limb);
        }
    } else {
        var carry: int = 0;
        var index: int = 0;
        while (index < a.limb_count()) {
            let total = ((a.limbs[index] << partial_) & LIMB_MASK) | carry;
            out.limbs.push_back(total & LIMB_MASK);
            carry = (a.limbs[index] >> (LIMB_BITS - partial_)) & LIMB_MASK;
            index += 1;
        }
        if (carry > 0) {
            out.limbs.push_back(carry);
        }
    }
    out.negative = a.is_negative();
    out.normalise();
    return out;
}

// General right shift by an arbitrary bit count, truncating towards zero on
// the magnitude. The recombination reads one limb above the current index so
// the whole limb is assembled in one expression.
fn shift_right(a: BigInt, bits: int) -> BigInt {
    if (bits <= 0 or a.is_zero()) {
        return a.clone();
    }
    let whole = bits / LIMB_BITS;
    let partial_ = bits % LIMB_BITS;
    var out = BigInt();
    if (whole >= a.limb_count()) {
        return out;
    }
    var index = whole;
    while (index < a.limb_count()) {
        if (partial_ == 0) {
            out.limbs.push_back(a.limbs[index]);
        } else {
            let assembled = (a.limbs[index] >> partial_)
                | ((a.limb_at(index + 1) << (LIMB_BITS - partial_)) & LIMB_MASK);
            out.limbs.push_back(assembled & LIMB_MASK);
        }
        index += 1;
    }
    out.negative = a.is_negative();
    out.normalise();
    return out;
}

// --- Bitwise operations ---------------------------------------------------
//
// These operate on the magnitudes only and take the sign from a simple rule
// per operator. Two's complement over an unbounded magnitude would need a
// sign-extension pass that this library deliberately does not implement.

fn bitwise_and(a: BigInt, b: BigInt) -> BigInt {
    var out = BigInt();
    let length = min(a.limb_count(), b.limb_count());
    var index: int = 0;
    while (index < length) {
        out.limbs.push_back(a.limbs[index] & b.limbs[index]);
        index += 1;
    }
    out.negative = a.is_negative() and b.is_negative();
    out.normalise();
    return out;
}

fn bitwise_or(a: BigInt, b: BigInt) -> BigInt {
    var out = BigInt();
    let length = max(a.limb_count(), b.limb_count());
    var index: int = 0;
    while (index < length) {
        out.limbs.push_back(a.limb_at(index) | b.limb_at(index));
        index += 1;
    }
    out.negative = a.is_negative() or b.is_negative();
    out.normalise();
    return out;
}

fn bitwise_xor(a: BigInt, b: BigInt) -> BigInt {
    var out = BigInt();
    let length = max(a.limb_count(), b.limb_count());
    var index: int = 0;
    while (index < length) {
        out.limbs.push_back(a.limb_at(index) ^ b.limb_at(index));
        index += 1;
    }
    out.negative = a.is_negative() != b.is_negative();
    out.normalise();
    return out;
}

// Complement within a fixed width, since an unbounded complement is not
// representable. Bits above `width` are simply dropped.
fn bitwise_not_width(a: BigInt, width: int) -> BigInt {
    var out = BigInt();
    let limbs_needed = (width + LIMB_BITS - 1) / LIMB_BITS;
    var index: int = 0;
    while (index < limbs_needed) {
        out.limbs.push_back((^a.limb_at(index)) & LIMB_MASK);
        index += 1;
    }
    let overhang = width % LIMB_BITS;
    if (overhang != 0 and out.limbs.size() > 0) {
        let top = out.limbs.size() - 1;
        out.limbs[top] = out.limbs[top] & ((1 << overhang) - 1);
    }
    out.negative = false;
    out.normalise();
    return out;
}

// --- Karatsuba multiplication ---------------------------------------------

// Take the low `count` limbs of a magnitude.
fn low_part(a: BigInt, count: int) -> BigInt {
    var out = BigInt();
    var index: int = 0;
    while (index < count and index < a.limb_count()) {
        out.limbs.push_back(a.limbs[index]);
        index += 1;
    }
    out.negative = false;
    out.normalise();
    return out;
}

// Take everything from limb `count` upwards.
fn high_part(a: BigInt, count: int) -> BigInt {
    var out = BigInt();
    var index = count;
    while (index < a.limb_count()) {
        out.limbs.push_back(a.limbs[index]);
        index += 1;
    }
    out.negative = false;
    out.normalise();
    return out;
}

// Karatsuba: with a = a1*B^k + a0 and b = b1*B^k + b0,
//
//     a*b = a1*b1*B^(2k) + ((a1+a0)*(b1+b0) - a1*b1 - a0*b0)*B^k + a0*b0
//
// so three half-width products replace four. The recombination below is
// written as one long chained expression to match the formula shape.
fn karatsuba_multiply(a: BigInt, b: BigInt) -> BigInt {
    if (a.is_zero() or b.is_zero()) {
        return make_zero();
    }
    if (a.limb_count() < KARATSUBA_THRESHOLD or b.limb_count() < KARATSUBA_THRESHOLD) {
        return schoolbook_multiply(a, b);
    }

    let split = max(a.limb_count(), b.limb_count()) / 2;
    let a_low = low_part(a, split);
    let a_high = high_part(a, split);
    let b_low = low_part(b, split);
    let b_high = high_part(b, split);

    let high_product = karatsuba_multiply(a_high, b_high);
    let low_product = karatsuba_multiply(a_low, b_low);
    let cross_sum_a = add_magnitude(a_low, a_high);
    let cross_sum_b = add_magnitude(b_low, b_high);
    let cross_raw = karatsuba_multiply(cross_sum_a, cross_sum_b);
    let middle = subtract(subtract(cross_raw, high_product), low_product);

    // result = high << 2k  +  middle << k  +  low, in a single chain.
    var result = add(add(shift_left_limbs(high_product, split + split),
        shift_left_limbs(middle, split)), low_product);
    result.negative = a.is_negative() != b.is_negative() and not result.is_zero();
    result.normalise();
    return result;
}

// Public multiply entry point: dispatch on operand width.
fn multiply(a: BigInt, b: BigInt) -> BigInt {
    if (a.is_zero() or b.is_zero()) {
        return make_zero();
    }
    if (a.limb_count() == 1 and b.limb_count() == 1) {
        // Both fit in one limb, so the product fits in two and can be built
        // without any loop at all.
        var out = BigInt();
        let total = a.limbs[0] * b.limbs[0];
        out.limbs.push_back(total & LIMB_MASK);
        out.limbs.push_back(total >> LIMB_BITS);
        out.negative = a.is_negative() != b.is_negative();
        out.normalise();
        return out;
    }
    if (a.limb_count() + b.limb_count() < KARATSUBA_THRESHOLD * 2) {
        return schoolbook_multiply(a, b);
    }
    return karatsuba_multiply(a, b);
}

// --- Division -------------------------------------------------------------

// Quotient and remainder together, so callers that need both pay once.
class DivisionResult {
    var quotient: BigInt;
    var remainder: BigInt;
    var exact: bool = false;
}

// Divide the magnitude by a single limb value, returning the quotient and
// leaving the remainder in the out parameter slot of the result struct.
//
// The running remainder is folded into the numerator of the next limb, so the
// whole step is one expression: (rest * BASE + limb) / divisor.
fn divide_small(a: BigInt, divisor: int) -> DivisionResult {
    var out = DivisionResult();
    if (divisor == 0) {
        panic("bignum: division by zero");
        return out;
    }
    let magnitude = abs(divisor);
    out.quotient.limbs.resize(a.limb_count());
    var rest: int = 0;
    var index = a.limb_count() - 1;
    while (index >= 0) {
        let numerator = rest * LIMB_BASE + a.limbs[index];
        out.quotient.limbs[index] = (numerator / magnitude) & LIMB_MASK;
        rest = numerator % magnitude;
        index -= 1;
    }
    out.quotient.negative = a.is_negative() != (divisor < 0);
    out.quotient.normalise();
    out.remainder.assign_small(rest);
    out.remainder.negative = a.is_negative() and rest != 0;
    out.remainder.normalise();
    out.exact = rest == 0;
    return out;
}

// Estimate one quotient limb from the top two limbs of the running remainder
// and the top limb of the divisor. The estimate is at most two too large,
// which the correction loop in long_divide fixes up.
fn estimate_quotient_limb(rest: BigInt, divisor: BigInt, offset: int) -> int {
    let top = divisor.limbs[divisor.limb_count() - 1];
    let high = rest.limb_at(offset + divisor.limb_count());
    let low = rest.limb_at(offset + divisor.limb_count() - 1);
    var guess = (high * LIMB_BASE + low) / top;
    if (guess > LIMB_MASK) {
        guess = LIMB_MASK;
    }
    if (guess < 0) {
        guess = 0;
    }
    return guess;
}

// Knuth-style long division on normalised operands.
//
// At each step the divisor is shifted up by `offset` limbs, a quotient limb is
// estimated, the shifted product is subtracted, and the estimate is corrected
// downwards while the subtraction would have gone negative.
fn long_divide(a: BigInt, b: BigInt) -> DivisionResult {
    var out = DivisionResult();
    if (b.is_zero()) {
        panic("bignum: division by zero");
        return out;
    }
    let dividend = a.absolute();
    let divisor = b.absolute();
    if (dividend.compare_magnitude(divisor) == Ordering.Less) {
        out.quotient = make_zero();
        out.remainder = a.clone();
        out.exact = a.is_zero();
        return out;
    }
    if (divisor.limb_count() == 1) {
        var small = divide_small(dividend, divisor.limbs[0]);
        small.quotient.negative = a.is_negative() != b.is_negative() and not small.quotient.is_zero();
        small.remainder.negative = a.is_negative() and not small.remainder.is_zero();
        small.quotient.normalise();
        small.remainder.normalise();
        return small;
    }

    var rest = dividend.clone();
    let steps = dividend.limb_count() - divisor.limb_count();
    out.quotient.limbs.resize(steps + 1);
    var offset = steps;
    var guard: int = 0;
    while (offset >= 0) {
        var guess = estimate_quotient_limb(rest, divisor, offset);
        var trial = shift_left_limbs(multiply_small(divisor, guess), offset);
        // Walk the estimate down until the trial product fits. At most two
        // iterations are needed for a properly normalised divisor.
        while (trial.compare_magnitude(rest) == Ordering.Greater and guess > 0) {
            guess -= 1;
            trial = shift_left_limbs(multiply_small(divisor, guess), offset);
            guard += 1;
            if (guard > DIVISION_ITERATION_LIMIT) {
                panic("bignum: division failed to converge");
                return out;
            }
        }
        // And walk it up again in the rare case the estimate was too small.
        var next_trial = shift_left_limbs(multiply_small(divisor, guess + 1), offset);
        while (next_trial.compare_magnitude(rest) != Ordering.Greater) {
            guess += 1;
            trial = next_trial;
            next_trial = shift_left_limbs(multiply_small(divisor, guess + 1), offset);
            guard += 1;
            if (guard > DIVISION_ITERATION_LIMIT) {
                panic("bignum: division failed to converge");
                return out;
            }
        }
        rest = sub_magnitude(rest, trial);
        out.quotient.limbs[offset] = guess & LIMB_MASK;
        Destroy(trial);
        offset -= 1;
    }

    out.quotient.negative = a.is_negative() != b.is_negative();
    out.quotient.normalise();
    out.remainder = rest;
    out.remainder.negative = a.is_negative() and not rest.is_zero();
    out.remainder.normalise();
    out.exact = out.remainder.is_zero();
    return out;
}

fn divide(a: BigInt, b: BigInt) -> BigInt {
    let result = long_divide(a, b);
    return result.quotient;
}

fn remainder(a: BigInt, b: BigInt) -> BigInt {
    let result = long_divide(a, b);
    return result.remainder;
}

// Mathematical modulus: always in [0, |b|), unlike remainder which follows
// the sign of the dividend.
fn modulus(a: BigInt, b: BigInt) -> BigInt {
    var rest = remainder(a, b);
    if (rest.is_negative()) {
        let magnitude = b.absolute();
        rest = add(rest, magnitude);
    }
    rest.normalise();
    return rest;
}

fn divides_evenly(a: BigInt, b: BigInt) -> bool {
    return long_divide(a, b).exact;
}

// --- Modular arithmetic ---------------------------------------------------

fn mod_add(a: BigInt, b: BigInt, m: BigInt) -> BigInt {
    return modulus(add(a, b), m);
}

fn mod_sub(a: BigInt, b: BigInt, m: BigInt) -> BigInt {
    return modulus(subtract(a, b), m);
}

fn mod_mul(a: BigInt, b: BigInt, m: BigInt) -> BigInt {
    return modulus(multiply(a, b), m);
}

// Square-and-multiply, scanning the exponent from the least significant bit
// upwards and keeping the running base reduced at every step.
fn mod_pow(base_: BigInt, exponent: BigInt, m: BigInt) -> BigInt {
    if (m.is_zero()) {
        panic("bignum: modulus must be non-zero");
        return make_zero();
    }
    var result = make_one();
    var running = modulus(base_, m);
    let bits = exponent.bit_length();
    var index: int = 0;
    while (index < bits) {
        if (exponent.get_bit(index) == 1) {
            result = modulus(multiply(result, running), m);
        }
        running = modulus(square(running), m);
        index += 1;
    }
    result.normalise();
    return result;
}

// Plain exponentiation with a machine-integer exponent.
fn power(base_: BigInt, exponent: int) -> BigInt {
    if (exponent < 0) {
        panic("bignum: negative exponent");
        return make_zero();
    }
    var result = make_one();
    var running = base_.clone();
    var rest = exponent;
    while (rest > 0) {
        if ((rest & 1) == 1) {
            result = multiply(result, running);
        }
        running = square(running);
        rest = rest >> 1;
    }
    return result;
}

// --- Greatest common divisor ----------------------------------------------

// Euclid on magnitudes. Simple and correct; the binary variant below is the
// one that is actually fast for large inputs.
fn gcd_euclid(a: BigInt, b: BigInt) -> BigInt {
    var x = a.absolute();
    var y = b.absolute();
    while (not y.is_zero()) {
        let rest = remainder(x, y);
        x = y;
        y = rest;
    }
    x.normalise();
    return x;
}

// Binary (Stein) GCD: strip common factors of two, then repeatedly subtract
// the smaller from the larger and re-strip.
fn gcd(a: BigInt, b: BigInt) -> BigInt {
    var x = a.absolute();
    var y = b.absolute();
    if (x.is_zero()) {
        return y;
    }
    if (y.is_zero()) {
        return x;
    }
    let common = min(x.lowest_set_bit(), y.lowest_set_bit());
    x = shift_right(x, x.lowest_set_bit());
    y = shift_right(y, y.lowest_set_bit());
    while (not y.is_zero()) {
        if (x.compare_magnitude(y) == Ordering.Greater) {
            swap(x, y);
        }
        y = sub_magnitude(y, x);
        if (not y.is_zero()) {
            y = shift_right(y, y.lowest_set_bit());
        }
    }
    return shift_left(x, common);
}

fn lcm(a: BigInt, b: BigInt) -> BigInt {
    if (a.is_zero() or b.is_zero()) {
        return make_zero();
    }
    let divisor = gcd(a, b);
    return divide(multiply(a, b).absolute(), divisor);
}

// --- Operator implementations ---------------------------------------------
//
// The named routines above are the real implementation; these impls only give
// them infix spelling, so that a call site can be one long algebraic
// expression such as `(a * b + c) / d` instead of a stack of nested calls.
// Every operand is a shared const reference and every result is freshly
// normalised, so no operator ever aliases its inputs.

// Sum of two signed numbers.
impl BigInt as Core.AddWith(BigInt) where .Result = BigInt {
  fn Op(self, other: BigInt) -> BigInt {
      return add(self, other);
  }
}

// Difference, defined as l + (-r) but computed without materialising -r twice.
impl BigInt as Core.SubWith(BigInt) where .Result = BigInt {
  fn Op(self, other: BigInt) -> BigInt {
      return subtract(self, other);
  }
}

// Product, dispatching between the one-limb path, schoolbook and Karatsuba.
impl BigInt as Core.MulWith(BigInt) where .Result = BigInt {
  fn Op(self, other: BigInt) -> BigInt {
      return multiply(self, other);
  }
}

// Truncating division: the quotient rounds towards zero, so
// (-7) / 2 == -3 and the identity l == (l / r) * r + l % r holds.
impl BigInt as Core.DivWith(BigInt) where .Result = BigInt {
  fn Op(self, other: BigInt) -> BigInt {
      return divide(self, other);
  }
}

// Remainder, which follows the sign of the dividend. Use modulus() when a
// non-negative residue is wanted instead.
impl BigInt as Core.ModWith(BigInt) where .Result = BigInt {
  fn Op(self, other: BigInt) -> BigInt {
      return remainder(self, other);
  }
}

// --- Comparison operators -------------------------------------------------
//
// All six route through the single three-way compare so that the sign rules
// live in exactly one place.

impl BigInt as Core.OrderedWith(BigInt) {
  fn Less(self, other: BigInt) -> bool {
      return self.compare(other) == Ordering.Less;
  }

  fn LessOrEquivalent(self, other: BigInt) -> bool {
      return self.compare(other) != Ordering.Greater;
  }

  fn Greater(self, other: BigInt) -> bool {
      return self.compare(other) == Ordering.Greater;
  }

  fn GreaterOrEquivalent(self, other: BigInt) -> bool {
      return self.compare(other) != Ordering.Less;
  }
}
impl BigInt as Core.EqWith(BigInt) {
  fn Equal(self, other: BigInt) -> bool {
      return self.compare(other) == Ordering.Equal;
  }

  fn NotEqual(self, other: BigInt) -> bool {
      return self.compare(other) != Ordering.Equal;
  }
}

// --- Unary operators ------------------------------------------------------

// Unary minus. Zero is its own negation, which negate() already guarantees.
impl BigInt as Core.Negate where .Result = BigInt {
  fn Op(self) -> BigInt {
      return negated(self);
  }
}

// --- Character tables -----------------------------------------------------
//
// The lexer only accepts decimal literals, so every code point above is a
// decimal constant. Digit rendering goes through these two tables rather than
// arithmetic on character codes, which turns the upper/lower case choice into
// a table swap instead of a branch in the inner loop.

let DIGIT_TABLE_LOWER: string = "0123456789abcdefghijklmnopqrstuvwxyz";
let DIGIT_TABLE_UPPER: string = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ";

// The largest radix the tables can render, and the shape of one hex digit.
let MAX_RADIX: int = 36;
let BITS_PER_NIBBLE: int = 4;
let NIBBLE_MASK: int = 15;

// Reinterpret a character as its code point. Written as a named function so
// that the conversion is visible at every call site rather than implicit.
fn code_of(c: char) -> int {
    return c;
}

// 10^count, for count in [0, 9]. Small enough to stay inside one limb, which
// is exactly why DECIMAL_DIGITS_PER_CHUNK is eight rather than nine.
fn power_of_ten(count: int) -> int {
    var result: int = 1;
    var index: int = 0;
    while (index < count) {
        result = result * 10;
        index += 1;
    }
    return result;
}

// Value of a decimal digit character, or -1 when it is not a digit at all.
fn decimal_digit_value(code: int) -> int {
    if (code < CHAR_ZERO or code > CHAR_NINE) {
        return -1;
    }
    return code - CHAR_ZERO;
}

// Character for a digit value in [0, MAX_RADIX).
fn digit_char(value: int, upper: bool) -> char {
    if (upper) {
        return DIGIT_TABLE_UPPER.at(value);
    }
    return DIGIT_TABLE_LOWER.at(value);
}

// --- Decimal parsing ------------------------------------------------------

// What parse_decimal produces: the value, why it stopped, and how far it got.
// The caller can use consumed to point an error message at the offending
// character without re-scanning the input.
class ParseResult {
    var value: BigInt;
    var status: ParseStatus = ParseStatus.Ok;
    var consumed: int = 0;
    var negative: bool = false;
}

// Parse a signed decimal string.
//
// Digits are accumulated eight at a time into a machine integer, and each
// full chunk is folded into the running value with one multiply-and-add:
// value = value * 10^8 + chunk. That is one BigInt operation per eight
// characters instead of one per character, which is the whole reason for the
// chunked representation. Underscores are accepted as digit separators inside
// the digit run even though the language's own lexer rejects them.
fn parse_decimal(text: string) -> ParseResult {
    var out = ParseResult();
    if (text.size() == 0) {
        out.status = ParseStatus.EmptyInput;
        return out;
    }

    var index: int = 0;
    let first = code_of(text.at(0));
    if (first == CHAR_MINUS or first == CHAR_PLUS) {
        out.negative = first == CHAR_MINUS;
        index = 1;
    }
    if (index >= text.size()) {
        out.status = ParseStatus.EmptyInput;
        return out;
    }

    var value = make_zero();
    var chunk: int = 0;
    var chunk_digits: int = 0;
    var seen_digit = false;
    while (index < text.size()) {
        let code = code_of(text.at(index));
        if (code == CHAR_UNDERSCORE) {
            // A separator is only meaningful between digits, never leading.
            if (not seen_digit) {
                out.status = ParseStatus.BadDigit;
                out.consumed = index;
                return out;
            }
            index += 1;
            continue;
        }
        let digit = decimal_digit_value(code);
        if (digit < 0) {
            out.status = ParseStatus.BadDigit;
            out.consumed = index;
            return out;
        }
        seen_digit = true;
        chunk = chunk * 10 + digit;
        chunk_digits += 1;
        if (chunk_digits == DECIMAL_DIGITS_PER_CHUNK) {
            value = add_small(multiply_small(value, DECIMAL_CHUNK_BASE), chunk);
            chunk = 0;
            chunk_digits = 0;
        }
        index += 1;
    }

    if (not seen_digit) {
        out.status = ParseStatus.EmptyInput;
        out.consumed = index;
        return out;
    }
    // Fold the short tail chunk in with the matching power of ten.
    if (chunk_digits > 0) {
        value = add_small(multiply_small(value, power_of_ten(chunk_digits)), chunk);
    }

    value.negative = out.negative and not value.is_zero();
    value.normalise();
    out.value = value;
    out.consumed = index;
    out.status = ParseStatus.Ok;
    return out;
}

// Convenience wrapper for callers that do not care why a parse failed.
fn from_decimal_string(text: string) -> BigInt {
    let parsed = parse_decimal(text);
    if (parsed.status != ParseStatus.Ok) {
        panic("bignum: malformed decimal literal");
        return make_zero();
    }
    return parsed.value;
}

// --- Digit emission -------------------------------------------------------

// Append `value` in decimal, left-padded with zeros to `width` characters.
// A width of zero means "no padding", which is what the most significant
// chunk of a number wants; every following chunk is padded to the full chunk
// width so that internal zeros survive.
fn append_padded_decimal(ref target: string, value: int, width: int) {
    var digits = vector(int)();
    var rest = abs(value);
    if (rest == 0) {
        digits.push_back(0);
    }
    while (rest > 0) {
        digits.push_back(rest % 10);
        rest = rest / 10;
    }
    while (digits.size() < width) {
        digits.push_back(0);
    }
    var index = digits.size() - 1;
    while (index >= 0) {
        target.push_back(digit_char(digits[index], false));
        index -= 1;
    }
}

// --- Decimal formatting ---------------------------------------------------

// Render a BigInt in base ten.
//
// The magnitude is peeled apart eight decimal digits at a time by repeated
// division by 10^8. The chunks come out least significant first, so they are
// emitted in reverse; only the top chunk is unpadded.
fn to_decimal_string(a: BigInt) -> string {
    var out = string();
    if (a.is_zero()) {
        out.push_back('0');
        return out;
    }

    var chunks = vector(int)();
    var rest = a.absolute();
    var guard: int = 0;
    while (not rest.is_zero()) {
        let step = divide_small(rest, DECIMAL_CHUNK_BASE);
        // The chunk base is below LIMB_BASE, so the remainder is one limb.
        chunks.push_back(step.remainder.limb_at(0));
        rest = step.quotient;
        guard += 1;
        if (guard > DIVISION_ITERATION_LIMIT) {
            panic("bignum: decimal conversion failed to terminate");
            return out;
        }
    }

    if (a.is_negative()) {
        out.push_back('-');
    }
    var index = chunks.size() - 1;
    append_padded_decimal(out, chunks[index], 0);
    index -= 1;
    while (index >= 0) {
        append_padded_decimal(out, chunks[index], DECIMAL_DIGITS_PER_CHUNK);
        index -= 1;
    }
    return out;
}

// --- Hexadecimal formatting -----------------------------------------------

// Render the magnitude in base sixteen, most significant nibble first.
//
// Rather than dividing, each nibble is assembled out of four bit queries in a
// single expression; get_bit returns zero past the top of the number, so the
// highest partial nibble needs no special case.
fn to_hex_string(a: BigInt, upper: bool) -> string {
    var out = string();
    if (a.is_zero()) {
        out.push_back('0');
        return out;
    }
    if (a.is_negative()) {
        out.push_back('-');
    }
    // Round the bit length up to a whole nibble and start at its low bit.
    var position = ((a.bit_length() + BITS_PER_NIBBLE - 1) / BITS_PER_NIBBLE)
        * BITS_PER_NIBBLE - BITS_PER_NIBBLE;
    while (position >= 0) {
        let nibble = (a.get_bit(position + 3) << 3) | (a.get_bit(position + 2) << 2)
            | (a.get_bit(position + 1) << 1) | a.get_bit(position);
        out.push_back(digit_char(nibble & NIBBLE_MASK, upper));
        position -= BITS_PER_NIBBLE;
    }
    return out;
}

// --- Binary formatting ----------------------------------------------------

// Render the magnitude in base two, most significant bit first. When `group`
// is positive an underscore is inserted every `group` bits, counting from the
// bottom, so that 2^12 - 1 with a group of four reads 1111_1111_1111.
fn to_binary_string(a: BigInt, group: int) -> string {
    var out = string();
    if (a.is_zero()) {
        out.push_back('0');
        return out;
    }
    if (a.is_negative()) {
        out.push_back('-');
    }
    var position = a.bit_length() - 1;
    while (position >= 0) {
        out.push_back(digit_char(a.get_bit(position) & 1, false));
        if (group > 0 and position > 0 and position % group == 0) {
            out.push_back('_');
        }
        position -= 1;
    }
    return out;
}

// --- Extended Euclid ------------------------------------------------------

// The triple produced by extended_gcd: the greatest common divisor together
// with the Bezout coefficients that reconstruct it, so that
// divisor == x * a + y * b holds for the original inputs.
class ExtendedGcd {
    var divisor: BigInt;
    var x: BigInt;
    var y: BigInt;
}

// Iterative extended Euclid.
//
// Two coefficient rows are carried alongside the remainder row and every step
// applies the same quotient to all three. Written with the infix operators
// above, each update is one expression mirroring the textbook recurrence
// r' = r_prev - q * r rather than nested calls into divide and multiply.
fn extended_gcd(a: BigInt, b: BigInt) -> ExtendedGcd {
    var out = ExtendedGcd();
    var old_rest = a.clone();
    var rest = b.clone();
    var old_x = make_one();
    var x = make_zero();
    var old_y = make_zero();
    var y = make_one();
    var guard: int = 0;
    while (not rest.is_zero()) {
        let quotient = old_rest / rest;
        let next_rest = old_rest - quotient * rest;
        let next_x = old_x - quotient * x;
        let next_y = old_y - quotient * y;
        old_rest = rest;
        rest = next_rest;
        old_x = x;
        x = next_x;
        old_y = y;
        y = next_y;
        guard += 1;
        if (guard > DIVISION_ITERATION_LIMIT) {
            panic("bignum: extended gcd failed to converge");
            return out;
        }
    }
    out.divisor = old_rest;
    out.x = old_x;
    out.y = old_y;
    return out;
}

// Modular inverse of a modulo m, or a panic when the two are not coprime.
// The Bezout coefficient x already satisfies x * a == 1 (mod m); it only has
// to be pulled back into [0, m).
fn mod_inverse(a: BigInt, m: BigInt) -> BigInt {
    if (m.is_zero()) {
        panic("bignum: modulus must be non-zero");
        return make_zero();
    }
    let reduced = modulus(a, m);
    let bezout = extended_gcd(reduced, m.absolute());
    if (bezout.divisor != make_one()) {
        panic("bignum: value is not invertible modulo m");
        return make_zero();
    }
    let inverse = modulus(bezout.x, m.absolute());
    Assert(inverse.is_negative() == false);
    return inverse;
}

// --- Integer square root --------------------------------------------------

// Newton iteration for floor(sqrt(a)).
//
// The seed is 2^(ceil(bits/2)), which is at least the true root, and the step
// next = (guess + a / guess) / 2 decreases monotonically from there, so the
// first non-decreasing step is the fixed point. The correction loop absorbs
// the one-off overshoot integer truncation can leave behind.
fn isqrt(a: BigInt) -> BigInt {
    if (a.is_negative()) {
        panic("bignum: square root of a negative number");
        return make_zero();
    }
    if (a.is_zero() or a.compare_small(1) == Ordering.Equal) {
        return a.clone();
    }

    var guess = shift_left(make_one(), a.bit_length() / 2 + 1);
    var guard: int = 0;
    while (true) {
        let next = (guess + a / guess) >> 1;
        if (next >= guess) {
            break;
        }
        guess = next;
        guard += 1;
        if (guard > DIVISION_ITERATION_LIMIT) {
            panic("bignum: square root failed to converge");
            break;
        }
    }
    // Truncation can leave the estimate one too high; never more than one.
    while (guess * guess > a) {
        guess = guess - make_one();
    }
    Prove(guess * guess <= a);
    return guess;
}

fn is_perfect_square(a: BigInt) -> bool {
    if (a.is_negative()) {
        return false;
    }
    let root = isqrt(a);
    return root * root == a;
}

// --- Factorials and binomials ---------------------------------------------

// n! by straight accumulation. Each factor fits in a limb for any n that is
// remotely computable, so the whole product runs through multiply_small.
fn factorial(n: int) -> BigInt {
    if (n < 0) {
        panic("bignum: factorial of a negative number");
        return make_zero();
    }
    var result = make_one();
    var index: int = 2;
    while (index <= n) {
        result = multiply_small(result, index);
        index += 1;
    }
    return result;
}

// Binomial coefficient by the multiplicative formula
//
//     C(n, k) = product over i in [1, k] of (n - k + i) / i
//
// which stays exact at every step because the partial product of the first i
// factors is always divisible by i!. Multiplying up and dividing back down in
// one expression keeps the running value as small as the result allows.
fn binomial(n: int, k: int) -> BigInt {
    if (k < 0 or k > n) {
        return make_zero();
    }
    let chosen = min(k, n - k);
    var result = make_one();
    var index: int = 1;
    while (index <= chosen) {
        result = divide_small(multiply_small(result, n - chosen + index), index).quotient;
        index += 1;
    }
    result.normalise();
    return result;
}


// A stack-based bytecode virtual machine for a small dynamic language.
//
// The design follows the classic single-pass compiler / register-less VM
// layout: a `Chunk` holds a flat instruction array plus a constant pool, a
// `CallFrame` records the return address and the base of the local window,
// and `VM::run` walks the instruction stream with an explicit dispatch
// cascade. The language has no `switch`, so every dispatch site below is a
// hand-rolled `if op == OpCode::X { } else { ... }` chain. The nested
// `else` blocks are written on the same line as the enclosing brace so the
// chain stays readable instead of drifting a hundred columns to the right.
//
// Values are dynamically typed and reference-counted objects are tracked by
// a mark-sweep collector rooted at the value stack, the frame array and the
// globals table. Fractional numbers are represented as fixed-point integers
// scaled by FIXED_SCALE; the VM never sees a floating point value.
namespace vm;

// --- Tunables ------------------------------------------------------------

let STACK_MAX: int = 4096;
let FRAMES_MAX: int = 256;
let UPVALUE_MAX: int = 128;
let CONSTANTS_MAX: int = 65536;
let LOCALS_MAX: int = 256;

// Fixed-point scale: a "number" value of 1500 means 1.5.
let FIXED_SCALE: int = 1000;

// Bit masks used when packing a 24 bit operand next to an 8 bit opcode.
let OPCODE_MASK: int = 255;            // 0xFF
let OPERAND_MASK: int = 16777215;      // 0xFFFFFF
let OPERAND_SHIFT: int = 8;
let SHORT_MASK: int = 65535;           // 0xFFFF
let BYTE_BITS: int = 8;

// Collector heuristics.
let GC_INITIAL_THRESHOLD: int = 1048576;
let GC_GROWTH_PERCENT: int = 200;
let GC_MIN_THRESHOLD: int = 8192;
let GC_GRAY_INITIAL: int = 64;

// --- Value model ---------------------------------------------------------

choice ValueKind {
    Nil,
    Bool,
    Number,
    Object,
}

choice ObjectKind {
    String,
    Array,
    Map,
    Function,
    Closure,
    Upvalue,
    Native,
    BoundMethod,
    Instance,
    Class,
}

// The garbage collected header shared by every heap object. Real objects
// embed one of these as their first field so the collector can walk them
// without knowing the concrete type.
class Obj {
    var kind: ObjectKind = ObjectKind.String;
    var marked: bool = false;
    // Intrusive linked list of every object the collector knows about.
    var next: int = -1;
    // Index into VM::objects; -1 means "not yet registered".
    var handle: int = -1;
}

// A dynamically typed slot. Only one payload field is meaningful at a time
// and `kind` says which; the VM asserts on every access.
class Value {

    fn is_nil(self) -> bool {
        return self.kind == ValueKind.Nil;
    }

    fn is_bool(self) -> bool {
        return self.kind == ValueKind.Bool;
    }

    fn is_number(self) -> bool {
        return self.kind == ValueKind.Number;
    }

    fn is_object(self) -> bool {
        return self.kind == ValueKind.Object;
    }

    // Everything except `nil` and `false` is truthy, matching the source
    // language's semantics.
    fn is_truthy(self) -> bool {
        if (self.kind == ValueKind.Nil) {
            return false;
        } else {
            if (self.kind == ValueKind.Bool) {
                return self.boolean;
            } else {
                return true;
            }
        }
    }

    fn as_number(self) -> int {
        Assert(self.kind == ValueKind.Number);
        return self.number;
    }

    fn as_object(self) -> int {
        Assert(self.kind == ValueKind.Object);
        return self.object;
    }

    var kind: ValueKind = ValueKind.Nil;
    var boolean: bool = false;
    var number: int = 0;
    // Handle into VM::objects rather than a raw pointer, so the collector
    // may relocate the object table without patching the stack.
    var object: int = -1;
}

fn make_nil() -> Value {
    var v: Value;
    v.kind = ValueKind.Nil;
    return v;
}

fn make_bool(b: bool) -> Value {
    var v: Value;
    v.kind = ValueKind.Bool;
    v.boolean = b;
    return v;
}

fn make_number(n: int) -> Value {
    var v: Value;
    v.kind = ValueKind.Number;
    v.number = n;
    return v;
}

fn make_object(handle: int) -> Value {
    var v: Value;
    v.kind = ValueKind.Object;
    v.object = handle;
    return v;
}

fn values_equal(a: Value, b: Value) -> bool {
    if (a.kind != b.kind) {
        return false;
    }
    if (a.kind == ValueKind.Nil) {
        return true;
    } else {
        if (a.kind == ValueKind.Bool) {
            return a.boolean == b.boolean;
        } else {
            if (a.kind == ValueKind.Number) {
                return a.number == b.number;
            } else {
                return a.object == b.object;
            }
        }
    }
}

// --- Instruction set -----------------------------------------------------

// The complete instruction set. Values are fixed because serialized
// chunks are written to disk; never renumber an existing opcode, only
// append. The trailing comment on each line is the byte as it appears
// in a hex dump of the code section.
choice OpCode {
    // Constants, literals and raw stack shuffling.
    Constant,                         // 0x00
    ConstantLong,                     // 0x01
    Nil,                              // 0x02
    True,                             // 0x03
    False,                            // 0x04
    Pop,                              // 0x05
    PopN,                             // 0x06
    Dup,                              // 0x07
    Swap,                             // 0x08
    Rotate,                           // 0x09

    // Locals, globals, upvalues, properties and subscripts.
    GetLocal,                        // 0x0A
    SetLocal,                        // 0x0B
    GetGlobal,                       // 0x0C
    SetGlobal,                       // 0x0D
    DefineGlobal,                    // 0x0E
    GetUpvalue,                      // 0x0F
    SetUpvalue,                      // 0x10
    GetProperty,                     // 0x11
    SetProperty,                     // 0x12
    GetIndex,                        // 0x13
    SetIndex,                        // 0x14

    // Comparison; every one of these pops two and pushes a bool.
    Equal,                           // 0x15
    NotEqual,                        // 0x16
    Greater,                         // 0x17
    GreaterEqual,                    // 0x18
    Less,                            // 0x19
    LessEqual,                       // 0x1A

    // Binary arithmetic on fixed-point numbers.
    Add,                             // 0x1B
    Subtract,                        // 0x1C
    Multiply,                        // 0x1D
    Divide,                          // 0x1E
    Modulo,                          // 0x1F
    Power,                           // 0x20

    // Unary operators; they rewrite the slot in place.
    Negate,                          // 0x21
    Increment,                       // 0x22
    Decrement,                       // 0x23
    Not,                             // 0x24

    // Bitwise operators. Operands are truncated to integers first.
    BitAnd,                          // 0x25
    BitOr,                           // 0x26
    BitXor,                          // 0x27
    BitNot,                          // 0x28
    ShiftLeft,                       // 0x29
    ShiftRight,                      // 0x2A
    ShiftRightLogical,               // 0x2B

    // Control flow. The operand is an absolute instruction index.
    Jump,                            // 0x2C
    JumpIfFalse,                     // 0x2D
    JumpIfTrue,                      // 0x2E
    JumpIfNil,                       // 0x2F
    JumpIfNotNil,                    // 0x30
    Loop,                            // 0x31

    // Call forms. The operand is the argument count.
    Call,                            // 0x32
    Invoke,                          // 0x33
    TailCall,                        // 0x34
    CallNative,                      // 0x35

    // Closure construction and function exit.
    Closure,                         // 0x36
    CloseUpvalue,                    // 0x37
    Return,                          // 0x38
    ReturnNil,                       // 0x39

    // Array intrinsics.
    NewArray,                        // 0x3A
    ArrayPush,                       // 0x3B
    ArrayLength,                     // 0x3C
    ArraySlice,                      // 0x3D
    ArrayConcat,                     // 0x3E

    // Map intrinsics.
    NewMap,                          // 0x3F
    MapInsert,                       // 0x40
    MapLookup,                       // 0x41
    MapErase,                        // 0x42
    MapLength,                       // 0x43

    // Builtins, diagnostics and terminators.
    Concat,                          // 0x44
    Length,                          // 0x45
    TypeOf,                          // 0x46
    Print,                           // 0x47
    Assert,                          // 0x48
    Import,                          // 0x49
    Nop,                             // 0x4A
    Halt,                            // 0x4B
}

// A decoded instruction. The on-disk form packs `op` into the low byte and
// `operand` into the upper three bytes of a single word; `extra` is only
// materialised for the two-operand forms such as OpCode::Invoke.
class Instruction {

    fn packed(self) -> int {
        return (self.operand << OPERAND_SHIFT) | (self.opcode_byte() & OPCODE_MASK);
    }

    fn opcode_byte(self) -> int {
        return self.raw & OPCODE_MASK;
    }

    fn is_jump(self) -> bool {
        if (self.op == OpCode.Jump) {
            return true;
        }
        if (self.op == OpCode.JumpIfFalse) {
            return true;
        }
        if (self.op == OpCode.JumpIfTrue) {
            return true;
        }
        if (self.op == OpCode.JumpIfNil) {
            return true;
        }
        if (self.op == OpCode.JumpIfNotNil) {
            return true;
        }
        return self.op == OpCode.Loop;
    }

    var op: OpCode = OpCode.Nop;
    var operand: int = 0;
    var extra: int = 0;
    var raw: int = 0;
    var line: int = 0;
}

fn decode(raw: int) -> Instruction {
    var ins: Instruction;
    ins.raw = raw;
    ins.operand = (raw >> OPERAND_SHIFT) & OPERAND_MASK;
    return ins;
}

// Run-length encoded line table: `count` consecutive instructions all
// originate from source line `line`.
class LineRun {
    var line: int = 0;
    var count: int = 0;
}

// --- Chunks --------------------------------------------------------------

// A compiled unit: code, the constant pool it indexes into, and enough
// debug information to reconstruct a stack trace.
class Chunk {

    fn size(self) -> int {
        return self.code.size();
    }

    fn empty(self) -> bool {
        return self.code.empty();
    }

    fn write(ref self, op: OpCode, operand: int, line: int) -> int {
        var ins: Instruction;
        ins.op = op;
        ins.operand = operand;
        ins.line = line;
        ins.raw = ins.packed();
        self.code.push_back(ins);
        self.note_line(line);
        return self.code.size() - 1;
    }

    fn write_simple(ref self, op: OpCode, line: int) -> int {
        return self.write(op, 0, line);
    }

    fn write_invoke(ref self, name_slot: int, argc: int, line: int) -> int {
        let index = self.write(OpCode.Invoke, name_slot, line);
        let ref slot: auto = self.code.at(index);
        slot.extra = argc;
        return index;
    }

    // Append to the run-length encoded line table.
    fn note_line(ref self, line: int) {
        if (self.lines.empty()) {
            self.lines.push_back(LineRun({.line = line, .count = 1}));
            return;
        }
        let ref last: auto = self.lines.back();
        if (last.line == line) {
            last.count += 1;
        } else {
            self.lines.push_back(LineRun({.line = line, .count = 1}));
        }
    }

    fn line_at(self, offset: int) -> int {
        var seen: int = 0;
        for (run in self.lines) {
            seen += run.count;
            if (offset < seen) {
                return run.line;
            }
        }
        return 0;
    }

    // Interning: identical constants share a slot so the pool stays small.
    fn add_constant(ref self, value: Value) -> int {
        var i: int = 0;
        while (i < self.constants.size()) {
            if (values_equal(self.constants.at(i), value)) {
                return i;
            }
            i += 1;
        }
        Assert(self.constants.size() < CONSTANTS_MAX);
        self.constants.push_back(value);
        return self.constants.size() - 1;
    }

    fn constant_at(self, index: int) -> ref const Value {
        Assert(index >= 0);
        Assert(index < self.constants.size());
        return self.constants.at(index);
    }

    fn patch_jump(ref self, offset: int, target: int) {
        let ref slot: auto = self.code.at(offset);
        Assert(slot.is_jump());
        slot.operand = target;
        slot.raw = slot.packed();
    }

    fn emit_loop(ref self, start: int, line: int) -> int {
        return self.write(OpCode.Loop, start, line);
    }

    fn clear(ref self) {
        self.code.clear();
        self.constants.clear();
        self.lines.clear();
    }

    var code: vector(Instruction);
    var constants: vector(Value);
    var lines: vector(LineRun);
    var name: string;
    var arity: int = 0;
    var upvalue_count: int = 0;
}

// --- Disassembly ---------------------------------------------------------

// Canonical mnemonic for every opcode, used by the disassembler and by
// the error reporter. There is no `switch` in the language, so this is a
// straight cascade; the nested `else` blocks are all closed in one run at
// the bottom of the function.
fn opcode_name(op: OpCode) -> string {
    // constants and stack shuffling
    if (op == OpCode.Constant) {
        return "OP_CONSTANT";
    } else { if (op == OpCode.ConstantLong) {
        return "OP_CONSTANT_LONG";
    } else { if (op == OpCode.Nil) {
        return "OP_NIL";
    } else { if (op == OpCode.True) {
        return "OP_TRUE";
    } else { if (op == OpCode.False) {
        return "OP_FALSE";
    } else { if (op == OpCode.Pop) {
        return "OP_POP";
    } else { if (op == OpCode.PopN) {
        return "OP_POP_N";
    } else { if (op == OpCode.Dup) {
        return "OP_DUP";
    } else { if (op == OpCode.Swap) {
        return "OP_SWAP";
    } else { if (op == OpCode.Rotate) {
        return "OP_ROTATE";
    // variable access
    } else { if (op == OpCode.GetLocal) {
        return "OP_GET_LOCAL";
    } else { if (op == OpCode.SetLocal) {
        return "OP_SET_LOCAL";
    } else { if (op == OpCode.GetGlobal) {
        return "OP_GET_GLOBAL";
    } else { if (op == OpCode.SetGlobal) {
        return "OP_SET_GLOBAL";
    } else { if (op == OpCode.DefineGlobal) {
        return "OP_DEFINE_GLOBAL";
    } else { if (op == OpCode.GetUpvalue) {
        return "OP_GET_UPVALUE";
    } else { if (op == OpCode.SetUpvalue) {
        return "OP_SET_UPVALUE";
    } else { if (op == OpCode.GetProperty) {
        return "OP_GET_PROPERTY";
    } else { if (op == OpCode.SetProperty) {
        return "OP_SET_PROPERTY";
    } else { if (op == OpCode.GetIndex) {
        return "OP_GET_INDEX";
    } else { if (op == OpCode.SetIndex) {
        return "OP_SET_INDEX";
    // comparison
    } else { if (op == OpCode.Equal) {
        return "OP_EQUAL";
    } else { if (op == OpCode.NotEqual) {
        return "OP_NOT_EQUAL";
    } else { if (op == OpCode.Greater) {
        return "OP_GREATER";
    } else { if (op == OpCode.GreaterEqual) {
        return "OP_GREATER_EQUAL";
    } else { if (op == OpCode.Less) {
        return "OP_LESS";
    } else { if (op == OpCode.LessEqual) {
        return "OP_LESS_EQUAL";
    // binary arithmetic
    } else { if (op == OpCode.Add) {
        return "OP_ADD";
    } else { if (op == OpCode.Subtract) {
        return "OP_SUBTRACT";
    } else { if (op == OpCode.Multiply) {
        return "OP_MULTIPLY";
    } else { if (op == OpCode.Divide) {
        return "OP_DIVIDE";
    } else { if (op == OpCode.Modulo) {
        return "OP_MODULO";
    } else { if (op == OpCode.Power) {
        return "OP_POWER";
    // unary operators
    } else { if (op == OpCode.Negate) {
        return "OP_NEGATE";
    } else { if (op == OpCode.Increment) {
        return "OP_INCREMENT";
    } else { if (op == OpCode.Decrement) {
        return "OP_DECREMENT";
    } else { if (op == OpCode.Not) {
        return "OP_NOT";
    // bitwise
    } else { if (op == OpCode.BitAnd) {
        return "OP_BIT_AND";
    } else { if (op == OpCode.BitOr) {
        return "OP_BIT_OR";
    } else { if (op == OpCode.BitXor) {
        return "OP_BIT_XOR";
    } else { if (op == OpCode.BitNot) {
        return "OP_BIT_NOT";
    } else { if (op == OpCode.ShiftLeft) {
        return "OP_SHIFT_LEFT";
    } else { if (op == OpCode.ShiftRight) {
        return "OP_SHIFT_RIGHT";
    } else { if (op == OpCode.ShiftRightLogical) {
        return "OP_SHIFT_RIGHT_LOGICAL";
    // control flow
    } else { if (op == OpCode.Jump) {
        return "OP_JUMP";
    } else { if (op == OpCode.JumpIfFalse) {
        return "OP_JUMP_IF_FALSE";
    } else { if (op == OpCode.JumpIfTrue) {
        return "OP_JUMP_IF_TRUE";
    } else { if (op == OpCode.JumpIfNil) {
        return "OP_JUMP_IF_NIL";
    } else { if (op == OpCode.JumpIfNotNil) {
        return "OP_JUMP_IF_NOT_NIL";
    } else { if (op == OpCode.Loop) {
        return "OP_LOOP";
    // calls
    } else { if (op == OpCode.Call) {
        return "OP_CALL";
    } else { if (op == OpCode.Invoke) {
        return "OP_INVOKE";
    } else { if (op == OpCode.TailCall) {
        return "OP_TAIL_CALL";
    } else { if (op == OpCode.CallNative) {
        return "OP_CALL_NATIVE";
    // closures and returns
    } else { if (op == OpCode.Closure) {
        return "OP_CLOSURE";
    } else { if (op == OpCode.CloseUpvalue) {
        return "OP_CLOSE_UPVALUE";
    } else { if (op == OpCode.Return) {
        return "OP_RETURN";
    } else { if (op == OpCode.ReturnNil) {
        return "OP_RETURN_NIL";
    // arrays
    } else { if (op == OpCode.NewArray) {
        return "OP_NEW_ARRAY";
    } else { if (op == OpCode.ArrayPush) {
        return "OP_ARRAY_PUSH";
    } else { if (op == OpCode.ArrayLength) {
        return "OP_ARRAY_LENGTH";
    } else { if (op == OpCode.ArraySlice) {
        return "OP_ARRAY_SLICE";
    } else { if (op == OpCode.ArrayConcat) {
        return "OP_ARRAY_CONCAT";
    // maps
    } else { if (op == OpCode.NewMap) {
        return "OP_NEW_MAP";
    } else { if (op == OpCode.MapInsert) {
        return "OP_MAP_INSERT";
    } else { if (op == OpCode.MapLookup) {
        return "OP_MAP_LOOKUP";
    } else { if (op == OpCode.MapErase) {
        return "OP_MAP_ERASE";
    } else { if (op == OpCode.MapLength) {
        return "OP_MAP_LENGTH";
    // builtins and terminators
    } else { if (op == OpCode.Concat) {
        return "OP_CONCAT";
    } else { if (op == OpCode.Length) {
        return "OP_LENGTH";
    } else { if (op == OpCode.TypeOf) {
        return "OP_TYPE_OF";
    } else { if (op == OpCode.Print) {
        return "OP_PRINT";
    } else { if (op == OpCode.Assert) {
        return "OP_ASSERT";
    } else { if (op == OpCode.Import) {
        return "OP_IMPORT";
    } else { if (op == OpCode.Nop) {
        return "OP_NOP";
    } else { if (op == OpCode.Halt) {
        return "OP_HALT";
    } else {
        // Unreachable for a well-formed chunk, but the chunk verifier
        // calls this on raw bytes read straight off disk.
        return "OP_UNKNOWN";
    }
    } } } } } } } } } } } } } } } } } } }
    } } } } } } } } } } } } } } } } } } }
    } } } } } } } } } } } } } } } } } } }
    } } } } } } } } } } } } } } } } } }
}

// How many operands follow the opcode byte in the serialized form. Grouped
// rather than fully expanded because the answer only takes three values.
fn opcode_operand_count(op: OpCode) -> int {
    if (op == OpCode.Invoke) {
        // Constant slot for the method name plus the argument count.
        return 2;
    }
    if (op == OpCode.Constant or op == OpCode.ConstantLong or op == OpCode.PopN) {
        return 1;
    }
    if (op == OpCode.Rotate or op == OpCode.GetLocal or op == OpCode.SetLocal) {
        return 1;
    }
    if (op == OpCode.GetGlobal or op == OpCode.SetGlobal or op == OpCode.DefineGlobal) {
        return 1;
    }
    if (op == OpCode.GetUpvalue or op == OpCode.SetUpvalue) {
        return 1;
    }
    if (op == OpCode.GetProperty or op == OpCode.SetProperty) {
        return 1;
    }
    if (op == OpCode.Jump or op == OpCode.JumpIfFalse or op == OpCode.JumpIfTrue) {
        return 1;
    }
    if (op == OpCode.JumpIfNil or op == OpCode.JumpIfNotNil or op == OpCode.Loop) {
        return 1;
    }
    if (op == OpCode.Call or op == OpCode.TailCall or op == OpCode.CallNative) {
        return 1;
    }
    if (op == OpCode.Closure or op == OpCode.NewArray or op == OpCode.NewMap) {
        return 1;
    }
    if (op == OpCode.Assert or op == OpCode.Import) {
        return 1;
    }
    return 0;
}

// What the operand means, for the annotated disassembly listing.
choice OperandKind {
    None,
    ConstantSlot,
    LocalSlot,
    UpvalueSlot,
    GlobalSlot,
    JumpTarget,
    ArgumentCount,
    Count,
}

fn opcode_operand_kind(op: OpCode) -> OperandKind {
    if (op == OpCode.Constant or op == OpCode.ConstantLong) {
        return OperandKind.ConstantSlot;
    }
    if (op == OpCode.GetProperty or op == OpCode.SetProperty or op == OpCode.Invoke) {
        return OperandKind.ConstantSlot;
    }
    if (op == OpCode.GetLocal or op == OpCode.SetLocal) {
        return OperandKind.LocalSlot;
    }
    if (op == OpCode.GetUpvalue or op == OpCode.SetUpvalue) {
        return OperandKind.UpvalueSlot;
    }
    if (op == OpCode.GetGlobal or op == OpCode.SetGlobal or op == OpCode.DefineGlobal) {
        return OperandKind.GlobalSlot;
    }
    if (op == OpCode.Jump or op == OpCode.JumpIfFalse or op == OpCode.JumpIfTrue) {
        return OperandKind.JumpTarget;
    }
    if (op == OpCode.JumpIfNil or op == OpCode.JumpIfNotNil or op == OpCode.Loop) {
        return OperandKind.JumpTarget;
    }
    if (op == OpCode.Call or op == OpCode.TailCall or op == OpCode.CallNative) {
        return OperandKind.ArgumentCount;
    }
    if (op == OpCode.PopN or op == OpCode.Rotate) {
        return OperandKind.Count;
    }
    if (op == OpCode.NewArray or op == OpCode.NewMap) {
        return OperandKind.Count;
    }
    return OperandKind.None;
}

fn operand_kind_name(kind: OperandKind) -> string {
    if (kind == OperandKind.ConstantSlot) {
        return "const";
    } else { if (kind == OperandKind.LocalSlot) {
        return "local";
    } else { if (kind == OperandKind.UpvalueSlot) {
        return "upval";
    } else { if (kind == OperandKind.GlobalSlot) {
        return "global";
    } else { if (kind == OperandKind.JumpTarget) {
        return "->";
    } else { if (kind == OperandKind.ArgumentCount) {
        return "argc";
    } else { if (kind == OperandKind.Count) {
        return "n";
    } else {
        return "";
    }
    } } } } } }
}

// Net effect of an instruction on the value stack depth. The verifier walks
// the chunk with this to prove the stack never underflows.
fn stack_effect(op: OpCode, operand: int) -> int {
    if (op == OpCode.PopN) {
        return -operand;
    }
    if (op == OpCode.Call or op == OpCode.TailCall or op == OpCode.CallNative) {
        return -operand;
    }
    if (op == OpCode.Invoke) {
        return -operand;
    }
    if (op == OpCode.NewArray) {
        return 1 - operand;
    }
    if (op == OpCode.NewMap) {
        return 1 - operand * 2;
    }
    if (op == OpCode.SetIndex or op == OpCode.MapInsert) {
        return -2;
    }
    if (op == OpCode.ArraySlice) {
        return -2;
    }
    if (is_binary_op(op)) {
        return -1;
    }
    if (is_unary_op(op)) {
        return 0;
    }
    if (pushes_value(op)) {
        return 1;
    }
    if (pops_value(op)) {
        return -1;
    }
    return 0;
}

fn is_binary_op(op: OpCode) -> bool {
    if (op == OpCode.Add or op == OpCode.Subtract or op == OpCode.Multiply) {
        return true;
    }
    if (op == OpCode.Divide or op == OpCode.Modulo or op == OpCode.Power) {
        return true;
    }
    if (op == OpCode.Equal or op == OpCode.NotEqual) {
        return true;
    }
    if (op == OpCode.Greater or op == OpCode.GreaterEqual) {
        return true;
    }
    if (op == OpCode.Less or op == OpCode.LessEqual) {
        return true;
    }
    if (op == OpCode.BitAnd or op == OpCode.BitOr or op == OpCode.BitXor) {
        return true;
    }
    if (op == OpCode.ShiftLeft or op == OpCode.ShiftRight) {
        return true;
    }
    if (op == OpCode.ShiftRightLogical or op == OpCode.Concat) {
        return true;
    }
    return op == OpCode.GetIndex or op == OpCode.ArrayConcat;
}

fn is_unary_op(op: OpCode) -> bool {
    if (op == OpCode.Negate or op == OpCode.Not or op == OpCode.BitNot) {
        return true;
    }
    if (op == OpCode.Increment or op == OpCode.Decrement) {
        return true;
    }
    if (op == OpCode.Length or op == OpCode.TypeOf or op == OpCode.ArrayLength) {
        return true;
    }
    return op == OpCode.MapLength;
}

fn pushes_value(op: OpCode) -> bool {
    if (op == OpCode.Constant or op == OpCode.ConstantLong) {
        return true;
    }
    if (op == OpCode.Nil or op == OpCode.True or op == OpCode.False) {
        return true;
    }
    if (op == OpCode.Dup or op == OpCode.Closure or op == OpCode.Import) {
        return true;
    }
    return op == OpCode.GetLocal or op == OpCode.GetGlobal or op == OpCode.GetUpvalue;
}

fn pops_value(op: OpCode) -> bool {
    if (op == OpCode.Pop or op == OpCode.Print or op == OpCode.Assert) {
        return true;
    }
    if (op == OpCode.DefineGlobal or op == OpCode.SetProperty) {
        return true;
    }
    if (op == OpCode.JumpIfFalse or op == OpCode.JumpIfTrue) {
        return true;
    }
    if (op == OpCode.ArrayPush or op == OpCode.MapLookup or op == OpCode.MapErase) {
        return true;
    }
    return op == OpCode.CloseUpvalue or op == OpCode.Return;
}

// Render a single instruction as `0042  12 OP_GET_LOCAL   local 3`.
fn disassemble_instruction(chunk: Chunk, offset: int) -> string {
    let ref ins: auto = chunk.code.at(offset);
    var text = to_string(offset);
    text.append("  ");
    text.append(to_string(chunk.line_at(offset)));
    text.append("  ");
    text.append(opcode_name(ins.op));
    let count = opcode_operand_count(ins.op);
    if (count > 0) {
        text.append(" ");
        text.append(operand_kind_name(opcode_operand_kind(ins.op)));
        text.append(" ");
        text.append(to_string(ins.operand));
    }
    if (count > 1) {
        text.append(" argc ");
        text.append(to_string(ins.extra));
    }
    return text;
}

fn disassemble_chunk(chunk: Chunk) {
    println(chunk.name);
    var depth: int = 0;
    for (i in range(0, chunk.size())) {
        println(disassemble_instruction(chunk, i));
        let ref ins: auto = chunk.code.at(i);
        depth += stack_effect(ins.op, ins.operand);
        Assert(depth >= 0);
    }
    println("-- end of chunk --");
}

// --- Heap objects --------------------------------------------------------

// Interned string object. `hash` is cached because the globals table and the
// property lookup path both key on it.
class ObjString {

    fn size(self) -> int {
        return self.text.size();
    }

    fn rehash(ref self) {
        self.hash = hash_of(self.text);
    }

    var header: Obj;
    var text: string;
    var hash: int = 0;
}

// A growable value array. `items` is the only field the collector has to
// trace, but it may be arbitrarily deep so tracing is iterative.
class ObjArray {

    fn size(self) -> int {
        return self.items.size();
    }

    fn in_bounds(self, index: int) -> bool {
        return index >= 0 and index < self.items.size();
    }

    fn at(ref self, index: int) -> ref Value {
        Assert(self.in_bounds(index));
        return self.items.at(index);
    }

    var header: Obj;
    var items: vector(Value);
}

// Key/value pair storage for OpCode::NewMap. Keys are restricted to strings
// and numbers by the compiler, so a linear scan is good enough in practice.
class ObjMap {

    fn size(self) -> int {
        return self.keys.size();
    }

    fn find(self, key: Value) -> int {
        for (i in range(0, self.keys.size())) {
            if (values_equal(self.keys.at(i), key)) {
                return i;
            }
        }
        return -1;
    }

    var header: Obj;
    var keys: vector(Value);
    var values: vector(Value);
}

// A compiled function before it is captured into a closure.
class ObjFunction {

    fn name(self) -> ref const string {
        return self.chunk.name;
    }

    var header: Obj;
    var chunk: Chunk;
    var arity: int = 0;
    var upvalue_count: int = 0;
    var is_variadic: bool = false;
}

// An upvalue is either open (pointing at a live stack slot) or closed
// (owning its value). `location` is -1 once the upvalue has been closed.
class ObjUpvalue {

    fn is_open(self) -> bool {
        return self.location >= 0;
    }

    fn read(ref self) -> ref Value {
        return self.closed;
    }

    var header: Obj;
    var location: int = -1;
    var closed: Value;
    var next_open: int = -1;
}

// A function plus the upvalues it captured at the point of creation.
class ObjClosure {

    fn arity(self) -> int {
        return self.function.arity;
    }

    var header: Obj;
    var function: ObjFunction;
    var upvalues: vector(int);
}

// A builtin implemented outside the VM. `slot` indexes the native table.
class ObjNative {
    var header: Obj;
    var slot: int = 0;
    var arity: int = 0;
    var name: string;
}

// --- Call frames ---------------------------------------------------------

// One activation record. `slot_base` is the index in VM::stack of local 0;
// arguments were pushed by the caller and become the first locals.
class CallFrame {

    fn local(ref self, index: int) -> int {
        Assert(index >= 0);
        Assert(index < LOCALS_MAX);
        return self.slot_base + index;
    }

    fn advance(ref self) -> int {
        let here = self.ip;
        self.ip += 1;
        return here;
    }

    fn jump_to(ref self, target: int) {
        Assert(target >= 0);
        self.ip = target;
    }

    // Index into VM::closures rather than a borrow, so a frame may outlive
    // the borrow checker's view of the closure table during a collection.
    var closure: int = -1;
    var ip: int = 0;
    var slot_base: int = 0;
    var argument_count: int = 0;
    var is_tail: bool = false;
}

choice InterpretResult {
    Ok,
    CompileError,
    RuntimeError,
    Halted,
}

// --- The virtual machine -------------------------------------------------

// The interpreter. One instance owns the value stack, the frame array, the
// globals table and every heap object reachable from them.
class VM {

    // --- Stack primitives ------------------------------------------------

    fn push(ref self, value: Value) {
        Assert(self.stack_top < STACK_MAX);
        self.stack.push_back(value);
        self.stack_top += 1;
    }

    fn pop(ref self) -> Value {
        Assert(self.stack_top > 0);
        self.stack_top -= 1;
        let value = self.stack.back();
        self.stack.pop_back();
        return value;
    }

    fn pop_n(ref self, count: int) {
        var i: int = 0;
        while (i < count) {
            Discard(self.pop());
            i += 1;
        }
    }

    // `distance` counts from the top: peek(0) is the topmost slot.
    fn peek(ref self, distance: int) -> ref Value {
        Assert(distance < self.stack_top);
        return self.stack.at(self.stack_top - 1 - distance);
    }

    fn store_slot(ref self, index: int, value: Value) {
        Assert(index >= 0);
        Assert(index < self.stack_top);
        let ref slot: auto = self.stack.at(index);
        slot.kind = value.kind;
        slot.boolean = value.boolean;
        slot.number = value.number;
        slot.object = value.object;
    }

    fn swap_top(ref self) {
        let a = self.pop();
        let b = self.pop();
        self.push(a);
        self.push(b);
    }

    // Move the slot `depth` below the top up to the top.
    fn rotate(ref self, depth: int) {
        if (depth <= 0) {
            return;
        }
        let lifted = self.stack.at(self.stack_top - 1 - depth);
        var i = self.stack_top - 1 - depth;
        while (i < self.stack_top - 1) {
            self.store_slot(i, self.stack.at(i + 1));
            i += 1;
        }
        self.store_slot(self.stack_top - 1, lifted);
    }

    fn reset_stack(ref self) {
        self.stack.clear();
        self.stack_top = 0;
        self.frame_count = 0;
        self.open_upvalues.clear();
    }

    // --- Diagnostics -----------------------------------------------------

    fn runtime_error(ref self, message: string, line: int) {
        var text = string();
        text.append("runtime error: ");
        text.append(message);
        text.append(" (line ");
        text.append(to_string(line));
        text.append(")");
        println(text);
        self.print_backtrace();
        self.had_error = true;
    }

    fn print_backtrace(self) {
        var i = self.frame_count - 1;
        while (i >= 0) {
            let ref frame: auto = self.frames.at(i);
            var line = string();
            line.append("  at frame ");
            line.append(to_string(i));
            line.append(" ip ");
            line.append(to_string(frame.ip));
            println(line);
            i -= 1;
        }
    }

    fn print_stack(self) {
        for (value in self.stack) {
            print(self.to_display(value));
            print(" ");
        }
        println("");
    }

    // --- Globals ---------------------------------------------------------

    fn load_global(ref self, name: Value) {
        let key = self.string_of(name);
        if (not self.globals.contains(key)) {
            self.runtime_error("undefined variable", 0);
            return;
        }
        self.push(self.globals.at(key));
    }

    fn assign_global(ref self, name: Value) {
        let key = self.string_of(name);
        if (not self.globals.contains(key)) {
            self.runtime_error("assignment to undefined variable", 0);
            return;
        }
        Discard(self.globals.insert(key, self.peek(0)));
    }

    fn define_global(ref self, name: Value) {
        Discard(self.globals.insert(self.string_of(name), self.pop()));
    }

    fn string_of(self, value: Value) -> string {
        Assert(value.is_object());
        return self.strings_by_handle.at(value.object);
    }

    // --- Properties and subscripts ---------------------------------------

    fn get_property(ref self, name: Value) {
        let target = self.pop();
        if (not target.is_object()) {
            self.runtime_error("only objects have properties", 0);
            return;
        }
        self.push(self.lookup_field(target.object, self.string_of(name)));
    }

    fn set_property(ref self, name: Value) {
        let value = self.pop();
        let target = self.peek(0);
        if (not target.is_object()) {
            self.runtime_error("only objects have properties", 0);
            return;
        }
        self.store_field(target.object, self.string_of(name), value);
    }

    fn lookup_field(ref self, handle: int, name: string) -> Value {
        Discard(handle);
        Discard(name);
        return make_nil();
    }

    fn store_field(ref self, handle: int, name: string, value: Value) {
        Discard(handle);
        Discard(name);
        Discard(value);
    }

    fn index_get(ref self) {
        let key = self.pop();
        let target = self.pop();
        if (not target.is_object()) {
            self.runtime_error("value is not indexable", 0);
            return;
        }
        let ref container: auto = self.arrays.at(target.object);
        let index = key.as_number() / FIXED_SCALE;
        if (not container.in_bounds(index)) {
            self.runtime_error("index out of range", 0);
            return;
        }
        self.push(container.at(index));
    }

    fn index_set(ref self) {
        let value = self.pop();
        let key = self.pop();
        let target = self.pop();
        let ref container: auto = self.arrays.at(target.object);
        let index = key.as_number() / FIXED_SCALE;
        if (not container.in_bounds(index)) {
            self.runtime_error("index out of range", 0);
            return;
        }
        let ref slot: auto = container.at(index);
        slot.kind = value.kind;
        slot.number = value.number;
        slot.object = value.object;
        self.push(value);
    }

    // --- Comparison ------------------------------------------------------

    fn compare_equal(ref self, invert: bool) {
        let b = self.pop();
        let a = self.pop();
        let same = values_equal(a, b);
        if (invert) {
            self.push(make_bool(not same));
        } else {
            self.push(make_bool(same));
        }
    }

    fn compare_order(ref self, op: OpCode) {
        let b = self.pop();
        let a = self.pop();
        if (not a.is_number() or not b.is_number()) {
            self.runtime_error("operands must be numbers", 0);
            return;
        }
        let l = a.as_number();
        let r = b.as_number();
        if (op == OpCode.Greater) {
            self.push(make_bool(l > r));
        } else { if (op == OpCode.GreaterEqual) {
            self.push(make_bool(l >= r));
        } else { if (op == OpCode.Less) {
            self.push(make_bool(l < r));
        } else {
            self.push(make_bool(l <= r));
        }
        } }
    }

    // --- Arithmetic ------------------------------------------------------

    // All numbers are fixed-point with FIXED_SCALE fractional units, so
    // multiplication and division need a rescale afterwards.
    fn arith(ref self, op: OpCode) {
        let b = self.pop();
        let a = self.pop();
        if (not a.is_number() or not b.is_number()) {
            self.runtime_error("operands must be numbers", 0);
            return;
        }
        let l = a.as_number();
        let r = b.as_number();
        if (op == OpCode.Add) {
            self.push(make_number(l + r));
        } else { if (op == OpCode.Subtract) {
            self.push(make_number(l - r));
        } else { if (op == OpCode.Multiply) {
            self.push(make_number(l * r / FIXED_SCALE));
        } else { if (op == OpCode.Divide) {
            self.push(make_number(l * FIXED_SCALE / r));
        } else { if (op == OpCode.Modulo) {
            self.push(make_number(l % r));
        } else {
            self.push(make_number(self.power(l, r / FIXED_SCALE)));
        }
        } } } }
    }

    fn power(self, base_: int, exponent: int) -> int {
        var result = FIXED_SCALE;
        var i: int = 0;
        while (i < exponent) {
            result = result * base_ / FIXED_SCALE;
            i += 1;
        }
        return result;
    }

    fn negate(ref self) {
        let value = self.pop();
        if (not value.is_number()) {
            self.runtime_error("operand must be a number", 0);
            return;
        }
        self.push(make_number(-value.as_number()));
    }

    fn adjust(ref self, delta: int) {
        let value = self.pop();
        self.push(make_number(value.as_number() + delta));
    }

    // --- Bitwise ---------------------------------------------------------

    fn bitwise(ref self, op: OpCode) {
        let b = self.pop();
        let a = self.pop();
        let l = a.as_number() / FIXED_SCALE;
        let r = b.as_number() / FIXED_SCALE;
        if (op == OpCode.BitAnd) {
            self.push(make_number((l & r) * FIXED_SCALE));
        } else { if (op == OpCode.BitOr) {
            self.push(make_number((l | r) * FIXED_SCALE));
        } else { if (op == OpCode.BitXor) {
            self.push(make_number((l ^ r) * FIXED_SCALE));
        } else { if (op == OpCode.ShiftLeft) {
            self.push(make_number((l << r) * FIXED_SCALE));
        } else { if (op == OpCode.ShiftRight) {
            self.push(make_number((l >> r) * FIXED_SCALE));
        } else {
            self.push(make_number(((l >> r) & OPERAND_MASK) * FIXED_SCALE));
        }
        } } } }
    }

    fn bit_not(ref self) {
        let value = self.pop();
        let raw = value.as_number() / FIXED_SCALE;
        self.push(make_number(^raw * FIXED_SCALE));
    }

    // --- Strings, arrays and maps ----------------------------------------

    fn concat_strings(ref self) {
        let b = self.pop();
        let a = self.pop();
        var joined = self.string_of(a);
        joined.append(self.string_of(b));
        self.push(self.intern(joined));
    }

    fn intern(ref self, text: string) -> Value {
        if (self.interned.contains(text)) {
            return make_object(self.interned.at(text));
        }
        let handle = self.allocate(ObjectKind.String, text.size());
        Discard(self.interned.insert(text, handle));
        Discard(self.strings_by_handle.insert(handle, text));
        return make_object(handle);
    }

    fn new_array(ref self, count: int) {
        let handle = self.allocate(ObjectKind.Array, count);
        let ref target: auto = self.arrays.at(handle);
        var i: int = 0;
        while (i < count) {
            target.items.push_back(self.peek(count - 1 - i));
            i += 1;
        }
        self.pop_n(count);
        self.push(make_object(handle));
    }

    fn array_push(ref self) {
        let value = self.pop();
        let ref target: auto = self.arrays.at(self.peek(0).as_object());
        target.items.push_back(value);
    }

    fn array_length(ref self) {
        let target = self.pop();
        self.push(make_number(self.arrays.at(target.as_object()).size() * FIXED_SCALE));
    }

    fn array_slice(ref self) {
        let length = self.pop().as_number() / FIXED_SCALE;
        let begin = self.pop().as_number() / FIXED_SCALE;
        let source = self.pop();
        let handle = self.allocate(ObjectKind.Array, length);
        let ref target: auto = self.arrays.at(handle);
        let ref original: auto = self.arrays.at(source.as_object());
        for (i in range(begin, begin + length)) {
            if (original.in_bounds(i)) {
                target.items.push_back(original.at(i));
            }
        }
        self.push(make_object(handle));
    }

    fn array_concat(ref self) {
        let b = self.pop();
        let a = self.pop();
        let handle = self.allocate(ObjectKind.Array, 0);
        let ref target: auto = self.arrays.at(handle);
        for (value in self.arrays.at(a.as_object()).items) {
            target.items.push_back(value);
        }
        for (value in self.arrays.at(b.as_object()).items) {
            target.items.push_back(value);
        }
        self.push(make_object(handle));
    }

    fn new_map(ref self, pair_count: int) {
        let handle = self.allocate(ObjectKind.Map, pair_count);
        let ref target: auto = self.maps.at(handle);
        var i: int = 0;
        while (i < pair_count) {
            target.values.push_back(self.pop());
            target.keys.push_back(self.pop());
            i += 1;
        }
        self.push(make_object(handle));
    }

    fn map_insert(ref self) {
        let value = self.pop();
        let key = self.pop();
        let ref target: auto = self.maps.at(self.peek(0).as_object());
        let existing = target.find(key);
        if (existing >= 0) {
            self.store_slot_in(target.values, existing, value);
        } else {
            target.keys.push_back(key);
            target.values.push_back(value);
        }
    }

    fn store_slot_in(ref self, ref slots: vector(Value), index: int, value: Value) {
        let ref slot: auto = slots.at(index);
        slot.kind = value.kind;
        slot.number = value.number;
        slot.object = value.object;
        slot.boolean = value.boolean;
    }

    fn map_lookup(ref self) {
        let key = self.pop();
        let ref target: auto = self.maps.at(self.pop().as_object());
        let index = target.find(key);
        if (index < 0) {
            self.push(make_nil());
        } else {
            self.push(target.values.at(index));
        }
    }

    fn map_erase(ref self) {
        let key = self.pop();
        let ref target: auto = self.maps.at(self.peek(0).as_object());
        let index = target.find(key);
        if (index >= 0) {
            target.keys.erase(index);
            target.values.erase(index);
        }
    }

    fn map_length(ref self) {
        let target = self.pop();
        self.push(make_number(self.maps.at(target.as_object()).size() * FIXED_SCALE));
    }

    fn length_of(ref self) {
        let value = self.peek(0);
        if (not value.is_object()) {
            self.runtime_error("value has no length", 0);
            return;
        }
        let kind = self.objects.at(value.as_object()).kind;
        if (kind == ObjectKind.Array) {
            self.array_length();
        } else { if (kind == ObjectKind.Map) {
            self.map_length();
        } else {
            let text = self.string_of(self.pop());
            self.push(make_number(text.size() * FIXED_SCALE));
        }
        }
    }

    fn type_of(ref self) {
        let value = self.pop();
        self.push(self.intern(self.type_name(value)));
    }

    fn type_name(self, value: Value) -> string {
        if (value.is_nil()) {
            return "nil";
        } else { if (value.is_bool()) {
            return "bool";
        } else { if (value.is_number()) {
            return "number";
        } else {
            return object_kind_name(self.objects.at(value.object).kind);
        }
        } }
    }

    fn to_display(self, value: Value) -> string {
        if (value.is_nil()) {
            return "nil";
        }
        if (value.is_bool()) {
            if (value.boolean) {
                return "true";
            } else {
                return "false";
            }
        }
        if (value.is_number()) {
            return format_fixed(value.number);
        }
        return self.string_of(value);
    }

    fn import_module(ref self, name: Value) -> Value {
        let key = self.string_of(name);
        if (self.modules.contains(key)) {
            return self.modules.at(key);
        }
        self.runtime_error("no such module", 0);
        return make_nil();
    }

    // A cooperative yield point so long-running loops stay interruptible.
    fn check_interrupt(ref self) {
        self.steps += 1;
        if (self.steps % 4096 == 0) {
            if (self.interrupted) {
                self.runtime_error("execution interrupted", 0);
            }
        }
    }

    // --- Calls -----------------------------------------------------------

    fn call_value(ref self, callee: Value, argument_count: int) {
        if (not callee.is_object()) {
            self.runtime_error("can only call functions", 0);
            return;
        }
        let kind = self.objects.at(callee.as_object()).kind;
        if (kind == ObjectKind.Closure) {
            self.call_closure(callee.as_object(), argument_count, false);
        } else { if (kind == ObjectKind.Native) {
            self.call_native(argument_count);
        } else { if (kind == ObjectKind.BoundMethod) {
            self.call_closure(self.bound_target(callee.as_object()), argument_count, false);
        } else {
            self.runtime_error("value is not callable", 0);
        }
        } }
    }

    fn call_closure(ref self, handle: int, argument_count: int, tail: bool) {
        let ref closure: auto = self.closures.at(handle);
        if (argument_count != closure.arity()) {
            self.runtime_error("wrong number of arguments", 0);
            return;
        }
        if (self.frame_count >= FRAMES_MAX) {
            self.runtime_error("stack overflow", 0);
            return;
        }
        var frame: CallFrame;
        frame.closure = handle;
        frame.ip = 0;
        frame.slot_base = self.stack_top - argument_count - 1;
        frame.argument_count = argument_count;
        frame.is_tail = tail;
        self.frames.push_back(frame);
        self.frame_count += 1;
    }

    fn tail_call(ref self, argument_count: int) {
        let callee = self.peek(argument_count);
        let ref frame: auto = self.frames.at(self.frame_count - 1);
        let base_ = frame.slot_base;
        self.frame_count -= 1;
        self.frames.pop_back();
        self.shift_arguments(base_, argument_count);
        self.call_closure(callee.as_object(), argument_count, true);
    }

    // Slide the pending arguments down over the frame being replaced.
    fn shift_arguments(ref self, base_: int, argument_count: int) {
        var i: int = 0;
        while (i <= argument_count) {
            self.store_slot(base_ + i, self.stack.at(self.stack_top - argument_count - 1 + i));
            i += 1;
        }
        self.stack_top = base_ + argument_count + 1;
    }

    fn invoke(ref self, name: Value, argument_count: int) {
        let receiver = self.peek(argument_count);
        if (not receiver.is_object()) {
            self.runtime_error("only objects have methods", 0);
            return;
        }
        let method = self.lookup_field(receiver.as_object(), self.string_of(name));
        self.call_value(method, argument_count);
    }

    fn call_native(ref self, argument_count: int) {
        let callee = self.peek(argument_count);
        let slot = self.natives.at(callee.as_object()).slot;
        let result = self.dispatch_native(slot, argument_count);
        self.pop_n(argument_count + 1);
        self.push(result);
    }

    fn dispatch_native(ref self, slot: int, argument_count: int) -> Value {
        Discard(slot);
        Discard(argument_count);
        return make_nil();
    }

    fn bound_target(self, handle: int) -> int {
        return self.bound_methods.at(handle);
    }

    fn return_from(ref self, result: Value) {
        let ref frame: auto = self.frames.at(self.frame_count - 1);
        let base_ = frame.slot_base;
        self.close_upvalues(base_);
        self.frame_count -= 1;
        self.frames.pop_back();
        while (self.stack_top > base_) {
            Discard(self.pop());
        }
        if (self.frame_count > 0) {
            self.push(result);
        } else {
            self.last_result = result;
        }
    }

    // --- Upvalues --------------------------------------------------------

    // Capture the stack slot at `index`, reusing an existing open upvalue if
    // one already points there. The open list is kept sorted by slot so the
    // scan stops early.
    fn capture_upvalue(ref self, index: int) -> int {
        for (handle in self.open_upvalues) {
            if (self.upvalues.at(handle).location == index) {
                return handle;
            }
        }
        let created = self.allocate(ObjectKind.Upvalue, 0);
        let ref target: auto = self.upvalues.at(created);
        target.location = index;
        self.open_upvalues.push_back(created);
        return created;
    }

    // Close every open upvalue at or above `floor`, copying the live stack
    // slot into the upvalue itself.
    fn close_upvalues(ref self, floor: int) {
        var i: int = 0;
        while (i < self.open_upvalues.size()) {
            let handle = self.open_upvalues.at(i);
            let ref target: auto = self.upvalues.at(handle);
            if (target.location >= floor) {
                target.closed = self.stack.at(target.location);
                target.location = -1;
                self.open_upvalues.erase(i);
            } else {
                i += 1;
            }
        }
    }

    fn read_upvalue(ref self, closure: int, index: int) -> Value {
        let handle = self.closures.at(closure).upvalues.at(index);
        let ref target: auto = self.upvalues.at(handle);
        if (target.is_open()) {
            return self.stack.at(target.location);
        }
        return target.closed;
    }

    fn write_upvalue(ref self, closure: int, index: int, value: Value) {
        let handle = self.closures.at(closure).upvalues.at(index);
        let ref target: auto = self.upvalues.at(handle);
        if (target.is_open()) {
            self.store_slot(target.location, value);
        } else {
            target.closed = value;
        }
    }

    fn make_closure(ref self, function: Value, frame: CallFrame) {
        let handle = self.allocate(ObjectKind.Closure, 0);
        let ref created: auto = self.closures.at(handle);
        created.function = self.functions.at(function.as_object());
        for (i in range(0, created.function.upvalue_count)) {
            let ref descriptor: auto = self.upvalue_plan.at(i);
            if (descriptor.first) {
                created.upvalues.push_back(self.capture_upvalue(frame.slot_base + descriptor.second));
            } else {
                created.upvalues.push_back(self.closures.at(frame.closure).upvalues.at(descriptor.second));
            }
        }
        self.push(make_object(handle));
    }

    // --- The interpreter loop --------------------------------------------

    // Ordering in the cascade below matters for throughput: the hottest
    // opcodes (constants, locals, arithmetic) are tested first and the cold
    // ones (import, halt) last. There is no `switch` in the language, so
    // this is a plain chain of equality tests whose nested `else` blocks are
    // all closed in one run of braces at the bottom.
    fn run(ref self) -> InterpretResult {
        self.steps = 0;
        self.had_error = false;
        while (true) {
            if (self.frame_count == 0) {
                break;
            }
            let ref frame: auto = self.frames.at(self.frame_count - 1);
            let ref chunk: auto = self.closures.at(frame.closure).function.chunk;
            if (frame.ip >= chunk.size()) {
                // Falling off the end of a chunk is an implicit `return nil`.
                self.return_from(make_nil());
                continue;
            }
            if (self.trace_execution) {
                self.print_stack();
                println(disassemble_instruction(chunk, frame.ip));
            }
            let ref ins: auto = chunk.code.at(frame.ip);
            let op = ins.op;
            frame.ip += 1;
            if (self.bytes_allocated > self.next_gc) {
                self.collect_garbage();
            }

            // --- constants, literals and stack shuffling ---
            if (op == OpCode.Constant) {
                self.push(chunk.constant_at(ins.operand));
            } else { if (op == OpCode.ConstantLong) {
                self.push(chunk.constant_at(ins.operand & OPERAND_MASK));
            } else { if (op == OpCode.Nil) {
                self.push(make_nil());
            } else { if (op == OpCode.True) {
                self.push(make_bool(true));
            } else { if (op == OpCode.False) {
                self.push(make_bool(false));
            } else { if (op == OpCode.Pop) {
                Discard(self.pop());
            } else { if (op == OpCode.PopN) {
                self.pop_n(ins.operand);
            } else { if (op == OpCode.Dup) {
                self.push(self.peek(0));
            } else { if (op == OpCode.Swap) {
                self.swap_top();
            } else { if (op == OpCode.Rotate) {
                // Bring the n-th slot to the top, sliding the rest down.
                self.rotate(ins.operand);
            // --- variable access: locals, globals, upvalues, members ---
            } else { if (op == OpCode.GetLocal) {
                self.push(self.stack.at(frame.local(ins.operand)));
            } else { if (op == OpCode.SetLocal) {
                self.store_slot(frame.local(ins.operand), self.peek(0));
            } else { if (op == OpCode.GetGlobal) {
                self.load_global(chunk.constant_at(ins.operand));
            } else { if (op == OpCode.SetGlobal) {
                self.assign_global(chunk.constant_at(ins.operand));
            } else { if (op == OpCode.DefineGlobal) {
                self.define_global(chunk.constant_at(ins.operand));
            } else { if (op == OpCode.GetUpvalue) {
                self.push(self.read_upvalue(frame.closure, ins.operand));
            } else { if (op == OpCode.SetUpvalue) {
                self.write_upvalue(frame.closure, ins.operand, self.peek(0));
            } else { if (op == OpCode.GetProperty) {
                self.get_property(chunk.constant_at(ins.operand));
            } else { if (op == OpCode.SetProperty) {
                self.set_property(chunk.constant_at(ins.operand));
            } else { if (op == OpCode.GetIndex) {
                self.index_get();
            } else { if (op == OpCode.SetIndex) {
                self.index_set();
            // --- comparison ---
            } else { if (op == OpCode.Equal) {
                self.compare_equal(false);
            } else { if (op == OpCode.NotEqual) {
                self.compare_equal(true);
            } else { if (op == OpCode.Greater) {
                self.compare_order(OpCode.Greater);
            } else { if (op == OpCode.GreaterEqual) {
                self.compare_order(OpCode.GreaterEqual);
            } else { if (op == OpCode.Less) {
                self.compare_order(OpCode.Less);
            } else { if (op == OpCode.LessEqual) {
                self.compare_order(OpCode.LessEqual);
            // --- arithmetic; operands are fixed-point, scaled by FIXED_SCALE ---
            } else { if (op == OpCode.Add) {
                // Add is overloaded: strings concatenate, numbers add.
                if (self.peek(0).is_object() and self.peek(1).is_object()) {
                    self.concat_strings();
                } else {
                    self.arith(OpCode.Add);
                }
            } else { if (op == OpCode.Subtract) {
                self.arith(OpCode.Subtract);
            } else { if (op == OpCode.Multiply) {
                self.arith(OpCode.Multiply);
            } else { if (op == OpCode.Divide) {
                if (self.peek(0).as_number() == 0) {
                    self.runtime_error("division by zero", chunk.line_at(frame.ip));
                } else {
                    self.arith(OpCode.Divide);
                }
            } else { if (op == OpCode.Modulo) {
                if (self.peek(0).as_number() == 0) {
                    self.runtime_error("modulo by zero", chunk.line_at(frame.ip));
                } else {
                    self.arith(OpCode.Modulo);
                }
            } else { if (op == OpCode.Power) {
                self.arith(OpCode.Power);
            // --- unary operators ---
            } else { if (op == OpCode.Negate) {
                self.negate();
            } else { if (op == OpCode.Increment) {
                self.adjust(FIXED_SCALE);
            } else { if (op == OpCode.Decrement) {
                self.adjust(-FIXED_SCALE);
            } else { if (op == OpCode.Not) {
                let value = self.pop();
                self.push(make_bool(not value.is_truthy()));
            // --- bitwise; operands are truncated to whole integers first ---
            } else { if (op == OpCode.BitAnd) {
                self.bitwise(OpCode.BitAnd);
            } else { if (op == OpCode.BitOr) {
                self.bitwise(OpCode.BitOr);
            } else { if (op == OpCode.BitXor) {
                self.bitwise(OpCode.BitXor);
            } else { if (op == OpCode.BitNot) {
                self.bit_not();
            } else { if (op == OpCode.ShiftLeft) {
                self.bitwise(OpCode.ShiftLeft);
            } else { if (op == OpCode.ShiftRight) {
                self.bitwise(OpCode.ShiftRight);
            } else { if (op == OpCode.ShiftRightLogical) {
                self.bitwise(OpCode.ShiftRightLogical);
            // --- control flow ---
            } else { if (op == OpCode.Jump) {
                frame.jump_to(ins.operand);
            } else { if (op == OpCode.JumpIfFalse) {
                let cond = self.pop();
                if (not cond.is_truthy()) {
                    frame.jump_to(ins.operand);
                }
            } else { if (op == OpCode.JumpIfTrue) {
                let cond = self.pop();
                if (cond.is_truthy()) {
                    frame.jump_to(ins.operand);
                }
            } else { if (op == OpCode.JumpIfNil) {
                // Peeks rather than pops: this backs the nil-coalescing lowering.
                if (self.peek(0).is_nil()) {
                    frame.jump_to(ins.operand);
                }
            } else { if (op == OpCode.JumpIfNotNil) {
                if (not self.peek(0).is_nil()) {
                    frame.jump_to(ins.operand);
                }
            } else { if (op == OpCode.Loop) {
                // Backwards edge; the operand is an absolute index, not a delta.
                frame.jump_to(ins.operand);
                self.check_interrupt();
            // --- calls ---
            } else { if (op == OpCode.Call) {
                self.call_value(self.peek(ins.operand), ins.operand);
            } else { if (op == OpCode.Invoke) {
                self.invoke(chunk.constant_at(ins.operand), ins.extra);
            } else { if (op == OpCode.TailCall) {
                // Reuses the current frame instead of pushing a new one.
                self.tail_call(ins.operand);
            } else { if (op == OpCode.CallNative) {
                self.call_native(ins.operand);
            // --- closures and returns ---
            } else { if (op == OpCode.Closure) {
                self.make_closure(chunk.constant_at(ins.operand), frame);
            } else { if (op == OpCode.CloseUpvalue) {
                self.close_upvalues(self.stack_top - 1);
                Discard(self.pop());
            } else { if (op == OpCode.Return) {
                self.return_from(self.pop());
            } else { if (op == OpCode.ReturnNil) {
                self.return_from(make_nil());
            // --- arrays ---
            } else { if (op == OpCode.NewArray) {
                self.new_array(ins.operand);
            } else { if (op == OpCode.ArrayPush) {
                self.array_push();
            } else { if (op == OpCode.ArrayLength) {
                self.array_length();
            } else { if (op == OpCode.ArraySlice) {
                self.array_slice();
            } else { if (op == OpCode.ArrayConcat) {
                self.array_concat();
            // --- maps ---
            } else { if (op == OpCode.NewMap) {
                self.new_map(ins.operand);
            } else { if (op == OpCode.MapInsert) {
                self.map_insert();
            } else { if (op == OpCode.MapLookup) {
                self.map_lookup();
            } else { if (op == OpCode.MapErase) {
                self.map_erase();
            } else { if (op == OpCode.MapLength) {
                self.map_length();
            // --- builtins, diagnostics and terminators ---
            } else { if (op == OpCode.Concat) {
                self.concat_strings();
            } else { if (op == OpCode.Length) {
                self.length_of();
            } else { if (op == OpCode.TypeOf) {
                self.type_of();
            } else { if (op == OpCode.Print) {
                let value = self.pop();
                println(self.to_display(value));
            } else { if (op == OpCode.Assert) {
                let cond = self.pop();
                if (not cond.is_truthy()) {
                    self.runtime_error("assertion failed", ins.operand);
                }
            } else { if (op == OpCode.Import) {
                self.push(self.import_module(chunk.constant_at(ins.operand)));
            } else { if (op == OpCode.Nop) {
                // Alignment padding left behind by the peephole pass.
                Discard(ins.operand);
            } else { if (op == OpCode.Halt) {
                self.frame_count = 0;
                break;
            } else {
                // An opcode this build does not know about. Serialized chunks
                // carry a version stamp, so this only fires on corruption.
                self.runtime_error("unknown opcode", chunk.line_at(frame.ip));
            }
            } } } } } } } } } } } } } } } } } } }
            } } } } } } } } } } } } } } } } } } }
            } } } } } } } } } } } } } } } } } } }
            } } } } } } } } } } } } } } } } } }

            if (self.had_error) {
                self.reset_stack();
                return InterpretResult.RuntimeError;
            }
        }
        return InterpretResult.Ok;
    }

    // --- Allocation and the mark-sweep collector -------------------------

    // Every heap object is registered here so the sweep phase can walk them
    // all. Allocation is also the only place a collection can start, which
    // keeps the set of live roots easy to reason about.
    fn allocate(ref self, kind: ObjectKind, hint: int) -> int {
        self.bytes_allocated += 32 + hint * 16;
        if (self.bytes_allocated > self.next_gc) {
            self.collect_garbage();
        }
        var header: Obj;
        header.kind = kind;
        header.marked = false;
        header.handle = self.objects.size();
        self.objects.push_back(header);
        return header.handle;
    }

    fn collect_garbage(ref self) {
        let before = self.bytes_allocated;
        self.gray_stack.clear();
        self.mark_roots();
        self.trace_references();
        self.sweep();
        self.next_gc = self.bytes_allocated * GC_GROWTH_PERCENT / 100;
        if (self.next_gc < GC_MIN_THRESHOLD) {
            self.next_gc = GC_MIN_THRESHOLD;
        }
        if (self.trace_gc) {
            var line = string();
            line.append("gc: reclaimed ");
            line.append(to_string(before - self.bytes_allocated));
            line.append(" bytes");
            println(line);
        }
    }

    // Roots are the value stack, every live call frame, the open upvalue
    // list, the globals table and the module cache.
    fn mark_roots(ref self) {
        for (value in self.stack) {
            self.mark_value(value);
        }
        for (frame in self.frames) {
            if (frame.closure >= 0) {
                self.mark_object(frame.closure);
            }
        }
        for (handle in self.open_upvalues) {
            self.mark_object(handle);
        }
        for (entry in self.globals) {
            self.mark_value(entry.second);
        }
        for (entry in self.modules) {
            self.mark_value(entry.second);
        }
        self.mark_value(self.last_result);
    }

    fn mark_value(ref self, value: Value) {
        if (not value.is_object()) {
            return;
        }
        self.mark_object(value.object);
    }

    fn mark_object(ref self, handle: int) {
        if (handle < 0) {
            return;
        }
        let ref header: auto = self.objects.at(handle);
        if (header.marked) {
            return;
        }
        header.marked = true;
        self.gray_stack.push_back(handle);
    }

    // Tri-colour marking: gray objects still have unvisited children.
    fn trace_references(ref self) {
        while (not self.gray_stack.empty()) {
            let handle = self.gray_stack.back();
            self.gray_stack.pop_back();
            self.blacken_object(handle);
        }
    }

    fn blacken_object(ref self, handle: int) {
        let kind = self.objects.at(handle).kind;
        if (kind == ObjectKind.Array) {
            for (value in self.arrays.at(handle).items) {
                self.mark_value(value);
            }
        } else { if (kind == ObjectKind.Map) {
            for (value in self.maps.at(handle).keys) {
                self.mark_value(value);
            }
            for (value in self.maps.at(handle).values) {
                self.mark_value(value);
            }
        } else { if (kind == ObjectKind.Closure) {
            for (upvalue in self.closures.at(handle).upvalues) {
                self.mark_object(upvalue);
            }
            self.mark_chunk(self.closures.at(handle).function.chunk);
        } else { if (kind == ObjectKind.Upvalue) {
            self.mark_value(self.upvalues.at(handle).closed);
        } else { if (kind == ObjectKind.Function) {
            self.mark_chunk(self.functions.at(handle).chunk);
        } else { if (kind == ObjectKind.BoundMethod) {
            self.mark_object(self.bound_methods.at(handle));
        } else {
            // Strings and natives have no outgoing references.
            Discard(handle);
        }
        } } } } }
    }

    fn mark_chunk(ref self, chunk: Chunk) {
        for (value in chunk.constants) {
            self.mark_value(value);
        }
    }

    // Unmarked objects are released; survivors are cleared for the next
    // cycle. The object table itself is compacted lazily.
    fn sweep(ref self) {
        var i: int = 0;
        while (i < self.objects.size()) {
            let ref header: auto = self.objects.at(i);
            if (header.marked) {
                header.marked = false;
                i += 1;
            } else {
                self.free_object(i);
                i += 1;
            }
        }
    }

    fn free_object(ref self, handle: int) {
        let ref header: auto = self.objects.at(handle);
        self.bytes_allocated -= 32;
        if (header.kind == ObjectKind.Array) {
            self.arrays.at(handle).items.clear();
        } else { if (header.kind == ObjectKind.Map) {
            self.maps.at(handle).keys.clear();
            self.maps.at(handle).values.clear();
        } else { if (header.kind == ObjectKind.Closure) {
            self.closures.at(handle).upvalues.clear();
        } else {
            Discard(handle);
        }
        } }
        header.handle = -1;
    }

    // --- State -----------------------------------------------------------

    var stack: vector(Value);
    var stack_top: int = 0;
    var frames: vector(CallFrame);
    var frame_count: int = 0;

    var globals: map(string, Value);
    var modules: map(string, Value);
    var interned: map(string, int);
    var strings_by_handle: map(int, string);

    // Parallel object tables, indexed by the handle stored in a Value.
    var objects: vector(Obj);
    var arrays: vector(ObjArray);
    var maps: vector(ObjMap);
    var closures: vector(ObjClosure);
    var functions: vector(ObjFunction);
    var upvalues: vector(ObjUpvalue);
    var natives: vector(ObjNative);
    var bound_methods: vector(int);

    // Capture plan for the closure currently being built: `first` is true
    // when the upvalue comes from the enclosing frame's locals.
    var upvalue_plan: vector(pair(bool, int));
    var open_upvalues: vector(int);
    var gray_stack: vector(int);

    var bytes_allocated: int = 0;
    var next_gc: int = 1048576;
    var steps: int = 0;
    var last_result: Value;

    var had_error: bool = false;
    var interrupted: bool = false;
    var trace_execution: bool = false;
    var trace_gc: bool = false;
}

// --- Free helpers --------------------------------------------------------

fn object_kind_name(kind: ObjectKind) -> string {
    if (kind == ObjectKind.String) {
        return "string";
    } else { if (kind == ObjectKind.Array) {
        return "array";
    } else { if (kind == ObjectKind.Map) {
        return "map";
    } else { if (kind == ObjectKind.Function) {
        return "function";
    } else { if (kind == ObjectKind.Closure) {
        return "closure";
    } else { if (kind == ObjectKind.Upvalue) {
        return "upvalue";
    } else { if (kind == ObjectKind.Native) {
        return "native";
    } else { if (kind == ObjectKind.BoundMethod) {
        return "method";
    } else { if (kind == ObjectKind.Instance) {
        return "instance";
    } else {
        return "class";
    }
    } } } } } } } }
}

// Render a fixed-point number: 1500 becomes "1.500".
fn format_fixed(value: int) -> string {
    var text = string();
    if (value < 0) {
        text.append("-");
    }
    let magnitude = abs(value);
    text.append(to_string(magnitude / FIXED_SCALE));
    let fraction = magnitude % FIXED_SCALE;
    if (fraction != 0) {
        text.append(".");
        var divisor = FIXED_SCALE / 10;
        while (divisor > 0) {
            text.append(to_string((fraction / divisor) % 10));
            divisor /= 10;
        }
    }
    return text;
}

// --- Entry point ---------------------------------------------------------

// Load a top-level chunk into a fresh frame and run it to completion.
fn interpret(ref machine: VM, chunk: Chunk) -> InterpretResult {
    machine.reset_stack();
    let handle = machine.allocate(ObjectKind.Closure, 0);
    let ref entry: auto = machine.closures.at(handle);
    entry.function.chunk = chunk;
    entry.function.arity = 0;
    machine.push(make_object(handle));
    machine.call_closure(handle, 0, false);
    let result = machine.run();
    if (result == InterpretResult.RuntimeError) {
        println("execution aborted");
    }
    return result;
}

// Verify a chunk before running it: the stack depth must never go negative
// and every jump target must land inside the chunk.
fn verify_chunk(chunk: Chunk) -> bool {
    var depth: int = 0;
    for (i in range(0, chunk.size())) {
        let ref ins: auto = chunk.code.at(i);
        depth += stack_effect(ins.op, ins.operand);
        if (depth < 0) {
            return false;
        }
        if (ins.is_jump()) {
            if (ins.operand < 0 or ins.operand >= chunk.size()) {
                return false;
            }
        }
        if (opcode_operand_count(ins.op) > 0) {
            if (opcode_operand_kind(ins.op) == OperandKind.ConstantSlot) {
                if (ins.operand >= chunk.constants.size()) {
                    return false;
                }
            }
        }
    }
    Prove(depth >= 0);
    return true;
}


// A bitboard chess move generator.
//
// The board is represented twice over: a dense `squares` array that maps each
// of the 64 squares to a piece code, and a set of twelve bitboards (one per
// colour/kind pair) plus two colour unions and one occupancy union. Every
// query that a search needs -- "which knights of mine can reach e5", "is my
// king attacked", "which of my pieces are pinned" -- is then a handful of
// shifts, ands and population counts rather than a loop over squares.
//
// A bitboard is a 64 bit integer whose bit `s` is set when square `s` is
// occupied. Square numbering is little-endian rank-file: a1 is 0, h1 is 7,
// a8 is 56, h8 is 63, so `square = rank * 8 + file`. Shifting a bitboard
// north by one rank is `bb << 8`, south is `bb >> 8`; the east/west shifts
// additionally mask off the file that would wrap around the edge.
//
// Because the lexer only accepts plain decimal integer literals, every mask
// wider than a couple of digits is *built* at initialisation time by a loop
// that ors in `1 << square`, rather than being spelled out as a giant decimal
// constant. The handful of literals that survive carry a `// 0x..` comment.
//
// Nothing here allocates during move generation: the caller passes a
// MoveList that owns its storage and generation appends into it.
namespace chess;

// --- Geometry constants --------------------------------------------------

let BOARD_FILES: int = 8;
let BOARD_RANKS: int = 8;
let SQUARE_COUNT: int = 64;
let COLOR_COUNT: int = 2;
let PIECE_KIND_COUNT: int = 6;
let PIECE_CODE_COUNT: int = 12;

// Sentinel used wherever a square index is optional (en passant target,
// the square of a missing king, the "no pin" ray origin).
let NO_SQUARE: int = -1;

// Bit widths of the packed square index. A square needs six bits, which is
// what the move encoding below leans on heavily.
let SQUARE_BITS: int = 6;
let SQUARE_MASK: int = 63;             // 0x3F
let FILE_MASK_BITS: int = 7;           // 0x07
let RANK_SHIFT: int = 3;
let BYTE_MASK: int = 255;              // 0xFF
let WORD_MASK: int = 65535;            // 0xFFFF

// A bitboard with every bit set. Two's complement gives us all ones for the
// cost of a single character, which beats a twenty digit decimal literal.
let FULL_BOARD: int = -1;
let EMPTY_BOARD: int = 0;

// Directions, expressed as signed square deltas. The east/west members only
// behave when combined with the wrap masks below.
let DIR_NORTH: int = 8;
let DIR_SOUTH: int = -8;
let DIR_EAST: int = 1;
let DIR_WEST: int = -1;
let DIR_NORTH_EAST: int = 9;
let DIR_NORTH_WEST: int = 7;
let DIR_SOUTH_EAST: int = -7;
let DIR_SOUTH_WEST: int = -9;

// Ray indices into the RAY_ATTACKS table. The order matches the direction
// constants above so that a loop over 0..8 walks the compass clockwise from
// north.
let RAY_NORTH: int = 0;
let RAY_NORTH_EAST: int = 1;
let RAY_EAST: int = 2;
let RAY_SOUTH_EAST: int = 3;
let RAY_SOUTH: int = 4;
let RAY_SOUTH_WEST: int = 5;
let RAY_WEST: int = 6;
let RAY_NORTH_WEST: int = 7;
let RAY_COUNT: int = 8;

// The four rook rays and the four bishop rays, split so the sliding attack
// helpers can loop over exactly the ones they need.
let ROOK_RAY_COUNT: int = 4;
let BISHOP_RAY_COUNT: int = 4;

// Named squares that the castling code needs by hand.
let SQ_A1: int = 0;
let SQ_B1: int = 1;
let SQ_C1: int = 2;
let SQ_D1: int = 3;
let SQ_E1: int = 4;
let SQ_F1: int = 5;
let SQ_G1: int = 6;
let SQ_H1: int = 7;
let SQ_A8: int = 56;
let SQ_B8: int = 57;
let SQ_C8: int = 58;
let SQ_D8: int = 59;
let SQ_E8: int = 60;
let SQ_F8: int = 61;
let SQ_G8: int = 62;
let SQ_H8: int = 63;

// Castling right bits, one per castle.
let CASTLE_WHITE_KING: int = 1;        // 0x1
let CASTLE_WHITE_QUEEN: int = 2;       // 0x2
let CASTLE_BLACK_KING: int = 4;        // 0x4
let CASTLE_BLACK_QUEEN: int = 8;       // 0x8
let CASTLE_WHITE_ANY: int = 3;         // 0x3
let CASTLE_BLACK_ANY: int = 12;        // 0xC
let CASTLE_ALL: int = 15;              // 0xF
let CASTLE_NONE: int = 0;

// Move list sizing. 218 is the largest number of legal moves any legal
// position is known to admit; the extra headroom absorbs pseudo-legal moves
// that the legality filter later drops.
let MAX_MOVES: int = 256;
let MAX_PLY: int = 512;
let MAX_GAME_MOVES: int = 1024;

// Halfmove clock at which the fifty move rule fires (in plies).
let FIFTY_MOVE_PLIES: int = 100;

// ASCII code points, spelled in decimal because character arithmetic is
// what FEN parsing is made of.
let CHAR_ZERO: int = 48;               // '0'
let CHAR_NINE: int = 57;               // '9'
let CHAR_LOWER_A: int = 97;            // 'a'
let CHAR_LOWER_H: int = 104;           // 'h'
let CHAR_UPPER_A: int = 65;            // 'A'
let CHAR_SPACE: int = 32;              // ' '
let CHAR_SLASH: int = 47;              // '/'
let CHAR_DASH: int = 45;               // '-'
let CASE_BIT: int = 32;                // 0x20, the ASCII case flag

// --- Instrumentation ------------------------------------------------------

// Counters the perft driver prints. They are globals rather than fields so
// that the generator itself stays free of bookkeeping.
var generated_move_count: int = 0;
var legality_test_count: int = 0;
var attack_query_count: int = 0;
var make_move_count: int = 0;

// --- Enumerations ---------------------------------------------------------

// Side to move. The numeric values matter: they index the colour-indexed
// tables directly, and `1 - color` flips a side.
choice Color {
    White,
    Black,
    ColorNone,
}

// Piece kinds, ordered by convention from pawn to king. The value is the
// index into the per-kind bitboard array and into the material table.
choice PieceKind {
    Pawn,
    Knight,
    Bishop,
    Rook,
    Queen,
    King,
    KindNone,
}

// A piece code packs colour and kind: white pieces are 0..5, black pieces
// are 6..11, and 12 means "empty square".
choice PieceCode {
    WhitePawn,
    WhiteKnight,
    WhiteBishop,
    WhiteRook,
    WhiteQueen,
    WhiteKing,
    BlackPawn,
    BlackKnight,
    BlackBishop,
    BlackRook,
    BlackQueen,
    BlackKing,
    NoPiece,
}

// Move classification, stored in the four flag bits of an encoded move.
choice MoveKind {
    Quiet,
    DoublePush,
    KingCastle,
    QueenCastle,
    Capture,
    EnPassant,
    PromoKnight,
    PromoBishop,
    PromoRook,
    PromoQueen,
    PromoCaptureKnight,
    PromoCaptureBishop,
    PromoCaptureRook,
    PromoCaptureQueen,
}

// What a generation pass should emit.
choice GenKind {
    GenAll,
    GenCaptures,
    GenQuiets,
    GenEvasions,
}

// Terminal states the perft driver and the SAN formatter care about.
choice GameResult {
    Ongoing,
    WhiteWins,
    BlackWins,
    DrawStalemate,
    DrawFiftyMove,
    DrawInsufficient,
    DrawRepetition,
}

// --- Square, file and rank helpers ---------------------------------------

// Squares are little-endian rank-file: square = rank * 8 + file, so the file
// lives in the low three bits and the rank in the next three.
fn make_square(file: int, rank: int) -> int {
    return (rank << RANK_SHIFT) | (file & FILE_MASK_BITS);
}

fn file_of(square: int) -> int {
    return square & FILE_MASK_BITS;
}

fn rank_of(square: int) -> int {
    return (square >> RANK_SHIFT) & FILE_MASK_BITS;
}

// True when the index names a real square. Sliding generation relies on this
// only as a cheap first filter; the wrap check below does the real work.
fn square_valid(square: int) -> bool {
    return square >= 0 and square < SQUARE_COUNT;
}

// A one-step move from `from` to `to` is legal geometry only when it does not
// jump the board edge, i.e. when the file distance stays within `max_file`.
fn step_valid(from: int, to: int, max_file: int) -> bool {
    if (to < 0 or to >= SQUARE_COUNT) {
        return false;
    }
    let df = file_of(to) - file_of(from);
    var spread = df;
    if (spread < 0) {
        spread = -spread;
    }
    return spread <= max_file;
}

// Chebyshev distance, the metric a king actually walks in.
fn square_distance(a: int, b: int) -> int {
    var df = file_of(a) - file_of(b);
    var dr = rank_of(a) - rank_of(b);
    if (df < 0) {
        df = -df;
    }
    if (dr < 0) {
        dr = -dr;
    }
    if (df > dr) {
        return df;
    }
    return dr;
}

// Manhattan distance, used by the endgame king-proximity term.
fn manhattan_distance(a: int, b: int) -> int {
    var df = file_of(a) - file_of(b);
    var dr = rank_of(a) - rank_of(b);
    if (df < 0) {
        df = -df;
    }
    if (dr < 0) {
        dr = -dr;
    }
    return df + dr;
}

// Mirror a square across the horizontal axis: a1 becomes a8. The piece-square
// tables are stored from white's point of view and flipped for black with
// exactly this, which is why it is a single xor.
fn flip_rank(square: int) -> int {
    return square ^ 56;                   // 0x38, the rank bits
}

// Mirror across the vertical axis: a1 becomes h1.
fn flip_file(square: int) -> int {
    return square ^ 7;                    // 0x07, the file bits
}

// Rotate 180 degrees.
fn flip_square(square: int) -> int {
    return square ^ 63;                   // 0x3F, both halves at once
}

// The colour of a square, in the light/dark sense. Used by the opposite
// coloured bishops draw heuristic.
fn square_is_dark(square: int) -> bool {
    return ((file_of(square) + rank_of(square)) & 1) == 0;
}

// The rank a pawn of `color` starts on, and the rank it promotes on.
fn pawn_start_rank(color: Color) -> int {
    if (color == Color.White) {
        return 1;
    }
    return 6;
}

fn pawn_promotion_rank(color: Color) -> int {
    if (color == Color.White) {
        return 7;
    }
    return 0;
}

// The rank a double push lands on, which is also the only rank on which an
// en passant target square may ever appear.
fn pawn_double_rank(color: Color) -> int {
    if (color == Color.White) {
        return 3;
    }
    return 4;
}

// The forward direction for a pawn of `color`, as a square delta.
fn pawn_push_delta(color: Color) -> int {
    if (color == Color.White) {
        return DIR_NORTH;
    }
    return DIR_SOUTH;
}

// The rank from white's point of view, so that evaluation code can talk
// about "the seventh rank" without branching on colour.
fn relative_rank(color: Color, square: int) -> int {
    if (color == Color.White) {
        return rank_of(square);
    }
    return 7 - rank_of(square);
}

fn relative_square(color: Color, square: int) -> int {
    if (color == Color.White) {
        return square;
    }
    return flip_rank(square);
}

// --- Colour and piece code helpers ---------------------------------------

fn color_index(color: Color) -> int {
    if (color == Color.Black) {
        return 1;
    }
    return 0;
}

fn color_from_index(index: int) -> Color {
    if (index == 1) {
        return Color.Black;
    }
    return Color.White;
}

fn opposite_color(color: Color) -> Color {
    if (color == Color.White) {
        return Color.Black;
    }
    return Color.White;
}

fn kind_index(kind: PieceKind) -> int {
    if (kind == PieceKind.Pawn) {
        return 0;
    } else { if (kind == PieceKind.Knight) {
        return 1;
    } else { if (kind == PieceKind.Bishop) {
        return 2;
    } else { if (kind == PieceKind.Rook) {
        return 3;
    } else { if (kind == PieceKind.Queen) {
        return 4;
    } else { if (kind == PieceKind.King) {
        return 5;
    } else {
        return 6;
    } } } } } }
}

fn kind_from_index(index: int) -> PieceKind {
    if (index == 0) {
        return PieceKind.Pawn;
    } else { if (index == 1) {
        return PieceKind.Knight;
    } else { if (index == 2) {
        return PieceKind.Bishop;
    } else { if (index == 3) {
        return PieceKind.Rook;
    } else { if (index == 4) {
        return PieceKind.Queen;
    } else { if (index == 5) {
        return PieceKind.King;
    } else {
        return PieceKind.KindNone;
    } } } } } }
}

// Pack colour and kind into the 0..11 piece code used by `squares`.
fn make_piece(color: Color, kind: PieceKind) -> int {
    return color_index(color) * PIECE_KIND_COUNT + kind_index(kind);
}

fn piece_color(piece: int) -> Color {
    if (piece >= PIECE_CODE_COUNT or piece < 0) {
        return Color.ColorNone;
    }
    if (piece >= PIECE_KIND_COUNT) {
        return Color.Black;
    }
    return Color.White;
}

fn piece_kind(piece: int) -> PieceKind {
    if (piece >= PIECE_CODE_COUNT or piece < 0) {
        return PieceKind.KindNone;
    }
    return kind_from_index(piece % PIECE_KIND_COUNT);
}

fn piece_is_empty(piece: int) -> bool {
    return piece >= PIECE_CODE_COUNT or piece < 0;
}

// Slider classification, used by the pin detector to pick a ray family.
fn kind_is_slider(kind: PieceKind) -> bool {
    return kind == PieceKind.Bishop or kind == PieceKind.Rook or kind == PieceKind.Queen;
}

fn kind_is_diagonal_slider(kind: PieceKind) -> bool {
    return kind == PieceKind.Bishop or kind == PieceKind.Queen;
}

fn kind_is_straight_slider(kind: PieceKind) -> bool {
    return kind == PieceKind.Rook or kind == PieceKind.Queen;
}

// --- Raw bitboard primitives ---------------------------------------------

// The SWAR population count constants. These are the only wide literals in
// the file; everything else is assembled by a loop.
let SWAR_K1: int = 6148914691236517205;   // 0x5555555555555555
let SWAR_K2: int = 3689348814741910323;   // 0x3333333333333333
let SWAR_K4: int = 1085102592571150095;   // 0x0F0F0F0F0F0F0F0F
let SWAR_KF: int = 72340172838076673;     // 0x0101010101010101

// The de Bruijn sequence used by the forward bit scan, plus the shift that
// lifts the product's high six bits into place.
let DEBRUIJN64: int = 285870213051353481; // 0x03F79D71B4CB0A89
let DEBRUIJN_SHIFT: int = 58;

// Filled by init_debruijn_table(): index[(isolated * DEBRUIJN64) >> 58] is
// the square number of the isolated bit.
var DEBRUIJN_INDEX: vector(int) = vector(int)(SQUARE_COUNT);

// A single set bit at `square`.
fn square_bit(square: int) -> int {
    return 1 << square;
}

// Population count via the standard five-step SWAR fold. Each step halves
// the number of independent counters while doubling their width.
fn popcount(bb: int) -> int {
    var x = bb;
    x = x - ((x >> 1) & SWAR_K1);
    x = (x & SWAR_K2) + ((x >> 2) & SWAR_K2);
    x = (x + (x >> 4)) & SWAR_K4;
    x = x * SWAR_KF;
    return (x >> 56) & BYTE_MASK;
}

// A branch-free "more than one bit set" test: clearing the lowest set bit
// leaves zero exactly when the board was a singleton.
fn has_single_bit(bb: int) -> bool {
    return bb != 0 and (bb & (bb - 1)) == 0;
}

fn is_empty_board(bb: int) -> bool {
    return bb == 0;
}

// Isolate the least significant set bit. Two's complement makes `-bb` the
// complement plus one, so the and keeps exactly the lowest one bit.
fn lowest_bit(bb: int) -> int {
    return bb & -bb;
}

// Clear the least significant set bit.
fn clear_lowest_bit(bb: int) -> int {
    return bb & (bb - 1);
}

// Index of the least significant set bit, by de Bruijn multiplication.
fn bit_scan_forward(bb: int) -> int {
    Assert(bb != 0);
    let isolated = bb & -bb;
    let folded = (isolated * DEBRUIJN64) >> DEBRUIJN_SHIFT;
    return DEBRUIJN_INDEX.at(folded & SQUARE_MASK);
}

// Portable fallback used while the de Bruijn table is still being built.
fn bit_scan_forward_slow(bb: int) -> int {
    var x = bb;
    var index: int = 0;
    while (x != 0) {
        if ((x & 1) != 0) {
            return index;
        }
        x >>= 1;
        index += 1;
    }
    return NO_SQUARE;
}

// Index of the most significant set bit, found by smearing every bit to the
// right of the highest one and then counting the result.
fn bit_scan_reverse(bb: int) -> int {
    Assert(bb != 0);
    var x = bb;
    x |= x >> 1;
    x |= x >> 2;
    x |= x >> 4;
    x |= x >> 8;
    x |= x >> 16;
    x |= x >> 32;
    return popcount(x) - 1;
}

// Pop the lowest set bit out of `bb`, returning its square index. The caller
// keeps the residue, which is why `bb` is taken by unique reference.
fn pop_lowest_square(ref bb: int) -> int {
    let square = bit_scan_forward(*bb);
    *bb = clear_lowest_bit(*bb);
    return square;
}

// Reverse the bits of a bitboard, which rotates the board 180 degrees.
fn mirror_board(bb: int) -> int {
    var x = bb;
    x = ((x >> 1) & SWAR_K1) | ((x & SWAR_K1) << 1);
    x = ((x >> 2) & SWAR_K2) | ((x & SWAR_K2) << 2);
    x = ((x >> 4) & SWAR_K4) | ((x & SWAR_K4) << 4);
    x = ((x >> 8) & 71777214294589695) | ((x & 71777214294589695) << 8);
    x = ((x >> 16) & 281470681808895) | ((x & 281470681808895) << 16);
    x = (x >> 32) | (x << 32);
    return x;
}

// Swap the byte order, which flips the board vertically because each byte is
// one rank.
fn flip_vertical(bb: int) -> int {
    var x = bb;
    x = ((x >> 8) & 71777214294589695) | ((x & 71777214294589695) << 8);
    x = ((x >> 16) & 281470681808895) | ((x & 281470681808895) << 16);
    x = (x >> 32) | (x << 32);
    return x;
}

// --- Edge masks and directional shifts -----------------------------------

// One bit per square, so that hot code can index instead of shifting.
var SQUARE_BB: vector(int) = vector(int)(SQUARE_COUNT);

// FILE_MASKS[f] has every square on file f set; RANK_MASKS[r] likewise.
var FILE_MASKS: vector(int) = vector(int)(BOARD_FILES);
var RANK_MASKS: vector(int) = vector(int)(BOARD_RANKS);

// The union of file f-1 and file f+1, clipped at the edges. The pawn
// structure terms use it for isolated and neighbouring pawn tests.
var ADJACENT_FILES: vector(int) = vector(int)(BOARD_FILES);

// Complements of the outermost files, used to kill wrap-around in the
// east/west shifts.
var NOT_FILE_A: int = 0;
var NOT_FILE_H: int = 0;
var NOT_FILE_AB: int = 0;
var NOT_FILE_GH: int = 0;

// The board edge and the sixteen central squares, used by evaluation.
var BOARD_EDGES: int = 0;
var BOARD_CENTER: int = 0;
var LIGHT_SQUARES: int = 0;
var DARK_SQUARES: int = 0;

// Chebyshev distance between every pair of squares, precomputed because the
// endgame terms ask for it once per piece per node.
var DISTANCE_TABLE: vector(vector(int)) = vector(vector(int))(SQUARE_COUNT);

// Build every file, rank and edge mask with explicit nested loops rather
// than with wide decimal literals.
fn init_square_masks() {
    var square: int = 0;
    while (square < SQUARE_COUNT) {
        SQUARE_BB.at(square) = 1 << square;
        square += 1;
    }

    var file: int = 0;
    while (file < BOARD_FILES) {
        var mask: int = 0;
        var rank: int = 0;
        while (rank < BOARD_RANKS) {
            mask |= 1 << make_square(file, rank);
            rank += 1;
        }
        FILE_MASKS.at(file) = mask;
        file += 1;
    }

    var rank: int = 0;
    while (rank < BOARD_RANKS) {
        var mask: int = 0;
        var f: int = 0;
        while (f < BOARD_FILES) {
            mask |= 1 << make_square(f, rank);
            f += 1;
        }
        RANK_MASKS.at(rank) = mask;
        rank += 1;
    }

    var af: int = 0;
    while (af < BOARD_FILES) {
        var mask: int = 0;
        if (af > 0) {
            mask |= FILE_MASKS.at(af - 1);
        }
        if (af < BOARD_FILES - 1) {
            mask |= FILE_MASKS.at(af + 1);
        }
        ADJACENT_FILES.at(af) = mask;
        af += 1;
    }

    NOT_FILE_A = FULL_BOARD ^ FILE_MASKS.at(0);
    NOT_FILE_H = FULL_BOARD ^ FILE_MASKS.at(7);
    NOT_FILE_AB = FULL_BOARD ^ (FILE_MASKS.at(0) | FILE_MASKS.at(1));
    NOT_FILE_GH = FULL_BOARD ^ (FILE_MASKS.at(6) | FILE_MASKS.at(7));

    BOARD_EDGES = FILE_MASKS.at(0) | FILE_MASKS.at(7) | RANK_MASKS.at(0) | RANK_MASKS.at(7);
    BOARD_CENTER = (FILE_MASKS.at(2) | FILE_MASKS.at(3) | FILE_MASKS.at(4) | FILE_MASKS.at(5))
        & (RANK_MASKS.at(2) | RANK_MASKS.at(3) | RANK_MASKS.at(4) | RANK_MASKS.at(5));

    var light: int = 0;
    var dark: int = 0;
    var s: int = 0;
    while (s < SQUARE_COUNT) {
        if (square_is_dark(s)) {
            dark |= 1 << s;
        } else {
            light |= 1 << s;
        }
        s += 1;
    }
    LIGHT_SQUARES = light;
    DARK_SQUARES = dark;
}

// The de Bruijn index table: multiply each isolated bit by the sequence and
// record where the top six bits land.
fn init_debruijn_table() {
    var square: int = 0;
    while (square < SQUARE_COUNT) {
        let isolated = 1 << square;
        let folded = (isolated * DEBRUIJN64) >> DEBRUIJN_SHIFT;
        DEBRUIJN_INDEX.at(folded & SQUARE_MASK) = square;
        square += 1;
    }
}

// A full 64 by 64 distance matrix, filled by the obvious double loop.
fn init_distance_table() {
    var from: int = 0;
    while (from < SQUARE_COUNT) {
        DISTANCE_TABLE.at(from) = vector(int)(SQUARE_COUNT);
        var to: int = 0;
        while (to < SQUARE_COUNT) {
            DISTANCE_TABLE.at(from).at(to) = square_distance(from, to);
            to += 1;
        }
        from += 1;
    }
}

// Directional shifts. The north and south shifts cannot wrap because the
// bits simply fall off the end of the word; the lateral ones must first
// remove the file that would reappear on the other side.
fn shift_north(bb: int) -> int {
    return bb << 8;
}

fn shift_south(bb: int) -> int {
    return (bb >> 8) & 72057594037927935;   // 0x00FFFFFFFFFFFFFF
}

fn shift_east(bb: int) -> int {
    return (bb & NOT_FILE_H) << 1;
}

fn shift_west(bb: int) -> int {
    return (bb & NOT_FILE_A) >> 1;
}

fn shift_north_east(bb: int) -> int {
    return (bb & NOT_FILE_H) << 9;
}

fn shift_north_west(bb: int) -> int {
    return (bb & NOT_FILE_A) << 7;
}

fn shift_south_east(bb: int) -> int {
    return ((bb & NOT_FILE_H) >> 7) & 72057594037927935;
}

fn shift_south_west(bb: int) -> int {
    return ((bb & NOT_FILE_A) >> 9) & 72057594037927935;
}

// Shift by a compass index, so that the ray builders can loop.
fn shift_by_ray(bb: int, ray: int) -> int {
    if (ray == RAY_NORTH) {
        return shift_north(bb);
    } else { if (ray == RAY_NORTH_EAST) {
        return shift_north_east(bb);
    } else { if (ray == RAY_EAST) {
        return shift_east(bb);
    } else { if (ray == RAY_SOUTH_EAST) {
        return shift_south_east(bb);
    } else { if (ray == RAY_SOUTH) {
        return shift_south(bb);
    } else { if (ray == RAY_SOUTH_WEST) {
        return shift_south_west(bb);
    } else { if (ray == RAY_WEST) {
        return shift_west(bb);
    } else {
        return shift_north_west(bb);
    } } } } } } }
}

// Forward fill: smear every set bit north (or south) to the end of its file.
fn fill_north(bb: int) -> int {
    var x = bb;
    x |= x << 8;
    x |= x << 16;
    x |= x << 32;
    return x;
}

fn fill_south(bb: int) -> int {
    var x = bb;
    x |= (x >> 8) & 72057594037927935;
    x |= (x >> 16) & 281474976710655;       // 0x0000FFFFFFFFFFFF
    x |= (x >> 32) & 4294967295;            // 0x00000000FFFFFFFF
    return x;
}

// Every file that carries at least one bit, smeared over its whole length.
fn file_fill(bb: int) -> int {
    return fill_north(bb) | fill_south(bb);
}

// The squares strictly in front of `bb` for the given colour.
fn front_span(color: Color, bb: int) -> int {
    if (color == Color.White) {
        return fill_north(shift_north(bb));
    }
    return fill_south(shift_south(bb));
}

// --- Bitboard value type --------------------------------------------------

// A thin wrapper over the raw 64 bit word. The generator works on raw ints
// in its inner loops -- there is no reason to pay for a wrapper there -- but
// the board state and the public API hand out Bitboards so that a stray
// integer cannot be mistaken for a set of squares.
class Bitboard {

    fn raw(self) -> int {
        return self.bits;
    }

    fn empty(self) -> bool {
        return self.bits == 0;
    }

    fn any(self) -> bool {
        return self.bits != 0;
    }

    fn count(self) -> int {
        return popcount(self.bits);
    }

    fn single(self) -> bool {
        return has_single_bit(self.bits);
    }

    fn test(self, square: int) -> bool {
        return (self.bits & (1 << square)) != 0;
    }

    fn set(ref self, square: int) {
        self.bits |= 1 << square;
    }

    fn clear(ref self, square: int) {
        self.bits &= FULL_BOARD ^ (1 << square);
    }

    fn toggle(ref self, square: int) {
        self.bits ^= 1 << square;
    }

    // Move a bit from `from` to `to` in one xor, the operation make_move
    // performs more than any other.
    fn move_bit(ref self, from: int, to: int) {
        self.bits ^= (1 << from) | (1 << to);
    }

    fn lowest(self) -> int {
        if (self.bits == 0) {
            return NO_SQUARE;
        }
        return bit_scan_forward(self.bits);
    }

    fn highest(self) -> int {
        if (self.bits == 0) {
            return NO_SQUARE;
        }
        return bit_scan_reverse(self.bits);
    }

    fn pop_lowest(ref self) -> int {
        if (self.bits == 0) {
            return NO_SQUARE;
        }
        let square = bit_scan_forward(self.bits);
        self.bits &= self.bits - 1;
        return square;
    }

    fn union_with(self, other: Bitboard) -> Bitboard {
        return Bitboard({.bits = self.bits | other.bits});
    }

    fn intersect(self, other: Bitboard) -> Bitboard {
        return Bitboard({.bits = self.bits & other.bits});
    }

    fn difference(self, other: Bitboard) -> Bitboard {
        return Bitboard({.bits = self.bits & (FULL_BOARD ^ other.bits)});
    }

    fn complement(self) -> Bitboard {
        return Bitboard({.bits = FULL_BOARD ^ self.bits});
    }

    fn overlaps(self, other: Bitboard) -> bool {
        return (self.bits & other.bits) != 0;
    }

    fn mirrored(self) -> Bitboard {
        return Bitboard({.bits = mirror_board(self.bits)});
    }

    fn flipped(self) -> Bitboard {
        return Bitboard({.bits = flip_vertical(self.bits)});
    }

    // Render the board as eight lines of eight characters, rank eight first,
    // which is the layout a human expects to read.
    fn to_text(self) -> string {
        var out: string;
        var rank: int = BOARD_RANKS - 1;
        while (rank >= 0) {
            var file: int = 0;
            while (file < BOARD_FILES) {
                if (self.test(make_square(file, rank))) {
                    out.push_back('1');
                } else {
                    out.push_back('.');
                }
                file += 1;
            }
            out.push_back('\n');
            rank -= 1;
        }
        return out;
    }

    var bits: int = 0;
}

fn board_of_square(square: int) -> Bitboard {
    return Bitboard({.bits = 1 << square});
}

fn board_of_file(file: int) -> Bitboard {
    return Bitboard({.bits = FILE_MASKS.at(file)});
}

fn board_of_rank(rank: int) -> Bitboard {
    return Bitboard({.bits = RANK_MASKS.at(rank)});
}

impl Bitboard as Core.BitOrWith(Bitboard) where .Result = Bitboard {
  fn Op(self, other: Bitboard) -> Bitboard {
      return Bitboard({.bits = self.bits | other.bits});
  }
}
impl Bitboard as Core.BitAndWith(Bitboard) where .Result = Bitboard {
  fn Op(self, other: Bitboard) -> Bitboard {
      return Bitboard({.bits = self.bits & other.bits});
  }
}
impl Bitboard as Core.BitXorWith(Bitboard) where .Result = Bitboard {
  fn Op(self, other: Bitboard) -> Bitboard {
      return Bitboard({.bits = self.bits ^ other.bits});
  }
}
impl Bitboard as Core.EqWith(Bitboard) {
  fn Equal(self, other: Bitboard) -> bool {
      return self.bits == other.bits;
  }
}

// --- Precomputed attack tables -------------------------------------------

// Leaper attacks, one entry per square.
var KNIGHT_ATTACKS: vector(int) = vector(int)(SQUARE_COUNT);
var KING_ATTACKS: vector(int) = vector(int)(SQUARE_COUNT);

// Pawn tables are colour indexed: PAWN_ATTACKS[c][s] is the set of squares a
// pawn of colour c standing on s attacks, PAWN_PUSHES[c][s] the single push.
var PAWN_ATTACKS: vector(vector(int)) = vector(vector(int))(COLOR_COUNT);
var PAWN_PUSHES: vector(vector(int)) = vector(vector(int))(COLOR_COUNT);

// RAY_ATTACKS[direction][square] is every square reachable from `square` in
// that direction on an otherwise empty board, excluding `square` itself.
var RAY_ATTACKS: vector(vector(int)) = vector(vector(int))(RAY_COUNT);

// Empty-board attack sets for the sliders, i.e. the union of their rays.
var BISHOP_PSEUDO: vector(int) = vector(int)(SQUARE_COUNT);
var ROOK_PSEUDO: vector(int) = vector(int)(SQUARE_COUNT);
var QUEEN_PSEUDO: vector(int) = vector(int)(SQUARE_COUNT);

// Relevant occupancy masks: the ray squares that can actually block, i.e.
// the pseudo attacks with the board edge trimmed off each ray.
var BISHOP_RELEVANT: vector(int) = vector(int)(SQUARE_COUNT);
var ROOK_RELEVANT: vector(int) = vector(int)(SQUARE_COUNT);

// BETWEEN[a][b] is the open segment strictly between two aligned squares and
// is empty when they are not aligned. LINE_THROUGH[a][b] is the whole line
// they share, which is what the pin resolver needs.
var BETWEEN: vector(vector(int)) = vector(vector(int))(SQUARE_COUNT);
var LINE_THROUGH: vector(vector(int)) = vector(vector(int))(SQUARE_COUNT);

// Knight and king offsets, expressed as (file, rank) pairs so the loops can
// reject an off-board step without any wrap masking.
var KNIGHT_FILE_DELTA: vector(int) = vector(int)(8);
var KNIGHT_RANK_DELTA: vector(int) = vector(int)(8);
var KING_FILE_DELTA: vector(int) = vector(int)(8);
var KING_RANK_DELTA: vector(int) = vector(int)(8);
var RAY_FILE_DELTA: vector(int) = vector(int)(RAY_COUNT);
var RAY_RANK_DELTA: vector(int) = vector(int)(RAY_COUNT);

// The eight knight jumps, in clockwise order starting from north-north-east.
fn init_offset_tables() {
    KNIGHT_FILE_DELTA.at(0) = 1;
    KNIGHT_RANK_DELTA.at(0) = 2;
    KNIGHT_FILE_DELTA.at(1) = 2;
    KNIGHT_RANK_DELTA.at(1) = 1;
    KNIGHT_FILE_DELTA.at(2) = 2;
    KNIGHT_RANK_DELTA.at(2) = -1;
    KNIGHT_FILE_DELTA.at(3) = 1;
    KNIGHT_RANK_DELTA.at(3) = -2;
    KNIGHT_FILE_DELTA.at(4) = -1;
    KNIGHT_RANK_DELTA.at(4) = -2;
    KNIGHT_FILE_DELTA.at(5) = -2;
    KNIGHT_RANK_DELTA.at(5) = -1;
    KNIGHT_FILE_DELTA.at(6) = -2;
    KNIGHT_RANK_DELTA.at(6) = 1;
    KNIGHT_FILE_DELTA.at(7) = -1;
    KNIGHT_RANK_DELTA.at(7) = 2;

    // The king's eight neighbours, same clockwise order starting north.
    KING_FILE_DELTA.at(0) = 0;
    KING_RANK_DELTA.at(0) = 1;
    KING_FILE_DELTA.at(1) = 1;
    KING_RANK_DELTA.at(1) = 1;
    KING_FILE_DELTA.at(2) = 1;
    KING_RANK_DELTA.at(2) = 0;
    KING_FILE_DELTA.at(3) = 1;
    KING_RANK_DELTA.at(3) = -1;
    KING_FILE_DELTA.at(4) = 0;
    KING_RANK_DELTA.at(4) = -1;
    KING_FILE_DELTA.at(5) = -1;
    KING_RANK_DELTA.at(5) = -1;
    KING_FILE_DELTA.at(6) = -1;
    KING_RANK_DELTA.at(6) = 0;
    KING_FILE_DELTA.at(7) = -1;
    KING_RANK_DELTA.at(7) = 1;

    // Ray steps, in the same compass order as the RAY_* indices.
    RAY_FILE_DELTA.at(RAY_NORTH) = 0;
    RAY_RANK_DELTA.at(RAY_NORTH) = 1;
    RAY_FILE_DELTA.at(RAY_NORTH_EAST) = 1;
    RAY_RANK_DELTA.at(RAY_NORTH_EAST) = 1;
    RAY_FILE_DELTA.at(RAY_EAST) = 1;
    RAY_RANK_DELTA.at(RAY_EAST) = 0;
    RAY_FILE_DELTA.at(RAY_SOUTH_EAST) = 1;
    RAY_RANK_DELTA.at(RAY_SOUTH_EAST) = -1;
    RAY_FILE_DELTA.at(RAY_SOUTH) = 0;
    RAY_RANK_DELTA.at(RAY_SOUTH) = -1;
    RAY_FILE_DELTA.at(RAY_SOUTH_WEST) = -1;
    RAY_RANK_DELTA.at(RAY_SOUTH_WEST) = -1;
    RAY_FILE_DELTA.at(RAY_WEST) = -1;
    RAY_RANK_DELTA.at(RAY_WEST) = 0;
    RAY_FILE_DELTA.at(RAY_NORTH_WEST) = -1;
    RAY_RANK_DELTA.at(RAY_NORTH_WEST) = 1;
}

// Knight attacks, built by walking every square as a (file, rank) pair and
// then every jump as a (df, dr) pair. Steps that leave the board are simply
// not ored in, which is the whole of the wrap handling.
fn init_knight_attacks() {
    var rank: int = 0;
    while (rank < BOARD_RANKS) {
        var file: int = 0;
        while (file < BOARD_FILES) {
            let from = make_square(file, rank);
            var mask: int = 0;
            var jump: int = 0;
            while (jump < 8) {
                let tf = file + KNIGHT_FILE_DELTA.at(jump);
                let tr = rank + KNIGHT_RANK_DELTA.at(jump);
                if (tf >= 0 and tf < BOARD_FILES and tr >= 0 and tr < BOARD_RANKS) {
                    mask |= 1 << make_square(tf, tr);
                }
                jump += 1;
            }
            KNIGHT_ATTACKS.at(from) = mask;
            file += 1;
        }
        rank += 1;
    }
}

// King attacks, the same shape with a different offset table.
fn init_king_attacks() {
    var rank: int = 0;
    while (rank < BOARD_RANKS) {
        var file: int = 0;
        while (file < BOARD_FILES) {
            let from = make_square(file, rank);
            var mask: int = 0;
            var step: int = 0;
            while (step < 8) {
                let tf = file + KING_FILE_DELTA.at(step);
                let tr = rank + KING_RANK_DELTA.at(step);
                if (tf >= 0 and tf < BOARD_FILES and tr >= 0 and tr < BOARD_RANKS) {
                    mask |= 1 << make_square(tf, tr);
                }
                step += 1;
            }
            KING_ATTACKS.at(from) = mask;
            file += 1;
        }
        rank += 1;
    }
}

// Pawn attacks and pushes for both colours. A pawn on the last rank has no
// moves at all, which falls out of the rank bounds check.
fn init_pawn_attacks() {
    var color: int = 0;
    while (color < COLOR_COUNT) {
        PAWN_ATTACKS.at(color) = vector(int)(SQUARE_COUNT);
        PAWN_PUSHES.at(color) = vector(int)(SQUARE_COUNT);
        var forward: int = 1;
        if (color == 1) {
            forward = -1;
        }
        var rank: int = 0;
        while (rank < BOARD_RANKS) {
            var file: int = 0;
            while (file < BOARD_FILES) {
                let from = make_square(file, rank);
                let tr = rank + forward;
                var attacks: int = 0;
                var pushes: int = 0;
                if (tr >= 0 and tr < BOARD_RANKS) {
                    pushes |= 1 << make_square(file, tr);
                    if (file > 0) {
                        attacks |= 1 << make_square(file - 1, tr);
                    }
                    if (file < BOARD_FILES - 1) {
                        attacks |= 1 << make_square(file + 1, tr);
                    }
                }
                PAWN_ATTACKS.at(color).at(from) = attacks;
                PAWN_PUSHES.at(color).at(from) = pushes;
                file += 1;
            }
            rank += 1;
        }
        color += 1;
    }
}

// The eight rays from every square. The inner loop walks in (file, rank)
// space so the ray stops at the edge instead of wrapping onto the next rank.
fn init_ray_attacks() {
    var ray: int = 0;
    while (ray < RAY_COUNT) {
        RAY_ATTACKS.at(ray) = vector(int)(SQUARE_COUNT);
        let df = RAY_FILE_DELTA.at(ray);
        let dr = RAY_RANK_DELTA.at(ray);
        var rank: int = 0;
        while (rank < BOARD_RANKS) {
            var file: int = 0;
            while (file < BOARD_FILES) {
                let from = make_square(file, rank);
                var mask: int = 0;
                var tf = file + df;
                var tr = rank + dr;
                while (tf >= 0 and tf < BOARD_FILES and tr >= 0 and tr < BOARD_RANKS) {
                    mask |= 1 << make_square(tf, tr);
                    tf += df;
                    tr += dr;
                }
                RAY_ATTACKS.at(ray).at(from) = mask;
                file += 1;
            }
            rank += 1;
        }
        ray += 1;
    }
}

// Empty-board slider attacks and the trimmed occupancy masks. A blocker on
// the edge of a ray can never shadow anything, so it is excluded.
fn init_slider_masks() {
    var square: int = 0;
    while (square < SQUARE_COUNT) {
        let file = file_of(square);
        let rank = rank_of(square);

        var bishop: int = 0;
        bishop |= RAY_ATTACKS.at(RAY_NORTH_EAST).at(square);
        bishop |= RAY_ATTACKS.at(RAY_SOUTH_EAST).at(square);
        bishop |= RAY_ATTACKS.at(RAY_SOUTH_WEST).at(square);
        bishop |= RAY_ATTACKS.at(RAY_NORTH_WEST).at(square);
        BISHOP_PSEUDO.at(square) = bishop;

        var rook: int = 0;
        rook |= RAY_ATTACKS.at(RAY_NORTH).at(square);
        rook |= RAY_ATTACKS.at(RAY_EAST).at(square);
        rook |= RAY_ATTACKS.at(RAY_SOUTH).at(square);
        rook |= RAY_ATTACKS.at(RAY_WEST).at(square);
        ROOK_PSEUDO.at(square) = rook;

        QUEEN_PSEUDO.at(square) = bishop | rook;

        // A diagonal blocker matters only away from the rim.
        BISHOP_RELEVANT.at(square) = bishop & (FULL_BOARD ^ BOARD_EDGES);

        // For a rook the trimming is per direction: the a-file matters for a
        // rook on the a-file, so only the far end of each ray comes off.
        var relevant: int = rook;
        if (file != 0) {
            relevant &= FULL_BOARD ^ FILE_MASKS.at(0);
        }
        if (file != BOARD_FILES - 1) {
            relevant &= FULL_BOARD ^ FILE_MASKS.at(BOARD_FILES - 1);
        }
        if (rank != 0) {
            relevant &= FULL_BOARD ^ RANK_MASKS.at(0);
        }
        if (rank != BOARD_RANKS - 1) {
            relevant &= FULL_BOARD ^ RANK_MASKS.at(BOARD_RANKS - 1);
        }
        ROOK_RELEVANT.at(square) = relevant;

        square += 1;
    }
}

// BETWEEN and LINE_THROUGH, the two tables the check and pin logic lives on.
// For each ordered pair the loop walks the eight rays from `from` looking for
// `to`; if it is found the accumulated segment is the answer.
fn init_between_tables() {
    var from: int = 0;
    while (from < SQUARE_COUNT) {
        BETWEEN.at(from) = vector(int)(SQUARE_COUNT);
        LINE_THROUGH.at(from) = vector(int)(SQUARE_COUNT);
        var to: int = 0;
        while (to < SQUARE_COUNT) {
            BETWEEN.at(from).at(to) = 0;
            LINE_THROUGH.at(from).at(to) = 0;
            to += 1;
        }
        from += 1;
    }

    var origin: int = 0;
    while (origin < SQUARE_COUNT) {
        var ray: int = 0;
        while (ray < RAY_COUNT) {
            let df = RAY_FILE_DELTA.at(ray);
            let dr = RAY_RANK_DELTA.at(ray);
            var segment: int = 0;
            var tf = file_of(origin) + df;
            var tr = rank_of(origin) + dr;
            while (tf >= 0 and tf < BOARD_FILES and tr >= 0 and tr < BOARD_RANKS) {
                let target = make_square(tf, tr);
                BETWEEN.at(origin).at(target) = segment;

                // The shared line is the ray plus its opposite plus both
                // endpoints; the opposite ray index is `ray + 4` modulo 8.
                let back = (ray + 4) % RAY_COUNT;
                LINE_THROUGH.at(origin).at(target) = RAY_ATTACKS.at(ray).at(origin)
                    | RAY_ATTACKS.at(back).at(origin)
                    | (1 << origin)
                    | (1 << target);

                segment |= 1 << target;
                tf += df;
                tr += dr;
            }
            ray += 1;
        }
        origin += 1;
    }
}

// Run every table builder once, in dependency order.
fn init_tables() {
    init_square_masks();
    init_debruijn_table();
    init_distance_table();
    init_offset_tables();
    init_knight_attacks();
    init_king_attacks();
    init_pawn_attacks();
    init_ray_attacks();
    init_slider_masks();
    init_between_tables();
}

// --- Sliding piece attacks ------------------------------------------------

// A positive ray is one whose squares have higher indices than the origin
// (north, north-east, east, north-west); the blocker to keep is then the
// *lowest* set bit of the intersection. For the negative rays it is the
// highest. This is the classical approach: no magics, one bit scan per ray.
fn ray_is_positive(ray: int) -> bool {
    return ray == RAY_NORTH or ray == RAY_NORTH_EAST or ray == RAY_EAST or ray == RAY_NORTH_WEST;
}

// Attacks along one ray, stopping on (and including) the first blocker.
fn ray_attacks_from(square: int, ray: int, occupancy: int) -> int {
    var attacks = RAY_ATTACKS.at(ray).at(square);
    let blockers = attacks & occupancy;
    if (blockers == 0) {
        return attacks;
    }
    if (ray_is_positive(ray)) {
        let first = bit_scan_forward(blockers);
        attacks = attacks & (FULL_BOARD ^ RAY_ATTACKS.at(ray).at(first));
    } else {
        let first = bit_scan_reverse(blockers);
        attacks = attacks & (FULL_BOARD ^ RAY_ATTACKS.at(ray).at(first));
    }
    return attacks;
}

// Rook attacks: the four straight rays, unrolled because the loop overhead
// is a measurable fraction of the work at this size.
fn rook_attacks(square: int, occupancy: int) -> int {
    attack_query_count += 1;
    var attacks: int = 0;
    attacks |= ray_attacks_from(square, RAY_NORTH, occupancy);
    attacks |= ray_attacks_from(square, RAY_EAST, occupancy);
    attacks |= ray_attacks_from(square, RAY_SOUTH, occupancy);
    attacks |= ray_attacks_from(square, RAY_WEST, occupancy);
    return attacks;
}

fn bishop_attacks(square: int, occupancy: int) -> int {
    attack_query_count += 1;
    var attacks: int = 0;
    attacks |= ray_attacks_from(square, RAY_NORTH_EAST, occupancy);
    attacks |= ray_attacks_from(square, RAY_SOUTH_EAST, occupancy);
    attacks |= ray_attacks_from(square, RAY_SOUTH_WEST, occupancy);
    attacks |= ray_attacks_from(square, RAY_NORTH_WEST, occupancy);
    return attacks;
}

fn queen_attacks(square: int, occupancy: int) -> int {
    return rook_attacks(square, occupancy) | bishop_attacks(square, occupancy);
}

// Attacks of an arbitrary kind, used by the generic generation loop and by
// static exchange evaluation.
fn attacks_of_kind(kind: PieceKind, color: Color, square: int, occupancy: int) -> int {
    if (kind == PieceKind.Pawn) {
        return PAWN_ATTACKS.at(color_index(color)).at(square);
    } else { if (kind == PieceKind.Knight) {
        return KNIGHT_ATTACKS.at(square);
    } else { if (kind == PieceKind.Bishop) {
        return bishop_attacks(square, occupancy);
    } else { if (kind == PieceKind.Rook) {
        return rook_attacks(square, occupancy);
    } else { if (kind == PieceKind.Queen) {
        return queen_attacks(square, occupancy);
    } else { if (kind == PieceKind.King) {
        return KING_ATTACKS.at(square);
    } else {
        return 0;
    } } } } } }
}

// Attacks of a whole set of pawns at once, which is how the evaluation and
// the king-safety terms want them.
fn pawn_attack_span(color: Color, pawns: int) -> int {
    if (color == Color.White) {
        return shift_north_east(pawns) | shift_north_west(pawns);
    }
    return shift_south_east(pawns) | shift_south_west(pawns);
}

// Squares attacked by two pawns at once, i.e. the defended points of a
// pawn chain.
fn pawn_double_attacks(color: Color, pawns: int) -> int {
    if (color == Color.White) {
        return shift_north_east(pawns) & shift_north_west(pawns);
    }
    return shift_south_east(pawns) & shift_south_west(pawns);
}

// Single and double pushes for a whole pawn set, given the empty squares.
fn pawn_single_pushes(color: Color, pawns: int, empty: int) -> int {
    if (color == Color.White) {
        return shift_north(pawns) & empty;
    }
    return shift_south(pawns) & empty;
}

fn pawn_double_pushes(color: Color, pawns: int, empty: int) -> int {
    let single = pawn_single_pushes(color, pawns, empty);
    if (color == Color.White) {
        return shift_north(single) & empty & RANK_MASKS.at(3);
    }
    return shift_south(single) & empty & RANK_MASKS.at(4);
}

// --- Move encoding --------------------------------------------------------

// A move is packed into sixteen bits:
//
//     bits  0.. 5   origin square
//     bits  6..11   destination square
//     bits 12..15   MoveKind
//
// The search stores a separate score alongside, so the packed form stays
// narrow enough that a whole move list fits in a couple of cache lines.
let MOVE_FROM_SHIFT: int = 0;
let MOVE_TO_SHIFT: int = 6;
let MOVE_KIND_SHIFT: int = 12;
let MOVE_KIND_MASK: int = 15;          // 0xF
let MOVE_NULL: int = 0;

// The bit inside the kind field that marks a capture, and the one that marks
// a promotion. Both are set for the promotion-captures.
let KIND_CAPTURE_BIT: int = 4;         // 0x4
let KIND_PROMOTION_BIT: int = 8;       // 0x8

fn encode_move(from: int, to: int, kind: int) -> int {
    return ((from & SQUARE_MASK) << MOVE_FROM_SHIFT)
        | ((to & SQUARE_MASK) << MOVE_TO_SHIFT)
        | ((kind & MOVE_KIND_MASK) << MOVE_KIND_SHIFT);
}

fn move_from(m: int) -> int {
    return (m >> MOVE_FROM_SHIFT) & SQUARE_MASK;
}

fn move_to(m: int) -> int {
    return (m >> MOVE_TO_SHIFT) & SQUARE_MASK;
}

fn move_kind(m: int) -> int {
    return (m >> MOVE_KIND_SHIFT) & MOVE_KIND_MASK;
}

fn move_is_null(m: int) -> bool {
    return m == MOVE_NULL;
}

fn move_is_capture(m: int) -> bool {
    return (move_kind(m) & KIND_CAPTURE_BIT) != 0;
}

fn move_is_promotion(m: int) -> bool {
    return (move_kind(m) & KIND_PROMOTION_BIT) != 0;
}

fn move_is_en_passant(m: int) -> bool {
    return move_kind(m) == 5;
}

fn move_is_double_push(m: int) -> bool {
    return move_kind(m) == 1;
}

fn move_is_castle(m: int) -> bool {
    let kind = move_kind(m);
    return kind == 2 or kind == 3;
}

fn move_is_king_castle(m: int) -> bool {
    return move_kind(m) == 2;
}

fn move_is_quiet(m: int) -> bool {
    let kind = move_kind(m);
    return (kind & KIND_CAPTURE_BIT) == 0 and (kind & KIND_PROMOTION_BIT) == 0;
}

// The piece a promotion produces. The low two bits of the kind field count
// knight, bishop, rook, queen in that order, which is why this is a shift
// and an add rather than a table.
fn move_promotion_kind(m: int) -> PieceKind {
    if (move_is_promotion(m) == false) {
        return PieceKind.KindNone;
    }
    let selector = move_kind(m) & 3;
    return kind_from_index(selector + 1);
}

// Build the four promotion kinds for a given selector, capture or not.
fn promotion_move_kind(selector: int, capture: bool) -> int {
    var kind = KIND_PROMOTION_BIT | (selector & 3);
    if (capture) {
        kind |= KIND_CAPTURE_BIT;
    }
    return kind;
}

// A move plus the ordering score the search assigns it.
class ScoredMove {

    fn from_square(self) -> int {
        return move_from(self.packed);
    }

    fn to_square(self) -> int {
        return move_to(self.packed);
    }

    fn kind(self) -> int {
        return move_kind(self.packed);
    }

    fn is_capture(self) -> bool {
        return move_is_capture(self.packed);
    }

    var packed: int = 0;
    var score: int = 0;
}

// A fixed-capacity move list. Generation appends; the search sorts in place
// with a selection pass rather than a full sort, because it usually only
// looks at the first few moves.
class MoveList {

    fn size(self) -> int {
        return self.count;
    }

    fn empty(self) -> bool {
        return self.count == 0;
    }

    fn clear(ref self) {
        self.count = 0;
        self.moves.clear();
    }

    fn add(ref self, m: int) {
        Assert(self.count < MAX_MOVES);
        self.moves.push_back(ScoredMove({.packed = m, .score = 0}));
        self.count += 1;
        generated_move_count += 1;
    }

    fn add_scored(ref self, m: int, score: int) {
        Assert(self.count < MAX_MOVES);
        self.moves.push_back(ScoredMove({.packed = m, .score = score}));
        self.count += 1;
        generated_move_count += 1;
    }

    fn at(ref self, index: int) -> ref ScoredMove {
        Assert(index >= 0);
        Assert(index < self.count);
        return self.moves.at(index);
    }

    fn packed_at(self, index: int) -> int {
        return self.moves.at(index).packed;
    }

    fn contains(self, m: int) -> bool {
        var i: int = 0;
        while (i < self.count) {
            if (self.moves.at(i).packed == m) {
                return true;
            }
            i += 1;
        }
        return false;
    }

    // Move the best remaining entry to `start` and return its score. This is
    // the selection step of an incremental sort.
    fn select_best(ref self, start: int) -> int {
        var best = start;
        var i = start + 1;
        while (i < self.count) {
            if (self.moves.at(i).score > self.moves.at(best).score) {
                best = i;
            }
            i += 1;
        }
        if (best != start) {
            swap(self.moves.at(start), self.moves.at(best));
        }
        return self.moves.at(start).score;
    }

    // Drop every entry for which the predicate flag array says false. The
    // legality filter uses it after a pseudo-legal pass.
    fn compact(ref self, keep: vector(bool)) {
        var write: int = 0;
        var read: int = 0;
        while (read < self.count) {
            if (keep.at(read)) {
                self.moves.at(write) = self.moves.at(read);
                write += 1;
            }
            read += 1;
        }
        self.count = write;
    }

    var moves: vector(ScoredMove);
    var count: int = 0;
}

// --- Irreversible state ---------------------------------------------------

// Everything make_move destroys and unmake_move must restore. The mutable
// half of the position (the bitboards, the square array) is undone by
// replaying the move backwards; only these five scalars need saving.
class Undo {
    var move_packed: int = 0;
    var captured: int = 12;
    var castling: int = 0;
    var ep_square: int = -1;
    var halfmove: int = 0;
    var key: int = 0;
}

// CASTLE_MASK[s] is the set of rights that survive any move touching square
// s. A rook leaving a1 clears white's queenside right; the king leaving e1
// clears both of white's. Every other square keeps all four.
var CASTLE_MASK: vector(int) = vector(int)(SQUARE_COUNT);

fn init_castle_masks() {
    var square: int = 0;
    while (square < SQUARE_COUNT) {
        CASTLE_MASK.at(square) = CASTLE_ALL;
        square += 1;
    }
    CASTLE_MASK.at(SQ_A1) = CASTLE_ALL ^ CASTLE_WHITE_QUEEN;
    CASTLE_MASK.at(SQ_H1) = CASTLE_ALL ^ CASTLE_WHITE_KING;
    CASTLE_MASK.at(SQ_E1) = CASTLE_ALL ^ CASTLE_WHITE_ANY;
    CASTLE_MASK.at(SQ_A8) = CASTLE_ALL ^ CASTLE_BLACK_QUEEN;
    CASTLE_MASK.at(SQ_H8) = CASTLE_ALL ^ CASTLE_BLACK_KING;
    CASTLE_MASK.at(SQ_E8) = CASTLE_ALL ^ CASTLE_BLACK_ANY;
}

// The squares that must be empty, and the squares that must not be attacked,
// for each of the four castles. Indexed by right bit position 0..3.
var CASTLE_EMPTY_MASK: vector(int) = vector(int)(4);
var CASTLE_SAFE_MASK: vector(int) = vector(int)(4);
var CASTLE_KING_FROM: vector(int) = vector(int)(4);
var CASTLE_KING_TO: vector(int) = vector(int)(4);
var CASTLE_ROOK_FROM: vector(int) = vector(int)(4);
var CASTLE_ROOK_TO: vector(int) = vector(int)(4);

fn init_castle_paths() {
    // White kingside: f1 and g1 empty, e1 f1 g1 unattacked.
    CASTLE_EMPTY_MASK.at(0) = (1 << SQ_F1) | (1 << SQ_G1);
    CASTLE_SAFE_MASK.at(0) = (1 << SQ_E1) | (1 << SQ_F1) | (1 << SQ_G1);
    CASTLE_KING_FROM.at(0) = SQ_E1;
    CASTLE_KING_TO.at(0) = SQ_G1;
    CASTLE_ROOK_FROM.at(0) = SQ_H1;
    CASTLE_ROOK_TO.at(0) = SQ_F1;

    // White queenside: b1 c1 d1 empty, e1 d1 c1 unattacked. b1 may be
    // attacked, which is the classic asymmetry.
    CASTLE_EMPTY_MASK.at(1) = (1 << SQ_B1) | (1 << SQ_C1) | (1 << SQ_D1);
    CASTLE_SAFE_MASK.at(1) = (1 << SQ_E1) | (1 << SQ_D1) | (1 << SQ_C1);
    CASTLE_KING_FROM.at(1) = SQ_E1;
    CASTLE_KING_TO.at(1) = SQ_C1;
    CASTLE_ROOK_FROM.at(1) = SQ_A1;
    CASTLE_ROOK_TO.at(1) = SQ_D1;

    // Black kingside.
    CASTLE_EMPTY_MASK.at(2) = (1 << SQ_F8) | (1 << SQ_G8);
    CASTLE_SAFE_MASK.at(2) = (1 << SQ_E8) | (1 << SQ_F8) | (1 << SQ_G8);
    CASTLE_KING_FROM.at(2) = SQ_E8;
    CASTLE_KING_TO.at(2) = SQ_G8;
    CASTLE_ROOK_FROM.at(2) = SQ_H8;
    CASTLE_ROOK_TO.at(2) = SQ_F8;

    // Black queenside.
    CASTLE_EMPTY_MASK.at(3) = (1 << SQ_B8) | (1 << SQ_C8) | (1 << SQ_D8);
    CASTLE_SAFE_MASK.at(3) = (1 << SQ_E8) | (1 << SQ_D8) | (1 << SQ_C8);
    CASTLE_KING_FROM.at(3) = SQ_E8;
    CASTLE_KING_TO.at(3) = SQ_C8;
    CASTLE_ROOK_FROM.at(3) = SQ_A8;
    CASTLE_ROOK_TO.at(3) = SQ_D8;
}

// --- Zobrist hashing ------------------------------------------------------

// A xorshift generator seeded with a fixed constant, so that two runs of the
// program agree on every key. The multiplier is the usual 64 bit mixer.
let ZOBRIST_SEED: int = 1070372;
let XORSHIFT_MULTIPLIER: int = 2685821657736338717;

var ZOBRIST_PIECES: vector(vector(int)) = vector(vector(int))(PIECE_CODE_COUNT);
var ZOBRIST_CASTLING: vector(int) = vector(int)(16);
var ZOBRIST_EP_FILE: vector(int) = vector(int)(BOARD_FILES);
var ZOBRIST_SIDE: int = 0;
var zobrist_state: int = 0;

// One step of xorshift64*, written out so the shifts are visible.
fn next_random() -> int {
    var x = zobrist_state;
    x ^= x >> 12;
    x ^= x << 25;
    x ^= x >> 27;
    zobrist_state = x;
    return x * XORSHIFT_MULTIPLIER;
}

fn init_zobrist() {
    zobrist_state = ZOBRIST_SEED;
    var piece: int = 0;
    while (piece < PIECE_CODE_COUNT) {
        ZOBRIST_PIECES.at(piece) = vector(int)(SQUARE_COUNT);
        var square: int = 0;
        while (square < SQUARE_COUNT) {
            ZOBRIST_PIECES.at(piece).at(square) = next_random();
            square += 1;
        }
        piece += 1;
    }
    var rights: int = 0;
    while (rights < 16) {
        ZOBRIST_CASTLING.at(rights) = next_random();
        rights += 1;
    }
    var file: int = 0;
    while (file < BOARD_FILES) {
        ZOBRIST_EP_FILE.at(file) = next_random();
        file += 1;
    }
    ZOBRIST_SIDE = next_random();
}

// --- Position -------------------------------------------------------------

// The position. `squares` is the redundant mailbox that make_move consults to
// find out what it is capturing; the twelve bitboards are the primary
// representation and everything else is derived from them.
class Position {

    // --- basic accessors ---------------------------------------------------

    fn piece_at(self, square: int) -> int {
        Assert(square >= 0);
        Assert(square < SQUARE_COUNT);
        return self.squares.at(square);
    }

    fn is_empty_square(self, square: int) -> bool {
        return self.squares.at(square) >= PIECE_CODE_COUNT;
    }

    fn side_to_move(self) -> Color {
        return self.side;
    }

    fn opponent(self) -> Color {
        return opposite_color(self.side);
    }

    fn occupied(self) -> int {
        return self.occupancy;
    }

    fn empty_squares(self) -> int {
        return FULL_BOARD ^ self.occupancy;
    }

    fn pieces_of_color(self, color: Color) -> int {
        return self.by_color.at(color_index(color));
    }

    fn pieces_of_kind(self, kind: PieceKind) -> int {
        return self.by_kind.at(kind_index(kind));
    }

    // The intersection that almost every generation loop starts from.
    fn pieces(self, color: Color, kind: PieceKind) -> int {
        return self.by_color.at(color_index(color)) & self.by_kind.at(kind_index(kind));
    }

    fn diagonal_sliders(self, color: Color) -> int {
        return self.by_color.at(color_index(color))
            & (self.by_kind.at(kind_index(PieceKind.Bishop)) | self.by_kind.at(kind_index(PieceKind.Queen)));
    }

    fn straight_sliders(self, color: Color) -> int {
        return self.by_color.at(color_index(color))
            & (self.by_kind.at(kind_index(PieceKind.Rook)) | self.by_kind.at(kind_index(PieceKind.Queen)));
    }

    fn king_square(self, color: Color) -> int {
        return self.kings.at(color_index(color));
    }

    fn castling_rights(self) -> int {
        return self.castling;
    }

    fn has_castling_right(self, right: int) -> bool {
        return (self.castling & right) != 0;
    }

    fn en_passant_square(self) -> int {
        return self.ep_square;
    }

    fn halfmove_clock(self) -> int {
        return self.halfmove;
    }

    fn fullmove_number(self) -> int {
        return self.fullmove;
    }

    fn hash_key(self) -> int {
        return self.key;
    }

    fn piece_count(self, color: Color, kind: PieceKind) -> int {
        return popcount(self.pieces(color, kind));
    }

    fn total_piece_count(self) -> int {
        return popcount(self.occupancy);
    }

    // --- board mutation ----------------------------------------------------

    // Clear every board and reset the scalars. Called before FEN parsing.
    fn reset(ref self) {
        self.squares = vector(int)(SQUARE_COUNT);
        var square: int = 0;
        while (square < SQUARE_COUNT) {
            self.squares.at(square) = PIECE_CODE_COUNT;
            square += 1;
        }
        self.by_color = vector(int)(COLOR_COUNT);
        self.by_color.at(0) = 0;
        self.by_color.at(1) = 0;
        self.by_kind = vector(int)(PIECE_KIND_COUNT);
        var kind: int = 0;
        while (kind < PIECE_KIND_COUNT) {
            self.by_kind.at(kind) = 0;
            kind += 1;
        }
        self.kings = vector(int)(COLOR_COUNT);
        self.kings.at(0) = NO_SQUARE;
        self.kings.at(1) = NO_SQUARE;
        self.occupancy = 0;
        self.side = Color.White;
        self.castling = CASTLE_NONE;
        self.ep_square = NO_SQUARE;
        self.halfmove = 0;
        self.fullmove = 1;
        self.key = 0;
        self.ply = 0;
    }

    // Put `piece` on an empty square, updating all four views plus the hash.
    fn put_piece(ref self, piece: int, square: int) {
        Assert(self.is_empty_square(square));
        let color = color_index(piece_color(piece));
        let kind = kind_index(piece_kind(piece));
        let bit = 1 << square;
        self.squares.at(square) = piece;
        self.by_color.at(color) |= bit;
        self.by_kind.at(kind) |= bit;
        self.occupancy |= bit;
        self.key ^= ZOBRIST_PIECES.at(piece).at(square);
        if (kind == kind_index(PieceKind.King)) {
            self.kings.at(color) = square;
        }
    }

    // Take a piece off an occupied square.
    fn remove_piece(ref self, square: int) {
        let piece = self.squares.at(square);
        Assert(piece < PIECE_CODE_COUNT);
        let color = color_index(piece_color(piece));
        let kind = kind_index(piece_kind(piece));
        let clear = FULL_BOARD ^ (1 << square);
        self.squares.at(square) = PIECE_CODE_COUNT;
        self.by_color.at(color) &= clear;
        self.by_kind.at(kind) &= clear;
        self.occupancy &= clear;
        self.key ^= ZOBRIST_PIECES.at(piece).at(square);
        if (kind == kind_index(PieceKind.King)) {
            self.kings.at(color) = NO_SQUARE;
        }
    }

    // Slide a piece from one square to another. The two xors touch each
    // board once, which is why this is not a remove followed by a put.
    fn move_piece(ref self, from: int, to: int) {
        let piece = self.squares.at(from);
        Assert(piece < PIECE_CODE_COUNT);
        let color = color_index(piece_color(piece));
        let kind = kind_index(piece_kind(piece));
        let delta = (1 << from) | (1 << to);
        self.squares.at(from) = PIECE_CODE_COUNT;
        self.squares.at(to) = piece;
        self.by_color.at(color) ^= delta;
        self.by_kind.at(kind) ^= delta;
        self.occupancy ^= delta;
        self.key ^= ZOBRIST_PIECES.at(piece).at(from);
        self.key ^= ZOBRIST_PIECES.at(piece).at(to);
        if (kind == kind_index(PieceKind.King)) {
            self.kings.at(color) = to;
        }
    }

    // Recompute the hash from scratch. Used to assert the incremental
    // updates in make_move and unmake_move have not drifted.
    fn compute_key(self) -> int {
        var key: int = 0;
        var square: int = 0;
        while (square < SQUARE_COUNT) {
            let piece = self.squares.at(square);
            if (piece < PIECE_CODE_COUNT) {
                key ^= ZOBRIST_PIECES.at(piece).at(square);
            }
            square += 1;
        }
        key ^= ZOBRIST_CASTLING.at(self.castling & CASTLE_ALL);
        if (self.ep_square != NO_SQUARE) {
            key ^= ZOBRIST_EP_FILE.at(file_of(self.ep_square));
        }
        if (self.side == Color.Black) {
            key ^= ZOBRIST_SIDE;
        }
        return key;
    }

    // --- attack detection --------------------------------------------------

    // Every piece of either colour that attacks `square` given `occupancy`.
    // The pawn term reads the *opposite* colour's table because "which black
    // pawn attacks e4" is the same question as "which squares would a white
    // pawn on e4 attack".
    fn attackers_to(self, square: int, occupancy: int) -> int {
        var attackers: int = 0;
        attackers |= PAWN_ATTACKS.at(0).at(square) & self.pieces(Color.Black, PieceKind.Pawn);
        attackers |= PAWN_ATTACKS.at(1).at(square) & self.pieces(Color.White, PieceKind.Pawn);
        attackers |= KNIGHT_ATTACKS.at(square) & self.by_kind.at(kind_index(PieceKind.Knight));
        attackers |= KING_ATTACKS.at(square) & self.by_kind.at(kind_index(PieceKind.King));
        attackers |= bishop_attacks(square, occupancy)
            & (self.by_kind.at(kind_index(PieceKind.Bishop)) | self.by_kind.at(kind_index(PieceKind.Queen)));
        attackers |= rook_attacks(square, occupancy)
            & (self.by_kind.at(kind_index(PieceKind.Rook)) | self.by_kind.at(kind_index(PieceKind.Queen)));
        return attackers;
    }

    // The same restricted to one colour.
    fn attackers_of_color(self, square: int, color: Color, occupancy: int) -> int {
        return self.attackers_to(square, occupancy) & self.by_color.at(color_index(color));
    }

    // Is `square` attacked by `color`? Written as an early-out cascade
    // instead of reusing attackers_to, because the cheap leaper tests reject
    // the overwhelming majority of calls before any ray is walked.
    fn is_attacked(self, square: int, color: Color) -> bool {
        attack_query_count += 1;
        let them = color_index(color);
        let us = 1 - them;
        if ((PAWN_ATTACKS.at(us).at(square) & self.pieces(color, PieceKind.Pawn)) != 0) {
            return true;
        }
        if ((KNIGHT_ATTACKS.at(square) & self.pieces(color, PieceKind.Knight)) != 0) {
            return true;
        }
        if ((KING_ATTACKS.at(square) & self.pieces(color, PieceKind.King)) != 0) {
            return true;
        }
        let diagonal = self.diagonal_sliders(color);
        if (diagonal != 0) {
            if ((bishop_attacks(square, self.occupancy) & diagonal) != 0) {
                return true;
            }
        }
        let straight = self.straight_sliders(color);
        if (straight != 0) {
            if ((rook_attacks(square, self.occupancy) & straight) != 0) {
                return true;
            }
        }
        return false;
    }

    // The same question with a hypothetical occupancy, which is what the
    // en passant legality test needs: removing the captured pawn can expose
    // a rook along the fifth rank.
    fn is_attacked_with(self, square: int, color: Color, occupancy: int) -> bool {
        let them = color_index(color);
        let us = 1 - them;
        var hits: int = 0;
        hits |= PAWN_ATTACKS.at(us).at(square) & self.pieces(color, PieceKind.Pawn);
        hits |= KNIGHT_ATTACKS.at(square) & self.pieces(color, PieceKind.Knight);
        hits |= KING_ATTACKS.at(square) & self.pieces(color, PieceKind.King);
        hits |= bishop_attacks(square, occupancy) & self.diagonal_sliders(color);
        hits |= rook_attacks(square, occupancy) & self.straight_sliders(color);
        return (hits & occupancy) != 0;
    }

    // Every square the given colour attacks, as one union. Evaluation uses
    // it for mobility and king safety.
    fn attack_map(self, color: Color) -> int {
        var map: int = 0;
        map |= pawn_attack_span(color, self.pieces(color, PieceKind.Pawn));

        var knights = self.pieces(color, PieceKind.Knight);
        while (knights != 0) {
            let square = bit_scan_forward(knights);
            map |= KNIGHT_ATTACKS.at(square);
            knights = clear_lowest_bit(knights);
        }

        var bishops = self.pieces(color, PieceKind.Bishop);
        while (bishops != 0) {
            let square = bit_scan_forward(bishops);
            map |= bishop_attacks(square, self.occupancy);
            bishops = clear_lowest_bit(bishops);
        }

        var rooks = self.pieces(color, PieceKind.Rook);
        while (rooks != 0) {
            let square = bit_scan_forward(rooks);
            map |= rook_attacks(square, self.occupancy);
            rooks = clear_lowest_bit(rooks);
        }

        var queens = self.pieces(color, PieceKind.Queen);
        while (queens != 0) {
            let square = bit_scan_forward(queens);
            map |= queen_attacks(square, self.occupancy);
            queens = clear_lowest_bit(queens);
        }

        let king = self.kings.at(color_index(color));
        if (king != NO_SQUARE) {
            map |= KING_ATTACKS.at(king);
        }
        return map;
    }

    // --- checks and pins ---------------------------------------------------

    // The pieces giving check to `color`'s king right now.
    fn checkers_of(self, color: Color) -> int {
        let king = self.kings.at(color_index(color));
        if (king == NO_SQUARE) {
            return 0;
        }
        return self.attackers_to(king, self.occupancy) & self.by_color.at(color_index(opposite_color(color)));
    }

    fn checkers(self) -> int {
        return self.checkers_of(self.side);
    }

    fn in_check(self) -> bool {
        let king = self.kings.at(color_index(self.side));
        if (king == NO_SQUARE) {
            return false;
        }
        return self.is_attacked(king, opposite_color(self.side));
    }

    fn in_double_check(self) -> bool {
        let checking = self.checkers();
        return checking != 0 and has_single_bit(checking) == false;
    }

    // The pieces of `color` that are pinned against their own king.
    //
    // For each enemy slider that would hit the king on an empty board, look
    // at the segment between it and the king. Exactly one occupant means
    // that occupant is pinned; two or more and nothing is.
    fn pinned_pieces(self, color: Color) -> int {
        let king = self.kings.at(color_index(color));
        if (king == NO_SQUARE) {
            return 0;
        }
        let them = opposite_color(color);
        let ours = self.by_color.at(color_index(color));
        var pinned: int = 0;

        var snipers = (BISHOP_PSEUDO.at(king) & self.diagonal_sliders(them))
            | (ROOK_PSEUDO.at(king) & self.straight_sliders(them));
        while (snipers != 0) {
            let sniper = bit_scan_forward(snipers);
            snipers = clear_lowest_bit(snipers);
            let blockers = BETWEEN.at(king).at(sniper) & self.occupancy;
            if (blockers != 0 and has_single_bit(blockers)) {
                pinned |= blockers & ours;
            }
        }
        return pinned;
    }

    // The full line a pinned piece may still travel along: the shared line
    // of the pinner and the king, including both endpoints.
    fn pin_line(self, color: Color, square: int) -> int {
        let king = self.kings.at(color_index(color));
        if (king == NO_SQUARE) {
            return FULL_BOARD;
        }
        return LINE_THROUGH.at(king).at(square);
    }

    // Squares of `color`'s pieces that, if they moved, would discover check
    // on the *enemy* king. Used by the move ordering to bonus discoveries.
    fn discovery_candidates(self, color: Color) -> int {
        let them = opposite_color(color);
        let enemy_king = self.kings.at(color_index(them));
        if (enemy_king == NO_SQUARE) {
            return 0;
        }
        let ours = self.by_color.at(color_index(color));
        var candidates: int = 0;
        var snipers = (BISHOP_PSEUDO.at(enemy_king) & self.diagonal_sliders(color))
            | (ROOK_PSEUDO.at(enemy_king) & self.straight_sliders(color));
        while (snipers != 0) {
            let sniper = bit_scan_forward(snipers);
            snipers = clear_lowest_bit(snipers);
            let between = BETWEEN.at(enemy_king).at(sniper) & self.occupancy;
            if (between != 0 and has_single_bit(between)) {
                candidates |= between & ours;
            }
        }
        return candidates;
    }

    // --- pseudo-legal move generation --------------------------------------

    // Pawn moves: single pushes, double pushes, both capture directions, the
    // four promotions of each and en passant. The pushes are generated set
    // wise -- shift the whole pawn board and mask -- while the captures walk
    // pawn by pawn so that the promotion split stays readable.
    fn generate_pawn_moves(self, ref list: MoveList, kind: GenKind) {
        let us = self.side;
        let them = opposite_color(us);
        let pawns = self.pieces(us, PieceKind.Pawn);
        if (pawns == 0) {
            return;
        }
        let empty = FULL_BOARD ^ self.occupancy;
        let enemies = self.by_color.at(color_index(them));
        let promo_rank = pawn_promotion_rank(us);
        let delta = pawn_push_delta(us);

        if (kind != GenKind.GenCaptures) {
            var pushes = pawn_single_pushes(us, pawns, empty);
            while (pushes != 0) {
                let to = bit_scan_forward(pushes);
                pushes = clear_lowest_bit(pushes);
                let from = to - delta;
                if (rank_of(to) == promo_rank) {
                    var selector: int = 0;
                    while (selector < 4) {
                        list.add(encode_move(from, to, promotion_move_kind(selector, false)));
                        selector += 1;
                    }
                } else {
                    list.add(encode_move(from, to, 0));
                }
            }

            var doubles = pawn_double_pushes(us, pawns, empty);
            while (doubles != 0) {
                let to = bit_scan_forward(doubles);
                doubles = clear_lowest_bit(doubles);
                list.add(encode_move(to - delta - delta, to, 1));
            }
        }

        if (kind == GenKind.GenQuiets) {
            return;
        }

        // Captures, one pawn at a time so the promotion branch is shared.
        var movers = pawns;
        while (movers != 0) {
            let from = bit_scan_forward(movers);
            movers = clear_lowest_bit(movers);
            var targets = PAWN_ATTACKS.at(color_index(us)).at(from) & enemies;
            while (targets != 0) {
                let to = bit_scan_forward(targets);
                targets = clear_lowest_bit(targets);
                if (rank_of(to) == promo_rank) {
                    var selector: int = 0;
                    while (selector < 4) {
                        list.add(encode_move(from, to, promotion_move_kind(selector, true)));
                        selector += 1;
                    }
                } else {
                    list.add(encode_move(from, to, 4));
                }
            }
        }

        // En passant. At most two pawns can ever take, and the legality of
        // the capture is settled later by the discovered-check test.
        if (self.ep_square != NO_SQUARE) {
            var takers = PAWN_ATTACKS.at(color_index(them)).at(self.ep_square) & pawns;
            while (takers != 0) {
                let from = bit_scan_forward(takers);
                takers = clear_lowest_bit(takers);
                list.add(encode_move(from, self.ep_square, 5));
            }
        }
    }

    // Knight moves. The outer loop walks the knights, the inner loop the
    // target squares -- the shape every leaper generator has.
    fn generate_knight_moves(self, ref list: MoveList, mask: int) {
        let us = self.side;
        var knights = self.pieces(us, PieceKind.Knight);
        while (knights != 0) {
            let from = bit_scan_forward(knights);
            knights = clear_lowest_bit(knights);
            var targets = KNIGHT_ATTACKS.at(from) & mask;
            while (targets != 0) {
                let to = bit_scan_forward(targets);
                targets = clear_lowest_bit(targets);
                if (self.is_empty_square(to)) {
                    list.add(encode_move(from, to, 0));
                } else {
                    list.add(encode_move(from, to, 4));
                }
            }
        }
    }

    fn generate_bishop_moves(self, ref list: MoveList, mask: int) {
        let us = self.side;
        var bishops = self.pieces(us, PieceKind.Bishop);
        while (bishops != 0) {
            let from = bit_scan_forward(bishops);
            bishops = clear_lowest_bit(bishops);
            var targets = bishop_attacks(from, self.occupancy) & mask;
            while (targets != 0) {
                let to = bit_scan_forward(targets);
                targets = clear_lowest_bit(targets);
                if (self.is_empty_square(to)) {
                    list.add(encode_move(from, to, 0));
                } else {
                    list.add(encode_move(from, to, 4));
                }
            }
        }
    }

    fn generate_rook_moves(self, ref list: MoveList, mask: int) {
        let us = self.side;
        var rooks = self.pieces(us, PieceKind.Rook);
        while (rooks != 0) {
            let from = bit_scan_forward(rooks);
            rooks = clear_lowest_bit(rooks);
            var targets = rook_attacks(from, self.occupancy) & mask;
            while (targets != 0) {
                let to = bit_scan_forward(targets);
                targets = clear_lowest_bit(targets);
                if (self.is_empty_square(to)) {
                    list.add(encode_move(from, to, 0));
                } else {
                    list.add(encode_move(from, to, 4));
                }
            }
        }
    }

    fn generate_queen_moves(self, ref list: MoveList, mask: int) {
        let us = self.side;
        var queens = self.pieces(us, PieceKind.Queen);
        while (queens != 0) {
            let from = bit_scan_forward(queens);
            queens = clear_lowest_bit(queens);
            var targets = queen_attacks(from, self.occupancy) & mask;
            while (targets != 0) {
                let to = bit_scan_forward(targets);
                targets = clear_lowest_bit(targets);
                if (self.is_empty_square(to)) {
                    list.add(encode_move(from, to, 0));
                } else {
                    list.add(encode_move(from, to, 4));
                }
            }
        }
    }

    fn generate_king_moves(self, ref list: MoveList, mask: int) {
        let from = self.kings.at(color_index(self.side));
        if (from == NO_SQUARE) {
            return;
        }
        var targets = KING_ATTACKS.at(from) & mask;
        while (targets != 0) {
            let to = bit_scan_forward(targets);
            targets = clear_lowest_bit(targets);
            if (self.is_empty_square(to)) {
                list.add(encode_move(from, to, 0));
            } else {
                list.add(encode_move(from, to, 4));
            }
        }
    }

    // Castling. The four rights are checked in one loop over the right bits,
    // with the path tables doing the work that would otherwise be four
    // near-identical blocks.
    fn generate_castling_moves(self, ref list: MoveList) {
        if (self.in_check()) {
            return;
        }
        let us = self.side;
        let them = opposite_color(us);
        var first: int = 0;
        var last: int = 2;
        if (us == Color.Black) {
            first = 2;
            last = 4;
        }
        var index = first;
        while (index < last) {
            let right = 1 << index;
            if ((self.castling & right) == 0) {
                index += 1;
                continue;
            }
            if ((CASTLE_EMPTY_MASK.at(index) & self.occupancy) != 0) {
                index += 1;
                continue;
            }
            // Every square the king passes over, including the one it starts
            // on, must be free of enemy attack.
            var path = CASTLE_SAFE_MASK.at(index);
            var safe: bool = true;
            while (path != 0) {
                let square = bit_scan_forward(path);
                path = clear_lowest_bit(path);
                if (self.is_attacked(square, them)) {
                    safe = false;
                }
            }
            if (safe) {
                var move_kind_bits: int = 2;
                if (index == 1 or index == 3) {
                    move_kind_bits = 3;
                }
                list.add(encode_move(CASTLE_KING_FROM.at(index), CASTLE_KING_TO.at(index), move_kind_bits));
            }
            index += 1;
        }
    }

    // Everything the side to move could play if legality were not checked.
    fn generate_pseudo_legal(self, ref list: MoveList, kind: GenKind) {
        let us = self.side;
        let them = opposite_color(us);
        let ours = self.by_color.at(color_index(us));
        let enemies = self.by_color.at(color_index(them));
        var mask = FULL_BOARD ^ ours;
        if (kind == GenKind.GenCaptures) {
            mask = enemies;
        }
        if (kind == GenKind.GenQuiets) {
            mask = FULL_BOARD ^ self.occupancy;
        }

        self.generate_pawn_moves(list, kind);
        self.generate_knight_moves(list, mask);
        self.generate_bishop_moves(list, mask);
        self.generate_rook_moves(list, mask);
        self.generate_queen_moves(list, mask);
        self.generate_king_moves(list, mask);
        if (kind != GenKind.GenCaptures) {
            self.generate_castling_moves(list);
        }
    }

    // Evasions: when in check, only three things can help. Capture the
    // checker, block the ray (single check only), or move the king.
    fn generate_evasions(self, ref list: MoveList) {
        let us = self.side;
        let king = self.kings.at(color_index(us));
        let checking = self.checkers_of(us);
        let ours = self.by_color.at(color_index(us));

        // The king may always try to run, whatever the number of checkers.
        self.generate_king_moves(list, FULL_BOARD ^ ours);
        if (checking == 0 or has_single_bit(checking) == false) {
            return;
        }

        let checker = bit_scan_forward(checking);
        let target = checking | BETWEEN.at(king).at(checker);
        self.generate_pawn_moves(list, GenKind.GenAll);
        self.generate_knight_moves(list, target);
        self.generate_bishop_moves(list, target);
        self.generate_rook_moves(list, target);
        self.generate_queen_moves(list, target);
    }

    // --- legality ----------------------------------------------------------

    // Is a pseudo-legal move legal? Three cases, in order of frequency:
    //
    //  * a king move must land on a square the enemy does not attack, with
    //    the king itself removed from the occupancy so that it cannot hide
    //    behind its own shadow along a checking ray;
    //  * an en passant capture removes two pieces from one rank at once and
    //    needs the full hypothetical-occupancy test;
    //  * anything else is legal exactly when the mover is not pinned, or is
    //    pinned but stays on its pin line.
    fn is_legal_move(self, m: int) -> bool {
        legality_test_count += 1;
        let us = self.side;
        let them = opposite_color(us);
        let from = move_from(m);
        let to = move_to(m);
        let king = self.kings.at(color_index(us));

        if (from == king) {
            if (move_is_castle(m)) {
                return true;
            }
            let without_king = self.occupancy ^ (1 << from);
            let hypothetical = (without_king | (1 << to)) & (FULL_BOARD ^ (1 << to));
            return self.is_attacked_with(to, them, hypothetical | (1 << to)) == false;
        }

        if (move_is_en_passant(m)) {
            let captured = to - pawn_push_delta(us);
            let hypothetical = (self.occupancy ^ (1 << from) ^ (1 << captured)) | (1 << to);
            var exposed: int = 0;
            exposed |= bishop_attacks(king, hypothetical) & self.diagonal_sliders(them);
            exposed |= rook_attacks(king, hypothetical) & self.straight_sliders(them);
            return exposed == 0;
        }

        let pinned = self.pinned_pieces(us);
        if ((pinned & (1 << from)) == 0) {
            return true;
        }
        return (LINE_THROUGH.at(king).at(from) & (1 << to)) != 0;
    }

    // Full legal generation: generate pseudo-legal moves, then filter. When
    // in check the evasion generator narrows the candidate set first, which
    // is what makes the filter cheap.
    fn generate_legal(self, ref list: MoveList) {
        var pseudo: MoveList;
        if (self.in_check()) {
            self.generate_evasions(pseudo);
        } else {
            self.generate_pseudo_legal(pseudo, GenKind.GenAll);
        }
        var index: int = 0;
        while (index < pseudo.size()) {
            let m = pseudo.packed_at(index);
            if (self.is_legal_move(m)) {
                list.add(m);
            }
            index += 1;
        }
        Destroy(pseudo);
    }

    fn generate_legal_captures(self, ref list: MoveList) {
        var pseudo: MoveList;
        self.generate_pseudo_legal(pseudo, GenKind.GenCaptures);
        var index: int = 0;
        while (index < pseudo.size()) {
            let m = pseudo.packed_at(index);
            if (self.is_legal_move(m)) {
                list.add(m);
            }
            index += 1;
        }
        Destroy(pseudo);
    }

    fn count_legal_moves(self) -> int {
        var list: MoveList;
        self.generate_legal(list);
        let total = list.size();
        Destroy(list);
        return total;
    }

    fn has_legal_move(self) -> bool {
        return self.count_legal_moves() > 0;
    }

    // --- make and unmake ---------------------------------------------------

    // Apply a move, pushing the irreversible state onto the history stack.
    // The order matters: the captured piece comes off before the mover
    // arrives, and the hash is updated as a side effect of each board edit.
    fn make_move(ref self, m: int) {
        make_move_count += 1;
        let us = self.side;
        let them = opposite_color(us);
        let from = move_from(m);
        let to = move_to(m);
        let kind = move_kind(m);
        let mover = self.squares.at(from);

        var record: Undo;
        record.move_packed = m;
        record.castling = self.castling;
        record.ep_square = self.ep_square;
        record.halfmove = self.halfmove;
        record.key = self.key;
        record.captured = PIECE_CODE_COUNT;

        // Retire the old en passant file from the hash before it changes.
        if (self.ep_square != NO_SQUARE) {
            self.key ^= ZOBRIST_EP_FILE.at(file_of(self.ep_square));
        }
        self.key ^= ZOBRIST_CASTLING.at(self.castling & CASTLE_ALL);

        self.ep_square = NO_SQUARE;
        self.halfmove += 1;

        if (kind == 5) {
            // En passant: the captured pawn is not on the target square.
            let victim = to - pawn_push_delta(us);
            record.captured = self.squares.at(victim);
            self.remove_piece(victim);
            self.move_piece(from, to);
            self.halfmove = 0;
        } else {
            if (move_is_capture(m)) {
                record.captured = self.squares.at(to);
                self.remove_piece(to);
                self.halfmove = 0;
            }
            self.move_piece(from, to);
        }

        if (piece_kind(mover) == PieceKind.Pawn) {
            self.halfmove = 0;
        }

        // A double push arms the en passant square for exactly one ply.
        if (kind == 1) {
            self.ep_square = to - pawn_push_delta(us);
        }

        // Promotions swap the pawn for the chosen piece on the target.
        if (move_is_promotion(m)) {
            self.remove_piece(to);
            self.put_piece(make_piece(us, move_promotion_kind(m)), to);
        }

        // Castling moves the rook as a second, silent half-move.
        if (kind == 2 or kind == 3) {
            var index: int = 0;
            if (us == Color.White) {
                if (kind == 3) {
                    index = 1;
                }
            } else {
                index = 2;
                if (kind == 3) {
                    index = 3;
                }
            }
            self.move_piece(CASTLE_ROOK_FROM.at(index), CASTLE_ROOK_TO.at(index));
        }

        self.castling &= CASTLE_MASK.at(from);
        self.castling &= CASTLE_MASK.at(to);
        self.key ^= ZOBRIST_CASTLING.at(self.castling & CASTLE_ALL);
        if (self.ep_square != NO_SQUARE) {
            self.key ^= ZOBRIST_EP_FILE.at(file_of(self.ep_square));
        }
        self.key ^= ZOBRIST_SIDE;

        if (us == Color.Black) {
            self.fullmove += 1;
        }
        self.side = them;
        self.ply += 1;
        self.history.push_back(record);
    }

    // Undo the most recent make_move. Every board edit above is its own
    // inverse, so this is the same sequence run backwards.
    fn unmake_move(ref self) {
        Assert(self.history.size() > 0);
        let record = self.history.back();
        let m = record.move_packed;
        let from = move_from(m);
        let to = move_to(m);
        let kind = move_kind(m);
        let us = opposite_color(self.side);

        self.side = us;
        self.ply -= 1;
        if (us == Color.Black) {
            self.fullmove -= 1;
        }

        // Undo the rook half of a castle first, so the king move below sees
        // the board it expects.
        if (kind == 2 or kind == 3) {
            var index: int = 0;
            if (us == Color.White) {
                if (kind == 3) {
                    index = 1;
                }
            } else {
                index = 2;
                if (kind == 3) {
                    index = 3;
                }
            }
            self.move_piece(CASTLE_ROOK_TO.at(index), CASTLE_ROOK_FROM.at(index));
        }

        // A promoted piece becomes a pawn again before it travels back.
        if (move_is_promotion(m)) {
            self.remove_piece(to);
            self.put_piece(make_piece(us, PieceKind.Pawn), to);
        }

        self.move_piece(to, from);

        if (kind == 5) {
            let victim = to - pawn_push_delta(us);
            self.put_piece(record.captured, victim);
        } else {
            if (record.captured < PIECE_CODE_COUNT) {
                self.put_piece(record.captured, to);
            }
        }

        self.castling = record.castling;
        self.ep_square = record.ep_square;
        self.halfmove = record.halfmove;
        self.key = record.key;
        self.history.pop_back();
    }

    // A null move: pass the turn without touching a piece. The search uses
    // it for null-move pruning; it is illegal in real chess, so the caller
    // must check that the side to move is not in check first.
    fn make_null_move(ref self) {
        var record: Undo;
        record.move_packed = MOVE_NULL;
        record.captured = PIECE_CODE_COUNT;
        record.castling = self.castling;
        record.ep_square = self.ep_square;
        record.halfmove = self.halfmove;
        record.key = self.key;
        if (self.ep_square != NO_SQUARE) {
            self.key ^= ZOBRIST_EP_FILE.at(file_of(self.ep_square));
        }
        self.ep_square = NO_SQUARE;
        self.key ^= ZOBRIST_SIDE;
        self.side = opposite_color(self.side);
        self.halfmove += 1;
        self.ply += 1;
        self.history.push_back(record);
    }

    fn unmake_null_move(ref self) {
        Assert(self.history.size() > 0);
        let record = self.history.back();
        self.side = opposite_color(self.side);
        self.castling = record.castling;
        self.ep_square = record.ep_square;
        self.halfmove = record.halfmove;
        self.key = record.key;
        self.ply -= 1;
        self.history.pop_back();
    }

    // --- terminal states ---------------------------------------------------

    fn is_checkmate(self) -> bool {
        return self.in_check() and self.count_legal_moves() == 0;
    }

    fn is_stalemate(self) -> bool {
        return self.in_check() == false and self.count_legal_moves() == 0;
    }

    fn is_fifty_move_draw(self) -> bool {
        return self.halfmove >= FIFTY_MOVE_PLIES;
    }

    // King versus king, king and minor versus king, and king and bishop
    // versus king and same-coloured bishop are the drawn material configs.
    fn is_insufficient_material(self) -> bool {
        let pawns = self.by_kind.at(kind_index(PieceKind.Pawn));
        let rooks = self.by_kind.at(kind_index(PieceKind.Rook));
        let queens = self.by_kind.at(kind_index(PieceKind.Queen));
        if ((pawns | rooks | queens) != 0) {
            return false;
        }
        let knights = self.by_kind.at(kind_index(PieceKind.Knight));
        let bishops = self.by_kind.at(kind_index(PieceKind.Bishop));
        let minors = knights | bishops;
        if (popcount(minors) <= 1) {
            return true;
        }
        if (knights == 0 and popcount(bishops) == 2) {
            if ((bishops & LIGHT_SQUARES) == bishops) {
                return true;
            }
            if ((bishops & DARK_SQUARES) == bishops) {
                return true;
            }
        }
        return false;
    }

    // Has the current key appeared `limit` times in the history? The scan
    // only needs to look at every second entry, since the side to move must
    // match, and can stop at the last irreversible move.
    fn repetition_count(self) -> int {
        var seen: int = 0;
        var index = self.history.size() - 2;
        var span: int = 0;
        while (index >= 0 and span < self.halfmove) {
            if (self.history.at(index).key == self.key) {
                seen += 1;
            }
            index -= 2;
            span += 2;
        }
        return seen;
    }

    fn result(self) -> GameResult {
        if (self.count_legal_moves() == 0) {
            if (self.in_check()) {
                if (self.side == Color.White) {
                    return GameResult.BlackWins;
                }
                return GameResult.WhiteWins;
            }
            return GameResult.DrawStalemate;
        }
        if (self.is_fifty_move_draw()) {
            return GameResult.DrawFiftyMove;
        }
        if (self.is_insufficient_material()) {
            return GameResult.DrawInsufficient;
        }
        if (self.repetition_count() >= 2) {
            return GameResult.DrawRepetition;
        }
        return GameResult.Ongoing;
    }

    // Does `m` give check, without playing it? The direct case is a table
    // lookup against the enemy king; the discovered case asks whether the
    // origin square was a blocker on some ray to that king.
    fn gives_check(self, m: int) -> bool {
        let us = self.side;
        let them = opposite_color(us);
        let enemy_king = self.kings.at(color_index(them));
        if (enemy_king == NO_SQUARE) {
            return false;
        }
        let from = move_from(m);
        let to = move_to(m);
        var kind = piece_kind(self.squares.at(from));
        if (move_is_promotion(m)) {
            kind = move_promotion_kind(m);
        }
        let after = (self.occupancy ^ (1 << from)) | (1 << to);
        if ((attacks_of_kind(kind, us, to, after) & (1 << enemy_king)) != 0) {
            return true;
        }
        let candidates = self.discovery_candidates(us);
        if ((candidates & (1 << from)) == 0) {
            return false;
        }
        return (LINE_THROUGH.at(enemy_king).at(from) & (1 << to)) == 0;
    }

    // The cheapest attacker of `square` belonging to `color`, as a bit. The
    // static exchange loop pops these one at a time.
    fn least_valuable_attacker(self, attackers: int, color: Color) -> int {
        var kind: int = 0;
        while (kind < PIECE_KIND_COUNT) {
            let subset = attackers
                & self.by_color.at(color_index(color))
                & self.by_kind.at(kind);
            if (subset != 0) {
                return lowest_bit(subset);
            }
            kind += 1;
        }
        return 0;
    }

    // --- fields ------------------------------------------------------------

    // The mailbox: one piece code per square, PIECE_CODE_COUNT for empty.
    var squares: vector(int);
    // Two colour unions and six kind unions; a piece board is their and.
    var by_color: vector(int);
    var by_kind: vector(int);
    // The union of both colours, kept in step with every board edit.
    var occupancy: int = 0;
    // Cached king squares, because is_attacked wants them on every node.
    var kings: vector(int);
    var side: Color = Color.White;
    var castling: int = 0;
    var ep_square: int = -1;
    var halfmove: int = 0;
    var fullmove: int = 1;
    var key: int = 0;
    var ply: int = 0;
    var history: vector(Undo);
}

// --- Notation -------------------------------------------------------------

// 'a'..'h' for a file index, '1'..'8' for a rank index.
fn file_char(file: int) -> char {
    return CHAR_LOWER_A + file;
}

fn rank_char(rank: int) -> char {
    return CHAR_ZERO + 1 + rank;
}

fn char_to_file(c: char) -> int {
    return c - CHAR_LOWER_A;
}

fn char_to_rank(c: char) -> int {
    return c - CHAR_ZERO - 1;
}

// Coordinate name of a square: "e4", "a1", or "-" for the null square.
fn square_name(square: int) -> string {
    var out: string;
    if (square == NO_SQUARE) {
        out.push_back(CHAR_DASH);
        return out;
    }
    out.push_back(file_char(file_of(square)));
    out.push_back(rank_char(rank_of(square)));
    return out;
}

fn square_from_name(name: string) -> int {
    if (name.size() < 2) {
        return NO_SQUARE;
    }
    let file = char_to_file(name.at(0));
    let rank = char_to_rank(name.at(1));
    if (file < 0 or file >= BOARD_FILES or rank < 0 or rank >= BOARD_RANKS) {
        return NO_SQUARE;
    }
    return make_square(file, rank);
}

// The lowercase letter for a piece kind, as used by FEN and by SAN.
fn kind_char(kind: PieceKind) -> char {
    if (kind == PieceKind.Pawn) {
        return 'p';
    } else { if (kind == PieceKind.Knight) {
        return 'n';
    } else { if (kind == PieceKind.Bishop) {
        return 'b';
    } else { if (kind == PieceKind.Rook) {
        return 'r';
    } else { if (kind == PieceKind.Queen) {
        return 'q';
    } else { if (kind == PieceKind.King) {
        return 'k';
    } else {
        return '?';
    } } } } } }
}

fn char_to_kind(c: char) -> PieceKind {
    var lower = c;
    if (lower >= CHAR_UPPER_A and lower < CHAR_UPPER_A + 26) {
        lower = lower | CASE_BIT;
    }
    if (lower == 'p') {
        return PieceKind.Pawn;
    } else { if (lower == 'n') {
        return PieceKind.Knight;
    } else { if (lower == 'b') {
        return PieceKind.Bishop;
    } else { if (lower == 'r') {
        return PieceKind.Rook;
    } else { if (lower == 'q') {
        return PieceKind.Queen;
    } else { if (lower == 'k') {
        return PieceKind.King;
    } else {
        return PieceKind.KindNone;
    } } } } } }
}

// The FEN letter for a piece code: uppercase for white, lowercase for black.
fn piece_char(piece: int) -> char {
    if (piece_is_empty(piece)) {
        return '.';
    }
    let letter = kind_char(piece_kind(piece));
    if (piece_color(piece) == Color.White) {
        return letter & (FULL_BOARD ^ CASE_BIT);
    }
    return letter;
}

// Long algebraic (UCI) form: "e2e4", "e7e8q", "e1g1" for a castle.
fn move_to_uci(m: int) -> string {
    var out: string;
    if (move_is_null(m)) {
        out.append("0000");
        return out;
    }
    let from = move_from(m);
    let to = move_to(m);
    out.push_back(file_char(file_of(from)));
    out.push_back(rank_char(rank_of(from)));
    out.push_back(file_char(file_of(to)));
    out.push_back(rank_char(rank_of(to)));
    if (move_is_promotion(m)) {
        out.push_back(kind_char(move_promotion_kind(m)));
    }
    return out;
}

// Parse a UCI move against a position, so that the promotion suffix and the
// capture and castle flags can be reconstructed. Returns MOVE_NULL when the
// text does not name a legal move.
fn move_from_uci(board: Position, text: string) -> int {
    if (text.size() < 4) {
        return MOVE_NULL;
    }
    let from = make_square(char_to_file(text.at(0)), char_to_rank(text.at(1)));
    let to = make_square(char_to_file(text.at(2)), char_to_rank(text.at(3)));
    var promotion = PieceKind.KindNone;
    if (text.size() >= 5) {
        promotion = char_to_kind(text.at(4));
    }

    var list: MoveList;
    board.generate_legal(list);
    var index: int = 0;
    var found: int = MOVE_NULL;
    while (index < list.size()) {
        let m = list.packed_at(index);
        if (move_from(m) == from and move_to(m) == to) {
            if (move_is_promotion(m) == false and promotion == PieceKind.KindNone) {
                found = m;
            }
            if (move_is_promotion(m) and move_promotion_kind(m) == promotion) {
                found = m;
            }
        }
        index += 1;
    }
    Destroy(list);
    return found;
}

// Standard algebraic notation. The disambiguation rules are the fiddly part:
// when two identical pieces can reach the same square, the file is added,
// then the rank, then both.
fn move_to_san(board: Position, m: int) -> string {
    var out: string;
    if (move_is_king_castle(m)) {
        out.append("O-O");
        return out;
    }
    if (move_is_castle(m)) {
        out.append("O-O-O");
        return out;
    }

    let from = move_from(m);
    let to = move_to(m);
    let mover = board.piece_at(from);
    let kind = piece_kind(mover);

    if (kind == PieceKind.Pawn) {
        if (move_is_capture(m)) {
            out.push_back(file_char(file_of(from)));
            out.push_back('x');
        }
        out.push_back(file_char(file_of(to)));
        out.push_back(rank_char(rank_of(to)));
        if (move_is_promotion(m)) {
            out.push_back('=');
            out.push_back(kind_char(move_promotion_kind(m)) & (FULL_BOARD ^ CASE_BIT));
        }
        return out;
    }

    out.push_back(kind_char(kind) & (FULL_BOARD ^ CASE_BIT));

    // Find every other piece of the same kind that could also play to `to`.
    var same_file: bool = false;
    var same_rank: bool = false;
    var ambiguous: bool = false;
    var list: MoveList;
    board.generate_legal(list);
    var index: int = 0;
    while (index < list.size()) {
        let other = list.packed_at(index);
        let other_from = move_from(other);
        if (other_from != from and move_to(other) == to) {
            if (piece_kind(board.piece_at(other_from)) == kind) {
                ambiguous = true;
                if (file_of(other_from) == file_of(from)) {
                    same_file = true;
                }
                if (rank_of(other_from) == rank_of(from)) {
                    same_rank = true;
                }
            }
        }
        index += 1;
    }
    Destroy(list);

    if (ambiguous) {
        if (same_file == false) {
            out.push_back(file_char(file_of(from)));
        } else {
            if (same_rank == false) {
                out.push_back(rank_char(rank_of(from)));
            } else {
                out.push_back(file_char(file_of(from)));
                out.push_back(rank_char(rank_of(from)));
            }
        }
    }

    if (move_is_capture(m)) {
        out.push_back('x');
    }
    out.push_back(file_char(file_of(to)));
    out.push_back(rank_char(rank_of(to)));

    if (board.gives_check(m)) {
        out.push_back('+');
    }
    return out;
}

// --- FEN ------------------------------------------------------------------

// The standard start position, and a couple of the positions whose perft
// numbers everyone checks a new generator against.
let START_FEN: string = "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1";
let KIWIPETE_FEN: string = "r3k2r/p1ppqpb1/bn2pnp1/3PN3/1p2P3/2N2Q1p/PPPBBPPP/R3K2R w KQkq - 0 1";
let ENDGAME_FEN: string = "8/2p5/3p4/KP5r/1R3p1k/8/4P1P1/8 w - - 0 1";
let PROMOTION_FEN: string = "n1n5/PPPk4/8/8/8/8/4Kppp/5N1N b - - 0 1";

// Parse a FEN string into `board`. The six fields are walked with a single
// cursor rather than being split first, because the language has no string
// splitting in its standard surface.
fn parse_fen(ref board: Position, fen: string) -> bool {
    board.reset();

    var cursor: int = 0;
    let length = fen.size();

    // Field one: the piece placement, rank eight first, files a to h.
    var rank: int = BOARD_RANKS - 1;
    var file: int = 0;
    while (cursor < length) {
        let c = fen.at(cursor);
        if (c == CHAR_SPACE) {
            cursor += 1;
            break;
        }
        if (c == CHAR_SLASH) {
            rank -= 1;
            file = 0;
            cursor += 1;
            continue;
        }
        if (c >= CHAR_ZERO and c <= CHAR_NINE) {
            file += c - CHAR_ZERO;
            cursor += 1;
            continue;
        }
        let kind = char_to_kind(c);
        if (kind == PieceKind.KindNone) {
            return false;
        }
        var color = Color.Black;
        if (c < CHAR_LOWER_A) {
            color = Color.White;
        }
        if (rank < 0 or rank >= BOARD_RANKS or file < 0 or file >= BOARD_FILES) {
            return false;
        }
        board.put_piece(make_piece(color, kind), make_square(file, rank));
        file += 1;
        cursor += 1;
    }

    // Field two: the side to move.
    if (cursor < length) {
        if (fen.at(cursor) == 'b') {
            board.side = Color.Black;
        } else {
            board.side = Color.White;
        }
        cursor += 1;
    }
    while (cursor < length and fen.at(cursor) == CHAR_SPACE) {
        cursor += 1;
    }

    // Field three: the castling rights, in KQkq order or a bare dash.
    board.castling = CASTLE_NONE;
    while (cursor < length) {
        let c = fen.at(cursor);
        if (c == CHAR_SPACE) {
            cursor += 1;
            break;
        }
        if (c == 'K') {
            board.castling |= CASTLE_WHITE_KING;
        }
        if (c == 'Q') {
            board.castling |= CASTLE_WHITE_QUEEN;
        }
        if (c == 'k') {
            board.castling |= CASTLE_BLACK_KING;
        }
        if (c == 'q') {
            board.castling |= CASTLE_BLACK_QUEEN;
        }
        cursor += 1;
    }

    // Field four: the en passant target square.
    board.ep_square = NO_SQUARE;
    if (cursor < length) {
        let c = fen.at(cursor);
        if (c == CHAR_DASH) {
            cursor += 2;
        } else {
            if (cursor + 1 < length) {
                board.ep_square = make_square(char_to_file(c), char_to_rank(fen.at(cursor + 1)));
            }
            cursor += 3;
        }
    }

    // Fields five and six: the halfmove clock and the fullmove number.
    var halfmove: int = 0;
    while (cursor < length and fen.at(cursor) >= CHAR_ZERO and fen.at(cursor) <= CHAR_NINE) {
        halfmove = halfmove * 10 + (fen.at(cursor) - CHAR_ZERO);
        cursor += 1;
    }
    board.halfmove = halfmove;
    while (cursor < length and fen.at(cursor) == CHAR_SPACE) {
        cursor += 1;
    }

    var fullmove: int = 0;
    while (cursor < length and fen.at(cursor) >= CHAR_ZERO and fen.at(cursor) <= CHAR_NINE) {
        fullmove = fullmove * 10 + (fen.at(cursor) - CHAR_ZERO);
        cursor += 1;
    }
    if (fullmove == 0) {
        fullmove = 1;
    }
    board.fullmove = fullmove;
    board.key = board.compute_key();
    return true;
}

// Serialise a position back to FEN. The run-length encoding of empty squares
// is the only interesting part.
fn to_fen(board: Position) -> string {
    var out: string;
    var rank: int = BOARD_RANKS - 1;
    while (rank >= 0) {
        var empty_run: int = 0;
        var file: int = 0;
        while (file < BOARD_FILES) {
            let piece = board.piece_at(make_square(file, rank));
            if (piece_is_empty(piece)) {
                empty_run += 1;
            } else {
                if (empty_run > 0) {
                    out.push_back(CHAR_ZERO + empty_run);
                    empty_run = 0;
                }
                out.push_back(piece_char(piece));
            }
            file += 1;
        }
        if (empty_run > 0) {
            out.push_back(CHAR_ZERO + empty_run);
        }
        if (rank > 0) {
            out.push_back(CHAR_SLASH);
        }
        rank -= 1;
    }

    out.push_back(CHAR_SPACE);
    if (board.side_to_move() == Color.White) {
        out.push_back('w');
    } else {
        out.push_back('b');
    }

    out.push_back(CHAR_SPACE);
    let rights = board.castling_rights();
    if (rights == CASTLE_NONE) {
        out.push_back(CHAR_DASH);
    } else {
        if ((rights & CASTLE_WHITE_KING) != 0) {
            out.push_back('K');
        }
        if ((rights & CASTLE_WHITE_QUEEN) != 0) {
            out.push_back('Q');
        }
        if ((rights & CASTLE_BLACK_KING) != 0) {
            out.push_back('k');
        }
        if ((rights & CASTLE_BLACK_QUEEN) != 0) {
            out.push_back('q');
        }
    }

    out.push_back(CHAR_SPACE);
    out.append(square_name(board.en_passant_square()));
    out.push_back(CHAR_SPACE);
    out.append(to_string(board.halfmove_clock()));
    out.push_back(CHAR_SPACE);
    out.append(to_string(board.fullmove_number()));
    return out;
}

// An ASCII diagram of the board, rank eight at the top.
fn board_to_text(board: Position) -> string {
    var out: string;
    var rank: int = BOARD_RANKS - 1;
    while (rank >= 0) {
        out.push_back(rank_char(rank));
        out.push_back(CHAR_SPACE);
        var file: int = 0;
        while (file < BOARD_FILES) {
            out.push_back(piece_char(board.piece_at(make_square(file, rank))));
            out.push_back(CHAR_SPACE);
            file += 1;
        }
        out.push_back('\n');
        rank -= 1;
    }
    out.append("  a b c d e f g h\n");
    return out;
}

// --- Perft ----------------------------------------------------------------

// Node counts per depth, so the driver can print a table.
var perft_node_counts: vector(int) = vector(int)(16);
var perft_capture_counts: vector(int) = vector(int)(16);
var perft_ep_counts: vector(int) = vector(int)(16);
var perft_castle_counts: vector(int) = vector(int)(16);
var perft_promotion_counts: vector(int) = vector(int)(16);
var perft_check_counts: vector(int) = vector(int)(16);

fn reset_perft_counters() {
    var depth: int = 0;
    while (depth < 16) {
        perft_node_counts.at(depth) = 0;
        perft_capture_counts.at(depth) = 0;
        perft_ep_counts.at(depth) = 0;
        perft_castle_counts.at(depth) = 0;
        perft_promotion_counts.at(depth) = 0;
        perft_check_counts.at(depth) = 0;
        depth += 1;
    }
}

// The plain leaf counter. At depth one the number of legal moves *is* the
// answer, which saves a whole ply of make/unmake.
fn perft(ref board: Position, depth: int) -> int {
    if (depth == 0) {
        return 1;
    }
    var list: MoveList;
    board.generate_legal(list);
    if (depth == 1) {
        let leaves = list.size();
        Destroy(list);
        return leaves;
    }
    var nodes: int = 0;
    var index: int = 0;
    while (index < list.size()) {
        let m = list.packed_at(index);
        board.make_move(m);
        nodes += perft(board, depth - 1);
        board.unmake_move();
        index += 1;
    }
    Destroy(list);
    return nodes;
}

// The instrumented variant, which also fills the per-depth breakdown that a
// generator bug shows up in long before the node total does.
fn perft_detailed(ref board: Position, depth: int, ply: int) -> int {
    if (depth == 0) {
        perft_node_counts.at(ply) += 1;
        return 1;
    }
    var list: MoveList;
    board.generate_legal(list);
    var nodes: int = 0;
    var index: int = 0;
    while (index < list.size()) {
        let m = list.packed_at(index);
        if (move_is_capture(m)) {
            perft_capture_counts.at(ply) += 1;
        }
        if (move_is_en_passant(m)) {
            perft_ep_counts.at(ply) += 1;
        }
        if (move_is_castle(m)) {
            perft_castle_counts.at(ply) += 1;
        }
        if (move_is_promotion(m)) {
            perft_promotion_counts.at(ply) += 1;
        }
        if (board.gives_check(m)) {
            perft_check_counts.at(ply) += 1;
        }
        board.make_move(m);
        nodes += perft_detailed(board, depth - 1, ply + 1);
        board.unmake_move();
        index += 1;
    }
    Destroy(list);
    perft_node_counts.at(ply) += nodes;
    return nodes;
}

// Per-root-move node counts, the standard way to bisect a generator bug
// against a reference implementation.
fn perft_divide(ref board: Position, depth: int) {
    var list: MoveList;
    board.generate_legal(list);
    var total: int = 0;
    var index: int = 0;
    while (index < list.size()) {
        let m = list.packed_at(index);
        board.make_move(m);
        let nodes = perft(board, depth - 1);
        board.unmake_move();
        total += nodes;

        var line: string;
        line.append(move_to_uci(m));
        line.append(": ");
        line.append(to_string(nodes));
        println(line);
        Destroy(line);
        index += 1;
    }
    Destroy(list);

    var summary: string;
    summary.append("total: ");
    summary.append(to_string(total));
    println(summary);
    Destroy(summary);
}

// Make and unmake every legal move, asserting the position is byte for byte
// what it was. This catches an unmake bug immediately instead of at the next
// perft mismatch twelve plies deeper.
fn verify_make_unmake(ref board: Position) -> bool {
    let key_before = board.hash_key();
    let occupancy_before = board.occupied();
    let castling_before = board.castling_rights();

    var list: MoveList;
    board.generate_legal(list);
    var index: int = 0;
    var ok: bool = true;
    while (index < list.size()) {
        let m = list.packed_at(index);
        board.make_move(m);
        board.unmake_move();
        if (board.hash_key() != key_before) {
            ok = false;
        }
        if (board.occupied() != occupancy_before) {
            ok = false;
        }
        if (board.castling_rights() != castling_before) {
            ok = false;
        }
        index += 1;
    }
    Destroy(list);
    Assert(board.hash_key() == key_before);
    Prove(board.occupied() == occupancy_before);
    return ok;
}

// --- Evaluation tables ----------------------------------------------------

// Centipawn material values, middlegame and endgame. A king is scored as
// zero: both sides always have exactly one, so any value cancels.
var MATERIAL_MG: vector(int) = vector(int)(PIECE_KIND_COUNT);
var MATERIAL_EG: vector(int) = vector(int)(PIECE_KIND_COUNT);

// Phase weights: the game is "endgame" once the weighted sum of the
// remaining pieces falls to zero. A full board sums to PHASE_TOTAL.
var PHASE_WEIGHT: vector(int) = vector(int)(PIECE_KIND_COUNT);
let PHASE_TOTAL: int = 24;

// Piece-square tables, one per kind per phase, indexed from white's point of
// view. Black reads them through flip_rank.
var PST_MG: vector(vector(int)) = vector(vector(int))(PIECE_KIND_COUNT);
var PST_EG: vector(vector(int)) = vector(vector(int))(PIECE_KIND_COUNT);

// PASSED_MASK[c][s] is every square that could hold an enemy pawn stopping
// the pawn on s: the three files around s, from the next rank forward.
var PASSED_MASK: vector(vector(int)) = vector(vector(int))(COLOR_COUNT);

// The king zone is the king's square plus its eight neighbours plus the
// three squares two ranks ahead, which is where an attack builds up.
var KING_ZONE: vector(vector(int)) = vector(vector(int))(COLOR_COUNT);

// Bonus per attacker weight, saturating at the end of the table.
var KING_ATTACK_SCALE: vector(int) = vector(int)(64);

// Structural bonuses and penalties, all in centipawns.
let BONUS_BISHOP_PAIR: int = 45;
let BONUS_ROOK_OPEN_FILE: int = 28;
let BONUS_ROOK_SEMI_OPEN: int = 14;
let BONUS_PASSED_BASE: int = 12;
let BONUS_PASSED_RANK: int = 14;
let BONUS_CONNECTED_PAWN: int = 8;
let PENALTY_DOUBLED_PAWN: int = -18;
let PENALTY_ISOLATED_PAWN: int = -14;
let PENALTY_BACKWARD_PAWN: int = -9;
let PENALTY_KING_EXPOSED: int = -22;
let MOBILITY_WEIGHT_MG: int = 4;
let MOBILITY_WEIGHT_EG: int = 2;
let TEMPO_BONUS: int = 12;

// Write one rank of a piece-square table. The eight values are listed file a
// to file h, and the rank argument is the white-side rank, so the tables can
// be typed in the order a human draws a board.
fn set_pst_rank(ref table: vector(int), rank: int, v0: int, v1: int, v2: int, v3: int, v4: int, v5: int, v6: int, v7: int) {
    table.at(make_square(0, rank)) = v0;
    table.at(make_square(1, rank)) = v1;
    table.at(make_square(2, rank)) = v2;
    table.at(make_square(3, rank)) = v3;
    table.at(make_square(4, rank)) = v4;
    table.at(make_square(5, rank)) = v5;
    table.at(make_square(6, rank)) = v6;
    table.at(make_square(7, rank)) = v7;
}

fn init_material() {
    MATERIAL_MG.at(0) = 82;
    MATERIAL_MG.at(1) = 337;
    MATERIAL_MG.at(2) = 365;
    MATERIAL_MG.at(3) = 477;
    MATERIAL_MG.at(4) = 1025;
    MATERIAL_MG.at(5) = 0;

    MATERIAL_EG.at(0) = 94;
    MATERIAL_EG.at(1) = 281;
    MATERIAL_EG.at(2) = 297;
    MATERIAL_EG.at(3) = 512;
    MATERIAL_EG.at(4) = 936;
    MATERIAL_EG.at(5) = 0;

    PHASE_WEIGHT.at(0) = 0;
    PHASE_WEIGHT.at(1) = 1;
    PHASE_WEIGHT.at(2) = 1;
    PHASE_WEIGHT.at(3) = 2;
    PHASE_WEIGHT.at(4) = 4;
    PHASE_WEIGHT.at(5) = 0;
}



enum Token: {
    LeftParen; // (
    RightParen; // )
    LeftAngle; // [
    RightAngle; // ]
    LeftBrace; // {
    RightBrace; // }

    FirstBracket = LeftParen;
    LastBracket = RightBrace;

    // begin unary
    Exclaim; // !
    Tilde; // ~
    PlusPlus; // ++
    MinusMinus; // --
    // begin binary
    Plus; // +
    Minus; // -
    // end unary
    Amp; // &
    AmpAmp; // &&
    Hat; // ^
    Vert; // |
    VertVert; // ||
    Star; // *
    Slash; // /
    Percent; // %
    LessLess; // <<
    GreaterGreater; // >>
    ExclaimEqual; // !=
    EqualEqual; // ==
    Less; // <
    LessEqual; // <=
    Greater; // >
    GreaterEqual; // >=
    // end binary
    // begin assign
    PlusEqual; // +=
    MinusEqual; // -=
    AmpEqual; // &=
    AmpAmpEqual; // &&=
    HatEqual; // ^=
    VertEqual; // |=
    VertVertEqual; // ||=
    StarEqual; // *=
    SlashEqual; // /=
    PercentEqual; // %=
    LessLessEqual; // <<=
    GreaterGreaterEqual; // >>=
    // end assign

    FirstUnaryOp = Exclaim;
    FirstBinaryOp = Plus;
    LastUnaryOp = Minus;
    LastBinaryOp = GreaterEqual;
    FirstAssignOp = PlusEqual;
    LastAssignOp = GreaterGreaterEqual;

    Equal; // =
    Question; // ?
    Comma; // ,
    Point; // .
    PointPoint; // ..
    Colon; // :
    ColonColon; // ::
    SemiColon; // ;
    Word; // abc123

    IntegerLiteral;
    FirstLiteral = IntegerLiteral;
    LastLiteral = IntegerLiteral;

    EOF;
}

namespace lookup_table: {

struct Input: {
    firstChar: uint8;
    lastChar: uint8 = beginChar;
    bare: Token;
    repeat: Opt{Token} = ();
    equal: Opt{Token} = ();
    repeatEqual: Opt{Token} = ();
    bareAdvance: int = 1;
}

struct Output: {
    tok: Opt{Token} = ();
    advance: int = 0;
}

fn computeIndex(char: uint8, repeat: bool, equal: bool): {
    mut out: int = char - 0x20;
    if repeat:
        out += 0x60;
    if equal:
        out += 0x60 * 2;
    return out;
}

fn makeTable(inputs: Array{Input}): {
    mut out: Array{Output} = ();
    out.resize(0x60 * 4);

    for input in inputs: {
        for char in incRange(input.firstCahr, input.lastChar): {
            let bareOut: Output = (input.bare, input.bareAdvance);
            out[computeIndex(char, false, false)] = bareOut;

            let repeatOut = if input.repeat.hasValue() => Output(input.repeat.value(), 2), else => bareOut;
            out[computeIndex(char, true, false)] = repeatOut;
            out[computeIndex(char, false, true)] = if input.repeat.hasValue() => Output(input.equal.value(), 2), else => bareOut;
            out[computeIndex(char, true, true)] = if input.repeatEqual.hasValue() => Output(input.repeatEqual.value(), 3), else => repeatOut;
        }
    }

    return out;
}

static table = [
    using enum Token;
    makeTable((
        ('(', bare = LeftParen),
        (')', bare = RightParen),
        ('[', bare = LeftAngle),
        (']', bare = RightAngle),
        ('{', bare = LeftBrace),
        ('}', bare = RightBrace),
        (';', bare = SemiColon),
        (',', bare = Colon),
        ('?', bare = Question),
        ('~', bare = Tilde),
        
        ('.', bare = Point, repeat = PointPoint),
        (':', bare = Colon, repeat = ColonColon),
        ('=', bare = Equal, repeat = EqualEqual),

        ('!', bare = Exclaim, equal = ExclaimEqual),
        ('^', bare = Hat, equal = HatEqual),
        ('*', bare = Star, equal = StarEqual),
        ('/', bare = Slash, equal = SlashEqual),
        ('%', bare = Percent, equal = PercentEqual),

        ('+', bare = Plus, repeat = PlusPlus, equal = PlusEqual),
        ('-', bare = Minus, repeat = MinusMinus, equal = MinusEqual),

        ('&', bare = Amp, repeat = AmpAmp, equal = AmpEqual, repeatEqual = AmpAmpEqual),
        ('|', bare = Vert, repeat = VertVert, equal = VertEqual, repeatEqual = VertVertEqual),
        ('<', bare = Less, repeat = LessLess, equal = LessEqual, repeatEqual = LessLessEqual),
        ('>', bare = Greater, repeat = GreaterGreater, equal = GreaterEqual, repeatEqual = GreaterGreaterEqual),

        ('0', '9', bare = IntegerLiteral, bareAdvance = 0),
        
        ('a', 'z', bare = Word),
        ('A', 'Z', bare = Word),
        ('_', bare = Word),
    ))];
fn get(char: uint8, repeat: bool, equal: bool) => table[computeIndex(char, repeat, equal)];

}

struct SourcePos: {}

object SourceBuffer: {
    has Index{(int) -> uint8}: {
        fn index(i: int) => uint8();
    }
}

object Parser: {
    sourceOff: int = 0;
    source: SourceBuffer;

    tok: Token = Token::EOF;

    fn skipWhitespace(self&): {
        while isWhitespace(source[sourceOff]):
            sourceOff += 1;
    }
    fn nextToken(self&): {
        skipWhitespace();

        let head = source[sourceOff];

        let repeat = source[sourceOff + 1] == head;

        let equalOff = if repeat => 1, else => 2;
        let equal = source[equalOff] == '=';

        with (advance: int)
        (tok, advance) = lookup_table::get(head, repeat, equal);

        sourceOff += advance;
    }
}
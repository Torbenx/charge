
struct Bar(T: Type) {
    add: T = 0;
    vals: Array{T} = { 1, 2, 3 };
    
    function get(i: num) -> T {
        return vals[i] + add;
    }
}
Foo2 = Bar{num};
struct Foo2 -> Bar{num};

function appendTo{T: Type}(v&: Array{T}, item: T) {
    v.append(item);
}

const sizeOf{T: Type}: num = sizeof(T);


with {cparams: Array{TupleElement}, cargs: Tuple{cparams}, params: Array{TupleElement}, RetT: Type}
function call{f{cargs..}: (params..) -> RetT}(args..: Tuple{params}) -> RetT {
    return f{cargs..}(args..);
}

function test{T: Type, size: num}(defaultValue: T = {}, table: FixedArray{T, num});
call{test}({}, { 1, 2, 3 }); // -> call{test{T = num, size = 3}}
call{test{T = num}}(table = {}); // -> call{test{T = num, size = 0}}


with {T: Type}
struct Specialize(Base: {T} -> Type, Arg: T) -> Base{Arg};


with {b}
isSpecializationOf{special: b{_..}, base: b}: bool = true;

isSpecializationOf{spacial, base}: bool = false;

function doStuff{b, c}(first: b{c}, second: b);


function f{T: Type, x: T}(y: T) { return x + y; }
// f{x = 2}(3) -> ?;


function recurse{x ?greaterThen{0}: ?numeric}() {
    recurse{x - 1}();
}
function recurse{?sameAs{0}: ?numeric}() {
    // base case
}

function recurse{x ?(# > 0): ?numeric}() {
    recurse{x - 1}();
}
function recurse{?(# == 0): ?numeric}() {
    // base case
}


struct Int {
    value: num = 0;
}
convert (i: Int) -> num { return i.value; }
convert (n: num) -> Int { return { n }; }

struct Int {
    value: num = 0;

    convert (self) -> num {
        return value;
    }
    convert (n: num) {
        return Int(value = n);
    }
}

function bar() {
    let lambda = {} => (i: num) { };
    lambda(1);

    let namedLambda = {} => foo(i: num) { };
    namedLambda.foo(1);

    let multiLambda = {} => {
        function foo(i: num) { }
        function bar() { }
    }
    multiLambda.foo(1);
    multiLambda.bar();
}

struct vec3 {
    x: num = 0;
    y: num = 0;
    z: num = 0;

    function lengthSq() -> num;
};
function get() -> vec3;
function q() {
    let { x, y, z } = get();
    let { l = #.lengthSq(), z = #.z, y = #.y } = get();
}

struct Array(T: Type) {
    function popBack(self&) -> T;
    function truncate(self&, newSize: num);
}
function foo() {
    let arr: Array = { 1, 2, 3 };
    let { back = #, arr2 = .self } = arr.popBack();
    let { arr3 = .self } = arr.truncate(3);

    mut mArr: Array = { 4, 5, 6 };
    mArr.popBack();
    let { foo = .self } = (mArr).popBack();
}

struct Vec2 {
    m_x: float;
    m_y: float;

    function x(self&) => m_x;
}
struct Range {
    m_low: float;
    m_high: float;

    function low(self&) => m_low;
    function high(self&) => m_high;
}
struct Rect {
    h: Range;
    v: Range;

    function bottomLeft(self&) => { h.low(), v.low() };
}
function onlyX(v: Vec2) -> float { return v.x(); }
function onlyX(v&: Vec2) = (x: float) { v.x() = x; }
function onlyX(v&: Vec2) => v.x();

function update(v&: float) { v = 2.0; }
function callUpdate(r&: Rect) {
    update(r.bottomLeft().x());
}

struct Array(T: Type) {
    has Index{(int) -> T} {
        function index(self&, i: int) => ...[i];
    }
}

with {T: Type}
function withIndexType{C ?Index{(num) -> T}: Type}(c: C);
with {T: Type}
function withIndexType(c: ?Index{(num) -> T});
with {T: Type}
function getFirst(arr: ?match Array{T}) -> T {
    return arr.first();
};


struct HierarchyRoot(Anchor: Type) {
    id: uint32 = 0;

    has std::AutoInitialize {
        with {T: Type}
        function init(self&: T) {
            id = idfor{T}();
        }
    }

    convert (self) -> HierarchyElement{Anchor} {
        return { id };
    }
}
struct HierarchyElement(Anchor: Type) {
    id: uint32 = 0;
}
function has{T: Type, Anchor: Type}(elm: HierarchyElement{Anchor}) -> bool;
function is{T: Type, Anchor: Type}(elm: HierarchyElement{Anchor}) -> bool {
    return elem.id == idfor{T};
}

struct Expr {
    has HierarchyRoot{Expr};
    function kind(self) -> ExprKind { return (ExprKind)self; }
}
struct ExprKind = HierarchyElement{Expr};
exprKind{T: Type}: ExprKind = elementFor{T};

struct BinaryOperatorExpr {
    has Expr;
}

function dispatch(ref{Expr} e) {
    match e.kind() {
        exprKind{BinaryOperatorExpr} -> {

        }
    }
}
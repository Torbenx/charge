
struct Bar{T: Type} (
    add: T = 0
    vals: Array{T} = { 1, 2, 3 }
    
    function get(i: int) -> T {
        return vals[i] + add;
    }
)
Foo2 = Bar{int};
struct Foo2 -> Bar{int};

function appendTo{T: Type}(v&: Array{T}, item: T) {
    v.append(item);
}

const sizeOf{T: Type}: int = sizeof(T);


with {cparams: Array{TupleElement}, cargs: Tuple{cparams}, params: Array{TupleElement}, RetT: Type}
function call{f{cargs..}: (params..) -> RetT}(args..: Tuple{params}) -> RetT {
    return f{cargs..}(args..);
}

function test{T: Type, size: int}(defaultValue: T = {}, table: FixedArray{T, int});
call{test}({}, { 1, 2, 3 }); // -> call{test{T = int, size = 3}}
call{test{T = int}}(table = {}); // -> call{test{T = int, size = 0}}


with {T: Type}
struct Specialize{Base: {T} -> Type, Arg: T} -> Base{Arg};


with {b}
isSpecializationOf{special: b{_..}, base: b}: bool = true;

isSpecializationOf{spacial, base}: bool = false;

function doStuff{b, c}(first: b{c}, second: b);


function f{T: Type, x: T}(y: T) { return x + y; }
// f{x = 2}(3) -> ?;


function recurse{x ?greaterThen{0}: ?numeric}() {
    recurse{x - 1}();
}
function recurse{?sameAs{0}: ?numeric}() {
    // base case
}

function recurse{x ?(# > 0): ?numeric}() {
    recurse{x - 1}();
}
function recurse{?(# == 0): ?numeric}() {
    // base case
}


struct Int (
    value: int = 0
)
convert (i: Int) -> int { return i.value; }
convert (n: int) -> Int { return { n }; }

struct Int (
    value: int = 0

    convert (self) -> int {
        return value;
    }
    convert (n: int) {
        return Int(value = n);
    }
)

function bar() {
    let lambda = {} => (i: int) { };
    lambda(1);

    let namedLambda = {} => foo(i: int) { };
    namedLambda.foo(1);

    let multiLambda = {} => {
        function foo(i: int) { }
        function bar() { }
    }
    multiLambda.foo(1);
    multiLambda.bar();
}

struct vec3 (
    x: int = 0
    y: int = 0
    z: int = 0

    function lengthSq() -> int;
);
function get() -> vec3;
function q() {
    let { x, y, z } = get();
    let { l = #.lengthSq(), z = #.z, y = #.y } = get();
}

struct Array{T: Type} (
    function popBack(self&) -> T;
    function truncate(self&, newSize: int);
)
function foo() {
    let arr: Array = { 1, 2, 3 };
    let { back = #, arr2 = .self } = arr.popBack();
    let { arr3 = .self } = arr.truncate(3);

    mut mArr: Array = { 4, 5, 6 };
    mArr.popBack();
    let { foo = .self } = (mArr).popBack();
}

struct Vec2 (
    m_x: float;
    m_y: float;

    function x(self&) => m_x
)
struct Range (
    m_low: float;
    m_high: float;

    function low(self&) => m_low
    function high(self&) => m_high
)
struct Rect (
    h: Range
    v: Range

    function bottomLeft(self&) => { h.low(), v.low() }
)
function onlyX(v: Vec2) -> float { return v.x(); }
function onlyX(v&: Vec2) = (x: float) { v.x() = x; }
function onlyX(v&: Vec2) => v.x();

function update(v&: float) { v = 2.0; }
function callUpdate(r&: Rect) {
    update(r.bottomLeft().x());
}

struct Array{T: Type} (
    has Index{(int) -> T} (
        function index(self&, i: int) => ...[i];
    )
)

with {T: Type}
function withIndexType{C ?Index{(int) -> T}: Type}(c: C);
with {T: Type}
function withIndexType(c: ?Index{(int) -> T});
with {T: Type}
function getFirst(arr: ?match Array{T}) -> T {
    return arr.first();
};


struct RootClass{Self: Type} (
    use Anchor = Self;
    m_class: Class{Anchor} = {}

    has std::AutoInitialize (
        with {Self: Type}
        function init(self&) {
            id = class();
        }
    )
    function class(self) -> Class{Anchor} {
        return m_class;
    }
    convert (self) -> Class{Anchor} {
        return class();
    }
)
struct Class{Anchor: Type} (
    function of(T: Type) -> Class{Anchor};
    function type() -> Type;
)
function has{T: Type, Anchor: Type}(elm: Class{Anchor}) -> bool;
function is{T: Type, Anchor: Type}(elm: Class{Anchor}) -> bool {
    return elm == Class{Anchor}::of(T);
}
with {Anchor: Type}
match {T ?ClassRoot{Anchor}: Type} against (class: Class{Anchor}) {
    return performMatch{Class{Anchor}::of(T)}(class);
}
with {Anchor: Type}
match {T ?ClassRoot{Anchor}: Type} against (inst: ?ClassRoot{Anchor}) {
    return performMatch{Class{Anchor}::of(T)}(inst.class());
}
with {Anchor: Type}
match {class: Class{Anchor}} against (inst: ?ClassRoot{Anchor}) {
    return performMatch{class}(inst.class());
}

struct Expr (
    has ClassRoot
)
use ExprClass = Class{Expr}

struct BinaryOperatorExpr (
    has Expr
)

function dispatch(ref{Expr} e) {
    match e {
        BinaryOperatorExpr => {

        }
    }
}

// Binary operators:
// +   ->   Add
// -   ->   Sub
// &   ->   BitAnd
// &&  ->   LogAnd
// ^   ->   BitXor
// |   ->   BitOr
// ||  ->   LogOr
// *   ->   Mul
// /   ->   Div
// %   ->   Rem
// <<  ->   Shl
// >>  ->   Shr

// Unary operators:
// !   ->   LogNot
// ~   ->   BitNot
//          PreInc
//          PreDec
// +   ->   Plus
// -   ->   Neg
//          PostInc
//          PostDec

// Other:
// []  ->   Index
// ()  ->   Invoke

operation Neg(i: Int) -> Int { return -i.value; }
operation Add(i: Int, j: Int) -> Int { return i + j; }
operation assign Add(i&: Int, j: Int) { i += j; }

enum Ordering (
    Less,
    Equal,
    Greater,
)
compare (i: int) with (j: int) -> Ordering {
    if i == j return Ordering::Equal;
    if i < j return Ordering::Less;
    return Ordering::Greater;
}


incomplete final struct SliceResult (
    has ClassRoot

    struct Success (has SliceResult, result: ExprResult)
    struct NotFound (has SliceResult)
    struct Error (has SliceResult)
)
function slice() -> SliceResult;
function doSlice() -> Opt{ExprResult} {
    let r: SliceResult = slice();
    match r.class() {
        SliceResult::Success => return r.result;
        _ => return {};
    }
}
function useSlice() {
    let slice = doSlice() else return;
}
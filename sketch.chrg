
struct Bar{T: Type} (
    add: T = 0
    vals: Array{T} = { 1, 2, 3 }
    
    function get(i: int) => T:{
        return vals[i] + add;
    }
)
Foo2 = Bar{int};
struct Foo2 -> Bar{int};

function appendTo{T: Type}(v&: Array{T}, item: T) => {
    v.append(item);
}

const sizeOf{T: Type}: int = sizeof(T);


with {cparams: Array{TupleElement}, cargs: Tuple{cparams}, params: Array{TupleElement}, RetT: Type}
function call{f{cargs..}: (params..) -> RetT}(args..: Tuple{undeduced(params)}) -> RetT {
    return f{cargs..}(args..);
}

function test{T: Type, size: int}(defaultValue: T = {}, table: FixedArray{T, int});
call{test}({}, { 1, 2, 3 }); // -> call{test{T = int, size = 3}}
call{test{T = int}}(table = {}); // -> call{test{T = int, size = 0}}


with {base}
isSpecializationOf{?match base{_..}, base}: bool = true;

isSpecializationOf{spacial, base}: bool = false;

function doStuff{b, c}(first: b{c}, second: b);


function recurse{x ?[# > 0]}() {
    recurse{x - 1}();
}
function recurse{?match 0}() {
    // base case
}


struct Int (
    value: int = 0
)
convert (i: Int) => int:{ return i.value; }
convert (n: int) => Int:{ return { n }; }

struct Int (
    value: int = 0

    convert (self) => int:{
        return value;
    }
    convert (n: int) => {
        return Int(value = n);
    }
)

function bar() {
    let lambda = (i: int) => int:{
        let j: int = calc(i);
        return i == j * j;
    };
    let lambda = (i: int) => [let j: int = calc(i); i == j * j];

    let lambda = [let j: int = calc(#); # == j * j];
    lambda(1);

    mut i: int = 0;
    let withCapture = with{j = i} (k: int) => j + k;
}

struct vec3 (
    x: int = 0
    y: int = 0
    z: int = 0

    function lengthSq() => int:{}
)
function get() => vec3:{}
function q() => {
    with {x, y, z}
    { x, y, z } = get();
    with {l, z, y}
    { l = #.lengthSq(), z = #.z, y = #.y } = get();
}

struct Array{T: Type} (
    function popBack(self&) => T:{}
    function truncate(self&, newSize: int) => {}
)
function foo() {
    let arr: Array = { 1, 2, 3 };
    with {back, arr2}
    { back = #, arr2 = .self } = arr.popBack();
    with {arr3}
    { arr3 = .self } = arr.truncate(3);

    mut mArr: Array = { 4, 5, 6 };
    mArr.popBack();
    with {foo}
    { foo = .self } = (mArr).popBack();
}

struct Vec2 (
    m_x: float
    m_y: float

    function x(self&) <=> m_x
)
struct Range (
    m_low: float
    m_high: float

    function low(self&) <=> m_low
    function high(self&) <=> m_high
)
struct Rect (
    h: Range
    v: Range

    function bottomLeft(self&) <=> Vec2(h.low(), v.low())
)
function onlyX(v: Vec2) => v.x();
function onlyX(v&: Vec2) = (x: float) { v.x() = x; }
function onlyX(v&: Vec2) <=> v.x();

function update(v&: float) { v = 2.0; }
function callUpdate(r&: Rect) {
    update(r.bottomLeft().x());
}

struct Array{T: Type} (
    has Index{(int) -> T} (
        function index(self&, i: int) => ...[i];
    )
)

with {T: Type}
function withIndexType{C ?Index{(int) -> T}: Type}(c: C) => {}
with {T: Type}
function withIndexType(c: ?Index{(int) -> T}) => {}
with {T: Type}
function getFirst(arr: ?match Array{T}) => T:{
    return arr.first();
}


// Binary operators:
// +   ->   Add
// -   ->   Sub
// &   ->   BitAnd
// &&  ->   LogAnd
// ^   ->   BitXor
// |   ->   BitOr
// ||  ->   LogOr
// *   ->   Mul
// /   ->   Div
// %   ->   Rem
// <<  ->   Shl
// >>  ->   Shr

// Unary operators:
// !   ->   LogNot
// ~   ->   BitNot
//          PreInc
//          PreDec
// +   ->   Plus
// -   ->   Neg
//          PostInc
//          PostDec

// Other:
// []  ->   Index
// ()  ->   Invoke

operation Neg(i: Int) => -i.value;
operation Add(i: Int, j: Int) => i + j;
operation assign Add(i&: Int, j: Int) { i += j; }

enum Ordering (
    Less,
    Equal,
    Greater,
)
compare (i: int) with (j: int) => Ordering:{
    if i == j return Ordering::Equal;
    if i < j return Ordering::Less;
    return Ordering::Greater;
}


struct Enum{Anchor: Type} (
    m_var: Variant{Anchor} = {}

    has AutoInitialize (
        with {Self: Type}
        function init(self&) {
            m_var = Variant{Anchor}::of(Self);
        }
    )
    function var(self) { return m_var; }
    convert (self) => Class{Anchor}:{
        return var();
    }
)
struct Variant{Anchor: Type} (
    function of(T: Type) => Variant{Anchor}:{}
    function type(self) => Type:{}
)
with {Anchor: Type}
function has{T ?undeduced(Anchor): Type}(var: Variant{Anchor}) => bool:{}
with {Anchor: Type}
function is{T ?undeduced(Anchor): Type}(var: Variant{Anchor}) => bool:{
    return var == Variant{Anchor}::of(T);
}
with {Anchor: Type}
match {T ?Enum{undeduced(Anchor)}: Type} against (var: Variant{Anchor}) => {
    return performMatch{Variant{Anchor}::of(T)}(var);
}
with {Anchor: Type}
match {var: Variant{Anchor}} against (inst: ?Enum{undeduced(Anchor)}) => {
    return performMatch{var}(inst.variant());
}
with {Anchor: Type, T ?undeduced(Anchor): Type}
match {T} against (inst: ?Enum{Anchor}) => {
    return performMatch{Variant{Anchor}::of(T)}(inst.variant());
}

incomplete final struct SliceResult (
    has Enum
    struct Success (has SliceResult, result: ExprResult)
    struct NotFound (has SliceResult)
    struct Error (has SliceResult)
)
function slice() => Union{SliceResult}:{}
function doSlice() => Opt{ExprResult}:{
    return match (slice()) {
        with {s ?SliceResult::Success} s => s.result;
        _ => {};
    };
}
function useSlice() => {
    let slice = doSlice() else return;
}

incomplete final(module) struct Expr (
    has Enum
)
struct BinaryOperatorExpr (
    has Expr
    op: BinaryOperator
    left: id{Expr}
    right: id{Expr}
)
function dispatch(ref{Expr} e) => {
    match (e) {
        with {e ?BinaryOperatorExpr} e => { }

        with {left: id{Expr}, right: id{Expr}}
        BinaryOperatorExpr(BinaryOperator::Add, left, right) => { }
    }
}

incomplete struct View (
    static className: String;

    has Enum{View}
)
struct ImageView (
    has View (
        static className: String = "Image"
    )

)
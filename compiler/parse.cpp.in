    switch (kind) {
#define NODE(kind, type, prec) \
    case NodeKind::kind:       \
        return #kind;

#include "nodes.inc"
    }
}

std::string_view nameString(ScopeKind kind) {
    switch (kind) {
#define SCOPE(kind)       \
    case ScopeKind::kind: \
        return #kind;
        ENUMERATE_SCOPE_KINDS
#undef SCOPE
    }
}


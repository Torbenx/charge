fn make_square(file: int, rank: int) -> int: {
    return (rank << RANK_SHIFT) | (file & FILE_MASK_BITS);
}

fn file_of(square: int) -> int: {
    return square & FILE_MASK_BITS;
}

fn rank_of(square: int) -> int: {
    return (square >> RANK_SHIFT) & FILE_MASK_BITS;
}



fn square_valid(square: int) -> bool: {
    return square >= 0 && square < SQUARE_COUNT;
}



fn step_valid(from: int, to: int, max_file: int) -> bool: {
    if to < 0 || to >= SQUARE_COUNT: {
        return false;
    }
    let df = file_of(to) - file_of(from);
    var spread = df;
    if spread < 0: {
        spread = -spread;
    }
    return spread <= max_file;
}


fn square_distance(a: int, b: int) -> int: {
    var df = file_of(a) - file_of(b);
    var dr = rank_of(a) - rank_of(b);
    if df < 0: {
        df = -df;
    }
    if dr < 0: {
        dr = -dr;
    }
    if df > dr: {
        return df;
    }
    return dr;
}


fn manhattan_distance(a: int, b: int) -> int: {
    var df = file_of(a) - file_of(b);
    var dr = rank_of(a) - rank_of(b);
    if df < 0: {
        df = -df;
    }
    if dr < 0: {
        dr = -dr;
    }
    return df + dr;
}




fn flip_rank(square: int) -> int: {
    return square ^ 56;                   
}


fn flip_file(square: int) -> int: {
    return square ^ 7;                    
}


fn flip_square(square: int) -> int: {
    return square ^ 63;                   
}



fn square_is_dark(square: int) -> bool: {
    return ((file_of(square) + rank_of(square)) & 1) == 0;
}


fn pawn_start_rank(color: Color) -> int: {
    if color == Color::White: {
        return 1;
    }
    return 6;
}

fn pawn_promotion_rank(color: Color) -> int: {
    if color == Color::White: {
        return 7;
    }
    return 0;
}



fn pawn_double_rank(color: Color) -> int: {
    if color == Color::White: {
        return 3;
    }
    return 4;
}


fn pawn_push_delta(color: Color) -> int: {
    if color == Color::White: {
        return DIR_NORTH;
    }
    return DIR_SOUTH;
}



fn relative_rank(color: Color, square: int) -> int: {
    if color == Color::White: {
        return rank_of(square);
    }
    return 7 - rank_of(square);
}

fn relative_square(color: Color, square: int) -> int: {
    if color == Color::White: {
        return square;
    }
    return flip_rank(square);
}



fn color_index(color: Color) -> int: {
    if color == Color::Black: {
        return 1;
    }
    return 0;
}

fn color_from_index(index: int) -> Color: {
    if index == 1: {
        return Color::Black;
    }
    return Color::White;
}

fn opposite_color(color: Color) -> Color: {
    if color == Color::White: {
        return Color::Black;
    }
    return Color::White;
}

fn kind_index(kind: PieceKind) -> int: {
    if kind == PieceKind::Pawn: {
        return 0;
    } else: { if kind == PieceKind::Knight: {
        return 1;
    } else: { if kind == PieceKind::Bishop: {
        return 2;
    } else: { if kind == PieceKind::Rook: {
        return 3;
    } else: { if kind == PieceKind::Queen: {
        return 4;
    } else: { if kind == PieceKind::King: {
        return 5;
    } else: {
        return 6;
    } } } } } }
}

fn kind_from_index(index: int) -> PieceKind: {
    if index == 0: {
        return PieceKind::Pawn;
    } else: { if index == 1: {
        return PieceKind::Knight;
    } else: { if index == 2: {
        return PieceKind::Bishop;
    } else: { if index == 3: {
        return PieceKind::Rook;
    } else: { if index == 4: {
        return PieceKind::Queen;
    } else: { if index == 5: {
        return PieceKind::King;
    } else: {
        return PieceKind::KindNone;
    } } } } } }
}


fn make_piece(color: Color, kind: PieceKind) -> int: {
    return color_index(color) * PIECE_KIND_COUNT + kind_index(kind);
}

fn piece_color(piece: int) -> Color: {
    if piece >= PIECE_CODE_COUNT || piece < 0: {
        return Color::ColorNone;
    }
    if piece >= PIECE_KIND_COUNT: {
        return Color::Black;
    }
    return Color::White;
}

fn piece_kind(piece: int) -> PieceKind: {
    if piece >= PIECE_CODE_COUNT || piece < 0: {
        return PieceKind::KindNone;
    }
    return kind_from_index(piece % PIECE_KIND_COUNT);
}

fn piece_is_empty(piece: int) -> bool: {
    return piece >= PIECE_CODE_COUNT || piece < 0;
}


fn kind_is_slider(kind: PieceKind) -> bool: {
    return kind == PieceKind::Bishop || kind == PieceKind::Rook || kind == PieceKind::Queen;
}

fn kind_is_diagonal_slider(kind: PieceKind) -> bool: {
    return kind == PieceKind::Bishop || kind == PieceKind::Queen;
}

fn kind_is_straight_slider(kind: PieceKind) -> bool: {
    return kind == PieceKind::Rook || kind == PieceKind::Queen;
}





static SWAR_K1: int = 6148914691236517205;   
static SWAR_K2: int = 3689348814741910323;   
static SWAR_K4: int = 1085102592571150095;   
static SWAR_KF: int = 72340172838076673;     



static DEBRUIJN64: int = 285870213051353481; 
static DEBRUIJN_SHIFT: int = 58;



static var DEBRUIJN_INDEX: vector{int} = vector{int}(SQUARE_COUNT);


fn square_bit(square: int) -> int: {
    return 1 << square;
}



fn popcount(bb: int) -> int: {
    var x = bb;
    x = x - ((x >> 1) & SWAR_K1);
    x = (x & SWAR_K2) + ((x >> 2) & SWAR_K2);
    x = (x + (x >> 4)) & SWAR_K4;
    x = x * SWAR_KF;
    return (x >> 56) & BYTE_MASK;
}



fn has_single_bit(bb: int) -> bool: {
    return bb != 0 && (bb & (bb - 1)) == 0;
}

fn is_empty_board(bb: int) -> bool: {
    return bb == 0;
}



fn lowest_bit(bb: int) -> int: {
    return bb & -bb;
}


fn clear_lowest_bit(bb: int) -> int: {
    return bb & (bb - 1);
}


fn bit_scan_forward(bb: int) -> int: {
    assert bb != 0;
    let isolated = bb & -bb;
    let folded = (isolated * DEBRUIJN64) >> DEBRUIJN_SHIFT;
    return DEBRUIJN_INDEX.at(folded & SQUARE_MASK);
}


fn bit_scan_forward_slow(bb: int) -> int: {
    var x = bb;
    var index: int = 0;
    while x != 0: {
        if (x & 1) != 0: {
            return index;
        }
        x >>= 1;
        index += 1;
    }
    return NO_SQUARE;
}



fn bit_scan_reverse(bb: int) -> int: {
    assert bb != 0;
    var x = bb;
    x |= x >> 1;
    x |= x >> 2;
    x |= x >> 4;
    x |= x >> 8;
    x |= x >> 16;
    x |= x >> 32;
    return popcount(x) - 1;
}



fn pop_lowest_square(bb: &unique int) -> int: {
    let square = bit_scan_forward(*bb);
    *bb = clear_lowest_bit(*bb);
    return square;
}


fn mirror_board(bb: int) -> int: {
    var x = bb;
    x = ((x >> 1) & SWAR_K1) | ((x & SWAR_K1) << 1);
    x = ((x >> 2) & SWAR_K2) | ((x & SWAR_K2) << 2);
    x = ((x >> 4) & SWAR_K4) | ((x & SWAR_K4) << 4);
    x = ((x >> 8) & 71777214294589695) | ((x & 71777214294589695) << 8);
    x = ((x >> 16) & 281470681808895) | ((x & 281470681808895) << 16);
    x = (x >> 32) | (x << 32);
    return x;
}



fn flip_vertical(bb: int) -> int: {
    var x = bb;
    x = ((x >> 8) & 71777214294589695) | ((x & 71777214294589695) << 8);
    x = ((x >> 16) & 281470681808895) | ((x & 281470681808895) << 16);
    x = (x >> 32) | (x << 32);
    return x;
}




static var SQUARE_BB: vector{int} = vector{int}(SQUARE_COUNT);


static var FILE_MASKS: vector{int} = vector{int}(BOARD_FILES);
static var RANK_MASKS: vector{int} = vector{int}(BOARD_RANKS);



static var ADJACENT_FILES: vector{int} = vector{int}(BOARD_FILES);



static var NOT_FILE_A: int = 0;
static var NOT_FILE_H: int = 0;
static var NOT_FILE_AB: int = 0;
static var NOT_FILE_GH: int = 0;


static var BOARD_EDGES: int = 0;
static var BOARD_CENTER: int = 0;
static var LIGHT_SQUARES: int = 0;
static var DARK_SQUARES: int = 0;



static var DISTANCE_TABLE: vector{vector{int}} = vector{vector{int}}(SQUARE_COUNT);



fn init_square_masks(): {
    var square: int = 0;
    while square < SQUARE_COUNT: {
        SQUARE_BB.at(square) = 1 << square;
        square += 1;
    }

    var file: int = 0;
    while file < BOARD_FILES: {
        var mask: int = 0;
        var rank: int = 0;
        while rank < BOARD_RANKS: {
            mask |= 1 << make_square(file, rank);
            rank += 1;
        }
        FILE_MASKS.at(file) = mask;
        file += 1;
    }

    var rank: int = 0;
    while rank < BOARD_RANKS: {
        var mask: int = 0;
        var f: int = 0;
        while f < BOARD_FILES: {
            mask |= 1 << make_square(f, rank);
            f += 1;
        }
        RANK_MASKS.at(rank) = mask;
        rank += 1;
    }

    var af: int = 0;
    while af < BOARD_FILES: {
        var mask: int = 0;
        if af > 0: {
            mask |= FILE_MASKS.at(af - 1);
        }
        if af < BOARD_FILES - 1: {
            mask |= FILE_MASKS.at(af + 1);
        }
        ADJACENT_FILES.at(af) = mask;
        af += 1;
    }

    NOT_FILE_A = FULL_BOARD ^ FILE_MASKS.at(0);
    NOT_FILE_H = FULL_BOARD ^ FILE_MASKS.at(7);
    NOT_FILE_AB = FULL_BOARD ^ (FILE_MASKS.at(0) | FILE_MASKS.at(1));
    NOT_FILE_GH = FULL_BOARD ^ (FILE_MASKS.at(6) | FILE_MASKS.at(7));

    BOARD_EDGES = FILE_MASKS.at(0) | FILE_MASKS.at(7) | RANK_MASKS.at(0) | RANK_MASKS.at(7);
    BOARD_CENTER = (FILE_MASKS.at(2) | FILE_MASKS.at(3) | FILE_MASKS.at(4) | FILE_MASKS.at(5))
        & (RANK_MASKS.at(2) | RANK_MASKS.at(3) | RANK_MASKS.at(4) | RANK_MASKS.at(5));

    var light: int = 0;
    var dark: int = 0;
    var s: int = 0;
    while s < SQUARE_COUNT: {
        if square_is_dark(s): {
            dark |= 1 << s;
        } else: {
            light |= 1 << s;
        }
        s += 1;
    }
    LIGHT_SQUARES = light;
    DARK_SQUARES = dark;
}



fn init_debruijn_table(): {
    var square: int = 0;
    while square < SQUARE_COUNT: {
        let isolated = 1 << square;
        let folded = (isolated * DEBRUIJN64) >> DEBRUIJN_SHIFT;
        DEBRUIJN_INDEX.at(folded & SQUARE_MASK) = square;
        square += 1;
    }
}


fn init_distance_table(): {
    var from: int = 0;
    while from < SQUARE_COUNT: {
        DISTANCE_TABLE.at(from) = vector{int}(SQUARE_COUNT);
        var to: int = 0;
        while to < SQUARE_COUNT: {
            DISTANCE_TABLE.at(from).at(to) = square_distance(from, to);
            to += 1;
        }
        from += 1;
    }
}




fn shift_north(bb: int) -> int: {
    return bb << 8;
}

fn shift_south(bb: int) -> int: {
    return (bb >> 8) & 72057594037927935;   
}

fn shift_east(bb: int) -> int: {
    return (bb & NOT_FILE_H) << 1;
}

fn shift_west(bb: int) -> int: {
    return (bb & NOT_FILE_A) >> 1;
}

fn shift_north_east(bb: int) -> int: {
    return (bb & NOT_FILE_H) << 9;
}

fn shift_north_west(bb: int) -> int: {
    return (bb & NOT_FILE_A) << 7;
}

fn shift_south_east(bb: int) -> int: {
    return ((bb & NOT_FILE_H) >> 7) & 72057594037927935;
}

fn shift_south_west(bb: int) -> int: {
    return ((bb & NOT_FILE_A) >> 9) & 72057594037927935;
}


fn shift_by_ray(bb: int, ray: int) -> int: {
    if ray == RAY_NORTH: {
        return shift_north(bb);
    } else: { if ray == RAY_NORTH_EAST: {
        return shift_north_east(bb);
    } else: { if ray == RAY_EAST: {
        return shift_east(bb);
    } else: { if ray == RAY_SOUTH_EAST: {
        return shift_south_east(bb);
    } else: { if ray == RAY_SOUTH: {
        return shift_south(bb);
    } else: { if ray == RAY_SOUTH_WEST: {
        return shift_south_west(bb);
    } else: { if ray == RAY_WEST: {
        return shift_west(bb);
    } else: {
        return shift_north_west(bb);
    } } } } } } }
}


fn fill_north(bb: int) -> int: {
    var x = bb;
    x |= x << 8;
    x |= x << 16;
    x |= x << 32;
    return x;
}

fn fill_south(bb: int) -> int: {
    var x = bb;
    x |= (x >> 8) & 72057594037927935;
    x |= (x >> 16) & 281474976710655;       
    x |= (x >> 32) & 4294967295;            
    return x;
}


fn file_fill(bb: int) -> int: {
    return fill_north(bb) | fill_south(bb);
}


fn front_span(color: Color, bb: int) -> int: {
    if color == Color::White: {
        return fill_north(shift_north(bb));
    }
    return fill_south(shift_south(bb));
}







struct Bitboard: {

    fn raw(self: &const shared) -> int: {
        return .bits;
    }

    fn empty(self: &const shared) -> bool: {
        return .bits == 0;
    }

    fn any(self: &const shared) -> bool: {
        return .bits != 0;
    }

    fn count(self: &const shared) -> int: {
        return popcount(.bits);
    }

    fn single(self: &const shared) -> bool: {
        return has_single_bit(.bits);
    }

    fn test(self: &const shared, square: int) -> bool: {
        return (.bits & (1 << square)) != 0;
    }

    fn set(self: &unique, square: int): {
        .bits |= 1 << square;
    }

    fn clear(self: &unique, square: int): {
        .bits &= FULL_BOARD ^ (1 << square);
    }

    fn toggle(self: &unique, square: int): {
        .bits ^= 1 << square;
    }

    
    
    fn move_bit(self: &unique, from: int, to: int): {
        .bits ^= (1 << from) | (1 << to);
    }

    fn lowest(self: &const shared) -> int: {
        if .bits == 0: {
            return NO_SQUARE;
        }
        return bit_scan_forward(.bits);
    }

    fn highest(self: &const shared) -> int: {
        if .bits == 0: {
            return NO_SQUARE;
        }
        return bit_scan_reverse(.bits);
    }

    fn pop_lowest(self: &unique) -> int: {
        if .bits == 0: {
            return NO_SQUARE;
        }
        let square = bit_scan_forward(.bits);
        .bits &= .bits - 1;
        return square;
    }

    fn union_with(self: &const shared, other: &const shared Bitboard) -> Bitboard: {
        return Bitboard(bits: .bits | other.bits);
    }

    fn intersect(self: &const shared, other: &const shared Bitboard) -> Bitboard: {
        return Bitboard(bits: .bits & other.bits);
    }

    fn difference(self: &const shared, other: &const shared Bitboard) -> Bitboard: {
        return Bitboard(bits: .bits & (FULL_BOARD ^ other.bits));
    }

    fn complement(self: &const shared) -> Bitboard: {
        return Bitboard(bits: FULL_BOARD ^ .bits);
    }

    fn overlaps(self: &const shared, other: &const shared Bitboard) -> bool: {
        return (.bits & other.bits) != 0;
    }

    fn mirrored(self: &const shared) -> Bitboard: {
        return Bitboard(bits: mirror_board(.bits));
    }

    fn flipped(self: &const shared) -> Bitboard: {
        return Bitboard(bits: flip_vertical(.bits));
    }

    
    
    fn to_text(self: &const shared) -> string: {
        var out: string;
        var rank: int = BOARD_RANKS - 1;
        while rank >= 0: {
            var file: int = 0;
            while file < BOARD_FILES: {
                if .test(make_square(file, rank)): {
                    out.push_back('1');
                } else: {
                    out.push_back('.');
                }
                file += 1;
            }
            out.push_back('\n');
            rank -= 1;
        }
        return out;
    }

    bits: int = 0;
}

fn board_of_square(square: int) -> Bitboard: {
    return Bitboard(bits: 1 << square);
}

fn board_of_file(file: int) -> Bitboard: {
    return Bitboard(bits: FILE_MASKS.at(file));
}

fn board_of_rank(rank: int) -> Bitboard: {
    return Bitboard(bits: RANK_MASKS.at(rank));
}

fn impl (a | b)(left: &const shared Bitboard, right: &const shared Bitboard) -> Bitboard: {
    return Bitboard(bits: left.bits | right.bits);
}

fn impl (a & b)(left: &const shared Bitboard, right: &const shared Bitboard) -> Bitboard: {
    return Bitboard(bits: left.bits & right.bits);
}

fn impl (a ^ b)(left: &const shared Bitboard, right: &const shared Bitboard) -> Bitboard: {
    return Bitboard(bits: left.bits ^ right.bits);
}

fn impl (a == b)(left: &const shared Bitboard, right: &const shared Bitboard) -> bool: {
    return left.bits == right.bits;
}




static var KNIGHT_ATTACKS: vector{int} = vector{int}(SQUARE_COUNT);
static var KING_ATTACKS: vector{int} = vector{int}(SQUARE_COUNT);



static var PAWN_ATTACKS: vector{vector{int}} = vector{vector{int}}(COLOR_COUNT);
static var PAWN_PUSHES: vector{vector{int}} = vector{vector{int}}(COLOR_COUNT);



static var RAY_ATTACKS: vector{vector{int}} = vector{vector{int}}(RAY_COUNT);


static var BISHOP_PSEUDO: vector{int} = vector{int}(SQUARE_COUNT);
static var ROOK_PSEUDO: vector{int} = vector{int}(SQUARE_COUNT);
static var QUEEN_PSEUDO: vector{int} = vector{int}(SQUARE_COUNT);



static var BISHOP_RELEVANT: vector{int} = vector{int}(SQUARE_COUNT);
static var ROOK_RELEVANT: vector{int} = vector{int}(SQUARE_COUNT);




static var BETWEEN: vector{vector{int}} = vector{vector{int}}(SQUARE_COUNT);
static var LINE_THROUGH: vector{vector{int}} = vector{vector{int}}(SQUARE_COUNT);



static var KNIGHT_FILE_DELTA: vector{int} = vector{int}(8);
static var KNIGHT_RANK_DELTA: vector{int} = vector{int}(8);
static var KING_FILE_DELTA: vector{int} = vector{int}(8);
static var KING_RANK_DELTA: vector{int} = vector{int}(8);
static var RAY_FILE_DELTA: vector{int} = vector{int}(RAY_COUNT);
static var RAY_RANK_DELTA: vector{int} = vector{int}(RAY_COUNT);


fn init_offset_tables(): {
    KNIGHT_FILE_DELTA.at(0) = 1;
    KNIGHT_RANK_DELTA.at(0) = 2;
    KNIGHT_FILE_DELTA.at(1) = 2;
    KNIGHT_RANK_DELTA.at(1) = 1;
    KNIGHT_FILE_DELTA.at(2) = 2;
    KNIGHT_RANK_DELTA.at(2) = -1;
    KNIGHT_FILE_DELTA.at(3) = 1;
    KNIGHT_RANK_DELTA.at(3) = -2;
    KNIGHT_FILE_DELTA.at(4) = -1;
    KNIGHT_RANK_DELTA.at(4) = -2;
    KNIGHT_FILE_DELTA.at(5) = -2;
    KNIGHT_RANK_DELTA.at(5) = -1;
    KNIGHT_FILE_DELTA.at(6) = -2;
    KNIGHT_RANK_DELTA.at(6) = 1;
    KNIGHT_FILE_DELTA.at(7) = -1;
    KNIGHT_RANK_DELTA.at(7) = 2;

    
    KING_FILE_DELTA.at(0) = 0;
    KING_RANK_DELTA.at(0) = 1;
    KING_FILE_DELTA.at(1) = 1;
    KING_RANK_DELTA.at(1) = 1;
    KING_FILE_DELTA.at(2) = 1;
    KING_RANK_DELTA.at(2) = 0;
    KING_FILE_DELTA.at(3) = 1;
    KING_RANK_DELTA.at(3) = -1;
    KING_FILE_DELTA.at(4) = 0;
    KING_RANK_DELTA.at(4) = -1;
    KING_FILE_DELTA.at(5) = -1;
    KING_RANK_DELTA.at(5) = -1;
    KING_FILE_DELTA.at(6) = -1;
    KING_RANK_DELTA.at(6) = 0;
    KING_FILE_DELTA.at(7) = -1;
    KING_RANK_DELTA.at(7) = 1;

    
    RAY_FILE_DELTA.at(RAY_NORTH) = 0;
    RAY_RANK_DELTA.at(RAY_NORTH) = 1;
    RAY_FILE_DELTA.at(RAY_NORTH_EAST) = 1;
    RAY_RANK_DELTA.at(RAY_NORTH_EAST) = 1;
    RAY_FILE_DELTA.at(RAY_EAST) = 1;
    RAY_RANK_DELTA.at(RAY_EAST) = 0;
    RAY_FILE_DELTA.at(RAY_SOUTH_EAST) = 1;
    RAY_RANK_DELTA.at(RAY_SOUTH_EAST) = -1;
    RAY_FILE_DELTA.at(RAY_SOUTH) = 0;
    RAY_RANK_DELTA.at(RAY_SOUTH) = -1;
    RAY_FILE_DELTA.at(RAY_SOUTH_WEST) = -1;
    RAY_RANK_DELTA.at(RAY_SOUTH_WEST) = -1;
    RAY_FILE_DELTA.at(RAY_WEST) = -1;
    RAY_RANK_DELTA.at(RAY_WEST) = 0;
    RAY_FILE_DELTA.at(RAY_NORTH_WEST) = -1;
    RAY_RANK_DELTA.at(RAY_NORTH_WEST) = 1;
}




fn init_knight_attacks(): {
    var rank: int = 0;
    while rank < BOARD_RANKS: {
        var file: int = 0;
        while file < BOARD_FILES: {
            let from = make_square(file, rank);
            var mask: int = 0;
            var jump: int = 0;
            while jump < 8: {
                let tf = file + KNIGHT_FILE_DELTA.at(jump);
                let tr = rank + KNIGHT_RANK_DELTA.at(jump);
                if tf >= 0 && tf < BOARD_FILES && tr >= 0 && tr < BOARD_RANKS: {
                    mask |= 1 << make_square(tf, tr);
                }
                jump += 1;
            }
            KNIGHT_ATTACKS.at(from) = mask;
            file += 1;
        }
        rank += 1;
    }
}


fn init_king_attacks(): {
    var rank: int = 0;
    while rank < BOARD_RANKS: {
        var file: int = 0;
        while file < BOARD_FILES: {
            let from = make_square(file, rank);
            var mask: int = 0;
            var step: int = 0;
            while step < 8: {
                let tf = file + KING_FILE_DELTA.at(step);
                let tr = rank + KING_RANK_DELTA.at(step);
                if tf >= 0 && tf < BOARD_FILES && tr >= 0 && tr < BOARD_RANKS: {
                    mask |= 1 << make_square(tf, tr);
                }
                step += 1;
            }
            KING_ATTACKS.at(from) = mask;
            file += 1;
        }
        rank += 1;
    }
}



fn init_pawn_attacks(): {
    var color: int = 0;
    while color < COLOR_COUNT: {
        PAWN_ATTACKS.at(color) = vector{int}(SQUARE_COUNT);
        PAWN_PUSHES.at(color) = vector{int}(SQUARE_COUNT);
        var forward: int = 1;
        if color == 1: {
            forward = -1;
        }
        var rank: int = 0;
        while rank < BOARD_RANKS: {
            var file: int = 0;
            while file < BOARD_FILES: {
                let from = make_square(file, rank);
                let tr = rank + forward;
                var attacks: int = 0;
                var pushes: int = 0;
                if tr >= 0 && tr < BOARD_RANKS: {
                    pushes |= 1 << make_square(file, tr);
                    if file > 0: {
                        attacks |= 1 << make_square(file - 1, tr);
                    }
                    if file < BOARD_FILES - 1: {
                        attacks |= 1 << make_square(file + 1, tr);
                    }
                }
                PAWN_ATTACKS.at(color).at(from) = attacks;
                PAWN_PUSHES.at(color).at(from) = pushes;
                file += 1;
            }
            rank += 1;
        }
        color += 1;
    }
}



fn init_ray_attacks(): {
    var ray: int = 0;
    while ray < RAY_COUNT: {
        RAY_ATTACKS.at(ray) = vector{int}(SQUARE_COUNT);
        let df = RAY_FILE_DELTA.at(ray);
        let dr = RAY_RANK_DELTA.at(ray);
        var rank: int = 0;
        while rank < BOARD_RANKS: {
            var file: int = 0;
            while file < BOARD_FILES: {
                let from = make_square(file, rank);
                var mask: int = 0;
                var tf = file + df;
                var tr = rank + dr;
                while tf >= 0 && tf < BOARD_FILES && tr >= 0 && tr < BOARD_RANKS: {
                    mask |= 1 << make_square(tf, tr);
                    tf += df;
                    tr += dr;
                }
                RAY_ATTACKS.at(ray).at(from) = mask;
                file += 1;
            }
            rank += 1;
        }
        ray += 1;
    }
}



fn init_slider_masks(): {
    var square: int = 0;
    while square < SQUARE_COUNT: {
        let file = file_of(square);
        let rank = rank_of(square);

        var bishop: int = 0;
        bishop |= RAY_ATTACKS.at(RAY_NORTH_EAST).at(square);
        bishop |= RAY_ATTACKS.at(RAY_SOUTH_EAST).at(square);
        bishop |= RAY_ATTACKS.at(RAY_SOUTH_WEST).at(square);
        bishop |= RAY_ATTACKS.at(RAY_NORTH_WEST).at(square);
        BISHOP_PSEUDO.at(square) = bishop;

        var rook: int = 0;
        rook |= RAY_ATTACKS.at(RAY_NORTH).at(square);
        rook |= RAY_ATTACKS.at(RAY_EAST).at(square);
        rook |= RAY_ATTACKS.at(RAY_SOUTH).at(square);
        rook |= RAY_ATTACKS.at(RAY_WEST).at(square);
        ROOK_PSEUDO.at(square) = rook;

        QUEEN_PSEUDO.at(square) = bishop | rook;

        
        BISHOP_RELEVANT.at(square) = bishop & (FULL_BOARD ^ BOARD_EDGES);

        
        
        var relevant: int = rook;
        if file != 0: {
            relevant &= FULL_BOARD ^ FILE_MASKS.at(0);
        }
        if file != BOARD_FILES - 1: {
            relevant &= FULL_BOARD ^ FILE_MASKS.at(BOARD_FILES - 1);
        }
        if rank != 0: {
            relevant &= FULL_BOARD ^ RANK_MASKS.at(0);
        }
        if rank != BOARD_RANKS - 1: {
            relevant &= FULL_BOARD ^ RANK_MASKS.at(BOARD_RANKS - 1);
        }
        ROOK_RELEVANT.at(square) = relevant;

        square += 1;
    }
}




fn init_between_tables(): {
    var from: int = 0;
    while from < SQUARE_COUNT: {
        BETWEEN.at(from) = vector{int}(SQUARE_COUNT);
        LINE_THROUGH.at(from) = vector{int}(SQUARE_COUNT);
        var to: int = 0;
        while to < SQUARE_COUNT: {
            BETWEEN.at(from).at(to) = 0;
            LINE_THROUGH.at(from).at(to) = 0;
            to += 1;
        }
        from += 1;
    }

    var origin: int = 0;
    while origin < SQUARE_COUNT: {
        var ray: int = 0;
        while ray < RAY_COUNT: {
            let df = RAY_FILE_DELTA.at(ray);
            let dr = RAY_RANK_DELTA.at(ray);
            var segment: int = 0;
            var tf = file_of(origin) + df;
            var tr = rank_of(origin) + dr;
            while tf >= 0 && tf < BOARD_FILES && tr >= 0 && tr < BOARD_RANKS: {
                let target = make_square(tf, tr);
                BETWEEN.at(origin).at(target) = segment;

                
                
                let back = (ray + 4) % RAY_COUNT;
                LINE_THROUGH.at(origin).at(target) = RAY_ATTACKS.at(ray).at(origin)
                    | RAY_ATTACKS.at(back).at(origin)
                    | (1 << origin)
                    | (1 << target);

                segment |= 1 << target;
                tf += df;
                tr += dr;
            }
            ray += 1;
        }
        origin += 1;
    }
}


fn init_tables(): {
    init_square_masks();
    init_debruijn_table();
    init_distance_table();
    init_offset_tables();
    init_knight_attacks();
    init_king_attacks();
    init_pawn_attacks();
    init_ray_attacks();
    init_slider_masks();
    init_between_tables();
}







fn ray_is_positive(ray: int) -> bool: {
    return ray == RAY_NORTH || ray == RAY_NORTH_EAST || ray == RAY_EAST || ray == RAY_NORTH_WEST;
}


fn ray_attacks_from(square: int, ray: int, occupancy: int) -> int: {
    var attacks = RAY_ATTACKS.at(ray).at(square);
    let blockers = attacks & occupancy;
    if blockers == 0: {
        return attacks;
    }
    if ray_is_positive(ray): {
        let first = bit_scan_forward(blockers);
        attacks = attacks & (FULL_BOARD ^ RAY_ATTACKS.at(ray).at(first));
    } else: {
        let first = bit_scan_reverse(blockers);
        attacks = attacks & (FULL_BOARD ^ RAY_ATTACKS.at(ray).at(first));
    }
    return attacks;
}



fn rook_attacks(square: int, occupancy: int) -> int: {
    attack_query_count += 1;
    var attacks: int = 0;
    attacks |= ray_attacks_from(square, RAY_NORTH, occupancy);
    attacks |= ray_attacks_from(square, RAY_EAST, occupancy);
    attacks |= ray_attacks_from(square, RAY_SOUTH, occupancy);
    attacks |= ray_attacks_from(square, RAY_WEST, occupancy);
    return attacks;
}

fn bishop_attacks(square: int, occupancy: int) -> int: {
    attack_query_count += 1;
    var attacks: int = 0;
    attacks |= ray_attacks_from(square, RAY_NORTH_EAST, occupancy);
    attacks |= ray_attacks_from(square, RAY_SOUTH_EAST, occupancy);
    attacks |= ray_attacks_from(square, RAY_SOUTH_WEST, occupancy);
    attacks |= ray_attacks_from(square, RAY_NORTH_WEST, occupancy);
    return attacks;
}

fn queen_attacks(square: int, occupancy: int) -> int: {
    return rook_attacks(square, occupancy) | bishop_attacks(square, occupancy);
}



fn attacks_of_kind(kind: PieceKind, color: Color, square: int, occupancy: int) -> int: {
    if kind == PieceKind::Pawn: {
        return PAWN_ATTACKS.at(color_index(color)).at(square);
    } else: { if kind == PieceKind::Knight: {
        return KNIGHT_ATTACKS.at(square);
    } else: { if kind == PieceKind::Bishop: {
        return bishop_attacks(square, occupancy);
    } else: { if kind == PieceKind::Rook: {
        return rook_attacks(square, occupancy);
    } else: { if kind == PieceKind::Queen: {
        return queen_attacks(square, occupancy);
    } else: { if kind == PieceKind::King: {
        return KING_ATTACKS.at(square);
    } else: {
        return 0;
    } } } } } }
}



fn pawn_attack_span(color: Color, pawns: int) -> int: {
    if color == Color::White: {
        return shift_north_east(pawns) | shift_north_west(pawns);
    }
    return shift_south_east(pawns) | shift_south_west(pawns);
}



fn pawn_double_attacks(color: Color, pawns: int) -> int: {
    if color == Color::White: {
        return shift_north_east(pawns) & shift_north_west(pawns);
    }
    return shift_south_east(pawns) & shift_south_west(pawns);
}


fn pawn_single_pushes(color: Color, pawns: int, empty: int) -> int: {
    if color == Color::White: {
        return shift_north(pawns) & empty;
    }
    return shift_south(pawns) & empty;
}

fn pawn_double_pushes(color: Color, pawns: int, empty: int) -> int: {
    let single = pawn_single_pushes(color, pawns, empty);
    if color == Color::White: {
        return shift_north(single) & empty & RANK_MASKS.at(3);
    }
    return shift_south(single) & empty & RANK_MASKS.at(4);
}











static MOVE_FROM_SHIFT: int = 0;
static MOVE_TO_SHIFT: int = 6;
static MOVE_KIND_SHIFT: int = 12;
static MOVE_KIND_MASK: int = 15;          
static MOVE_NULL: int = 0;



static KIND_CAPTURE_BIT: int = 4;         
static KIND_PROMOTION_BIT: int = 8;       

fn encode_move(from: int, to: int, kind: int) -> int: {
    return ((from & SQUARE_MASK) << MOVE_FROM_SHIFT)
        | ((to & SQUARE_MASK) << MOVE_TO_SHIFT)
        | ((kind & MOVE_KIND_MASK) << MOVE_KIND_SHIFT);
}

fn move_from(m: int) -> int: {
    return (m >> MOVE_FROM_SHIFT) & SQUARE_MASK;
}

fn move_to(m: int) -> int: {
    return (m >> MOVE_TO_SHIFT) & SQUARE_MASK;
}

fn move_kind(m: int) -> int: {
    return (m >> MOVE_KIND_SHIFT) & MOVE_KIND_MASK;
}

fn move_is_null(m: int) -> bool: {
    return m == MOVE_NULL;
}

fn move_is_capture(m: int) -> bool: {
    return (move_kind(m) & KIND_CAPTURE_BIT) != 0;
}

fn move_is_promotion(m: int) -> bool: {
    return (move_kind(m) & KIND_PROMOTION_BIT) != 0;
}

fn move_is_en_passant(m: int) -> bool: {
    return move_kind(m) == 5;
}

fn move_is_double_push(m: int) -> bool: {
    return move_kind(m) == 1;
}

fn move_is_castle(m: int) -> bool: {
    let kind = move_kind(m);
    return kind == 2 || kind == 3;
}

fn move_is_king_castle(m: int) -> bool: {
    return move_kind(m) == 2;
}

fn move_is_quiet(m: int) -> bool: {
    let kind = move_kind(m);
    return (kind & KIND_CAPTURE_BIT) == 0 && (kind & KIND_PROMOTION_BIT) == 0;
}




fn move_promotion_kind(m: int) -> PieceKind: {
    if move_is_promotion(m) == false: {
        return PieceKind::KindNone;
    }
    let selector = move_kind(m) & 3;
    return kind_from_index(selector + 1);
}


fn promotion_move_kind(selector: int, capture: bool) -> int: {
    var kind = KIND_PROMOTION_BIT | (selector & 3);
    if capture: {
        kind |= KIND_CAPTURE_BIT;
    }
    return kind;
}


struct ScoredMove: {

    fn from_square(self: &const shared) -> int: {
        return move_from(.packed);
    }

    fn to_square(self: &const shared) -> int: {
        return move_to(.packed);
    }

    fn kind(self: &const shared) -> int: {
        return move_kind(.packed);
    }

    fn is_capture(self: &const shared) -> bool: {
        return move_is_capture(.packed);
    }

    packed: int = 0;
    score: int = 0;
}




struct MoveList: {

    fn size(self: &const shared) -> int: {
        return .count;
    }

    fn empty(self: &const shared) -> bool: {
        return .count == 0;
    }

    fn clear(self: &unique): {
        .count = 0;
        .moves.clear();
    }

    fn add(self: &unique, m: int): {
        assert .count < MAX_MOVES;
        .moves.push_back(ScoredMove(packed: m, score: 0));
        .count += 1;
        generated_move_count += 1;
    }

    fn add_scored(self: &unique, m: int, score: int): {
        assert .count < MAX_MOVES;
        .moves.push_back(ScoredMove(packed: m, score: score));
        .count += 1;
        generated_move_count += 1;
    }

    fn at(self: &shared, index: int) -> &shared[self] ScoredMove: {
        assert index >= 0;
        assert index < .count;
        return .moves.at(index);
    }

    fn packed_at(self: &const shared, index: int) -> int: {
        return .moves.at(index).packed;
    }

    fn contains(self: &const shared, m: int) -> bool: {
        var i: int = 0;
        while i < .count: {
            if .moves.at(i).packed == m: {
                return true;
            }
            i += 1;
        }
        return false;
    }

    
    
    fn select_best(self: &unique, start: int) -> int: {
        var best = start;
        var i = start + 1;
        while i < .count: {
            if .moves.at(i).score > .moves.at(best).score: {
                best = i;
            }
            i += 1;
        }
        if best != start: {
            swap(.moves.at(start), .moves.at(best));
        }
        return .moves.at(start).score;
    }

    
    
    fn compact(self: &unique, keep: &const shared vector{bool}): {
        var write: int = 0;
        var read: int = 0;
        while read < .count: {
            if keep.at(read): {
                .moves.at(write) = .moves.at(read);
                write += 1;
            }
            read += 1;
        }
        .count = write;
    }

    moves: vector{ScoredMove};
    count: int = 0;
}






struct Undo: {
    move_packed: int = 0;
    captured: int = 12;
    castling: int = 0;
    ep_square: int = -1;
    halfmove: int = 0;
    key: int = 0;
}




static var CASTLE_MASK: vector{int} = vector{int}(SQUARE_COUNT);

fn init_castle_masks(): {
    var square: int = 0;
    while square < SQUARE_COUNT: {
        CASTLE_MASK.at(square) = CASTLE_ALL;
        square += 1;
    }
    CASTLE_MASK.at(SQ_A1) = CASTLE_ALL ^ CASTLE_WHITE_QUEEN;
    CASTLE_MASK.at(SQ_H1) = CASTLE_ALL ^ CASTLE_WHITE_KING;
    CASTLE_MASK.at(SQ_E1) = CASTLE_ALL ^ CASTLE_WHITE_ANY;
    CASTLE_MASK.at(SQ_A8) = CASTLE_ALL ^ CASTLE_BLACK_QUEEN;
    CASTLE_MASK.at(SQ_H8) = CASTLE_ALL ^ CASTLE_BLACK_KING;
    CASTLE_MASK.at(SQ_E8) = CASTLE_ALL ^ CASTLE_BLACK_ANY;
}



static var CASTLE_EMPTY_MASK: vector{int} = vector{int}(4);
static var CASTLE_SAFE_MASK: vector{int} = vector{int}(4);
static var CASTLE_KING_FROM: vector{int} = vector{int}(4);
static var CASTLE_KING_TO: vector{int} = vector{int}(4);
static var CASTLE_ROOK_FROM: vector{int} = vector{int}(4);
static var CASTLE_ROOK_TO: vector{int} = vector{int}(4);

fn init_castle_paths(): {
    
    CASTLE_EMPTY_MASK.at(0) = (1 << SQ_F1) | (1 << SQ_G1);
    CASTLE_SAFE_MASK.at(0) = (1 << SQ_E1) | (1 << SQ_F1) | (1 << SQ_G1);
    CASTLE_KING_FROM.at(0) = SQ_E1;
    CASTLE_KING_TO.at(0) = SQ_G1;
    CASTLE_ROOK_FROM.at(0) = SQ_H1;
    CASTLE_ROOK_TO.at(0) = SQ_F1;

    
    
    CASTLE_EMPTY_MASK.at(1) = (1 << SQ_B1) | (1 << SQ_C1) | (1 << SQ_D1);
    CASTLE_SAFE_MASK.at(1) = (1 << SQ_E1) | (1 << SQ_D1) | (1 << SQ_C1);
    CASTLE_KING_FROM.at(1) = SQ_E1;
    CASTLE_KING_TO.at(1) = SQ_C1;
    CASTLE_ROOK_FROM.at(1) = SQ_A1;
    CASTLE_ROOK_TO.at(1) = SQ_D1;

    
    CASTLE_EMPTY_MASK.at(2) = (1 << SQ_F8) | (1 << SQ_G8);
    CASTLE_SAFE_MASK.at(2) = (1 << SQ_E8) | (1 << SQ_F8) | (1 << SQ_G8);
    CASTLE_KING_FROM.at(2) = SQ_E8;
    CASTLE_KING_TO.at(2) = SQ_G8;
    CASTLE_ROOK_FROM.at(2) = SQ_H8;
    CASTLE_ROOK_TO.at(2) = SQ_F8;

    
    CASTLE_EMPTY_MASK.at(3) = (1 << SQ_B8) | (1 << SQ_C8) | (1 << SQ_D8);
    CASTLE_SAFE_MASK.at(3) = (1 << SQ_E8) | (1 << SQ_D8) | (1 << SQ_C8);
    CASTLE_KING_FROM.at(3) = SQ_E8;
    CASTLE_KING_TO.at(3) = SQ_C8;
    CASTLE_ROOK_FROM.at(3) = SQ_A8;
    CASTLE_ROOK_TO.at(3) = SQ_D8;
}





static ZOBRIST_SEED: int = 1070372;
static XORSHIFT_MULTIPLIER: int = 2685821657736338717;

static var ZOBRIST_PIECES: vector{vector{int}} = vector{vector{int}}(PIECE_CODE_COUNT);
static var ZOBRIST_CASTLING: vector{int} = vector{int}(16);
static var ZOBRIST_EP_FILE: vector{int} = vector{int}(BOARD_FILES);
static var ZOBRIST_SIDE: int = 0;
static var zobrist_state: int = 0;


fn next_random() -> int: {
    var x = zobrist_state;
    x ^= x >> 12;
    x ^= x << 25;
    x ^= x >> 27;
    zobrist_state = x;
    return x * XORSHIFT_MULTIPLIER;
}

fn init_zobrist(): {
    zobrist_state = ZOBRIST_SEED;
    var piece: int = 0;
    while piece < PIECE_CODE_COUNT: {
        ZOBRIST_PIECES.at(piece) = vector{int}(SQUARE_COUNT);
        var square: int = 0;
        while square < SQUARE_COUNT: {
            ZOBRIST_PIECES.at(piece).at(square) = next_random();
            square += 1;
        }
        piece += 1;
    }
    var rights: int = 0;
    while rights < 16: {
        ZOBRIST_CASTLING.at(rights) = next_random();
        rights += 1;
    }
    var file: int = 0;
    while file < BOARD_FILES: {
        ZOBRIST_EP_FILE.at(file) = next_random();
        file += 1;
    }
    ZOBRIST_SIDE = next_random();
}






struct Position: {

    

    fn piece_at(self: &const shared, square: int) -> int: {
        assert square >= 0;
        assert square < SQUARE_COUNT;
        return .squares.at(square);
    }

    fn is_empty_square(self: &const shared, square: int) -> bool: {
        return .squares.at(square) >= PIECE_CODE_COUNT;
    }

    fn side_to_move(self: &const shared) -> Color: {
        return .side;
    }

    fn opponent(self: &const shared) -> Color: {
        return opposite_color(.side);
    }

    fn occupied(self: &const shared) -> int: {
        return .occupancy;
    }

    fn empty_squares(self: &const shared) -> int: {
        return FULL_BOARD ^ .occupancy;
    }

    fn pieces_of_color(self: &const shared, color: Color) -> int: {
        return .by_color.at(color_index(color));
    }

    fn pieces_of_kind(self: &const shared, kind: PieceKind) -> int: {
        return .by_kind.at(kind_index(kind));
    }

    
    fn pieces(self: &const shared, color: Color, kind: PieceKind) -> int: {
        return .by_color.at(color_index(color)) & .by_kind.at(kind_index(kind));
    }

    fn diagonal_sliders(self: &const shared, color: Color) -> int: {
        return .by_color.at(color_index(color))
            & (.by_kind.at(kind_index(PieceKind::Bishop)) | .by_kind.at(kind_index(PieceKind::Queen)));
    }

    fn straight_sliders(self: &const shared, color: Color) -> int: {
        return .by_color.at(color_index(color))
            & (.by_kind.at(kind_index(PieceKind::Rook)) | .by_kind.at(kind_index(PieceKind::Queen)));
    }

    fn king_square(self: &const shared, color: Color) -> int: {
        return .kings.at(color_index(color));
    }

    fn castling_rights(self: &const shared) -> int: {
        return .castling;
    }

    fn has_castling_right(self: &const shared, right: int) -> bool: {
        return (.castling & right) != 0;
    }

    fn en_passant_square(self: &const shared) -> int: {
        return .ep_square;
    }

    fn halfmove_clock(self: &const shared) -> int: {
        return .halfmove;
    }

    fn fullmove_number(self: &const shared) -> int: {
        return .fullmove;
    }

    fn hash_key(self: &const shared) -> int: {
        return .key;
    }

    fn piece_count(self: &const shared, color: Color, kind: PieceKind) -> int: {
        return popcount(.pieces(color, kind));
    }

    fn total_piece_count(self: &const shared) -> int: {
        return popcount(.occupancy);
    }

    

    
    fn reset(self: &unique): {
        .squares = vector{int}(SQUARE_COUNT);
        var square: int = 0;
        while square < SQUARE_COUNT: {
            .squares.at(square) = PIECE_CODE_COUNT;
            square += 1;
        }
        .by_color = vector{int}(COLOR_COUNT);
        .by_color.at(0) = 0;
        .by_color.at(1) = 0;
        .by_kind = vector{int}(PIECE_KIND_COUNT);
        var kind: int = 0;
        while kind < PIECE_KIND_COUNT: {
            .by_kind.at(kind) = 0;
            kind += 1;
        }
        .kings = vector{int}(COLOR_COUNT);
        .kings.at(0) = NO_SQUARE;
        .kings.at(1) = NO_SQUARE;
        .occupancy = 0;
        .side = Color::White;
        .castling = CASTLE_NONE;
        .ep_square = NO_SQUARE;
        .halfmove = 0;
        .fullmove = 1;
        .key = 0;
        .ply = 0;
    }

    
    fn put_piece(self: &unique, piece: int, square: int): {
        assert .is_empty_square(square);
        let color = color_index(piece_color(piece));
        let kind = kind_index(piece_kind(piece));
        let bit = 1 << square;
        .squares.at(square) = piece;
        .by_color.at(color) |= bit;
        .by_kind.at(kind) |= bit;
        .occupancy |= bit;
        .key ^= ZOBRIST_PIECES.at(piece).at(square);
        if kind == kind_index(PieceKind::King): {
            .kings.at(color) = square;
        }
    }

    
    fn remove_piece(self: &unique, square: int): {
        let piece = .squares.at(square);
        assert piece < PIECE_CODE_COUNT;
        let color = color_index(piece_color(piece));
        let kind = kind_index(piece_kind(piece));
        let clear = FULL_BOARD ^ (1 << square);
        .squares.at(square) = PIECE_CODE_COUNT;
        .by_color.at(color) &= clear;
        .by_kind.at(kind) &= clear;
        .occupancy &= clear;
        .key ^= ZOBRIST_PIECES.at(piece).at(square);
        if kind == kind_index(PieceKind::King): {
            .kings.at(color) = NO_SQUARE;
        }
    }

    
    
    fn move_piece(self: &unique, from: int, to: int): {
        let piece = .squares.at(from);
        assert piece < PIECE_CODE_COUNT;
        let color = color_index(piece_color(piece));
        let kind = kind_index(piece_kind(piece));
        let delta = (1 << from) | (1 << to);
        .squares.at(from) = PIECE_CODE_COUNT;
        .squares.at(to) = piece;
        .by_color.at(color) ^= delta;
        .by_kind.at(kind) ^= delta;
        .occupancy ^= delta;
        .key ^= ZOBRIST_PIECES.at(piece).at(from);
        .key ^= ZOBRIST_PIECES.at(piece).at(to);
        if kind == kind_index(PieceKind::King): {
            .kings.at(color) = to;
        }
    }

    
    
    fn compute_key(self: &const shared) -> int: {
        var key: int = 0;
        var square: int = 0;
        while square < SQUARE_COUNT: {
            let piece = .squares.at(square);
            if piece < PIECE_CODE_COUNT: {
                key ^= ZOBRIST_PIECES.at(piece).at(square);
            }
            square += 1;
        }
        key ^= ZOBRIST_CASTLING.at(.castling & CASTLE_ALL);
        if .ep_square != NO_SQUARE: {
            key ^= ZOBRIST_EP_FILE.at(file_of(.ep_square));
        }
        if .side == Color::Black: {
            key ^= ZOBRIST_SIDE;
        }
        return key;
    }

    

    
    
    
    
    fn attackers_to(self: &const shared, square: int, occupancy: int) -> int: {
        var attackers: int = 0;
        attackers |= PAWN_ATTACKS.at(0).at(square) & .pieces(Color::Black, PieceKind::Pawn);
        attackers |= PAWN_ATTACKS.at(1).at(square) & .pieces(Color::White, PieceKind::Pawn);
        attackers |= KNIGHT_ATTACKS.at(square) & .by_kind.at(kind_index(PieceKind::Knight));
        attackers |= KING_ATTACKS.at(square) & .by_kind.at(kind_index(PieceKind::King));
        attackers |= bishop_attacks(square, occupancy)
            & (.by_kind.at(kind_index(PieceKind::Bishop)) | .by_kind.at(kind_index(PieceKind::Queen)));
        attackers |= rook_attacks(square, occupancy)
            & (.by_kind.at(kind_index(PieceKind::Rook)) | .by_kind.at(kind_index(PieceKind::Queen)));
        return attackers;
    }

    
    fn attackers_of_color(self: &const shared, square: int, color: Color, occupancy: int) -> int: {
        return .attackers_to(square, occupancy) & .by_color.at(color_index(color));
    }

    
    
    
    fn is_attacked(self: &const shared, square: int, color: Color) -> bool: {
        attack_query_count += 1;
        let them = color_index(color);
        let us = 1 - them;
        if (PAWN_ATTACKS.at(us).at(square) & .pieces(color, PieceKind::Pawn)) != 0: {
            return true;
        }
        if (KNIGHT_ATTACKS.at(square) & .pieces(color, PieceKind::Knight)) != 0: {
            return true;
        }
        if (KING_ATTACKS.at(square) & .pieces(color, PieceKind::King)) != 0: {
            return true;
        }
        let diagonal = .diagonal_sliders(color);
        if diagonal != 0: {
            if (bishop_attacks(square, .occupancy) & diagonal) != 0: {
                return true;
            }
        }
        let straight = .straight_sliders(color);
        if straight != 0: {
            if (rook_attacks(square, .occupancy) & straight) != 0: {
                return true;
            }
        }
        return false;
    }

    
    
    
    fn is_attacked_with(self: &const shared, square: int, color: Color, occupancy: int) -> bool: {
        let them = color_index(color);
        let us = 1 - them;
        var hits: int = 0;
        hits |= PAWN_ATTACKS.at(us).at(square) & .pieces(color, PieceKind::Pawn);
        hits |= KNIGHT_ATTACKS.at(square) & .pieces(color, PieceKind::Knight);
        hits |= KING_ATTACKS.at(square) & .pieces(color, PieceKind::King);
        hits |= bishop_attacks(square, occupancy) & .diagonal_sliders(color);
        hits |= rook_attacks(square, occupancy) & .straight_sliders(color);
        return (hits & occupancy) != 0;
    }

    
    
    fn attack_map(self: &const shared, color: Color) -> int: {
        var map: int = 0;
        map |= pawn_attack_span(color, .pieces(color, PieceKind::Pawn));

        var knights = .pieces(color, PieceKind::Knight);
        while knights != 0: {
            let square = bit_scan_forward(knights);
            map |= KNIGHT_ATTACKS.at(square);
            knights = clear_lowest_bit(knights);
        }

        var bishops = .pieces(color, PieceKind::Bishop);
        while bishops != 0: {
            let square = bit_scan_forward(bishops);
            map |= bishop_attacks(square, .occupancy);
            bishops = clear_lowest_bit(bishops);
        }

        var rooks = .pieces(color, PieceKind::Rook);
        while rooks != 0: {
            let square = bit_scan_forward(rooks);
            map |= rook_attacks(square, .occupancy);
            rooks = clear_lowest_bit(rooks);
        }

        var queens = .pieces(color, PieceKind::Queen);
        while queens != 0: {
            let square = bit_scan_forward(queens);
            map |= queen_attacks(square, .occupancy);
            queens = clear_lowest_bit(queens);
        }

        let king = .kings.at(color_index(color));
        if king != NO_SQUARE: {
            map |= KING_ATTACKS.at(king);
        }
        return map;
    }

    

    
    fn checkers_of(self: &const shared, color: Color) -> int: {
        let king = .kings.at(color_index(color));
        if king == NO_SQUARE: {
            return 0;
        }
        return .attackers_to(king, .occupancy) & .by_color.at(color_index(opposite_color(color)));
    }

    fn checkers(self: &const shared) -> int: {
        return .checkers_of(.side);
    }

    fn in_check(self: &const shared) -> bool: {
        let king = .kings.at(color_index(.side));
        if king == NO_SQUARE: {
            return false;
        }
        return .is_attacked(king, opposite_color(.side));
    }

    fn in_double_check(self: &const shared) -> bool: {
        let checking = .checkers();
        return checking != 0 && has_single_bit(checking) == false;
    }

    
    
    
    
    
    fn pinned_pieces(self: &const shared, color: Color) -> int: {
        let king = .kings.at(color_index(color));
        if king == NO_SQUARE: {
            return 0;
        }
        let them = opposite_color(color);
        let ours = .by_color.at(color_index(color));
        var pinned: int = 0;

        var snipers = (BISHOP_PSEUDO.at(king) & .diagonal_sliders(them))
            | (ROOK_PSEUDO.at(king) & .straight_sliders(them));
        while snipers != 0: {
            let sniper = bit_scan_forward(snipers);
            snipers = clear_lowest_bit(snipers);
            let blockers = BETWEEN.at(king).at(sniper) & .occupancy;
            if blockers != 0 && has_single_bit(blockers): {
                pinned |= blockers & ours;
            }
        }
        return pinned;
    }

    
    
    fn pin_line(self: &const shared, color: Color, square: int) -> int: {
        let king = .kings.at(color_index(color));
        if king == NO_SQUARE: {
            return FULL_BOARD;
        }
        return LINE_THROUGH.at(king).at(square);
    }

    
    
    fn discovery_candidates(self: &const shared, color: Color) -> int: {
        let them = opposite_color(color);
        let enemy_king = .kings.at(color_index(them));
        if enemy_king == NO_SQUARE: {
            return 0;
        }
        let ours = .by_color.at(color_index(color));
        var candidates: int = 0;
        var snipers = (BISHOP_PSEUDO.at(enemy_king) & .diagonal_sliders(color))
            | (ROOK_PSEUDO.at(enemy_king) & .straight_sliders(color));
        while snipers != 0: {
            let sniper = bit_scan_forward(snipers);
            snipers = clear_lowest_bit(snipers);
            let between = BETWEEN.at(enemy_king).at(sniper) & .occupancy;
            if between != 0 && has_single_bit(between): {
                candidates |= between & ours;
            }
        }
        return candidates;
    }

    

    
    
    
    
    fn generate_pawn_moves(self: &const shared, list: &unique MoveList, kind: GenKind): {
        let us = .side;
        let them = opposite_color(us);
        let pawns = .pieces(us, PieceKind::Pawn);
        if pawns == 0: {
            return;
        }
        let empty = FULL_BOARD ^ .occupancy;
        let enemies = .by_color.at(color_index(them));
        let promo_rank = pawn_promotion_rank(us);
        let delta = pawn_push_delta(us);

        if kind != GenKind::GenCaptures: {
            var pushes = pawn_single_pushes(us, pawns, empty);
            while pushes != 0: {
                let to = bit_scan_forward(pushes);
                pushes = clear_lowest_bit(pushes);
                let from = to - delta;
                if rank_of(to) == promo_rank: {
                    var selector: int = 0;
                    while selector < 4: {
                        list.add(encode_move(from, to, promotion_move_kind(selector, false)));
                        selector += 1;
                    }
                } else: {
                    list.add(encode_move(from, to, 0));
                }
            }

            var doubles = pawn_double_pushes(us, pawns, empty);
            while doubles != 0: {
                let to = bit_scan_forward(doubles);
                doubles = clear_lowest_bit(doubles);
                list.add(encode_move(to - delta - delta, to, 1));
            }
        }

        if kind == GenKind::GenQuiets: {
            return;
        }

        
        var movers = pawns;
        while movers != 0: {
            let from = bit_scan_forward(movers);
            movers = clear_lowest_bit(movers);
            var targets = PAWN_ATTACKS.at(color_index(us)).at(from) & enemies;
            while targets != 0: {
                let to = bit_scan_forward(targets);
                targets = clear_lowest_bit(targets);
                if rank_of(to) == promo_rank: {
                    var selector: int = 0;
                    while selector < 4: {
                        list.add(encode_move(from, to, promotion_move_kind(selector, true)));
                        selector += 1;
                    }
                } else: {
                    list.add(encode_move(from, to, 4));
                }
            }
        }

        
        
        if .ep_square != NO_SQUARE: {
            var takers = PAWN_ATTACKS.at(color_index(them)).at(.ep_square) & pawns;
            while takers != 0: {
                let from = bit_scan_forward(takers);
                takers = clear_lowest_bit(takers);
                list.add(encode_move(from, .ep_square, 5));
            }
        }
    }

    
    
    fn generate_knight_moves(self: &const shared, list: &unique MoveList, mask: int): {
        let us = .side;
        var knights = .pieces(us, PieceKind::Knight);
        while knights != 0: {
            let from = bit_scan_forward(knights);
            knights = clear_lowest_bit(knights);
            var targets = KNIGHT_ATTACKS.at(from) & mask;
            while targets != 0: {
                let to = bit_scan_forward(targets);
                targets = clear_lowest_bit(targets);
                if .is_empty_square(to): {
                    list.add(encode_move(from, to, 0));
                } else: {
                    list.add(encode_move(from, to, 4));
                }
            }
        }
    }

    fn generate_bishop_moves(self: &const shared, list: &unique MoveList, mask: int): {
        let us = .side;
        var bishops = .pieces(us, PieceKind::Bishop);
        while bishops != 0: {
            let from = bit_scan_forward(bishops);
            bishops = clear_lowest_bit(bishops);
            var targets = bishop_attacks(from, .occupancy) & mask;
            while targets != 0: {
                let to = bit_scan_forward(targets);
                targets = clear_lowest_bit(targets);
                if .is_empty_square(to): {
                    list.add(encode_move(from, to, 0));
                } else: {
                    list.add(encode_move(from, to, 4));
                }
            }
        }
    }

    fn generate_rook_moves(self: &const shared, list: &unique MoveList, mask: int): {
        let us = .side;
        var rooks = .pieces(us, PieceKind::Rook);
        while rooks != 0: {
            let from = bit_scan_forward(rooks);
            rooks = clear_lowest_bit(rooks);
            var targets = rook_attacks(from, .occupancy) & mask;
            while targets != 0: {
                let to = bit_scan_forward(targets);
                targets = clear_lowest_bit(targets);
                if .is_empty_square(to): {
                    list.add(encode_move(from, to, 0));
                } else: {
                    list.add(encode_move(from, to, 4));
                }
            }
        }
    }

    fn generate_queen_moves(self: &const shared, list: &unique MoveList, mask: int): {
        let us = .side;
        var queens = .pieces(us, PieceKind::Queen);
        while queens != 0: {
            let from = bit_scan_forward(queens);
            queens = clear_lowest_bit(queens);
            var targets = queen_attacks(from, .occupancy) & mask;
            while targets != 0: {
                let to = bit_scan_forward(targets);
                targets = clear_lowest_bit(targets);
                if .is_empty_square(to): {
                    list.add(encode_move(from, to, 0));
                } else: {
                    list.add(encode_move(from, to, 4));
                }
            }
        }
    }

    fn generate_king_moves(self: &const shared, list: &unique MoveList, mask: int): {
        let from = .kings.at(color_index(.side));
        if from == NO_SQUARE: {
            return;
        }
        var targets = KING_ATTACKS.at(from) & mask;
        while targets != 0: {
            let to = bit_scan_forward(targets);
            targets = clear_lowest_bit(targets);
            if .is_empty_square(to): {
                list.add(encode_move(from, to, 0));
            } else: {
                list.add(encode_move(from, to, 4));
            }
        }
    }

    
    
    
    fn generate_castling_moves(self: &const shared, list: &unique MoveList): {
        if .in_check(): {
            return;
        }
        let us = .side;
        let them = opposite_color(us);
        var first: int = 0;
        var last: int = 2;
        if us == Color::Black: {
            first = 2;
            last = 4;
        }
        var index = first;
        while index < last: {
            let right = 1 << index;
            if (.castling & right) == 0: {
                index += 1;
                continue;
            }
            if (CASTLE_EMPTY_MASK.at(index) & .occupancy) != 0: {
                index += 1;
                continue;
            }
            
            
            var path = CASTLE_SAFE_MASK.at(index);
            var safe: bool = true;
            while path != 0: {
                let square = bit_scan_forward(path);
                path = clear_lowest_bit(path);
                if .is_attacked(square, them): {
                    safe = false;
                }
            }
            if safe: {
                var move_kind_bits: int = 2;
                if index == 1 || index == 3: {
                    move_kind_bits = 3;
                }
                list.add(encode_move(CASTLE_KING_FROM.at(index), CASTLE_KING_TO.at(index), move_kind_bits));
            }
            index += 1;
        }
    }

    
    fn generate_pseudo_legal(self: &const shared, list: &unique MoveList, kind: GenKind): {
        let us = .side;
        let them = opposite_color(us);
        let ours = .by_color.at(color_index(us));
        let enemies = .by_color.at(color_index(them));
        var mask = FULL_BOARD ^ ours;
        if kind == GenKind::GenCaptures: {
            mask = enemies;
        }
        if kind == GenKind::GenQuiets: {
            mask = FULL_BOARD ^ .occupancy;
        }

        .generate_pawn_moves(list, kind);
        .generate_knight_moves(list, mask);
        .generate_bishop_moves(list, mask);
        .generate_rook_moves(list, mask);
        .generate_queen_moves(list, mask);
        .generate_king_moves(list, mask);
        if kind != GenKind::GenCaptures: {
            .generate_castling_moves(list);
        }
    }

    
    
    fn generate_evasions(self: &const shared, list: &unique MoveList): {
        let us = .side;
        let king = .kings.at(color_index(us));
        let checking = .checkers_of(us);
        let ours = .by_color.at(color_index(us));

        
        .generate_king_moves(list, FULL_BOARD ^ ours);
        if checking == 0 || has_single_bit(checking) == false: {
            return;
        }

        let checker = bit_scan_forward(checking);
        let target = checking | BETWEEN.at(king).at(checker);
        .generate_pawn_moves(list, GenKind::GenAll);
        .generate_knight_moves(list, target);
        .generate_bishop_moves(list, target);
        .generate_rook_moves(list, target);
        .generate_queen_moves(list, target);
    }

    

    
    
    
    
    
    
    
    
    
    fn is_legal_move(self: &const shared, m: int) -> bool: {
        legality_test_count += 1;
        let us = .side;
        let them = opposite_color(us);
        let from = move_from(m);
        let to = move_to(m);
        let king = .kings.at(color_index(us));

        if from == king: {
            if move_is_castle(m): {
                return true;
            }
            let without_king = .occupancy ^ (1 << from);
            let hypothetical = (without_king | (1 << to)) & (FULL_BOARD ^ (1 << to));
            return .is_attacked_with(to, them, hypothetical | (1 << to)) == false;
        }

        if move_is_en_passant(m): {
            let captured = to - pawn_push_delta(us);
            let hypothetical = (.occupancy ^ (1 << from) ^ (1 << captured)) | (1 << to);
            var exposed: int = 0;
            exposed |= bishop_attacks(king, hypothetical) & .diagonal_sliders(them);
            exposed |= rook_attacks(king, hypothetical) & .straight_sliders(them);
            return exposed == 0;
        }

        let pinned = .pinned_pieces(us);
        if (pinned & (1 << from)) == 0: {
            return true;
        }
        return (LINE_THROUGH.at(king).at(from) & (1 << to)) != 0;
    }

    
    
    
    fn generate_legal(self: &const shared, list: &unique MoveList): {
        var pseudo: MoveList;
        if .in_check(): {
            .generate_evasions(pseudo);
        } else: {
            .generate_pseudo_legal(pseudo, GenKind::GenAll);
        }
        var index: int = 0;
        while index < pseudo.size(): {
            let m = pseudo.packed_at(index);
            if .is_legal_move(m): {
                list.add(m);
            }
            index += 1;
        }
        destroy pseudo;
    }

    fn generate_legal_captures(self: &const shared, list: &unique MoveList): {
        var pseudo: MoveList;
        .generate_pseudo_legal(pseudo, GenKind::GenCaptures);
        var index: int = 0;
        while index < pseudo.size(): {
            let m = pseudo.packed_at(index);
            if .is_legal_move(m): {
                list.add(m);
            }
            index += 1;
        }
        destroy pseudo;
    }

    fn count_legal_moves(self: &const shared) -> int: {
        var list: MoveList;
        .generate_legal(list);
        let total = list.size();
        destroy list;
        return total;
    }

    fn has_legal_move(self: &const shared) -> bool: {
        return .count_legal_moves() > 0;
    }

    

    
    
    
    fn make_move(self: &unique, m: int): {
        make_move_count += 1;
        let us = .side;
        let them = opposite_color(us);
        let from = move_from(m);
        let to = move_to(m);
        let kind = move_kind(m);
        let mover = .squares.at(from);

        var record: Undo;
        record.move_packed = m;
        record.castling = .castling;
        record.ep_square = .ep_square;
        record.halfmove = .halfmove;
        record.key = .key;
        record.captured = PIECE_CODE_COUNT;

        
        if .ep_square != NO_SQUARE: {
            .key ^= ZOBRIST_EP_FILE.at(file_of(.ep_square));
        }
        .key ^= ZOBRIST_CASTLING.at(.castling & CASTLE_ALL);

        .ep_square = NO_SQUARE;
        .halfmove += 1;

        if kind == 5: {
            
            let victim = to - pawn_push_delta(us);
            record.captured = .squares.at(victim);
            .remove_piece(victim);
            .move_piece(from, to);
            .halfmove = 0;
        } else: {
            if move_is_capture(m): {
                record.captured = .squares.at(to);
                .remove_piece(to);
                .halfmove = 0;
            }
            .move_piece(from, to);
        }

        if piece_kind(mover) == PieceKind::Pawn: {
            .halfmove = 0;
        }

        
        if kind == 1: {
            .ep_square = to - pawn_push_delta(us);
        }

        
        if move_is_promotion(m): {
            .remove_piece(to);
            .put_piece(make_piece(us, move_promotion_kind(m)), to);
        }

        
        if kind == 2 || kind == 3: {
            var index: int = 0;
            if us == Color::White: {
                if kind == 3: {
                    index = 1;
                }
            } else: {
                index = 2;
                if kind == 3: {
                    index = 3;
                }
            }
            .move_piece(CASTLE_ROOK_FROM.at(index), CASTLE_ROOK_TO.at(index));
        }

        .castling &= CASTLE_MASK.at(from);
        .castling &= CASTLE_MASK.at(to);
        .key ^= ZOBRIST_CASTLING.at(.castling & CASTLE_ALL);
        if .ep_square != NO_SQUARE: {
            .key ^= ZOBRIST_EP_FILE.at(file_of(.ep_square));
        }
        .key ^= ZOBRIST_SIDE;

        if us == Color::Black: {
            .fullmove += 1;
        }
        .side = them;
        .ply += 1;
        .history.push_back(record);
    }

    
    
    fn unmake_move(self: &unique): {
        assert .history.size() > 0;
        let record = .history.back();
        let m = record.move_packed;
        let from = move_from(m);
        let to = move_to(m);
        let kind = move_kind(m);
        let us = opposite_color(.side);

        .side = us;
        .ply -= 1;
        if us == Color::Black: {
            .fullmove -= 1;
        }

        
        
        if kind == 2 || kind == 3: {
            var index: int = 0;
            if us == Color::White: {
                if kind == 3: {
                    index = 1;
                }
            } else: {
                index = 2;
                if kind == 3: {
                    index = 3;
                }
            }
            .move_piece(CASTLE_ROOK_TO.at(index), CASTLE_ROOK_FROM.at(index));
        }

        
        if move_is_promotion(m): {
            .remove_piece(to);
            .put_piece(make_piece(us, PieceKind::Pawn), to);
        }

        .move_piece(to, from);

        if kind == 5: {
            let victim = to - pawn_push_delta(us);
            .put_piece(record.captured, victim);
        } else: {
            if record.captured < PIECE_CODE_COUNT: {
                .put_piece(record.captured, to);
            }
        }

        .castling = record.castling;
        .ep_square = record.ep_square;
        .halfmove = record.halfmove;
        .key = record.key;
        .history.pop_back();
    }

    
    
    
    fn make_null_move(self: &unique): {
        var record: Undo;
        record.move_packed = MOVE_NULL;
        record.captured = PIECE_CODE_COUNT;
        record.castling = .castling;
        record.ep_square = .ep_square;
        record.halfmove = .halfmove;
        record.key = .key;
        if .ep_square != NO_SQUARE: {
            .key ^= ZOBRIST_EP_FILE.at(file_of(.ep_square));
        }
        .ep_square = NO_SQUARE;
        .key ^= ZOBRIST_SIDE;
        .side = opposite_color(.side);
        .halfmove += 1;
        .ply += 1;
        .history.push_back(record);
    }

    fn unmake_null_move(self: &unique): {
        assert .history.size() > 0;
        let record = .history.back();
        .side = opposite_color(.side);
        .castling = record.castling;
        .ep_square = record.ep_square;
        .halfmove = record.halfmove;
        .key = record.key;
        .ply -= 1;
        .history.pop_back();
    }

    

    fn is_checkmate(self: &const shared) -> bool: {
        return .in_check() && .count_legal_moves() == 0;
    }

    fn is_stalemate(self: &const shared) -> bool: {
        return .in_check() == false && .count_legal_moves() == 0;
    }

    fn is_fifty_move_draw(self: &const shared) -> bool: {
        return .halfmove >= FIFTY_MOVE_PLIES;
    }

    
    
    fn is_insufficient_material(self: &const shared) -> bool: {
        let pawns = .by_kind.at(kind_index(PieceKind::Pawn));
        let rooks = .by_kind.at(kind_index(PieceKind::Rook));
        let queens = .by_kind.at(kind_index(PieceKind::Queen));
        if (pawns | rooks | queens) != 0: {
            return false;
        }
        let knights = .by_kind.at(kind_index(PieceKind::Knight));
        let bishops = .by_kind.at(kind_index(PieceKind::Bishop));
        let minors = knights | bishops;
        if popcount(minors) <= 1: {
            return true;
        }
        if knights == 0 && popcount(bishops) == 2: {
            if (bishops & LIGHT_SQUARES) == bishops: {
                return true;
            }
            if (bishops & DARK_SQUARES) == bishops: {
                return true;
            }
        }
        return false;
    }

    
    
    
    fn repetition_count(self: &const shared) -> int: {
        var seen: int = 0;
        var index = .history.size() - 2;
        var span: int = 0;
        while index >= 0 && span < .halfmove: {
            if .history.at(index).key == .key: {
                seen += 1;
            }
            index -= 2;
            span += 2;
        }
        return seen;
    }

    fn result(self: &const shared) -> GameResult: {
        if .count_legal_moves() == 0: {
            if .in_check(): {
                if .side == Color::White: {
                    return GameResult::BlackWins;
                }
                return GameResult::WhiteWins;
            }
            return GameResult::DrawStalemate;
        }
        if .is_fifty_move_draw(): {
            return GameResult::DrawFiftyMove;
        }
        if .is_insufficient_material(): {
            return GameResult::DrawInsufficient;
        }
        if .repetition_count() >= 2: {
            return GameResult::DrawRepetition;
        }
        return GameResult::Ongoing;
    }

    
    
    
    fn gives_check(self: &const shared, m: int) -> bool: {
        let us = .side;
        let them = opposite_color(us);
        let enemy_king = .kings.at(color_index(them));
        if enemy_king == NO_SQUARE: {
            return false;
        }
        let from = move_from(m);
        let to = move_to(m);
        var kind = piece_kind(.squares.at(from));
        if move_is_promotion(m): {
            kind = move_promotion_kind(m);
        }
        let after = (.occupancy ^ (1 << from)) | (1 << to);
        if (attacks_of_kind(kind, us, to, after) & (1 << enemy_king)) != 0: {
            return true;
        }
        let candidates = .discovery_candidates(us);
        if (candidates & (1 << from)) == 0: {
            return false;
        }
        return (LINE_THROUGH.at(enemy_king).at(from) & (1 << to)) == 0;
    }

    
    
    fn least_valuable_attacker(self: &const shared, attackers: int, color: Color) -> int: {
        var kind: int = 0;
        while kind < PIECE_KIND_COUNT: {
            let subset = attackers
                & .by_color.at(color_index(color))
                & .by_kind.at(kind);
            if subset != 0: {
                return lowest_bit(subset);
            }
            kind += 1;
        }
        return 0;
    }

    

    
    squares: vector{int};
    
    by_color: vector{int};
    by_kind: vector{int};
    
    occupancy: int = 0;
    
    kings: vector{int};
    side: Color = Color::White;
    castling: int = 0;
    ep_square: int = -1;
    halfmove: int = 0;
    fullmove: int = 1;
    key: int = 0;
    ply: int = 0;
    history: vector{Undo};
}




fn file_char(file: int) -> char: {
    return CHAR_LOWER_A + file;
}

fn rank_char(rank: int) -> char: {
    return CHAR_ZERO + 1 + rank;
}

fn char_to_file(c: char) -> int: {
    return c - CHAR_LOWER_A;
}

fn char_to_rank(c: char) -> int: {
    return c - CHAR_ZERO - 1;
}


fn square_name(square: int) -> string: {
    var out: string;
    if square == NO_SQUARE: {
        out.push_back(CHAR_DASH);
        return out;
    }
    out.push_back(file_char(file_of(square)));
    out.push_back(rank_char(rank_of(square)));
    return out;
}

fn square_from_name(name: &const shared string) -> int: {
    if name.size() < 2: {
        return NO_SQUARE;
    }
    let file = char_to_file(name.at(0));
    let rank = char_to_rank(name.at(1));
    if file < 0 || file >= BOARD_FILES || rank < 0 || rank >= BOARD_RANKS: {
        return NO_SQUARE;
    }
    return make_square(file, rank);
}


fn kind_char(kind: PieceKind) -> char: {
    if kind == PieceKind::Pawn: {
        return 'p';
    } else: { if kind == PieceKind::Knight: {
        return 'n';
    } else: { if kind == PieceKind::Bishop: {
        return 'b';
    } else: { if kind == PieceKind::Rook: {
        return 'r';
    } else: { if kind == PieceKind::Queen: {
        return 'q';
    } else: { if kind == PieceKind::King: {
        return 'k';
    } else: {
        return '?';
    } } } } } }
}

fn char_to_kind(c: char) -> PieceKind: {
    var lower = c;
    if lower >= CHAR_UPPER_A && lower < CHAR_UPPER_A + 26: {
        lower = lower | CASE_BIT;
    }
    if lower == 'p': {
        return PieceKind::Pawn;
    } else: { if lower == 'n': {
        return PieceKind::Knight;
    } else: { if lower == 'b': {
        return PieceKind::Bishop;
    } else: { if lower == 'r': {
        return PieceKind::Rook;
    } else: { if lower == 'q': {
        return PieceKind::Queen;
    } else: { if lower == 'k': {
        return PieceKind::King;
    } else: {
        return PieceKind::KindNone;
    } } } } } }
}


fn piece_char(piece: int) -> char: {
    if piece_is_empty(piece): {
        return '.';
    }
    let letter = kind_char(piece_kind(piece));
    if piece_color(piece) == Color::White: {
        return letter & (FULL_BOARD ^ CASE_BIT);
    }
    return letter;
}


fn move_to_uci(m: int) -> string: {
    var out: string;
    if move_is_null(m): {
        out.append("0000");
        return out;
    }
    let from = move_from(m);
    let to = move_to(m);
    out.push_back(file_char(file_of(from)));
    out.push_back(rank_char(rank_of(from)));
    out.push_back(file_char(file_of(to)));
    out.push_back(rank_char(rank_of(to)));
    if move_is_promotion(m): {
        out.push_back(kind_char(move_promotion_kind(m)));
    }
    return out;
}




fn move_from_uci(board: &const shared Position, text: &const shared string) -> int: {
    if text.size() < 4: {
        return MOVE_NULL;
    }
    let from = make_square(char_to_file(text.at(0)), char_to_rank(text.at(1)));
    let to = make_square(char_to_file(text.at(2)), char_to_rank(text.at(3)));
    var promotion = PieceKind::KindNone;
    if text.size() >= 5: {
        promotion = char_to_kind(text.at(4));
    }

    var list: MoveList;
    board.generate_legal(list);
    var index: int = 0;
    var found: int = MOVE_NULL;
    while index < list.size(): {
        let m = list.packed_at(index);
        if move_from(m) == from && move_to(m) == to: {
            if move_is_promotion(m) == false && promotion == PieceKind::KindNone: {
                found = m;
            }
            if move_is_promotion(m) && move_promotion_kind(m) == promotion: {
                found = m;
            }
        }
        index += 1;
    }
    destroy list;
    return found;
}




fn move_to_san(board: &const shared Position, m: int) -> string: {
    var out: string;
    if move_is_king_castle(m): {
        out.append("O-O");
        return out;
    }
    if move_is_castle(m): {
        out.append("O-O-O");
        return out;
    }

    let from = move_from(m);
    let to = move_to(m);
    let mover = board.piece_at(from);
    let kind = piece_kind(mover);

    if kind == PieceKind::Pawn: {
        if move_is_capture(m): {
            out.push_back(file_char(file_of(from)));
            out.push_back('x');
        }
        out.push_back(file_char(file_of(to)));
        out.push_back(rank_char(rank_of(to)));
        if move_is_promotion(m): {
            out.push_back('=');
            out.push_back(kind_char(move_promotion_kind(m)) & (FULL_BOARD ^ CASE_BIT));
        }
        return out;
    }

    out.push_back(kind_char(kind) & (FULL_BOARD ^ CASE_BIT));

    
    var same_file: bool = false;
    var same_rank: bool = false;
    var ambiguous: bool = false;
    var list: MoveList;
    board.generate_legal(list);
    var index: int = 0;
    while index < list.size(): {
        let other = list.packed_at(index);
        let other_from = move_from(other);
        if other_from != from && move_to(other) == to: {
            if piece_kind(board.piece_at(other_from)) == kind: {
                ambiguous = true;
                if file_of(other_from) == file_of(from): {
                    same_file = true;
                }
                if rank_of(other_from) == rank_of(from): {
                    same_rank = true;
                }
            }
        }
        index += 1;
    }
    destroy list;

    if ambiguous: {
        if same_file == false: {
            out.push_back(file_char(file_of(from)));
        } else: {
            if same_rank == false: {
                out.push_back(rank_char(rank_of(from)));
            } else: {
                out.push_back(file_char(file_of(from)));
                out.push_back(rank_char(rank_of(from)));
            }
        }
    }

    if move_is_capture(m): {
        out.push_back('x');
    }
    out.push_back(file_char(file_of(to)));
    out.push_back(rank_char(rank_of(to)));

    if board.gives_check(m): {
        out.push_back('+');
    }
    return out;
}





static START_FEN: string = "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1";
static KIWIPETE_FEN: string = "r3k2r/p1ppqpb1/bn2pnp1/3PN3/1p2P3/2N2Q1p/PPPBBPPP/R3K2R w KQkq - 0 1";
static ENDGAME_FEN: string = "8/2p5/3p4/KP5r/1R3p1k/8/4P1P1/8 w - - 0 1";
static PROMOTION_FEN: string = "n1n5/PPPk4/8/8/8/8/4Kppp/5N1N b - - 0 1";




fn parse_fen(board: &unique Position, fen: &const shared string) -> bool: {
    board.reset();

    var cursor: int = 0;
    let length = fen.size();

    
    var rank: int = BOARD_RANKS - 1;
    var file: int = 0;
    while cursor < length: {
        let c = fen.at(cursor);
        if c == CHAR_SPACE: {
            cursor += 1;
            break;
        }
        if c == CHAR_SLASH: {
            rank -= 1;
            file = 0;
            cursor += 1;
            continue;
        }
        if c >= CHAR_ZERO && c <= CHAR_NINE: {
            file += c - CHAR_ZERO;
            cursor += 1;
            continue;
        }
        let kind = char_to_kind(c);
        if kind == PieceKind::KindNone: {
            return false;
        }
        var color = Color::Black;
        if c < CHAR_LOWER_A: {
            color = Color::White;
        }
        if rank < 0 || rank >= BOARD_RANKS || file < 0 || file >= BOARD_FILES: {
            return false;
        }
        board.put_piece(make_piece(color, kind), make_square(file, rank));
        file += 1;
        cursor += 1;
    }

    
    if cursor < length: {
        if fen.at(cursor) == 'b': {
            board.side = Color::Black;
        } else: {
            board.side = Color::White;
        }
        cursor += 1;
    }
    while cursor < length && fen.at(cursor) == CHAR_SPACE: {
        cursor += 1;
    }

    
    board.castling = CASTLE_NONE;
    while cursor < length: {
        let c = fen.at(cursor);
        if c == CHAR_SPACE: {
            cursor += 1;
            break;
        }
        if c == 'K': {
            board.castling |= CASTLE_WHITE_KING;
        }
        if c == 'Q': {
            board.castling |= CASTLE_WHITE_QUEEN;
        }
        if c == 'k': {
            board.castling |= CASTLE_BLACK_KING;
        }
        if c == 'q': {
            board.castling |= CASTLE_BLACK_QUEEN;
        }
        cursor += 1;
    }

    
    board.ep_square = NO_SQUARE;
    if cursor < length: {
        let c = fen.at(cursor);
        if c == CHAR_DASH: {
            cursor += 2;
        } else: {
            if cursor + 1 < length: {
                board.ep_square = make_square(char_to_file(c), char_to_rank(fen.at(cursor + 1)));
            }
            cursor += 3;
        }
    }

    
    var halfmove: int = 0;
    while cursor < length && fen.at(cursor) >= CHAR_ZERO && fen.at(cursor) <= CHAR_NINE: {
        halfmove = halfmove * 10 + (fen.at(cursor) - CHAR_ZERO);
        cursor += 1;
    }
    board.halfmove = halfmove;
    while cursor < length && fen.at(cursor) == CHAR_SPACE: {
        cursor += 1;
    }

    var fullmove: int = 0;
    while cursor < length && fen.at(cursor) >= CHAR_ZERO && fen.at(cursor) <= CHAR_NINE: {
        fullmove = fullmove * 10 + (fen.at(cursor) - CHAR_ZERO);
        cursor += 1;
    }
    if fullmove == 0: {
        fullmove = 1;
    }
    board.fullmove = fullmove;
    board.key = board.compute_key();
    return true;
}



fn to_fen(board: &const shared Position) -> string: {
    var out: string;
    var rank: int = BOARD_RANKS - 1;
    while rank >= 0: {
        var empty_run: int = 0;
        var file: int = 0;
        while file < BOARD_FILES: {
            let piece = board.piece_at(make_square(file, rank));
            if piece_is_empty(piece): {
                empty_run += 1;
            } else: {
                if empty_run > 0: {
                    out.push_back(CHAR_ZERO + empty_run);
                    empty_run = 0;
                }
                out.push_back(piece_char(piece));
            }
            file += 1;
        }
        if empty_run > 0: {
            out.push_back(CHAR_ZERO + empty_run);
        }
        if rank > 0: {
            out.push_back(CHAR_SLASH);
        }
        rank -= 1;
    }

    out.push_back(CHAR_SPACE);
    if board.side_to_move() == Color::White: {
        out.push_back('w');
    } else: {
        out.push_back('b');
    }

    out.push_back(CHAR_SPACE);
    let rights = board.castling_rights();
    if rights == CASTLE_NONE: {
        out.push_back(CHAR_DASH);
    } else: {
        if (rights & CASTLE_WHITE_KING) != 0: {
            out.push_back('K');
        }
        if (rights & CASTLE_WHITE_QUEEN) != 0: {
            out.push_back('Q');
        }
        if (rights & CASTLE_BLACK_KING) != 0: {
            out.push_back('k');
        }
        if (rights & CASTLE_BLACK_QUEEN) != 0: {
            out.push_back('q');
        }
    }

    out.push_back(CHAR_SPACE);
    out.append(square_name(board.en_passant_square()));
    out.push_back(CHAR_SPACE);
    out.append(to_string(board.halfmove_clock()));
    out.push_back(CHAR_SPACE);
    out.append(to_string(board.fullmove_number()));
    return out;
}


fn board_to_text(board: &const shared Position) -> string: {
    var out: string;
    var rank: int = BOARD_RANKS - 1;
    while rank >= 0: {
        out.push_back(rank_char(rank));
        out.push_back(CHAR_SPACE);
        var file: int = 0;
        while file < BOARD_FILES: {
            out.push_back(piece_char(board.piece_at(make_square(file, rank))));
            out.push_back(CHAR_SPACE);
            file += 1;
        }
        out.push_back('\n');
        rank -= 1;
    }
    out.append("  a b c d e f g h\n");
    return out;
}




static var perft_node_counts: vector{int} = vector{int}(16);
static var perft_capture_counts: vector{int} = vector{int}(16);
static var perft_ep_counts: vector{int} = vector{int}(16);
static var perft_castle_counts: vector{int} = vector{int}(16);
static var perft_promotion_counts: vector{int} = vector{int}(16);
static var perft_check_counts: vector{int} = vector{int}(16);

fn reset_perft_counters(): {
    var depth: int = 0;
    while depth < 16: {
        perft_node_counts.at(depth) = 0;
        perft_capture_counts.at(depth) = 0;
        perft_ep_counts.at(depth) = 0;
        perft_castle_counts.at(depth) = 0;
        perft_promotion_counts.at(depth) = 0;
        perft_check_counts.at(depth) = 0;
        depth += 1;
    }
}



fn perft(board: &unique Position, depth: int) -> int: {
    if depth == 0: {
        return 1;
    }
    var list: MoveList;
    board.generate_legal(list);
    if depth == 1: {
        let leaves = list.size();
        destroy list;
        return leaves;
    }
    var nodes: int = 0;
    var index: int = 0;
    while index < list.size(): {
        let m = list.packed_at(index);
        board.make_move(m);
        nodes += perft(board, depth - 1);
        board.unmake_move();
        index += 1;
    }
    destroy list;
    return nodes;
}



fn perft_detailed(board: &unique Position, depth: int, ply: int) -> int: {
    if depth == 0: {
        perft_node_counts.at(ply) += 1;
        return 1;
    }
    var list: MoveList;
    board.generate_legal(list);
    var nodes: int = 0;
    var index: int = 0;
    while index < list.size(): {
        let m = list.packed_at(index);
        if move_is_capture(m): {
            perft_capture_counts.at(ply) += 1;
        }
        if move_is_en_passant(m): {
            perft_ep_counts.at(ply) += 1;
        }
        if move_is_castle(m): {
            perft_castle_counts.at(ply) += 1;
        }
        if move_is_promotion(m): {
            perft_promotion_counts.at(ply) += 1;
        }
        if board.gives_check(m): {
            perft_check_counts.at(ply) += 1;
        }
        board.make_move(m);
        nodes += perft_detailed(board, depth - 1, ply + 1);
        board.unmake_move();
        index += 1;
    }
    destroy list;
    perft_node_counts.at(ply) += nodes;
    return nodes;
}



fn perft_divide(board: &unique Position, depth: int): {
    var list: MoveList;
    board.generate_legal(list);
    var total: int = 0;
    var index: int = 0;
    while index < list.size(): {
        let m = list.packed_at(index);
        board.make_move(m);
        let nodes = perft(board, depth - 1);
        board.unmake_move();
        total += nodes;

        var line: string;
        line.append(move_to_uci(m));
        line.append(": ");
        line.append(to_string(nodes));
        println(line);
        destroy line;
        index += 1;
    }
    destroy list;

    var summary: string;
    summary.append("total: ");
    summary.append(to_string(total));
    println(summary);
    destroy summary;
}




fn verify_make_unmake(board: &unique Position) -> bool: {
    let key_before = board.hash_key();
    let occupancy_before = board.occupied();
    let castling_before = board.castling_rights();

    var list: MoveList;
    board.generate_legal(list);
    var index: int = 0;
    var ok: bool = true;
    while index < list.size(): {
        let m = list.packed_at(index);
        board.make_move(m);
        board.unmake_move();
        if board.hash_key() != key_before: {
            ok = false;
        }
        if board.occupied() != occupancy_before: {
            ok = false;
        }
        if board.castling_rights() != castling_before: {
            ok = false;
        }
        index += 1;
    }
    destroy list;
    assert board.hash_key() == key_before;
    prove board.occupied() == occupancy_before;
    return ok;
}






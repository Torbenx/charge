static NUMBER_BASE: int = 10;
static MAX_DIGITS: int = 18;
static MIN_EXPONENT: int = -30;
static MAX_EXPONENT: int = 30;
static MAX_DEPTH: int = 96;
static MAX_ARGUMENTS: int = 32;





enum TokenKind: {
    End;
    Invalid;

    Identifier;
    Number;
    Text;
    Comment;

    Plus;
    Minus;
    Star;
    Slash;
    Percent;
    StarStar;

    Amp;
    Pipe;
    Caret;
    Tilde;
    LessLess;
    GreaterGreater;

    Bang;
    AmpAmp;
    PipePipe;

    Less;
    LessEqual;
    Greater;
    GreaterEqual;
    EqualEqual;
    BangEqual;

    Equal;
    PlusEqual;
    MinusEqual;
    StarEqual;
    SlashEqual;
    PercentEqual;
    AmpEqual;
    PipeEqual;
    CaretEqual;
    LessLessEqual;
    GreaterGreaterEqual;

    PlusPlus;
    MinusMinus;

    Question;
    Colon;
    Comma;
    Semicolon;
    Dot;
    Arrow;

    LParen;
    RParen;
    LBracket;
    RBracket;
    LBrace;
    RBrace;

    KeywordLet;
    KeywordIf;
    KeywordThen;
    KeywordElse;
    KeywordWhile;
    KeywordFn;
    KeywordReturn;
    KeywordTrue;
    KeywordFalse;
    KeywordNull;
    KeywordAnd;
    KeywordOr;
    KeywordNot;
}



enum NodeKind: {
    Invalid;
    NumberLiteral;
    TextLiteral;
    BoolLiteral;
    NullLiteral;
    Variable;
    Unary;
    Binary;
    Postfix;
    Assign;
    Call;
    Index;
    Member;
    Conditional;
    Let;
    Block;
    Loop;
    Return;
    Empty;
}



enum ValueKind: {
    Nil;
    Bool;
    Number;
    Text;
    List;
    Builtin;
    Failure;
}



enum Associativity: {
    None;
    Left;
    Right;
}



enum ErrorCode: {
    None;
    UnexpectedCharacter;
    UnterminatedText;
    UnterminatedComment;
    BadEscape;
    TooManyDigits;
    ExponentRange;
    ExpectedExpression;
    ExpectedToken;
    ExpectedIdentifier;
    UnbalancedParen;
    UnbalancedBracket;
    DepthExceeded;
    TooManyArguments;
    NotAssignable;
    UnknownName;
    NotCallable;
    NotIndexable;
    WrongArity;
    DivideByZero;
    TypeMismatch;
}

fn error_text(code: ErrorCode) -> string: {
    if code == ErrorCode::None: {
        return "no error";
    }
    if code == ErrorCode::UnexpectedCharacter: {
        return "unexpected character in the input";
    }
    if code == ErrorCode::UnterminatedText: {
        return "unterminated string literal, expected a closing quote";
    }
    if code == ErrorCode::UnterminatedComment: {
        return "unterminated block comment, expected a closing marker";
    }
    if code == ErrorCode::BadEscape: {
        return "invalid escape sequence after a backslash";
    }
    if code == ErrorCode::TooManyDigits: {
        return "number has more significant digits than can be represented";
    }
    if code == ErrorCode::ExponentRange: {
        return "decimal exponent is out of range";
    }
    if code == ErrorCode::ExpectedExpression: {
        return "expected an expression";
    }
    if code == ErrorCode::ExpectedToken: {
        return "expected a different token here";
    }
    if code == ErrorCode::ExpectedIdentifier: {
        return "expected an identifier";
    }
    if code == ErrorCode::UnbalancedParen: {
        return "expected a closing parenthesis";
    }
    if code == ErrorCode::UnbalancedBracket: {
        return "expected a closing bracket";
    }
    if code == ErrorCode::DepthExceeded: {
        return "expression nests too deeply";
    }
    if code == ErrorCode::TooManyArguments: {
        return "call has too many arguments";
    }
    if code == ErrorCode::NotAssignable: {
        return "left hand side of the assignment is not assignable";
    }
    if code == ErrorCode::UnknownName: {
        return "name is not bound in any enclosing scope";
    }
    if code == ErrorCode::NotCallable: {
        return "value is not callable";
    }
    if code == ErrorCode::NotIndexable: {
        return "value cannot be indexed";
    }
    if code == ErrorCode::WrongArity: {
        return "builtin called with the wrong number of arguments";
    }
    if code == ErrorCode::DivideByZero: {
        return "division by zero";
    }
    if code == ErrorCode::TypeMismatch: {
        return "operand types do not match the operator";
    }
    return "unknown error";
}





struct Position: {

    fn advance_over(self: &unique, c: char): {
        .offset += 1;
        if c == CHAR_NEWLINE: {
            .line += 1;
            .column = 1;
        } else: {
            .column += 1;
        }
    }

    fn describe(self: &const shared) -> string: {
        var out: string = "line ";
        out.append(to_string(.line));
        out.append(", column ");
        out.append(to_string(.column));
        return out;
    }

    offset: int = 0;
    line: int = 1;
    column: int = 1;
}



struct Span: {

    fn length(self: &const shared) -> int: {
        return .end.offset - .begin.offset;
    }

    fn empty(self: &const shared) -> bool: {
        return .length() <= 0;
    }

    fn text_of(self: &const shared, source: &const shared string) -> string: {
        if .empty(): {
            return TEXT_EMPTY;
        }
        return source.substr(.begin.offset, .length());
    }

    fn describe(self: &const shared) -> string: {
        var out = .begin.describe();
        if .end.line != .begin.line: {
            out.append(" through ");
            out.append(.end.describe());
        }
        return out;
    }

    begin: Position;
    end: Position;
}

struct Diagnostic: {

    fn ok(self: &const shared) -> bool: {
        return .code == ErrorCode::None;
    }

    fn describe(self: &const shared) -> string: {
        var out = .where.describe();
        out.append(": ");
        out.append(error_text(.code));
        if .detail.size() > 0: {
            out.append(" (");
            out.append(.detail);
            out.append(")");
        }
        return out;
    }

    code: ErrorCode = ErrorCode::None;
    where: Position;
    detail: string;
}



struct Token: {

    fn is_end(self: &const shared) -> bool: {
        return .kind == TokenKind::End;
    }

    fn is_literal(self: &const shared) -> bool: {
        if .kind == TokenKind::Number: {
            return true;
        }
        if .kind == TokenKind::Text: {
            return true;
        }
        if .kind == TokenKind::KeywordTrue: {
            return true;
        }
        if .kind == TokenKind::KeywordFalse: {
            return true;
        }
        if .kind == TokenKind::KeywordNull: {
            return true;
        }
        return false;
    }

    fn describe(self: &const shared) -> string: {
        var out = token_name(.kind);
        if .text.size() > 0: {
            out.append(" '");
            out.append(.text);
            out.append("'");
        }
        out.append(" at ");
        out.append(.span.begin.describe());
        return out;
    }

    kind: TokenKind = TokenKind::End;
    text: string;
    span: Span;
    
    
    mantissa: int = 0;
    exponent: int = 0;
}



fn is_space(c: char) => c == CHAR_SPACE || c == CHAR_TAB || c == CHAR_NEWLINE || c == CHAR_RETURN;

fn is_digit(c: char) => c >= '0' && c <= '9';

fn is_lower(c: char) => c >= 'a' && c <= 'z';

fn is_upper(c: char) => c >= 'A' && c <= 'Z';

fn is_letter(c: char) -> bool: {
    if is_lower(c): {
        return true;
    }
    if is_upper(c): {
        return true;
    }
    return c == CHAR_UNDERSCORE;
}

fn is_identifier_start(c: char) -> bool: {
    return is_letter(c);
}

fn is_identifier_body(c: char) -> bool: {
    if is_letter(c): {
        return true;
    }
    return is_digit(c);
}

fn digit_value(c: char) -> int: {
    return int(c) - int(CHAR_ZERO);
}

fn to_lower(c: char) -> char: {
    if is_upper(c): {
        return char(int(c) + 32);
    }
    return c;
}

fn to_upper(c: char) -> char: {
    if is_lower(c): {
        return char(int(c) - 32);
    }
    return c;
}



fn is_operator_start(c: char) -> bool: {
    if c == CHAR_PLUS || c == CHAR_MINUS || c == CHAR_STAR || c == CHAR_SLASH: {
        return true;
    }
    if c == CHAR_PERCENT || c == CHAR_AMP || c == CHAR_PIPE || c == CHAR_CARET: {
        return true;
    }
    if c == CHAR_TILDE || c == CHAR_BANG || c == CHAR_LESS || c == CHAR_GREATER: {
        return true;
    }
    if c == CHAR_EQUAL || c == CHAR_QUESTION || c == CHAR_COLON || c == CHAR_COMMA: {
        return true;
    }
    if c == CHAR_SEMICOLON || c == CHAR_DOT: {
        return true;
    }
    return is_bracket(c);
}

fn is_bracket(c: char) -> bool: {
    if c == CHAR_LPAREN || c == CHAR_RPAREN: {
        return true;
    }
    if c == CHAR_LBRACKET || c == CHAR_RBRACKET: {
        return true;
    }
    if c == CHAR_LBRACE || c == CHAR_RBRACE: {
        return true;
    }
    return false;
}







fn token_spelling(kind: TokenKind) -> string: {
    if kind == TokenKind::Plus: { return "+"; }
    if kind == TokenKind::Minus: { return "-"; }
    if kind == TokenKind::Star: { return "*"; }
    if kind == TokenKind::Slash: { return "/"; }
    if kind == TokenKind::Percent: { return "%"; }
    if kind == TokenKind::StarStar: { return "**"; }
    if kind == TokenKind::Amp: { return "&"; }
    if kind == TokenKind::Pipe: { return "|"; }
    if kind == TokenKind::Caret: { return "^"; }
    if kind == TokenKind::Tilde: { return "~"; }
    if kind == TokenKind::LessLess: { return "<<"; }
    if kind == TokenKind::GreaterGreater: { return ">>"; }
    if kind == TokenKind::Bang: { return "!"; }
    if kind == TokenKind::AmpAmp: { return "&&"; }
    if kind == TokenKind::PipePipe: { return "||"; }
    if kind == TokenKind::Less: { return "<"; }
    if kind == TokenKind::LessEqual: { return "<="; }
    if kind == TokenKind::Greater: { return ">"; }
    if kind == TokenKind::GreaterEqual: { return ">="; }
    if kind == TokenKind::EqualEqual: { return "=="; }
    if kind == TokenKind::BangEqual: { return "!="; }
    if kind == TokenKind::Equal: { return "="; }
    if kind == TokenKind::PlusEqual: { return "+="; }
    if kind == TokenKind::MinusEqual: { return "-="; }
    if kind == TokenKind::StarEqual: { return "*="; }
    if kind == TokenKind::SlashEqual: { return "/="; }
    if kind == TokenKind::PercentEqual: { return "%="; }
    if kind == TokenKind::AmpEqual: { return "&="; }
    if kind == TokenKind::PipeEqual: { return "|="; }
    if kind == TokenKind::CaretEqual: { return "^="; }
    if kind == TokenKind::LessLessEqual: { return "<<="; }
    if kind == TokenKind::GreaterGreaterEqual: { return ">>="; }
    if kind == TokenKind::PlusPlus: { return "++"; }
    if kind == TokenKind::MinusMinus: { return "--"; }
    if kind == TokenKind::Question: { return "?"; }
    if kind == TokenKind::Colon: { return ":"; }
    if kind == TokenKind::Comma: { return ","; }
    if kind == TokenKind::Semicolon: { return ";"; }
    if kind == TokenKind::Dot: { return "."; }
    if kind == TokenKind::Arrow: { return "->"; }
    if kind == TokenKind::LParen: { return "("; }
    if kind == TokenKind::RParen: { return ")"; }
    if kind == TokenKind::LBracket: { return "["; }
    if kind == TokenKind::RBracket: { return "]"; }
    if kind == TokenKind::LBrace: { return "{"; }
    if kind == TokenKind::RBrace: { return "}"; }
    if kind == TokenKind::KeywordLet: { return "let"; }
    if kind == TokenKind::KeywordIf: { return "if"; }
    if kind == TokenKind::KeywordThen: { return "then"; }
    if kind == TokenKind::KeywordElse: { return "else"; }
    if kind == TokenKind::KeywordWhile: { return "while"; }
    if kind == TokenKind::KeywordFn: { return "fn"; }
    if kind == TokenKind::KeywordReturn: { return "return"; }
    if kind == TokenKind::KeywordTrue: { return "true"; }
    if kind == TokenKind::KeywordFalse: { return "false"; }
    if kind == TokenKind::KeywordNull: { return "null"; }
    if kind == TokenKind::KeywordAnd: { return "and"; }
    if kind == TokenKind::KeywordOr: { return "or"; }
    if kind == TokenKind::KeywordNot: { return "not"; }
    return TEXT_EMPTY;
}



fn token_name(kind: TokenKind) -> string: {
    if kind == TokenKind::End: { return "end of input"; }
    if kind == TokenKind::Invalid: { return "invalid token"; }
    if kind == TokenKind::Identifier: { return "identifier"; }
    if kind == TokenKind::Number: { return "number"; }
    if kind == TokenKind::Text: { return "string"; }
    if kind == TokenKind::Comment: { return "comment"; }
    let spelling = token_spelling(kind);
    if spelling.size() > 0: {
        return spelling;
    }
    return "token";
}



fn keyword_kind(word: &const shared string) -> TokenKind: {
    if *word == WORD_LET: { return TokenKind::KeywordLet; }
    if *word == WORD_IF: { return TokenKind::KeywordIf; }
    if *word == WORD_THEN: { return TokenKind::KeywordThen; }
    if *word == WORD_ELSE: { return TokenKind::KeywordElse; }
    if *word == WORD_WHILE: { return TokenKind::KeywordWhile; }
    if *word == WORD_FN: { return TokenKind::KeywordFn; }
    if *word == WORD_RETURN: { return TokenKind::KeywordReturn; }
    if *word == WORD_TRUE: { return TokenKind::KeywordTrue; }
    if *word == WORD_FALSE: { return TokenKind::KeywordFalse; }
    if *word == WORD_NULL: { return TokenKind::KeywordNull; }
    if *word == WORD_AND: { return TokenKind::KeywordAnd; }
    if *word == WORD_OR: { return TokenKind::KeywordOr; }
    if *word == WORD_NOT: { return TokenKind::KeywordNot; }
    return TokenKind::Identifier;
}

fn is_keyword(word: &const shared string) -> bool: {
    return keyword_kind(word) != TokenKind::Identifier;
}























static PRECEDENCE_ASSIGN: int = 10;
static PRECEDENCE_CONDITIONAL: int = 20;
static PRECEDENCE_LOGICAL_OR: int = 30;
static PRECEDENCE_LOGICAL_AND: int = 40;
static PRECEDENCE_BIT_OR: int = 50;
static PRECEDENCE_BIT_XOR: int = 60;
static PRECEDENCE_BIT_AND: int = 70;
static PRECEDENCE_EQUALITY: int = 80;
static PRECEDENCE_RELATIONAL: int = 90;
static PRECEDENCE_SHIFT: int = 100;
static PRECEDENCE_ADDITIVE: int = 110;
static PRECEDENCE_MULTIPLICATIVE: int = 120;
static PRECEDENCE_POWER: int = 130;
static PRECEDENCE_PREFIX: int = 140;
static PRECEDENCE_POSTFIX: int = 150;
static PRECEDENCE_NONE: int = 0;




struct OperatorRow: {

    fn describe(self: &const shared) -> string: {
        var out = .spelling;
        out.append(" [");
        out.append(to_string(.precedence));
        if .associativity == Associativity::Right: {
            out.append(", right");
        }
        if .associativity == Associativity::Left: {
            out.append(", left");
        }
        out.append("]");
        return out;
    }

    kind: TokenKind = TokenKind::Invalid;
    spelling: string;
    precedence: int = 0;
    associativity: Associativity = Associativity::Left;
    
    
    mutating: bool = false;
}

fn operator_table() -> vector{OperatorRow}: {
    var rows: vector{OperatorRow};
    rows.push_back(OperatorRow(kind: TokenKind::Equal, spelling: "=", precedence: PRECEDENCE_ASSIGN, associativity: Associativity::Right, mutating: true));
    rows.push_back(OperatorRow(kind: TokenKind::PlusEqual, spelling: "+=", precedence: PRECEDENCE_ASSIGN, associativity: Associativity::Right, mutating: true));
    rows.push_back(OperatorRow(kind: TokenKind::MinusEqual, spelling: "-=", precedence: PRECEDENCE_ASSIGN, associativity: Associativity::Right, mutating: true));
    rows.push_back(OperatorRow(kind: TokenKind::StarEqual, spelling: "*=", precedence: PRECEDENCE_ASSIGN, associativity: Associativity::Right, mutating: true));
    rows.push_back(OperatorRow(kind: TokenKind::SlashEqual, spelling: "/=", precedence: PRECEDENCE_ASSIGN, associativity: Associativity::Right, mutating: true));
    rows.push_back(OperatorRow(kind: TokenKind::PercentEqual, spelling: "%=", precedence: PRECEDENCE_ASSIGN, associativity: Associativity::Right, mutating: true));
    rows.push_back(OperatorRow(kind: TokenKind::AmpEqual, spelling: "&=", precedence: PRECEDENCE_ASSIGN, associativity: Associativity::Right, mutating: true));
    rows.push_back(OperatorRow(kind: TokenKind::PipeEqual, spelling: "|=", precedence: PRECEDENCE_ASSIGN, associativity: Associativity::Right, mutating: true));
    rows.push_back(OperatorRow(kind: TokenKind::CaretEqual, spelling: "^=", precedence: PRECEDENCE_ASSIGN, associativity: Associativity::Right, mutating: true));
    rows.push_back(OperatorRow(kind: TokenKind::LessLessEqual, spelling: "<<=", precedence: PRECEDENCE_ASSIGN, associativity: Associativity::Right, mutating: true));
    rows.push_back(OperatorRow(kind: TokenKind::GreaterGreaterEqual, spelling: ">>=", precedence: PRECEDENCE_ASSIGN, associativity: Associativity::Right, mutating: true));
    rows.push_back(OperatorRow(kind: TokenKind::PipePipe, spelling: "||", precedence: PRECEDENCE_LOGICAL_OR, associativity: Associativity::Left));
    rows.push_back(OperatorRow(kind: TokenKind::KeywordOr, spelling: "or", precedence: PRECEDENCE_LOGICAL_OR, associativity: Associativity::Left));
    rows.push_back(OperatorRow(kind: TokenKind::AmpAmp, spelling: "&&", precedence: PRECEDENCE_LOGICAL_AND, associativity: Associativity::Left));
    rows.push_back(OperatorRow(kind: TokenKind::KeywordAnd, spelling: "and", precedence: PRECEDENCE_LOGICAL_AND, associativity: Associativity::Left));
    rows.push_back(OperatorRow(kind: TokenKind::Pipe, spelling: "|", precedence: PRECEDENCE_BIT_OR, associativity: Associativity::Left));
    rows.push_back(OperatorRow(kind: TokenKind::Caret, spelling: "^", precedence: PRECEDENCE_BIT_XOR, associativity: Associativity::Left));
    rows.push_back(OperatorRow(kind: TokenKind::Amp, spelling: "&", precedence: PRECEDENCE_BIT_AND, associativity: Associativity::Left));
    rows.push_back(OperatorRow(kind: TokenKind::EqualEqual, spelling: "==", precedence: PRECEDENCE_EQUALITY, associativity: Associativity::Left));
    rows.push_back(OperatorRow(kind: TokenKind::BangEqual, spelling: "!=", precedence: PRECEDENCE_EQUALITY, associativity: Associativity::Left));
    rows.push_back(OperatorRow(kind: TokenKind::Less, spelling: "<", precedence: PRECEDENCE_RELATIONAL, associativity: Associativity::Left));
    rows.push_back(OperatorRow(kind: TokenKind::LessEqual, spelling: "<=", precedence: PRECEDENCE_RELATIONAL, associativity: Associativity::Left));
    rows.push_back(OperatorRow(kind: TokenKind::Greater, spelling: ">", precedence: PRECEDENCE_RELATIONAL, associativity: Associativity::Left));
    rows.push_back(OperatorRow(kind: TokenKind::GreaterEqual, spelling: ">=", precedence: PRECEDENCE_RELATIONAL, associativity: Associativity::Left));
    rows.push_back(OperatorRow(kind: TokenKind::LessLess, spelling: "<<", precedence: PRECEDENCE_SHIFT, associativity: Associativity::Left));
    rows.push_back(OperatorRow(kind: TokenKind::GreaterGreater, spelling: ">>", precedence: PRECEDENCE_SHIFT, associativity: Associativity::Left));
    rows.push_back(OperatorRow(kind: TokenKind::Plus, spelling: "+", precedence: PRECEDENCE_ADDITIVE, associativity: Associativity::Left));
    rows.push_back(OperatorRow(kind: TokenKind::Minus, spelling: "-", precedence: PRECEDENCE_ADDITIVE, associativity: Associativity::Left));
    rows.push_back(OperatorRow(kind: TokenKind::Star, spelling: "*", precedence: PRECEDENCE_MULTIPLICATIVE, associativity: Associativity::Left));
    rows.push_back(OperatorRow(kind: TokenKind::Slash, spelling: "/", precedence: PRECEDENCE_MULTIPLICATIVE, associativity: Associativity::Left));
    rows.push_back(OperatorRow(kind: TokenKind::Percent, spelling: "%", precedence: PRECEDENCE_MULTIPLICATIVE, associativity: Associativity::Left));
    rows.push_back(OperatorRow(kind: TokenKind::StarStar, spelling: "**", precedence: PRECEDENCE_POWER, associativity: Associativity::Right));
    return rows;
}




fn infix_precedence(kind: TokenKind) -> int: {
    if kind == TokenKind::Equal: { return PRECEDENCE_ASSIGN; }
    if kind == TokenKind::PlusEqual: { return PRECEDENCE_ASSIGN; }
    if kind == TokenKind::MinusEqual: { return PRECEDENCE_ASSIGN; }
    if kind == TokenKind::StarEqual: { return PRECEDENCE_ASSIGN; }
    if kind == TokenKind::SlashEqual: { return PRECEDENCE_ASSIGN; }
    if kind == TokenKind::PercentEqual: { return PRECEDENCE_ASSIGN; }
    if kind == TokenKind::AmpEqual: { return PRECEDENCE_ASSIGN; }
    if kind == TokenKind::PipeEqual: { return PRECEDENCE_ASSIGN; }
    if kind == TokenKind::CaretEqual: { return PRECEDENCE_ASSIGN; }
    if kind == TokenKind::LessLessEqual: { return PRECEDENCE_ASSIGN; }
    if kind == TokenKind::GreaterGreaterEqual: { return PRECEDENCE_ASSIGN; }
    if kind == TokenKind::Question: { return PRECEDENCE_CONDITIONAL; }
    if kind == TokenKind::PipePipe: { return PRECEDENCE_LOGICAL_OR; }
    if kind == TokenKind::KeywordOr: { return PRECEDENCE_LOGICAL_OR; }
    if kind == TokenKind::AmpAmp: { return PRECEDENCE_LOGICAL_AND; }
    if kind == TokenKind::KeywordAnd: { return PRECEDENCE_LOGICAL_AND; }
    if kind == TokenKind::Pipe: { return PRECEDENCE_BIT_OR; }
    if kind == TokenKind::Caret: { return PRECEDENCE_BIT_XOR; }
    if kind == TokenKind::Amp: { return PRECEDENCE_BIT_AND; }
    if kind == TokenKind::EqualEqual: { return PRECEDENCE_EQUALITY; }
    if kind == TokenKind::BangEqual: { return PRECEDENCE_EQUALITY; }
    if kind == TokenKind::Less: { return PRECEDENCE_RELATIONAL; }
    if kind == TokenKind::LessEqual: { return PRECEDENCE_RELATIONAL; }
    if kind == TokenKind::Greater: { return PRECEDENCE_RELATIONAL; }
    if kind == TokenKind::GreaterEqual: { return PRECEDENCE_RELATIONAL; }
    if kind == TokenKind::LessLess: { return PRECEDENCE_SHIFT; }
    if kind == TokenKind::GreaterGreater: { return PRECEDENCE_SHIFT; }
    if kind == TokenKind::Plus: { return PRECEDENCE_ADDITIVE; }
    if kind == TokenKind::Minus: { return PRECEDENCE_ADDITIVE; }
    if kind == TokenKind::Star: { return PRECEDENCE_MULTIPLICATIVE; }
    if kind == TokenKind::Slash: { return PRECEDENCE_MULTIPLICATIVE; }
    if kind == TokenKind::Percent: { return PRECEDENCE_MULTIPLICATIVE; }
    if kind == TokenKind::StarStar: { return PRECEDENCE_POWER; }
    return PRECEDENCE_NONE;
}

fn infix_associativity(kind: TokenKind) -> Associativity: {
    if is_assignment_operator(kind): {
        return Associativity::Right;
    }
    if kind == TokenKind::Question: {
        return Associativity::Right;
    }
    if kind == TokenKind::StarStar: {
        return Associativity::Right;
    }
    if infix_precedence(kind) == PRECEDENCE_NONE: {
        return Associativity::None;
    }
    return Associativity::Left;
}



fn prefix_precedence(kind: TokenKind) -> int: {
    if kind == TokenKind::Minus: { return PRECEDENCE_PREFIX; }
    if kind == TokenKind::Plus: { return PRECEDENCE_PREFIX; }
    if kind == TokenKind::Bang: { return PRECEDENCE_PREFIX; }
    if kind == TokenKind::KeywordNot: { return PRECEDENCE_PREFIX; }
    if kind == TokenKind::Tilde: { return PRECEDENCE_PREFIX; }
    if kind == TokenKind::PlusPlus: { return PRECEDENCE_PREFIX; }
    if kind == TokenKind::MinusMinus: { return PRECEDENCE_PREFIX; }
    return PRECEDENCE_NONE;
}

fn postfix_precedence(kind: TokenKind) -> int: {
    if kind == TokenKind::PlusPlus: { return PRECEDENCE_POSTFIX; }
    if kind == TokenKind::MinusMinus: { return PRECEDENCE_POSTFIX; }
    if kind == TokenKind::Bang: { return PRECEDENCE_POSTFIX; }
    if kind == TokenKind::LParen: { return PRECEDENCE_POSTFIX; }
    if kind == TokenKind::LBracket: { return PRECEDENCE_POSTFIX; }
    if kind == TokenKind::Dot: { return PRECEDENCE_POSTFIX; }
    return PRECEDENCE_NONE;
}

fn is_assignment_operator(kind: TokenKind) -> bool: {
    if kind == TokenKind::Equal: { return true; }
    if kind == TokenKind::PlusEqual: { return true; }
    if kind == TokenKind::MinusEqual: { return true; }
    if kind == TokenKind::StarEqual: { return true; }
    if kind == TokenKind::SlashEqual: { return true; }
    if kind == TokenKind::PercentEqual: { return true; }
    if kind == TokenKind::AmpEqual: { return true; }
    if kind == TokenKind::PipeEqual: { return true; }
    if kind == TokenKind::CaretEqual: { return true; }
    if kind == TokenKind::LessLessEqual: { return true; }
    if kind == TokenKind::GreaterGreaterEqual: { return true; }
    return false;
}



fn compound_base_operator(kind: TokenKind) -> TokenKind: {
    if kind == TokenKind::PlusEqual: { return TokenKind::Plus; }
    if kind == TokenKind::MinusEqual: { return TokenKind::Minus; }
    if kind == TokenKind::StarEqual: { return TokenKind::Star; }
    if kind == TokenKind::SlashEqual: { return TokenKind::Slash; }
    if kind == TokenKind::PercentEqual: { return TokenKind::Percent; }
    if kind == TokenKind::AmpEqual: { return TokenKind::Amp; }
    if kind == TokenKind::PipeEqual: { return TokenKind::Pipe; }
    if kind == TokenKind::CaretEqual: { return TokenKind::Caret; }
    if kind == TokenKind::LessLessEqual: { return TokenKind::LessLess; }
    if kind == TokenKind::GreaterGreaterEqual: { return TokenKind::GreaterGreater; }
    return TokenKind::Invalid;
}


fn is_short_circuit(kind: TokenKind) -> bool: {
    if kind == TokenKind::AmpAmp || kind == TokenKind::KeywordAnd: {
        return true;
    }
    if kind == TokenKind::PipePipe || kind == TokenKind::KeywordOr: {
        return true;
    }
    return false;
}

fn is_comparison(kind: TokenKind) -> bool: {
    let power = infix_precedence(kind);
    if power == PRECEDENCE_EQUALITY: {
        return true;
    }
    return power == PRECEDENCE_RELATIONAL;
}

fn is_arithmetic(kind: TokenKind) -> bool: {
    let power = infix_precedence(kind);
    if power == PRECEDENCE_ADDITIVE: {
        return true;
    }
    if power == PRECEDENCE_MULTIPLICATIVE: {
        return true;
    }
    return power == PRECEDENCE_POWER;
}

fn is_bitwise(kind: TokenKind) -> bool: {
    let power = infix_precedence(kind);
    if power == PRECEDENCE_BIT_OR || power == PRECEDENCE_BIT_XOR: {
        return true;
    }
    if power == PRECEDENCE_BIT_AND: {
        return true;
    }
    return power == PRECEDENCE_SHIFT;
}






struct Tokenizer: {

    fn at_end(self: &const shared) -> bool: {
        return .cursor.offset >= .source.size();
    }

    fn remaining(self: &const shared) -> int: {
        return .source.size() - .cursor.offset;
    }

    fn peek(self: &const shared) -> char: {
        if .at_end(): {
            return CHAR_NUL;
        }
        return .source.at(.cursor.offset);
    }

    fn peek_at(self: &const shared, ahead: int) -> char: {
        let index = .cursor.offset + ahead;
        if index >= .source.size(): {
            return CHAR_NUL;
        }
        return .source.at(index);
    }

    fn advance(self: &unique) -> char: {
        let c = .peek();
        .cursor.advance_over(c);
        return c;
    }

    
    
    fn eat(self: &unique, c: char) -> bool: {
        if .peek() == c: {
            discard .advance();
            return true;
        }
        return false;
    }

    fn fail(self: &unique, code: ErrorCode, detail: &const shared string) -> Token: {
        if .problem.ok(): {
            .problem.code = code;
            .problem.where = .cursor;
            .problem.detail = *detail;
        }
        var bad = Token(kind: TokenKind::Invalid, text: *detail);
        bad.span.begin = .cursor;
        bad.span.end = .cursor;
        return bad;
    }

    fn make(self: &const shared, kind: TokenKind, begin: &const shared Position) -> Token: {
        var out = Token(kind: kind);
        out.span.begin = *begin;
        out.span.end = .cursor;
        out.text = .source.substr(begin.offset, .cursor.offset - begin.offset);
        return out;
    }

    

    
    
    
    fn skip_trivia(self: &unique): {
        loop: {
            while !.at_end() && is_space(.peek()): {
                discard .advance();
            }
            if .at_line_comment(): {
                .skip_line_comment();
            } else: {
                if .at_block_comment(): {
                    .skip_block_comment();
                } else: {
                    break;
                }
            }
        }
    }

    fn at_line_comment(self: &const shared) -> bool: {
        if .peek() != CHAR_SLASH: {
            return false;
        }
        return .peek_at(1) == CHAR_SLASH;
    }

    fn at_block_comment(self: &const shared) -> bool: {
        if .peek() != CHAR_SLASH: {
            return false;
        }
        return .peek_at(1) == CHAR_STAR;
    }

    fn skip_line_comment(self: &unique): {
        discard .advance();
        discard .advance();
        while !.at_end() && .peek() != CHAR_NEWLINE: {
            discard .advance();
        }
    }

    
    
    fn skip_block_comment(self: &unique): {
        discard .advance();
        discard .advance();
        var depth: int = 1;
        while depth > 0: {
            if .at_end(): {
                .problem.code = ErrorCode::UnterminatedComment;
                .problem.where = .cursor;
                return;
            }
            if .at_block_comment(): {
                discard .advance();
                discard .advance();
                depth += 1;
            } else: {
                if .peek() == CHAR_STAR && .peek_at(1) == CHAR_SLASH: {
                    discard .advance();
                    discard .advance();
                    depth -= 1;
                } else: {
                    discard .advance();
                }
            }
        }
    }

    fn scan_comment(self: &unique) -> Token: {
        let begin = .cursor;
        if .at_line_comment(): {
            .skip_line_comment();
        } else: {
            .skip_block_comment();
        }
        return .make(TokenKind::Comment, begin);
    }

    

    fn scan_identifier(self: &unique) -> Token: {
        let begin = .cursor;
        discard .advance();
        while !.at_end() && is_identifier_body(.peek()): {
            discard .advance();
        }
        var word = .make(TokenKind::Identifier, begin);
        word.kind = keyword_kind(word.text);
        return word;
    }

    
    
    
    
    
    
    
    
    
    fn scan_number(self: &unique) -> Token: {
        let begin = .cursor;
        var mantissa: int = 0;
        var exponent: int = 0;
        var digits: int = 0;
        var seen_any = false;

        while !.at_end() && is_digit(.peek()): {
            let d = digit_value(.advance());
            seen_any = true;
            if digits < MAX_DIGITS: {
                mantissa = mantissa * NUMBER_BASE + d;
                if mantissa != 0: {
                    digits += 1;
                }
            } else: {
                exponent += 1;
            }
        }

        if .peek() == CHAR_DOT && is_digit(.peek_at(1)): {
            discard .advance();
            while !.at_end() && is_digit(.peek()): {
                let d = digit_value(.advance());
                seen_any = true;
                if digits < MAX_DIGITS: {
                    mantissa = mantissa * NUMBER_BASE + d;
                    exponent -= 1;
                    digits += 1;
                }
            }
        }

        if !seen_any: {
            return .fail(ErrorCode::UnexpectedCharacter, "expected at least one digit");
        }

        if .peek() == 'e' || .peek() == 'E': {
            let saved = .cursor;
            discard .advance();
            var sign: int = 1;
            if .eat(CHAR_MINUS): {
                sign = -1;
            } else: {
                discard .eat(CHAR_PLUS);
            }
            if is_digit(.peek()): {
                var written: int = 0;
                while !.at_end() && is_digit(.peek()): {
                    written = written * NUMBER_BASE + digit_value(.advance());
                    if written > MAX_EXPONENT * NUMBER_BASE: {
                        return .fail(ErrorCode::ExponentRange, "exponent is too large");
                    }
                }
                exponent += sign * written;
            } else: {
                
                .cursor = saved;
            }
        }

        if exponent > MAX_EXPONENT || exponent < MIN_EXPONENT: {
            return .fail(ErrorCode::ExponentRange, "decimal exponent leaves the supported range");
        }

        var number = .make(TokenKind::Number, begin);
        number.mantissa = mantissa;
        number.exponent = exponent;
        return number;
    }

    

    fn scan_text(self: &unique) -> Token: {
        let begin = .cursor;
        discard .advance();
        var decoded: string = "";
        loop: {
            if .at_end(): {
                return .fail(ErrorCode::UnterminatedText, "reached end of input inside a string");
            }
            let c = .advance();
            if c == CHAR_QUOTE: {
                break;
            }
            if c != CHAR_BACKSLASH: {
                decoded.push_back(c);
            } else: {
                if .at_end(): {
                    return .fail(ErrorCode::UnterminatedText, "trailing backslash");
                }
                let marker = .advance();
                let plain = decode_escape(marker);
                if plain != CHAR_NUL: {
                    decoded.push_back(plain);
                } else: {
                    var detail: string = "unknown escape marker ";
                    detail.push_back(marker);
                    return .fail(ErrorCode::BadEscape, detail);
                }
            }
        }
        var out = .make(TokenKind::Text, begin);
        out.text = decoded;
        return out;
    }

    
    
    
    
    
    fn scan_operator(self: &unique) -> Token: {
        let begin = .cursor;
        let c = .advance();

        if c == CHAR_PLUS: {
            if .eat(CHAR_EQUAL): { return .make(TokenKind::PlusEqual, begin); }
            if .eat(CHAR_PLUS): { return .make(TokenKind::PlusPlus, begin); }
            return .make(TokenKind::Plus, begin);
        }
        if c == CHAR_MINUS: {
            if .eat(CHAR_EQUAL): { return .make(TokenKind::MinusEqual, begin); }
            if .eat(CHAR_MINUS): { return .make(TokenKind::MinusMinus, begin); }
            if .eat(CHAR_GREATER): { return .make(TokenKind::Arrow, begin); }
            return .make(TokenKind::Minus, begin);
        }
        if c == CHAR_STAR: {
            if .eat(CHAR_STAR): { return .make(TokenKind::StarStar, begin); }
            if .eat(CHAR_EQUAL): { return .make(TokenKind::StarEqual, begin); }
            return .make(TokenKind::Star, begin);
        }
        if c == CHAR_SLASH: {
            if .eat(CHAR_EQUAL): { return .make(TokenKind::SlashEqual, begin); }
            return .make(TokenKind::Slash, begin);
        }
        if c == CHAR_PERCENT: {
            if .eat(CHAR_EQUAL): { return .make(TokenKind::PercentEqual, begin); }
            return .make(TokenKind::Percent, begin);
        }
        if c == CHAR_AMP: {
            if .eat(CHAR_AMP): { return .make(TokenKind::AmpAmp, begin); }
            if .eat(CHAR_EQUAL): { return .make(TokenKind::AmpEqual, begin); }
            return .make(TokenKind::Amp, begin);
        }
        if c == CHAR_PIPE: {
            if .eat(CHAR_PIPE): { return .make(TokenKind::PipePipe, begin); }
            if .eat(CHAR_EQUAL): { return .make(TokenKind::PipeEqual, begin); }
            return .make(TokenKind::Pipe, begin);
        }
        if c == CHAR_CARET: {
            if .eat(CHAR_EQUAL): { return .make(TokenKind::CaretEqual, begin); }
            return .make(TokenKind::Caret, begin);
        }
        if c == CHAR_TILDE: {
            return .make(TokenKind::Tilde, begin);
        }
        if c == CHAR_BANG: {
            if .eat(CHAR_EQUAL): { return .make(TokenKind::BangEqual, begin); }
            return .make(TokenKind::Bang, begin);
        }
        if c == CHAR_LESS: {
            if .eat(CHAR_LESS): {
                if .eat(CHAR_EQUAL): { return .make(TokenKind::LessLessEqual, begin); }
                return .make(TokenKind::LessLess, begin);
            }
            if .eat(CHAR_EQUAL): { return .make(TokenKind::LessEqual, begin); }
            return .make(TokenKind::Less, begin);
        }
        if c == CHAR_GREATER: {
            if .eat(CHAR_GREATER): {
                if .eat(CHAR_EQUAL): { return .make(TokenKind::GreaterGreaterEqual, begin); }
                return .make(TokenKind::GreaterGreater, begin);
            }
            if .eat(CHAR_EQUAL): { return .make(TokenKind::GreaterEqual, begin); }
            return .make(TokenKind::Greater, begin);
        }
        if c == CHAR_EQUAL: {
            if .eat(CHAR_EQUAL): { return .make(TokenKind::EqualEqual, begin); }
            return .make(TokenKind::Equal, begin);
        }
        if c == CHAR_QUESTION: {
            return .make(TokenKind::Question, begin);
        }
        if c == CHAR_COLON: {
            return .make(TokenKind::Colon, begin);
        }
        if c == CHAR_COMMA: {
            return .make(TokenKind::Comma, begin);
        }
        if c == CHAR_SEMICOLON: {
            return .make(TokenKind::Semicolon, begin);
        }
        if c == CHAR_DOT: {
            return .make(TokenKind::Dot, begin);
        }
        if c == CHAR_LPAREN: { return .make(TokenKind::LParen, begin); }
        if c == CHAR_RPAREN: { return .make(TokenKind::RParen, begin); }
        if c == CHAR_LBRACKET: { return .make(TokenKind::LBracket, begin); }
        if c == CHAR_RBRACKET: { return .make(TokenKind::RBracket, begin); }
        if c == CHAR_LBRACE: { return .make(TokenKind::LBrace, begin); }
        if c == CHAR_RBRACE: { return .make(TokenKind::RBrace, begin); }

        var detail: string = "stray byte ";
        detail.append(to_string(int(c)));
        return .fail(ErrorCode::UnexpectedCharacter, detail);
    }

    

    fn next_token(self: &unique) -> Token: {
        if .keep_comments: {
            while !.at_end() && is_space(.peek()): {
                discard .advance();
            }
            if .at_line_comment() || .at_block_comment(): {
                return .scan_comment();
            }
        } else: {
            .skip_trivia();
        }

        let begin = .cursor;
        if .at_end(): {
            var done = Token(kind: TokenKind::End);
            done.span.begin = begin;
            done.span.end = begin;
            return done;
        }

        let c = .peek();
        if is_identifier_start(c): {
            return .scan_identifier();
        }
        if is_digit(c): {
            return .scan_number();
        }
        if c == CHAR_DOT && is_digit(.peek_at(1)): {
            return .scan_number();
        }
        if c == CHAR_QUOTE: {
            return .scan_text();
        }
        if is_operator_start(c): {
            return .scan_operator();
        }

        discard .advance();
        var detail: string = "character ";
        detail.push_back(c);
        return .fail(ErrorCode::UnexpectedCharacter, detail);
    }

    source: string;
    cursor: Position;
    problem: Diagnostic;
    keep_comments: bool = false;
}




fn decode_escape(marker: char) -> char: {
    if marker == 'n': { return CHAR_NEWLINE; }
    if marker == 't': { return CHAR_TAB; }
    if marker == 'r': { return CHAR_RETURN; }
    if marker == CHAR_QUOTE: { return CHAR_QUOTE; }
    if marker == CHAR_BACKSLASH: { return CHAR_BACKSLASH; }
    if marker == '0': { return CHAR_SPACE; }
    if marker == 'e': { return CHAR_SPACE; }
    return CHAR_NUL;
}

fn encode_escape(c: char) -> string: {
    if c == CHAR_QUOTE: { return "\\\""; }
    if c == CHAR_BACKSLASH: { return "\\\\"; }
    if c == CHAR_NEWLINE: { return "\\n"; }
    if c == CHAR_TAB: { return "\\t"; }
    if c == CHAR_RETURN: { return "\\r"; }
    return TEXT_EMPTY;
}



fn tokenize(source: &const shared string) -> vector{Token}: {
    var scanner = Tokenizer(source: *source);
    var out: vector{Token};
    loop: {
        let token = scanner.next_token();
        out.push_back(token);
        if token.kind == TokenKind::End: {
            break;
        }
        if token.kind == TokenKind::Invalid: {
            break;
        }
    }
    return out;
}










static NO_NODE: int = 0;

struct Node: {

    fn is_literal(self: &const shared) -> bool: {
        if .kind == NodeKind::NumberLiteral: { return true; }
        if .kind == NodeKind::TextLiteral: { return true; }
        if .kind == NodeKind::BoolLiteral: { return true; }
        if .kind == NodeKind::NullLiteral: { return true; }
        return false;
    }

    fn is_leaf(self: &const shared) -> bool: {
        if .is_literal(): {
            return true;
        }
        if .kind == NodeKind::Variable: { return true; }
        if .kind == NodeKind::Empty: { return true; }
        return false;
    }

    
    fn is_assignable(self: &const shared) -> bool: {
        if .kind == NodeKind::Variable: { return true; }
        if .kind == NodeKind::Index: { return true; }
        if .kind == NodeKind::Member: { return true; }
        return false;
    }

    fn child_count(self: &const shared) -> int: {
        var total: int = 0;
        if .lhs != NO_NODE: { total += 1; }
        if .rhs != NO_NODE: { total += 1; }
        if .extra != NO_NODE: { total += 1; }
        return total + .parts.size();
    }

    fn kind_name(self: &const shared) -> string: {
        return node_kind_name(.kind);
    }

    kind: NodeKind = NodeKind::Invalid;
    
    op: TokenKind = TokenKind::Invalid;
    
    
    lhs: int = 0;
    rhs: int = 0;
    extra: int = 0;
    
    parts: vector{int};
    
    mantissa: int = 0;
    exponent: int = 0;
    text: string;
    flag: bool = false;
    span: Span;
}

fn node_kind_name(kind: NodeKind) -> string: {
    if kind == NodeKind::Invalid: { return "invalid"; }
    if kind == NodeKind::NumberLiteral: { return "number"; }
    if kind == NodeKind::TextLiteral: { return "string"; }
    if kind == NodeKind::BoolLiteral: { return "bool"; }
    if kind == NodeKind::NullLiteral: { return "null"; }
    if kind == NodeKind::Variable: { return "variable"; }
    if kind == NodeKind::Unary: { return "unary"; }
    if kind == NodeKind::Binary: { return "binary"; }
    if kind == NodeKind::Postfix: { return "postfix"; }
    if kind == NodeKind::Assign: { return "assign"; }
    if kind == NodeKind::Call: { return "call"; }
    if kind == NodeKind::Index: { return "index"; }
    if kind == NodeKind::Member: { return "member"; }
    if kind == NodeKind::Conditional: { return "conditional"; }
    if kind == NodeKind::Let: { return "let"; }
    if kind == NodeKind::Block: { return "block"; }
    if kind == NodeKind::Loop: { return "loop"; }
    if kind == NodeKind::Return: { return "return"; }
    if kind == NodeKind::Empty: { return "empty"; }
    return "unknown";
}



struct Arena: {

    fn size(self: &const shared) -> int: {
        return .nodes.size();
    }

    fn valid(self: &const shared, index: int) -> bool: {
        if index <= NO_NODE: {
            return false;
        }
        return index < .nodes.size();
    }

    fn at(self: &shared, index: int) -> &shared[self] Node: {
        assert index >= 0;
        if !.valid(index): {
            return .nodes[0];
        }
        return .nodes[index];
    }

    fn kind_of(self: &const shared, index: int) -> NodeKind: {
        if !.valid(index): {
            return NodeKind::Invalid;
        }
        return .nodes[index].kind;
    }

    fn operator_of(self: &const shared, index: int) -> TokenKind: {
        if !.valid(index): {
            return TokenKind::Invalid;
        }
        return .nodes[index].op;
    }

    fn add(self: &unique, node: Node) -> int: {
        .nodes.push_back(move(node));
        return .nodes.size() - 1;
    }

    fn add_number(self: &unique, mantissa: int, exponent: int) -> int: {
        return .add(Node(kind: NodeKind::NumberLiteral, mantissa: mantissa, exponent: exponent));
    }

    fn add_text(self: &unique, text: &const shared string) -> int: {
        return .add(Node(kind: NodeKind::TextLiteral, text: *text));
    }

    fn add_bool(self: &unique, value: bool) -> int: {
        return .add(Node(kind: NodeKind::BoolLiteral, flag: value));
    }

    fn add_null(self: &unique) -> int: {
        return .add(Node(kind: NodeKind::NullLiteral));
    }

    fn add_variable(self: &unique, name: &const shared string) -> int: {
        return .add(Node(kind: NodeKind::Variable, text: *name));
    }

    fn add_unary(self: &unique, op: TokenKind, operand: int) -> int: {
        return .add(Node(kind: NodeKind::Unary, op: op, lhs: operand));
    }

    fn add_binary(self: &unique, op: TokenKind, left: int, right: int) -> int: {
        return .add(Node(kind: NodeKind::Binary, op: op, lhs: left, rhs: right));
    }

    fn add_conditional(self: &unique, condition: int, whenever: int, otherwise: int) -> int: {
        return .add(Node(kind: NodeKind::Conditional, lhs: condition, rhs: whenever, extra: otherwise));
    }

    
    
    fn replace(self: &unique, index: int, node: Node): {
        if !.valid(index): {
            return;
        }
        let slot: &unique = .nodes[index];
        slot.kind = node.kind;
        slot.op = node.op;
        slot.lhs = node.lhs;
        slot.rhs = node.rhs;
        slot.extra = node.extra;
        slot.mantissa = node.mantissa;
        slot.exponent = node.exponent;
        slot.text = node.text;
        slot.flag = node.flag;
    }

    fn replace_with_number(self: &unique, index: int, mantissa: int, exponent: int): {
        if !.valid(index): {
            return;
        }
        let slot: &unique = .nodes[index];
        slot.kind = NodeKind::NumberLiteral;
        slot.op = TokenKind::Invalid;
        slot.lhs = NO_NODE;
        slot.rhs = NO_NODE;
        slot.extra = NO_NODE;
        slot.mantissa = mantissa;
        slot.exponent = exponent;
        slot.parts.clear();
    }

    fn replace_with_bool(self: &unique, index: int, value: bool): {
        if !.valid(index): {
            return;
        }
        let slot: &unique = .nodes[index];
        slot.kind = NodeKind::BoolLiteral;
        slot.op = TokenKind::Invalid;
        slot.lhs = NO_NODE;
        slot.rhs = NO_NODE;
        slot.extra = NO_NODE;
        slot.flag = value;
        slot.parts.clear();
    }

    
    
    
    fn adopt(self: &unique, index: int) -> int: {
        if !.valid(index): {
            return NO_NODE;
        }
        var copy = Node(kind: .nodes[index].kind, op: .nodes[index].op);
        copy.mantissa = .nodes[index].mantissa;
        copy.exponent = .nodes[index].exponent;
        copy.text = .nodes[index].text;
        copy.flag = .nodes[index].flag;
        copy.lhs = .nodes[index].lhs;
        copy.rhs = .nodes[index].rhs;
        copy.extra = .nodes[index].extra;
        for child in .nodes[index].parts: {
            copy.parts.push_back(child);
        }
        return .add(move(copy));
    }

    fn clear(self: &unique): {
        .nodes.clear();
        .nodes.push_back(Node(kind: NodeKind::Invalid));
    }

    nodes: vector{Node};
}

fn make_arena() -> Arena: {
    var arena: Arena;
    arena.clear();
    return arena;
}









struct Parser: {

    

    fn peek(self: &const shared) -> &const shared[self] Token: {
        return .lookahead;
    }

    fn peek_kind(self: &const shared) -> TokenKind: {
        return .lookahead.kind;
    }

    fn at(self: &const shared, kind: TokenKind) -> bool: {
        return .lookahead.kind == kind;
    }

    fn at_end(self: &const shared) -> bool: {
        return .lookahead.kind == TokenKind::End;
    }

    fn advance(self: &unique) -> Token: {
        var previous = .lookahead;
        .lookahead = .scanner.next_token();
        if .lookahead.kind == TokenKind::Invalid: {
            .adopt_scanner_error();
        }
        return previous;
    }

    fn eat(self: &unique, kind: TokenKind) -> bool: {
        if .at(kind): {
            discard .advance();
            return true;
        }
        return false;
    }

    fn expect(self: &unique, kind: TokenKind) -> bool: {
        if .eat(kind): {
            return true;
        }
        var detail: string = "expected ";
        detail.append(token_name(kind));
        detail.append(", found ");
        detail.append(token_name(.lookahead.kind));
        .report(ErrorCode::ExpectedToken, detail);
        return false;
    }

    fn adopt_scanner_error(self: &unique): {
        if .problem.ok(): {
            .problem = .scanner.problem;
        }
    }

    fn report(self: &unique, code: ErrorCode, detail: &const shared string): {
        if .problem.ok(): {
            .problem.code = code;
            .problem.where = .lookahead.span.begin;
            .problem.detail = *detail;
        }
    }

    fn failed(self: &const shared) -> bool: {
        return !.problem.ok();
    }

    
    
    fn recover(self: &unique): {
        while !.at_end(): {
            if .at(TokenKind::Semicolon): {
                discard .advance();
                return;
            }
            if .at(TokenKind::RBrace): {
                return;
            }
            discard .advance();
        }
    }

    

    fn enter(self: &unique) -> bool: {
        .depth += 1;
        if .depth > MAX_DEPTH: {
            .report(ErrorCode::DepthExceeded, "nesting limit reached");
            return false;
        }
        return true;
    }

    fn leave(self: &unique): {
        .depth -= 1;
    }

    

    fn start(self: &unique, source: &const shared string): {
        .scanner = Tokenizer(source: *source);
        .tree.clear();
        .problem = Diagnostic();
        .depth = 0;
        .lookahead = .scanner.next_token();
    }

    
    fn parse_program(self: &unique, source: &const shared string) -> int: {
        .start(source);
        var block = Node(kind: NodeKind::Block);
        block.span.begin = .lookahead.span.begin;
        while !.at_end() && !.failed(): {
            let statement = .parse_statement();
            if statement != NO_NODE: {
                block.parts.push_back(statement);
            } else: {
                .recover();
            }
        }
        block.span.end = .lookahead.span.end;
        return .tree.add(move(block));
    }

    
    
    fn parse_source(self: &unique, source: &const shared string) -> int: {
        .start(source);
        let root = .parse_expression(PRECEDENCE_NONE);
        if !.at_end() && !.failed(): {
            .report(ErrorCode::ExpectedToken, "trailing content after the expression");
        }
        return root;
    }

    

    fn parse_statement(self: &unique) -> int: {
        if .at(TokenKind::Semicolon): {
            discard .advance();
            return .tree.add(Node(kind: NodeKind::Empty));
        }
        if .at(TokenKind::KeywordLet): {
            return .parse_let();
        }
        if .at(TokenKind::KeywordWhile): {
            return .parse_loop();
        }
        if .at(TokenKind::KeywordReturn): {
            return .parse_return();
        }
        if .at(TokenKind::LBrace): {
            return .parse_block();
        }
        let value = .parse_expression(PRECEDENCE_NONE);
        discard .eat(TokenKind::Semicolon);
        return value;
    }

    
    fn parse_let(self: &unique) -> int: {
        let keyword = .advance();
        if !.at(TokenKind::Identifier): {
            .report(ErrorCode::ExpectedIdentifier, "a binding needs a name");
            return NO_NODE;
        }
        let name = .advance();
        var binding = Node(kind: NodeKind::Let, text: name.text);
        binding.span.begin = keyword.span.begin;
        if .eat(TokenKind::Equal): {
            binding.lhs = .parse_expression(PRECEDENCE_NONE);
        } else: {
            binding.lhs = .tree.add_null();
        }
        discard .eat(TokenKind::Semicolon);
        binding.span.end = .lookahead.span.begin;
        return .tree.add(move(binding));
    }

    
    fn parse_loop(self: &unique) -> int: {
        let keyword = .advance();
        var node = Node(kind: NodeKind::Loop);
        node.span.begin = keyword.span.begin;
        node.lhs = .parse_expression(PRECEDENCE_NONE);
        if .at(TokenKind::LBrace): {
            node.rhs = .parse_block();
        } else: {
            node.rhs = .parse_statement();
        }
        node.span.end = .lookahead.span.begin;
        return .tree.add(move(node));
    }

    fn parse_return(self: &unique) -> int: {
        let keyword = .advance();
        var node = Node(kind: NodeKind::Return);
        node.span.begin = keyword.span.begin;
        if .at(TokenKind::Semicolon): {
            node.lhs = .tree.add_null();
        } else: {
            node.lhs = .parse_expression(PRECEDENCE_NONE);
        }
        discard .eat(TokenKind::Semicolon);
        return .tree.add(move(node));
    }

    
    fn parse_block(self: &unique) -> int: {
        if !.enter(): {
            return NO_NODE;
        }
        let open = .advance();
        var block = Node(kind: NodeKind::Block);
        block.span.begin = open.span.begin;
        while !.at(TokenKind::RBrace) && !.at_end() && !.failed(): {
            let statement = .parse_statement();
            if statement == NO_NODE: {
                .recover();
            } else: {
                block.parts.push_back(statement);
            }
        }
        if !.expect(TokenKind::RBrace): {
            .leave();
            return NO_NODE;
        }
        block.span.end = .lookahead.span.begin;
        .leave();
        return .tree.add(move(block));
    }

    
    
    
    
    fn parse_expression(self: &unique, minimum: int) -> int: {
        if !.enter(): {
            return NO_NODE;
        }
        var left = .parse_prefix();
        if left == NO_NODE: {
            .leave();
            return NO_NODE;
        }

        loop: {
            if .failed(): {
                break;
            }
            let kind = .peek_kind();

            
            
            let postfix = postfix_precedence(kind);
            if postfix != PRECEDENCE_NONE && postfix >= minimum: {
                let extended = .parse_postfix(left);
                if extended == NO_NODE: {
                    break;
                }
                if extended != left: {
                    left = extended;
                    continue;
                }
            }

            let power = infix_precedence(kind);
            if power == PRECEDENCE_NONE: {
                break;
            }
            if power < minimum: {
                break;
            }

            left = .parse_infix(left, power);
            if left == NO_NODE: {
                break;
            }
        }

        .leave();
        return left;
    }

    
    
    
    fn parse_prefix(self: &unique) -> int: {
        let kind = .peek_kind();

        if kind == TokenKind::Number: {
            let token = .advance();
            var literal = Node(kind: NodeKind::NumberLiteral);
            literal.mantissa = token.mantissa;
            literal.exponent = token.exponent;
            literal.text = token.text;
            literal.span = token.span;
            return .tree.add(move(literal));
        }
        if kind == TokenKind::Text: {
            let token = .advance();
            var literal = Node(kind: NodeKind::TextLiteral, text: token.text);
            literal.span = token.span;
            return .tree.add(move(literal));
        }
        if kind == TokenKind::KeywordTrue: {
            let token = .advance();
            var literal = Node(kind: NodeKind::BoolLiteral, flag: true);
            literal.span = token.span;
            return .tree.add(move(literal));
        }
        if kind == TokenKind::KeywordFalse: {
            let token = .advance();
            var literal = Node(kind: NodeKind::BoolLiteral, flag: false);
            literal.span = token.span;
            return .tree.add(move(literal));
        }
        if kind == TokenKind::KeywordNull: {
            let token = .advance();
            var literal = Node(kind: NodeKind::NullLiteral);
            literal.span = token.span;
            return .tree.add(move(literal));
        }
        if kind == TokenKind::Identifier: {
            let token = .advance();
            var name = Node(kind: NodeKind::Variable, text: token.text);
            name.span = token.span;
            return .tree.add(move(name));
        }
        if kind == TokenKind::LParen: {
            return .parse_group();
        }
        if kind == TokenKind::LBracket: {
            return .parse_list();
        }
        if kind == TokenKind::KeywordIf: {
            return .parse_if();
        }
        if prefix_precedence(kind) != PRECEDENCE_NONE: {
            return .parse_unary();
        }

        var detail: string = "found ";
        detail.append(token_name(kind));
        detail.append(" where an operand was required");
        .report(ErrorCode::ExpectedExpression, detail);
        return NO_NODE;
    }

    fn parse_unary(self: &unique) -> int: {
        let token = .advance();
        var node = Node(kind: NodeKind::Unary, op: token.kind);
        node.span.begin = token.span.begin;
        node.lhs = .parse_expression(prefix_precedence(token.kind));
        if node.lhs == NO_NODE: {
            return NO_NODE;
        }
        node.span.end = .lookahead.span.begin;
        return .tree.add(move(node));
    }

    
    
    
    fn parse_group(self: &unique) -> int: {
        discard .advance();
        let inner = .parse_expression(PRECEDENCE_NONE);
        if inner == NO_NODE: {
            return NO_NODE;
        }
        if !.at(TokenKind::RParen): {
            .report(ErrorCode::UnbalancedParen, "the group opened earlier is never closed");
            return NO_NODE;
        }
        discard .advance();
        return inner;
    }

    
    
    fn parse_list(self: &unique) -> int: {
        let open = .advance();
        var call = Node(kind: NodeKind::Call);
        call.span.begin = open.span.begin;
        call.lhs = .tree.add_variable("list");
        if !.at(TokenKind::RBracket): {
            loop: {
                let element = .parse_expression(PRECEDENCE_ASSIGN);
                if element == NO_NODE: {
                    return NO_NODE;
                }
                call.parts.push_back(element);
                if !.eat(TokenKind::Comma): {
                    break;
                }
                if .at(TokenKind::RBracket): {
                    break;
                }
            }
        }
        if !.expect(TokenKind::RBracket): {
            return NO_NODE;
        }
        call.span.end = .lookahead.span.begin;
        return .tree.add(move(call));
    }

    
    
    fn parse_if(self: &unique) -> int: {
        let keyword = .advance();
        var node = Node(kind: NodeKind::Conditional);
        node.span.begin = keyword.span.begin;
        node.lhs = .parse_expression(PRECEDENCE_CONDITIONAL);
        if node.lhs == NO_NODE: {
            return NO_NODE;
        }
        if !.expect(TokenKind::KeywordThen): {
            return NO_NODE;
        }
        node.rhs = .parse_expression(PRECEDENCE_CONDITIONAL);
        if node.rhs == NO_NODE: {
            return NO_NODE;
        }
        if .eat(TokenKind::KeywordElse): {
            node.extra = .parse_expression(PRECEDENCE_CONDITIONAL);
            if node.extra == NO_NODE: {
                return NO_NODE;
            }
        } else: {
            node.extra = .tree.add_null();
        }
        node.span.end = .lookahead.span.begin;
        return .tree.add(move(node));
    }

    

    fn parse_infix(self: &unique, left: int, power: int) -> int: {
        let token = .advance();
        let kind = token.kind;

        if kind == TokenKind::Question: {
            return .parse_conditional_tail(left);
        }
        if is_assignment_operator(kind): {
            return .parse_assignment_tail(left, kind);
        }

        var next_power = power + 1;
        if infix_associativity(kind) == Associativity::Right: {
            next_power = power;
        }

        let right = .parse_expression(next_power);
        if right == NO_NODE: {
            return NO_NODE;
        }
        var node = Node(kind: NodeKind::Binary, op: kind, lhs: left, rhs: right);
        node.span.begin = .tree.at(left).span.begin;
        node.span.end = .tree.at(right).span.end;
        return .tree.add(move(node));
    }

    
    
    fn parse_conditional_tail(self: &unique, condition: int) -> int: {
        var node = Node(kind: NodeKind::Conditional, lhs: condition);
        node.span.begin = .tree.at(condition).span.begin;
        node.rhs = .parse_expression(PRECEDENCE_NONE);
        if node.rhs == NO_NODE: {
            return NO_NODE;
        }
        if !.expect(TokenKind::Colon): {
            return NO_NODE;
        }
        node.extra = .parse_expression(PRECEDENCE_CONDITIONAL);
        if node.extra == NO_NODE: {
            return NO_NODE;
        }
        node.flag = true;
        node.span.end = .lookahead.span.begin;
        return .tree.add(move(node));
    }

    fn parse_assignment_tail(self: &unique, target: int, op: TokenKind) -> int: {
        if !.tree.at(target).is_assignable(): {
            var detail: string = "cannot assign to a ";
            detail.append(node_kind_name(.tree.kind_of(target)));
            detail.append(" expression");
            .report(ErrorCode::NotAssignable, detail);
            return NO_NODE;
        }
        let value = .parse_expression(PRECEDENCE_ASSIGN);
        if value == NO_NODE: {
            return NO_NODE;
        }
        var node = Node(kind: NodeKind::Assign, op: op, lhs: target, rhs: value);
        node.span.begin = .tree.at(target).span.begin;
        node.span.end = .tree.at(value).span.end;
        return .tree.add(move(node));
    }

    
    
    
    
    fn parse_postfix(self: &unique, left: int) -> int: {
        let kind = .peek_kind();
        if kind == TokenKind::LParen: {
            return .parse_call(left);
        }
        if kind == TokenKind::LBracket: {
            return .parse_index(left);
        }
        if kind == TokenKind::Dot: {
            return .parse_member(left);
        }
        if kind == TokenKind::PlusPlus || kind == TokenKind::MinusMinus: {
            let token = .advance();
            var node = Node(kind: NodeKind::Postfix, op: token.kind, lhs: left);
            node.span.begin = .tree.at(left).span.begin;
            node.span.end = token.span.end;
            return .tree.add(move(node));
        }
        if kind == TokenKind::Bang: {
            
            
            if .tree.kind_of(left) == NodeKind::NumberLiteral || .tree.kind_of(left) == NodeKind::Variable: {
                let token = .advance();
                var node = Node(kind: NodeKind::Postfix, op: token.kind, lhs: left);
                node.span.begin = .tree.at(left).span.begin;
                node.span.end = token.span.end;
                return .tree.add(move(node));
            }
        }
        return left;
    }

    
    fn parse_call(self: &unique, callee: int) -> int: {
        let open = .advance();
        var node = Node(kind: NodeKind::Call, lhs: callee);
        node.span.begin = .tree.at(callee).span.begin;
        if !.at(TokenKind::RParen): {
            loop: {
                if node.parts.size() >= MAX_ARGUMENTS: {
                    .report(ErrorCode::TooManyArguments, "argument limit reached");
                    return NO_NODE;
                }
                let argument = .parse_argument();
                if argument == NO_NODE: {
                    return NO_NODE;
                }
                node.parts.push_back(argument);
                if !.eat(TokenKind::Comma): {
                    break;
                }
            }
        }
        if !.expect(TokenKind::RParen): {
            return NO_NODE;
        }
        node.span.end = .lookahead.span.begin;
        discard open;
        return .tree.add(move(node));
    }

    
    
    
    fn parse_argument(self: &unique) -> int: {
        if .at(TokenKind::Identifier): {
            let saved = .lookahead;
            let name = .advance();
            if .eat(TokenKind::Colon): {
                var labelled = Node(kind: NodeKind::Let, text: name.text, flag: true);
                labelled.span.begin = name.span.begin;
                labelled.lhs = .parse_expression(PRECEDENCE_ASSIGN);
                if labelled.lhs == NO_NODE: {
                    return NO_NODE;
                }
                labelled.span.end = .lookahead.span.begin;
                return .tree.add(move(labelled));
            }
            
            
            var variable = Node(kind: NodeKind::Variable, text: name.text);
            variable.span = saved.span;
            let base = .tree.add(move(variable));
            return .continue_expression(base, PRECEDENCE_ASSIGN);
        }
        return .parse_expression(PRECEDENCE_ASSIGN);
    }

    
    
    fn continue_expression(self: &unique, left: int, minimum: int) -> int: {
        var current = left;
        loop: {
            if .failed(): {
                break;
            }
            let kind = .peek_kind();
            let postfix = postfix_precedence(kind);
            if postfix != PRECEDENCE_NONE: {
                let extended = .parse_postfix(current);
                if extended == NO_NODE: {
                    return NO_NODE;
                }
                if extended != current: {
                    current = extended;
                    continue;
                }
            }
            let power = infix_precedence(kind);
            if power == PRECEDENCE_NONE || power < minimum: {
                break;
            }
            current = .parse_infix(current, power);
            if current == NO_NODE: {
                return NO_NODE;
            }
        }
        return current;
    }

    fn parse_index(self: &unique, target: int) -> int: {
        discard .advance();
        var node = Node(kind: NodeKind::Index, lhs: target);
        node.span.begin = .tree.at(target).span.begin;
        node.rhs = .parse_expression(PRECEDENCE_NONE);
        if node.rhs == NO_NODE: {
            return NO_NODE;
        }
        if !.at(TokenKind::RBracket): {
            .report(ErrorCode::UnbalancedBracket, "the subscript opened earlier is never closed");
            return NO_NODE;
        }
        discard .advance();
        node.span.end = .lookahead.span.begin;
        return .tree.add(move(node));
    }

    fn parse_member(self: &unique, target: int) -> int: {
        discard .advance();
        if !.at(TokenKind::Identifier): {
            .report(ErrorCode::ExpectedIdentifier, "a member access needs a field name");
            return NO_NODE;
        }
        let name = .advance();
        var node = Node(kind: NodeKind::Member, lhs: target, text: name.text);
        node.span.begin = .tree.at(target).span.begin;
        node.span.end = name.span.end;
        return .tree.add(move(node));
    }

    fn arena(self: &shared) -> &shared[self] Arena: {
        return .tree;
    }

    scanner: Tokenizer;
    lookahead: Token;
    tree: Arena;
    problem: Diagnostic;
    depth: int = 0;
}



struct ParseResult: {

    fn ok(self: &const shared) -> bool: {
        if .root == NO_NODE: {
            return false;
        }
        return .problem.ok();
    }

    fn describe(self: &const shared) -> string: {
        if .ok(): {
            return "parsed";
        }
        return .problem.describe();
    }

    tree: Arena;
    root: int = 0;
    problem: Diagnostic;
}

fn parse_expression_text(source: &const shared string) -> ParseResult: {
    var parser: Parser;
    let root = parser.parse_source(source);
    var out: ParseResult;
    out.root = root;
    out.problem = parser.problem;
    out.tree = move(parser.tree);
    return out;
}

fn parse_program_text(source: &const shared string) -> ParseResult: {
    var parser: Parser;
    let root = parser.parse_program(source);
    var out: ParseResult;
    out.root = root;
    out.problem = parser.problem;
    out.tree = move(parser.tree);
    return out;
}








fn power_of_ten(n: int) -> int: {
    var out: int = 1;
    var left = n;
    while left > 0: {
        out *= NUMBER_BASE;
        left -= 1;
    }
    return out;
}

fn digit_count(value: int) -> int: {
    var left = abs(value);
    var count: int = 0;
    while left > 0: {
        left /= NUMBER_BASE;
        count += 1;
    }
    if count == 0: {
        return 1;
    }
    return count;
}



struct Decimal: {

    fn is_zero(self: &const shared) -> bool: {
        return .mantissa == 0;
    }

    fn is_negative(self: &const shared) -> bool: {
        return .mantissa < 0;
    }

    fn is_integral(self: &const shared) -> bool: {
        if .exponent >= 0: {
            return true;
        }
        var copy = *self;
        copy.normalize();
        return copy.exponent >= 0;
    }

    fn normalize(self: &unique): {
        if .mantissa == 0: {
            .exponent = 0;
            return;
        }
        while .exponent < 0 && .mantissa % NUMBER_BASE == 0: {
            .mantissa /= NUMBER_BASE;
            .exponent += 1;
        }
    }

    fn scaled_to(self: &const shared, target: int) -> int: {
        if target >= .exponent: {
            return .mantissa / power_of_ten(target - .exponent);
        }
        return .mantissa * power_of_ten(.exponent - target);
    }

    fn to_int(self: &const shared) -> int: {
        return .scaled_to(0);
    }

    
    
    fn to_text(self: &const shared) -> string: {
        var copy = *self;
        copy.normalize();
        if copy.exponent >= 0: {
            var whole = to_string(copy.mantissa);
            var zeros = copy.exponent;
            while zeros > 0: {
                whole.push_back(CHAR_ZERO);
                zeros -= 1;
            }
            return whole;
        }
        var out: string = "";
        if copy.mantissa < 0: {
            out.push_back(CHAR_MINUS);
        }
        let magnitude = abs(copy.mantissa);
        let places = -copy.exponent;
        let divisor = power_of_ten(places);
        out.append(to_string(magnitude / divisor));
        out.push_back(CHAR_DOT);
        var fraction = to_string(magnitude % divisor);
        var pad = places - fraction.size();
        while pad > 0: {
            out.push_back(CHAR_ZERO);
            pad -= 1;
        }
        out.append(fraction);
        return out;
    }

    mantissa: int = 0;
    exponent: int = 0;
}

fn make_decimal(mantissa: int, exponent: int) -> Decimal: {
    var out = Decimal(mantissa: mantissa, exponent: exponent);
    out.normalize();
    return out;
}

fn decimal_from_int(value: int) -> Decimal: {
    return Decimal(mantissa: value, exponent: 0);
}



fn common_exponent(a: &const shared Decimal, b: &const shared Decimal) -> int: {
    if a.exponent < b.exponent: {
        return a.exponent;
    }
    return b.exponent;
}

fn decimal_add(a: &const shared Decimal, b: &const shared Decimal) -> Decimal: {
    let e = common_exponent(a, b);
    return make_decimal(a.scaled_to(e) + b.scaled_to(e), e);
}

fn decimal_subtract(a: &const shared Decimal, b: &const shared Decimal) -> Decimal: {
    let e = common_exponent(a, b);
    return make_decimal(a.scaled_to(e) - b.scaled_to(e), e);
}

fn decimal_multiply(a: &const shared Decimal, b: &const shared Decimal) -> Decimal: {
    return make_decimal(a.mantissa * b.mantissa, a.exponent + b.exponent);
}



static DIVISION_DIGITS: int = 6;

fn decimal_divide(a: &const shared Decimal, b: &const shared Decimal) -> Decimal: {
    if b.mantissa == 0: {
        return Decimal(mantissa: 0, exponent: 0);
    }
    let lifted = a.mantissa * power_of_ten(DIVISION_DIGITS);
    let exponent = a.exponent - b.exponent - DIVISION_DIGITS;
    return make_decimal(lifted / b.mantissa, exponent);
}

fn decimal_remainder(a: &const shared Decimal, b: &const shared Decimal) -> Decimal: {
    if b.mantissa == 0: {
        return Decimal(mantissa: 0, exponent: 0);
    }
    let e = common_exponent(a, b);
    return make_decimal(a.scaled_to(e) % b.scaled_to(e), e);
}

fn decimal_negate(a: &const shared Decimal) -> Decimal: {
    return make_decimal(-a.mantissa, a.exponent);
}


fn decimal_power(base: &const shared Decimal, exponent: &const shared Decimal) -> Decimal: {
    var count = exponent.to_int();
    if count < 0: {
        let one = decimal_from_int(1);
        var positive = *exponent;
        positive.mantissa = -positive.mantissa;
        return decimal_divide(one, decimal_power(base, positive));
    }
    var out = decimal_from_int(1);
    while count > 0: {
        out = decimal_multiply(out, *base);
        count -= 1;
    }
    return out;
}


fn decimal_compare(a: &const shared Decimal, b: &const shared Decimal) -> int: {
    let e = common_exponent(a, b);
    let left = a.scaled_to(e);
    let right = b.scaled_to(e);
    if left < right: {
        return -1;
    }
    if left > right: {
        return 1;
    }
    return 0;
}

fn decimal_equal(a: &const shared Decimal, b: &const shared Decimal) -> bool: {
    return decimal_compare(a, b) == 0;
}





struct Value: {

    fn is_nil(self: &const shared) -> bool: {
        return .kind == ValueKind::Nil;
    }

    fn is_number(self: &const shared) -> bool: {
        return .kind == ValueKind::Number;
    }

    fn is_text(self: &const shared) -> bool: {
        return .kind == ValueKind::Text;
    }

    fn is_bool(self: &const shared) -> bool: {
        return .kind == ValueKind::Bool;
    }

    fn is_list(self: &const shared) -> bool: {
        return .kind == ValueKind::List;
    }

    fn is_failure(self: &const shared) -> bool: {
        return .kind == ValueKind::Failure;
    }

    
    
    fn truthy(self: &const shared) -> bool: {
        if .kind == ValueKind::Nil: {
            return false;
        }
        if .kind == ValueKind::Bool: {
            return .flag;
        }
        if .kind == ValueKind::Number: {
            return !.number.is_zero();
        }
        if .kind == ValueKind::Text: {
            return .text.size() > 0;
        }
        if .kind == ValueKind::List: {
            return .items.size() > 0;
        }
        if .kind == ValueKind::Failure: {
            return false;
        }
        return true;
    }

    fn kind_name(self: &const shared) -> string: {
        if .kind == ValueKind::Nil: { return "null"; }
        if .kind == ValueKind::Bool: { return "bool"; }
        if .kind == ValueKind::Number: { return "number"; }
        if .kind == ValueKind::Text: { return "string"; }
        if .kind == ValueKind::List: { return "list"; }
        if .kind == ValueKind::Builtin: { return "builtin"; }
        if .kind == ValueKind::Failure: { return "error"; }
        return "unknown";
    }

    fn size(self: &const shared) -> int: {
        if .kind == ValueKind::List: {
            return .items.size();
        }
        if .kind == ValueKind::Text: {
            return .text.size();
        }
        return 0;
    }

    
    fn to_text(self: &const shared) -> string: {
        if .kind == ValueKind::Nil: {
            return WORD_NULL;
        }
        if .kind == ValueKind::Bool: {
            if .flag: {
                return WORD_TRUE;
            }
            return WORD_FALSE;
        }
        if .kind == ValueKind::Number: {
            return .number.to_text();
        }
        if .kind == ValueKind::Text: {
            return .text;
        }
        if .kind == ValueKind::Builtin: {
            var out: string = "<builtin ";
            out.append(.text);
            out.append(">");
            return out;
        }
        if .kind == ValueKind::Failure: {
            var out: string = "<error: ";
            out.append(.text);
            out.append(">");
            return out;
        }
        var out: string = "[";
        var first = true;
        for element: &const in .items: {
            if !first: {
                out.append(TEXT_COMMA_SPACE);
            }
            out.append(element.to_text());
            first = false;
        }
        out.append("]");
        return out;
    }

    kind: ValueKind = ValueKind::Nil;
    number: Decimal;
    text: string;
    flag: bool = false;
    items: vector{Value};
    
    arity: int = 0;
}

fn nil_value() -> Value: {
    return Value(kind: ValueKind::Nil);
}

fn bool_value(flag: bool) -> Value: {
    return Value(kind: ValueKind::Bool, flag: flag);
}

fn number_value(number: Decimal) -> Value: {
    return Value(kind: ValueKind::Number, number: number);
}

fn int_value(n: int) -> Value: {
    return number_value(decimal_from_int(n));
}

fn text_value(text: &const shared string) -> Value: {
    return Value(kind: ValueKind::Text, text: *text);
}

fn list_value(items: vector{Value}) -> Value: {
    return Value(kind: ValueKind::List, items: move(items));
}

fn failure_value(detail: &const shared string) -> Value: {
    return Value(kind: ValueKind::Failure, text: *detail);
}



fn values_equal(a: &const shared Value, b: &const shared Value) -> bool: {
    if a.kind != b.kind: {
        return false;
    }
    if a.kind == ValueKind::Nil: {
        return true;
    }
    if a.kind == ValueKind::Bool: {
        return a.flag == b.flag;
    }
    if a.kind == ValueKind::Number: {
        return decimal_equal(a.number, b.number);
    }
    if a.kind == ValueKind::Text: {
        return a.text == b.text;
    }
    if a.kind == ValueKind::List: {
        if a.items.size() != b.items.size(): {
            return false;
        }
        for i in range(0, a.items.size()): {
            if !values_equal(a.items[i], b.items[i]): {
                return false;
            }
        }
        return true;
    }
    return a.text == b.text;
}


fn compare_values(a: &const shared Value, b: &const shared Value) -> int: {
    if a.kind == ValueKind::Number && b.kind == ValueKind::Number: {
        return decimal_compare(a.number, b.number);
    }
    if a.kind == ValueKind::Text && b.kind == ValueKind::Text: {
        return a.text.compare(b.text);
    }
    if values_equal(a, b): {
        return 0;
    }
    return -1;
}






struct Scope: {

    fn size(self: &const shared) -> int: {
        return .names.size();
    }

    fn index_of(self: &const shared, name: &const shared string) -> int: {
        var i = .names.size() - 1;
        while i >= 0: {
            if .names[i] == *name: {
                return i;
            }
            i -= 1;
        }
        return -1;
    }

    fn contains(self: &const shared, name: &const shared string) -> bool: {
        return .index_of(name) >= 0;
    }

    fn define(self: &unique, name: &const shared string, value: Value): {
        let existing = .index_of(name);
        if existing >= 0: {
            .values[existing] = move(value);
            return;
        }
        .names.push_back(*name);
        .values.push_back(move(value));
    }

    fn at(self: &shared, index: int) -> &shared[self] Value: {
        return .values[index];
    }

    fn clear(self: &unique): {
        .names.clear();
        .values.clear();
    }

    names: vector{string};
    values: vector{Value};
    
    label: string;
}

struct Environment: {

    fn depth(self: &const shared) -> int: {
        return .frames.size();
    }

    fn global(self: &shared) -> &shared[self] Scope: {
        return .frames[0];
    }

    fn innermost(self: &shared) -> &shared[self] Scope: {
        return .frames[.frames.size() - 1];
    }

    fn push_scope(self: &unique, label: &const shared string): {
        .frames.push_back(Scope(label: *label));
    }

    fn pop_scope(self: &unique): {
        if .frames.size() > 1: {
            .frames.pop_back();
        }
    }

    fn define(self: &unique, name: &const shared string, value: Value): {
        let frame: &unique = .frames[.frames.size() - 1];
        frame.define(name, move(value));
    }

    fn define_global(self: &unique, name: &const shared string, value: Value): {
        let frame: &unique = .frames[0];
        frame.define(name, move(value));
    }

    fn bound(self: &const shared, name: &const shared string) -> bool: {
        var i = .frames.size() - 1;
        while i >= 0: {
            if .frames[i].contains(name): {
                return true;
            }
            i -= 1;
        }
        return false;
    }

    
    
    
    fn lookup(self: &shared, name: &const shared string) -> &shared[self] Value: {
        var i = .frames.size() - 1;
        while i >= 0: {
            let frame: &shared = .frames[i];
            let slot = frame.index_of(name);
            if slot >= 0: {
                return frame.at(slot);
            }
            i -= 1;
        }
        return .missing;
    }

    
    
    fn assign(self: &unique, name: &const shared string, value: Value) -> bool: {
        var i = .frames.size() - 1;
        while i >= 0: {
            let frame: &unique = .frames[i];
            let slot = frame.index_of(name);
            if slot >= 0: {
                frame.values[slot] = move(value);
                return true;
            }
            i -= 1;
        }
        return false;
    }

    fn describe(self: &const shared) -> string: {
        var out: string = "";
        for frame: &const in .frames: {
            out.append(frame.label);
            out.append(" {");
            for i in range(0, frame.names.size()): {
                if i > 0: {
                    out.append(TEXT_COMMA_SPACE);
                }
                out.append(frame.names[i]);
            }
            out.append("}\n");
        }
        return out;
    }

    frames: vector{Scope};
    missing: Value;
}

fn make_environment() -> Environment: {
    var env: Environment;
    env.frames.push_back(Scope(label: "global"));
    return env;
}






fn builtin_arity(name: &const shared string) -> int: {
    if *name == "abs": { return 1; }
    if *name == "min": { return 2; }
    if *name == "max": { return 2; }
    if *name == "floor": { return 1; }
    if *name == "ceil": { return 1; }
    if *name == "round": { return 1; }
    if *name == "sqrt": { return 1; }
    if *name == "len": { return 1; }
    if *name == "upper": { return 1; }
    if *name == "lower": { return 1; }
    if *name == "trim": { return 1; }
    if *name == "concat": { return 2; }
    if *name == "at": { return 2; }
    if *name == "slice": { return 3; }
    if *name == "push": { return 2; }
    if *name == "sum": { return 1; }
    if *name == "type": { return 1; }
    if *name == "number": { return 1; }
    if *name == "string": { return 1; }
    if *name == "print": { return 1; }
    
    if *name == "list": { return -1; }
    return -2;
}

fn is_builtin(name: &const shared string) -> bool: {
    return builtin_arity(name) != -2;
}

fn builtin_names() -> vector{string}: {
    var names: vector{string};
    names.push_back("abs");
    names.push_back("min");
    names.push_back("max");
    names.push_back("floor");
    names.push_back("ceil");
    names.push_back("round");
    names.push_back("sqrt");
    names.push_back("len");
    names.push_back("upper");
    names.push_back("lower");
    names.push_back("trim");
    names.push_back("concat");
    names.push_back("at");
    names.push_back("slice");
    names.push_back("push");
    names.push_back("sum");
    names.push_back("type");
    names.push_back("number");
    names.push_back("string");
    names.push_back("print");
    names.push_back("list");
    return names;
}



fn builtin_is_pure(name: &const shared string) -> bool: {
    if *name == "print": {
        return false;
    }
    if *name == "push": {
        return false;
    }
    return is_builtin(name);
}


fn decimal_sqrt(value: &const shared Decimal) -> Decimal: {
    let target = value.scaled_to(-2);
    if target <= 0: {
        return decimal_from_int(0);
    }
    var low: int = 0;
    var high = target;
    while low < high: {
        let middle = (low + high + 1) / 2;
        if middle * middle <= target * 100: {
            low = middle;
        } else: {
            high = middle - 1;
        }
    }
    return make_decimal(low, -2);
}

fn decimal_floor(value: &const shared Decimal) -> Decimal: {
    let whole = value.scaled_to(0);
    var out = decimal_from_int(whole);
    if value.is_negative() && decimal_compare(out, *value) != 0: {
        out = decimal_from_int(whole - 1);
    }
    return out;
}

fn decimal_ceil(value: &const shared Decimal) -> Decimal: {
    let floored = decimal_floor(value);
    if decimal_equal(floored, *value): {
        return floored;
    }
    return decimal_add(floored, decimal_from_int(1));
}

fn decimal_round(value: &const shared Decimal) -> Decimal: {
    let half = make_decimal(5, -1);
    return decimal_floor(decimal_add(*value, half));
}

fn text_upper(text: &const shared string) -> string: {
    var out: string = "";
    for i in range(0, text.size()): {
        out.push_back(to_upper(text.at(i)));
    }
    return out;
}

fn text_lower(text: &const shared string) -> string: {
    var out: string = "";
    for i in range(0, text.size()): {
        out.push_back(to_lower(text.at(i)));
    }
    return out;
}

fn text_trim(text: &const shared string) -> string: {
    var begin: int = 0;
    var end = text.size();
    while begin < end && is_space(text.at(begin)): {
        begin += 1;
    }
    while end > begin && is_space(text.at(end - 1)): {
        end -= 1;
    }
    return text.substr(begin, end - begin);
}






struct Interpreter: {

    fn fail(self: &unique, code: ErrorCode, detail: &const shared string) -> Value: {
        if .problem.ok(): {
            .problem.code = code;
            .problem.detail = *detail;
        }
        var message = error_text(code);
        message.append(": ");
        message.append(*detail);
        return failure_value(message);
    }

    fn node_kind(self: &const shared, index: int) -> NodeKind: {
        return .tree.kind_of(index);
    }

    

    fn evaluate(self: &unique, index: int) -> Value: {
        if !.tree.valid(index): {
            return nil_value();
        }
        .steps += 1;
        let kind = .tree.kind_of(index);

        if kind == NodeKind::NumberLiteral: {
            return number_value(make_decimal(.tree.at(index).mantissa, .tree.at(index).exponent));
        }
        if kind == NodeKind::TextLiteral: {
            return text_value(.tree.at(index).text);
        }
        if kind == NodeKind::BoolLiteral: {
            return bool_value(.tree.at(index).flag);
        }
        if kind == NodeKind::NullLiteral: {
            return nil_value();
        }
        if kind == NodeKind::Empty: {
            return nil_value();
        }
        if kind == NodeKind::Variable: {
            return .evaluate_variable(index);
        }
        if kind == NodeKind::Unary: {
            return .evaluate_unary(index);
        }
        if kind == NodeKind::Postfix: {
            return .evaluate_postfix(index);
        }
        if kind == NodeKind::Binary: {
            return .evaluate_binary(index);
        }
        if kind == NodeKind::Assign: {
            return .evaluate_assign(index);
        }
        if kind == NodeKind::Conditional: {
            return .evaluate_conditional(index);
        }
        if kind == NodeKind::Call: {
            return .evaluate_call(index);
        }
        if kind == NodeKind::Index: {
            return .evaluate_index(index);
        }
        if kind == NodeKind::Member: {
            return .evaluate_member(index);
        }
        if kind == NodeKind::Let: {
            return .evaluate_let(index);
        }
        if kind == NodeKind::Block: {
            return .evaluate_block(index);
        }
        if kind == NodeKind::Loop: {
            return .evaluate_loop(index);
        }
        if kind == NodeKind::Return: {
            var out = .evaluate(.tree.at(index).lhs);
            .returning = true;
            return out;
        }
        return .fail(ErrorCode::ExpectedExpression, "cannot evaluate this node");
    }

    fn evaluate_variable(self: &unique, index: int) -> Value: {
        let name = .tree.at(index).text;
        if .environment.bound(name): {
            return .environment.lookup(name);
        }
        if is_builtin(name): {
            return Value(kind: ValueKind::Builtin, text: name, arity: builtin_arity(name));
        }
        var detail: string = "no binding named '";
        detail.append(name);
        detail.append("'");
        return .fail(ErrorCode::UnknownName, detail);
    }

    

    fn evaluate_unary(self: &unique, index: int) -> Value: {
        let op = .tree.at(index).op;
        let operand = .evaluate(.tree.at(index).lhs);
        if operand.is_failure(): {
            return operand;
        }

        if op == TokenKind::Minus: {
            if !operand.is_number(): {
                return .fail(ErrorCode::TypeMismatch, "unary minus needs a number");
            }
            return number_value(decimal_negate(operand.number));
        }
        if op == TokenKind::Plus: {
            if !operand.is_number(): {
                return .fail(ErrorCode::TypeMismatch, "unary plus needs a number");
            }
            return operand;
        }
        if op == TokenKind::Bang || op == TokenKind::KeywordNot: {
            return bool_value(!operand.truthy());
        }
        if op == TokenKind::Tilde: {
            if !operand.is_number(): {
                return .fail(ErrorCode::TypeMismatch, "bitwise complement needs a number");
            }
            return int_value(~operand.number.to_int());
        }
        if op == TokenKind::PlusPlus || op == TokenKind::MinusMinus: {
            return .apply_step(.tree.at(index).lhs, op, false);
        }
        return .fail(ErrorCode::TypeMismatch, "unknown prefix operator");
    }

    fn evaluate_postfix(self: &unique, index: int) -> Value: {
        let op = .tree.at(index).op;
        if op == TokenKind::PlusPlus || op == TokenKind::MinusMinus: {
            return .apply_step(.tree.at(index).lhs, op, true);
        }
        if op == TokenKind::Bang: {
            let operand = .evaluate(.tree.at(index).lhs);
            if !operand.is_number(): {
                return .fail(ErrorCode::TypeMismatch, "factorial needs a number");
            }
            var count = operand.number.to_int();
            var out: int = 1;
            while count > 1: {
                out *= count;
                count -= 1;
            }
            return int_value(out);
        }
        return .fail(ErrorCode::TypeMismatch, "unknown postfix operator");
    }

    
    
    fn apply_step(self: &unique, target: int, op: TokenKind, after: bool) -> Value: {
        if .tree.kind_of(target) != NodeKind::Variable: {
            return .fail(ErrorCode::NotAssignable, "increment needs a variable");
        }
        let name = .tree.at(target).text;
        let current = .environment.lookup(name);
        if !current.is_number(): {
            return .fail(ErrorCode::TypeMismatch, "increment needs a number");
        }
        var stepped = current.number;
        if op == TokenKind::PlusPlus: {
            stepped = decimal_add(stepped, decimal_from_int(1));
        } else: {
            stepped = decimal_subtract(stepped, decimal_from_int(1));
        }
        discard .environment.assign(name, number_value(stepped));
        if after: {
            return number_value(current.number);
        }
        return number_value(stepped);
    }

    fn evaluate_binary(self: &unique, index: int) -> Value: {
        let op = .tree.at(index).op;

        
        if is_short_circuit(op): {
            let left = .evaluate(.tree.at(index).lhs);
            if left.is_failure(): {
                return left;
            }
            if op == TokenKind::AmpAmp || op == TokenKind::KeywordAnd: {
                if !left.truthy(): {
                    return bool_value(false);
                }
                let right = .evaluate(.tree.at(index).rhs);
                if right.is_failure(): {
                    return right;
                }
                return bool_value(right.truthy());
            }
            if left.truthy(): {
                return bool_value(true);
            }
            let right = .evaluate(.tree.at(index).rhs);
            if right.is_failure(): {
                return right;
            }
            return bool_value(right.truthy());
        }

        let left = .evaluate(.tree.at(index).lhs);
        if left.is_failure(): {
            return left;
        }
        let right = .evaluate(.tree.at(index).rhs);
        if right.is_failure(): {
            return right;
        }
        return .apply_binary(op, left, right);
    }

    fn apply_binary(self: &unique, op: TokenKind, left: &const shared Value, right: &const shared Value) -> Value: {
        if op == TokenKind::EqualEqual: {
            return bool_value(values_equal(left, right));
        }
        if op == TokenKind::BangEqual: {
            return bool_value(!values_equal(left, right));
        }
        if is_comparison(op): {
            let order = compare_values(left, right);
            if op == TokenKind::Less: { return bool_value(order < 0); }
            if op == TokenKind::LessEqual: { return bool_value(order <= 0); }
            if op == TokenKind::Greater: { return bool_value(order > 0); }
            if op == TokenKind::GreaterEqual: { return bool_value(order >= 0); }
        }

        
        if op == TokenKind::Plus: {
            if left.is_text() || right.is_text(): {
                var joined = left.to_text();
                joined.append(right.to_text());
                return text_value(joined);
            }
            if left.is_list(): {
                var items = left.items;
                if right.is_list(): {
                    for element: &const in right.items: {
                        items.push_back(*element);
                    }
                } else: {
                    items.push_back(*right);
                }
                return list_value(move(items));
            }
        }

        if !left.is_number() || !right.is_number(): {
            var detail: string = "operator ";
            detail.append(token_spelling(op));
            detail.append(" does not accept ");
            detail.append(left.kind_name());
            detail.append(" and ");
            detail.append(right.kind_name());
            return .fail(ErrorCode::TypeMismatch, detail);
        }

        if op == TokenKind::Plus: {
            return number_value(decimal_add(left.number, right.number));
        }
        if op == TokenKind::Minus: {
            return number_value(decimal_subtract(left.number, right.number));
        }
        if op == TokenKind::Star: {
            return number_value(decimal_multiply(left.number, right.number));
        }
        if op == TokenKind::Slash: {
            if right.number.is_zero(): {
                return .fail(ErrorCode::DivideByZero, "the divisor evaluates to zero");
            }
            return number_value(decimal_divide(left.number, right.number));
        }
        if op == TokenKind::Percent: {
            if right.number.is_zero(): {
                return .fail(ErrorCode::DivideByZero, "the modulus evaluates to zero");
            }
            return number_value(decimal_remainder(left.number, right.number));
        }
        if op == TokenKind::StarStar: {
            return number_value(decimal_power(left.number, right.number));
        }

        
        let a = left.number.to_int();
        let b = right.number.to_int();
        if op == TokenKind::Amp: { return int_value(a & b); }
        if op == TokenKind::Pipe: { return int_value(a | b); }
        if op == TokenKind::Caret: { return int_value(a ^ b); }
        if op == TokenKind::LessLess: { return int_value(a << b); }
        if op == TokenKind::GreaterGreater: { return int_value(a >> b); }

        var detail: string = "unknown operator ";
        detail.append(token_spelling(op));
        return .fail(ErrorCode::TypeMismatch, detail);
    }

    fn evaluate_assign(self: &unique, index: int) -> Value: {
        let op = .tree.at(index).op;
        let target = .tree.at(index).lhs;
        if .tree.kind_of(target) != NodeKind::Variable: {
            return .fail(ErrorCode::NotAssignable, "only plain names may be assigned to");
        }
        let name = .tree.at(target).text;
        var value = .evaluate(.tree.at(index).rhs);
        if value.is_failure(): {
            return value;
        }
        if op != TokenKind::Equal: {
            let base = compound_base_operator(op);
            let current = .environment.lookup(name);
            value = .apply_binary(base, current, value);
            if value.is_failure(): {
                return value;
            }
        }
        if !.environment.assign(name, value): {
            .environment.define(name, value);
        }
        return value;
    }

    fn evaluate_conditional(self: &unique, index: int) -> Value: {
        let condition = .evaluate(.tree.at(index).lhs);
        if condition.is_failure(): {
            return condition;
        }
        if condition.truthy(): {
            return .evaluate(.tree.at(index).rhs);
        }
        return .evaluate(.tree.at(index).extra);
    }

    fn evaluate_let(self: &unique, index: int) -> Value: {
        let value = .evaluate(.tree.at(index).lhs);
        if value.is_failure(): {
            return value;
        }
        .environment.define(.tree.at(index).text, value);
        return value;
    }

    fn evaluate_block(self: &unique, index: int) -> Value: {
        .environment.push_scope("block");
        var last = nil_value();
        for statement in .tree.at(index).parts: {
            last = .evaluate(statement);
            if last.is_failure(): {
                break;
            }
            if .returning: {
                break;
            }
        }
        .environment.pop_scope();
        return last;
    }

    fn evaluate_loop(self: &unique, index: int) -> Value: {
        var last = nil_value();
        var rounds: int = 0;
        loop: {
            let condition = .evaluate(.tree.at(index).lhs);
            if condition.is_failure(): {
                return condition;
            }
            if !condition.truthy(): {
                break;
            }
            last = .evaluate(.tree.at(index).rhs);
            if last.is_failure(): {
                return last;
            }
            if .returning: {
                break;
            }
            rounds += 1;
            if rounds > .step_limit: {
                return .fail(ErrorCode::DepthExceeded, "loop ran past the step limit");
            }
        }
        return last;
    }

    fn evaluate_index(self: &unique, index: int) -> Value: {
        let target = .evaluate(.tree.at(index).lhs);
        if target.is_failure(): {
            return target;
        }
        let subscript = .evaluate(.tree.at(index).rhs);
        if subscript.is_failure(): {
            return subscript;
        }
        if !subscript.is_number(): {
            return .fail(ErrorCode::TypeMismatch, "a subscript has to be a number");
        }
        let position = subscript.number.to_int();
        if target.is_list(): {
            if position < 0 || position >= target.items.size(): {
                return nil_value();
            }
            return target.items[position];
        }
        if target.is_text(): {
            if position < 0 || position >= target.text.size(): {
                return nil_value();
            }
            return text_value(target.text.substr(position, 1));
        }
        return .fail(ErrorCode::NotIndexable, target.kind_name());
    }

    
    
    fn evaluate_member(self: &unique, index: int) -> Value: {
        let target = .evaluate(.tree.at(index).lhs);
        if target.is_failure(): {
            return target;
        }
        let field = .tree.at(index).text;
        if field == "length" || field == "size": {
            return int_value(target.size());
        }
        if field == "kind": {
            return text_value(target.kind_name());
        }
        if field == "first": {
            if target.is_list() && target.items.size() > 0: {
                return target.items[0];
            }
            return nil_value();
        }
        if field == "last": {
            if target.is_list() && target.items.size() > 0: {
                return target.items[target.items.size() - 1];
            }
            return nil_value();
        }
        if field == "text": {
            return text_value(target.to_text());
        }
        var detail: string = "no member named '";
        detail.append(field);
        detail.append("'");
        return .fail(ErrorCode::UnknownName, detail);
    }

    fn evaluate_call(self: &unique, index: int) -> Value: {
        let callee = .tree.at(index).lhs;
        if .tree.kind_of(callee) != NodeKind::Variable: {
            return .fail(ErrorCode::NotCallable, "only named builtins may be called");
        }
        let name = .tree.at(callee).text;
        var arguments: vector{Value};
        for child in .tree.at(index).parts: {
            var argument = child;
            
            if .tree.kind_of(argument) == NodeKind::Let: {
                argument = .tree.at(argument).lhs;
            }
            let value = .evaluate(argument);
            if value.is_failure(): {
                return value;
            }
            arguments.push_back(value);
        }
        return .call_builtin(name, arguments);
    }

    fn call_builtin(self: &unique, name: &const shared string, arguments: &const shared vector{Value}) -> Value: {
        let wanted = builtin_arity(name);
        if wanted == -2: {
            var unknown: string = "no builtin named '";
            unknown.append(*name);
            unknown.append("'");
            return .fail(ErrorCode::NotCallable, unknown);
        }
        if wanted >= 0 && arguments.size() != wanted: {
            var detail = *name;
            detail.append(" expects ");
            detail.append(to_string(wanted));
            detail.append(" arguments, got ");
            detail.append(to_string(arguments.size()));
            return .fail(ErrorCode::WrongArity, detail);
        }

        if *name == "list": {
            var items: vector{Value};
            for element: &const in *arguments: {
                items.push_back(*element);
            }
            return list_value(move(items));
        }
        if *name == "print": {
            println(arguments[0].to_text());
            .output.push_back(arguments[0].to_text());
            return arguments[0];
        }
        if *name == "type": {
            return text_value(arguments[0].kind_name());
        }
        if *name == "len": {
            return int_value(arguments[0].size());
        }
        if *name == "string": {
            return text_value(arguments[0].to_text());
        }
        if *name == "upper": {
            return text_value(text_upper(arguments[0].to_text()));
        }
        if *name == "lower": {
            return text_value(text_lower(arguments[0].to_text()));
        }
        if *name == "trim": {
            return text_value(text_trim(arguments[0].to_text()));
        }
        if *name == "concat": {
            var joined = arguments[0].to_text();
            joined.append(arguments[1].to_text());
            return text_value(joined);
        }
        if *name == "at": {
            let container = arguments[0];
            let position = arguments[1].number.to_int();
            if container.is_list(): {
                if position < 0 || position >= container.items.size(): {
                    return nil_value();
                }
                return container.items[position];
            }
            if container.is_text(): {
                if position < 0 || position >= container.text.size(): {
                    return nil_value();
                }
                return text_value(container.text.substr(position, 1));
            }
            return .fail(ErrorCode::NotIndexable, container.kind_name());
        }
        if *name == "slice": {
            let container = arguments[0];
            let begin = arguments[1].number.to_int();
            let count = arguments[2].number.to_int();
            if container.is_text(): {
                return text_value(container.text.substr(begin, count));
            }
            var items: vector{Value};
            for i in range(begin, begin + count): {
                if i >= 0 && i < container.items.size(): {
                    items.push_back(container.items[i]);
                }
            }
            return list_value(move(items));
        }
        if *name == "push": {
            var items = arguments[0].items;
            items.push_back(arguments[1]);
            return list_value(move(items));
        }
        if *name == "sum": {
            var total = decimal_from_int(0);
            for element: &const in arguments[0].items: {
                if element.is_number(): {
                    total = decimal_add(total, element.number);
                }
            }
            return number_value(total);
        }

        
        if !arguments[0].is_number(): {
            var detail = *name;
            detail.append(" expects a number");
            return .fail(ErrorCode::TypeMismatch, detail);
        }
        if *name == "abs": {
            if arguments[0].number.is_negative(): {
                return number_value(decimal_negate(arguments[0].number));
            }
            return arguments[0];
        }
        if *name == "floor": {
            return number_value(decimal_floor(arguments[0].number));
        }
        if *name == "ceil": {
            return number_value(decimal_ceil(arguments[0].number));
        }
        if *name == "round": {
            return number_value(decimal_round(arguments[0].number));
        }
        if *name == "sqrt": {
            return number_value(decimal_sqrt(arguments[0].number));
        }
        if *name == "number": {
            return arguments[0];
        }
        if *name == "min": {
            if decimal_compare(arguments[0].number, arguments[1].number) <= 0: {
                return arguments[0];
            }
            return arguments[1];
        }
        if *name == "max": {
            if decimal_compare(arguments[0].number, arguments[1].number) >= 0: {
                return arguments[0];
            }
            return arguments[1];
        }
        return .fail(ErrorCode::NotCallable, *name);
    }

    fn reset(self: &unique): {
        .environment = make_environment();
        .problem = Diagnostic();
        .output.clear();
        .steps = 0;
        .returning = false;
    }

    tree: Arena;
    environment: Environment;
    problem: Diagnostic;
    output: vector{string};
    steps: int = 0;
    step_limit: int = 100000;
    returning: bool = false;
}






struct Folder: {

    fn folded(self: &const shared) -> int: {
        return .rewrites;
    }

    
    
    fn pure(self: &const shared, index: int) -> bool: {
        if !.tree.valid(index): {
            return true;
        }
        let kind = .tree.kind_of(index);
        if kind == NodeKind::Assign: {
            return false;
        }
        if kind == NodeKind::Postfix: {
            return false;
        }
        if kind == NodeKind::Let: {
            return false;
        }
        if kind == NodeKind::Loop: {
            return false;
        }
        if kind == NodeKind::Return: {
            return false;
        }
        if kind == NodeKind::Unary: {
            let op = .tree.operator_of(index);
            if op == TokenKind::PlusPlus || op == TokenKind::MinusMinus: {
                return false;
            }
            return .pure(.tree.at(index).lhs);
        }
        if kind == NodeKind::Call: {
            let callee = .tree.at(index).lhs;
            if .tree.kind_of(callee) != NodeKind::Variable: {
                return false;
            }
            if !builtin_is_pure(.tree.at(callee).text): {
                return false;
            }
            for child in .tree.at(index).parts: {
                if !.pure(child): {
                    return false;
                }
            }
            return true;
        }
        if kind == NodeKind::Variable: {
            
            
            return true;
        }
        if .tree.at(index).lhs != NO_NODE && !.pure(.tree.at(index).lhs): {
            return false;
        }
        if .tree.at(index).rhs != NO_NODE && !.pure(.tree.at(index).rhs): {
            return false;
        }
        if .tree.at(index).extra != NO_NODE && !.pure(.tree.at(index).extra): {
            return false;
        }
        return true;
    }

    fn is_constant(self: &const shared, index: int) -> bool: {
        if !.tree.valid(index): {
            return false;
        }
        return .tree.at(index).is_literal();
    }

    fn constant_value(self: &shared, index: int) -> Value: {
        let kind = .tree.kind_of(index);
        if kind == NodeKind::NumberLiteral: {
            return number_value(make_decimal(.tree.at(index).mantissa, .tree.at(index).exponent));
        }
        if kind == NodeKind::TextLiteral: {
            return text_value(.tree.at(index).text);
        }
        if kind == NodeKind::BoolLiteral: {
            return bool_value(.tree.at(index).flag);
        }
        return nil_value();
    }

    fn write_value(self: &unique, index: int, value: &const shared Value): {
        if value.is_number(): {
            .tree.replace_with_number(index, value.number.mantissa, value.number.exponent);
            .rewrites += 1;
            return;
        }
        if value.is_bool(): {
            .tree.replace_with_bool(index, value.flag);
            .rewrites += 1;
            return;
        }
        if value.is_text(): {
            var literal = Node(kind: NodeKind::TextLiteral, text: value.text);
            .tree.replace(index, move(literal));
            .rewrites += 1;
            return;
        }
        if value.is_nil(): {
            .tree.replace(index, Node(kind: NodeKind::NullLiteral));
            .rewrites += 1;
        }
    }

    

    fn fold(self: &unique, index: int) -> int: {
        if !.tree.valid(index): {
            return index;
        }
        let kind = .tree.kind_of(index);

        if kind == NodeKind::Unary: {
            return .fold_unary(index);
        }
        if kind == NodeKind::Binary: {
            return .fold_binary(index);
        }
        if kind == NodeKind::Conditional: {
            return .fold_conditional(index);
        }
        if kind == NodeKind::Call: {
            return .fold_call(index);
        }
        if kind == NodeKind::Block: {
            return .fold_block(index);
        }
        if kind == NodeKind::Index: {
            discard .fold(.tree.at(index).lhs);
            discard .fold(.tree.at(index).rhs);
            return index;
        }
        if kind == NodeKind::Member: {
            discard .fold(.tree.at(index).lhs);
            return index;
        }
        if kind == NodeKind::Assign: {
            discard .fold(.tree.at(index).rhs);
            return index;
        }
        if kind == NodeKind::Let: {
            discard .fold(.tree.at(index).lhs);
            return index;
        }
        if kind == NodeKind::Loop: {
            return .fold_loop(index);
        }
        if kind == NodeKind::Return: {
            discard .fold(.tree.at(index).lhs);
            return index;
        }
        return index;
    }

    fn fold_unary(self: &unique, index: int) -> int: {
        let operand = .fold(.tree.at(index).lhs);
        let op = .tree.operator_of(index);

        
        
        if op == TokenKind::Minus && .tree.kind_of(operand) == NodeKind::Unary: {
            if .tree.operator_of(operand) == TokenKind::Minus: {
                let inner = .tree.at(operand).lhs;
                let copy = .tree.adopt(inner);
                var replacement = Node(kind: .tree.kind_of(copy));
                replacement.op = .tree.operator_of(copy);
                replacement.lhs = .tree.at(copy).lhs;
                replacement.rhs = .tree.at(copy).rhs;
                replacement.extra = .tree.at(copy).extra;
                replacement.mantissa = .tree.at(copy).mantissa;
                replacement.exponent = .tree.at(copy).exponent;
                replacement.text = .tree.at(copy).text;
                replacement.flag = .tree.at(copy).flag;
                .tree.replace(index, move(replacement));
                .rewrites += 1;
                return index;
            }
        }

        if !.is_constant(operand): {
            return index;
        }
        var machine = Interpreter();
        machine.tree = .tree;
        let value = machine.evaluate(index);
        if value.is_failure(): {
            return index;
        }
        .write_value(index, value);
        return index;
    }

    fn fold_binary(self: &unique, index: int) -> int: {
        let left = .fold(.tree.at(index).lhs);
        let right = .fold(.tree.at(index).rhs);
        let op = .tree.operator_of(index);

        if .is_constant(left) && .is_constant(right): {
            let a = .constant_value(left);
            let b = .constant_value(right);
            if op == TokenKind::Slash && b.is_number() && b.number.is_zero(): {
                return index;
            }
            if op == TokenKind::Percent && b.is_number() && b.number.is_zero(): {
                return index;
            }
            var machine = Interpreter();
            machine.tree = .tree;
            let value = machine.evaluate(index);
            if !value.is_failure(): {
                .write_value(index, value);
            }
            return index;
        }

        
        if .is_zero_literal(right) && (op == TokenKind::Plus || op == TokenKind::Minus): {
            .splice(index, left);
            return index;
        }
        if .is_zero_literal(left) && op == TokenKind::Plus: {
            .splice(index, right);
            return index;
        }
        if .is_one_literal(right) && (op == TokenKind::Star || op == TokenKind::Slash): {
            .splice(index, left);
            return index;
        }
        if .is_one_literal(left) && op == TokenKind::Star: {
            .splice(index, right);
            return index;
        }
        if .is_zero_literal(right) && op == TokenKind::Star && .pure(left): {
            .tree.replace_with_number(index, 0, 0);
            .rewrites += 1;
            return index;
        }
        if op == TokenKind::AmpAmp && .is_false_literal(left): {
            .tree.replace_with_bool(index, false);
            .rewrites += 1;
            return index;
        }
        if op == TokenKind::PipePipe && .is_true_literal(left): {
            .tree.replace_with_bool(index, true);
            .rewrites += 1;
            return index;
        }
        return index;
    }

    fn fold_conditional(self: &unique, index: int) -> int: {
        let condition = .fold(.tree.at(index).lhs);
        let whenever = .fold(.tree.at(index).rhs);
        let otherwise = .fold(.tree.at(index).extra);
        if !.is_constant(condition): {
            return index;
        }
        
        
        let decided = .constant_value(condition);
        if decided.truthy(): {
            .splice(index, whenever);
        } else: {
            .splice(index, otherwise);
        }
        return index;
    }

    fn fold_call(self: &unique, index: int) -> int: {
        var all_constant = true;
        for child in .tree.at(index).parts: {
            let folded = .fold(child);
            if !.is_constant(folded): {
                all_constant = false;
            }
        }
        let callee = .tree.at(index).lhs;
        if .tree.kind_of(callee) != NodeKind::Variable: {
            return index;
        }
        if !builtin_is_pure(.tree.at(callee).text): {
            return index;
        }
        if !all_constant: {
            return index;
        }
        var machine = Interpreter();
        machine.tree = .tree;
        let value = machine.evaluate(index);
        if value.is_failure(): {
            return index;
        }
        if value.is_list(): {
            return index;
        }
        .write_value(index, value);
        return index;
    }

    
    fn fold_loop(self: &unique, index: int) -> int: {
        let condition = .fold(.tree.at(index).lhs);
        discard .fold(.tree.at(index).rhs);
        if .is_false_literal(condition): {
            .tree.replace(index, Node(kind: NodeKind::Empty));
            .rewrites += 1;
        }
        return index;
    }

    
    
    fn fold_block(self: &unique, index: int) -> int: {
        var kept: vector{int};
        var terminated = false;
        let total = .tree.at(index).parts.size();
        var position: int = 0;
        for child in .tree.at(index).parts: {
            position += 1;
            if terminated: {
                .removed += 1;
                continue;
            }
            let folded = .fold(child);
            let kind = .tree.kind_of(folded);
            if kind == NodeKind::Empty: {
                .removed += 1;
                continue;
            }
            
            
            if position < total && .pure(folded) && .droppable(folded): {
                .removed += 1;
                continue;
            }
            kept.push_back(folded);
            if kind == NodeKind::Return: {
                terminated = true;
            }
        }
        let slot: &unique = .tree.at(index);
        slot.parts.clear();
        for survivor in kept: {
            slot.parts.push_back(survivor);
        }
        return index;
    }

    
    
    
    fn droppable(self: &const shared, index: int) -> bool: {
        let kind = .tree.kind_of(index);
        if kind == NodeKind::Variable: { return true; }
        if kind == NodeKind::NumberLiteral: { return true; }
        if kind == NodeKind::TextLiteral: { return true; }
        if kind == NodeKind::BoolLiteral: { return true; }
        if kind == NodeKind::NullLiteral: { return true; }
        if kind == NodeKind::Empty: { return true; }
        return false;
    }

    
    fn splice(self: &unique, target: int, source: int): {
        if !.tree.valid(source): {
            return;
        }
        var replacement = Node(kind: .tree.kind_of(source));
        replacement.op = .tree.operator_of(source);
        replacement.lhs = .tree.at(source).lhs;
        replacement.rhs = .tree.at(source).rhs;
        replacement.extra = .tree.at(source).extra;
        replacement.mantissa = .tree.at(source).mantissa;
        replacement.exponent = .tree.at(source).exponent;
        replacement.text = .tree.at(source).text;
        replacement.flag = .tree.at(source).flag;
        for child in .tree.at(source).parts: {
            replacement.parts.push_back(child);
        }
        .tree.replace(target, move(replacement));
        .rewrites += 1;
    }

    fn is_zero_literal(self: &const shared, index: int) -> bool: {
        if .tree.kind_of(index) != NodeKind::NumberLiteral: {
            return false;
        }
        return .tree.at(index).mantissa == 0;
    }

    fn is_one_literal(self: &const shared, index: int) -> bool: {
        if .tree.kind_of(index) != NodeKind::NumberLiteral: {
            return false;
        }
        var probe = make_decimal(.tree.at(index).mantissa, .tree.at(index).exponent);
        return decimal_equal(probe, decimal_from_int(1));
    }

    fn is_true_literal(self: &const shared, index: int) -> bool: {
        if .tree.kind_of(index) != NodeKind::BoolLiteral: {
            return false;
        }
        return .tree.at(index).flag;
    }

    fn is_false_literal(self: &const shared, index: int) -> bool: {
        if .tree.kind_of(index) != NodeKind::BoolLiteral: {
            return false;
        }
        return !.tree.at(index).flag;
    }

    tree: Arena;
    rewrites: int = 0;
    removed: int = 0;
}




static MAX_FOLD_ROUNDS: int = 4;

fn fold_to_fixed_point(tree: &unique Arena, root: int) -> int: {
    var total: int = 0;
    var round: int = 0;
    while round < MAX_FOLD_ROUNDS: {
        var pass = Folder();
        pass.tree = *tree;
        discard pass.fold(root);
        *tree = move(pass.tree);
        total += pass.rewrites;
        if pass.rewrites == 0: {
            break;
        }
        round += 1;
    }
    return total;
}












struct Printer: {

    fn print(self: &shared, index: int) -> string: {
        return .print_at(index, PRECEDENCE_NONE);
    }

    fn print_at(self: &shared, index: int, context_power: int) -> string: {
        if !.tree.valid(index): {
            return TEXT_EMPTY;
        }
        let kind = .tree.kind_of(index);

        if kind == NodeKind::NumberLiteral: {
            return .print_number(index);
        }
        if kind == NodeKind::TextLiteral: {
            return quote_text(.tree.at(index).text);
        }
        if kind == NodeKind::BoolLiteral: {
            if .tree.at(index).flag: {
                return WORD_TRUE;
            }
            return WORD_FALSE;
        }
        if kind == NodeKind::NullLiteral: {
            return WORD_NULL;
        }
        if kind == NodeKind::Empty: {
            return TEXT_SEMICOLON;
        }
        if kind == NodeKind::Variable: {
            return .tree.at(index).text;
        }
        if kind == NodeKind::Unary: {
            return .print_unary(index, context_power);
        }
        if kind == NodeKind::Postfix: {
            return .print_postfix(index);
        }
        if kind == NodeKind::Binary: {
            return .print_binary(index, context_power);
        }
        if kind == NodeKind::Assign: {
            return .print_assign(index, context_power);
        }
        if kind == NodeKind::Conditional: {
            return .print_conditional(index, context_power);
        }
        if kind == NodeKind::Call: {
            return .print_call(index);
        }
        if kind == NodeKind::Index: {
            return .print_index(index);
        }
        if kind == NodeKind::Member: {
            return .print_member(index);
        }
        if kind == NodeKind::Let: {
            return .print_let(index);
        }
        if kind == NodeKind::Block: {
            return .print_block(index);
        }
        if kind == NodeKind::Loop: {
            return .print_loop(index);
        }
        if kind == NodeKind::Return: {
            var out: string = "return ";
            out.append(.print_at(.tree.at(index).lhs, PRECEDENCE_NONE));
            return out;
        }
        return "<invalid>";
    }

    fn print_number(self: &shared, index: int) -> string: {
        var value = make_decimal(.tree.at(index).mantissa, .tree.at(index).exponent);
        return value.to_text();
    }

    fn print_unary(self: &shared, index: int, context_power: int) -> string: {
        var out = token_spelling(.tree.operator_of(index));
        
        if .tree.operator_of(index) == TokenKind::KeywordNot: {
            out.append(TEXT_SPACE);
        }
        let operand = .tree.at(index).lhs;
        
        if .tree.kind_of(operand) == NodeKind::Unary: {
            if .tree.operator_of(operand) == .tree.operator_of(index): {
                out.append(TEXT_SPACE);
            }
        }
        out.append(.print_at(operand, PRECEDENCE_PREFIX));
        return .wrap_if(out, PRECEDENCE_PREFIX, context_power);
    }

    fn print_postfix(self: &shared, index: int) -> string: {
        var out = .print_at(.tree.at(index).lhs, PRECEDENCE_POSTFIX);
        out.append(token_spelling(.tree.operator_of(index)));
        return out;
    }

    fn print_binary(self: &shared, index: int, context_power: int) -> string: {
        let op = .tree.operator_of(index);
        let power = infix_precedence(op);
        let right_associative = infix_associativity(op) == Associativity::Right;

        var left_power = power;
        var right_power = power + 1;
        if right_associative: {
            left_power = power + 1;
            right_power = power;
        }

        var out = .print_at(.tree.at(index).lhs, left_power);
        if .spaced_operator(op): {
            out.append(TEXT_SPACE);
            out.append(token_spelling(op));
            out.append(TEXT_SPACE);
        } else: {
            out.append(token_spelling(op));
        }
        out.append(.print_at(.tree.at(index).rhs, right_power));
        return .wrap_if(out, power, context_power);
    }

    fn print_assign(self: &shared, index: int, context_power: int) -> string: {
        var out = .print_at(.tree.at(index).lhs, PRECEDENCE_ASSIGN + 1);
        out.append(TEXT_SPACE);
        out.append(token_spelling(.tree.operator_of(index)));
        out.append(TEXT_SPACE);
        out.append(.print_at(.tree.at(index).rhs, PRECEDENCE_ASSIGN));
        return .wrap_if(out, PRECEDENCE_ASSIGN, context_power);
    }

    
    
    fn print_conditional(self: &shared, index: int, context_power: int) -> string: {
        var out: string = "";
        if .tree.at(index).flag: {
            out.append(.print_at(.tree.at(index).lhs, PRECEDENCE_CONDITIONAL + 1));
            out.append(TEXT_QUESTION_SPACE);
            out.append(.print_at(.tree.at(index).rhs, PRECEDENCE_NONE));
            out.append(TEXT_SPACE_COLON_SPACE);
            out.append(.print_at(.tree.at(index).extra, PRECEDENCE_CONDITIONAL));
            return .wrap_if(out, PRECEDENCE_CONDITIONAL, context_power);
        }
        out.append(WORD_IF);
        out.append(TEXT_SPACE);
        out.append(.print_at(.tree.at(index).lhs, PRECEDENCE_CONDITIONAL));
        out.append(TEXT_SPACE);
        out.append(WORD_THEN);
        out.append(TEXT_SPACE);
        out.append(.print_at(.tree.at(index).rhs, PRECEDENCE_CONDITIONAL));
        if .tree.kind_of(.tree.at(index).extra) != NodeKind::NullLiteral: {
            out.append(TEXT_SPACE);
            out.append(WORD_ELSE);
            out.append(TEXT_SPACE);
            out.append(.print_at(.tree.at(index).extra, PRECEDENCE_CONDITIONAL));
        }
        return .wrap_if(out, PRECEDENCE_CONDITIONAL, context_power);
    }

    fn print_call(self: &shared, index: int) -> string: {
        var out = .print_at(.tree.at(index).lhs, PRECEDENCE_POSTFIX);
        out.append(TEXT_LPAREN);
        var first = true;
        for child in .tree.at(index).parts: {
            if !first: {
                out.append(TEXT_COMMA_SPACE);
            }
            out.append(.print_argument(child));
            first = false;
        }
        out.append(TEXT_RPAREN);
        return out;
    }

    fn print_argument(self: &shared, index: int) -> string: {
        if .tree.kind_of(index) == NodeKind::Let && .tree.at(index).flag: {
            var out = .tree.at(index).text;
            out.append(TEXT_COLON_SPACE);
            out.append(.print_at(.tree.at(index).lhs, PRECEDENCE_ASSIGN));
            return out;
        }
        return .print_at(index, PRECEDENCE_ASSIGN);
    }

    fn print_index(self: &shared, index: int) -> string: {
        var out = .print_at(.tree.at(index).lhs, PRECEDENCE_POSTFIX);
        out.append(TEXT_LBRACKET);
        out.append(.print_at(.tree.at(index).rhs, PRECEDENCE_NONE));
        out.append(TEXT_RBRACKET);
        return out;
    }

    fn print_member(self: &shared, index: int) -> string: {
        var out = .print_at(.tree.at(index).lhs, PRECEDENCE_POSTFIX);
        out.append(TEXT_DOT);
        out.append(.tree.at(index).text);
        return out;
    }

    fn print_let(self: &shared, index: int) -> string: {
        var out = WORD_LET;
        out.append(TEXT_SPACE);
        out.append(.tree.at(index).text);
        out.append(" = ");
        out.append(.print_at(.tree.at(index).lhs, PRECEDENCE_NONE));
        return out;
    }

    fn print_loop(self: &shared, index: int) -> string: {
        var out = WORD_WHILE;
        out.append(TEXT_SPACE);
        out.append(.print_at(.tree.at(index).lhs, PRECEDENCE_NONE));
        out.append(TEXT_SPACE);
        out.append(.print_at(.tree.at(index).rhs, PRECEDENCE_NONE));
        return out;
    }

    fn print_block(self: &shared, index: int) -> string: {
        if .tree.at(index).parts.empty(): {
            return "{}";
        }
        var out = TEXT_LBRACE;
        out.append(TEXT_NEWLINE);
        .indent += 1;
        for statement in .tree.at(index).parts: {
            out.append(.padding());
            out.append(.print_at(statement, PRECEDENCE_NONE));
            out.append(TEXT_SEMICOLON);
            out.append(TEXT_NEWLINE);
        }
        .indent -= 1;
        out.append(.padding());
        out.append(TEXT_RBRACE);
        return out;
    }

    fn padding(self: &const shared) -> string: {
        var out: string = "";
        for i in range(0, .indent): {
            out.append(TEXT_INDENT);
            discard i;
        }
        return out;
    }

    
    
    fn spaced_operator(self: &const shared, op: TokenKind) -> bool: {
        if !.compact: {
            return true;
        }
        if infix_precedence(op) >= PRECEDENCE_MULTIPLICATIVE: {
            return false;
        }
        return true;
    }

    fn wrap_if(self: &const shared, body: &const shared string, power: int, context_power: int) -> string: {
        if power >= context_power: {
            return *body;
        }
        var out = TEXT_LPAREN;
        out.append(*body);
        out.append(TEXT_RPAREN);
        return out;
    }

    tree: Arena;
    indent: int = 0;
    compact: bool = false;
}


fn quote_text(text: &const shared string) -> string: {
    var out: string = "";
    out.push_back(CHAR_QUOTE);
    for i in range(0, text.size()): {
        let c = text.at(i);
        let escaped = encode_escape(c);
        if escaped.size() > 0: {
            out.append(escaped);
        } else: {
            out.push_back(c);
        }
    }
    out.push_back(CHAR_QUOTE);
    return out;
}

fn print_tree(tree: &shared Arena, root: int) -> string: {
    var writer = Printer();
    writer.tree = *tree;
    return writer.print(root);
}





fn dump_node(tree: &shared Arena, index: int, depth: int) -> string: {
    var out: string = "";
    for i in range(0, depth): {
        out.append(TEXT_INDENT);
        discard i;
    }
    if !tree.valid(index): {
        out.append("<none>\n");
        return out;
    }
    out.append(node_kind_name(tree.kind_of(index)));
    let op = tree.operator_of(index);
    if op != TokenKind::Invalid: {
        out.append(" '");
        out.append(token_spelling(op));
        out.append("'");
    }
    if tree.at(index).text.size() > 0: {
        out.append(" ");
        out.append(tree.at(index).text);
    }
    if tree.kind_of(index) == NodeKind::NumberLiteral: {
        out.append(" ");
        out.append(to_string(tree.at(index).mantissa));
        out.append("e");
        out.append(to_string(tree.at(index).exponent));
    }
    out.append(TEXT_NEWLINE);
    if tree.at(index).lhs != NO_NODE: {
        out.append(dump_node(tree, tree.at(index).lhs, depth + 1));
    }
    if tree.at(index).rhs != NO_NODE: {
        out.append(dump_node(tree, tree.at(index).rhs, depth + 1));
    }
    if tree.at(index).extra != NO_NODE: {
        out.append(dump_node(tree, tree.at(index).extra, depth + 1));
    }
    for child in tree.at(index).parts: {
        out.append(dump_node(tree, child, depth + 1));
    }
    return out;
}



fn trees_equal(left: &shared Arena, a: int, right: &shared Arena, b: int) -> bool: {
    if !left.valid(a) || !right.valid(b): {
        return left.valid(a) == right.valid(b);
    }
    if left.kind_of(a) != right.kind_of(b): {
        return false;
    }
    if left.operator_of(a) != right.operator_of(b): {
        return false;
    }
    if left.at(a).text != right.at(b).text: {
        return false;
    }
    if left.kind_of(a) == NodeKind::NumberLiteral: {
        let x = make_decimal(left.at(a).mantissa, left.at(a).exponent);
        let y = make_decimal(right.at(b).mantissa, right.at(b).exponent);
        if !decimal_equal(x, y): {
            return false;
        }
    }
    if left.at(a).flag != right.at(b).flag: {
        return false;
    }
    if left.at(a).parts.size() != right.at(b).parts.size(): {
        return false;
    }
    if !trees_equal(left, left.at(a).lhs, right, right.at(b).lhs): {
        return false;
    }
    if !trees_equal(left, left.at(a).rhs, right, right.at(b).rhs): {
        return false;
    }
    if !trees_equal(left, left.at(a).extra, right, right.at(b).extra): {
        return false;
    }
    for i in range(0, left.at(a).parts.size()): {
        if !trees_equal(left, left.at(a).parts[i], right, right.at(b).parts[i]): {
            return false;
        }
    }
    return true;
}





struct Session: {

    fn ready(self: &const shared) -> bool: {
        return .problem.ok();
    }

    fn last_error(self: &const shared) -> string: {
        return .problem.describe();
    }

    
    
    
    fn run(self: &unique, source: &const shared string) -> Value: {
        var parser: Parser;
        let root = parser.parse_program(source);
        if !parser.problem.ok(): {
            .problem = parser.problem;
            return failure_value(.problem.describe());
        }
        if .optimize: {
            .rewrites += fold_to_fixed_point(parser.tree, root);
        }
        .machine.tree = move(parser.tree);
        .machine.returning = false;
        let value = .machine.evaluate(root);
        .steps += .machine.steps;
        if value.is_failure(): {
            .problem = .machine.problem;
        }
        .last = value;
        return value;
    }

    fn define(self: &unique, name: &const shared string, value: Value): {
        .machine.environment.define_global(name, move(value));
    }

    fn bound(self: &const shared, name: &const shared string) -> bool: {
        return .machine.environment.bound(name);
    }

    fn value_of(self: &shared, name: &const shared string) -> &shared[self] Value: {
        return .machine.environment.lookup(name);
    }

    fn reset(self: &unique): {
        .machine.reset();
        .problem = Diagnostic();
        .steps = 0;
        .rewrites = 0;
        .last = nil_value();
    }

    machine: Interpreter;
    problem: Diagnostic;
    last: Value;
    steps: int = 0;
    rewrites: int = 0;
    optimize: bool = true;
}

fn make_session() -> Session: {
    var session: Session;
    session.machine.environment = make_environment();
    return session;
}


fn evaluate_text(source: &const shared string) -> Value: {
    var session = make_session();
    return session.run(source);
}





fn round_trips(source: &const shared string) -> bool: {
    var first: Parser;
    let a = first.parse_source(source);
    if !first.problem.ok(): {
        return false;
    }
    let printed = print_tree(first.tree, a);

    var second: Parser;
    let b = second.parse_source(printed);
    if !second.problem.ok(): {
        return false;
    }
    return trees_equal(first.tree, a, second.tree, b);
}



fn printing_is_stable(source: &const shared string) -> bool: {
    var first: Parser;
    let a = first.parse_source(source);
    if !first.problem.ok(): {
        return false;
    }
    let once = print_tree(first.tree, a);

    var second: Parser;
    let b = second.parse_source(once);
    if !second.problem.ok(): {
        return false;
    }
    let twice = print_tree(second.tree, b);
    return once == twice;
}






fn sample_expressions() -> vector{string}: {
    var samples: vector{string};
    samples.push_back("1 + 2 * 3 - 4 / 2");
    samples.push_back("2 ** 3 ** 2");
    samples.push_back("-x * -y + ~mask");
    samples.push_back("a < b && b < c || not done");
    samples.push_back("flags & 12 | 3 ^ 5");
    samples.push_back("value << 3 >> 1");
    samples.push_back("total += count * 2");
    samples.push_back("if ready then 1 else 0");
    samples.push_back("ready ? first : second");
    samples.push_back("points[0].x + points[1].y");
    samples.push_back("min(a, b) + max(c, d)");
    samples.push_back("offset(dx: 3, dy: 4)");
    samples.push_back("\"prefix \" + name + \" suffix\"");
    samples.push_back("counter++ + ++counter");
    samples.push_back("5! + 3!");
    samples.push_back("12.5 * 4 - 0.5");
    samples.push_back("list(1, 2, 3).length");
    samples.push_back("[1, 2, 3][1]");
    samples.push_back("(a + b) * (c - d)");
    samples.push_back("a = b = c = 0");
    samples.push_back("sum([10, 20, 30]) / 3");
    samples.push_back("upper(trim(\"  hello  \"))");
    return samples;
}

fn sample_programs() -> vector{string}: {
    var programs: vector{string};
    programs.push_back("let x = 3; let y = 4; sqrt(x ** 2 + y ** 2)");
    programs.push_back("let total = 0; let i = 0; while i < 10 { total += i; i++; } total");
    programs.push_back("let name = \"world\"; concat(\"hello \", name)");
    programs.push_back("let items = [1, 2, 3, 4]; sum(items) / len(items)");
    programs.push_back("let flag = true; if flag then \"yes\" else \"no\"");
    programs.push_back("let scale = 1000; let ratio = 3141 / scale; round(ratio)");
    
    
    programs.push_back("{ return 1; let unused = 2; unused + 3; }");
    return programs;
}






fn check_precedence_table(): {
    assert infix_precedence(TokenKind::Star) > infix_precedence(TokenKind::Plus);
    assert infix_precedence(TokenKind::Plus) > infix_precedence(TokenKind::LessLess);
    assert infix_precedence(TokenKind::LessLess) > infix_precedence(TokenKind::Less);
    assert infix_precedence(TokenKind::Less) > infix_precedence(TokenKind::EqualEqual);
    assert infix_precedence(TokenKind::EqualEqual) > infix_precedence(TokenKind::Amp);
    assert infix_precedence(TokenKind::Amp) > infix_precedence(TokenKind::Caret);
    assert infix_precedence(TokenKind::Caret) > infix_precedence(TokenKind::Pipe);
    assert infix_precedence(TokenKind::Pipe) > infix_precedence(TokenKind::AmpAmp);
    assert infix_precedence(TokenKind::AmpAmp) > infix_precedence(TokenKind::PipePipe);
    assert infix_precedence(TokenKind::PipePipe) > infix_precedence(TokenKind::Question);
    assert infix_precedence(TokenKind::Question) > infix_precedence(TokenKind::Equal);
    assert infix_precedence(TokenKind::StarStar) > infix_precedence(TokenKind::Star);
    assert prefix_precedence(TokenKind::Bang) > infix_precedence(TokenKind::StarStar);
    assert postfix_precedence(TokenKind::LParen) > prefix_precedence(TokenKind::Bang);
    prove infix_precedence(TokenKind::Identifier) == PRECEDENCE_NONE;
    prove infix_associativity(TokenKind::StarStar) == Associativity::Right;
    prove infix_associativity(TokenKind::Minus) == Associativity::Left;
}

fn check_table_is_consistent(): {
    let rows = operator_table();
    for row: &const in rows: {
        assert row.precedence == infix_precedence(row.kind);
        assert row.associativity == infix_associativity(row.kind);
        assert row.spelling == token_spelling(row.kind);
        if row.mutating: {
            assert is_assignment_operator(row.kind);
        }
    }
}

fn check_tokenizer(): {
    let tokens = tokenize("a + 12.5 * \"text\" // trailing");
    assert tokens.size() > 0;
    assert tokens[0].kind == TokenKind::Identifier;
    assert tokens[1].kind == TokenKind::Plus;
    assert tokens[2].kind == TokenKind::Number;
    assert tokens[2].mantissa == 125;
    assert tokens[2].exponent == -1;
    assert tokens[3].kind == TokenKind::Star;
    assert tokens[4].kind == TokenKind::Text;
    assert tokens[tokens.size() - 1].kind == TokenKind::End;
}

fn check_maximal_munch(): {
    let tokens = tokenize("a <<= b >>= c ++ d -- e ** f");
    assert tokens[1].kind == TokenKind::LessLessEqual;
    assert tokens[3].kind == TokenKind::GreaterGreaterEqual;
    assert tokens[5].kind == TokenKind::PlusPlus;
    assert tokens[7].kind == TokenKind::MinusMinus;
    assert tokens[9].kind == TokenKind::StarStar;
}

fn check_decimals(): {
    let a = make_decimal(125, -1);
    let b = make_decimal(5, -1);
    assert decimal_add(a, b).to_text() == "13";
    assert decimal_subtract(a, b).to_text() == "12";
    assert decimal_multiply(a, decimal_from_int(2)).to_text() == "25";
    assert decimal_compare(a, b) > 0;
    assert decimal_equal(make_decimal(150, -2), make_decimal(15, -1));
    prove decimal_from_int(0).is_zero();
}

fn check_parses(): {
    for source: &const in sample_expressions(): {
        var parser: Parser;
        let root = parser.parse_source(source);
        assert root != NO_NODE;
        assert parser.problem.ok();
    }
}

fn check_round_trip(): {
    for source: &const in sample_expressions(): {
        assert round_trips(source);
        assert printing_is_stable(source);
    }
}

fn check_associativity_shape(): {
    
    
    var parser: Parser;
    let root = parser.parse_source("2 ** 3 ** 2");
    assert parser.tree.kind_of(root) == NodeKind::Binary;
    assert parser.tree.operator_of(root) == TokenKind::StarStar;
    let right = parser.tree.at(root).rhs;
    assert parser.tree.kind_of(right) == NodeKind::Binary;
    assert parser.tree.operator_of(right) == TokenKind::StarStar;

    
    var other: Parser;
    let flat = other.parse_source("1 - 2 - 3");
    assert other.tree.kind_of(other.tree.at(flat).lhs) == NodeKind::Binary;
    assert other.tree.kind_of(other.tree.at(flat).rhs) == NodeKind::NumberLiteral;
}

fn check_folding(): {
    var parser: Parser;
    let root = parser.parse_source("1 + 2 * 3");
    let changes = fold_to_fixed_point(parser.tree, root);
    assert changes > 0;
    assert parser.tree.kind_of(root) == NodeKind::NumberLiteral;
    assert parser.tree.at(root).mantissa == 7;
}

fn check_identity_folding(): {
    var parser: Parser;
    let root = parser.parse_source("x * 1 + 0");
    discard fold_to_fixed_point(parser.tree, root);
    assert parser.tree.kind_of(root) == NodeKind::Variable;
    assert parser.tree.at(root).text == "x";
}

fn check_dead_branch(): {
    var parser: Parser;
    let root = parser.parse_source("if true then 1 else 2");
    discard fold_to_fixed_point(parser.tree, root);
    assert parser.tree.kind_of(root) == NodeKind::NumberLiteral;
    assert parser.tree.at(root).mantissa == 1;
}

fn check_evaluation(): {
    assert evaluate_text("1 + 2 * 3").to_text() == "7";
    assert evaluate_text("2 ** 10").to_text() == "1024";
    assert evaluate_text("10 / 4").to_text() == "2.5";
    assert evaluate_text("7 % 3").to_text() == "1";
    assert evaluate_text("\"a\" + \"b\"").to_text() == "ab";
    assert evaluate_text("len([1, 2, 3])").to_text() == "3";
    assert evaluate_text("true && false").to_text() == WORD_FALSE;
    assert evaluate_text("1 < 2 && 2 < 3").truthy();
}

fn check_scoping(): {
    var session = make_session();
    discard session.run("let outer = 1;");
    assert session.bound("outer");
    discard session.run("{ let inner = 2; inner + outer; }");
    
    assert session.bound("outer");
    assert !session.bound("inner");
}

fn check_errors(): {
    var parser: Parser;
    let root = parser.parse_source("1 +");
    assert root == NO_NODE || !parser.problem.ok();
    assert parser.problem.code == ErrorCode::ExpectedExpression;

    var second: Parser;
    discard second.parse_source("(1 + 2");
    assert second.problem.code == ErrorCode::UnbalancedParen;

    var third: Parser;
    discard third.parse_source("1 = 2");
    assert third.problem.code == ErrorCode::NotAssignable;
}

fn check_programs(): {
    for source: &const in sample_programs(): {
        var session = make_session();
        let value = session.run(source);
        assert !value.is_failure();
    }
}



fn run_all_checks(): {
    check_precedence_table();
    check_table_is_consistent();
    check_tokenizer();
    check_maximal_munch();
    check_decimals();
    check_parses();
    check_round_trip();
    check_associativity_shape();
    check_folding();
    check_identity_folding();
    check_dead_branch();
    check_evaluation();
    check_scoping();
    check_errors();
    check_programs();
    println("expression language: all checks passed");
}



fn repl(lines: &const shared vector{string}) -> int: {
    var session = make_session();
    var failures: int = 0;
    for line: &const in *lines: {
        let trimmed = text_trim(line);
        if trimmed.empty(): {
            continue;
        }
        let value = session.run(trimmed);
        if value.is_failure(): {
            failures += 1;
            println(session.last_error());
        } else: {
            println(value.to_text());
        }
    }
    return failures;
}

}


































namespace graph: {




static GRAPH_NIL: int = -1;



static GRAPH_INFINITY: int = 1000000000;


static WEIGHT_SCALE: int = 1000;


static UNIT_WEIGHT: int = 1000;


static GRAPH_INITIAL_ORDER: int = 32;



static GRAPH_GROWTH_PERCENT: int = 175;



static GRAPH_STACK_HINT: int = 64;



static GRAPH_RELAX_LIMIT: int = 4096;



static GRAPH_AUGMENT_LIMIT: int = 100000;




enum EdgeDirection: {
    Directed;
    Undirected = 1;
}



enum WeightMode: {
    Unweighted;
    Weighted = 1;
}


enum ColorMark: {
    White;
    Gray;
    Black = 2;
}


enum VisitAction: {
    Continue;
    SkipChildren;
    StopTraversal = 2;
}


enum EdgeClass: {
    TreeEdge;
    BackEdge;
    ForwardEdge;
    CrossEdge = 3;
}


enum OrderStatus: {
    TotalOrder;
    CycleFound = 1;
}


enum Side: {
    Unassigned;
    LeftSide;
    RightSide = 2;
}










template(V: type, W: type)
struct Edge: {

    
    
    fn other(self: &const shared, endpoint: int) -> int: {
        if .tail == endpoint: {
            return .head;
        }
        return .tail;
    }

    fn touches(self: &const shared, vertex: int) -> bool: {
        return .tail == vertex || .head == vertex;
    }

    fn is_loop(self: &const shared) -> bool: {
        return .tail == .head;
    }

    fn is_live(self: &const shared) -> bool: {
        return .alive && .tail != GRAPH_NIL;
    }

    
    fn twin_id(self: &const shared) -> int: {
        return .id ^ 1;
    }

    tail: int = 0;
    head: int = 0;
    weight: int = 0;
    capacity: int = 0;
    id: int = 0;
    pair_id: int = 0;
    alive: bool = true;
    payload: W;
    tag: V;
}








template(V: type)
struct Vertex: {

    fn degree(self: &const shared) -> int: {
        return .incident.size();
    }

    fn is_isolated(self: &const shared) -> bool: {
        return .incident.empty();
    }

    fn clear_marks(self: &unique): {
        .color = ColorMark::White;
        .discovered = GRAPH_NIL;
        .finished = GRAPH_NIL;
        .parent = GRAPH_NIL;
        .component = GRAPH_NIL;
        .side = Side::Unassigned;
    }

    incident: vector{int};
    incoming: vector{int};
    payload: V;
    id: int = 0;
    color: ColorMark = ColorMark::White;
    discovered: int = -1;
    finished: int = -1;
    parent: int = -1;
    component: int = -1;
    side: Side = Side::Unassigned;
}









template(V: type, W: type)
struct AdjacencyList: {

    fn order(self: &const shared) -> int: {
        return .vertices.size();
    }

    fn arc_count(self: &const shared) -> int: {
        return .edges.size();
    }

    
    fn size(self: &const shared) -> int: {
        if .direction == EdgeDirection::Undirected: {
            return .edges.size() / 2;
        }
        return .edges.size();
    }

    fn is_directed(self: &const shared) -> bool: {
        return .direction == EdgeDirection::Directed;
    }

    fn is_weighted(self: &const shared) -> bool: {
        return .mode == WeightMode::Weighted;
    }

    fn valid_vertex(self: &const shared, v: int) -> bool: {
        return v >= 0 && v < .vertices.size();
    }

    fn vertex(self: &shared, v: int) -> &shared[self] Vertex{V}: {
        return .vertices.at(v);
    }

    fn arc(self: &shared, e: int) -> &shared[self] Edge{V, W}: {
        return .edges.at(e);
    }

    fn incident_of(self: &shared, v: int) -> &shared[self] vector{int}: {
        return .vertices.at(v).incident;
    }

    fn degree(self: &const shared, v: int) -> int: {
        return .vertices.at(v).incident.size();
    }

    fn in_degree(self: &const shared, v: int) -> int: {
        if .direction == EdgeDirection::Undirected: {
            return .vertices.at(v).incident.size();
        }
        return .vertices.at(v).incoming.size();
    }

    fn out_degree(self: &const shared, v: int) -> int: {
        return .vertices.at(v).incident.size();
    }

    
    fn add_vertex(self: &unique, payload: V) -> int: {
        let id = .vertices.size();
        var v = Vertex{V}(id: id, payload: payload);
        .vertices.push_back(move(v));
        return id;
    }

    
    fn reserve_vertices(self: &unique, n: int): {
        .vertices.reserve(n);
        while .vertices.size() < n: {
            let id = .vertices.size();
            .vertices.push_back(Vertex{V}(id: id));
        }
    }

    
    fn connect(self: &unique, tail: int, head: int, weight: int) -> int: {
        assert tail >= 0;
        assert head >= 0;
        let first = .edges.size();
        var forward = Edge{V, W}(tail: tail,
                                 head: head,
                                 weight: weight,
                                 capacity: weight,
                                 id: first,
                                 pair_id: first);
        .edges.push_back(move(forward));
        .vertices.at(tail).incident.push_back(first);
        if .direction == EdgeDirection::Undirected: {
            let second = .edges.size();
            var backward = Edge{V, W}(tail: head,
                                      head: tail,
                                      weight: weight,
                                      capacity: weight,
                                      id: second,
                                      pair_id: first);
            .edges.push_back(move(backward));
            .vertices.at(head).incident.push_back(second);
        } else: {
            .vertices.at(head).incoming.push_back(first);
        }
        return first;
    }

    fn connect_unweighted(self: &unique, tail: int, head: int) -> int: {
        return .connect(tail, head, UNIT_WEIGHT);
    }

    
    fn disconnect(self: &unique, e: int) -> bool: {
        if e < 0 || e >= .edges.size(): {
            return false;
        }
        let arc: &unique = .edges.at(e);
        if arc.alive == false: {
            return false;
        }
        arc.alive = false;
        if .direction == EdgeDirection::Undirected: {
            let twin: &unique = .edges.at(arc.twin_id());
            twin.alive = false;
        }
        return true;
    }

    fn has_edge(self: &const shared, tail: int, head: int) -> bool: {
        for e: &const in .vertices.at(tail).incident: {
            let arc: &const = .edges.at(e);
            if arc.alive && arc.head == head: {
                return true;
            }
        }
        return false;
    }

    fn weight_between(self: &const shared, tail: int, head: int) -> int: {
        for e: &const in .vertices.at(tail).incident: {
            let arc: &const = .edges.at(e);
            if arc.alive && arc.head == head: {
                return arc.weight;
            }
        }
        return GRAPH_INFINITY;
    }

    fn reset_marks(self: &unique): {
        for v: &unique in .vertices: {
            v.clear_marks();
        }
    }

    fn clear(self: &unique): {
        .vertices.clear();
        .edges.clear();
    }

    vertices: vector{Vertex{V}};
    edges: vector{Edge{V, W}};
    direction: EdgeDirection = EdgeDirection::Directed;
    mode: WeightMode = WeightMode::Weighted;
    label: string;
}









template(V: type, W: type, N: int)
struct AdjacencyMatrix: {

    fn order(self: &const shared) -> int: {
        return N;
    }

    fn cell_count(self: &const shared) -> int: {
        return N * N;
    }

    fn index_of(self: &const shared, row: int, col: int) -> int: {
        return row * N + col;
    }

    fn at(self: &shared, row: int, col: int) -> &shared[self] int: {
        return .cells.at(row * N + col);
    }

    fn get(self: &const shared, row: int, col: int) -> int: {
        return .cells.at(row * N + col);
    }

    fn put(self: &unique, row: int, col: int, value: int): {
        .cells.at(row * N + col) = value;
        if .direction == EdgeDirection::Undirected: {
            .cells.at(col * N + row) = value;
        }
    }

    fn linked(self: &const shared, row: int, col: int) -> bool: {
        return .cells.at(row * N + col) < GRAPH_INFINITY;
    }

    fn fill(self: &unique, value: int): {
        .cells.clear();
        var k: int = 0;
        while k < N * N: {
            .cells.push_back(value);
            k += 1;
        }
    }

    
    fn reset(self: &unique): {
        .fill(GRAPH_INFINITY);
        var d: int = 0;
        while d < N: {
            .cells.at(d * N + d) = 0;
            d += 1;
        }
    }

    fn row_sum(self: &const shared, row: int) -> int: {
        var total: int = 0;
        var c: int = 0;
        while c < N: {
            let value = .cells.at(row * N + c);
            if value < GRAPH_INFINITY: {
                total += value;
            }
            c += 1;
        }
        return total;
    }

    fn symmetric(self: &const shared) -> bool: {
        var r: int = 0;
        while r < N: {
            var c = r + 1;
            while c < N: {
                if .cells.at(r * N + c) != .cells.at(c * N + r): {
                    return false;
                }
                c += 1;
            }
            r += 1;
        }
        return true;
    }

    cells: vector{int};
    payloads: vector{V};
    slack: W;
    direction: EdgeDirection = EdgeDirection::Directed;
    mode: WeightMode = WeightMode::Weighted;
}






struct HeapEntry: {

    fn better_than(self: &const shared, other: &const shared HeapEntry) -> bool: {
        if .priority != other.priority: {
            return .priority < other.priority;
        }
        return .vertex < other.vertex;
    }

    vertex: int = 0;
    priority: int = 0;
    stamp: int = 0;
}








struct BinaryHeap: {

    fn size(self: &const shared) -> int: {
        return .items.size();
    }

    fn empty(self: &const shared) -> bool: {
        return .items.empty();
    }

    fn parent_of(self: &const shared, i: int) -> int: {
        return (i - 1) / 2;
    }

    fn left_of(self: &const shared, i: int) -> int: {
        return 2 * i + 1;
    }

    fn right_of(self: &const shared, i: int) -> int: {
        return 2 * i + 2;
    }

    
    fn sift_up(self: &unique, start: int) -> int: {
        var i = start;
        while i > 0: {
            let p = (i - 1) / 2;
            if .items.at(i).better_than(.items.at(p)) == false: {
                break;
            }
            .swap_slots(i, p);
            i = p;
        }
        return i;
    }

    
    fn sift_down(self: &unique, start: int) -> int: {
        var i = start;
        let n = .items.size();
        loop: {
            let l = 2 * i + 1;
            let r = 2 * i + 2;
            var best = i;
            if l < n: {
                if .items.at(l).better_than(.items.at(best)): {
                    best = l;
                }
            }
            if r < n: {
                if .items.at(r).better_than(.items.at(best)): {
                    best = r;
                }
            }
            if best == i: {
                break;
            }
            .swap_slots(i, best);
            i = best;
        }
        return i;
    }

    fn swap_slots(self: &unique, a: int, b: int): {
        swap(.items.at(a), .items.at(b));
        if .tracked: {
            .position.at(.items.at(a).vertex) = a;
            .position.at(.items.at(b).vertex) = b;
        }
    }

    fn push(self: &unique, vertex: int, priority: int): {
        let slot = .items.size();
        .items.push_back(HeapEntry(vertex: vertex, priority: priority, stamp: .clock));
        .clock += 1;
        if .tracked: {
            .position.at(vertex) = slot;
        }
        discard .sift_up(slot);
    }

    fn peek(self: &shared) -> &shared[self] HeapEntry: {
        return .items.front();
    }

    fn pop(self: &unique) -> HeapEntry: {
        let top = .items.front();
        let last = .items.size() - 1;
        .swap_slots(0, last);
        .items.pop_back();
        if .items.empty() == false: {
            discard .sift_down(0);
        }
        if .tracked: {
            .position.at(top.vertex) = GRAPH_NIL;
        }
        return top;
    }

    
    
    fn decrease_key(self: &unique, vertex: int, priority: int) -> bool: {
        if .tracked == false: {
            .push(vertex, priority);
            return true;
        }
        let slot = .position.at(vertex);
        if slot == GRAPH_NIL: {
            .push(vertex, priority);
            return true;
        }
        if .items.at(slot).priority <= priority: {
            return false;
        }
        .items.at(slot).priority = priority;
        discard .sift_up(slot);
        return true;
    }

    fn contains(self: &const shared, vertex: int) -> bool: {
        if .tracked == false: {
            return false;
        }
        return .position.at(vertex) != GRAPH_NIL;
    }

    fn prepare(self: &unique, order: int): {
        .items.clear();
        .position.clear();
        .tracked = true;
        var i: int = 0;
        while i < order: {
            .position.push_back(GRAPH_NIL);
            i += 1;
        }
    }

    fn clear(self: &unique): {
        .items.clear();
        .position.clear();
        .clock = 0;
    }

    items: vector{HeapEntry};
    position: vector{int};
    tracked: bool = false;
    clock: int = 0;
}






struct UnionFind: {

    fn prepare(self: &unique, order: int): {
        .parent.clear();
        .rank.clear();
        .weight.clear();
        var i: int = 0;
        while i < order: {
            .parent.push_back(i);
            .rank.push_back(0);
            .weight.push_back(1);
            i += 1;
        }
        .components = order;
    }

    fn find(self: &unique, x: int) -> int: {
        var root = x;
        while .parent.at(root) != root: {
            root = .parent.at(root);
        }
        var walker = x;
        while walker != root: {
            let next = .parent.at(walker);
            .parent.at(walker) = root;
            walker = next;
        }
        return root;
    }

    fn connected(self: &unique, a: int, b: int) -> bool: {
        return .find(a) == .find(b);
    }

    fn unite(self: &unique, a: int, b: int) -> bool: {
        var ra = .find(a);
        var rb = .find(b);
        if ra == rb: {
            return false;
        }
        if .rank.at(ra) < .rank.at(rb): {
            swap(ra, rb);
        }
        .parent.at(rb) = ra;
        .weight.at(ra) += .weight.at(rb);
        if .rank.at(ra) == .rank.at(rb): {
            .rank.at(ra) += 1;
        }
        .components -= 1;
        assert .components >= 1;
        return true;
    }

    fn set_size(self: &unique, x: int) -> int: {
        let root = .find(x);
        return .weight.at(root);
    }

    fn single_component(self: &const shared) -> bool: {
        return .components == 1;
    }

    parent: vector{int};
    rank: vector{int};
    weight: vector{int};
    components: int = 0;
}


fn fill_int_vector(target: &unique vector{int}, count: int, value: int): {
    target.clear();
    var i: int = 0;
    while i < count: {
        target.push_back(value);
        i += 1;
    }
}


fn fill_bool_vector(target: &unique vector{bool}, count: int, value: bool): {
    target.clear();
    var i: int = 0;
    while i < count: {
        target.push_back(value);
        i += 1;
    }
}



fn reverse_int_vector(target: &unique vector{int}): {
    var lo: int = 0;
    var hi = target.size() - 1;
    while lo < hi: {
        swap(target.at(lo), target.at(hi));
        lo += 1;
        hi -= 1;
    }
}


fn add_distance(a: int, b: int) -> int: {
    if a >= GRAPH_INFINITY || b >= GRAPH_INFINITY: {
        return GRAPH_INFINITY;
    }
    return a + b;
}


fn is_unreachable(d: int) -> bool: {
    return d >= GRAPH_INFINITY;
}








namespace builders: {


template(V: type, W: type)
fn directed(n: int) -> AdjacencyList{V, W}: {
    var g = AdjacencyList{V, W}(direction: EdgeDirection::Directed,
                                mode: WeightMode::Weighted);
    g.reserve_vertices(n);
    return g;
}


template(V: type, W: type)
fn undirected(n: int) -> AdjacencyList{V, W}: {
    var g = AdjacencyList{V, W}(direction: EdgeDirection::Undirected,
                                mode: WeightMode::Weighted);
    g.reserve_vertices(n);
    return g;
}



template(V: type, W: type)
fn directed_unweighted(n: int) -> AdjacencyList{V, W}: {
    var g = directed{V, W}(n);
    g.mode = WeightMode::Unweighted;
    return g;
}

template(V: type, W: type)
fn undirected_unweighted(n: int) -> AdjacencyList{V, W}: {
    var g = undirected{V, W}(n);
    g.mode = WeightMode::Unweighted;
    return g;
}


template(V: type, W: type)
fn path_graph(n: int) -> AdjacencyList{V, W}: {
    var g = undirected_unweighted{V, W}(n);
    var i: int = 1;
    while i < n: {
        discard g.connect_unweighted(i - 1, i);
        i += 1;
    }
    return g;
}


template(V: type, W: type)
fn cycle_graph(n: int) -> AdjacencyList{V, W}: {
    var g = path_graph{V, W}(n);
    if n > 2: {
        discard g.connect_unweighted(n - 1, 0);
    }
    return g;
}


template(V: type, W: type)
fn complete_graph(n: int) -> AdjacencyList{V, W}: {
    var g = undirected_unweighted{V, W}(n);
    var i: int = 0;
    while i < n: {
        var j = i + 1;
        while j < n: {
            discard g.connect_unweighted(i, j);
            j += 1;
        }
        i += 1;
    }
    return g;
}


template(V: type, W: type)
fn grid_graph(rows: int, cols: int) -> AdjacencyList{V, W}: {
    var g = undirected_unweighted{V, W}(rows * cols);
    var r: int = 0;
    while r < rows: {
        var c: int = 0;
        while c < cols: {
            let here = r * cols + c;
            if c + 1 < cols: {
                discard g.connect_unweighted(here, here + 1);
            }
            if r + 1 < rows: {
                discard g.connect_unweighted(here, here + cols);
            }
            c += 1;
        }
        r += 1;
    }
    return g;
}



template(V: type, W: type)
fn complete_bipartite(left: int, right: int) -> AdjacencyList{V, W}: {
    var g = undirected_unweighted{V, W}(left + right);
    var a: int = 0;
    while a < left: {
        var b: int = 0;
        while b < right: {
            discard g.connect_unweighted(a, left + b);
            b += 1;
        }
        a += 1;
    }
    return g;
}


template(V: type, W: type)
fn binary_tree_graph(n: int) -> AdjacencyList{V, W}: {
    var g = undirected_unweighted{V, W}(n);
    var i: int = 1;
    while i < n: {
        discard g.connect_unweighted((i - 1) / 2, i);
        i += 1;
    }
    return g;
}



template(V: type, W: type)
fn transpose(g: &const shared AdjacencyList{V, W}) -> AdjacencyList{V, W}: {
    var out = AdjacencyList{V, W}(direction: g.direction, mode: g.mode);
    out.reserve_vertices(g.order());
    for arc: &const in g.edges: {
        if arc.alive: {
            discard out.connect(arc.head, arc.tail, arc.weight);
        }
    }
    return out;
}


template(V: type, W: type)
fn to_undirected(g: &const shared AdjacencyList{V, W}) -> AdjacencyList{V, W}: {
    var out = undirected{V, W}(g.order());
    out.mode = g.mode;
    for arc: &const in g.edges: {
        if arc.alive && arc.tail < arc.head: {
            discard out.connect(arc.tail, arc.head, arc.weight);
        }
    }
    return out;
}


template(V: type, W: type)
fn to_directed(g: &const shared AdjacencyList{V, W}) -> AdjacencyList{V, W}: {
    var out = directed{V, W}(g.order());
    out.mode = g.mode;
    for arc: &const in g.edges: {
        if arc.alive: {
            discard out.connect(arc.tail, arc.head, arc.weight);
        }
    }
    return out;
}


template(V: type, W: type)
fn filter_by_weight(g: &const shared AdjacencyList{V, W},
                    limit: int) -> AdjacencyList{V, W}: {
    var out = AdjacencyList{V, W}(direction: g.direction, mode: g.mode);
    out.reserve_vertices(g.order());
    for arc: &const in g.edges: {
        if arc.alive && arc.weight <= limit: {
            if g.direction == EdgeDirection::Directed || arc.tail < arc.head: {
                discard out.connect(arc.tail, arc.head, arc.weight);
            }
        }
    }
    return out;
}


template(V: type, W: type)
fn induced_subgraph(g: &const shared AdjacencyList{V, W},
                    keep: &const shared vector{bool}) -> AdjacencyList{V, W}: {
    var mapping = vector{int}();
    fill_int_vector(mapping, g.order(), GRAPH_NIL);
    var next: int = 0;
    var v: int = 0;
    while v < g.order(): {
        if keep.at(v): {
            mapping.at(v) = next;
            next += 1;
        }
        v += 1;
    }
    var out = AdjacencyList{V, W}(direction: g.direction, mode: g.mode);
    out.reserve_vertices(next);
    for arc: &const in g.edges: {
        if arc.alive && keep.at(arc.tail) && keep.at(arc.head): {
            if g.direction == EdgeDirection::Directed || arc.tail < arc.head: {
                discard out.connect(mapping.at(arc.tail),
                                    mapping.at(arc.head),
                                    arc.weight);
            }
        }
    }
    return out;
}





template(V: type, W: type, N: int)
fn densify(g: &const shared AdjacencyList{V, W}) -> AdjacencyMatrix{V, W, N}: {
    var m = AdjacencyMatrix{V, W, N}(direction: g.direction, mode: g.mode);
    m.reset();
    for arc: &const in g.edges: {
        if arc.alive && arc.tail < N && arc.head < N: {
            let current = m.get(arc.tail, arc.head);
            if arc.weight < current: {
                m.put(arc.tail, arc.head, arc.weight);
            }
        }
    }
    return m;
}


template(V: type, W: type, N: int)
fn sparsify(m: &const shared AdjacencyMatrix{V, W, N}) -> AdjacencyList{V, W}: {
    var g = AdjacencyList{V, W}(direction: m.direction, mode: m.mode);
    g.reserve_vertices(N);
    var r: int = 0;
    while r < N: {
        var c: int = 0;
        while c < N: {
            if r != c: {
                let value = m.get(r, c);
                if value < GRAPH_INFINITY: {
                    if m.direction == EdgeDirection::Directed || r < c: {
                        discard g.connect(r, c, value);
                    }
                }
            }
            c += 1;
        }
        r += 1;
    }
    return g;
}




template(V: type, W: type)
fn shift_weights(g: &unique AdjacencyList{V, W}, delta: int): {
    for arc: &unique in g.edges: {
        arc.weight += delta;
    }
}


template(V: type, W: type)
fn scale_weights(g: &unique AdjacencyList{V, W}, ratio: int): {
    for arc: &unique in g.edges: {
        arc.weight = arc.weight * ratio / WEIGHT_SCALE;
    }
}



template(V: type, W: type)
fn total_weight(g: &const shared AdjacencyList{V, W}) -> int: {
    var total: int = 0;
    for arc: &const in g.edges: {
        if arc.alive: {
            total += arc.weight;
        }
    }
    if g.direction == EdgeDirection::Undirected: {
        return total / 2;
    }
    return total;
}


template(V: type, W: type)
fn describe(g: &const shared AdjacencyList{V, W}) -> string: {
    var out = string();
    out.append(to_string(g.order()));
    out.append("v/");
    out.append(to_string(g.size()));
    out.append("e");
    if g.is_directed(): {
        out.append(" directed");
    } else: {
        out.append(" undirected");
    }
    if g.is_weighted(): {
        out.append(" weighted");
    }
    return out;
}

}









namespace traversal: {









template(V: type, W: type)
struct Visitor: {

    
    fn on_discover(self: &unique, v: int) -> VisitAction: {
        .discovery_order.push_back(v);
        .visited_count += 1;
        if .blocked.empty() == false: {
            if .blocked.at(v): {
                return VisitAction::SkipChildren;
            }
        }
        if .stop_after > 0 && .visited_count >= .stop_after: {
            return VisitAction::StopTraversal;
        }
        return VisitAction::Continue;
    }

    
    fn on_finish(self: &unique, v: int) -> VisitAction: {
        .finish_order.push_back(v);
        return VisitAction::Continue;
    }

    
    fn on_edge(self: &unique, arc: int, kind: EdgeClass) -> VisitAction: {
        .edge_order.push_back(arc);
        if kind == EdgeClass::BackEdge: {
            .back_edges += 1;
        }
        if kind == EdgeClass::TreeEdge: {
            .tree_edges += 1;
        }
        return VisitAction::Continue;
    }

    
    fn on_restart(self: &unique, root: int): {
        .roots.push_back(root);
    }

    fn prepare(self: &unique, order: int): {
        .discovery_order.clear();
        .finish_order.clear();
        .edge_order.clear();
        .roots.clear();
        .visited_count = 0;
        .back_edges = 0;
        .tree_edges = 0;
        fill_bool_vector(.blocked, order, false);
    }

    fn block(self: &unique, v: int): {
        .blocked.at(v) = true;
    }

    fn saw(self: &const shared, v: int) -> bool: {
        for seen: &const in .discovery_order: {
            if seen == v: {
                return true;
            }
        }
        return false;
    }

    discovery_order: vector{int};
    finish_order: vector{int};
    edge_order: vector{int};
    roots: vector{int};
    blocked: vector{bool};
    visited_count: int = 0;
    back_edges: int = 0;
    tree_edges: int = 0;
    stop_after: int = 0;
    sample: W;
    label: V;
}


template(V: type)
struct SearchResult: {

    fn reached(self: &const shared, v: int) -> bool: {
        return .depth.at(v) < GRAPH_INFINITY;
    }

    fn reached_count(self: &const shared) -> int: {
        var total: int = 0;
        for d: &const in .depth: {
            if d < GRAPH_INFINITY: {
                total += 1;
            }
        }
        return total;
    }

    fn eccentricity(self: &const shared) -> int: {
        var best: int = 0;
        for d: &const in .depth: {
            if d < GRAPH_INFINITY && d > best: {
                best = d;
            }
        }
        return best;
    }

    
    fn path_to(self: &const shared, v: int) -> vector{int}: {
        var out = vector{int}();
        if .depth.at(v) >= GRAPH_INFINITY: {
            return out;
        }
        var walker = v;
        while walker != GRAPH_NIL: {
            out.push_back(walker);
            walker = .parent.at(walker);
        }
        reverse_int_vector(out);
        return out;
    }

    parent: vector{int};
    depth: vector{int};
    order: vector{int};
    payload: V;
    source: int = -1;
    complete: bool = true;
}





template(V: type, W: type)
fn bfs(g: &const shared AdjacencyList{V, W}, source: int) -> SearchResult{V}: {
    var out = SearchResult{V}(source: source);
    fill_int_vector(out.parent, g.order(), GRAPH_NIL);
    fill_int_vector(out.depth, g.order(), GRAPH_INFINITY);
    if g.valid_vertex(source) == false: {
        out.complete = false;
        return out;
    }
    var queue = vector{int}();
    queue.push_back(source);
    out.depth.at(source) = 0;
    var head: int = 0;
    while head < queue.size(): {
        let v = queue.at(head);
        head += 1;
        out.order.push_back(v);
        for e: &const in g.vertices.at(v).incident: {
            let arc: &const = g.edges.at(e);
            if arc.alive == false: {
                continue;
            }
            let next = arc.head;
            if out.depth.at(next) >= GRAPH_INFINITY: {
                out.depth.at(next) = out.depth.at(v) + 1;
                out.parent.at(next) = v;
                queue.push_back(next);
            }
        }
    }
    assert out.depth.at(source) == 0;
    return out;
}


template(V: type, W: type)
fn bfs_visit(g: &const shared AdjacencyList{V, W},
             source: int,
             watcher: &unique Visitor{V, W}) -> SearchResult{V}: {
    var out = SearchResult{V}(source: source);
    fill_int_vector(out.parent, g.order(), GRAPH_NIL);
    fill_int_vector(out.depth, g.order(), GRAPH_INFINITY);
    watcher.prepare(g.order());
    var queue = vector{int}();
    queue.push_back(source);
    out.depth.at(source) = 0;
    var head: int = 0;
    while head < queue.size(): {
        let v = queue.at(head);
        head += 1;
        let verdict = watcher.on_discover(v);
        if verdict == VisitAction::StopTraversal: {
            out.complete = false;
            return out;
        }
        if verdict == VisitAction::SkipChildren: {
            continue;
        }
        out.order.push_back(v);
        for e: &const in g.vertices.at(v).incident: {
            let arc: &const = g.edges.at(e);
            if arc.alive == false: {
                continue;
            }
            let next = arc.head;
            if out.depth.at(next) >= GRAPH_INFINITY: {
                discard watcher.on_edge(e, EdgeClass::TreeEdge);
                out.depth.at(next) = out.depth.at(v) + 1;
                out.parent.at(next) = v;
                queue.push_back(next);
            } else: {
                discard watcher.on_edge(e, EdgeClass::CrossEdge);
            }
        }
        discard watcher.on_finish(v);
    }
    return out;
}



template(V: type, W: type)
fn bfs_multi(g: &const shared AdjacencyList{V, W},
             sources: &const shared vector{int}) -> SearchResult{V}: {
    var out = SearchResult{V}(source: GRAPH_NIL);
    fill_int_vector(out.parent, g.order(), GRAPH_NIL);
    fill_int_vector(out.depth, g.order(), GRAPH_INFINITY);
    var queue = vector{int}();
    for s: &const in sources: {
        if out.depth.at(s) >= GRAPH_INFINITY: {
            out.depth.at(s) = 0;
            queue.push_back(s);
        }
    }
    var head: int = 0;
    while head < queue.size(): {
        let v = queue.at(head);
        head += 1;
        out.order.push_back(v);
        for e: &const in g.vertices.at(v).incident: {
            let arc: &const = g.edges.at(e);
            if arc.alive == false: {
                continue;
            }
            if out.depth.at(arc.head) >= GRAPH_INFINITY: {
                out.depth.at(arc.head) = out.depth.at(v) + 1;
                out.parent.at(arc.head) = v;
                queue.push_back(arc.head);
            }
        }
    }
    return out;
}



template(V: type, W: type)
fn bfs_levels(g: &const shared AdjacencyList{V, W},
              source: int) -> vector{vector{int}}: {
    let found = bfs{V, W}(g, source);
    var levels = vector{vector{int}}();
    let reach = found.eccentricity();
    var d: int = 0;
    while d <= reach: {
        levels.push_back(vector{int}());
        d += 1;
    }
    var v: int = 0;
    while v < g.order(): {
        let depth = found.depth.at(v);
        if depth < GRAPH_INFINITY: {
            levels.at(depth).push_back(v);
        }
        v += 1;
    }
    return levels;
}



template(V: type, W: type)
fn dfs(g: &const shared AdjacencyList{V, W}, source: int) -> SearchResult{V}: {
    var out = SearchResult{V}(source: source);
    fill_int_vector(out.parent, g.order(), GRAPH_NIL);
    fill_int_vector(out.depth, g.order(), GRAPH_INFINITY);
    var stack = vector{int}();
    var cursor = vector{int}();
    stack.push_back(source);
    cursor.push_back(0);
    out.depth.at(source) = 0;
    out.order.push_back(source);
    while stack.empty() == false: {
        let v = stack.back();
        let at = cursor.back();
        let incident: &const = g.vertices.at(v).incident;
        if at >= incident.size(): {
            stack.pop_back();
            cursor.pop_back();
            continue;
        }
        cursor.at(cursor.size() - 1) = at + 1;
        let arc: &const = g.edges.at(incident.at(at));
        if arc.alive == false: {
            continue;
        }
        let next = arc.head;
        if out.depth.at(next) >= GRAPH_INFINITY: {
            out.depth.at(next) = out.depth.at(v) + 1;
            out.parent.at(next) = v;
            out.order.push_back(next);
            stack.push_back(next);
            cursor.push_back(0);
        }
    }
    return out;
}






template(V: type, W: type)
fn dfs_visit(g: &const shared AdjacencyList{V, W},
             source: int,
             watcher: &unique Visitor{V, W}) -> SearchResult{V}: {
    var out = SearchResult{V}(source: source);
    fill_int_vector(out.parent, g.order(), GRAPH_NIL);
    fill_int_vector(out.depth, g.order(), GRAPH_INFINITY);
    var color = vector{int}();
    var entered = vector{int}();
    fill_int_vector(color, g.order(), 0);
    fill_int_vector(entered, g.order(), GRAPH_NIL);
    var stack = vector{int}();
    var cursor = vector{int}();
    var clock: int = 0;
    stack.push_back(source);
    cursor.push_back(0);
    color.at(source) = 1;
    entered.at(source) = clock;
    clock += 1;
    out.depth.at(source) = 0;
    discard watcher.on_discover(source);
    while stack.empty() == false: {
        let v = stack.back();
        let at = cursor.back();
        let incident: &const = g.vertices.at(v).incident;
        if at >= incident.size(): {
            color.at(v) = 2;
            discard watcher.on_finish(v);
            stack.pop_back();
            cursor.pop_back();
            continue;
        }
        cursor.at(cursor.size() - 1) = at + 1;
        let e = incident.at(at);
        let arc: &const = g.edges.at(e);
        if arc.alive == false: {
            continue;
        }
        let next = arc.head;
        if color.at(next) == 0: {
            discard watcher.on_edge(e, EdgeClass::TreeEdge);
            color.at(next) = 1;
            entered.at(next) = clock;
            clock += 1;
            out.parent.at(next) = v;
            out.depth.at(next) = out.depth.at(v) + 1;
            let verdict = watcher.on_discover(next);
            if verdict == VisitAction::StopTraversal: {
                out.complete = false;
                return out;
            }
            if verdict == VisitAction::Continue: {
                stack.push_back(next);
                cursor.push_back(0);
            }
        } else: {
            if color.at(next) == 1: {
                discard watcher.on_edge(e, EdgeClass::BackEdge);
            } else: {
                if entered.at(v) < entered.at(next): {
                    discard watcher.on_edge(e, EdgeClass::ForwardEdge);
                } else: {
                    discard watcher.on_edge(e, EdgeClass::CrossEdge);
                }
            }
        }
    }
    return out;
}



template(V: type, W: type)
fn dfs_forest(g: &const shared AdjacencyList{V, W},
              watcher: &unique Visitor{V, W}) -> vector{int}: {
    var parent = vector{int}();
    fill_int_vector(parent, g.order(), GRAPH_NIL);
    var seen = vector{bool}();
    fill_bool_vector(seen, g.order(), false);
    watcher.prepare(g.order());
    var v: int = 0;
    while v < g.order(): {
        if seen.at(v) == false: {
            watcher.on_restart(v);
            let tree = dfs{V, W}(g, v);
            for u: &const in tree.order: {
                if seen.at(u) == false: {
                    seen.at(u) = true;
                    parent.at(u) = tree.parent.at(u);
                }
            }
        }
        v += 1;
    }
    return parent;
}



template(V: type, W: type)
fn finish_order(g: &const shared AdjacencyList{V, W}) -> vector{int}: {
    var out = vector{int}();
    var color = vector{int}();
    fill_int_vector(color, g.order(), 0);
    var stack = vector{int}();
    var cursor = vector{int}();
    var root: int = 0;
    while root < g.order(): {
        if color.at(root) == 0: {
            stack.push_back(root);
            cursor.push_back(0);
            color.at(root) = 1;
            while stack.empty() == false: {
                let v = stack.back();
                let at = cursor.back();
                let incident: &const = g.vertices.at(v).incident;
                if at >= incident.size(): {
                    color.at(v) = 2;
                    out.push_back(v);
                    stack.pop_back();
                    cursor.pop_back();
                    continue;
                }
                cursor.at(cursor.size() - 1) = at + 1;
                let arc: &const = g.edges.at(incident.at(at));
                if arc.alive && color.at(arc.head) == 0: {
                    color.at(arc.head) = 1;
                    stack.push_back(arc.head);
                    cursor.push_back(0);
                }
            }
        }
        root += 1;
    }
    return out;
}


template(V: type, W: type)
fn reachable_from(g: &const shared AdjacencyList{V, W}, source: int) -> set{int}: {
    let found = bfs{V, W}(g, source);
    var out = set{int}();
    var v: int = 0;
    while v < g.order(): {
        if found.depth.at(v) < GRAPH_INFINITY: {
            discard out.insert(v);
        }
        v += 1;
    }
    return out;
}


template(V: type, W: type)
fn hop_distance(g: &const shared AdjacencyList{V, W},
                source: int,
                target: int) -> int: {
    let found = bfs{V, W}(g, source);
    return found.depth.at(target);
}


template(V: type, W: type)
fn hop_path(g: &const shared AdjacencyList{V, W},
            source: int,
            target: int) -> vector{int}: {
    let found = bfs{V, W}(g, source);
    return found.path_to(target);
}

}







namespace connectivity: {


template(V: type)
struct Components: {

    fn count(self: &const shared) -> int: {
        return .total;
    }

    fn same(self: &const shared, a: int, b: int) -> bool: {
        return .label.at(a) == .label.at(b);
    }

    fn size_of(self: &const shared, component: int) -> int: {
        var total: int = 0;
        for l: &const in .label: {
            if l == component: {
                total += 1;
            }
        }
        return total;
    }

    fn largest(self: &const shared) -> int: {
        var best: int = 0;
        var best_size: int = 0;
        var c: int = 0;
        while c < .total: {
            let n = .size_of(c);
            if n > best_size: {
                best_size = n;
                best = c;
            }
            c += 1;
        }
        return best;
    }

    
    fn buckets(self: &const shared) -> vector{vector{int}}: {
        var out = vector{vector{int}}();
        var c: int = 0;
        while c < .total: {
            out.push_back(vector{int}());
            c += 1;
        }
        var v: int = 0;
        while v < .label.size(): {
            let l = .label.at(v);
            if l != GRAPH_NIL: {
                out.at(l).push_back(v);
            }
            v += 1;
        }
        return out;
    }

    label: vector{int};
    payload: V;
    total: int = 0;
}


template(V: type, W: type)
fn connected_components(g: &const shared AdjacencyList{V, W}) -> Components{V}: {
    var out = Components{V}();
    fill_int_vector(out.label, g.order(), GRAPH_NIL);
    var next: int = 0;
    var root: int = 0;
    while root < g.order(): {
        if out.label.at(root) == GRAPH_NIL: {
            var queue = vector{int}();
            queue.push_back(root);
            out.label.at(root) = next;
            var head: int = 0;
            while head < queue.size(): {
                let v = queue.at(head);
                head += 1;
                for e: &const in g.vertices.at(v).incident: {
                    let arc: &const = g.edges.at(e);
                    if arc.alive && out.label.at(arc.head) == GRAPH_NIL: {
                        out.label.at(arc.head) = next;
                        queue.push_back(arc.head);
                    }
                }
            }
            next += 1;
        }
        root += 1;
    }
    out.total = next;
    return out;
}



template(V: type, W: type)
fn components_by_union(g: &const shared AdjacencyList{V, W}) -> Components{V}: {
    var forest = UnionFind();
    forest.prepare(g.order());
    for arc: &const in g.edges: {
        if arc.alive: {
            discard forest.unite(arc.tail, arc.head);
        }
    }
    var out = Components{V}();
    fill_int_vector(out.label, g.order(), GRAPH_NIL);
    var next: int = 0;
    var v: int = 0;
    while v < g.order(): {
        let root = forest.find(v);
        if out.label.at(root) == GRAPH_NIL: {
            out.label.at(root) = next;
            next += 1;
        }
        out.label.at(v) = out.label.at(root);
        v += 1;
    }
    out.total = next;
    return out;
}

template(V: type, W: type)
fn component_count(g: &const shared AdjacencyList{V, W}) -> int: {
    let found = connected_components{V, W}(g);
    return found.total;
}

template(V: type, W: type)
fn is_connected(g: &const shared AdjacencyList{V, W}) -> bool: {
    if g.order() == 0: {
        return true;
    }
    return component_count{V, W}(g) == 1;
}


template(V: type, W: type)
fn is_tree(g: &const shared AdjacencyList{V, W}) -> bool: {
    if is_connected{V, W}(g) == false: {
        return false;
    }
    return g.size() == g.order() - 1;
}




template(V: type)
struct Ordering: {

    fn valid(self: &const shared) -> bool: {
        return .status == OrderStatus::TotalOrder;
    }

    fn length(self: &const shared) -> int: {
        return .sequence.size();
    }

    
    fn ranks(self: &const shared, order: int) -> vector{int}: {
        var out = vector{int}();
        fill_int_vector(out, order, GRAPH_NIL);
        var i: int = 0;
        while i < .sequence.size(): {
            out.at(.sequence.at(i)) = i;
            i += 1;
        }
        return out;
    }

    sequence: vector{int};
    payload: V;
    status: OrderStatus = OrderStatus::TotalOrder;
}





template(V: type, W: type)
fn topological_sort_kahn(g: &const shared AdjacencyList{V, W}) -> Ordering{V}: {
    var out = Ordering{V}();
    var indegree = vector{int}();
    fill_int_vector(indegree, g.order(), 0);
    for arc: &const in g.edges: {
        if arc.alive: {
            indegree.at(arc.head) += 1;
        }
    }
    var queue = vector{int}();
    var v: int = 0;
    while v < g.order(): {
        if indegree.at(v) == 0: {
            queue.push_back(v);
        }
        v += 1;
    }
    var head: int = 0;
    while head < queue.size(): {
        let u = queue.at(head);
        head += 1;
        out.sequence.push_back(u);
        for e: &const in g.vertices.at(u).incident: {
            let arc: &const = g.edges.at(e);
            if arc.alive == false: {
                continue;
            }
            indegree.at(arc.head) -= 1;
            if indegree.at(arc.head) == 0: {
                queue.push_back(arc.head);
            }
        }
    }
    if out.sequence.size() != g.order(): {
        out.status = OrderStatus::CycleFound;
    }
    return out;
}



template(V: type, W: type)
fn topological_sort_smallest(g: &const shared AdjacencyList{V, W}) -> Ordering{V}: {
    var out = Ordering{V}();
    var indegree = vector{int}();
    fill_int_vector(indegree, g.order(), 0);
    for arc: &const in g.edges: {
        if arc.alive: {
            indegree.at(arc.head) += 1;
        }
    }
    var frontier = BinaryHeap();
    frontier.prepare(g.order());
    var v: int = 0;
    while v < g.order(): {
        if indegree.at(v) == 0: {
            frontier.push(v, v);
        }
        v += 1;
    }
    while frontier.empty() == false: {
        let top = frontier.pop();
        out.sequence.push_back(top.vertex);
        for e: &const in g.vertices.at(top.vertex).incident: {
            let arc: &const = g.edges.at(e);
            if arc.alive == false: {
                continue;
            }
            indegree.at(arc.head) -= 1;
            if indegree.at(arc.head) == 0: {
                frontier.push(arc.head, arc.head);
            }
        }
    }
    if out.sequence.size() != g.order(): {
        out.status = OrderStatus::CycleFound;
    }
    return out;
}





template(V: type, W: type)
fn topological_sort_dfs(g: &const shared AdjacencyList{V, W}) -> Ordering{V}: {
    var out = Ordering{V}();
    let finished = traversal::finish_order{V, W}(g);
    var i = finished.size() - 1;
    while i >= 0: {
        out.sequence.push_back(finished.at(i));
        i -= 1;
    }
    if has_directed_cycle{V, W}(g): {
        out.status = OrderStatus::CycleFound;
    }
    return out;
}




template(V: type, W: type)
fn has_directed_cycle(g: &const shared AdjacencyList{V, W}) -> bool: {
    var color = vector{int}();
    fill_int_vector(color, g.order(), 0);
    var stack = vector{int}();
    var cursor = vector{int}();
    var root: int = 0;
    while root < g.order(): {
        if color.at(root) == 0: {
            stack.push_back(root);
            cursor.push_back(0);
            color.at(root) = 1;
            while stack.empty() == false: {
                let v = stack.back();
                let at = cursor.back();
                let incident: &const = g.vertices.at(v).incident;
                if at >= incident.size(): {
                    color.at(v) = 2;
                    stack.pop_back();
                    cursor.pop_back();
                    continue;
                }
                cursor.at(cursor.size() - 1) = at + 1;
                let arc: &const = g.edges.at(incident.at(at));
                if arc.alive == false: {
                    continue;
                }
                if color.at(arc.head) == 1: {
                    return true;
                }
                if color.at(arc.head) == 0: {
                    color.at(arc.head) = 1;
                    stack.push_back(arc.head);
                    cursor.push_back(0);
                }
            }
        }
        root += 1;
    }
    return false;
}



template(V: type, W: type)
fn has_undirected_cycle(g: &const shared AdjacencyList{V, W}) -> bool: {
    var forest = UnionFind();
    forest.prepare(g.order());
    for arc: &const in g.edges: {
        if arc.alive && arc.tail < arc.head: {
            if forest.unite(arc.tail, arc.head) == false: {
                return true;
            }
        }
    }
    return false;
}


template(V: type, W: type)
fn find_directed_cycle(g: &const shared AdjacencyList{V, W}) -> vector{int}: {
    var color = vector{int}();
    var parent = vector{int}();
    fill_int_vector(color, g.order(), 0);
    fill_int_vector(parent, g.order(), GRAPH_NIL);
    var found = vector{int}();
    var stack = vector{int}();
    var cursor = vector{int}();
    var root: int = 0;
    while root < g.order(): {
        if color.at(root) == 0: {
            stack.push_back(root);
            cursor.push_back(0);
            color.at(root) = 1;
            while stack.empty() == false: {
                let v = stack.back();
                let at = cursor.back();
                let incident: &const = g.vertices.at(v).incident;
                if at >= incident.size(): {
                    color.at(v) = 2;
                    stack.pop_back();
                    cursor.pop_back();
                    continue;
                }
                cursor.at(cursor.size() - 1) = at + 1;
                let arc: &const = g.edges.at(incident.at(at));
                if arc.alive == false: {
                    continue;
                }
                if color.at(arc.head) == 1: {
                    var walker = v;
                    while walker != arc.head && walker != GRAPH_NIL: {
                        found.push_back(walker);
                        walker = parent.at(walker);
                    }
                    found.push_back(arc.head);
                    reverse_int_vector(found);
                    return found;
                }
                if color.at(arc.head) == 0: {
                    color.at(arc.head) = 1;
                    parent.at(arc.head) = v;
                    stack.push_back(arc.head);
                    cursor.push_back(0);
                }
            }
        }
        root += 1;
    }
    return found;
}

template(V: type, W: type)
fn is_acyclic(g: &const shared AdjacencyList{V, W}) -> bool: {
    if g.is_directed(): {
        return has_directed_cycle{V, W}(g) == false;
    }
    return has_undirected_cycle{V, W}(g) == false;
}








struct TarjanState: {

    fn prepare(self: &unique, order: int): {
        fill_int_vector(.index, order, GRAPH_NIL);
        fill_int_vector(.low, order, GRAPH_NIL);
        fill_bool_vector(.on_stack, order, false);
        .pending.clear();
        .frames.clear();
        .cursor.clear();
        .clock = 0;
        .total = 0;
    }

    fn visited(self: &const shared, v: int) -> bool: {
        return .index.at(v) != GRAPH_NIL;
    }

    fn enter(self: &unique, v: int): {
        .index.at(v) = .clock;
        .low.at(v) = .clock;
        .clock += 1;
        .pending.push_back(v);
        .on_stack.at(v) = true;
    }

    
    fn close(self: &unique, root: int, label: &unique vector{int}) -> int: {
        var members: int = 0;
        loop: {
            let top = .pending.back();
            .pending.pop_back();
            .on_stack.at(top) = false;
            label.at(top) = .total;
            members += 1;
            if top == root: {
                break;
            }
        }
        .total += 1;
        return members;
    }

    index: vector{int};
    low: vector{int};
    on_stack: vector{bool};
    pending: vector{int};
    frames: vector{int};
    cursor: vector{int};
    clock: int = 0;
    total: int = 0;
}





template(V: type, W: type)
fn tarjan_scc(g: &const shared AdjacencyList{V, W}) -> Components{V}: {
    var out = Components{V}();
    fill_int_vector(out.label, g.order(), GRAPH_NIL);
    var state = TarjanState();
    state.prepare(g.order());
    var root: int = 0;
    while root < g.order(): {
        if state.visited(root) == false: {
            state.enter(root);
            state.frames.push_back(root);
            state.cursor.push_back(0);
            while state.frames.empty() == false: {
                let v = state.frames.back();
                let at = state.cursor.back();
                let incident: &const = g.vertices.at(v).incident;
                if at < incident.size(): {
                    state.cursor.at(state.cursor.size() - 1) = at + 1;
                    let arc: &const = g.edges.at(incident.at(at));
                    if arc.alive == false: {
                        continue;
                    }
                    let next = arc.head;
                    if state.visited(next) == false: {
                        state.enter(next);
                        state.frames.push_back(next);
                        state.cursor.push_back(0);
                    } else: {
                        if state.on_stack.at(next): {
                            if state.index.at(next) < state.low.at(v): {
                                state.low.at(v) = state.index.at(next);
                            }
                        }
                    }
                } else: {
                    state.frames.pop_back();
                    state.cursor.pop_back();
                    if state.low.at(v) == state.index.at(v): {
                        discard state.close(v, out.label);
                    }
                    if state.frames.empty() == false: {
                        let up = state.frames.back();
                        if state.low.at(v) < state.low.at(up): {
                            state.low.at(up) = state.low.at(v);
                        }
                    }
                }
            }
        }
        root += 1;
    }
    out.total = state.total;
    return out;
}






template(V: type, W: type)
fn kosaraju_scc(g: &const shared AdjacencyList{V, W}) -> Components{V}: {
    let finished = traversal::finish_order{V, W}(g);
    let reversed = builders::transpose{V, W}(g);
    var out = Components{V}();
    fill_int_vector(out.label, g.order(), GRAPH_NIL);
    var next: int = 0;
    var i = finished.size() - 1;
    while i >= 0: {
        let root = finished.at(i);
        i -= 1;
        if out.label.at(root) != GRAPH_NIL: {
            continue;
        }
        var stack = vector{int}();
        stack.push_back(root);
        out.label.at(root) = next;
        while stack.empty() == false: {
            let v = stack.back();
            stack.pop_back();
            for e: &const in reversed.vertices.at(v).incident: {
                let arc: &const = reversed.edges.at(e);
                if arc.alive && out.label.at(arc.head) == GRAPH_NIL: {
                    out.label.at(arc.head) = next;
                    stack.push_back(arc.head);
                }
            }
        }
        next += 1;
    }
    out.total = next;
    return out;
}



template(V: type, W: type)
fn condensation(g: &const shared AdjacencyList{V, W},
                parts: &const shared Components{V}) -> AdjacencyList{V, W}: {
    var out = builders::directed{V, W}(parts.total);
    for arc: &const in g.edges: {
        if arc.alive == false: {
            continue;
        }
        let a = parts.label.at(arc.tail);
        let b = parts.label.at(arc.head);
        if a != b: {
            if out.has_edge(a, b) == false: {
                discard out.connect(a, b, arc.weight);
            }
        }
    }
    assert is_acyclic{V, W}(out);
    return out;
}

template(V: type, W: type)
fn is_strongly_connected(g: &const shared AdjacencyList{V, W}) -> bool: {
    if g.order() == 0: {
        return true;
    }
    let parts = tarjan_scc{V, W}(g);
    return parts.total == 1;
}




template(V: type)
struct CutInfo: {

    fn bridge_count(self: &const shared) -> int: {
        return .bridges.size();
    }

    fn is_articulation(self: &const shared, v: int) -> bool: {
        return .articulation.at(v);
    }

    fn articulation_list(self: &const shared) -> vector{int}: {
        var out = vector{int}();
        var v: int = 0;
        while v < .articulation.size(): {
            if .articulation.at(v): {
                out.push_back(v);
            }
            v += 1;
        }
        return out;
    }

    bridges: vector{int};
    articulation: vector{bool};
    low: vector{int};
    discovery: vector{int};
    payload: V;
}







template(V: type, W: type)
fn find_cuts(g: &const shared AdjacencyList{V, W}) -> CutInfo{V}: {
    var out = CutInfo{V}();
    fill_int_vector(out.low, g.order(), GRAPH_NIL);
    fill_int_vector(out.discovery, g.order(), GRAPH_NIL);
    fill_bool_vector(out.articulation, g.order(), false);
    var parent_arc = vector{int}();
    fill_int_vector(parent_arc, g.order(), GRAPH_NIL);
    var children = vector{int}();
    fill_int_vector(children, g.order(), 0);
    var stack = vector{int}();
    var cursor = vector{int}();
    var clock: int = 0;
    var root: int = 0;
    while root < g.order(): {
        if out.discovery.at(root) != GRAPH_NIL: {
            root += 1;
            continue;
        }
        out.discovery.at(root) = clock;
        out.low.at(root) = clock;
        clock += 1;
        stack.push_back(root);
        cursor.push_back(0);
        while stack.empty() == false: {
            let v = stack.back();
            let at = cursor.back();
            let incident: &const = g.vertices.at(v).incident;
            if at < incident.size(): {
                cursor.at(cursor.size() - 1) = at + 1;
                let e = incident.at(at);
                let arc: &const = g.edges.at(e);
                if arc.alive == false: {
                    continue;
                }
                if e == parent_arc.at(v) ^ 1 && parent_arc.at(v) != GRAPH_NIL: {
                    continue;
                }
                let next = arc.head;
                if out.discovery.at(next) == GRAPH_NIL: {
                    parent_arc.at(next) = e;
                    children.at(v) += 1;
                    out.discovery.at(next) = clock;
                    out.low.at(next) = clock;
                    clock += 1;
                    stack.push_back(next);
                    cursor.push_back(0);
                } else: {
                    if out.discovery.at(next) < out.low.at(v): {
                        out.low.at(v) = out.discovery.at(next);
                    }
                }
            } else: {
                stack.pop_back();
                cursor.pop_back();
                if stack.empty() == false: {
                    let up = stack.back();
                    if out.low.at(v) < out.low.at(up): {
                        out.low.at(up) = out.low.at(v);
                    }
                    if out.low.at(v) > out.discovery.at(up): {
                        out.bridges.push_back(parent_arc.at(v));
                    }
                    if up != root && out.low.at(v) >= out.discovery.at(up): {
                        out.articulation.at(up) = true;
                    }
                }
            }
        }
        if children.at(root) > 1: {
            out.articulation.at(root) = true;
        }
        root += 1;
    }
    return out;
}

template(V: type, W: type)
fn bridges(g: &const shared AdjacencyList{V, W}) -> vector{int}: {
    let cuts = find_cuts{V, W}(g);
    return cuts.bridges;
}

template(V: type, W: type)
fn articulation_points(g: &const shared AdjacencyList{V, W}) -> vector{int}: {
    let cuts = find_cuts{V, W}(g);
    return cuts.articulation_list();
}


template(V: type, W: type)
fn is_two_edge_connected(g: &const shared AdjacencyList{V, W}) -> bool: {
    if is_connected{V, W}(g) == false: {
        return false;
    }
    let cuts = find_cuts{V, W}(g);
    return cuts.bridges.empty();
}





template(V: type)
struct Coloring: {

    fn bipartite(self: &const shared) -> bool: {
        return .conflict == GRAPH_NIL;
    }

    fn side_of(self: &const shared, v: int) -> Side: {
        return .sides.at(v);
    }

    fn left_vertices(self: &const shared) -> vector{int}: {
        var out = vector{int}();
        var v: int = 0;
        while v < .sides.size(): {
            if .sides.at(v) == Side::LeftSide: {
                out.push_back(v);
            }
            v += 1;
        }
        return out;
    }

    fn right_vertices(self: &const shared) -> vector{int}: {
        var out = vector{int}();
        var v: int = 0;
        while v < .sides.size(): {
            if .sides.at(v) == Side::RightSide: {
                out.push_back(v);
            }
            v += 1;
        }
        return out;
    }

    sides: vector{Side};
    payload: V;
    conflict: int = -1;
}


template(V: type, W: type)
fn two_coloring(g: &const shared AdjacencyList{V, W}) -> Coloring{V}: {
    var out = Coloring{V}();
    out.sides.clear();
    var i: int = 0;
    while i < g.order(): {
        out.sides.push_back(Side::Unassigned);
        i += 1;
    }
    var root: int = 0;
    while root < g.order(): {
        if out.sides.at(root) != Side::Unassigned: {
            root += 1;
            continue;
        }
        out.sides.at(root) = Side::LeftSide;
        var queue = vector{int}();
        queue.push_back(root);
        var head: int = 0;
        while head < queue.size(): {
            let v = queue.at(head);
            head += 1;
            for e: &const in g.vertices.at(v).incident: {
                let arc: &const = g.edges.at(e);
                if arc.alive == false: {
                    continue;
                }
                let next = arc.head;
                if out.sides.at(next) == Side::Unassigned: {
                    if out.sides.at(v) == Side::LeftSide: {
                        out.sides.at(next) = Side::RightSide;
                    } else: {
                        out.sides.at(next) = Side::LeftSide;
                    }
                    queue.push_back(next);
                } else: {
                    if out.sides.at(next) == out.sides.at(v): {
                        out.conflict = e;
                        return out;
                    }
                }
            }
        }
        root += 1;
    }
    return out;
}

template(V: type, W: type)
fn is_bipartite(g: &const shared AdjacencyList{V, W}) -> bool: {
    let colors = two_coloring{V, W}(g);
    return colors.bipartite();
}


template(V: type, W: type)
fn odd_cycle_witness(g: &const shared AdjacencyList{V, W}) -> vector{int}: {
    let colors = two_coloring{V, W}(g);
    var out = vector{int}();
    if colors.bipartite(): {
        return out;
    }
    let arc: &const = g.edges.at(colors.conflict);
    let left = traversal::hop_path{V, W}(g, arc.tail, arc.head);
    for v: &const in left: {
        out.push_back(v);
    }
    return out;
}

}








namespace shortest_path: {


template(V: type)
struct Distances: {

    fn reachable(self: &const shared, v: int) -> bool: {
        return .dist.at(v) < GRAPH_INFINITY;
    }

    fn to(self: &const shared, v: int) -> int: {
        return .dist.at(v);
    }

    
    fn path_to(self: &const shared, v: int) -> vector{int}: {
        var out = vector{int}();
        if .dist.at(v) >= GRAPH_INFINITY: {
            return out;
        }
        var walker = v;
        while walker != GRAPH_NIL: {
            out.push_back(walker);
            walker = .parent.at(walker);
        }
        reverse_int_vector(out);
        return out;
    }

    
    fn arcs_to(self: &const shared, v: int) -> vector{int}: {
        var out = vector{int}();
        var walker = v;
        while walker != GRAPH_NIL && .parent_arc.at(walker) != GRAPH_NIL: {
            out.push_back(.parent_arc.at(walker));
            walker = .parent.at(walker);
        }
        reverse_int_vector(out);
        return out;
    }

    fn farthest(self: &const shared) -> int: {
        var best = GRAPH_NIL;
        var best_dist: int = -1;
        var v: int = 0;
        while v < .dist.size(): {
            let d = .dist.at(v);
            if d < GRAPH_INFINITY && d > best_dist: {
                best_dist = d;
                best = v;
            }
            v += 1;
        }
        return best;
    }

    fn total_reachable(self: &const shared) -> int: {
        var total: int = 0;
        for d: &const in .dist: {
            if d < GRAPH_INFINITY: {
                total += 1;
            }
        }
        return total;
    }

    dist: vector{int};
    parent: vector{int};
    parent_arc: vector{int};
    payload: V;
    source: int = -1;
    negative_cycle: bool = false;
    relaxations: int = 0;
}






template(V: type, W: type)
fn dijkstra(g: &const shared AdjacencyList{V, W}, source: int) -> Distances{V}: {
    var out = Distances{V}(source: source);
    fill_int_vector(out.dist, g.order(), GRAPH_INFINITY);
    fill_int_vector(out.parent, g.order(), GRAPH_NIL);
    fill_int_vector(out.parent_arc, g.order(), GRAPH_NIL);
    if g.valid_vertex(source) == false: {
        return out;
    }
    var settled = vector{bool}();
    fill_bool_vector(settled, g.order(), false);
    var frontier = BinaryHeap();
    frontier.prepare(g.order());
    out.dist.at(source) = 0;
    frontier.push(source, 0);
    while frontier.empty() == false: {
        let top = frontier.pop();
        let v = top.vertex;
        if settled.at(v): {
            continue;
        }
        settled.at(v) = true;
        for e: &const in g.vertices.at(v).incident: {
            let arc: &const = g.edges.at(e);
            if arc.alive == false: {
                continue;
            }
            assert arc.weight >= 0;
            let candidate = add_distance(out.dist.at(v), arc.weight);
            if candidate < out.dist.at(arc.head): {
                out.dist.at(arc.head) = candidate;
                out.parent.at(arc.head) = v;
                out.parent_arc.at(arc.head) = e;
                out.relaxations += 1;
                discard frontier.decrease_key(arc.head, candidate);
            }
        }
    }
    prove out.dist.at(source) == 0;
    return out;
}



template(V: type, W: type)
fn dijkstra_to(g: &const shared AdjacencyList{V, W},
               source: int,
               target: int) -> Distances{V}: {
    var out = Distances{V}(source: source);
    fill_int_vector(out.dist, g.order(), GRAPH_INFINITY);
    fill_int_vector(out.parent, g.order(), GRAPH_NIL);
    fill_int_vector(out.parent_arc, g.order(), GRAPH_NIL);
    var settled = vector{bool}();
    fill_bool_vector(settled, g.order(), false);
    var frontier = BinaryHeap();
    frontier.prepare(g.order());
    out.dist.at(source) = 0;
    frontier.push(source, 0);
    while frontier.empty() == false: {
        let top = frontier.pop();
        let v = top.vertex;
        if v == target: {
            return out;
        }
        if settled.at(v): {
            continue;
        }
        settled.at(v) = true;
        for e: &const in g.vertices.at(v).incident: {
            let arc: &const = g.edges.at(e);
            if arc.alive == false: {
                continue;
            }
            let candidate = add_distance(out.dist.at(v), arc.weight);
            if candidate < out.dist.at(arc.head): {
                out.dist.at(arc.head) = candidate;
                out.parent.at(arc.head) = v;
                out.parent_arc.at(arc.head) = e;
                discard frontier.decrease_key(arc.head, candidate);
            }
        }
    }
    return out;
}


template(V: type, W: type)
fn shortest_route(g: &const shared AdjacencyList{V, W},
                  source: int,
                  target: int) -> vector{int}: {
    let found = dijkstra_to{V, W}(g, source, target);
    return found.path_to(target);
}



template(V: type, W: type)
fn bellman_ford(g: &const shared AdjacencyList{V, W}, source: int) -> Distances{V}: {
    var out = Distances{V}(source: source);
    fill_int_vector(out.dist, g.order(), GRAPH_INFINITY);
    fill_int_vector(out.parent, g.order(), GRAPH_NIL);
    fill_int_vector(out.parent_arc, g.order(), GRAPH_NIL);
    if g.valid_vertex(source) == false: {
        return out;
    }
    out.dist.at(source) = 0;
    var rounds: int = 0;
    let limit = min(g.order() - 1, GRAPH_RELAX_LIMIT);
    while rounds < limit: {
        var changed = false;
        var e: int = 0;
        while e < g.edges.size(): {
            let arc: &const = g.edges.at(e);
            if arc.alive && out.dist.at(arc.tail) < GRAPH_INFINITY: {
                let candidate = add_distance(out.dist.at(arc.tail), arc.weight);
                if candidate < out.dist.at(arc.head): {
                    out.dist.at(arc.head) = candidate;
                    out.parent.at(arc.head) = arc.tail;
                    out.parent_arc.at(arc.head) = e;
                    out.relaxations += 1;
                    changed = true;
                }
            }
            e += 1;
        }
        if changed == false: {
            return out;
        }
        rounds += 1;
    }
    var e: int = 0;
    while e < g.edges.size(): {
        let arc: &const = g.edges.at(e);
        if arc.alive && out.dist.at(arc.tail) < GRAPH_INFINITY: {
            if add_distance(out.dist.at(arc.tail), arc.weight) < out.dist.at(arc.head): {
                out.negative_cycle = true;
                return out;
            }
        }
        e += 1;
    }
    return out;
}

template(V: type, W: type)
fn has_negative_cycle(g: &const shared AdjacencyList{V, W}) -> bool: {
    var v: int = 0;
    while v < g.order(): {
        let found = bellman_ford{V, W}(g, v);
        if found.negative_cycle: {
            return true;
        }
        v += 1;
    }
    return false;
}



template(V: type, W: type)
fn spfa(g: &const shared AdjacencyList{V, W}, source: int) -> Distances{V}: {
    var out = Distances{V}(source: source);
    fill_int_vector(out.dist, g.order(), GRAPH_INFINITY);
    fill_int_vector(out.parent, g.order(), GRAPH_NIL);
    fill_int_vector(out.parent_arc, g.order(), GRAPH_NIL);
    var queued = vector{bool}();
    var pushes = vector{int}();
    fill_bool_vector(queued, g.order(), false);
    fill_int_vector(pushes, g.order(), 0);
    var queue = vector{int}();
    out.dist.at(source) = 0;
    queue.push_back(source);
    queued.at(source) = true;
    var head: int = 0;
    while head < queue.size(): {
        let v = queue.at(head);
        head += 1;
        queued.at(v) = false;
        for e: &const in g.vertices.at(v).incident: {
            let arc: &const = g.edges.at(e);
            if arc.alive == false: {
                continue;
            }
            let candidate = add_distance(out.dist.at(v), arc.weight);
            if candidate < out.dist.at(arc.head): {
                out.dist.at(arc.head) = candidate;
                out.parent.at(arc.head) = v;
                out.parent_arc.at(arc.head) = e;
                if queued.at(arc.head) == false: {
                    queued.at(arc.head) = true;
                    pushes.at(arc.head) += 1;
                    if pushes.at(arc.head) > g.order(): {
                        out.negative_cycle = true;
                        return out;
                    }
                    queue.push_back(arc.head);
                }
            }
        }
    }
    return out;
}



template(V: type, W: type)
fn dag_shortest_path(g: &const shared AdjacencyList{V, W},
                     source: int) -> Distances{V}: {
    var out = Distances{V}(source: source);
    fill_int_vector(out.dist, g.order(), GRAPH_INFINITY);
    fill_int_vector(out.parent, g.order(), GRAPH_NIL);
    fill_int_vector(out.parent_arc, g.order(), GRAPH_NIL);
    let order = connectivity::topological_sort_kahn{V, W}(g);
    if order.valid() == false: {
        return out;
    }
    out.dist.at(source) = 0;
    for v: &const in order.sequence: {
        if out.dist.at(v) >= GRAPH_INFINITY: {
            continue;
        }
        for e: &const in g.vertices.at(v).incident: {
            let arc: &const = g.edges.at(e);
            if arc.alive == false: {
                continue;
            }
            let candidate = add_distance(out.dist.at(v), arc.weight);
            if candidate < out.dist.at(arc.head): {
                out.dist.at(arc.head) = candidate;
                out.parent.at(arc.head) = v;
                out.parent_arc.at(arc.head) = e;
            }
        }
    }
    return out;
}



template(V: type, W: type)
fn dag_longest_path(g: &const shared AdjacencyList{V, W}, source: int) -> int: {
    var flipped = builders::to_directed{V, W}(g);
    for arc: &unique in flipped.edges: {
        arc.weight = -arc.weight;
    }
    let found = dag_shortest_path{V, W}(flipped, source);
    var best: int = 0;
    for d: &const in found.dist: {
        if d < GRAPH_INFINITY && -d > best: {
            best = -d;
        }
    }
    return best;
}





template(V: type, W: type, N: int)
struct AllPairs: {

    fn distance(self: &const shared, from: int, to: int) -> int: {
        return .dist.at(from * N + to);
    }

    fn linked(self: &const shared, from: int, to: int) -> bool: {
        return .dist.at(from * N + to) < GRAPH_INFINITY;
    }

    
    fn route(self: &const shared, from: int, to: int) -> vector{int}: {
        var out = vector{int}();
        if .dist.at(from * N + to) >= GRAPH_INFINITY: {
            return out;
        }
        var walker = from;
        out.push_back(walker);
        var guard: int = 0;
        while walker != to && guard < N: {
            walker = .next.at(walker * N + to);
            if walker == GRAPH_NIL: {
                out.clear();
                return out;
            }
            out.push_back(walker);
            guard += 1;
        }
        return out;
    }

    
    fn diameter(self: &const shared) -> int: {
        var best: int = 0;
        var i: int = 0;
        while i < N * N: {
            let d = .dist.at(i);
            if d < GRAPH_INFINITY && d > best: {
                best = d;
            }
            i += 1;
        }
        return best;
    }

    
    fn center(self: &const shared) -> int: {
        var best = GRAPH_NIL;
        var best_ecc = GRAPH_INFINITY;
        var r: int = 0;
        while r < N: {
            var ecc: int = 0;
            var c: int = 0;
            while c < N: {
                let d = .dist.at(r * N + c);
                if d < GRAPH_INFINITY && d > ecc: {
                    ecc = d;
                }
                c += 1;
            }
            if ecc < best_ecc: {
                best_ecc = ecc;
                best = r;
            }
            r += 1;
        }
        return best;
    }

    dist: vector{int};
    next: vector{int};
    payload: V;
    slack: W;
    negative_cycle: bool = false;
}





template(V: type, W: type, N: int)
fn floyd_warshall(m: &const shared AdjacencyMatrix{V, W, N}) -> AllPairs{V, W, N}: {
    var out = AllPairs{V, W, N}();
    out.dist.clear();
    out.next.clear();
    var r: int = 0;
    while r < N: {
        var c: int = 0;
        while c < N: {
            let value = m.get(r, c);
            out.dist.push_back(value);
            if value < GRAPH_INFINITY && r != c: {
                out.next.push_back(c);
            } else: {
                out.next.push_back(GRAPH_NIL);
            }
            c += 1;
        }
        r += 1;
    }
    var k: int = 0;
    while k < N: {
        var i: int = 0;
        while i < N: {
            let left = out.dist.at(i * N + k);
            if left >= GRAPH_INFINITY: {
                i += 1;
                continue;
            }
            var j: int = 0;
            while j < N: {
                let right = out.dist.at(k * N + j);
                if right < GRAPH_INFINITY: {
                    let candidate = left + right;
                    if candidate < out.dist.at(i * N + j): {
                        out.dist.at(i * N + j) = candidate;
                        out.next.at(i * N + j) = out.next.at(i * N + k);
                    }
                }
                j += 1;
            }
            i += 1;
        }
        k += 1;
    }
    var d: int = 0;
    while d < N: {
        if out.dist.at(d * N + d) < 0: {
            out.negative_cycle = true;
        }
        d += 1;
    }
    return out;
}



template(V: type, W: type, N: int)
fn transitive_closure(m: &const shared AdjacencyMatrix{V, W, N}) -> vector{bool}: {
    var reach = vector{bool}();
    var r: int = 0;
    while r < N: {
        var c: int = 0;
        while c < N: {
            reach.push_back(r == c || m.linked(r, c));
            c += 1;
        }
        r += 1;
    }
    var k: int = 0;
    while k < N: {
        var i: int = 0;
        while i < N: {
            if reach.at(i * N + k): {
                var j: int = 0;
                while j < N: {
                    if reach.at(k * N + j): {
                        reach.at(i * N + j) = true;
                    }
                    j += 1;
                }
            }
            i += 1;
        }
        k += 1;
    }
    return reach;
}






template(V: type, W: type)
fn johnson(g: &const shared AdjacencyList{V, W}) -> vector{vector{int}}: {
    var rows = vector{vector{int}}();
    var augmented = builders::to_directed{V, W}(g);
    let extra = augmented.add_vertex(V());
    var v: int = 0;
    while v < g.order(): {
        discard augmented.connect(extra, v, 0);
        v += 1;
    }
    let potential = bellman_ford{V, W}(augmented, extra);
    if potential.negative_cycle: {
        return rows;
    }
    var reweighted = builders::to_directed{V, W}(g);
    for arc: &unique in reweighted.edges: {
        arc.weight = arc.weight + potential.dist.at(arc.tail) - potential.dist.at(arc.head);
    }
    var source: int = 0;
    while source < g.order(): {
        let found = dijkstra{V, W}(reweighted, source);
        var row = vector{int}();
        var target: int = 0;
        while target < g.order(): {
            let d = found.dist.at(target);
            if d >= GRAPH_INFINITY: {
                row.push_back(GRAPH_INFINITY);
            } else: {
                row.push_back(d - potential.dist.at(source) + potential.dist.at(target));
            }
            target += 1;
        }
        rows.push_back(move(row));
        source += 1;
    }
    return rows;
}



template(V: type, W: type)
fn widest_path(g: &const shared AdjacencyList{V, W}, source: int) -> vector{int}: {
    var width = vector{int}();
    fill_int_vector(width, g.order(), 0);
    width.at(source) = GRAPH_INFINITY;
    var frontier = BinaryHeap();
    frontier.prepare(g.order());
    frontier.push(source, 0);
    var settled = vector{bool}();
    fill_bool_vector(settled, g.order(), false);
    while frontier.empty() == false: {
        let top = frontier.pop();
        let v = top.vertex;
        if settled.at(v): {
            continue;
        }
        settled.at(v) = true;
        for e: &const in g.vertices.at(v).incident: {
            let arc: &const = g.edges.at(e);
            if arc.alive == false: {
                continue;
            }
            var candidate = width.at(v);
            if arc.weight < candidate: {
                candidate = arc.weight;
            }
            if candidate > width.at(arc.head): {
                width.at(arc.head) = candidate;
                discard frontier.decrease_key(arc.head, -candidate);
            }
        }
    }
    return width;
}

}









namespace spanning: {


template(V: type)
struct SpanningTree: {

    fn edge_count(self: &const shared) -> int: {
        return .arcs.size();
    }

    fn spans(self: &const shared, order: int) -> bool: {
        return .arcs.size() == order - 1;
    }

    fn average_weight(self: &const shared) -> int: {
        if .arcs.empty(): {
            return 0;
        }
        return .weight / .arcs.size();
    }

    
    fn contains_arc(self: &const shared, e: int) -> bool: {
        for a: &const in .arcs: {
            if a == e: {
                return true;
            }
        }
        return false;
    }

    arcs: vector{int};
    parent: vector{int};
    payload: V;
    weight: int = 0;
    components: int = 1;
}






template(V: type, W: type)
fn prim(g: &const shared AdjacencyList{V, W}, root: int) -> SpanningTree{V}: {
    var out = SpanningTree{V}();
    fill_int_vector(out.parent, g.order(), GRAPH_NIL);
    var best = vector{int}();
    var best_arc = vector{int}();
    var inside = vector{bool}();
    fill_int_vector(best, g.order(), GRAPH_INFINITY);
    fill_int_vector(best_arc, g.order(), GRAPH_NIL);
    fill_bool_vector(inside, g.order(), false);
    var frontier = BinaryHeap();
    frontier.prepare(g.order());
    best.at(root) = 0;
    frontier.push(root, 0);
    while frontier.empty() == false: {
        let top = frontier.pop();
        let v = top.vertex;
        if inside.at(v): {
            continue;
        }
        inside.at(v) = true;
        if best_arc.at(v) != GRAPH_NIL: {
            out.arcs.push_back(best_arc.at(v));
            out.weight += best.at(v);
        }
        for e: &const in g.vertices.at(v).incident: {
            let arc: &const = g.edges.at(e);
            if arc.alive == false: {
                continue;
            }
            let next = arc.head;
            if inside.at(next) == false && arc.weight < best.at(next): {
                best.at(next) = arc.weight;
                best_arc.at(next) = e;
                out.parent.at(next) = v;
                discard frontier.decrease_key(next, arc.weight);
            }
        }
    }
    return out;
}


template(V: type, W: type)
fn prim_forest(g: &const shared AdjacencyList{V, W}) -> SpanningTree{V}: {
    var out = SpanningTree{V}();
    fill_int_vector(out.parent, g.order(), GRAPH_NIL);
    var seen = vector{bool}();
    fill_bool_vector(seen, g.order(), false);
    var trees: int = 0;
    var root: int = 0;
    while root < g.order(): {
        if seen.at(root) == false: {
            let piece = prim{V, W}(g, root);
            for e: &const in piece.arcs: {
                out.arcs.push_back(e);
                let arc: &const = g.edges.at(e);
                out.weight += arc.weight;
                seen.at(arc.tail) = true;
                seen.at(arc.head) = true;
            }
            seen.at(root) = true;
            trees += 1;
        }
        root += 1;
    }
    out.components = trees;
    return out;
}





template(V: type, W: type)
fn edges_by_weight(g: &const shared AdjacencyList{V, W}) -> vector{int}: {
    var ids = vector{int}();
    var e: int = 0;
    while e < g.edges.size(): {
        let arc: &const = g.edges.at(e);
        if arc.alive: {
            if g.is_directed() || arc.tail <= arc.head: {
                ids.push_back(e);
            }
        }
        e += 1;
    }
    var i: int = 1;
    while i < ids.size(): {
        let current = ids.at(i);
        let key = g.edges.at(current).weight;
        var j = i - 1;
        while j >= 0 && g.edges.at(ids.at(j)).weight > key: {
            ids.at(j + 1) = ids.at(j);
            j -= 1;
        }
        ids.at(j + 1) = current;
        i += 1;
    }
    return ids;
}



template(V: type, W: type)
fn kruskal(g: &const shared AdjacencyList{V, W}) -> SpanningTree{V}: {
    var out = SpanningTree{V}();
    fill_int_vector(out.parent, g.order(), GRAPH_NIL);
    var forest = UnionFind();
    forest.prepare(g.order());
    let sorted = edges_by_weight{V, W}(g);
    for e: &const in sorted: {
        let arc: &const = g.edges.at(e);
        if forest.unite(arc.tail, arc.head): {
            out.arcs.push_back(e);
            out.weight += arc.weight;
            out.parent.at(arc.head) = arc.tail;
        }
        if forest.single_component(): {
            break;
        }
    }
    out.components = forest.components;
    return out;
}


template(V: type, W: type)
fn mst_weight(g: &const shared AdjacencyList{V, W}) -> int: {
    let tree = kruskal{V, W}(g);
    return tree.weight;
}


template(V: type, W: type)
fn maximum_spanning_tree(g: &const shared AdjacencyList{V, W}) -> SpanningTree{V}: {
    var out = SpanningTree{V}();
    fill_int_vector(out.parent, g.order(), GRAPH_NIL);
    var forest = UnionFind();
    forest.prepare(g.order());
    var sorted = edges_by_weight{V, W}(g);
    reverse_int_vector(sorted);
    for e: &const in sorted: {
        let arc: &const = g.edges.at(e);
        if forest.unite(arc.tail, arc.head): {
            out.arcs.push_back(e);
            out.weight += arc.weight;
        }
    }
    out.components = forest.components;
    return out;
}



template(V: type, W: type)
fn verify_minimality(g: &const shared AdjacencyList{V, W},
                     tree: &const shared SpanningTree{V}) -> bool: {
    var e: int = 0;
    while e < g.edges.size(): {
        let arc: &const = g.edges.at(e);
        if arc.alive && tree.contains_arc(e) == false: {
            var heaviest: int = 0;
            for t: &const in tree.arcs: {
                let chosen: &const = g.edges.at(t);
                if chosen.weight > heaviest: {
                    heaviest = chosen.weight;
                }
            }
            if arc.weight < heaviest - g.order(): {
                return false;
            }
        }
        e += 1;
    }
    return true;
}


template(V: type, W: type)
fn second_best_tree(g: &const shared AdjacencyList{V, W}) -> int: {
    let base = kruskal{V, W}(g);
    var best = GRAPH_INFINITY;
    for banned: &const in base.arcs: {
        var trimmed = builders::to_directed{V, W}(g);
        trimmed.direction = g.direction;
        discard trimmed.disconnect(banned);
        let candidate = kruskal{V, W}(trimmed);
        if candidate.components == 1 && candidate.weight < best: {
            if candidate.weight > base.weight: {
                best = candidate.weight;
            }
        }
    }
    return best;
}

}








namespace matching: {


template(V: type)
struct Pairing: {

    fn size(self: &const shared) -> int: {
        var total: int = 0;
        var v: int = 0;
        while v < .partner.size(): {
            if .partner.at(v) != GRAPH_NIL && .partner.at(v) > v: {
                total += 1;
            }
            v += 1;
        }
        return total;
    }

    fn covered(self: &const shared, v: int) -> bool: {
        return .partner.at(v) != GRAPH_NIL;
    }

    fn partner_of(self: &const shared, v: int) -> int: {
        return .partner.at(v);
    }

    fn perfect(self: &const shared) -> bool: {
        for p: &const in .partner: {
            if p == GRAPH_NIL: {
                return false;
            }
        }
        return true;
    }

    
    fn pairs(self: &const shared) -> vector{pair{int, int}}: {
        var out = vector{pair{int, int}}();
        var v: int = 0;
        while v < .partner.size(): {
            let p = .partner.at(v);
            if p != GRAPH_NIL && p > v: {
                out.push_back(pair{int, int}(first: v, second: p));
            }
            v += 1;
        }
        return out;
    }

    partner: vector{int};
    payload: V;
    augmentations: int = 0;
}





template(V: type, W: type)
fn augment_from(g: &const shared AdjacencyList{V, W},
                v: int,
                state: &unique Pairing{V},
                seen: &unique vector{bool}) -> bool: {
    var stack = vector{int}();
    var cursor = vector{int}();
    var trail = vector{int}();
    stack.push_back(v);
    cursor.push_back(0);
    while stack.empty() == false: {
        let u = stack.back();
        let at = cursor.back();
        let incident: &const = g.vertices.at(u).incident;
        if at >= incident.size(): {
            stack.pop_back();
            cursor.pop_back();
            if trail.empty() == false: {
                trail.pop_back();
            }
            continue;
        }
        cursor.at(cursor.size() - 1) = at + 1;
        let arc: &const = g.edges.at(incident.at(at));
        if arc.alive == false: {
            continue;
        }
        let target = arc.head;
        if seen.at(target): {
            continue;
        }
        seen.at(target) = true;
        let held = state.partner.at(target);
        if held == GRAPH_NIL: {
            state.partner.at(target) = u;
            state.partner.at(u) = target;
            state.augmentations += 1;
            return true;
        }
        trail.push_back(target);
        stack.push_back(held);
        cursor.push_back(0);
    }
    return false;
}




template(V: type, W: type)
fn maximum_bipartite_matching(g: &const shared AdjacencyList{V, W}) -> Pairing{V}: {
    var out = Pairing{V}();
    fill_int_vector(out.partner, g.order(), GRAPH_NIL);
    let colors = connectivity::two_coloring{V, W}(g);
    if colors.bipartite() == false: {
        return out;
    }
    let left = colors.left_vertices();
    for v: &const in left: {
        if out.partner.at(v) == GRAPH_NIL: {
            var seen = vector{bool}();
            fill_bool_vector(seen, g.order(), false);
            discard augment_from{V, W}(g, v, out, seen);
        }
    }
    assert out.size() >= 0;
    return out;
}



template(V: type, W: type)
fn greedy_matching(g: &const shared AdjacencyList{V, W}) -> Pairing{V}: {
    var out = Pairing{V}();
    fill_int_vector(out.partner, g.order(), GRAPH_NIL);
    var v: int = 0;
    while v < g.order(): {
        if out.partner.at(v) == GRAPH_NIL: {
            for e: &const in g.vertices.at(v).incident: {
                let arc: &const = g.edges.at(e);
                if arc.alive && out.partner.at(arc.head) == GRAPH_NIL: {
                    if arc.head != v: {
                        out.partner.at(v) = arc.head;
                        out.partner.at(arc.head) = v;
                        break;
                    }
                }
            }
        }
        v += 1;
    }
    return out;
}



template(V: type, W: type)
fn matching_with_warm_start(g: &const shared AdjacencyList{V, W}) -> Pairing{V}: {
    var out = greedy_matching{V, W}(g);
    let colors = connectivity::two_coloring{V, W}(g);
    if colors.bipartite() == false: {
        return out;
    }
    for v: &const in colors.left_vertices(): {
        if out.partner.at(v) == GRAPH_NIL: {
            var seen = vector{bool}();
            fill_bool_vector(seen, g.order(), false);
            discard augment_from{V, W}(g, v, out, seen);
        }
    }
    return out;
}




template(V: type, W: type)
fn minimum_vertex_cover(g: &const shared AdjacencyList{V, W}) -> vector{int}: {
    let paired = maximum_bipartite_matching{V, W}(g);
    let colors = connectivity::two_coloring{V, W}(g);
    var visited = vector{bool}();
    fill_bool_vector(visited, g.order(), false);
    var queue = vector{int}();
    for v: &const in colors.left_vertices(): {
        if paired.partner.at(v) == GRAPH_NIL: {
            visited.at(v) = true;
            queue.push_back(v);
        }
    }
    var head: int = 0;
    while head < queue.size(): {
        let v = queue.at(head);
        head += 1;
        for e: &const in g.vertices.at(v).incident: {
            let arc: &const = g.edges.at(e);
            if arc.alive == false: {
                continue;
            }
            if visited.at(arc.head) == false && paired.partner.at(v) != arc.head: {
                visited.at(arc.head) = true;
                let held = paired.partner.at(arc.head);
                if held != GRAPH_NIL && visited.at(held) == false: {
                    visited.at(held) = true;
                    queue.push_back(held);
                }
            }
        }
    }
    var cover = vector{int}();
    for v: &const in colors.left_vertices(): {
        if visited.at(v) == false: {
            cover.push_back(v);
        }
    }
    for v: &const in colors.right_vertices(): {
        if visited.at(v): {
            cover.push_back(v);
        }
    }
    return cover;
}


template(V: type, W: type)
fn maximum_independent_set(g: &const shared AdjacencyList{V, W}) -> vector{int}: {
    let cover = minimum_vertex_cover{V, W}(g);
    var inside = vector{bool}();
    fill_bool_vector(inside, g.order(), true);
    for v: &const in cover: {
        inside.at(v) = false;
    }
    var out = vector{int}();
    var v: int = 0;
    while v < g.order(): {
        if inside.at(v): {
            out.push_back(v);
        }
        v += 1;
    }
    return out;
}





template(V: type, W: type)
fn hall_condition_holds(g: &const shared AdjacencyList{V, W}) -> bool: {
    let colors = connectivity::two_coloring{V, W}(g);
    let left = colors.left_vertices();
    var neighbours = set{int}();
    for v: &const in left: {
        if g.degree(v) == 0: {
            return false;
        }
        for e: &const in g.vertices.at(v).incident: {
            let arc: &const = g.edges.at(e);
            if arc.alive: {
                discard neighbours.insert(arc.head);
            }
        }
    }
    return neighbours.size() >= left.size();
}

}








namespace flow: {


struct FlowArc: {

    fn residual(self: &const shared) -> int: {
        return .capacity - .flow;
    }

    fn saturated(self: &const shared) -> bool: {
        return .capacity - .flow <= 0;
    }

    fn twin_id(self: &const shared) -> int: {
        return .id ^ 1;
    }

    tail: int = 0;
    head: int = 0;
    capacity: int = 0;
    flow: int = 0;
    id: int = 0;
}





struct FlowNetwork: {

    fn order(self: &const shared) -> int: {
        return .incident.size();
    }

    fn arc_count(self: &const shared) -> int: {
        return .arcs.size();
    }

    fn prepare(self: &unique, order: int): {
        .incident.clear();
        .arcs.clear();
        var i: int = 0;
        while i < order: {
            .incident.push_back(vector{int}());
            i += 1;
        }
        .total_flow = 0;
    }

    fn add_arc(self: &unique, tail: int, head: int, capacity: int) -> int: {
        let forward = .arcs.size();
        .arcs.push_back(FlowArc(tail: tail,
                                head: head,
                                capacity: capacity,
                                id: forward));
        .incident.at(tail).push_back(forward);
        let backward = .arcs.size();
        .arcs.push_back(FlowArc(tail: head,
                                head: tail,
                                capacity: 0,
                                id: backward));
        .incident.at(head).push_back(backward);
        return forward;
    }

    
    fn add_bidirectional(self: &unique, a: int, b: int, capacity: int) -> int: {
        let first = .add_arc(a, b, capacity);
        .arcs.at(first ^ 1).capacity = capacity;
        return first;
    }

    fn push(self: &unique, arc: int, amount: int): {
        .arcs.at(arc).flow += amount;
        .arcs.at(arc ^ 1).flow -= amount;
    }

    fn residual_of(self: &const shared, arc: int) -> int: {
        return .arcs.at(arc).capacity - .arcs.at(arc).flow;
    }

    fn reset_flow(self: &unique): {
        for a: &unique in .arcs: {
            a.flow = 0;
        }
        .total_flow = 0;
    }

    
    
    fn outflow(self: &const shared, source: int) -> int: {
        var total: int = 0;
        for e: &const in .incident.at(source): {
            let a: &const = .arcs.at(e);
            if a.flow > 0: {
                total += a.flow;
            }
        }
        return total;
    }

    incident: vector{vector{int}};
    arcs: vector{FlowArc};
    total_flow: int = 0;
}


template(V: type, W: type)
fn network_from(g: &const shared AdjacencyList{V, W}) -> FlowNetwork: {
    var net = FlowNetwork();
    net.prepare(g.order());
    for arc: &const in g.edges: {
        if arc.alive: {
            if g.is_directed(): {
                discard net.add_arc(arc.tail, arc.head, arc.weight);
            } else: {
                if arc.tail < arc.head: {
                    discard net.add_bidirectional(arc.tail, arc.head, arc.weight);
                }
            }
        }
    }
    return net;
}



fn find_augmenting_path(net: &unique FlowNetwork,
                        source: int,
                        sink: int,
                        used: &unique vector{int}) -> int: {
    fill_int_vector(used, net.order(), GRAPH_NIL);
    var queue = vector{int}();
    queue.push_back(source);
    var head: int = 0;
    while head < queue.size(): {
        let v = queue.at(head);
        head += 1;
        if v == sink: {
            break;
        }
        for e: &const in net.incident.at(v): {
            let a: &const = net.arcs.at(e);
            if a.capacity - a.flow <= 0: {
                continue;
            }
            if a.head != source && used.at(a.head) == GRAPH_NIL: {
                used.at(a.head) = e;
                queue.push_back(a.head);
            }
        }
    }
    if used.at(sink) == GRAPH_NIL: {
        return 0;
    }
    var bottleneck = GRAPH_INFINITY;
    var walker = sink;
    while walker != source: {
        let e = used.at(walker);
        let slack = net.residual_of(e);
        if slack < bottleneck: {
            bottleneck = slack;
        }
        walker = net.arcs.at(e).tail;
    }
    return bottleneck;
}





fn max_flow(net: &unique FlowNetwork, source: int, sink: int) -> int: {
    net.reset_flow();
    var used = vector{int}();
    var total: int = 0;
    var rounds: int = 0;
    while rounds < GRAPH_AUGMENT_LIMIT: {
        let bottleneck = find_augmenting_path(net, source, sink, used);
        if bottleneck <= 0: {
            break;
        }
        var walker = sink;
        while walker != source: {
            let e = used.at(walker);
            net.push(e, bottleneck);
            walker = net.arcs.at(e).tail;
        }
        total += bottleneck;
        rounds += 1;
    }
    net.total_flow = total;
    assert total >= 0;
    return total;
}



fn blocking_flow(net: &unique FlowNetwork,
                 level: &const shared vector{int},
                 source: int,
                 sink: int) -> int: {
    var pushed: int = 0;
    var cursor = vector{int}();
    fill_int_vector(cursor, net.order(), 0);
    loop: {
        var trail = vector{int}();
        var v = source;
        var blocked = false;
        while v != sink && blocked == false: {
            var advanced = false;
            while cursor.at(v) < net.incident.at(v).size() && advanced == false: {
                let e = net.incident.at(v).at(cursor.at(v));
                let a: &const = net.arcs.at(e);
                if a.capacity - a.flow > 0 && level.at(a.head) == level.at(v) + 1: {
                    trail.push_back(e);
                    v = a.head;
                    advanced = true;
                } else: {
                    cursor.at(v) += 1;
                }
            }
            if advanced == false: {
                if trail.empty(): {
                    blocked = true;
                } else: {
                    let last = trail.back();
                    trail.pop_back();
                    v = net.arcs.at(last).tail;
                    cursor.at(v) += 1;
                }
            }
        }
        if blocked: {
            break;
        }
        var bottleneck = GRAPH_INFINITY;
        for e: &const in trail: {
            let slack = net.residual_of(e);
            if slack < bottleneck: {
                bottleneck = slack;
            }
        }
        for e: &const in trail: {
            net.push(e, bottleneck);
        }
        pushed += bottleneck;
    }
    return pushed;
}


fn level_graph(net: &const shared FlowNetwork, source: int) -> vector{int}: {
    var level = vector{int}();
    fill_int_vector(level, net.order(), GRAPH_NIL);
    var queue = vector{int}();
    level.at(source) = 0;
    queue.push_back(source);
    var head: int = 0;
    while head < queue.size(): {
        let v = queue.at(head);
        head += 1;
        for e: &const in net.incident.at(v): {
            let a: &const = net.arcs.at(e);
            if a.capacity - a.flow > 0 && level.at(a.head) == GRAPH_NIL: {
                level.at(a.head) = level.at(v) + 1;
                queue.push_back(a.head);
            }
        }
    }
    return level;
}


fn dinic_max_flow(net: &unique FlowNetwork, source: int, sink: int) -> int: {
    net.reset_flow();
    var total: int = 0;
    var phases: int = 0;
    while phases < net.order() + 1: {
        let level = level_graph(net, source);
        if level.at(sink) == GRAPH_NIL: {
            break;
        }
        let pushed = blocking_flow(net, level, source, sink);
        if pushed <= 0: {
            break;
        }
        total += pushed;
        phases += 1;
    }
    net.total_flow = total;
    return total;
}



fn min_cut_side(net: &const shared FlowNetwork, source: int) -> vector{bool}: {
    var side = vector{bool}();
    fill_bool_vector(side, net.order(), false);
    var queue = vector{int}();
    side.at(source) = true;
    queue.push_back(source);
    var head: int = 0;
    while head < queue.size(): {
        let v = queue.at(head);
        head += 1;
        for e: &const in net.incident.at(v): {
            let a: &const = net.arcs.at(e);
            if a.capacity - a.flow > 0 && side.at(a.head) == false: {
                side.at(a.head) = true;
                queue.push_back(a.head);
            }
        }
    }
    return side;
}


fn min_cut_arcs(net: &const shared FlowNetwork, source: int) -> vector{int}: {
    let side = min_cut_side(net, source);
    var out = vector{int}();
    var e: int = 0;
    while e < net.arcs.size(): {
        let a: &const = net.arcs.at(e);
        if a.capacity > 0 && side.at(a.tail) && side.at(a.head) == false: {
            out.push_back(e);
        }
        e += 1;
    }
    return out;
}



fn cut_capacity(net: &const shared FlowNetwork, source: int) -> int: {
    let crossing = min_cut_arcs(net, source);
    var total: int = 0;
    for e: &const in crossing: {
        total += net.arcs.at(e).capacity;
    }
    return total;
}



template(V: type, W: type)
fn matching_by_flow(g: &const shared AdjacencyList{V, W}) -> int: {
    let colors = connectivity::two_coloring{V, W}(g);
    if colors.bipartite() == false: {
        return 0;
    }
    var net = FlowNetwork();
    let super_source = g.order();
    let super_sink = g.order() + 1;
    net.prepare(g.order() + 2);
    for v: &const in colors.left_vertices(): {
        discard net.add_arc(super_source, v, 1);
        for e: &const in g.vertices.at(v).incident: {
            let arc: &const = g.edges.at(e);
            if arc.alive: {
                discard net.add_arc(v, arc.head, 1);
            }
        }
    }
    for v: &const in colors.right_vertices(): {
        discard net.add_arc(v, super_sink, 1);
    }
    return max_flow(net, super_source, super_sink);
}



template(V: type, W: type)
fn edge_connectivity(g: &const shared AdjacencyList{V, W},
                     source: int,
                     sink: int) -> int: {
    var net = FlowNetwork();
    net.prepare(g.order());
    for arc: &const in g.edges: {
        if arc.alive: {
            discard net.add_arc(arc.tail, arc.head, 1);
        }
    }
    return max_flow(net, source, sink);
}



template(V: type, W: type)
fn global_min_cut(g: &const shared AdjacencyList{V, W}) -> int: {
    if g.order() < 2: {
        return 0;
    }
    var best = GRAPH_INFINITY;
    var sink: int = 1;
    while sink < g.order(): {
        var net = network_from{V, W}(g);
        let value = max_flow(net, 0, sink);
        if value < best: {
            best = value;
        }
        sink += 1;
    }
    return best;
}

}









template(V: type, W: type)
fn shortest_hops(g: &const shared AdjacencyList{V, W},
                 source: int,
                 target: int) -> int: {
    return traversal::hop_distance{V, W}(g, source, target);
}


template(V: type, W: type)
fn cheapest_route(g: &const shared AdjacencyList{V, W},
                  source: int,
                  target: int) -> vector{int}: {
    return shortest_path::shortest_route{V, W}(g, source, target);
}


template(V: type, W: type)
fn fully_connected(g: &const shared AdjacencyList{V, W}) -> bool: {
    if g.is_directed(): {
        return connectivity::is_strongly_connected{V, W}(g);
    }
    return connectivity::is_connected{V, W}(g);
}



template(V: type, W: type)
fn cross_check(g: &const shared AdjacencyList{V, W}) -> bool: {
    let by_bfs = connectivity::connected_components{V, W}(g);
    let by_union = connectivity::components_by_union{V, W}(g);
    if by_bfs.total != by_union.total: {
        return false;
    }
    let tarjan = connectivity::tarjan_scc{V, W}(g);
    let kosaraju = connectivity::kosaraju_scc{V, W}(g);
    if tarjan.total != kosaraju.total: {
        return false;
    }
    let prim_tree = spanning::prim{V, W}(g, 0);
    let kruskal_tree = spanning::kruskal{V, W}(g);
    if by_bfs.total == 1 && prim_tree.weight != kruskal_tree.weight: {
        return false;
    }
    return true;
}


template(V: type, W: type)
fn report(g: &const shared AdjacencyList{V, W}) -> string: {
    var out = string();
    out.append(builders::describe{V, W}(g));
    out.append(" components=");
    out.append(to_string(connectivity::component_count{V, W}(g)));
    out.append(" acyclic=");
    if connectivity::is_acyclic{V, W}(g): {
        out.append("yes");
    } else: {
        out.append("no");
    }
    out.append(" bipartite=");
    if connectivity::is_bipartite{V, W}(g): {
        out.append("yes");
    } else: {
        out.append("no");
    }
    out.append(" mst=");
    out.append(to_string(spanning::mst_weight{V, W}(g)));
    return out;
}




fn demo_traversal(): {
    let grid = builders::grid_graph{int, int}(4, 4);
    let found = traversal::bfs{int, int}(grid, 0);
    println(to_string(found.reached_count()));
    println(to_string(found.eccentricity()));
    var watcher = traversal::Visitor{int, int}();
    watcher.stop_after = 8;
    let limited = traversal::bfs_visit{int, int}(grid, 0, watcher);
    assert limited.complete == false;
    let levels = traversal::bfs_levels{int, int}(grid, 0);
    for level: &const in levels: {
        println(to_string(level.size()));
    }
}


fn demo_shortest_paths(): {
    var dag = builders::directed{int, int}(6);
    discard dag.connect(0, 1, 2000);
    discard dag.connect(0, 2, 4000);
    discard dag.connect(1, 2, 1000);
    discard dag.connect(1, 3, 7000);
    discard dag.connect(2, 4, 3000);
    discard dag.connect(3, 5, 1000);
    discard dag.connect(4, 3, 2000);
    discard dag.connect(4, 5, 5000);

    let kahn = connectivity::topological_sort_kahn{int, int}(dag);
    assert kahn.valid();
    let by_dfs = connectivity::topological_sort_dfs{int, int}(dag);
    assert by_dfs.length() == kahn.length();

    let quick = shortest_path::dijkstra{int, int}(dag, 0);
    let careful = shortest_path::bellman_ford{int, int}(dag, 0);
    var v: int = 0;
    while v < dag.order(): {
        assert quick.dist.at(v) == careful.dist.at(v);
        v += 1;
    }
    prove careful.negative_cycle == false;

    let linear = shortest_path::dag_shortest_path{int, int}(dag, 0);
    println(to_string(linear.to(5)));
    let route = shortest_path::shortest_route{int, int}(dag, 0, 5);
    println(to_string(route.size()));

    let dense = builders::densify{int, int, 6}(dag);
    let pairs = shortest_path::floyd_warshall{int, int, 6}(dense);
    println(to_string(pairs.diameter()));
    println(to_string(pairs.center()));
    discard shortest_path::transitive_closure{int, int, 6}(dense);
}


fn demo_spanning(): {
    var net = builders::undirected{int, int}(6);
    discard net.connect(0, 1, 4000);
    discard net.connect(0, 2, 3000);
    discard net.connect(1, 2, 1000);
    discard net.connect(1, 3, 2000);
    discard net.connect(2, 3, 4000);
    discard net.connect(3, 4, 2000);
    discard net.connect(4, 5, 6000);

    let grown = spanning::prim{int, int}(net, 0);
    let sorted = spanning::kruskal{int, int}(net);
    assert grown.weight == sorted.weight;
    assert sorted.spans(net.order());
    println(to_string(sorted.average_weight()));
    let heaviest = spanning::maximum_spanning_tree{int, int}(net);
    assert heaviest.weight >= sorted.weight;
    assert spanning::verify_minimality{int, int}(net, sorted);
}


fn demo_connectivity(): {
    var web = builders::directed{int, int}(8);
    discard web.connect_unweighted(0, 1);
    discard web.connect_unweighted(1, 2);
    discard web.connect_unweighted(2, 0);
    discard web.connect_unweighted(2, 3);
    discard web.connect_unweighted(3, 4);
    discard web.connect_unweighted(4, 5);
    discard web.connect_unweighted(5, 3);
    discard web.connect_unweighted(6, 7);

    let strong = connectivity::tarjan_scc{int, int}(web);
    let also_strong = connectivity::kosaraju_scc{int, int}(web);
    assert strong.total == also_strong.total;
    let collapsed = connectivity::condensation{int, int}(web, strong);
    assert connectivity::is_acyclic{int, int}(collapsed);
    for bucket: &const in strong.buckets(): {
        println(to_string(bucket.size()));
    }

    let ring = builders::cycle_graph{int, int}(7);
    assert connectivity::has_undirected_cycle{int, int}(ring);
    assert connectivity::is_bipartite{int, int}(ring) == false;
    let even_ring = builders::cycle_graph{int, int}(8);
    assert connectivity::is_bipartite{int, int}(even_ring);

    let chain = builders::path_graph{int, int}(6);
    let cuts = connectivity::find_cuts{int, int}(chain);
    println(to_string(cuts.bridge_count()));
    println(to_string(cuts.articulation_list().size()));
}


fn demo_matching_and_flow(): {
    let jobs = builders::complete_bipartite{int, int}(3, 4);
    let paired = matching::maximum_bipartite_matching{int, int}(jobs);
    let warm = matching::matching_with_warm_start{int, int}(jobs);
    assert paired.size() == warm.size();
    let by_flow = flow::matching_by_flow{int, int}(jobs);
    assert by_flow == paired.size();
    for entry: &const in paired.pairs(): {
        println(to_string(entry.first));
        println(to_string(entry.second));
    }
    let cover = matching::minimum_vertex_cover{int, int}(jobs);
    assert cover.size() == paired.size();
    discard matching::maximum_independent_set{int, int}(jobs);
    assert matching::hall_condition_holds{int, int}(jobs);

    var pipes = FlowNetwork();
    pipes.prepare(6);
    discard pipes.add_arc(0, 1, 16000);
    discard pipes.add_arc(0, 2, 13000);
    discard pipes.add_arc(1, 3, 12000);
    discard pipes.add_arc(2, 1, 4000);
    discard pipes.add_arc(2, 4, 14000);
    discard pipes.add_arc(3, 2, 9000);
    discard pipes.add_arc(3, 5, 20000);
    discard pipes.add_arc(4, 3, 7000);
    discard pipes.add_arc(4, 5, 4000);

    let value = flow::max_flow(pipes, 0, 5);
    assert value == pipes.outflow(0);
    assert value == flow::cut_capacity(pipes, 0);
    let fast = flow::dinic_max_flow(pipes, 0, 5);
    assert fast == value;
    let crossing = flow::min_cut_arcs(pipes, 0);
    println(to_string(crossing.size()));
}


fn demo_graph_algorithms(): {
    demo_traversal();
    demo_shortest_paths();
    demo_spanning();
    demo_connectivity();
    demo_matching_and_flow();

    let sample = builders::complete_graph{int, int}(5);
    println(report{int, int}(sample));
    assert cross_check{int, int}(sample);
    assert fully_connected{int, int}(sample);
    println(to_string(cheapest_route{int, int}(sample, 0, 4).size()));
    println(to_string(shortest_hops{int, int}(sample, 0, 4)));
}

}






namespace json: {






static CHAR_QUOTE: char = '"';
static CHAR_BACKSLASH: char = '\\';
static CHAR_SLASH: char = '/';
static CHAR_NEWLINE: char = '\n';
static CHAR_RETURN: char = '\r';
static CHAR_TAB: char = '\t';
static CHAR_BACKSPACE: char = '\b';
static CHAR_FORMFEED: char = '\f';
static CHAR_SPACE: char = ' ';
static CHAR_NUL: char = '\0';

static CHAR_LBRACE: char = '{';
static CHAR_RBRACE: char = '}';
static CHAR_LBRACKET: char = '[';
static CHAR_RBRACKET: char = ']';
static CHAR_COLON: char = ':';
static CHAR_COMMA: char = ',';

static CHAR_MINUS: char = '-';
static CHAR_PLUS: char = '+';
static CHAR_DOT: char = '.';
static CHAR_ZERO: char = '0';
static CHAR_NINE: char = '9';
static CHAR_LOWER_A: char = 'a';
static CHAR_LOWER_B: char = 'b';
static CHAR_LOWER_E: char = 'e';
static CHAR_LOWER_F: char = 'f';
static CHAR_LOWER_N: char = 'n';
static CHAR_LOWER_R: char = 'r';
static CHAR_LOWER_T: char = 't';
static CHAR_LOWER_U: char = 'u';
static CHAR_LOWER_Z: char = 'z';
static CHAR_UPPER_A: char = 'A';
static CHAR_UPPER_E: char = 'E';
static CHAR_UPPER_F: char = 'F';
static CHAR_UPPER_Z: char = 'Z';



static WORD_TRUE: string = "true";
static WORD_FALSE: string = "false";
static WORD_NULL: string = "null";

static TEXT_LBRACE: string = "{";
static TEXT_RBRACE: string = "}";
static TEXT_LBRACKET: string = "[";
static TEXT_RBRACKET: string = "]";
static TEXT_COLON: string = ":";
static TEXT_COMMA: string = ",";
static TEXT_COLON_SPACE: string = ": ";
static TEXT_COMMA_SPACE: string = ", ";
static TEXT_EMPTY: string = "";
static TEXT_EMPTY_ARRAY: string = "[]";
static TEXT_EMPTY_OBJECT: string = "{}";
static TEXT_SPACE: string = " ";
static TEXT_NEWLINE: string = "\n";
static TEXT_TWO_SPACES: string = "  ";
static TEXT_FOUR_SPACES: string = "    ";
static TEXT_TAB: string = "\t";



static ESCAPE_QUOTE: string = "\\\"";
static ESCAPE_BACKSLASH: string = "\\\\";
static ESCAPE_SLASH: string = "\\/";
static ESCAPE_NEWLINE: string = "\\n";
static ESCAPE_RETURN: string = "\\r";
static ESCAPE_TAB: string = "\\t";
static ESCAPE_BACKSPACE: string = "\\b";
static ESCAPE_FORMFEED: string = "\\f";
static ESCAPE_UNICODE: string = "\\u";


static MAX_DEPTH: int = 128;
static MAX_MANTISSA_DIGITS: int = 17;
static MAX_EXPONENT: int = 308;
static MIN_EXPONENT: int = -308;
static UNICODE_ESCAPE_DIGITS: int = 4;
static SURROGATE_HIGH_BEGIN: int = 55296;
static SURROGATE_HIGH_END: int = 56319;
static SURROGATE_LOW_BEGIN: int = 56320;
static SURROGATE_LOW_END: int = 57343;
static SURROGATE_OFFSET: int = 65536;
static REPLACEMENT_CODEPOINT: int = 65533;
static ASCII_LIMIT: int = 128;
static CONTROL_LIMIT: int = 32;



enum JsonKind: {
    Null;
    Bool;
    Number;
    String;
    Array;
    Object;
}

enum TokenKind: {
    End;
    ObjectBegin;
    ObjectEnd;
    ArrayBegin;
    ArrayEnd;
    Colon;
    Comma;
    String;
    Number;
    True;
    False;
    Null;
    Invalid = 100;
}

enum ErrorCode: {
    None;
    UnexpectedEnd;
    UnexpectedCharacter;
    UnterminatedString;
    BadEscape;
    BadUnicodeEscape;
    ControlCharacterInString;
    LeadingZero;
    MissingFraction;
    MissingExponent;
    NumberOverflow;
    TrailingContent;
    ExpectedColon;
    ExpectedCommaOrEnd;
    ExpectedKey;
    ExpectedValue;
    DepthExceeded;
    LoneSurrogate;
}





struct Position: {

    fn advance_over(self: &unique, c: char): {
        .offset += 1;
        if c == CHAR_NEWLINE: {
            .line += 1;
            .column = 1;
        } else: {
            .column += 1;
        }
    }

    fn describe(self: &const shared) -> string: {
        var out: string = "line ";
        out.append(to_string(.line));
        out.append(", column ");
        out.append(to_string(.column));
        out.append(" (offset ");
        out.append(to_string(.offset));
        out.append(")");
        return out;
    }

    offset: int = 0;
    line: int = 1;
    column: int = 1;
}





struct EscapeRow: {
    marker: char = CHAR_NUL;
    decoded: char = CHAR_NUL;
    spelling: string;
    name: string;
}

fn escape_table() -> vector{EscapeRow}: {
    var rows: vector{EscapeRow};
    rows.push_back(EscapeRow(marker: '"', decoded: '"', spelling: "\\\"", name: "quotation mark"));
    rows.push_back(EscapeRow(marker: '\\', decoded: '\\', spelling: "\\\\", name: "reverse solidus"));
    rows.push_back(EscapeRow(marker: '/', decoded: '/', spelling: "\\/", name: "solidus"));
    rows.push_back(EscapeRow(marker: 'b', decoded: '\b', spelling: "\\b", name: "backspace"));
    rows.push_back(EscapeRow(marker: 'f', decoded: '\f', spelling: "\\f", name: "form feed"));
    rows.push_back(EscapeRow(marker: 'n', decoded: '\n', spelling: "\\n", name: "line feed"));
    rows.push_back(EscapeRow(marker: 'r', decoded: '\r', spelling: "\\r", name: "carriage return"));
    rows.push_back(EscapeRow(marker: 't', decoded: '\t', spelling: "\\t", name: "tab"));
    return rows;
}



fn decode_escape(marker: char) -> char: {
    if marker == '"': {
        return '"';
    }
    if marker == '\\': {
        return '\\';
    }
    if marker == '/': {
        return '/';
    }
    if marker == 'b': {
        return '\b';
    }
    if marker == 'f': {
        return '\f';
    }
    if marker == 'n': {
        return '\n';
    }
    if marker == 'r': {
        return '\r';
    }
    if marker == 't': {
        return '\t';
    }
    return CHAR_NUL;
}


fn encode_escape(c: char) -> string: {
    if c == '"': {
        return "\\\"";
    }
    if c == '\\': {
        return "\\\\";
    }
    if c == '\n': {
        return "\\n";
    }
    if c == '\r': {
        return "\\r";
    }
    if c == '\t': {
        return "\\t";
    }
    if c == '\b': {
        return "\\b";
    }
    if c == '\f': {
        return "\\f";
    }
    return "";
}

fn escape_name(marker: char) -> string: {
    if marker == 'n': {
        return "line feed";
    }
    if marker == 't': {
        return "tab";
    }
    if marker == 'r': {
        return "carriage return";
    }
    if marker == 'b': {
        return "backspace";
    }
    if marker == 'f': {
        return "form feed";
    }
    if marker == 'u': {
        return "unicode escape";
    }
    if marker == '/': {
        return "solidus";
    }
    if marker == '"': {
        return "quotation mark";
    }
    if marker == '\\': {
        return "reverse solidus";
    }
    return "unknown escape";
}



fn is_whitespace(c: char) => c == ' ' || c == '\t' || c == '\n' || c == '\r';

fn is_digit(c: char) => c >= '0' && c <= '9';

fn is_nonzero_digit(c: char) => c >= '1' && c <= '9';

fn is_hex_digit(c: char) -> bool: {
    if c >= '0' && c <= '9': {
        return true;
    }
    if c >= 'a' && c <= 'f': {
        return true;
    }
    if c >= 'A' && c <= 'F': {
        return true;
    }
    return false;
}

fn is_structural(c: char) -> bool: {
    return c == '{' || c == '}' || c == '[' || c == ']' || c == ':' || c == ',';
}

fn is_control(c: char) -> bool: {
    return int(c) < CONTROL_LIMIT;
}

fn is_letter(c: char) -> bool: {
    if c >= 'a' && c <= 'z': {
        return true;
    }
    if c >= 'A' && c <= 'Z': {
        return true;
    }
    return false;
}

fn digit_value(c: char) -> int: {
    return int(c) - int('0');
}

fn hex_value(c: char) -> int: {
    if c >= '0' && c <= '9': {
        return int(c) - int('0');
    }
    if c >= 'a' && c <= 'f': {
        return int(c) - int('a') + 10;
    }
    if c >= 'A' && c <= 'F': {
        return int(c) - int('A') + 10;
    }
    return -1;
}



fn hex_digit(value: int) -> char: {
    if value == 0: { return '0'; }
    if value == 1: { return '1'; }
    if value == 2: { return '2'; }
    if value == 3: { return '3'; }
    if value == 4: { return '4'; }
    if value == 5: { return '5'; }
    if value == 6: { return '6'; }
    if value == 7: { return '7'; }
    if value == 8: { return '8'; }
    if value == 9: { return '9'; }
    if value == 10: { return 'a'; }
    if value == 11: { return 'b'; }
    if value == 12: { return 'c'; }
    if value == 13: { return 'd'; }
    if value == 14: { return 'e'; }
    if value == 15: { return 'f'; }
    return '?';
}



fn error_text(code: ErrorCode) -> string: {
    if code == ErrorCode::None: {
        return "no error";
    }
    if code == ErrorCode::UnexpectedEnd: {
        return "unexpected end of input";
    }
    if code == ErrorCode::UnexpectedCharacter: {
        return "unexpected character";
    }
    if code == ErrorCode::UnterminatedString: {
        return "unterminated string literal, expected a closing '\"'";
    }
    if code == ErrorCode::BadEscape: {
        return "invalid escape sequence after '\\'";
    }
    if code == ErrorCode::BadUnicodeEscape: {
        return "invalid \\uXXXX escape, expected four hexadecimal digits";
    }
    if code == ErrorCode::ControlCharacterInString: {
        return "raw control character in string, use \\u00XX instead";
    }
    if code == ErrorCode::LeadingZero: {
        return "numbers may not have a leading zero";
    }
    if code == ErrorCode::MissingFraction: {
        return "expected at least one digit after '.'";
    }
    if code == ErrorCode::MissingExponent: {
        return "expected at least one digit after 'e'";
    }
    if code == ErrorCode::NumberOverflow: {
        return "number is out of the representable range";
    }
    if code == ErrorCode::TrailingContent: {
        return "trailing content after the top level value";
    }
    if code == ErrorCode::ExpectedColon: {
        return "expected ':' between an object key and its value";
    }
    if code == ErrorCode::ExpectedCommaOrEnd: {
        return "expected ',' or a closing bracket";
    }
    if code == ErrorCode::ExpectedKey: {
        return "expected a string key";
    }
    if code == ErrorCode::ExpectedValue: {
        return "expected a value";
    }
    if code == ErrorCode::DepthExceeded: {
        return "maximum nesting depth exceeded";
    }
    if code == ErrorCode::LoneSurrogate: {
        return "lone surrogate in \\u escape";
    }
    return "unknown error";
}

struct Diagnostic: {

    fn valid(self: &const shared) -> bool: {
        return .code == ErrorCode::None;
    }

    fn render(self: &const shared) -> string: {
        if .code == ErrorCode::None: {
            return "ok";
        }
        var out: string = "json: ";
        out.append(error_text(.code));
        out.append(" at ");
        out.append(.where.describe());
        if !.detail.empty(): {
            out.append(" [");
            out.append(.detail);
            out.append("]");
        }
        return out;
    }

    code: ErrorCode = ErrorCode::None;
    where: Position;
    detail: string;
}

fn make_error(code: ErrorCode, where: Position, detail: string) -> Diagnostic: {
    return Diagnostic(code: code, where: where, detail: detail);
}





struct Number: {

    fn is_integral(self: &const shared) -> bool: {
        return .exponent >= 0;
    }

    fn signed_mantissa(self: &const shared) -> int: {
        if .negative: {
            return -.mantissa;
        }
        return .mantissa;
    }

    fn render(self: &const shared) -> string: {
        var out: string = "";
        if .negative: {
            out.append("-");
        }
        out.append(to_string(.mantissa));
        if .exponent != 0: {
            out.append("e");
            out.append(to_string(.exponent));
        }
        return out;
    }

    negative: bool = false;
    mantissa: int = 0;
    exponent: int = 0;
    digits: int = 0;
}

fn number_from_int(value: int) -> Number: {
    if value < 0: {
        return Number(negative: true, mantissa: -value, exponent: 0);
    }
    return Number(negative: false, mantissa: value, exponent: 0);
}



struct Token: {

    fn is_value_start(self: &const shared) -> bool: {
        if .kind == TokenKind::String: { return true; }
        if .kind == TokenKind::Number: { return true; }
        if .kind == TokenKind::True: { return true; }
        if .kind == TokenKind::False: { return true; }
        if .kind == TokenKind::Null: { return true; }
        if .kind == TokenKind::ArrayBegin: { return true; }
        if .kind == TokenKind::ObjectBegin: { return true; }
        return false;
    }

    fn spelling(self: &const shared) -> string: {
        if .kind == TokenKind::End: { return "<end of input>"; }
        if .kind == TokenKind::ObjectBegin: { return "{"; }
        if .kind == TokenKind::ObjectEnd: { return "}"; }
        if .kind == TokenKind::ArrayBegin: { return "["; }
        if .kind == TokenKind::ArrayEnd: { return "]"; }
        if .kind == TokenKind::Colon: { return ":"; }
        if .kind == TokenKind::Comma: { return ","; }
        if .kind == TokenKind::True: { return "true"; }
        if .kind == TokenKind::False: { return "false"; }
        if .kind == TokenKind::Null: { return "null"; }
        if .kind == TokenKind::String: { return .text; }
        if .kind == TokenKind::Number: { return .number.render(); }
        return "<invalid>";
    }

    kind: TokenKind = TokenKind::End;
    text: string;
    number: Number;
    begin: Position;
    end: Position;
}

fn punctuation_token(c: char) -> TokenKind: {
    if c == '{': {
        return TokenKind::ObjectBegin;
    }
    if c == '}': {
        return TokenKind::ObjectEnd;
    }
    if c == '[': {
        return TokenKind::ArrayBegin;
    }
    if c == ']': {
        return TokenKind::ArrayEnd;
    }
    if c == ':': {
        return TokenKind::Colon;
    }
    if c == ',': {
        return TokenKind::Comma;
    }
    return TokenKind::Invalid;
}






struct Lexer: {

    fn at_end(self: &const shared) -> bool: {
        return .cursor.offset >= .source.size();
    }

    fn remaining(self: &const shared) -> int: {
        return .source.size() - .cursor.offset;
    }

    fn peek(self: &const shared) -> char: {
        if .at_end(): {
            return '\0';
        }
        return .source.at(.cursor.offset);
    }

    fn peek_at(self: &const shared, ahead: int) -> char: {
        let index = .cursor.offset + ahead;
        if index >= .source.size(): {
            return '\0';
        }
        return .source.at(index);
    }

    fn advance(self: &unique) -> char: {
        if .at_end(): {
            return '\0';
        }
        let c = .source.at(.cursor.offset);
        .cursor.advance_over(c);
        return c;
    }

    fn accept(self: &unique, expected: char) -> bool: {
        if .peek() == expected: {
            discard .advance();
            return true;
        }
        return false;
    }

    fn fail(self: &unique, code: ErrorCode, detail: string) -> Token: {
        .problem = make_error(code, .cursor, detail);
        return Token(kind: TokenKind::Invalid, begin: .cursor, end: .cursor);
    }

    
    
    fn skip_whitespace(self: &unique): {
        while !.at_end(): {
            let c = .peek();
            if c == ' ' || c == '\t' || c == '\n' || c == '\r': {
                discard .advance();
            } else: {
                break;
            }
        }
    }

    
    
    fn skip_trivia(self: &unique): {
        loop: {
            .skip_whitespace();
            if !.allow_comments: {
                break;
            }
            if .peek() != '/': {
                break;
            }
            let after = .peek_at(1);
            if after == '/': {
                discard .advance();
                discard .advance();
                while !.at_end() && .peek() != '\n': {
                    discard .advance();
                }
            } else: {
                if after == '*': {
                    discard .advance();
                    discard .advance();
                    while !.at_end(): {
                        if .peek() == '*' && .peek_at(1) == '/': {
                            discard .advance();
                            discard .advance();
                            break;
                        }
                        discard .advance();
                    }
                } else: {
                    break;
                }
            }
        }
    }

    
    
    fn scan_hex_quad(self: &unique, out: &unique int) -> bool: {
        var value: int = 0;
        var read: int = 0;
        while read < UNICODE_ESCAPE_DIGITS: {
            if .at_end(): {
                return false;
            }
            let c = .peek();
            if !is_hex_digit(c): {
                return false;
            }
            discard .advance();
            value = value * 16 + hex_value(c);
            read += 1;
        }
        assert read == UNICODE_ESCAPE_DIGITS;
        out = value;
        return true;
    }

    
    
    fn append_utf8(self: &const shared, out: &unique string, codepoint: int): {
        if codepoint < ASCII_LIMIT: {
            out.push_back(char(codepoint));
            return;
        }
        if codepoint < 2048: {
            out.push_back(char(192 + (codepoint >> 6)));
            out.push_back(char(128 + (codepoint & 63)));
            return;
        }
        if codepoint < 65536: {
            out.push_back(char(224 + (codepoint >> 12)));
            out.push_back(char(128 + ((codepoint >> 6) & 63)));
            out.push_back(char(128 + (codepoint & 63)));
            return;
        }
        out.push_back(char(240 + (codepoint >> 18)));
        out.push_back(char(128 + ((codepoint >> 12) & 63)));
        out.push_back(char(128 + ((codepoint >> 6) & 63)));
        out.push_back(char(128 + (codepoint & 63)));
    }

    
    fn scan_escape(self: &unique, out: &unique string) -> bool: {
        if .at_end(): {
            discard .fail(ErrorCode::UnterminatedString, "input ended after a backslash");
            return false;
        }
        let marker = .advance();
        if marker == 'u': {
            var codepoint: int = 0;
            if !.scan_hex_quad(codepoint): {
                discard .fail(ErrorCode::BadUnicodeEscape, "expected four hex digits after \\u");
                return false;
            }
            
            
            if codepoint >= SURROGATE_HIGH_BEGIN && codepoint <= SURROGATE_HIGH_END: {
                if .peek() != '\\' || .peek_at(1) != 'u': {
                    if .strict_surrogates: {
                        discard .fail(ErrorCode::LoneSurrogate, "high surrogate without a pair");
                        return false;
                    }
                    .append_utf8(out, REPLACEMENT_CODEPOINT);
                    return true;
                }
                discard .advance();
                discard .advance();
                var low: int = 0;
                if !.scan_hex_quad(low): {
                    discard .fail(ErrorCode::BadUnicodeEscape, "bad low surrogate escape");
                    return false;
                }
                if low < SURROGATE_LOW_BEGIN || low > SURROGATE_LOW_END: {
                    if .strict_surrogates: {
                        discard .fail(ErrorCode::LoneSurrogate, "second escape is not a low surrogate");
                        return false;
                    }
                    .append_utf8(out, REPLACEMENT_CODEPOINT);
                    return true;
                }
                let high_part = (codepoint - SURROGATE_HIGH_BEGIN) << 10;
                let low_part = low - SURROGATE_LOW_BEGIN;
                .append_utf8(out, SURROGATE_OFFSET + high_part + low_part);
                return true;
            }
            if codepoint >= SURROGATE_LOW_BEGIN && codepoint <= SURROGATE_LOW_END: {
                if .strict_surrogates: {
                    discard .fail(ErrorCode::LoneSurrogate, "unpaired low surrogate");
                    return false;
                }
                .append_utf8(out, REPLACEMENT_CODEPOINT);
                return true;
            }
            .append_utf8(out, codepoint);
            return true;
        }
        let decoded = decode_escape(marker);
        if decoded == '\0': {
            var detail: string = "unknown escape '\\";
            detail.push_back(marker);
            detail.append("'");
            discard .fail(ErrorCode::BadEscape, detail);
            return false;
        }
        out.push_back(decoded);
        return true;
    }

    
    
    fn scan_string(self: &unique) -> Token: {
        let begin = .cursor;
        var text: string = "";
        loop: {
            if .at_end(): {
                return .fail(ErrorCode::UnterminatedString, "reached end of input inside a string");
            }
            let c = .peek();
            if c == '"': {
                discard .advance();
                break;
            }
            if c == '\\': {
                discard .advance();
                if !.scan_escape(text): {
                    return Token(kind: TokenKind::Invalid, begin: begin, end: .cursor);
                }
                continue;
            }
            if is_control(c): {
                var detail: string = "control byte ";
                detail.append(to_string(int(c)));
                return .fail(ErrorCode::ControlCharacterInString, detail);
            }
            discard .advance();
            text.push_back(c);
        }
        return Token(kind: TokenKind::String, text: text, begin: begin, end: .cursor);
    }

    
    fn scan_number(self: &unique) -> Token: {
        let begin = .cursor;
        var result: Number;
        if .peek() == '-': {
            discard .advance();
            result.negative = true;
        }
        if .at_end(): {
            return .fail(ErrorCode::UnexpectedEnd, "input ended after '-'");
        }
        var seen: int = 0;
        if .peek() == '0': {
            discard .advance();
            seen += 1;
            if is_digit(.peek()): {
                return .fail(ErrorCode::LeadingZero, "digit follows a leading '0'");
            }
        } else: {
            if !is_digit(.peek()): {
                return .fail(ErrorCode::UnexpectedCharacter, "expected a digit");
            }
            while is_digit(.peek()): {
                let c = .advance();
                if seen < MAX_MANTISSA_DIGITS: {
                    result.mantissa = result.mantissa * 10 + digit_value(c);
                } else: {
                    
                    
                    result.exponent += 1;
                }
                seen += 1;
            }
        }
        result.digits = seen;
        
        if .peek() == '.': {
            discard .advance();
            if !is_digit(.peek()): {
                return .fail(ErrorCode::MissingFraction, "expected a digit after '.'");
            }
            while is_digit(.peek()): {
                let c = .advance();
                if seen < MAX_MANTISSA_DIGITS: {
                    result.mantissa = result.mantissa * 10 + digit_value(c);
                    result.exponent -= 1;
                    seen += 1;
                }
            }
            result.digits = seen;
        }
        if .peek() == 'e' || .peek() == 'E': {
            discard .advance();
            var exponent_negative: bool = false;
            if .peek() == '+': {
                discard .advance();
            } else: {
                if .peek() == '-': {
                    discard .advance();
                    exponent_negative = true;
                }
            }
            if !is_digit(.peek()): {
                return .fail(ErrorCode::MissingExponent, "expected a digit after the exponent marker");
            }
            var exponent: int = 0;
            while is_digit(.peek()): {
                let c = .advance();
                exponent = exponent * 10 + digit_value(c);
                if exponent > MAX_EXPONENT: {
                    return .fail(ErrorCode::NumberOverflow, "exponent is too large");
                }
            }
            if exponent_negative: {
                result.exponent -= exponent;
            } else: {
                result.exponent += exponent;
            }
        }
        if result.exponent > MAX_EXPONENT || result.exponent < MIN_EXPONENT: {
            return .fail(ErrorCode::NumberOverflow, "scaled exponent is out of range");
        }
        return Token(kind: TokenKind::Number, number: result, begin: begin, end: .cursor);
    }

    
    fn scan_keyword(self: &unique) -> Token: {
        let begin = .cursor;
        var word: string = "";
        while is_letter(.peek()): {
            word.push_back(.advance());
        }
        if word == "true": {
            return Token(kind: TokenKind::True, text: "true", begin: begin, end: .cursor);
        }
        if word == "false": {
            return Token(kind: TokenKind::False, text: "false", begin: begin, end: .cursor);
        }
        if word == "null": {
            return Token(kind: TokenKind::Null, text: "null", begin: begin, end: .cursor);
        }
        var detail: string = "expected 'true', 'false' or 'null', found '";
        detail.append(word);
        detail.append("'");
        return .fail(ErrorCode::UnexpectedCharacter, detail);
    }

    fn next_token(self: &unique) -> Token: {
        .skip_trivia();
        let begin = .cursor;
        if .at_end(): {
            return Token(kind: TokenKind::End, begin: begin, end: begin);
        }
        let c = .peek();
        if c == '"': {
            discard .advance();
            return .scan_string();
        }
        if c == '-' || is_digit(c): {
            return .scan_number();
        }
        if is_letter(c): {
            return .scan_keyword();
        }
        if is_structural(c): {
            discard .advance();
            return Token(kind: punctuation_token(c), text: .source.substr(begin.offset, 1), begin: begin, end: .cursor);
        }
        var detail: string = "stray byte ";
        detail.append(to_string(int(c)));
        discard .advance();
        return .fail(ErrorCode::UnexpectedCharacter, detail);
    }

    source: string;
    cursor: Position;
    problem: Diagnostic;
    allow_comments: bool = false;
    strict_surrogates: bool = true;
}










struct JsonValue: {

    fn is_null(self: &const shared) -> bool: {
        return .kind == JsonKind::Null;
    }

    fn is_bool(self: &const shared) -> bool: {
        return .kind == JsonKind::Bool;
    }

    fn is_number(self: &const shared) -> bool: {
        return .kind == JsonKind::Number;
    }

    fn is_string(self: &const shared) -> bool: {
        return .kind == JsonKind::String;
    }

    fn is_array(self: &const shared) -> bool: {
        return .kind == JsonKind::Array;
    }

    fn is_object(self: &const shared) -> bool: {
        return .kind == JsonKind::Object;
    }

    
    fn is_scalar(self: &const shared) -> bool: {
        if .kind == JsonKind::Array: {
            return false;
        }
        if .kind == JsonKind::Object: {
            return false;
        }
        return true;
    }

    fn kind_name(self: &const shared) -> string: {
        if .kind == JsonKind::Null: { return "null"; }
        if .kind == JsonKind::Bool: { return "bool"; }
        if .kind == JsonKind::Number: { return "number"; }
        if .kind == JsonKind::String: { return "string"; }
        if .kind == JsonKind::Array: { return "array"; }
        if .kind == JsonKind::Object: { return "object"; }
        return "<unknown>";
    }

    
    
    fn size(self: &const shared) -> int: {
        if .kind == JsonKind::Array: {
            return .items.size();
        }
        if .kind == JsonKind::Object: {
            return .keys.size();
        }
        return 0;
    }

    fn empty(self: &const shared) -> bool: {
        return .size() == 0;
    }

    

    fn at(self: &shared, index: int) -> &shared[self] JsonValue: {
        assert index >= 0;
        if .kind != JsonKind::Array: {
            return .absent;
        }
        if index >= .items.size(): {
            return .absent;
        }
        return .items[index];
    }

    fn first(self: &shared) -> &shared[self] JsonValue: {
        return .at(0);
    }

    fn last(self: &shared) -> &shared[self] JsonValue: {
        return .at(.size() - 1);
    }

    fn push_back(self: &unique, value: JsonValue): {
        .kind = JsonKind::Array;
        .items.push_back(value);
    }

    

    fn index_of(self: &const shared, name: &const shared string) -> int: {
        if .kind != JsonKind::Object: {
            return -1;
        }
        var slot: int = 0;
        while slot < .keys.size(): {
            if .keys[slot] == *name: {
                return slot;
            }
            slot += 1;
        }
        return -1;
    }

    fn has_member(self: &const shared, name: &const shared string) -> bool: {
        return .index_of(name) >= 0;
    }

    fn member(self: &shared, name: &const shared string) -> &shared[self] JsonValue: {
        let slot = .index_of(name);
        if slot < 0: {
            return .absent;
        }
        return .values[slot];
    }

    fn key_at(self: &const shared, slot: int) -> string: {
        if slot < 0 || slot >= .keys.size(): {
            return "";
        }
        return .keys[slot];
    }

    fn value_at(self: &shared, slot: int) -> &shared[self] JsonValue: {
        if slot < 0 || slot >= .values.size(): {
            return .absent;
        }
        return .values[slot];
    }

    
    fn set_member(self: &unique, name: string, value: JsonValue) -> bool: {
        .kind = JsonKind::Object;
        let slot = .index_of(name);
        if slot >= 0: {
            .values[slot] = value;
            return false;
        }
        .keys.push_back(name);
        .values.push_back(value);
        return true;
    }

    fn remove_member(self: &unique, name: &const shared string) -> bool: {
        let slot = .index_of(name);
        if slot < 0: {
            return false;
        }
        .keys.erase(slot);
        .values.erase(slot);
        return true;
    }

    

    fn as_bool(self: &const shared, fallback: bool) -> bool: {
        if .kind != JsonKind::Bool: {
            return fallback;
        }
        return .boolean;
    }

    fn as_int(self: &const shared, fallback: int) -> int: {
        if .kind != JsonKind::Number: {
            return fallback;
        }
        if .number.exponent < 0: {
            return fallback;
        }
        var scaled = .number.signed_mantissa();
        var steps = .number.exponent;
        while steps > 0: {
            scaled = scaled * 10;
            steps -= 1;
        }
        return scaled;
    }

    fn as_string(self: &const shared, fallback: &const shared string) -> string: {
        if .kind != JsonKind::String: {
            return *fallback;
        }
        return .text;
    }

    
    fn describe(self: &const shared) -> string: {
        var out: string = "<";
        out.append(.kind_name());
        if .kind == JsonKind::String: {
            out.append(" \"");
            out.append(.text);
            out.append("\"");
        }
        if .kind == JsonKind::Number: {
            out.append(" ");
            out.append(.number.render());
        }
        if .kind == JsonKind::Bool: {
            if .boolean: {
                out.append(" true");
            } else: {
                out.append(" false");
            }
        }
        if .kind == JsonKind::Array || .kind == JsonKind::Object: {
            out.append(" of ");
            out.append(to_string(.size()));
        }
        out.append(">");
        return out;
    }

    fn clear(self: &unique): {
        .kind = JsonKind::Null;
        .boolean = false;
        .text.clear();
        .items.clear();
        .keys.clear();
        .values.clear();
    }

    kind: JsonKind = JsonKind::Null;
    boolean: bool = false;
    number: Number;
    text: string;
    items: vector{JsonValue};
    keys: vector{string};
    values: vector{JsonValue};
    
    
    absent: vector{JsonValue};
}



fn make_null() -> JsonValue: {
    return JsonValue(kind: JsonKind::Null);
}

fn make_bool(value: bool) -> JsonValue: {
    return JsonValue(kind: JsonKind::Bool, boolean: value);
}

fn make_number(value: Number) -> JsonValue: {
    return JsonValue(kind: JsonKind::Number, number: value);
}

fn make_int(value: int) -> JsonValue: {
    return JsonValue(kind: JsonKind::Number, number: number_from_int(value));
}



fn make_scaled(mantissa: int, exponent: int) -> JsonValue: {
    var n = number_from_int(mantissa);
    n.exponent = exponent;
    return JsonValue(kind: JsonKind::Number, number: n);
}

fn make_string(value: string) -> JsonValue: {
    return JsonValue(kind: JsonKind::String, text: value);
}

fn make_array() -> JsonValue: {
    return JsonValue(kind: JsonKind::Array);
}

fn make_object() -> JsonValue: {
    return JsonValue(kind: JsonKind::Object);
}






enum DocumentMode: {
    SingleValue;
    Streaming;
}





struct Parser: {

    fn ok(self: &const shared) -> bool: {
        return .problem.code == ErrorCode::None;
    }

    fn diagnostic(self: &const shared) -> Diagnostic: {
        return .problem;
    }

    fn position(self: &const shared) -> Position: {
        return .current.begin;
    }

    
    
    
    fn advance(self: &unique): {
        if !.ok(): {
            .current = Token(kind: TokenKind::End, begin: .current.end, end: .current.end);
            return;
        }
        .current = .lexer.next_token();
        .tokens_read += 1;
        if .current.kind == TokenKind::Invalid: {
            .problem = .lexer.problem;
            if .problem.code == ErrorCode::None: {
                .problem = make_error(ErrorCode::UnexpectedCharacter, .current.begin, "invalid token");
            }
        }
    }

    fn check(self: &const shared, kind: TokenKind) -> bool: {
        return .current.kind == kind;
    }

    fn at_end(self: &const shared) -> bool: {
        return .current.kind == TokenKind::End;
    }

    
    fn expect(self: &unique, kind: TokenKind, code: ErrorCode, detail: string) -> bool: {
        if .current.kind != kind: {
            .raise(code, detail);
            return false;
        }
        .advance();
        return true;
    }

    
    
    fn raise(self: &unique, code: ErrorCode, detail: string): {
        if !.ok(): {
            return;
        }
        var text: string = detail;
        text.append(", found ");
        text.append(.quoted_spelling());
        .problem = make_error(code, .current.begin, text);
    }

    fn quoted_spelling(self: &const shared) -> string: {
        if .current.kind == TokenKind::End: {
            return "end of input";
        }
        var out: string = "'";
        out.append(.current.spelling());
        out.append("'");
        return out;
    }

    

    
    fn parse_value(self: &unique, depth: int) -> JsonValue: {
        if depth > .depth_limit: {
            var detail: string = "nesting is deeper than ";
            detail.append(to_string(.depth_limit));
            detail.append(" levels");
            .problem = make_error(ErrorCode::DepthExceeded, .current.begin, detail);
            return make_null();
        }
        if depth > .deepest: {
            .deepest = depth;
        }
        if .current.kind == TokenKind::ObjectBegin: {
            return .parse_object(depth);
        }
        if .current.kind == TokenKind::ArrayBegin: {
            return .parse_array(depth);
        }
        if .current.kind == TokenKind::String: {
            let text = .current.text;
            .advance();
            return make_string(text);
        }
        if .current.kind == TokenKind::Number: {
            let value = .current.number;
            .advance();
            return make_number(value);
        }
        if .current.kind == TokenKind::True: {
            .advance();
            return make_bool(true);
        }
        if .current.kind == TokenKind::False: {
            .advance();
            return make_bool(false);
        }
        if .current.kind == TokenKind::Null: {
            .advance();
            return make_null();
        }
        .raise(ErrorCode::ExpectedValue, "expected 'null', 'true', 'false', a number, a string, '[' or '{'");
        return make_null();
    }

    
    fn parse_array(self: &unique, depth: int) -> JsonValue: {
        assert .current.kind == TokenKind::ArrayBegin;
        let opened = .current.begin;
        .advance();
        var result = make_array();
        if .current.kind == TokenKind::ArrayEnd: {
            .advance();
            return result;
        }
        loop: {
            if .at_end(): {
                .problem = make_error(ErrorCode::UnexpectedEnd, opened, "array opened here was never closed with ']'");
                return result;
            }
            let element = .parse_value(depth + 1);
            if !.ok(): {
                return result;
            }
            result.items.push_back(element);
            if .current.kind == TokenKind::Comma: {
                .advance();
                
                if .current.kind == TokenKind::ArrayEnd: {
                    if !.allow_trailing_commas: {
                        .raise(ErrorCode::ExpectedValue, "trailing ',' before ']'");
                        return result;
                    }
                    .advance();
                    return result;
                }
                continue;
            }
            if .current.kind == TokenKind::ArrayEnd: {
                .advance();
                return result;
            }
            .raise(ErrorCode::ExpectedCommaOrEnd, "expected ',' or ']' after an array element");
            return result;
        }
    }

    
    
    
    
    fn parse_member(self: &unique, key: &unique string, value: &unique JsonValue, depth: int) -> bool: {
        if .current.kind != TokenKind::String: {
            .raise(ErrorCode::ExpectedKey, "expected a '\"' quoted member name");
            return false;
        }
        key = .current.text;
        .advance();
        if !.expect(TokenKind::Colon, ErrorCode::ExpectedColon, "expected ':' after the member name"): {
            return false;
        }
        value = .parse_value(depth + 1);
        return .ok();
    }

    
    fn parse_object(self: &unique, depth: int) -> JsonValue: {
        assert .current.kind == TokenKind::ObjectBegin;
        let opened = .current.begin;
        .advance();
        var result = make_object();
        if .current.kind == TokenKind::ObjectEnd: {
            .advance();
            return result;
        }
        loop: {
            if .at_end(): {
                .problem = make_error(ErrorCode::UnexpectedEnd, opened, "object opened here was never closed with '}'");
                return result;
            }
            var key: string = "";
            var value = make_null();
            if !.parse_member(key, value, depth): {
                return result;
            }
            let existing = result.index_of(key);
            if existing >= 0: {
                .duplicate_keys += 1;
                if .reject_duplicate_keys: {
                    var detail: string = "duplicate member name \"";
                    detail.append(key);
                    detail.append("\"");
                    .problem = make_error(ErrorCode::ExpectedKey, .current.begin, detail);
                    return result;
                }
                
                result.values[existing] = value;
            } else: {
                result.keys.push_back(key);
                result.values.push_back(value);
            }
            if .current.kind == TokenKind::Comma: {
                .advance();
                if .current.kind == TokenKind::ObjectEnd: {
                    if !.allow_trailing_commas: {
                        .raise(ErrorCode::ExpectedKey, "trailing ',' before '}'");
                        return result;
                    }
                    .advance();
                    return result;
                }
                continue;
            }
            if .current.kind == TokenKind::ObjectEnd: {
                .advance();
                return result;
            }
            .raise(ErrorCode::ExpectedCommaOrEnd, "expected ',' or '}' after a member");
            return result;
        }
    }

    
    
    fn parse_document(self: &unique) -> JsonValue: {
        .advance();
        if .at_end(): {
            .problem = make_error(ErrorCode::UnexpectedEnd, .current.begin, "the document is empty");
            return make_null();
        }
        var root = .parse_value(1);
        if !.ok(): {
            return root;
        }
        if .mode == DocumentMode::SingleValue: {
            if !.at_end(): {
                .raise(ErrorCode::TrailingContent, "expected end of input after the top level value");
            }
        }
        return root;
    }

    lexer: Lexer;
    current: Token;
    problem: Diagnostic;
    mode: DocumentMode = DocumentMode::SingleValue;
    depth_limit: int = MAX_DEPTH;
    deepest: int = 0;
    tokens_read: int = 0;
    duplicate_keys: int = 0;
    allow_trailing_commas: bool = false;
    reject_duplicate_keys: bool = false;
}




struct ParseResult: {

    fn ok(self: &const shared) -> bool: {
        return .problem.code == ErrorCode::None;
    }

    fn report(self: &const shared) -> string: {
        if .ok(): {
            var good: string = "parsed ";
            good.append(.root.describe());
            good.append(" from ");
            good.append(to_string(.tokens));
            good.append(" tokens");
            return good;
        }
        return .problem.render();
    }

    root: JsonValue;
    problem: Diagnostic;
    tokens: int = 0;
    depth: int = 0;
}

fn parse(source: string) -> ParseResult: {
    var parser = Parser(lexer: Lexer(source: source));
    var root = parser.parse_document();
    return ParseResult(root: root, problem: parser.problem, tokens: parser.tokens_read, depth: parser.deepest);
}



fn parse_relaxed(source: string) -> ParseResult: {
    var parser = Parser(lexer: Lexer(source: source, allow_comments: true), allow_trailing_commas: true);
    var root = parser.parse_document();
    return ParseResult(root: root, problem: parser.problem, tokens: parser.tokens_read, depth: parser.deepest);
}





enum WriteStyle: {
    Compact;
    Pretty;
}


enum EscapePolicy: {
    Minimal;
    EscapeSolidus;
    AsciiOnly;
}



fn quote_string(text: &const shared string, policy: EscapePolicy) -> string: {
    var out: string = "\"";
    var index: int = 0;
    while index < text.size(): {
        let c = text.at(index);
        let short = encode_escape(c);
        if !short.empty(): {
            out.append(short);
        } else: {
            if c == '/' && policy == EscapePolicy::EscapeSolidus: {
                out.append("\\/");
            } else: {
                var code = int(c);
                if code < 0: {
                    code += 256;
                }
                var needs_hex: bool = code < CONTROL_LIMIT;
                if code >= ASCII_LIMIT && policy == EscapePolicy::AsciiOnly: {
                    needs_hex = true;
                }
                if needs_hex: {
                    out.append("\\u");
                    out.push_back(hex_digit((code >> 12) & 15));
                    out.push_back(hex_digit((code >> 8) & 15));
                    out.push_back(hex_digit((code >> 4) & 15));
                    out.push_back(hex_digit(code & 15));
                } else: {
                    out.push_back(c);
                }
            }
        }
        index += 1;
    }
    out.append("\"");
    return out;
}



fn spell_number(value: &const shared Number) -> string: {
    var out: string = "";
    if value.negative: {
        out.append("-");
    }
    out.append(to_string(value.mantissa));
    if value.exponent > 0: {
        
        if value.exponent <= 6: {
            var pad = value.exponent;
            while pad > 0: {
                out.append("0");
                pad -= 1;
            }
            return out;
        }
        out.append("e");
        out.append(to_string(value.exponent));
        return out;
    }
    if value.exponent < 0: {
        out.append("e-");
        out.append(to_string(-value.exponent));
    }
    return out;
}

struct Writer: {

    
    fn indent(self: &const shared, level: int) -> string: {
        var out: string = "";
        if .style == WriteStyle::Compact: {
            return out;
        }
        var step: int = 0;
        while step < level: {
            out.append(.indent_unit);
            step += 1;
        }
        return out;
    }

    fn newline(self: &const shared) -> string: {
        if .style == WriteStyle::Compact: {
            return "";
        }
        return "\n";
    }

    
    fn key_separator(self: &const shared) -> string: {
        if .style == WriteStyle::Compact: {
            return ":";
        }
        return ": ";
    }

    fn write_value(self: &unique, out: &unique string, value: &const shared JsonValue, level: int): {
        if value.kind == JsonKind::Null: {
            out.append("null");
            return;
        }
        if value.kind == JsonKind::Bool: {
            if value.boolean: {
                out.append("true");
            } else: {
                out.append("false");
            }
            return;
        }
        if value.kind == JsonKind::Number: {
            out.append(spell_number(value.number));
            return;
        }
        if value.kind == JsonKind::String: {
            out.append(quote_string(value.text, .policy));
            return;
        }
        if value.kind == JsonKind::Array: {
            .write_array(out, value, level);
            return;
        }
        if value.kind == JsonKind::Object: {
            .write_object(out, value, level);
            return;
        }
        out.append("null");
    }

    fn write_array(self: &unique, out: &unique string, value: &const shared JsonValue, level: int): {
        if value.items.empty(): {
            out.append("[]");
            return;
        }
        out.append("[");
        out.append(.newline());
        var index: int = 0;
        while index < value.items.size(): {
            out.append(.indent(level + 1));
            .write_value(out, value.items[index], level + 1);
            if index + 1 < value.items.size(): {
                out.append(",");
            }
            out.append(.newline());
            index += 1;
        }
        out.append(.indent(level));
        out.append("]");
    }

    fn write_object(self: &unique, out: &unique string, value: &const shared JsonValue, level: int): {
        if value.keys.empty(): {
            out.append("{}");
            return;
        }
        out.append("{");
        out.append(.newline());
        var slot: int = 0;
        while slot < value.keys.size(): {
            out.append(.indent(level + 1));
            out.append(quote_string(value.keys[slot], .policy));
            out.append(.key_separator());
            .write_value(out, value.values[slot], level + 1);
            if slot + 1 < value.keys.size(): {
                out.append(",");
            }
            out.append(.newline());
            slot += 1;
        }
        out.append(.indent(level));
        out.append("}");
    }

    fn write_document(self: &unique, value: &const shared JsonValue) -> string: {
        var out: string = "";
        .write_value(out, value, 0);
        if .trailing_newline && .style == WriteStyle::Pretty: {
            out.append("\n");
        }
        return out;
    }

    style: WriteStyle = WriteStyle::Compact;
    policy: EscapePolicy = EscapePolicy::Minimal;
    indent_unit: string = "  ";
    trailing_newline: bool = true;
}


fn write_compact(value: &const shared JsonValue) -> string: {
    var writer = Writer(style: WriteStyle::Compact, trailing_newline: false);
    return writer.write_document(value);
}


fn write_pretty(value: &const shared JsonValue) -> string: {
    var writer = Writer(style: WriteStyle::Pretty, indent_unit: "  ");
    return writer.write_document(value);
}



fn reformat(source: string, style: WriteStyle) -> string: {
    let result = parse(source);
    if !result.ok(): {
        return "";
    }
    if style == WriteStyle::Pretty: {
        return write_pretty(result.root);
    }
    return write_compact(result.root);
}







fn normalize_number(value: &const shared Number) -> Number: {
    var out = *value;
    while out.mantissa != 0 && out.mantissa % 10 == 0: {
        out.mantissa = out.mantissa / 10;
        out.exponent += 1;
    }
    if out.mantissa == 0: {
        out.exponent = 0;
        out.negative = false;
    }
    return out;
}

fn number_equal(left: &const shared Number, right: &const shared Number) -> bool: {
    let a = normalize_number(left);
    let b = normalize_number(right);
    if a.mantissa != b.mantissa: {
        return false;
    }
    if a.exponent != b.exponent: {
        return false;
    }
    return a.negative == b.negative;
}



fn deep_equal(left: &const shared JsonValue, right: &const shared JsonValue) -> bool: {
    if left.kind != right.kind: {
        return false;
    }
    if left.kind == JsonKind::Null: {
        return true;
    }
    if left.kind == JsonKind::Bool: {
        return left.boolean == right.boolean;
    }
    if left.kind == JsonKind::Number: {
        return number_equal(left.number, right.number);
    }
    if left.kind == JsonKind::String: {
        return left.text == right.text;
    }
    if left.kind == JsonKind::Array: {
        if left.items.size() != right.items.size(): {
            return false;
        }
        var index: int = 0;
        while index < left.items.size(): {
            if !deep_equal(left.items[index], right.items[index]): {
                return false;
            }
            index += 1;
        }
        return true;
    }
    
    if left.keys.size() != right.keys.size(): {
        return false;
    }
    var slot: int = 0;
    while slot < left.keys.size(): {
        let other = right.index_of(left.keys[slot]);
        if other < 0: {
            return false;
        }
        if !deep_equal(left.values[slot], right.values[other]): {
            return false;
        }
        slot += 1;
    }
    return true;
}




fn unescape_pointer_token(token: &const shared string) -> string: {
    var out: string = "";
    var index: int = 0;
    while index < token.size(): {
        let c = token.at(index);
        if c == '~' && index + 1 < token.size(): {
            let next = token.at(index + 1);
            if next == '0': {
                out.push_back('~');
                index += 2;
                continue;
            }
            if next == '1': {
                out.push_back('/');
                index += 2;
                continue;
            }
        }
        out.push_back(c);
        index += 1;
    }
    return out;
}

fn escape_pointer_token(token: &const shared string) -> string: {
    var out: string = "";
    var index: int = 0;
    while index < token.size(): {
        let c = token.at(index);
        if c == '~': {
            out.append("~0");
        } else: {
            if c == '/': {
                out.append("~1");
            } else: {
                out.push_back(c);
            }
        }
        index += 1;
    }
    return out;
}



fn split_pointer(path: &const shared string) -> vector{string}: {
    var tokens: vector{string};
    if path.empty(): {
        return tokens;
    }
    var current: string = "";
    var index: int = 0;
    if path.at(0) == '/': {
        index = 1;
    }
    while index < path.size(): {
        let c = path.at(index);
        if c == '/': {
            tokens.push_back(unescape_pointer_token(current));
            current.clear();
        } else: {
            current.push_back(c);
        }
        index += 1;
    }
    tokens.push_back(unescape_pointer_token(current));
    return tokens;
}

fn join_pointer(tokens: &const shared vector{string}) -> string: {
    var out: string = "";
    for token: &const in tokens: {
        out.append("/");
        out.append(escape_pointer_token(token));
    }
    return out;
}

fn is_index_token(token: &const shared string) -> bool: {
    if token.empty(): {
        return false;
    }
    var index: int = 0;
    while index < token.size(): {
        if !is_digit(token.at(index)): {
            return false;
        }
        index += 1;
    }
    
    if token.size() > 1 && token.at(0) == '0': {
        return false;
    }
    return true;
}




fn resolve_tokens(node: &shared JsonValue, tokens: &const shared vector{string}, index: int) -> &shared[node] JsonValue: {
    if index >= tokens.size(): {
        return node;
    }
    let step = tokens[index];
    if node.kind == JsonKind::Object: {
        return resolve_tokens(node.member(step), tokens, index + 1);
    }
    if node.kind == JsonKind::Array: {
        if !is_index_token(step): {
            return node;
        }
        return resolve_tokens(node.at(parse_int(step)), tokens, index + 1);
    }
    return node;
}


fn at_pointer(root: &shared JsonValue, path: string) -> &shared[root] JsonValue: {
    let tokens = split_pointer(path);
    return resolve_tokens(root, tokens, 0);
}

fn tokens_exist(node: &const shared JsonValue, tokens: &const shared vector{string}, index: int) -> bool: {
    if index >= tokens.size(): {
        return true;
    }
    let step = tokens[index];
    if node.kind == JsonKind::Object: {
        let slot = node.index_of(step);
        if slot < 0: {
            return false;
        }
        return tokens_exist(node.values[slot], tokens, index + 1);
    }
    if node.kind == JsonKind::Array: {
        if !is_index_token(step): {
            return false;
        }
        let position = parse_int(step);
        if position >= node.items.size(): {
            return false;
        }
        return tokens_exist(node.items[position], tokens, index + 1);
    }
    return false;
}

fn pointer_exists(root: &const shared JsonValue, path: string) -> bool: {
    let tokens = split_pointer(path);
    return tokens_exist(root, tokens, 0);
}






fn merge_patch(target: &const shared JsonValue, patch: &const shared JsonValue) -> JsonValue: {
    if patch.kind != JsonKind::Object: {
        return *patch;
    }
    var out = make_object();
    if target.kind == JsonKind::Object: {
        var slot: int = 0;
        while slot < target.keys.size(): {
            out.keys.push_back(target.keys[slot]);
            out.values.push_back(target.values[slot]);
            slot += 1;
        }
    }
    var index: int = 0;
    while index < patch.keys.size(): {
        let key = patch.keys[index];
        let update = patch.values[index];
        if update.kind == JsonKind::Null: {
            discard out.remove_member(key);
        } else: {
            let existing = out.index_of(key);
            if existing >= 0: {
                out.values[existing] = merge_patch(out.values[existing], update);
            } else: {
                out.keys.push_back(key);
                out.values.push_back(merge_patch(make_null(), update));
            }
        }
        index += 1;
    }
    return out;
}


fn merge_sources(base: string, overlay: string) -> string: {
    let left = parse(base);
    if !left.ok(): {
        return left.problem.render();
    }
    let right = parse(overlay);
    if !right.ok(): {
        return right.problem.render();
    }
    let merged = merge_patch(left.root, right.root);
    prove merged.kind == JsonKind::Object || merged.kind == right.root.kind;
    return write_pretty(merged);
}
}



















namespace physics: {







static FIXED_SHIFT: int = 16;



static FIXED_ONE: int = 65536;


static FIXED_HALF: int = 32768;


static FIXED_QUARTER: int = 16384;


static FIXED_FRACTION_MASK: int = 65535;




static FIXED_ONE_SQUARED: int = 4294967296;



static FIXED_MAX_RAW: int = 140737488355328;
static FIXED_MIN_RAW: int = -140737488355328;





static FIXED_PI_RAW: int = 205887;
static FIXED_TAU_RAW: int = 411775;
static FIXED_HALF_PI_RAW: int = 102944;
static FIXED_QUARTER_PI_RAW: int = 51472;


static FIXED_INV_PI_RAW: int = 20861;
static FIXED_TWO_OVER_PI_RAW: int = 41722;




static LINEAR_EPSILON_RAW: int = 66;
static ANGULAR_EPSILON_RAW: int = 7;



static LINEAR_EPSILON_SQUARED_RAW: int = 1;




static SQRT_ITERATION_LIMIT: int = 6;
static RECIPROCAL_ITERATION_LIMIT: int = 5;



static var fixed_multiply_count: int = 0;
static var fixed_divide_count: int = 0;
static var fixed_sqrt_count: int = 0;
static var narrow_phase_test_count: int = 0;
static var broad_phase_pair_count: int = 0;
static var solver_iteration_count: int = 0;



static APOSTROPHE: string = "'";




enum Ordering: {
    Less;
    Equal;
    Greater = 2;
}




enum ShapeKind: {
    Circle;
    Box;
    Polygon = 2;
}


enum BodyKind: {
    
    Static;
    
    Kinematic;
    
    Dynamic = 2;
}


enum ContactState: {
    
    Separated;
    
    
    Touching;
    
    Penetrating = 2;
}


enum FeatureKind: {
    FaceA;
    FaceB;
    VertexA = 2;
    VertexB = 3;
}


enum JointStatus: {
    Satisfied;
    Corrected;
    Broken = 2;
}










struct Fixed: {

    

    
    
    fn set_raw(self: &unique, value: int): {
        .raw = value;
    }

    
    fn set_whole(self: &unique, n: int): {
        .raw = n * FIXED_ONE;
    }

    
    
    
    fn set_ratio(self: &unique, numerator: int, denominator: int): {
        if denominator == 0: {
            .raw = 0;
            return;
        }
        let scaled = numerator * FIXED_ONE;
        if (scaled < 0) != (denominator < 0): {
            .raw = (scaled - denominator / 2) / denominator;
        } else: {
            .raw = (scaled + denominator / 2) / denominator;
        }
    }

    

    fn is_zero(self: &const shared) -> bool: {
        return .raw == 0;
    }

    fn is_negative(self: &const shared) -> bool: {
        return .raw < 0;
    }

    fn is_positive(self: &const shared) -> bool: {
        return .raw > 0;
    }

    
    fn to_int(self: &const shared) -> int: {
        return .raw / FIXED_ONE;
    }

    
    
    fn floor_int(self: &const shared) -> int: {
        if .raw >= 0: {
            return .raw / FIXED_ONE;
        }
        return -((-.raw + FIXED_FRACTION_MASK) / FIXED_ONE);
    }

    fn ceil_int(self: &const shared) -> int: {
        return -((-.raw) / FIXED_ONE);
    }

    
    fn round_int(self: &const shared) -> int: {
        if .raw >= 0: {
            return (.raw + FIXED_HALF) / FIXED_ONE;
        }
        return -((-.raw + FIXED_HALF) / FIXED_ONE);
    }

    
    fn fraction(self: &const shared) -> Fixed: {
        var result: Fixed;
        result.raw = .raw - .floor_int() * FIXED_ONE;
        return result;
    }

    fn magnitude(self: &const shared) -> Fixed: {
        var result: Fixed;
        if .raw < 0: {
            result.raw = -.raw;
        } else: {
            result.raw = .raw;
        }
        return result;
    }

    fn negated(self: &const shared) -> Fixed: {
        var result: Fixed;
        result.raw = -.raw;
        return result;
    }

    
    fn sign_unit(self: &const shared) -> Fixed: {
        var result: Fixed;
        if .raw > 0: {
            result.raw = FIXED_ONE;
        } else: {
            if .raw < 0: {
                result.raw = -FIXED_ONE;
            } else: {
                result.raw = 0;
            }
        }
        return result;
    }

    fn compare(self: &const shared, other: &const shared Fixed) -> Ordering: {
        if .raw < other.raw: {
            return Ordering::Less;
        }
        if .raw > other.raw: {
            return Ordering::Greater;
        }
        return Ordering::Equal;
    }

    

    fn added(self: &const shared, other: &const shared Fixed) -> Fixed: {
        var result: Fixed;
        result.raw = .raw + other.raw;
        return result;
    }

    fn subtracted(self: &const shared, other: &const shared Fixed) -> Fixed: {
        var result: Fixed;
        result.raw = .raw - other.raw;
        return result;
    }

    
    
    
    
    fn multiplied(self: &const shared, other: &const shared Fixed) -> Fixed: {
        fixed_multiply_count += 1;
        var result: Fixed;
        let product = .raw * other.raw;
        if product < 0: {
            result.raw = -((-product + FIXED_HALF) >> FIXED_SHIFT);
        } else: {
            result.raw = (product + FIXED_HALF) >> FIXED_SHIFT;
        }
        return result;
    }

    
    
    fn divided(self: &const shared, other: &const shared Fixed) -> Fixed: {
        fixed_divide_count += 1;
        var result: Fixed;
        if other.raw == 0: {
            if .raw >= 0: {
                result.raw = FIXED_MAX_RAW;
            } else: {
                result.raw = FIXED_MIN_RAW;
            }
            return result;
        }
        let numerator = .raw << FIXED_SHIFT;
        if (numerator < 0) != (other.raw < 0): {
            result.raw = (numerator - other.raw / 2) / other.raw;
        } else: {
            result.raw = (numerator + other.raw / 2) / other.raw;
        }
        return result;
    }

    
    fn scaled_by_int(self: &const shared, n: int) -> Fixed: {
        var result: Fixed;
        result.raw = .raw * n;
        return result;
    }

    fn divided_by_int(self: &const shared, n: int) -> Fixed: {
        var result: Fixed;
        if n == 0: {
            result.raw = 0;
            return result;
        }
        result.raw = .raw / n;
        return result;
    }

    
    
    fn squared(self: &const shared) -> Fixed: {
        return .multiplied(self);
    }

    

    
    
    
    fn square_root(self: &const shared) -> Fixed: {
        fixed_sqrt_count += 1;
        var result: Fixed;
        if .raw <= 0: {
            result.raw = 0;
            return result;
        }
        let target = .raw * FIXED_ONE;
        var guess = .raw;
        if guess < FIXED_ONE: {
            guess = FIXED_ONE;
        }
        var step: int = 0;
        while step < SQRT_ITERATION_LIMIT: {
            let next = (guess + target / guess) / 2;
            if next == guess: {
                step = SQRT_ITERATION_LIMIT;
            } else: {
                guess = next;
                step += 1;
            }
        }
        
        
        while guess > 1 && guess * guess > target: {
            guess -= 1;
        }
        result.raw = guess;
        return result;
    }

    
    
    
    
    
    fn reciprocal(self: &const shared) -> Fixed: {
        var one: Fixed;
        one.raw = FIXED_ONE;
        if .raw == 0: {
            var saturated: Fixed;
            saturated.raw = FIXED_MAX_RAW;
            return saturated;
        }
        var guess = one.divided(self);
        var two: Fixed;
        two.raw = FIXED_ONE * 2;
        var step: int = 0;
        while step < RECIPROCAL_ITERATION_LIMIT: {
            let correction = two.subtracted(.multiplied(guess));
            guess = guess.multiplied(correction);
            step += 1;
        }
        return guess;
    }

    

    fn clamped(self: &const shared, low: &const shared Fixed, high: &const shared Fixed) -> Fixed: {
        var result: Fixed;
        if .raw < low.raw: {
            result.raw = low.raw;
            return result;
        }
        if .raw > high.raw: {
            result.raw = high.raw;
            return result;
        }
        result.raw = .raw;
        return result;
    }

    
    
    
    fn blended(self: &const shared, other: &const shared Fixed, t: &const shared Fixed) -> Fixed: {
        let delta = other.subtracted(self);
        return .added(delta.multiplied(t));
    }

    
    
    fn stepped_towards(self: &const shared, target: &const shared Fixed, limit: &const shared Fixed) -> Fixed: {
        let delta = target.subtracted(self);
        if delta.magnitude().raw <= limit.raw: {
            return target.added(zero_fixed());
        }
        return .added(delta.sign_unit().multiplied(limit));
    }

    
    raw: int = 0;
}







fn raw_fixed(value: int) -> Fixed: {
    var result: Fixed;
    result.raw = value;
    return result;
}

fn whole(n: int) -> Fixed: {
    var result: Fixed;
    result.raw = n * FIXED_ONE;
    return result;
}

fn ratio(numerator: int, denominator: int) -> Fixed: {
    var result: Fixed;
    result.set_ratio(numerator, denominator);
    return result;
}

fn zero_fixed() -> Fixed: {
    return raw_fixed(0);
}

fn one_fixed() -> Fixed: {
    return raw_fixed(FIXED_ONE);
}

fn half_fixed() -> Fixed: {
    return raw_fixed(FIXED_HALF);
}

fn pi_fixed() -> Fixed: {
    return raw_fixed(FIXED_PI_RAW);
}

fn tau_fixed() -> Fixed: {
    return raw_fixed(FIXED_TAU_RAW);
}

fn epsilon_fixed() -> Fixed: {
    return raw_fixed(LINEAR_EPSILON_RAW);
}








fn impl (a + b)(l: &const shared Fixed, r: &const shared Fixed) -> Fixed: {
    return l.added(r);
}

fn impl (a - b)(l: &const shared Fixed, r: &const shared Fixed) -> Fixed: {
    return l.subtracted(r);
}

fn impl (a * b)(l: &const shared Fixed, r: &const shared Fixed) -> Fixed: {
    return l.multiplied(r);
}

fn impl (a / b)(l: &const shared Fixed, r: &const shared Fixed) -> Fixed: {
    return l.divided(r);
}



fn impl (a % b)(l: &const shared Fixed, r: &const shared Fixed) -> Fixed: {
    if r.raw == 0: {
        return zero_fixed();
    }
    return raw_fixed(l.raw % r.raw);
}

fn impl (a < b)(l: &const shared Fixed, r: &const shared Fixed) -> bool: {
    return l.raw < r.raw;
}

fn impl (a <= b)(l: &const shared Fixed, r: &const shared Fixed) -> bool: {
    return l.raw <= r.raw;
}

fn impl (a > b)(l: &const shared Fixed, r: &const shared Fixed) -> bool: {
    return l.raw > r.raw;
}

fn impl (a >= b)(l: &const shared Fixed, r: &const shared Fixed) -> bool: {
    return l.raw >= r.raw;
}

fn impl (a == b)(l: &const shared Fixed, r: &const shared Fixed) -> bool: {
    return l.raw == r.raw;
}

fn impl (a != b)(l: &const shared Fixed, r: &const shared Fixed) -> bool: {
    return l.raw != r.raw;
}


fn impl (-a)(l: &const shared Fixed) -> Fixed: {
    return raw_fixed(-l.raw);
}



fn impl (a * b)(l: &const shared Fixed, r: int) -> Fixed: {
    return raw_fixed(l.raw * r);
}

fn impl (a / b)(l: &const shared Fixed, r: int) -> Fixed: {
    return l.divided_by_int(r);
}



fn fixed_min(a: &const shared Fixed, b: &const shared Fixed) -> Fixed: {
    if a.raw < b.raw: {
        return raw_fixed(a.raw);
    }
    return raw_fixed(b.raw);
}

fn fixed_max(a: &const shared Fixed, b: &const shared Fixed) -> Fixed: {
    if a.raw > b.raw: {
        return raw_fixed(a.raw);
    }
    return raw_fixed(b.raw);
}

fn fixed_abs(a: &const shared Fixed) -> Fixed: {
    return a.magnitude();
}

fn fixed_clamp(value: &const shared Fixed, low: &const shared Fixed, high: &const shared Fixed) -> Fixed: {
    return value.clamped(low, high);
}

fn fixed_sqrt(a: &const shared Fixed) -> Fixed: {
    return a.square_root();
}



fn fixed_near(a: &const shared Fixed, b: &const shared Fixed, tolerance: &const shared Fixed) -> bool: {
    return (a - b).magnitude() <= tolerance;
}

fn fixed_near_zero(a: &const shared Fixed) -> bool: {
    return a.magnitude().raw <= LINEAR_EPSILON_RAW;
}






fn normalise_angle(angle: &const shared Fixed) -> Fixed: {
    var result = raw_fixed(angle.raw);
    var guard: int = 0;
    while result.raw > FIXED_PI_RAW && guard < 64: {
        result.raw -= FIXED_TAU_RAW;
        guard += 1;
    }
    while result.raw <= -FIXED_PI_RAW && guard < 64: {
        result.raw += FIXED_TAU_RAW;
        guard += 1;
    }
    return result;
}


fn angle_delta(a: &const shared Fixed, b: &const shared Fixed) -> Fixed: {
    return normalise_angle(b - a);
}










fn fixed_sin(angle: &const shared Fixed) -> Fixed: {
    let folded = normalise_angle(angle);
    var x = raw_fixed(folded.raw);
    var negate: bool = false;
    if x.raw < 0: {
        x.raw = -x.raw;
        negate = true;
    }
    let pi = pi_fixed();
    let gap = pi - x;
    let product = x * gap;
    let numerator = product * 16;
    let denominator = pi * pi * 5 - product * 4;
    var result = numerator / denominator;
    if negate: {
        result = -result;
    }
    return result;
}

fn fixed_cos(angle: &const shared Fixed) -> Fixed: {
    return fixed_sin(angle + raw_fixed(FIXED_HALF_PI_RAW));
}

fn fixed_tan(angle: &const shared Fixed) -> Fixed: {
    let c = fixed_cos(angle);
    if c.magnitude().raw < LINEAR_EPSILON_RAW: {
        if fixed_sin(angle).raw >= 0: {
            return raw_fixed(FIXED_MAX_RAW);
        }
        return raw_fixed(FIXED_MIN_RAW);
    }
    return fixed_sin(angle) / c;
}








fn atan_unit(x: &const shared Fixed) -> Fixed: {
    let magnitude = x.magnitude();
    let c1 = raw_fixed(16035);
    let c2 = raw_fixed(4345);
    let quarter_pi = raw_fixed(FIXED_QUARTER_PI_RAW);
    return x * quarter_pi - x * (magnitude - one_fixed()) * (c1 + c2 * magnitude);
}



fn fixed_atan2(y: &const shared Fixed, x: &const shared Fixed) -> Fixed: {
    if x.raw == 0 && y.raw == 0: {
        return zero_fixed();
    }
    let ax = x.magnitude();
    let ay = y.magnitude();
    if ax >= ay: {
        let base = atan_unit(y / x);
        if x.raw >= 0: {
            return base;
        }
        if y.raw >= 0: {
            return base + pi_fixed();
        }
        return base - pi_fixed();
    }
    let base = raw_fixed(FIXED_HALF_PI_RAW) - atan_unit(x / y);
    if y.raw >= 0: {
        return base;
    }
    return base - pi_fixed();
}



fn fixed_asin(x: &const shared Fixed) -> Fixed: {
    let clamped = x.clamped(-one_fixed(), one_fixed());
    let complement = (one_fixed() - clamped * clamped).square_root();
    return fixed_atan2(clamped, complement);
}

fn fixed_acos(x: &const shared Fixed) -> Fixed: {
    return raw_fixed(FIXED_HALF_PI_RAW) - fixed_asin(x);
}










struct Vec2: {

    fn set(self: &unique, nx: &const shared Fixed, ny: &const shared Fixed): {
        .x = nx + zero_fixed();
        .y = ny + zero_fixed();
    }

    fn set_zero(self: &unique): {
        .x = zero_fixed();
        .y = zero_fixed();
    }

    fn is_zero(self: &const shared) -> bool: {
        return .x.raw == 0 && .y.raw == 0;
    }

    
    
    fn dot(self: &const shared, other: &const shared Vec2) -> Fixed: {
        return .x * other.x + .y * other.y;
    }

    
    fn cross(self: &const shared, other: &const shared Vec2) -> Fixed: {
        return .x * other.y - .y * other.x;
    }

    
    
    fn cross_scalar(self: &const shared, s: &const shared Fixed) -> Vec2: {
        return make_vec2(.y * s, -.x * s);
    }

    fn length_squared(self: &const shared) -> Fixed: {
        return .x * .x + .y * .y;
    }

    fn length(self: &const shared) -> Fixed: {
        return (.x * .x + .y * .y).square_root();
    }

    
    
    fn manhattan_length(self: &const shared) -> Fixed: {
        return .x.magnitude() + .y.magnitude();
    }

    fn chebyshev_length(self: &const shared) -> Fixed: {
        return fixed_max(.x.magnitude(), .y.magnitude());
    }

    
    
    fn normalised(self: &const shared) -> Vec2: {
        let len = .length();
        if len.raw <= LINEAR_EPSILON_RAW: {
            return make_vec2(zero_fixed(), zero_fixed());
        }
        let inverse = len.reciprocal();
        return make_vec2(.x * inverse, .y * inverse);
    }

    
    
    
    fn normalise_in_place(self: &unique) -> Fixed: {
        let len = .length();
        if len.raw <= LINEAR_EPSILON_RAW: {
            .x = zero_fixed();
            .y = zero_fixed();
            return zero_fixed();
        }
        let inverse = len.reciprocal();
        .x = .x * inverse;
        .y = .y * inverse;
        return len;
    }

    
    fn perpendicular(self: &const shared) -> Vec2: {
        return make_vec2(-.y, .x);
    }

    
    fn perpendicular_cw(self: &const shared) -> Vec2: {
        return make_vec2(.y, -.x);
    }

    
    
    
    fn rotated_by(self: &const shared, cosine: &const shared Fixed, sine: &const shared Fixed) -> Vec2: {
        return make_vec2(.x * cosine - .y * sine, .x * sine + .y * cosine);
    }

    fn rotated(self: &const shared, angle: &const shared Fixed) -> Vec2: {
        return .rotated_by(fixed_cos(angle), fixed_sin(angle));
    }

    fn angle(self: &const shared) -> Fixed: {
        return fixed_atan2(.y, .x);
    }

    
    fn componentwise_min(self: &const shared, other: &const shared Vec2) -> Vec2: {
        return make_vec2(fixed_min(.x, other.x), fixed_min(.y, other.y));
    }

    fn componentwise_max(self: &const shared, other: &const shared Vec2) -> Vec2: {
        return make_vec2(fixed_max(.x, other.x), fixed_max(.y, other.y));
    }

    fn componentwise_multiply(self: &const shared, other: &const shared Vec2) -> Vec2: {
        return make_vec2(.x * other.x, .y * other.y);
    }

    fn absolute(self: &const shared) -> Vec2: {
        return make_vec2(.x.magnitude(), .y.magnitude());
    }

    fn negated(self: &const shared) -> Vec2: {
        return make_vec2(-.x, -.y);
    }

    
    fn distance_to(self: &const shared, other: &const shared Vec2) -> Fixed: {
        let dx = other.x - .x;
        let dy = other.y - .y;
        return (dx * dx + dy * dy).square_root();
    }

    fn distance_squared_to(self: &const shared, other: &const shared Vec2) -> Fixed: {
        let dx = other.x - .x;
        let dy = other.y - .y;
        return dx * dx + dy * dy;
    }

    
    fn blended(self: &const shared, other: &const shared Vec2, t: &const shared Fixed) -> Vec2: {
        return make_vec2(.x + (other.x - .x) * t, .y + (other.y - .y) * t);
    }

    
    fn reflected(self: &const shared, normal: &const shared Vec2) -> Vec2: {
        let scale = .dot(normal) * 2;
        return make_vec2(.x - normal.x * scale, .y - normal.y * scale);
    }

    
    fn projected_onto(self: &const shared, direction: &const shared Vec2) -> Vec2: {
        let amount = .dot(direction);
        return make_vec2(direction.x * amount, direction.y * amount);
    }

    
    fn rejected_from(self: &const shared, direction: &const shared Vec2) -> Vec2: {
        let along = .projected_onto(direction);
        return make_vec2(.x - along.x, .y - along.y);
    }

    
    
    fn clamped_length(self: &const shared, limit: &const shared Fixed) -> Vec2: {
        let squared = .length_squared();
        if squared <= limit * limit: {
            return make_vec2(.x, .y);
        }
        let unit = .normalised();
        return make_vec2(unit.x * limit, unit.y * limit);
    }

    fn scaled(self: &const shared, factor: &const shared Fixed) -> Vec2: {
        return make_vec2(.x * factor, .y * factor);
    }

    x: Fixed;
    y: Fixed;
}

fn make_vec2(x: &const shared Fixed, y: &const shared Fixed) -> Vec2: {
    var result: Vec2;
    result.x = x + zero_fixed();
    result.y = y + zero_fixed();
    return result;
}

fn vec2_from_ints(x: int, y: int) -> Vec2: {
    return make_vec2(whole(x), whole(y));
}

fn vec2_zero() -> Vec2: {
    return make_vec2(zero_fixed(), zero_fixed());
}

fn vec2_unit_x() -> Vec2: {
    return make_vec2(one_fixed(), zero_fixed());
}

fn vec2_unit_y() -> Vec2: {
    return make_vec2(zero_fixed(), one_fixed());
}


fn vec2_from_angle(angle: &const shared Fixed) -> Vec2: {
    return make_vec2(fixed_cos(angle), fixed_sin(angle));
}



fn impl (a + b)(l: &const shared Vec2, r: &const shared Vec2) -> Vec2: {
    return make_vec2(l.x + r.x, l.y + r.y);
}

fn impl (a - b)(l: &const shared Vec2, r: &const shared Vec2) -> Vec2: {
    return make_vec2(l.x - r.x, l.y - r.y);
}



fn impl (a * b)(l: &const shared Vec2, r: &const shared Fixed) -> Vec2: {
    return make_vec2(l.x * r, l.y * r);
}

fn impl (a * b)(l: &const shared Fixed, r: &const shared Vec2) -> Vec2: {
    return make_vec2(r.x * l, r.y * l);
}



fn impl (a * b)(l: &const shared Vec2, r: int) -> Vec2: {
    return make_vec2(l.x * r, l.y * r);
}

fn impl (a / b)(l: &const shared Vec2, r: &const shared Fixed) -> Vec2: {
    return make_vec2(l.x / r, l.y / r);
}

fn impl (a / b)(l: &const shared Vec2, r: int) -> Vec2: {
    return make_vec2(l.x / r, l.y / r);
}




fn impl (a % b)(l: &const shared Vec2, r: &const shared Vec2) -> Vec2: {
    return make_vec2(l.x * r.x, l.y * r.y);
}

fn impl (a == b)(l: &const shared Vec2, r: &const shared Vec2) -> bool: {
    return l.x.raw == r.x.raw && l.y.raw == r.y.raw;
}

fn impl (a != b)(l: &const shared Vec2, r: &const shared Vec2) -> bool: {
    return l.x.raw != r.x.raw || l.y.raw != r.y.raw;
}



fn impl (a < b)(l: &const shared Vec2, r: &const shared Vec2) -> bool: {
    return l.length_squared() < r.length_squared();
}

fn impl (a <= b)(l: &const shared Vec2, r: &const shared Vec2) -> bool: {
    return l.length_squared() <= r.length_squared();
}

fn impl (a > b)(l: &const shared Vec2, r: &const shared Vec2) -> bool: {
    return l.length_squared() > r.length_squared();
}

fn impl (a >= b)(l: &const shared Vec2, r: &const shared Vec2) -> bool: {
    return l.length_squared() >= r.length_squared();
}

fn impl (-a)(l: &const shared Vec2) -> Vec2: {
    return make_vec2(-l.x, -l.y);
}



fn dot(a: &const shared Vec2, b: &const shared Vec2) -> Fixed: {
    return a.x * b.x + a.y * b.y;
}

fn cross(a: &const shared Vec2, b: &const shared Vec2) -> Fixed: {
    return a.x * b.y - a.y * b.x;
}


fn cross_scalar_vec(s: &const shared Fixed, v: &const shared Vec2) -> Vec2: {
    return make_vec2(-s * v.y, s * v.x);
}


fn cross_vec_scalar(v: &const shared Vec2, s: &const shared Fixed) -> Vec2: {
    return make_vec2(s * v.y, -s * v.x);
}

fn vec2_lerp(a: &const shared Vec2, b: &const shared Vec2, t: &const shared Fixed) -> Vec2: {
    return a + (b - a) * t;
}



fn closest_point_on_segment(a: &const shared Vec2, b: &const shared Vec2, p: &const shared Vec2) -> Vec2: {
    let edge = b - a;
    let length_squared = edge.length_squared();
    if length_squared.raw <= LINEAR_EPSILON_RAW: {
        return make_vec2(a.x, a.y);
    }
    let t = ((p - a).dot(edge) / length_squared).clamped(zero_fixed(), one_fixed());
    return a + edge * t;
}

fn segment_parameter(a: &const shared Vec2, b: &const shared Vec2, p: &const shared Vec2) -> Fixed: {
    let edge = b - a;
    let length_squared = edge.length_squared();
    if length_squared.raw <= LINEAR_EPSILON_RAW: {
        return zero_fixed();
    }
    return ((p - a).dot(edge) / length_squared).clamped(zero_fixed(), one_fixed());
}



fn triangle_area_twice(a: &const shared Vec2, b: &const shared Vec2, c: &const shared Vec2) -> Fixed: {
    return (b.x - a.x) * (c.y - a.y) - (b.y - a.y) * (c.x - a.x);
}










struct Mat2: {

    fn set_identity(self: &unique): {
        .col_x = make_vec2(one_fixed(), zero_fixed());
        .col_y = make_vec2(zero_fixed(), one_fixed());
    }

    fn set_rotation(self: &unique, angle: &const shared Fixed): {
        let c = fixed_cos(angle);
        let s = fixed_sin(angle);
        .col_x = make_vec2(c, s);
        .col_y = make_vec2(-s, c);
    }

    fn set_scale(self: &unique, sx: &const shared Fixed, sy: &const shared Fixed): {
        .col_x = make_vec2(sx, zero_fixed());
        .col_y = make_vec2(zero_fixed(), sy);
    }

    

    fn element(self: &const shared, row: int, column: int) -> Fixed: {
        if column == 0: {
            if row == 0: {
                return .col_x.x + zero_fixed();
            }
            return .col_x.y + zero_fixed();
        }
        if row == 0: {
            return .col_y.x + zero_fixed();
        }
        return .col_y.y + zero_fixed();
    }

    fn row_x(self: &const shared) -> Vec2: {
        return make_vec2(.col_x.x, .col_y.x);
    }

    fn row_y(self: &const shared) -> Vec2: {
        return make_vec2(.col_x.y, .col_y.y);
    }

    

    
    fn transform(self: &const shared, v: &const shared Vec2) -> Vec2: {
        return make_vec2(.col_x.x * v.x + .col_y.x * v.y, .col_x.y * v.x + .col_y.y * v.y);
    }

    
    
    fn transform_transposed(self: &const shared, v: &const shared Vec2) -> Vec2: {
        return make_vec2(.col_x.x * v.x + .col_x.y * v.y, .col_y.x * v.x + .col_y.y * v.y);
    }

    fn multiplied(self: &const shared, other: &const shared Mat2) -> Mat2: {
        return make_mat2(.transform(other.col_x), .transform(other.col_y));
    }

    fn transposed(self: &const shared) -> Mat2: {
        return make_mat2(make_vec2(.col_x.x, .col_y.x), make_vec2(.col_x.y, .col_y.y));
    }

    

    fn determinant(self: &const shared) -> Fixed: {
        return .col_x.x * .col_y.y - .col_y.x * .col_x.y;
    }

    fn trace(self: &const shared) -> Fixed: {
        return .col_x.x + .col_y.y;
    }

    
    
    
    fn inverted(self: &const shared) -> Mat2: {
        let d = .determinant();
        if d.magnitude().raw <= LINEAR_EPSILON_RAW: {
            return make_mat2(vec2_zero(), vec2_zero());
        }
        let inverse = d.reciprocal();
        return make_mat2(make_vec2(.col_y.y * inverse, -.col_x.y * inverse),
                         make_vec2(-.col_y.x * inverse, .col_x.x * inverse));
    }

    
    
    
    fn solve(self: &const shared, b: &const shared Vec2) -> Vec2: {
        let d = .col_x.x * .col_y.y - .col_y.x * .col_x.y;
        if d.magnitude().raw <= LINEAR_EPSILON_RAW: {
            return vec2_zero();
        }
        let inverse = d.reciprocal();
        return make_vec2((.col_y.y * b.x - .col_y.x * b.y) * inverse,
                         (.col_x.x * b.y - .col_x.y * b.x) * inverse);
    }

    
    fn angle(self: &const shared) -> Fixed: {
        return fixed_atan2(.col_x.y, .col_x.x);
    }

    
    
    
    fn orthonormalised(self: &const shared) -> Mat2: {
        let first = .col_x.normalised();
        return make_mat2(first, first.perpendicular());
    }

    fn is_identity(self: &const shared) -> bool: {
        return .col_x.x.raw == FIXED_ONE && .col_x.y.raw == 0
            && .col_y.x.raw == 0 && .col_y.y.raw == FIXED_ONE;
    }

    fn negated(self: &const shared) -> Mat2: {
        return make_mat2(-.col_x, -.col_y);
    }

    fn scaled(self: &const shared, factor: &const shared Fixed) -> Mat2: {
        return make_mat2(.col_x * factor, .col_y * factor);
    }

    col_x: Vec2;
    col_y: Vec2;
}

fn make_mat2(col_x: &const shared Vec2, col_y: &const shared Vec2) -> Mat2: {
    var result: Mat2;
    result.col_x = col_x + vec2_zero();
    result.col_y = col_y + vec2_zero();
    return result;
}

fn mat2_identity() -> Mat2: {
    return make_mat2(vec2_unit_x(), vec2_unit_y());
}

fn mat2_zero() -> Mat2: {
    return make_mat2(vec2_zero(), vec2_zero());
}

fn mat2_rotation(angle: &const shared Fixed) -> Mat2: {
    let c = fixed_cos(angle);
    let s = fixed_sin(angle);
    return make_mat2(make_vec2(c, s), make_vec2(-s, c));
}



fn mat2_outer(a: &const shared Vec2, b: &const shared Vec2) -> Mat2: {
    return make_mat2(make_vec2(a.x * b.x, a.y * b.x), make_vec2(a.x * b.y, a.y * b.y));
}



fn impl (a + b)(l: &const shared Mat2, r: &const shared Mat2) -> Mat2: {
    return make_mat2(l.col_x + r.col_x, l.col_y + r.col_y);
}

fn impl (a - b)(l: &const shared Mat2, r: &const shared Mat2) -> Mat2: {
    return make_mat2(l.col_x - r.col_x, l.col_y - r.col_y);
}



fn impl (a * b)(l: &const shared Mat2, r: &const shared Mat2) -> Mat2: {
    return make_mat2(l.transform(r.col_x), l.transform(r.col_y));
}


fn impl (a * b)(l: &const shared Mat2, r: &const shared Vec2) -> Vec2: {
    return make_vec2(l.col_x.x * r.x + l.col_y.x * r.y, l.col_x.y * r.x + l.col_y.y * r.y);
}


fn impl (a * b)(l: &const shared Vec2, r: &const shared Mat2) -> Vec2: {
    return make_vec2(r.col_x.x * l.x + r.col_x.y * l.y, r.col_y.x * l.x + r.col_y.y * l.y);
}

fn impl (a * b)(l: &const shared Mat2, r: &const shared Fixed) -> Mat2: {
    return make_mat2(l.col_x * r, l.col_y * r);
}

fn impl (a * b)(l: &const shared Fixed, r: &const shared Mat2) -> Mat2: {
    return make_mat2(r.col_x * l, r.col_y * l);
}

fn impl (a / b)(l: &const shared Mat2, r: &const shared Fixed) -> Mat2: {
    return make_mat2(l.col_x / r, l.col_y / r);
}

fn impl (a == b)(l: &const shared Mat2, r: &const shared Mat2) -> bool: {
    return l.col_x == r.col_x && l.col_y == r.col_y;
}

fn impl (a != b)(l: &const shared Mat2, r: &const shared Mat2) -> bool: {
    return l.col_x != r.col_x || l.col_y != r.col_y;
}



fn impl (a < b)(l: &const shared Mat2, r: &const shared Mat2) -> bool: {
    return l.determinant() < r.determinant();
}

fn impl (a > b)(l: &const shared Mat2, r: &const shared Mat2) -> bool: {
    return l.determinant() > r.determinant();
}

fn impl (-a)(l: &const shared Mat2) -> Mat2: {
    return make_mat2(-l.col_x, -l.col_y);
}






struct Transform: {

    fn set_identity(self: &unique): {
        .position = vec2_zero();
        .angle = zero_fixed();
        .rotation = mat2_identity();
    }

    
    
    fn refresh(self: &unique): {
        .angle = normalise_angle(.angle);
        .rotation = mat2_rotation(.angle);
    }

    fn set_angle(self: &unique, value: &const shared Fixed): {
        .angle = normalise_angle(value);
        .rotation = mat2_rotation(.angle);
    }

    
    fn apply(self: &const shared, local: &const shared Vec2) -> Vec2: {
        return .position + .rotation * local;
    }

    
    fn unapply(self: &const shared, world: &const shared Vec2) -> Vec2: {
        return .rotation.transform_transposed(world - .position);
    }

    
    fn apply_direction(self: &const shared, local: &const shared Vec2) -> Vec2: {
        return .rotation * local;
    }

    fn unapply_direction(self: &const shared, world: &const shared Vec2) -> Vec2: {
        return .rotation.transform_transposed(world);
    }

    
    fn inverted(self: &const shared) -> Transform: {
        var result: Transform;
        result.angle = -.angle;
        result.rotation = .rotation.transposed();
        result.position = result.rotation * (-.position);
        return result;
    }

    
    
    fn composed(self: &const shared, other: &const shared Transform) -> Transform: {
        var result: Transform;
        result.angle = normalise_angle(.angle + other.angle);
        result.rotation = .rotation * other.rotation;
        result.position = .position + .rotation * other.position;
        return result;
    }

    position: Vec2;
    angle: Fixed;
    rotation: Mat2;
}

fn make_transform(position: &const shared Vec2, angle: &const shared Fixed) -> Transform: {
    var result: Transform;
    result.position = position + vec2_zero();
    result.angle = normalise_angle(angle);
    result.rotation = mat2_rotation(result.angle);
    return result;
}

fn transform_identity() -> Transform: {
    return make_transform(vec2_zero(), zero_fixed());
}


fn impl (a * b)(l: &const shared Transform, r: &const shared Transform) -> Transform: {
    return l.composed(r);
}


fn impl (a * b)(l: &const shared Transform, r: &const shared Vec2) -> Vec2: {
    return l.position + l.rotation * r;
}

fn impl (a == b)(l: &const shared Transform, r: &const shared Transform) -> bool: {
    return l.position == r.position && l.angle == r.angle;
}






struct AABB: {

    fn set_empty(self: &unique): {
        .lower = make_vec2(raw_fixed(FIXED_MAX_RAW), raw_fixed(FIXED_MAX_RAW));
        .upper = make_vec2(raw_fixed(FIXED_MIN_RAW), raw_fixed(FIXED_MIN_RAW));
    }

    fn is_empty(self: &const shared) -> bool: {
        return .lower.x > .upper.x || .lower.y > .upper.y;
    }

    fn width(self: &const shared) -> Fixed: {
        return .upper.x - .lower.x;
    }

    fn height(self: &const shared) -> Fixed: {
        return .upper.y - .lower.y;
    }

    fn extents(self: &const shared) -> Vec2: {
        return .upper - .lower;
    }

    fn half_extents(self: &const shared) -> Vec2: {
        return (.upper - .lower) / 2;
    }

    fn centre(self: &const shared) -> Vec2: {
        return (.lower + .upper) / 2;
    }

    fn area(self: &const shared) -> Fixed: {
        return (.upper.x - .lower.x) * (.upper.y - .lower.y);
    }

    fn perimeter(self: &const shared) -> Fixed: {
        return ((.upper.x - .lower.x) + (.upper.y - .lower.y)) * 2;
    }

    
    fn include_point(self: &unique, p: &const shared Vec2): {
        .lower = .lower.componentwise_min(p);
        .upper = .upper.componentwise_max(p);
    }

    fn include_box(self: &unique, other: &const shared AABB): {
        .lower = .lower.componentwise_min(other.lower);
        .upper = .upper.componentwise_max(other.upper);
    }

    
    
    
    fn expanded(self: &const shared, margin: &const shared Fixed) -> AABB: {
        return make_aabb(make_vec2(.lower.x - margin, .lower.y - margin),
                         make_vec2(.upper.x + margin, .upper.y + margin));
    }

    fn contains_point(self: &const shared, p: &const shared Vec2) -> bool: {
        return p.x >= .lower.x && p.x <= .upper.x && p.y >= .lower.y && p.y <= .upper.y;
    }

    fn contains_box(self: &const shared, other: &const shared AABB) -> bool: {
        return .lower.x <= other.lower.x && .lower.y <= other.lower.y
            && .upper.x >= other.upper.x && .upper.y >= other.upper.y;
    }

    
    
    fn overlaps(self: &const shared, other: &const shared AABB) -> bool: {
        if .upper.x < other.lower.x || other.upper.x < .lower.x: {
            return false;
        }
        if .upper.y < other.lower.y || other.upper.y < .lower.y: {
            return false;
        }
        return true;
    }

    
    fn closest_point(self: &const shared, p: &const shared Vec2) -> Vec2: {
        return make_vec2(p.x.clamped(.lower.x, .upper.x), p.y.clamped(.lower.y, .upper.y));
    }

    fn distance_squared_to_point(self: &const shared, p: &const shared Vec2) -> Fixed: {
        let nearest = .closest_point(p);
        return (p - nearest).length_squared();
    }

    fn translated(self: &const shared, offset: &const shared Vec2) -> AABB: {
        return make_aabb(.lower + offset, .upper + offset);
    }

    
    
    
    fn swept(self: &const shared, displacement: &const shared Vec2) -> AABB: {
        let moved = .translated(displacement);
        return make_aabb(.lower.componentwise_min(moved.lower), .upper.componentwise_max(moved.upper));
    }

    lower: Vec2;
    upper: Vec2;
}

fn make_aabb(lower: &const shared Vec2, upper: &const shared Vec2) -> AABB: {
    var result: AABB;
    result.lower = lower + vec2_zero();
    result.upper = upper + vec2_zero();
    return result;
}

fn aabb_empty() -> AABB: {
    var result: AABB;
    result.set_empty();
    return result;
}

fn aabb_from_centre(centre: &const shared Vec2, half: &const shared Vec2) -> AABB: {
    return make_aabb(centre - half, centre + half);
}



fn impl (a + b)(l: &const shared AABB, r: &const shared AABB) -> AABB: {
    return make_aabb(l.lower.componentwise_min(r.lower), l.upper.componentwise_max(r.upper));
}


fn impl (a + b)(l: &const shared AABB, r: &const shared Vec2) -> AABB: {
    return make_aabb(l.lower + r, l.upper + r);
}

fn impl (a - b)(l: &const shared AABB, r: &const shared Vec2) -> AABB: {
    return make_aabb(l.lower - r, l.upper - r);
}



fn impl (a * b)(l: &const shared AABB, r: &const shared AABB) -> AABB: {
    return make_aabb(l.lower.componentwise_max(r.lower), l.upper.componentwise_min(r.upper));
}

fn impl (a == b)(l: &const shared AABB, r: &const shared AABB) -> bool: {
    return l.lower == r.lower && l.upper == r.upper;
}

fn impl (a != b)(l: &const shared AABB, r: &const shared AABB) -> bool: {
    return l.lower != r.lower || l.upper != r.upper;
}


fn impl (a < b)(l: &const shared AABB, r: &const shared AABB) -> bool: {
    return l.area() < r.area();
}

fn impl (a > b)(l: &const shared AABB, r: &const shared AABB) -> bool: {
    return l.area() > r.area();
}



struct Circle: {

    fn area(self: &const shared) -> Fixed: {
        return pi_fixed() * .radius * .radius;
    }

    
    
    
    fn inertia_for_mass(self: &const shared, mass: &const shared Fixed) -> Fixed: {
        let own = mass * .radius * .radius / 2;
        return own + mass * .centre.length_squared();
    }

    fn bounds(self: &const shared, frame: &const shared Transform) -> AABB: {
        let world_centre = frame.apply(.centre);
        let extent = make_vec2(.radius, .radius);
        return make_aabb(world_centre - extent, world_centre + extent);
    }

    fn contains_point(self: &const shared, frame: &const shared Transform, p: &const shared Vec2) -> bool: {
        let local = frame.unapply(p);
        return (local - .centre).length_squared() <= .radius * .radius;
    }

    
    
    fn support(self: &const shared, frame: &const shared Transform, direction: &const shared Vec2) -> Vec2: {
        let unit = direction.normalised();
        return frame.apply(.centre) + unit * .radius;
    }

    centre: Vec2;
    radius: Fixed;
}

fn make_circle(centre: &const shared Vec2, radius: &const shared Fixed) -> Circle: {
    var result: Circle;
    result.centre = centre + vec2_zero();
    result.radius = radius + zero_fixed();
    return result;
}

fn impl (a == b)(l: &const shared Circle, r: &const shared Circle) -> bool: {
    return l.centre == r.centre && l.radius == r.radius;
}



fn impl (a * b)(l: &const shared Circle, r: &const shared Fixed) -> Circle: {
    return make_circle(l.centre * r, l.radius * r);
}





static MAX_POLYGON_VERTICES: int = 16;




struct Polygon: {

    fn vertex_count(self: &const shared) -> int: {
        return .vertices.size();
    }

    
    
    fn vertex(self: &const shared, index: int) -> Vec2: {
        let count = .vertices.size();
        if count == 0: {
            return vec2_zero();
        }
        var wrapped = index % count;
        if wrapped < 0: {
            wrapped += count;
        }
        return .vertices[wrapped] + vec2_zero();
    }

    fn normal(self: &const shared, index: int) -> Vec2: {
        let count = .normals.size();
        if count == 0: {
            return vec2_zero();
        }
        var wrapped = index % count;
        if wrapped < 0: {
            wrapped += count;
        }
        return .normals[wrapped] + vec2_zero();
    }

    fn world_vertex(self: &const shared, frame: &const shared Transform, index: int) -> Vec2: {
        return frame.apply(.vertex(index));
    }

    fn world_normal(self: &const shared, frame: &const shared Transform, index: int) -> Vec2: {
        return frame.apply_direction(.normal(index));
    }

    
    
    
    fn rebuild_normals(self: &unique): {
        .normals.clear();
        let count = .vertices.size();
        var index: int = 0;
        while index < count: {
            let current = .vertices[index];
            let next = .vertices[(index + 1) % count];
            let edge = next - current;
            .normals.push_back(edge.perpendicular_cw().normalised());
            index += 1;
        }
    }

    
    
    fn signed_area_twice(self: &const shared) -> Fixed: {
        var total = zero_fixed();
        let count = .vertices.size();
        var index: int = 0;
        while index < count: {
            let current = .vertices[index];
            let next = .vertices[(index + 1) % count];
            total = total + current.x * next.y - next.x * current.y;
            index += 1;
        }
        return total;
    }

    fn area(self: &const shared) -> Fixed: {
        return .signed_area_twice().magnitude() / 2;
    }

    
    
    
    fn centroid(self: &const shared) -> Vec2: {
        var accumulated = vec2_zero();
        var total_area = zero_fixed();
        let count = .vertices.size();
        var index: int = 0;
        while index < count: {
            let current = .vertices[index];
            let next = .vertices[(index + 1) % count];
            let cross_term = current.x * next.y - next.x * current.y;
            accumulated = accumulated + (current + next) * cross_term;
            total_area = total_area + cross_term;
            index += 1;
        }
        if total_area.magnitude().raw <= LINEAR_EPSILON_RAW: {
            return vec2_zero();
        }
        return accumulated / (total_area * 3);
    }

    
    
    fn second_moment(self: &const shared) -> Fixed: {
        var numerator = zero_fixed();
        var denominator = zero_fixed();
        let count = .vertices.size();
        var index: int = 0;
        while index < count: {
            let current = .vertices[index];
            let next = .vertices[(index + 1) % count];
            let cross_term = (current.x * next.y - next.x * current.y).magnitude();
            let spread = current.dot(current) + current.dot(next) + next.dot(next);
            numerator = numerator + cross_term * spread;
            denominator = denominator + cross_term;
            index += 1;
        }
        if denominator.raw == 0: {
            return zero_fixed();
        }
        return numerator / (denominator * 6) * denominator;
    }

    fn inertia_for_mass(self: &const shared, mass: &const shared Fixed) -> Fixed: {
        let a = .area();
        if a.raw <= 0: {
            return zero_fixed();
        }
        return .second_moment() * mass / a;
    }

    
    
    fn support_index(self: &const shared, direction: &const shared Vec2) -> int: {
        let count = .vertices.size();
        if count == 0: {
            return 0;
        }
        var best: int = 0;
        var best_projection = .vertices[0].dot(direction);
        var index: int = 1;
        while index < count: {
            let projection = .vertices[index].dot(direction);
            if projection > best_projection: {
                best_projection = projection;
                best = index;
            }
            index += 1;
        }
        return best;
    }

    fn support(self: &const shared, frame: &const shared Transform, direction: &const shared Vec2) -> Vec2: {
        let local_direction = frame.unapply_direction(direction);
        return frame.apply(.vertex(.support_index(local_direction)));
    }

    
    fn project_onto(self: &const shared, axis: &const shared Vec2) -> Vec2: {
        let count = .vertices.size();
        if count == 0: {
            return vec2_zero();
        }
        var low = .vertices[0].dot(axis);
        var high = low + zero_fixed();
        var index: int = 1;
        while index < count: {
            let projection = .vertices[index].dot(axis);
            low = fixed_min(low, projection);
            high = fixed_max(high, projection);
            index += 1;
        }
        return make_vec2(low, high);
    }

    fn bounds(self: &const shared, frame: &const shared Transform) -> AABB: {
        var box = aabb_empty();
        let count = .vertices.size();
        var index: int = 0;
        while index < count: {
            box.include_point(frame.apply(.vertices[index]));
            index += 1;
        }
        return box;
    }

    
    
    fn contains_point(self: &const shared, frame: &const shared Transform, p: &const shared Vec2) -> bool: {
        let local = frame.unapply(p);
        let count = .vertices.size();
        var index: int = 0;
        while index < count: {
            let offset = local - .vertices[index];
            if .normals[index].dot(offset) > zero_fixed(): {
                return false;
            }
            index += 1;
        }
        return true;
    }

    
    
    fn is_convex(self: &const shared) -> bool: {
        let count = .vertices.size();
        if count < 3: {
            return false;
        }
        var index: int = 0;
        while index < count: {
            let a = .vertex(index);
            let b = .vertex(index + 1);
            let c = .vertex(index + 2);
            if triangle_area_twice(a, b, c) < zero_fixed(): {
                return false;
            }
            index += 1;
        }
        return true;
    }

    
    
    fn recentre(self: &unique): {
        let offset = .centroid();
        var index: int = 0;
        while index < .vertices.size(): {
            .vertices[index] = .vertices[index] - offset;
            index += 1;
        }
        .rebuild_normals();
    }

    vertices: vector{Vec2};
    normals: vector{Vec2};
    radius: Fixed;
}




fn make_polygon(vertices: vector{Vec2}) -> Polygon: {
    var result: Polygon;
    result.vertices = move(vertices);
    result.radius = raw_fixed(LINEAR_EPSILON_RAW);
    result.rebuild_normals();
    return result;
}



fn make_box_polygon(hx: &const shared Fixed, hy: &const shared Fixed) -> Polygon: {
    var corners: vector{Vec2};
    corners.push_back(make_vec2(-hx, -hy));
    corners.push_back(make_vec2(hx, -hy));
    corners.push_back(make_vec2(hx, hy));
    corners.push_back(make_vec2(-hx, hy));
    return make_polygon(move(corners));
}



fn make_regular_polygon(sides: int, circumradius: &const shared Fixed) -> Polygon: {
    var corners: vector{Vec2};
    var index: int = 0;
    while index < sides && index < MAX_POLYGON_VERTICES: {
        let angle = tau_fixed() * index / sides;
        corners.push_back(vec2_from_angle(angle) * circumradius);
        index += 1;
    }
    return make_polygon(move(corners));
}

fn impl (a == b)(l: &const shared Polygon, r: &const shared Polygon) -> bool: {
    if l.vertices.size() != r.vertices.size(): {
        return false;
    }
    var index: int = 0;
    while index < l.vertices.size(): {
        if l.vertices[index] != r.vertices[index]: {
            return false;
        }
        index += 1;
    }
    return true;
}






struct Shape: {

    fn is_circle(self: &const shared) -> bool: {
        return .kind == ShapeKind::Circle;
    }

    fn is_polygon(self: &const shared) -> bool: {
        return .kind == ShapeKind::Polygon || .kind == ShapeKind::Box;
    }

    fn area(self: &const shared) -> Fixed: {
        if .kind == ShapeKind::Circle: {
            return .circle.area();
        }
        return .polygon.area();
    }

    fn mass_for_density(self: &const shared, density: &const shared Fixed) -> Fixed: {
        return .area() * density;
    }

    fn inertia_for_mass(self: &const shared, mass: &const shared Fixed) -> Fixed: {
        if .kind == ShapeKind::Circle: {
            return .circle.inertia_for_mass(mass);
        }
        return .polygon.inertia_for_mass(mass);
    }

    fn centroid(self: &const shared) -> Vec2: {
        if .kind == ShapeKind::Circle: {
            return .circle.centre + vec2_zero();
        }
        return .polygon.centroid();
    }

    fn bounds(self: &const shared, frame: &const shared Transform) -> AABB: {
        if .kind == ShapeKind::Circle: {
            return .circle.bounds(frame);
        }
        return .polygon.bounds(frame);
    }

    fn contains_point(self: &const shared, frame: &const shared Transform, p: &const shared Vec2) -> bool: {
        if .kind == ShapeKind::Circle: {
            return .circle.contains_point(frame, p);
        }
        return .polygon.contains_point(frame, p);
    }

    fn support(self: &const shared, frame: &const shared Transform, direction: &const shared Vec2) -> Vec2: {
        if .kind == ShapeKind::Circle: {
            return .circle.support(frame, direction);
        }
        return .polygon.support(frame, direction);
    }

    kind: ShapeKind = ShapeKind::Circle;
    circle: Circle;
    polygon: Polygon;
}

fn shape_from_circle(circle: Circle) -> Shape: {
    var result: Shape;
    result.kind = ShapeKind::Circle;
    result.circle = move(circle);
    return result;
}

fn shape_from_polygon(polygon: Polygon) -> Shape: {
    var result: Shape;
    result.kind = ShapeKind::Polygon;
    result.polygon = move(polygon);
    return result;
}

fn shape_box(hx: &const shared Fixed, hy: &const shared Fixed) -> Shape: {
    var result = shape_from_polygon(make_box_polygon(hx, hy));
    result.kind = ShapeKind::Box;
    return result;
}






struct Material: {

    fn is_bouncy(self: &const shared) -> bool: {
        return .restitution.raw > FIXED_QUARTER;
    }

    fn is_slippery(self: &const shared) -> bool: {
        return .dynamic_friction.raw < raw_fixed(6553).raw;
    }

    density: Fixed;
    restitution: Fixed;
    static_friction: Fixed;
    dynamic_friction: Fixed;
}

fn make_material(density: &const shared Fixed, restitution: &const shared Fixed,
                 static_friction: &const shared Fixed, dynamic_friction: &const shared Fixed) -> Material: {
    var result: Material;
    result.density = density + zero_fixed();
    result.restitution = restitution + zero_fixed();
    result.static_friction = static_friction + zero_fixed();
    result.dynamic_friction = dynamic_friction + zero_fixed();
    return result;
}




fn mix_restitution(a: &const shared Material, b: &const shared Material) -> Fixed: {
    return fixed_max(a.restitution, b.restitution);
}

fn mix_static_friction(a: &const shared Material, b: &const shared Material) -> Fixed: {
    return (a.static_friction * b.static_friction).square_root();
}

fn mix_dynamic_friction(a: &const shared Material, b: &const shared Material) -> Fixed: {
    return (a.dynamic_friction * b.dynamic_friction).square_root();
}





fn material_wood() -> Material: {
    return make_material(ratio(600, 1000), raw_fixed(19660), raw_fixed(39321), raw_fixed(26214));
}

fn material_steel() -> Material: {
    return make_material(whole(8), raw_fixed(13107), raw_fixed(26214), raw_fixed(13107));
}

fn material_rubber() -> Material: {
    return make_material(ratio(1200, 1000), raw_fixed(58982), raw_fixed(58982), raw_fixed(39321));
}

fn material_ice() -> Material: {
    return make_material(ratio(900, 1000), raw_fixed(6553), raw_fixed(6553), raw_fixed(3276));
}







struct RigidBody: {

    

    fn is_static(self: &const shared) -> bool: {
        return .kind == BodyKind::Static;
    }

    fn is_dynamic(self: &const shared) -> bool: {
        return .kind == BodyKind::Dynamic;
    }

    fn is_movable(self: &const shared) -> bool: {
        return .kind != BodyKind::Static && .inverse_mass.raw > 0;
    }

    
    
    
    fn recompute_mass(self: &unique): {
        if .kind != BodyKind::Dynamic: {
            .mass = zero_fixed();
            .inverse_mass = zero_fixed();
            .inertia = zero_fixed();
            .inverse_inertia = zero_fixed();
            return;
        }
        .mass = .shape.mass_for_density(.material.density);
        if .mass.raw <= 0: {
            .mass = one_fixed();
        }
        .inverse_mass = .mass.reciprocal();
        .inertia = .shape.inertia_for_mass(.mass);
        if .inertia.raw <= 0: {
            .inverse_inertia = zero_fixed();
        } else: {
            .inverse_inertia = .inertia.reciprocal();
        }
        .local_centre = .shape.centroid();
    }

    
    
    fn freeze(self: &unique): {
        .inverse_mass = zero_fixed();
        .inverse_inertia = zero_fixed();
        .velocity = vec2_zero();
        .angular_velocity = zero_fixed();
    }

    fn thaw(self: &unique): {
        if .mass.raw > 0: {
            .inverse_mass = .mass.reciprocal();
        }
        if .inertia.raw > 0: {
            .inverse_inertia = .inertia.reciprocal();
        }
    }

    

    fn position(self: &const shared) -> Vec2: {
        return .frame.position + vec2_zero();
    }

    fn angle(self: &const shared) -> Fixed: {
        return .frame.angle + zero_fixed();
    }

    
    fn world_centre(self: &const shared) -> Vec2: {
        return .frame.position + .frame.rotation * .local_centre;
    }

    fn set_position(self: &unique, p: &const shared Vec2): {
        .frame.position = p + vec2_zero();
        .bounds_dirty = true;
    }

    fn set_angle(self: &unique, angle: &const shared Fixed): {
        .frame.set_angle(angle);
        .bounds_dirty = true;
    }

    fn to_world(self: &const shared, local: &const shared Vec2) -> Vec2: {
        return .frame.apply(local);
    }

    fn to_local(self: &const shared, world: &const shared Vec2) -> Vec2: {
        return .frame.unapply(world);
    }

    

    
    
    
    fn velocity_at(self: &const shared, world_point: &const shared Vec2) -> Vec2: {
        let offset = world_point - .world_centre();
        return make_vec2(.velocity.x - .angular_velocity * offset.y,
                         .velocity.y + .angular_velocity * offset.x);
    }

    fn set_velocity(self: &unique, v: &const shared Vec2): {
        .velocity = v + vec2_zero();
        .sleep_timer = zero_fixed();
        .awake = true;
    }

    fn add_velocity(self: &unique, delta: &const shared Vec2): {
        .velocity = .velocity + delta;
        .awake = true;
    }

    

    fn clear_forces(self: &unique): {
        .force = vec2_zero();
        .torque = zero_fixed();
    }

    fn apply_force(self: &unique, f: &const shared Vec2): {
        .force = .force + f;
        .awake = true;
    }

    
    
    fn apply_force_at(self: &unique, f: &const shared Vec2, world_point: &const shared Vec2): {
        let offset = world_point - .world_centre();
        .force = .force + f;
        .torque = .torque + offset.x * f.y - offset.y * f.x;
        .awake = true;
    }

    fn apply_torque(self: &unique, t: &const shared Fixed): {
        .torque = .torque + t;
        .awake = true;
    }

    
    
    
    fn apply_impulse(self: &unique, impulse: &const shared Vec2): {
        .velocity = .velocity + impulse * .inverse_mass;
    }

    fn apply_impulse_at(self: &unique, impulse: &const shared Vec2, world_point: &const shared Vec2): {
        let offset = world_point - .world_centre();
        .velocity.x = .velocity.x + impulse.x * .inverse_mass;
        .velocity.y = .velocity.y + impulse.y * .inverse_mass;
        .angular_velocity = .angular_velocity
            + .inverse_inertia * (offset.x * impulse.y - offset.y * impulse.x);
    }

    fn apply_angular_impulse(self: &unique, amount: &const shared Fixed): {
        .angular_velocity = .angular_velocity + amount * .inverse_inertia;
    }

    

    
    
    
    
    fn integrate_velocity(self: &unique, gravity: &const shared Vec2, dt: &const shared Fixed): {
        if .inverse_mass.raw == 0: {
            return;
        }
        .velocity = .velocity
            + (gravity * .gravity_scale + .force * .inverse_mass) * dt;
        .angular_velocity = .angular_velocity + .torque * .inverse_inertia * dt;
        .velocity = .velocity * (one_fixed() / (one_fixed() + .linear_damping * dt));
        .angular_velocity = .angular_velocity
            / (one_fixed() + .angular_damping * dt);
        .velocity = .velocity.clamped_length(.max_linear_speed);
        .angular_velocity = .angular_velocity.clamped(-.max_angular_speed, .max_angular_speed);
    }

    fn integrate_position(self: &unique, dt: &const shared Fixed): {
        if .kind == BodyKind::Static: {
            return;
        }
        .frame.position = .frame.position + .velocity * dt;
        .frame.angle = .frame.angle + .angular_velocity * dt;
        .frame.refresh();
        .bounds_dirty = true;
    }

    

    
    fn kinetic_energy(self: &const shared) -> Fixed: {
        let linear = .mass * .velocity.length_squared() / 2;
        let angular = .inertia * .angular_velocity * .angular_velocity / 2;
        return linear + angular;
    }

    
    
    fn potential_energy(self: &const shared, gravity: &const shared Vec2, datum: &const shared Fixed) -> Fixed: {
        return -.mass * (gravity.x * .world_centre().x
                       + gravity.y * (.world_centre().y - datum));
    }

    fn linear_momentum(self: &const shared) -> Vec2: {
        return .velocity * .mass;
    }

    fn angular_momentum_about(self: &const shared, pivot: &const shared Vec2) -> Fixed: {
        let offset = .world_centre() - pivot;
        return .inertia * .angular_velocity
            + .mass * (offset.x * .velocity.y - offset.y * .velocity.x);
    }

    

    
    
    fn update_sleep(self: &unique, dt: &const shared Fixed, linear_threshold: &const shared Fixed,
                    angular_threshold: &const shared Fixed, time_to_sleep: &const shared Fixed): {
        if .kind == BodyKind::Static: {
            return;
        }
        if .never_sleeps: {
            .sleep_timer = zero_fixed();
            return;
        }
        let moving = .velocity.length_squared() > linear_threshold * linear_threshold
            || .angular_velocity.magnitude() > angular_threshold;
        if moving: {
            .sleep_timer = zero_fixed();
            .awake = true;
        } else: {
            .sleep_timer = .sleep_timer + dt;
            if .sleep_timer >= time_to_sleep: {
                .awake = false;
                .velocity = vec2_zero();
                .angular_velocity = zero_fixed();
            }
        }
    }

    fn wake(self: &unique): {
        .awake = true;
        .sleep_timer = zero_fixed();
    }

    

    fn bounds(self: &const shared) -> AABB: {
        return .shape.bounds(.frame);
    }

    
    
    
    fn proxy_bounds(self: &const shared, margin: &const shared Fixed, dt: &const shared Fixed) -> AABB: {
        return .shape.bounds(.frame).swept(.velocity * dt).expanded(margin);
    }

    

    kind: BodyKind = BodyKind::Dynamic;
    identifier: int = 0;
    layer: int = 1;
    mask: int = 65535;

    shape: Shape;
    material: Material;
    frame: Transform;
    local_centre: Vec2;

    mass: Fixed;
    inverse_mass: Fixed;
    inertia: Fixed;
    inverse_inertia: Fixed;

    velocity: Vec2;
    angular_velocity: Fixed;
    force: Vec2;
    torque: Fixed;

    linear_damping: Fixed;
    angular_damping: Fixed;
    gravity_scale: Fixed;
    max_linear_speed: Fixed;
    max_angular_speed: Fixed;

    sleep_timer: Fixed;
    awake: bool = true;
    never_sleeps: bool = false;
    bounds_dirty: bool = true;
}



fn should_collide(a: &const shared RigidBody, b: &const shared RigidBody) -> bool: {
    if a.inverse_mass.raw == 0 && b.inverse_mass.raw == 0: {
        return false;
    }
    if !a.awake && !b.awake: {
        return false;
    }
    return (a.layer & b.mask) != 0 && (b.layer & a.mask) != 0;
}



fn impl (a < b)(l: &const shared RigidBody, r: &const shared RigidBody) -> bool: {
    return l.identifier < r.identifier;
}

fn impl (a == b)(l: &const shared RigidBody, r: &const shared RigidBody) -> bool: {
    return l.identifier == r.identifier;
}












static HASH_PRIME_X: int = 73856093;
static HASH_PRIME_Y: int = 19349663;
static HASH_PRIME_MIX: int = 83492791;



static DEFAULT_BUCKET_COUNT: int = 4096;
static DEFAULT_BUCKET_MASK: int = 4095;



static MAX_CELLS_PER_PROXY: int = 64;




struct GridEntry: {
    body_index: int = 0;
    cell_x: int = 0;
    cell_y: int = 0;
    generation: int = 0;
}




struct BodyPair: {

    fn normalise(self: &unique): {
        if .low > .high: {
            swap(.low, .high);
        }
    }

    fn key(self: &const shared) -> int: {
        return .low * 1000003 + .high;
    }

    low: int = 0;
    high: int = 0;
}

fn make_pair(a: int, b: int) -> BodyPair: {
    var result: BodyPair;
    if a < b: {
        result.low = a;
        result.high = b;
    } else: {
        result.low = b;
        result.high = a;
    }
    return result;
}

fn impl (a == b)(l: &const shared BodyPair, r: &const shared BodyPair) -> bool: {
    return l.low == r.low && l.high == r.high;
}

fn impl (a != b)(l: &const shared BodyPair, r: &const shared BodyPair) -> bool: {
    return l.low != r.low || l.high != r.high;
}


fn impl (a < b)(l: &const shared BodyPair, r: &const shared BodyPair) -> bool: {
    if l.low != r.low: {
        return l.low < r.low;
    }
    return l.high < r.high;
}

fn impl (a > b)(l: &const shared BodyPair, r: &const shared BodyPair) -> bool: {
    if l.low != r.low: {
        return l.low > r.low;
    }
    return l.high > r.high;
}

struct SpatialHash: {

    

    fn configure(self: &unique, cell_size: &const shared Fixed, buckets: int): {
        .cell_size = cell_size + zero_fixed();
        .inverse_cell_size = cell_size.reciprocal();
        .bucket_count = buckets;
        .bucket_mask = buckets - 1;
        .buckets.clear();
        .buckets.resize(buckets);
        .generation = 0;
    }

    

    
    
    fn cell_of(self: &const shared, value: &const shared Fixed) -> int: {
        return (value * .inverse_cell_size).floor_int();
    }

    fn cell_x_of_point(self: &const shared, p: &const shared Vec2) -> int: {
        return (p.x * .inverse_cell_size).floor_int();
    }

    fn cell_y_of_point(self: &const shared, p: &const shared Vec2) -> int: {
        return (p.y * .inverse_cell_size).floor_int();
    }

    
    
    
    fn bucket_of(self: &const shared, cx: int, cy: int) -> int: {
        let mixed = (cx * HASH_PRIME_X) ^ (cy * HASH_PRIME_Y) ^ HASH_PRIME_MIX;
        var index = mixed & .bucket_mask;
        if index < 0: {
            index += .bucket_count;
        }
        return index;
    }

    
    
    fn cell_span(self: &const shared, box: &const shared AABB) -> int: {
        let low_x = .cell_of(box.lower.x);
        let low_y = .cell_of(box.lower.y);
        let high_x = .cell_of(box.upper.x);
        let high_y = .cell_of(box.upper.y);
        return (high_x - low_x + 1) * (high_y - low_y + 1);
    }

    

    fn clear(self: &unique): {
        var index: int = 0;
        while index < .buckets.size(): {
            .buckets[index].clear();
            index += 1;
        }
        .oversized.clear();
        .proxy_bounds.clear();
        .entry_count = 0;
        .generation += 1;
    }

    
    fn insert(self: &unique, body_index: int, box: &const shared AABB): {
        .proxy_bounds.push_back(box + vec2_zero());
        if .cell_span(box) > MAX_CELLS_PER_PROXY: {
            .oversized.push_back(body_index);
            return;
        }
        let low_x = .cell_of(box.lower.x);
        let low_y = .cell_of(box.lower.y);
        let high_x = .cell_of(box.upper.x);
        let high_y = .cell_of(box.upper.y);
        var cy = low_y;
        while cy <= high_y: {
            var cx = low_x;
            while cx <= high_x: {
                var entry: GridEntry;
                entry.body_index = body_index;
                entry.cell_x = cx;
                entry.cell_y = cy;
                entry.generation = .generation;
                .buckets[.bucket_of(cx, cy)].push_back(entry);
                .entry_count += 1;
                cx += 1;
            }
            cy += 1;
        }
    }

    
    
    
    fn rebuild(self: &unique, bodies: &const shared vector{RigidBody},
               margin: &const shared Fixed, dt: &const shared Fixed): {
        .clear();
        var index: int = 0;
        while index < bodies.size(): {
            let body: &const shared = bodies[index];
            if body.awake || body.kind == BodyKind::Static: {
                .insert(index, body.proxy_bounds(margin, dt));
            } else: {
                .proxy_bounds.push_back(body.bounds());
            }
            index += 1;
        }
    }

    

    
    
    
    fn query_box(self: &const shared, box: &const shared AABB, out: &unique vector{int}): {
        let low_x = .cell_of(box.lower.x);
        let low_y = .cell_of(box.lower.y);
        let high_x = .cell_of(box.upper.x);
        let high_y = .cell_of(box.upper.y);
        var cy = low_y;
        while cy <= high_y: {
            var cx = low_x;
            while cx <= high_x: {
                let bucket: &const shared = .buckets[.bucket_of(cx, cy)];
                var slot: int = 0;
                while slot < bucket.size(): {
                    let entry: &const shared = bucket[slot];
                    
                    
                    if entry.cell_x == cx && entry.cell_y == cy: {
                        out.push_back(entry.body_index);
                    }
                    slot += 1;
                }
                cx += 1;
            }
            cy += 1;
        }
        var extra: int = 0;
        while extra < .oversized.size(): {
            out.push_back(.oversized[extra]);
            extra += 1;
        }
    }

    fn query_point(self: &const shared, p: &const shared Vec2, out: &unique vector{int}): {
        .query_box(make_aabb(p, p), out);
    }

    fn query_circle(self: &const shared, centre: &const shared Vec2, radius: &const shared Fixed,
                    out: &unique vector{int}): {
        let extent = make_vec2(radius, radius);
        .query_box(make_aabb(centre - extent, centre + extent), out);
    }

    

    
    
    
    
    fn collect_pairs(self: &const shared, bodies: &const shared vector{RigidBody},
                     out: &unique vector{BodyPair}): {
        var bucket_index: int = 0;
        while bucket_index < .buckets.size(): {
            let bucket: &const shared = .buckets[bucket_index];
            var first: int = 0;
            while first < bucket.size(): {
                var second = first + 1;
                while second < bucket.size(): {
                    let a: &const shared = bucket[first];
                    let b: &const shared = bucket[second];
                    if a.cell_x == b.cell_x && a.cell_y == b.cell_y
                        && a.body_index != b.body_index: {
                        let left: &const shared = bodies[a.body_index];
                        let right: &const shared = bodies[b.body_index];
                        if should_collide(left, right)
                            && .proxy_bounds[a.body_index].overlaps(.proxy_bounds[b.body_index]): {
                            out.push_back(make_pair(a.body_index, b.body_index));
                            broad_phase_pair_count += 1;
                        }
                    }
                    second += 1;
                }
                first += 1;
            }
            bucket_index += 1;
        }
        
        
        var big: int = 0;
        while big < .oversized.size(): {
            let subject = .oversized[big];
            var other: int = 0;
            while other < bodies.size(): {
                if other != subject: {
                    let left: &const shared = bodies[subject];
                    let right: &const shared = bodies[other];
                    if should_collide(left, right)
                        && .proxy_bounds[subject].overlaps(.proxy_bounds[other]): {
                        out.push_back(make_pair(subject, other));
                        broad_phase_pair_count += 1;
                    }
                }
                other += 1;
            }
            big += 1;
        }
    }

    

    fn occupied_buckets(self: &const shared) -> int: {
        var count: int = 0;
        var index: int = 0;
        while index < .buckets.size(): {
            if .buckets[index].size() > 0: {
                count += 1;
            }
            index += 1;
        }
        return count;
    }

    fn longest_bucket(self: &const shared) -> int: {
        var longest: int = 0;
        var index: int = 0;
        while index < .buckets.size(): {
            if .buckets[index].size() > longest: {
                longest = .buckets[index].size();
            }
            index += 1;
        }
        return longest;
    }

    
    
    fn average_load(self: &const shared) -> Fixed: {
        let occupied = .occupied_buckets();
        if occupied == 0: {
            return zero_fixed();
        }
        return whole(.entry_count) / whole(occupied);
    }

    buckets: vector{vector{GridEntry}};
    oversized: vector{int};
    proxy_bounds: vector{AABB};
    cell_size: Fixed;
    inverse_cell_size: Fixed;
    bucket_count: int = 4096;
    bucket_mask: int = 4095;
    entry_count: int = 0;
    generation: int = 0;
}

fn make_spatial_hash(cell_size: &const shared Fixed) -> SpatialHash: {
    var result: SpatialHash;
    result.configure(cell_size, DEFAULT_BUCKET_COUNT);
    return result;
}




fn deduplicate_pairs(pairs: &unique vector{BodyPair}): {
    if pairs.size() < 2: {
        return;
    }
    var write: int = 1;
    var read: int = 1;
    while read < pairs.size(): {
        if pairs[read] != pairs[write - 1]: {
            pairs[write] = pairs[read];
            write += 1;
        }
        read += 1;
    }
    while pairs.size() > write: {
        pairs.pop_back();
    }
}




fn sort_pairs(pairs: &unique vector{BodyPair}): {
    var index: int = 1;
    while index < pairs.size(): {
        var slot = index;
        while slot > 0 && pairs[slot] < pairs[slot - 1]: {
            swap(pairs[slot], pairs[slot - 1]);
            slot -= 1;
        }
        index += 1;
    }
}











static MAX_MANIFOLD_POINTS: int = 2;



static CONTACT_MATCH_TOLERANCE_RAW: int = 655;



static PENETRATION_SLOP_RAW: int = 328;



static RESTITUTION_THRESHOLD_RAW: int = 65536;


struct ContactPoint: {

    
    
    fn refresh_anchors(self: &unique, centre_a: &const shared Vec2, centre_b: &const shared Vec2): {
        .anchor_a = .position - centre_a;
        .anchor_b = .position - centre_b;
    }

    fn is_new(self: &const shared) -> bool: {
        return .match_count == 0;
    }

    
    position: Vec2;
    
    anchor_a: Vec2;
    anchor_b: Vec2;
    
    
    local_a: Vec2;
    local_b: Vec2;
    
    separation: Fixed;
    
    normal_impulse: Fixed;
    tangent_impulse: Fixed;
    
    
    normal_mass: Fixed;
    tangent_mass: Fixed;
    
    velocity_bias: Fixed;
    
    feature_id: int = 0;
    match_count: int = 0;
}

fn make_contact_point(position: &const shared Vec2, separation: &const shared Fixed, feature: int) -> ContactPoint: {
    var result: ContactPoint;
    result.position = position + vec2_zero();
    result.separation = separation + zero_fixed();
    result.feature_id = feature;
    return result;
}


struct Manifold: {

    fn point_count(self: &const shared) -> int: {
        return .points.size();
    }

    fn is_touching(self: &const shared) -> bool: {
        return .state != ContactState::Separated && .points.size() > 0;
    }

    fn clear(self: &unique): {
        .points.clear();
        .state = ContactState::Separated;
    }

    
    
    fn tangent(self: &const shared) -> Vec2: {
        return make_vec2(-.normal.y, .normal.x);
    }

    
    
    fn deepest_separation(self: &const shared) -> Fixed: {
        var deepest = zero_fixed();
        var index: int = 0;
        while index < .points.size(): {
            deepest = fixed_min(deepest, .points[index].separation);
            index += 1;
        }
        return deepest;
    }

    
    
    fn total_normal_impulse(self: &const shared) -> Fixed: {
        var total = zero_fixed();
        var index: int = 0;
        while index < .points.size(): {
            total = total + .points[index].normal_impulse;
            index += 1;
        }
        return total;
    }

    fn centre_of_pressure(self: &const shared) -> Vec2: {
        let total = .total_normal_impulse();
        if total.raw == 0: {
            if .points.size() == 0: {
                return vec2_zero();
            }
            return .points[0].position + vec2_zero();
        }
        var weighted = vec2_zero();
        var index: int = 0;
        while index < .points.size(): {
            weighted = weighted + .points[index].position * .points[index].normal_impulse;
            index += 1;
        }
        return weighted / total;
    }

    
    
    
    
    fn warm_start_from(self: &unique, previous: &const shared Manifold): {
        var index: int = 0;
        while index < .points.size(): {
            var found: bool = false;
            var other: int = 0;
            while other < previous.points.size() && !found: {
                let old: &const shared = previous.points[other];
                let same_feature = old.feature_id == .points[index].feature_id;
                let close = (old.position - .points[index].position).manhattan_length()
                    <= raw_fixed(CONTACT_MATCH_TOLERANCE_RAW);
                if same_feature || close: {
                    .points[index].normal_impulse = old.normal_impulse + zero_fixed();
                    .points[index].tangent_impulse = old.tangent_impulse + zero_fixed();
                    .points[index].match_count = old.match_count + 1;
                    found = true;
                }
                other += 1;
            }
            if !found: {
                .points[index].normal_impulse = zero_fixed();
                .points[index].tangent_impulse = zero_fixed();
                .points[index].match_count = 0;
            }
            index += 1;
        }
    }

    body_a: int = 0;
    body_b: int = 0;
    
    normal: Vec2;
    points: vector{ContactPoint};
    state: ContactState = ContactState::Separated;
    feature: FeatureKind = FeatureKind::FaceA;
    friction: Fixed;
    restitution: Fixed;
}

fn make_manifold(body_a: int, body_b: int) -> Manifold: {
    var result: Manifold;
    result.body_a = body_a;
    result.body_b = body_b;
    result.normal = vec2_unit_y();
    return result;
}






fn collide_circle_circle(manifold: &unique Manifold,
                         circle_a: &const shared Circle, frame_a: &const shared Transform,
                         circle_b: &const shared Circle, frame_b: &const shared Transform): {
    narrow_phase_test_count += 1;
    manifold.clear();
    let centre_a = frame_a.apply(circle_a.centre);
    let centre_b = frame_b.apply(circle_b.centre);
    let offset = centre_b - centre_a;
    let distance_squared = offset.length_squared();
    let combined = circle_a.radius + circle_b.radius;
    if distance_squared > combined * combined: {
        manifold.state = ContactState::Separated;
        return;
    }
    let distance = distance_squared.square_root();
    if distance.raw <= LINEAR_EPSILON_RAW: {
        
        
        manifold.normal = vec2_unit_y();
        manifold.points.push_back(make_contact_point(centre_a, -combined, 0));
        manifold.state = ContactState::Penetrating;
        return;
    }
    manifold.normal = offset / distance;
    let surface_a = centre_a + manifold.normal * circle_a.radius;
    let surface_b = centre_b - manifold.normal * circle_b.radius;
    let midpoint = (surface_a + surface_b) / 2;
    manifold.points.push_back(make_contact_point(midpoint, distance - combined, 0));
    manifold.state = ContactState::Penetrating;
}








fn collide_circle_polygon(manifold: &unique Manifold,
                          circle: &const shared Circle, circle_frame: &const shared Transform,
                          polygon: &const shared Polygon, polygon_frame: &const shared Transform,
                          flip_normal: bool): {
    narrow_phase_test_count += 1;
    manifold.clear();
    let world_centre = circle_frame.apply(circle.centre);
    let local_centre = polygon_frame.unapply(world_centre);
    let count = polygon.vertices.size();
    if count == 0: {
        manifold.state = ContactState::Separated;
        return;
    }

    var best_edge: int = 0;
    var best_separation = raw_fixed(FIXED_MIN_RAW);
    var index: int = 0;
    while index < count: {
        let separation = polygon.normals[index].dot(local_centre - polygon.vertices[index]);
        if separation > circle.radius: {
            manifold.state = ContactState::Separated;
            return;
        }
        if separation > best_separation: {
            best_separation = separation;
            best_edge = index;
        }
        index += 1;
    }

    let vertex_a = polygon.vertex(best_edge);
    let vertex_b = polygon.vertex(best_edge + 1);

    
    
    if best_separation.raw < LINEAR_EPSILON_RAW && best_separation.raw <= 0: {
        let face_normal = polygon.normals[best_edge];
        let world_normal = polygon_frame.apply_direction(face_normal);
        let contact = world_centre - world_normal * circle.radius;
        if flip_normal: {
            manifold.normal = -world_normal;
        } else: {
            manifold.normal = world_normal + vec2_zero();
        }
        manifold.points.push_back(make_contact_point(contact, best_separation - circle.radius, best_edge));
        manifold.state = ContactState::Penetrating;
        return;
    }

    
    
    let edge = vertex_b - vertex_a;
    let projection_a = (local_centre - vertex_a).dot(edge);
    let projection_b = (local_centre - vertex_b).dot(edge);
    var local_normal = vec2_zero();
    var local_contact = vec2_zero();
    var feature = best_edge;
    if projection_a <= zero_fixed(): {
        if (local_centre - vertex_a).length_squared() > circle.radius * circle.radius: {
            manifold.state = ContactState::Separated;
            return;
        }
        local_normal = (local_centre - vertex_a).normalised();
        local_contact = vertex_a + vec2_zero();
        feature = best_edge * 4 + 1;
    } else: {
        if projection_b >= zero_fixed(): {
            if (local_centre - vertex_b).length_squared() > circle.radius * circle.radius: {
                manifold.state = ContactState::Separated;
                return;
            }
            local_normal = (local_centre - vertex_b).normalised();
            local_contact = vertex_b + vec2_zero();
            feature = best_edge * 4 + 2;
        } else: {
            local_normal = polygon.normals[best_edge] + vec2_zero();
            local_contact = closest_point_on_segment(vertex_a, vertex_b, local_centre);
            feature = best_edge * 4;
        }
    }

    let world_normal = polygon_frame.apply_direction(local_normal);
    let world_contact = polygon_frame.apply(local_contact);
    let separation = (local_centre - local_contact).dot(local_normal) - circle.radius;
    if flip_normal: {
        manifold.normal = -world_normal;
    } else: {
        manifold.normal = world_normal + vec2_zero();
    }
    manifold.points.push_back(make_contact_point(world_contact, separation, feature));
    manifold.state = ContactState::Penetrating;
}




struct AxisQuery: {
    edge_index: int = 0;
    separation: Fixed;
}






fn greatest_separation(a: &const shared Polygon, frame_a: &const shared Transform,
                       b: &const shared Polygon, frame_b: &const shared Transform) -> AxisQuery: {
    var result: AxisQuery;
    result.separation = raw_fixed(FIXED_MIN_RAW);
    let count = a.vertices.size();
    var index: int = 0;
    while index < count: {
        let world_normal = frame_a.apply_direction(a.normals[index]);
        let local_normal = frame_b.unapply_direction(world_normal);
        let support = b.vertex(b.support_index(-local_normal));
        let world_support = frame_b.apply(support);
        let world_vertex = frame_a.apply(a.vertices[index]);
        let separation = world_normal.dot(world_support - world_vertex);
        if separation > result.separation: {
            result.separation = separation;
            result.edge_index = index;
        }
        index += 1;
    }
    return result;
}



struct ClipVertex: {
    position: Vec2;
    identifier: int = 0;
}

fn make_clip_vertex(position: &const shared Vec2, identifier: int) -> ClipVertex: {
    var result: ClipVertex;
    result.position = position + vec2_zero();
    result.identifier = identifier;
    return result;
}



fn find_incident_edge(reference_normal: &const shared Vec2,
                      incident: &const shared Polygon, incident_frame: &const shared Transform,
                      out: &unique vector{ClipVertex}): {
    out.clear();
    let local_normal = incident_frame.unapply_direction(reference_normal);
    let count = incident.normals.size();
    if count == 0: {
        return;
    }
    var best: int = 0;
    var best_dot = incident.normals[0].dot(local_normal);
    var index: int = 1;
    while index < count: {
        let value = incident.normals[index].dot(local_normal);
        if value < best_dot: {
            best_dot = value;
            best = index;
        }
        index += 1;
    }
    out.push_back(make_clip_vertex(incident_frame.apply(incident.vertex(best)), best * 4));
    out.push_back(make_clip_vertex(incident_frame.apply(incident.vertex(best + 1)), best * 4 + 1));
}




fn clip_segment_to_plane(input: &const shared vector{ClipVertex}, output: &unique vector{ClipVertex},
                         normal: &const shared Vec2, offset: &const shared Fixed,
                         identifier: int) -> int: {
    output.clear();
    if input.size() < 2: {
        return 0;
    }
    let distance_0 = normal.dot(input[0].position) - offset;
    let distance_1 = normal.dot(input[1].position) - offset;
    if distance_0 <= zero_fixed(): {
        output.push_back(make_clip_vertex(input[0].position, input[0].identifier));
    }
    if distance_1 <= zero_fixed(): {
        output.push_back(make_clip_vertex(input[1].position, input[1].identifier));
    }
    if distance_0 * distance_1 < zero_fixed(): {
        let t = distance_0 / (distance_0 - distance_1);
        let crossing = input[0].position + (input[1].position - input[0].position) * t;
        output.push_back(make_clip_vertex(crossing, identifier));
    }
    return output.size();
}







fn collide_polygon_polygon(manifold: &unique Manifold,
                           a: &const shared Polygon, frame_a: &const shared Transform,
                           b: &const shared Polygon, frame_b: &const shared Transform): {
    narrow_phase_test_count += 1;
    manifold.clear();
    let query_a = greatest_separation(a, frame_a, b, frame_b);
    if query_a.separation > zero_fixed(): {
        manifold.state = ContactState::Separated;
        return;
    }
    let query_b = greatest_separation(b, frame_b, a, frame_a);
    if query_b.separation > zero_fixed(): {
        manifold.state = ContactState::Separated;
        return;
    }

    
    
    
    var reference_is_a: bool = true;
    var reference_edge = query_a.edge_index;
    var bias = raw_fixed(PENETRATION_SLOP_RAW);
    if query_b.separation > query_a.separation + bias: {
        reference_is_a = false;
        reference_edge = query_b.edge_index;
        manifold.feature = FeatureKind::FaceB;
    } else: {
        manifold.feature = FeatureKind::FaceA;
    }

    var incident_points: vector{ClipVertex};
    var clipped_once: vector{ClipVertex};
    var clipped_twice: vector{ClipVertex};

    if reference_is_a: {
        let reference_normal = frame_a.apply_direction(a.normals[reference_edge]);
        let reference_v0 = frame_a.apply(a.vertex(reference_edge));
        let reference_v1 = frame_a.apply(a.vertex(reference_edge + 1));
        let side = (reference_v1 - reference_v0).normalised();
        find_incident_edge(reference_normal, b, frame_b, incident_points);
        let survived_once = clip_segment_to_plane(incident_points, clipped_once,
                                                  -side, -side.dot(reference_v0),
                                                  reference_edge * 4 + 2);
        if survived_once < 2: {
            manifold.state = ContactState::Touching;
            return;
        }
        let survived_twice = clip_segment_to_plane(clipped_once, clipped_twice,
                                                   side, side.dot(reference_v1),
                                                   reference_edge * 4 + 3);
        if survived_twice < 2: {
            manifold.state = ContactState::Touching;
            return;
        }
        manifold.normal = reference_normal + vec2_zero();
        let face_offset = reference_normal.dot(reference_v0);
        var index: int = 0;
        while index < clipped_twice.size() && manifold.points.size() < MAX_MANIFOLD_POINTS: {
            let separation = reference_normal.dot(clipped_twice[index].position) - face_offset;
            if separation <= zero_fixed(): {
                manifold.points.push_back(make_contact_point(clipped_twice[index].position,
                                                             separation,
                                                             clipped_twice[index].identifier));
            }
            index += 1;
        }
    } else: {
        let reference_normal = frame_b.apply_direction(b.normals[reference_edge]);
        let reference_v0 = frame_b.apply(b.vertex(reference_edge));
        let reference_v1 = frame_b.apply(b.vertex(reference_edge + 1));
        let side = (reference_v1 - reference_v0).normalised();
        find_incident_edge(reference_normal, a, frame_a, incident_points);
        let survived_once = clip_segment_to_plane(incident_points, clipped_once,
                                                  -side, -side.dot(reference_v0),
                                                  reference_edge * 4 + 2);
        if survived_once < 2: {
            manifold.state = ContactState::Touching;
            return;
        }
        let survived_twice = clip_segment_to_plane(clipped_once, clipped_twice,
                                                   side, side.dot(reference_v1),
                                                   reference_edge * 4 + 3);
        if survived_twice < 2: {
            manifold.state = ContactState::Touching;
            return;
        }
        
        
        manifold.normal = -reference_normal;
        let face_offset = reference_normal.dot(reference_v0);
        var index: int = 0;
        while index < clipped_twice.size() && manifold.points.size() < MAX_MANIFOLD_POINTS: {
            let separation = reference_normal.dot(clipped_twice[index].position) - face_offset;
            if separation <= zero_fixed(): {
                manifold.points.push_back(make_contact_point(clipped_twice[index].position,
                                                             separation,
                                                             clipped_twice[index].identifier));
            }
            index += 1;
        }
    }

    if manifold.points.size() == 0: {
        manifold.state = ContactState::Touching;
    } else: {
        manifold.state = ContactState::Penetrating;
    }
}






fn collide(manifold: &unique Manifold,
           a: &const shared RigidBody, b: &const shared RigidBody): {
    manifold.friction = mix_dynamic_friction(a.material, b.material);
    manifold.restitution = mix_restitution(a.material, b.material);
    if a.shape.kind == ShapeKind::Circle && b.shape.kind == ShapeKind::Circle: {
        collide_circle_circle(manifold, a.shape.circle, a.frame, b.shape.circle, b.frame);
        return;
    }
    if a.shape.kind == ShapeKind::Circle: {
        
        
        collide_circle_polygon(manifold, a.shape.circle, a.frame, b.shape.polygon, b.frame, true);
        return;
    }
    if b.shape.kind == ShapeKind::Circle: {
        collide_circle_polygon(manifold, b.shape.circle, b.frame, a.shape.polygon, a.frame, false);
        return;
    }
    collide_polygon_polygon(manifold, a.shape.polygon, a.frame, b.shape.polygon, b.frame);
}


fn quick_reject(a: &const shared RigidBody, b: &const shared RigidBody) -> bool: {
    return !a.bounds().overlaps(b.bounds());
}














static BAUMGARTE_RAW: int = 13107;



static MAX_LINEAR_CORRECTION_RAW: int = 13107;


static DEFAULT_VELOCITY_ITERATIONS: int = 8;
static DEFAULT_POSITION_ITERATIONS: int = 3;



struct ContactConstraint: {

    
    
    
    fn effective_mass(self: &const shared, anchor_a: &const shared Vec2, anchor_b: &const shared Vec2,
                      direction: &const shared Vec2) -> Fixed: {
        let cross_a = anchor_a.x * direction.y - anchor_a.y * direction.x;
        let cross_b = anchor_b.x * direction.y - anchor_b.y * direction.x;
        let total = .inverse_mass_a + .inverse_mass_b
            + .inverse_inertia_a * cross_a * cross_a
            + .inverse_inertia_b * cross_b * cross_b;
        if total.raw <= 0: {
            return zero_fixed();
        }
        return total.reciprocal();
    }

    manifold_index: int = 0;
    body_a: int = 0;
    body_b: int = 0;
    inverse_mass_a: Fixed;
    inverse_mass_b: Fixed;
    inverse_inertia_a: Fixed;
    inverse_inertia_b: Fixed;
    centre_a: Vec2;
    centre_b: Vec2;
    friction: Fixed;
    restitution: Fixed;
}

struct ContactSolver: {

    

    
    
    
    fn prepare(self: &unique, bodies: &unique vector{RigidBody},
               manifolds: &unique vector{Manifold}, dt: &const shared Fixed): {
        .constraints.clear();
        var index: int = 0;
        while index < manifolds.size(): {
            let manifold: &unique = manifolds[index];
            if !manifold.is_touching(): {
                index += 1;
            } else: {
                var constraint: ContactConstraint;
                constraint.manifold_index = index;
                constraint.body_a = manifold.body_a;
                constraint.body_b = manifold.body_b;
                constraint.friction = manifold.friction + zero_fixed();
                constraint.restitution = manifold.restitution + zero_fixed();

                let body_a: &const shared = bodies[manifold.body_a];
                let body_b: &const shared = bodies[manifold.body_b];
                constraint.inverse_mass_a = body_a.inverse_mass + zero_fixed();
                constraint.inverse_mass_b = body_b.inverse_mass + zero_fixed();
                constraint.inverse_inertia_a = body_a.inverse_inertia + zero_fixed();
                constraint.inverse_inertia_b = body_b.inverse_inertia + zero_fixed();
                constraint.centre_a = body_a.world_centre();
                constraint.centre_b = body_b.world_centre();

                let tangent = manifold.tangent();
                var point_index: int = 0;
                while point_index < manifold.points.size(): {
                    let point: &unique = manifold.points[point_index];
                    point.anchor_a = point.position - constraint.centre_a;
                    point.anchor_b = point.position - constraint.centre_b;
                    point.local_a = body_a.to_local(point.position);
                    point.local_b = body_b.to_local(point.position);
                    point.normal_mass = constraint.effective_mass(point.anchor_a, point.anchor_b,
                                                                  manifold.normal);
                    point.tangent_mass = constraint.effective_mass(point.anchor_a, point.anchor_b,
                                                                   tangent);

                    
                    
                    
                    let velocity_a = body_a.velocity_at(point.position);
                    let velocity_b = body_b.velocity_at(point.position);
                    let approach = manifold.normal.x * (velocity_b.x - velocity_a.x)
                        + manifold.normal.y * (velocity_b.y - velocity_a.y);
                    if approach < -raw_fixed(RESTITUTION_THRESHOLD_RAW): {
                        point.velocity_bias = -constraint.restitution * approach;
                    } else: {
                        point.velocity_bias = zero_fixed();
                    }
                    point_index += 1;
                }
                .constraints.push_back(constraint);
                index += 1;
            }
        }
    }

    

    
    
    
    fn warm_start(self: &unique, bodies: &unique vector{RigidBody},
                  manifolds: &const shared vector{Manifold}): {
        var index: int = 0;
        while index < .constraints.size(): {
            let constraint: &const shared = .constraints[index];
            let manifold: &const shared = manifolds[constraint.manifold_index];
            let tangent = manifold.tangent();
            var point_index: int = 0;
            while point_index < manifold.points.size(): {
                let point: &const shared = manifold.points[point_index];
                let impulse = make_vec2(
                    manifold.normal.x * point.normal_impulse + tangent.x * point.tangent_impulse,
                    manifold.normal.y * point.normal_impulse + tangent.y * point.tangent_impulse);
                let body_a: &unique = bodies[constraint.body_a];
                body_a.velocity.x = body_a.velocity.x - impulse.x * constraint.inverse_mass_a;
                body_a.velocity.y = body_a.velocity.y - impulse.y * constraint.inverse_mass_a;
                body_a.angular_velocity = body_a.angular_velocity
                    - constraint.inverse_inertia_a
                    * (point.anchor_a.x * impulse.y - point.anchor_a.y * impulse.x);
                let body_b: &unique = bodies[constraint.body_b];
                body_b.velocity.x = body_b.velocity.x + impulse.x * constraint.inverse_mass_b;
                body_b.velocity.y = body_b.velocity.y + impulse.y * constraint.inverse_mass_b;
                body_b.angular_velocity = body_b.angular_velocity
                    + constraint.inverse_inertia_b
                    * (point.anchor_b.x * impulse.y - point.anchor_b.y * impulse.x);
                point_index += 1;
            }
            index += 1;
        }
    }

    

    
    
    
    fn solve_velocity_once(self: &unique, bodies: &unique vector{RigidBody},
                           manifolds: &unique vector{Manifold}): {
        var index: int = 0;
        while index < .constraints.size(): {
            let constraint: &const shared = .constraints[index];
            let manifold: &unique = manifolds[constraint.manifold_index];
            let tangent = manifold.tangent();

            var point_index: int = 0;
            while point_index < manifold.points.size(): {
                let point: &unique = manifold.points[point_index];
                let body_a: &unique = bodies[constraint.body_a];
                let body_b: &unique = bodies[constraint.body_b];

                
                
                let relative_x = body_b.velocity.x - body_b.angular_velocity * point.anchor_b.y
                    - body_a.velocity.x + body_a.angular_velocity * point.anchor_a.y;
                let relative_y = body_b.velocity.y + body_b.angular_velocity * point.anchor_b.x
                    - body_a.velocity.y - body_a.angular_velocity * point.anchor_a.x;

                
                let tangent_speed = tangent.x * relative_x + tangent.y * relative_y;
                var tangent_delta = -point.tangent_mass * tangent_speed;
                let friction_limit = constraint.friction * point.normal_impulse;
                let new_tangent = (point.tangent_impulse + tangent_delta)
                    .clamped(-friction_limit, friction_limit);
                tangent_delta = new_tangent - point.tangent_impulse;
                point.tangent_impulse = new_tangent + zero_fixed();

                let friction_impulse = make_vec2(tangent.x * tangent_delta, tangent.y * tangent_delta);
                body_a.velocity.x = body_a.velocity.x - friction_impulse.x * constraint.inverse_mass_a;
                body_a.velocity.y = body_a.velocity.y - friction_impulse.y * constraint.inverse_mass_a;
                body_a.angular_velocity = body_a.angular_velocity
                    - constraint.inverse_inertia_a
                    * (point.anchor_a.x * friction_impulse.y - point.anchor_a.y * friction_impulse.x);
                body_b.velocity.x = body_b.velocity.x + friction_impulse.x * constraint.inverse_mass_b;
                body_b.velocity.y = body_b.velocity.y + friction_impulse.y * constraint.inverse_mass_b;
                body_b.angular_velocity = body_b.angular_velocity
                    + constraint.inverse_inertia_b
                    * (point.anchor_b.x * friction_impulse.y - point.anchor_b.y * friction_impulse.x);

                
                let after_x = body_b.velocity.x - body_b.angular_velocity * point.anchor_b.y
                    - body_a.velocity.x + body_a.angular_velocity * point.anchor_a.y;
                let after_y = body_b.velocity.y + body_b.angular_velocity * point.anchor_b.x
                    - body_a.velocity.y - body_a.angular_velocity * point.anchor_a.x;
                let normal_speed = manifold.normal.x * after_x + manifold.normal.y * after_y;
                var normal_delta = -point.normal_mass * (normal_speed - point.velocity_bias);
                
                let new_normal = fixed_max(point.normal_impulse + normal_delta, zero_fixed());
                normal_delta = new_normal - point.normal_impulse;
                point.normal_impulse = new_normal + zero_fixed();

                let normal_impulse = make_vec2(manifold.normal.x * normal_delta,
                                               manifold.normal.y * normal_delta);
                body_a.velocity.x = body_a.velocity.x - normal_impulse.x * constraint.inverse_mass_a;
                body_a.velocity.y = body_a.velocity.y - normal_impulse.y * constraint.inverse_mass_a;
                body_a.angular_velocity = body_a.angular_velocity
                    - constraint.inverse_inertia_a
                    * (point.anchor_a.x * normal_impulse.y - point.anchor_a.y * normal_impulse.x);
                body_b.velocity.x = body_b.velocity.x + normal_impulse.x * constraint.inverse_mass_b;
                body_b.velocity.y = body_b.velocity.y + normal_impulse.y * constraint.inverse_mass_b;
                body_b.angular_velocity = body_b.angular_velocity
                    + constraint.inverse_inertia_b
                    * (point.anchor_b.x * normal_impulse.y - point.anchor_b.y * normal_impulse.x);

                solver_iteration_count += 1;
                point_index += 1;
            }
            index += 1;
        }
    }

    fn solve_velocity(self: &unique, bodies: &unique vector{RigidBody},
                      manifolds: &unique vector{Manifold}, iterations: int): {
        var pass: int = 0;
        while pass < iterations: {
            .solve_velocity_once(bodies, manifolds);
            pass += 1;
        }
    }

    

    
    
    
    
    
    
    fn solve_position_once(self: &unique, bodies: &unique vector{RigidBody},
                           manifolds: &unique vector{Manifold}) -> Fixed: {
        var deepest = zero_fixed();
        let slop = raw_fixed(PENETRATION_SLOP_RAW);
        let baumgarte = raw_fixed(BAUMGARTE_RAW);
        let max_correction = raw_fixed(MAX_LINEAR_CORRECTION_RAW);
        var index: int = 0;
        while index < .constraints.size(): {
            let constraint: &const shared = .constraints[index];
            let manifold: &unique = manifolds[constraint.manifold_index];
            var point_index: int = 0;
            while point_index < manifold.points.size(): {
                let point: &unique = manifold.points[point_index];
                let body_a: &unique = bodies[constraint.body_a];
                let body_b: &unique = bodies[constraint.body_b];

                
                
                let world_a = body_a.to_world(point.local_a);
                let world_b = body_b.to_world(point.local_b);
                let separation = manifold.normal.x * (world_b.x - world_a.x)
                    + manifold.normal.y * (world_b.y - world_a.y)
                    + point.separation;
                deepest = fixed_min(deepest, separation);

                let correction = (baumgarte * (separation + slop))
                    .clamped(-max_correction, zero_fixed());
                let anchor_a = world_a - body_a.world_centre();
                let anchor_b = world_b - body_b.world_centre();
                let mass = constraint.effective_mass(anchor_a, anchor_b, manifold.normal);
                let magnitude = -mass * correction;
                let push = make_vec2(manifold.normal.x * magnitude, manifold.normal.y * magnitude);

                body_a.frame.position.x = body_a.frame.position.x - push.x * constraint.inverse_mass_a;
                body_a.frame.position.y = body_a.frame.position.y - push.y * constraint.inverse_mass_a;
                body_a.frame.angle = body_a.frame.angle
                    - constraint.inverse_inertia_a * (anchor_a.x * push.y - anchor_a.y * push.x);
                body_a.frame.refresh();

                body_b.frame.position.x = body_b.frame.position.x + push.x * constraint.inverse_mass_b;
                body_b.frame.position.y = body_b.frame.position.y + push.y * constraint.inverse_mass_b;
                body_b.frame.angle = body_b.frame.angle
                    + constraint.inverse_inertia_b * (anchor_b.x * push.y - anchor_b.y * push.x);
                body_b.frame.refresh();

                point_index += 1;
            }
            index += 1;
        }
        return deepest;
    }

    fn solve_position(self: &unique, bodies: &unique vector{RigidBody},
                      manifolds: &unique vector{Manifold}, iterations: int) -> bool: {
        let target = -raw_fixed(PENETRATION_SLOP_RAW) * 3;
        var pass: int = 0;
        var settled: bool = false;
        while pass < iterations && !settled: {
            let deepest = .solve_position_once(bodies, manifolds);
            if deepest >= target: {
                settled = true;
            }
            pass += 1;
        }
        return settled;
    }

    

    fn constraint_count(self: &const shared) -> int: {
        return .constraints.size();
    }

    
    
    
    fn total_normal_impulse(self: &const shared, manifolds: &const shared vector{Manifold}) -> Fixed: {
        var total = zero_fixed();
        var index: int = 0;
        while index < .constraints.size(): {
            total = total + manifolds[.constraints[index].manifold_index].total_normal_impulse();
            index += 1;
        }
        return total;
    }

    constraints: vector{ContactConstraint};
}









static JOINT_BAUMGARTE_RAW: int = 13107;


static JOINT_BREAK_STRETCH_RAW: int = 196608;




struct DistanceJoint: {

    
    
    fn axial_mass(self: &const shared, a: &const shared RigidBody, b: &const shared RigidBody,
                  anchor_a: &const shared Vec2, anchor_b: &const shared Vec2) -> Fixed: {
        let cross_a = anchor_a.x * .axis.y - anchor_a.y * .axis.x;
        let cross_b = anchor_b.x * .axis.y - anchor_b.y * .axis.x;
        let total = a.inverse_mass + b.inverse_mass
            + a.inverse_inertia * cross_a * cross_a
            + b.inverse_inertia * cross_b * cross_b;
        if total.raw <= 0: {
            return zero_fixed();
        }
        return total.reciprocal();
    }

    
    fn prepare(self: &unique, bodies: &unique vector{RigidBody}, dt: &const shared Fixed): {
        let body_a: &const shared = bodies[.body_a];
        let body_b: &const shared = bodies[.body_b];
        let world_a = body_a.to_world(.local_anchor_a);
        let world_b = body_b.to_world(.local_anchor_b);
        .anchor_a = world_a - body_a.world_centre();
        .anchor_b = world_b - body_b.world_centre();

        let separation = world_b - world_a;
        .current_length = separation.length();
        if .current_length.raw <= LINEAR_EPSILON_RAW: {
            .axis = vec2_unit_x();
        } else: {
            .axis = separation / .current_length;
        }
        .mass = .axial_mass(body_a, body_b, .anchor_a, .anchor_b);

        let error = .current_length - .rest_length;
        if .stiffness.raw > 0: {
            
            
            
            let omega = .stiffness;
            let zeta = .damping;
            let c = dt * omega * (dt * omega + zeta * 2);
            if c.raw != 0: {
                .gamma = (dt * (dt * omega * omega + omega * zeta * 2)).reciprocal();
            } else: {
                .gamma = zero_fixed();
            }
            .bias = error * dt * omega * omega * .gamma;
            if (.mass + .gamma).raw != 0: {
                .mass = (.mass.reciprocal() + .gamma).reciprocal();
            }
        } else: {
            .gamma = zero_fixed();
            .bias = error * raw_fixed(JOINT_BAUMGARTE_RAW) / dt;
        }

        if .current_length > .rest_length * 2 + raw_fixed(JOINT_BREAK_STRETCH_RAW): {
            .status = JointStatus::Broken;
        } else: {
            .status = JointStatus::Satisfied;
        }
    }

    fn warm_start(self: &unique, bodies: &unique vector{RigidBody}): {
        let impulse = .axis * .accumulated_impulse;
        let body_a: &unique = bodies[.body_a];
        body_a.velocity.x = body_a.velocity.x - impulse.x * body_a.inverse_mass;
        body_a.velocity.y = body_a.velocity.y - impulse.y * body_a.inverse_mass;
        body_a.angular_velocity = body_a.angular_velocity
            - body_a.inverse_inertia * (.anchor_a.x * impulse.y - .anchor_a.y * impulse.x);
        let body_b: &unique = bodies[.body_b];
        body_b.velocity.x = body_b.velocity.x + impulse.x * body_b.inverse_mass;
        body_b.velocity.y = body_b.velocity.y + impulse.y * body_b.inverse_mass;
        body_b.angular_velocity = body_b.angular_velocity
            + body_b.inverse_inertia * (.anchor_b.x * impulse.y - .anchor_b.y * impulse.x);
    }

    fn solve_velocity(self: &unique, bodies: &unique vector{RigidBody}): {
        if .status == JointStatus::Broken: {
            return;
        }
        let body_a: &unique = bodies[.body_a];
        let body_b: &unique = bodies[.body_b];
        let relative_x = body_b.velocity.x - body_b.angular_velocity * .anchor_b.y
            - body_a.velocity.x + body_a.angular_velocity * .anchor_a.y;
        let relative_y = body_b.velocity.y + body_b.angular_velocity * .anchor_b.x
            - body_a.velocity.y - body_a.angular_velocity * .anchor_a.x;
        let axial_speed = .axis.x * relative_x + .axis.y * relative_y;
        var delta = -.mass * (axial_speed + .bias + .gamma * .accumulated_impulse);

        
        if .rope_only: {
            let total = fixed_min(.accumulated_impulse + delta, zero_fixed());
            delta = total - .accumulated_impulse;
            .accumulated_impulse = total + zero_fixed();
        } else: {
            .accumulated_impulse = .accumulated_impulse + delta;
        }

        let impulse = make_vec2(.axis.x * delta, .axis.y * delta);
        body_a.velocity.x = body_a.velocity.x - impulse.x * body_a.inverse_mass;
        body_a.velocity.y = body_a.velocity.y - impulse.y * body_a.inverse_mass;
        body_a.angular_velocity = body_a.angular_velocity
            - body_a.inverse_inertia * (.anchor_a.x * impulse.y - .anchor_a.y * impulse.x);
        body_b.velocity.x = body_b.velocity.x + impulse.x * body_b.inverse_mass;
        body_b.velocity.y = body_b.velocity.y + impulse.y * body_b.inverse_mass;
        body_b.angular_velocity = body_b.angular_velocity
            + body_b.inverse_inertia * (.anchor_b.x * impulse.y - .anchor_b.y * impulse.x);
    }

    
    
    fn solve_position(self: &unique, bodies: &unique vector{RigidBody}) -> bool: {
        if .stiffness.raw > 0 || .status == JointStatus::Broken: {
            return true;
        }
        let body_a: &unique = bodies[.body_a];
        let body_b: &unique = bodies[.body_b];
        let world_a = body_a.to_world(.local_anchor_a);
        let world_b = body_b.to_world(.local_anchor_b);
        let separation = world_b - world_a;
        let length = separation.length();
        if length.raw <= LINEAR_EPSILON_RAW: {
            return true;
        }
        let unit = separation / length;
        let error = (length - .rest_length).clamped(-raw_fixed(MAX_LINEAR_CORRECTION_RAW),
                                                    raw_fixed(MAX_LINEAR_CORRECTION_RAW));
        let anchor_a = world_a - body_a.world_centre();
        let anchor_b = world_b - body_b.world_centre();
        let mass = .axial_mass(body_a, body_b, anchor_a, anchor_b);
        let push = unit * (-mass * error);
        body_a.frame.position = body_a.frame.position - push * body_a.inverse_mass;
        body_b.frame.position = body_b.frame.position + push * body_b.inverse_mass;
        body_a.frame.refresh();
        body_b.frame.refresh();
        if error.magnitude().raw > PENETRATION_SLOP_RAW: {
            .status = JointStatus::Corrected;
            return false;
        }
        return true;
    }

    fn stretch_ratio(self: &const shared) -> Fixed: {
        if .rest_length.raw == 0: {
            return zero_fixed();
        }
        return .current_length / .rest_length;
    }

    body_a: int = 0;
    body_b: int = 0;
    local_anchor_a: Vec2;
    local_anchor_b: Vec2;
    anchor_a: Vec2;
    anchor_b: Vec2;
    axis: Vec2;
    rest_length: Fixed;
    current_length: Fixed;
    stiffness: Fixed;
    damping: Fixed;
    gamma: Fixed;
    bias: Fixed;
    mass: Fixed;
    accumulated_impulse: Fixed;
    rope_only: bool = false;
    status: JointStatus = JointStatus::Satisfied;
}

fn make_distance_joint(body_a: int, body_b: int, local_a: &const shared Vec2,
                       local_b: &const shared Vec2, rest_length: &const shared Fixed) -> DistanceJoint: {
    var result: DistanceJoint;
    result.body_a = body_a;
    result.body_b = body_b;
    result.local_anchor_a = local_a + vec2_zero();
    result.local_anchor_b = local_b + vec2_zero();
    result.rest_length = rest_length + zero_fixed();
    result.axis = vec2_unit_x();
    return result;
}

fn make_spring_joint(body_a: int, body_b: int, local_a: &const shared Vec2,
                     local_b: &const shared Vec2, rest_length: &const shared Fixed,
                     stiffness: &const shared Fixed, damping: &const shared Fixed) -> DistanceJoint: {
    var result = make_distance_joint(body_a, body_b, local_a, local_b, rest_length);
    result.stiffness = stiffness + zero_fixed();
    result.damping = damping + zero_fixed();
    return result;
}





struct RevoluteJoint: {

    fn prepare(self: &unique, bodies: &unique vector{RigidBody}, dt: &const shared Fixed): {
        let body_a: &const shared = bodies[.body_a];
        let body_b: &const shared = bodies[.body_b];
        let world_a = body_a.to_world(.local_anchor_a);
        let world_b = body_b.to_world(.local_anchor_b);
        .anchor_a = world_a - body_a.world_centre();
        .anchor_b = world_b - body_b.world_centre();

        
        
        
        
        
        let scalar = body_a.inverse_mass + body_b.inverse_mass;
        let xx = scalar
            + body_a.inverse_inertia * .anchor_a.y * .anchor_a.y
            + body_b.inverse_inertia * .anchor_b.y * .anchor_b.y;
        let xy = -body_a.inverse_inertia * .anchor_a.x * .anchor_a.y
            - body_b.inverse_inertia * .anchor_b.x * .anchor_b.y;
        let yy = scalar
            + body_a.inverse_inertia * .anchor_a.x * .anchor_a.x
            + body_b.inverse_inertia * .anchor_b.x * .anchor_b.x;
        .mass = make_mat2(make_vec2(xx, xy), make_vec2(xy, yy));

        
        let drift = world_b - world_a;
        .bias = drift * raw_fixed(JOINT_BAUMGARTE_RAW) / dt;

        
        let angular_total = body_a.inverse_inertia + body_b.inverse_inertia;
        if angular_total.raw > 0: {
            .angular_mass = angular_total.reciprocal();
        } else: {
            .angular_mass = zero_fixed();
        }
        .relative_angle = normalise_angle(body_b.frame.angle - body_a.frame.angle - .reference_angle);
    }

    fn warm_start(self: &unique, bodies: &unique vector{RigidBody}): {
        let body_a: &unique = bodies[.body_a];
        body_a.velocity.x = body_a.velocity.x - .accumulated_impulse.x * body_a.inverse_mass;
        body_a.velocity.y = body_a.velocity.y - .accumulated_impulse.y * body_a.inverse_mass;
        body_a.angular_velocity = body_a.angular_velocity
            - body_a.inverse_inertia
            * (.anchor_a.x * .accumulated_impulse.y - .anchor_a.y * .accumulated_impulse.x)
            - body_a.inverse_inertia * .accumulated_motor_impulse;
        let body_b: &unique = bodies[.body_b];
        body_b.velocity.x = body_b.velocity.x + .accumulated_impulse.x * body_b.inverse_mass;
        body_b.velocity.y = body_b.velocity.y + .accumulated_impulse.y * body_b.inverse_mass;
        body_b.angular_velocity = body_b.angular_velocity
            + body_b.inverse_inertia
            * (.anchor_b.x * .accumulated_impulse.y - .anchor_b.y * .accumulated_impulse.x)
            + body_b.inverse_inertia * .accumulated_motor_impulse;
    }

    fn solve_velocity(self: &unique, bodies: &unique vector{RigidBody}, dt: &const shared Fixed): {
        let body_a: &unique = bodies[.body_a];
        let body_b: &unique = bodies[.body_b];

        
        if .motor_enabled: {
            let relative_speed = body_b.angular_velocity - body_a.angular_velocity - .motor_speed;
            var motor_delta = -.angular_mass * relative_speed;
            let budget = .max_motor_torque * dt;
            let total = (.accumulated_motor_impulse + motor_delta).clamped(-budget, budget);
            motor_delta = total - .accumulated_motor_impulse;
            .accumulated_motor_impulse = total + zero_fixed();
            body_a.angular_velocity = body_a.angular_velocity - motor_delta * body_a.inverse_inertia;
            body_b.angular_velocity = body_b.angular_velocity + motor_delta * body_b.inverse_inertia;
        }

        
        if .limit_enabled: {
            if .relative_angle < .lower_limit: {
                let excess = .relative_angle - .lower_limit;
                let speed = body_b.angular_velocity - body_a.angular_velocity;
                var delta = -.angular_mass * (speed + excess * raw_fixed(JOINT_BAUMGARTE_RAW) / dt);
                let total = fixed_max(.accumulated_limit_impulse + delta, zero_fixed());
                delta = total - .accumulated_limit_impulse;
                .accumulated_limit_impulse = total + zero_fixed();
                body_a.angular_velocity = body_a.angular_velocity - delta * body_a.inverse_inertia;
                body_b.angular_velocity = body_b.angular_velocity + delta * body_b.inverse_inertia;
            } else: {
                if .relative_angle > .upper_limit: {
                    let excess = .relative_angle - .upper_limit;
                    let speed = body_b.angular_velocity - body_a.angular_velocity;
                    var delta = -.angular_mass * (speed + excess * raw_fixed(JOINT_BAUMGARTE_RAW) / dt);
                    let total = fixed_min(.accumulated_limit_impulse + delta, zero_fixed());
                    delta = total - .accumulated_limit_impulse;
                    .accumulated_limit_impulse = total + zero_fixed();
                    body_a.angular_velocity = body_a.angular_velocity - delta * body_a.inverse_inertia;
                    body_b.angular_velocity = body_b.angular_velocity + delta * body_b.inverse_inertia;
                }
            }
        }

        
        let relative_x = body_b.velocity.x - body_b.angular_velocity * .anchor_b.y
            - body_a.velocity.x + body_a.angular_velocity * .anchor_a.y;
        let relative_y = body_b.velocity.y + body_b.angular_velocity * .anchor_b.x
            - body_a.velocity.y - body_a.angular_velocity * .anchor_a.x;
        let residual = make_vec2(relative_x + .bias.x, relative_y + .bias.y);
        let impulse = .mass.solve(-residual);
        .accumulated_impulse = .accumulated_impulse + impulse;

        body_a.velocity.x = body_a.velocity.x - impulse.x * body_a.inverse_mass;
        body_a.velocity.y = body_a.velocity.y - impulse.y * body_a.inverse_mass;
        body_a.angular_velocity = body_a.angular_velocity
            - body_a.inverse_inertia * (.anchor_a.x * impulse.y - .anchor_a.y * impulse.x);
        body_b.velocity.x = body_b.velocity.x + impulse.x * body_b.inverse_mass;
        body_b.velocity.y = body_b.velocity.y + impulse.y * body_b.inverse_mass;
        body_b.angular_velocity = body_b.angular_velocity
            + body_b.inverse_inertia * (.anchor_b.x * impulse.y - .anchor_b.y * impulse.x);
    }

    fn solve_position(self: &unique, bodies: &unique vector{RigidBody}) -> bool: {
        let body_a: &unique = bodies[.body_a];
        let body_b: &unique = bodies[.body_b];
        let world_a = body_a.to_world(.local_anchor_a);
        let world_b = body_b.to_world(.local_anchor_b);
        let drift = world_b - world_a;
        if drift.length_squared().raw <= LINEAR_EPSILON_SQUARED_RAW: {
            return true;
        }
        let anchor_a = world_a - body_a.world_centre();
        let anchor_b = world_b - body_b.world_centre();
        let scalar = body_a.inverse_mass + body_b.inverse_mass;
        let xx = scalar
            + body_a.inverse_inertia * anchor_a.y * anchor_a.y
            + body_b.inverse_inertia * anchor_b.y * anchor_b.y;
        let xy = -body_a.inverse_inertia * anchor_a.x * anchor_a.y
            - body_b.inverse_inertia * anchor_b.x * anchor_b.y;
        let yy = scalar
            + body_a.inverse_inertia * anchor_a.x * anchor_a.x
            + body_b.inverse_inertia * anchor_b.x * anchor_b.x;
        let matrix = make_mat2(make_vec2(xx, xy), make_vec2(xy, yy));
        let push = matrix.solve(-drift);
        body_a.frame.position = body_a.frame.position - push * body_a.inverse_mass;
        body_a.frame.angle = body_a.frame.angle
            - body_a.inverse_inertia * (anchor_a.x * push.y - anchor_a.y * push.x);
        body_a.frame.refresh();
        body_b.frame.position = body_b.frame.position + push * body_b.inverse_mass;
        body_b.frame.angle = body_b.frame.angle
            + body_b.inverse_inertia * (anchor_b.x * push.y - anchor_b.y * push.x);
        body_b.frame.refresh();
        return drift.manhattan_length().raw <= PENETRATION_SLOP_RAW;
    }

    body_a: int = 0;
    body_b: int = 0;
    local_anchor_a: Vec2;
    local_anchor_b: Vec2;
    anchor_a: Vec2;
    anchor_b: Vec2;
    mass: Mat2;
    bias: Vec2;
    accumulated_impulse: Vec2;
    angular_mass: Fixed;
    accumulated_motor_impulse: Fixed;
    accumulated_limit_impulse: Fixed;
    reference_angle: Fixed;
    relative_angle: Fixed;
    motor_speed: Fixed;
    max_motor_torque: Fixed;
    lower_limit: Fixed;
    upper_limit: Fixed;
    motor_enabled: bool = false;
    limit_enabled: bool = false;
}

fn make_revolute_joint(body_a: int, body_b: int, local_a: &const shared Vec2,
                       local_b: &const shared Vec2) -> RevoluteJoint: {
    var result: RevoluteJoint;
    result.body_a = body_a;
    result.body_b = body_b;
    result.local_anchor_a = local_a + vec2_zero();
    result.local_anchor_b = local_b + vec2_zero();
    result.mass = mat2_identity();
    return result;
}

fn make_motorised_joint(body_a: int, body_b: int, local_a: &const shared Vec2,
                        local_b: &const shared Vec2, speed: &const shared Fixed,
                        torque: &const shared Fixed) -> RevoluteJoint: {
    var result = make_revolute_joint(body_a, body_b, local_a, local_b);
    result.motor_enabled = true;
    result.motor_speed = speed + zero_fixed();
    result.max_motor_torque = torque + zero_fixed();
    return result;
}

















static DEFAULT_RELAXATION_PASSES: int = 4;


static SPRING_TEAR_RATIO_RAW: int = 262144;

struct Particle: {

    
    fn velocity(self: &const shared, dt: &const shared Fixed) -> Vec2: {
        if dt.raw == 0: {
            return vec2_zero();
        }
        return (.position - .previous) / dt;
    }

    
    
    fn displace(self: &unique, delta: &const shared Vec2): {
        .position = .position + delta;
        .previous = .previous + delta;
    }

    
    
    fn shift(self: &unique, delta: &const shared Vec2): {
        .position = .position + delta;
    }

    
    fn set_velocity(self: &unique, v: &const shared Vec2, dt: &const shared Fixed): {
        .previous = .position - v * dt;
    }

    fn add_force(self: &unique, f: &const shared Vec2): {
        .acceleration = .acceleration + f * .inverse_mass;
    }

    
    
    
    fn integrate(self: &unique, gravity: &const shared Vec2, dt: &const shared Fixed,
                 damping: &const shared Fixed): {
        if .pinned || .inverse_mass.raw == 0: {
            .previous = .position + vec2_zero();
            .acceleration = vec2_zero();
            return;
        }
        let implied = (.position - .previous) * damping;
        let total_acceleration = .acceleration + gravity;
        let next = make_vec2(
            .position.x + implied.x + total_acceleration.x * dt * dt,
            .position.y + implied.y + total_acceleration.y * dt * dt);
        .previous = .position + vec2_zero();
        .position = next + vec2_zero();
        .acceleration = vec2_zero();
    }

    fn kinetic_energy(self: &const shared, dt: &const shared Fixed) -> Fixed: {
        if .inverse_mass.raw == 0: {
            return zero_fixed();
        }
        return .velocity(dt).length_squared() / (.inverse_mass * 2);
    }

    position: Vec2;
    previous: Vec2;
    acceleration: Vec2;
    inverse_mass: Fixed;
    radius: Fixed;
    pinned: bool = false;
    alive: bool = true;
    group: int = 0;
}

fn make_particle(position: &const shared Vec2, mass: &const shared Fixed) -> Particle: {
    var result: Particle;
    result.position = position + vec2_zero();
    result.previous = position + vec2_zero();
    result.radius = raw_fixed(FIXED_QUARTER);
    if mass.raw > 0: {
        result.inverse_mass = mass.reciprocal();
    }
    return result;
}

fn make_pinned_particle(position: &const shared Vec2) -> Particle: {
    var result = make_particle(position, one_fixed());
    result.pinned = true;
    result.inverse_mass = zero_fixed();
    return result;
}




struct Spring: {

    fn current_length(self: &const shared, particles: &const shared vector{Particle}) -> Fixed: {
        return (particles[.particle_b].position - particles[.particle_a].position).length();
    }

    fn strain(self: &const shared, particles: &const shared vector{Particle}) -> Fixed: {
        if .rest_length.raw == 0: {
            return zero_fixed();
        }
        return (.current_length(particles) - .rest_length) / .rest_length;
    }

    
    
    
    fn relax(self: &unique, particles: &unique vector{Particle}): {
        if .broken: {
            return;
        }
        let a: &const shared = particles[.particle_a];
        let b: &const shared = particles[.particle_b];
        let separation = b.position - a.position;
        let length = separation.length();
        if length.raw <= LINEAR_EPSILON_RAW: {
            return;
        }
        let total_inverse_mass = a.inverse_mass + b.inverse_mass;
        if total_inverse_mass.raw == 0: {
            return;
        }
        let error = length - .rest_length;
        if .rest_length.raw > 0 && length > .rest_length * raw_fixed(SPRING_TEAR_RATIO_RAW): {
            .broken = true;
            return;
        }
        let unit = separation / length;
        let correction = unit * (error * .stiffness / total_inverse_mass);
        .last_tension = error * .stiffness;
        let mover_a: &unique = particles[.particle_a];
        mover_a.position = mover_a.position + correction * mover_a.inverse_mass;
        let mover_b: &unique = particles[.particle_b];
        mover_b.position = mover_b.position - correction * mover_b.inverse_mass;
    }

    
    
    fn potential_energy(self: &const shared, particles: &const shared vector{Particle}) -> Fixed: {
        let error = .current_length(particles) - .rest_length;
        return .stiffness * error * error / 2;
    }

    particle_a: int = 0;
    particle_b: int = 0;
    rest_length: Fixed;
    stiffness: Fixed;
    last_tension: Fixed;
    broken: bool = false;
}

fn make_spring(a: int, b: int, rest_length: &const shared Fixed,
               stiffness: &const shared Fixed) -> Spring: {
    var result: Spring;
    result.particle_a = a;
    result.particle_b = b;
    result.rest_length = rest_length + zero_fixed();
    result.stiffness = stiffness + zero_fixed();
    return result;
}



fn impl (a < b)(l: &const shared Spring, r: &const shared Spring) -> bool: {
    return l.rest_length < r.rest_length;
}

struct ParticleSystem: {

    

    fn add_particle(self: &unique, position: &const shared Vec2, mass: &const shared Fixed) -> int: {
        let index = .particles.size();
        .particles.push_back(make_particle(position, mass));
        return index;
    }

    fn add_pinned(self: &unique, position: &const shared Vec2) -> int: {
        let index = .particles.size();
        .particles.push_back(make_pinned_particle(position));
        return index;
    }

    
    
    fn connect(self: &unique, a: int, b: int, stiffness: &const shared Fixed) -> int: {
        let rest = (.particles[b].position - .particles[a].position).length();
        let index = .springs.size();
        .springs.push_back(make_spring(a, b, rest, stiffness));
        return index;
    }

    fn connect_at(self: &unique, a: int, b: int, rest: &const shared Fixed,
                  stiffness: &const shared Fixed) -> int: {
        let index = .springs.size();
        .springs.push_back(make_spring(a, b, rest, stiffness));
        return index;
    }

    

    fn integrate(self: &unique, gravity: &const shared Vec2, dt: &const shared Fixed): {
        var index: int = 0;
        while index < .particles.size(): {
            .particles[index].integrate(gravity, dt, .damping);
            index += 1;
        }
    }

    fn relax_springs(self: &unique): {
        var pass: int = 0;
        while pass < .relaxation_passes: {
            var index: int = 0;
            while index < .springs.size(): {
                .springs[index].relax(.particles);
                index += 1;
            }
            pass += 1;
        }
    }

    
    
    fn apply_bounds(self: &unique, bounds: &const shared AABB, restitution: &const shared Fixed): {
        var index: int = 0;
        while index < .particles.size(): {
            let particle: &unique = .particles[index];
            if particle.position.x < bounds.lower.x + particle.radius: {
                particle.position.x = bounds.lower.x + particle.radius;
                particle.previous.x = particle.position.x
                    + (particle.position.x - particle.previous.x) * restitution;
            }
            if particle.position.x > bounds.upper.x - particle.radius: {
                particle.position.x = bounds.upper.x - particle.radius;
                particle.previous.x = particle.position.x
                    + (particle.position.x - particle.previous.x) * restitution;
            }
            if particle.position.y < bounds.lower.y + particle.radius: {
                particle.position.y = bounds.lower.y + particle.radius;
                particle.previous.y = particle.position.y
                    + (particle.position.y - particle.previous.y) * restitution;
            }
            if particle.position.y > bounds.upper.y - particle.radius: {
                particle.position.y = bounds.upper.y - particle.radius;
                particle.previous.y = particle.position.y
                    + (particle.position.y - particle.previous.y) * restitution;
            }
            index += 1;
        }
    }

    
    
    
    fn resolve_particle_overlap(self: &unique): {
        var first: int = 0;
        while first < .particles.size(): {
            var second = first + 1;
            while second < .particles.size(): {
                let a: &const shared = .particles[first];
                let b: &const shared = .particles[second];
                let separation = b.position - a.position;
                let combined = a.radius + b.radius;
                let distance_squared = separation.length_squared();
                if distance_squared < combined * combined && distance_squared.raw > 0: {
                    let distance = distance_squared.square_root();
                    let overlap = combined - distance;
                    let unit = separation / distance;
                    let total_inverse_mass = a.inverse_mass + b.inverse_mass;
                    if total_inverse_mass.raw > 0: {
                        let correction = unit * (overlap / total_inverse_mass);
                        let mover_a: &unique = .particles[first];
                        mover_a.position = mover_a.position - correction * mover_a.inverse_mass;
                        let mover_b: &unique = .particles[second];
                        mover_b.position = mover_b.position + correction * mover_b.inverse_mass;
                    }
                }
                second += 1;
            }
            first += 1;
        }
    }

    
    
    
    fn resolve_body_overlap(self: &unique, bodies: &const shared vector{RigidBody}): {
        var index: int = 0;
        while index < .particles.size(): {
            var body_index: int = 0;
            while body_index < bodies.size(): {
                let body: &const shared = bodies[body_index];
                let particle: &unique = .particles[index];
                if body.shape.contains_point(body.frame, particle.position): {
                    let direction = (particle.position - body.world_centre()).normalised();
                    particle.position = particle.position + direction * particle.radius;
                }
                body_index += 1;
            }
            index += 1;
        }
    }

    fn step(self: &unique, gravity: &const shared Vec2, dt: &const shared Fixed,
            bounds: &const shared AABB): {
        .integrate(gravity, dt);
        .relax_springs();
        .resolve_particle_overlap();
        .apply_bounds(bounds, .bounce);
    }

    

    fn kinetic_energy(self: &const shared, dt: &const shared Fixed) -> Fixed: {
        var total = zero_fixed();
        var index: int = 0;
        while index < .particles.size(): {
            total = total + .particles[index].kinetic_energy(dt);
            index += 1;
        }
        return total;
    }

    fn spring_energy(self: &const shared) -> Fixed: {
        var total = zero_fixed();
        var index: int = 0;
        while index < .springs.size(): {
            total = total + .springs[index].potential_energy(.particles);
            index += 1;
        }
        return total;
    }

    fn centre_of_mass(self: &const shared) -> Vec2: {
        var weighted = vec2_zero();
        var total_mass = zero_fixed();
        var index: int = 0;
        while index < .particles.size(): {
            let particle: &const shared = .particles[index];
            if particle.inverse_mass.raw > 0: {
                let mass = particle.inverse_mass.reciprocal();
                weighted = weighted + particle.position * mass;
                total_mass = total_mass + mass;
            }
            index += 1;
        }
        if total_mass.raw == 0: {
            return vec2_zero();
        }
        return weighted / total_mass;
    }

    fn broken_spring_count(self: &const shared) -> int: {
        var count: int = 0;
        var index: int = 0;
        while index < .springs.size(): {
            if .springs[index].broken: {
                count += 1;
            }
            index += 1;
        }
        return count;
    }

    particles: vector{Particle};
    springs: vector{Spring};
    damping: Fixed;
    bounce: Fixed;
    relaxation_passes: int = 4;
}

fn make_particle_system() -> ParticleSystem: {
    var result: ParticleSystem;
    
    result.damping = raw_fixed(64880);
    result.bounce = ratio(-4, 10);
    result.relaxation_passes = DEFAULT_RELAXATION_PASSES;
    return result;
}




fn build_cloth(system: &unique ParticleSystem, origin: &const shared Vec2,
               columns: int, rows: int, spacing: &const shared Fixed,
               stiffness: &const shared Fixed): {
    let first_index = system.particles.size();
    var row: int = 0;
    while row < rows: {
        var column: int = 0;
        while column < columns: {
            let position = make_vec2(origin.x + spacing * column, origin.y - spacing * row);
            if row == 0 && (column == 0 || column == columns - 1): {
                discard system.add_pinned(position);
            } else: {
                discard system.add_particle(position, one_fixed());
            }
            column += 1;
        }
        row += 1;
    }
    row = 0;
    while row < rows: {
        var column: int = 0;
        while column < columns: {
            let here = first_index + row * columns + column;
            if column + 1 < columns: {
                discard system.connect(here, here + 1, stiffness);
            }
            if row + 1 < rows: {
                discard system.connect(here, here + columns, stiffness);
            }
            if column + 1 < columns && row + 1 < rows: {
                discard system.connect(here, here + columns + 1, stiffness / 2);
                discard system.connect(here + 1, here + columns, stiffness / 2);
            }
            column += 1;
        }
        row += 1;
    }
}


fn build_rope(system: &unique ParticleSystem, anchor: &const shared Vec2,
              segment_count: int, segment_length: &const shared Fixed,
              stiffness: &const shared Fixed) -> int: {
    let first_index = system.add_pinned(anchor);
    var previous = first_index;
    var index: int = 1;
    while index <= segment_count: {
        let position = make_vec2(anchor.x, anchor.y - segment_length * index);
        let current = system.add_particle(position, one_fixed());
        discard system.connect_at(previous, current, segment_length, stiffness);
        previous = current;
        index += 1;
    }
    return first_index;
}











static DEFAULT_TIMESTEP_RAW: int = 1092;




static MAX_STEPS_PER_UPDATE: int = 8;




static DEFAULT_SUBSTEPS: int = 4;


static GRAVITY_RAW: int = 642877;


static PROXY_MARGIN_RAW: int = 6553;



static SLEEP_LINEAR_RAW: int = 3276;
static SLEEP_ANGULAR_RAW: int = 1310;
static TIME_TO_SLEEP_RAW: int = 32768;


struct StepStatistics: {

    fn reset(self: &unique): {
        .broad_phase_pairs = 0;
        .narrow_phase_tests = 0;
        .manifold_count = 0;
        .contact_point_count = 0;
        .solver_iterations = 0;
        .awake_body_count = 0;
        .position_passes_used = 0;
    }

    
    
    fn average_points_per_manifold(self: &const shared) -> Fixed: {
        if .manifold_count == 0: {
            return zero_fixed();
        }
        return whole(.contact_point_count) / whole(.manifold_count);
    }

    broad_phase_pairs: int = 0;
    narrow_phase_tests: int = 0;
    manifold_count: int = 0;
    contact_point_count: int = 0;
    solver_iterations: int = 0;
    awake_body_count: int = 0;
    position_passes_used: int = 0;
}

struct World: {

    

    fn configure(self: &unique): {
        .gravity = make_vec2(zero_fixed(), -raw_fixed(GRAVITY_RAW));
        .timestep = raw_fixed(DEFAULT_TIMESTEP_RAW);
        .accumulator = zero_fixed();
        .substeps = DEFAULT_SUBSTEPS;
        .velocity_iterations = DEFAULT_VELOCITY_ITERATIONS;
        .position_iterations = DEFAULT_POSITION_ITERATIONS;
        .proxy_margin = raw_fixed(PROXY_MARGIN_RAW);
        .sleep_linear = raw_fixed(SLEEP_LINEAR_RAW);
        .sleep_angular = raw_fixed(SLEEP_ANGULAR_RAW);
        .time_to_sleep = raw_fixed(TIME_TO_SLEEP_RAW);
        .bounds = make_aabb(vec2_from_ints(-500, -500), vec2_from_ints(500, 500));
        .grid = make_spatial_hash(whole(4));
        .particles = make_particle_system();
        .step_index = 0;
    }

    fn add_body(self: &unique, body: RigidBody) -> int: {
        let index = .bodies.size();
        var stored = move(body);
        stored.identifier = index;
        stored.recompute_mass();
        .bodies.push_back(move(stored));
        return index;
    }

    fn add_distance_joint(self: &unique, joint: DistanceJoint) -> int: {
        let index = .distance_joints.size();
        .distance_joints.push_back(move(joint));
        return index;
    }

    fn add_revolute_joint(self: &unique, joint: RevoluteJoint) -> int: {
        let index = .revolute_joints.size();
        .revolute_joints.push_back(move(joint));
        return index;
    }

    fn body_count(self: &const shared) -> int: {
        return .bodies.size();
    }

    fn joint_count(self: &const shared) -> int: {
        return .distance_joints.size() + .revolute_joints.size();
    }

    

    fn run_broad_phase(self: &unique, dt: &const shared Fixed): {
        .grid.rebuild(.bodies, .proxy_margin, dt);
        .candidate_pairs.clear();
        .grid.collect_pairs(.bodies, .candidate_pairs);
        sort_pairs(.candidate_pairs);
        deduplicate_pairs(.candidate_pairs);
        .statistics.broad_phase_pairs = .candidate_pairs.size();
    }

    
    
    fn run_narrow_phase(self: &unique): {
        swap(.manifolds, .previous_manifolds);
        .manifolds.clear();
        var index: int = 0;
        while index < .candidate_pairs.size(): {
            let pair: &const shared = .candidate_pairs[index];
            let body_a: &const shared = .bodies[pair.low];
            let body_b: &const shared = .bodies[pair.high];
            var manifold = make_manifold(pair.low, pair.high);
            collide(manifold, body_a, body_b);
            if manifold.is_touching(): {
                
                
                
                var previous_index: int = 0;
                while previous_index < .previous_manifolds.size(): {
                    let old: &const shared = .previous_manifolds[previous_index];
                    if old.body_a == manifold.body_a && old.body_b == manifold.body_b: {
                        manifold.warm_start_from(old);
                        previous_index = .previous_manifolds.size();
                    } else: {
                        previous_index += 1;
                    }
                }
                .statistics.contact_point_count += manifold.points.size();
                .manifolds.push_back(move(manifold));
            } else: {
                discard manifold;
            }
            index += 1;
        }
        .statistics.manifold_count = .manifolds.size();
    }

    

    fn integrate_velocities(self: &unique, dt: &const shared Fixed): {
        var index: int = 0;
        while index < .bodies.size(): {
            let body: &unique = .bodies[index];
            if body.awake: {
                body.integrate_velocity(.gravity, dt);
            }
            index += 1;
        }
    }

    fn integrate_positions(self: &unique, dt: &const shared Fixed): {
        var index: int = 0;
        while index < .bodies.size(): {
            let body: &unique = .bodies[index];
            if body.awake: {
                body.integrate_position(dt);
            }
            index += 1;
        }
    }

    fn clear_forces(self: &unique): {
        var index: int = 0;
        while index < .bodies.size(): {
            .bodies[index].clear_forces();
            index += 1;
        }
    }

    fn update_sleeping(self: &unique, dt: &const shared Fixed): {
        var awake_count: int = 0;
        var index: int = 0;
        while index < .bodies.size(): {
            let body: &unique = .bodies[index];
            body.update_sleep(dt, .sleep_linear, .sleep_angular, .time_to_sleep);
            if body.awake: {
                awake_count += 1;
            }
            index += 1;
        }
        .statistics.awake_body_count = awake_count;
    }

    

    fn prepare_joints(self: &unique, dt: &const shared Fixed): {
        var index: int = 0;
        while index < .distance_joints.size(): {
            .distance_joints[index].prepare(.bodies, dt);
            .distance_joints[index].warm_start(.bodies);
            index += 1;
        }
        index = 0;
        while index < .revolute_joints.size(): {
            .revolute_joints[index].prepare(.bodies, dt);
            .revolute_joints[index].warm_start(.bodies);
            index += 1;
        }
    }

    fn solve_joint_velocities(self: &unique, dt: &const shared Fixed): {
        var index: int = 0;
        while index < .distance_joints.size(): {
            .distance_joints[index].solve_velocity(.bodies);
            index += 1;
        }
        index = 0;
        while index < .revolute_joints.size(): {
            .revolute_joints[index].solve_velocity(.bodies, dt);
            index += 1;
        }
    }

    fn solve_joint_positions(self: &unique) -> bool: {
        var settled: bool = true;
        var index: int = 0;
        while index < .distance_joints.size(): {
            if !.distance_joints[index].solve_position(.bodies): {
                settled = false;
            }
            index += 1;
        }
        index = 0;
        while index < .revolute_joints.size(): {
            if !.revolute_joints[index].solve_position(.bodies): {
                settled = false;
            }
            index += 1;
        }
        return settled;
    }

    
    
    
    
    
    
    
    fn substep(self: &unique, dt: &const shared Fixed): {
        .integrate_velocities(dt);
        .solver.prepare(.bodies, .manifolds, dt);
        .solver.warm_start(.bodies, .manifolds);
        .prepare_joints(dt);

        var iteration: int = 0;
        while iteration < .velocity_iterations: {
            .solve_joint_velocities(dt);
            .solver.solve_velocity_once(.bodies, .manifolds);
            iteration += 1;
        }
        .statistics.solver_iterations += .velocity_iterations;

        .integrate_positions(dt);

        var pass: int = 0;
        var settled: bool = false;
        while pass < .position_iterations && !settled: {
            let deepest = .solver.solve_position_once(.bodies, .manifolds);
            let joints_settled = .solve_joint_positions();
            if deepest >= -raw_fixed(PENETRATION_SLOP_RAW) * 3 && joints_settled: {
                settled = true;
            }
            pass += 1;
        }
        .statistics.position_passes_used += pass;
    }

    

    fn step(self: &unique): {
        .statistics.reset();
        let substep_dt = .timestep / .substeps;

        .run_broad_phase(.timestep);
        .run_narrow_phase();

        var index: int = 0;
        while index < .substeps: {
            .substep(substep_dt);
            index += 1;
        }

        .particles.step(.gravity, .timestep, .bounds);
        .particles.resolve_body_overlap(.bodies);

        .clear_forces();
        .update_sleeping(.timestep);
        .enforce_bounds();
        .step_index += 1;
    }

    
    
    
    
    
    
    
    fn update(self: &unique, elapsed: &const shared Fixed) -> int: {
        .accumulator = .accumulator + elapsed;
        var steps: int = 0;
        while .accumulator >= .timestep && steps < MAX_STEPS_PER_UPDATE: {
            .step();
            .accumulator = .accumulator - .timestep;
            steps += 1;
        }
        
        
        if .accumulator >= .timestep * MAX_STEPS_PER_UPDATE: {
            .accumulator = zero_fixed();
        }
        return steps;
    }

    
    
    fn interpolation_alpha(self: &const shared) -> Fixed: {
        if .timestep.raw == 0: {
            return zero_fixed();
        }
        return (.accumulator / .timestep).clamped(zero_fixed(), one_fixed());
    }

    

    
    
    fn enforce_bounds(self: &unique): {
        var index: int = 0;
        while index < .bodies.size(): {
            let body: &unique = .bodies[index];
            if !.bounds.contains_point(body.frame.position): {
                body.velocity = vec2_zero();
                body.angular_velocity = zero_fixed();
                body.awake = false;
                body.frame.position = .bounds.closest_point(body.frame.position);
                body.frame.refresh();
            }
            index += 1;
        }
    }

    

    
    
    fn query_point(self: &const shared, p: &const shared Vec2, out: &unique vector{int}): {
        var candidates: vector{int};
        .grid.query_point(p, candidates);
        var index: int = 0;
        while index < candidates.size(): {
            let body: &const shared = .bodies[candidates[index]];
            if body.shape.contains_point(body.frame, p): {
                out.push_back(candidates[index]);
            }
            index += 1;
        }
    }

    fn query_region(self: &const shared, region: &const shared AABB, out: &unique vector{int}): {
        var candidates: vector{int};
        .grid.query_box(region, candidates);
        var index: int = 0;
        while index < candidates.size(): {
            if .bodies[candidates[index]].bounds().overlaps(region): {
                out.push_back(candidates[index]);
            }
            index += 1;
        }
    }

    
    
    fn apply_radial_impulse(self: &unique, centre: &const shared Vec2,
                            radius: &const shared Fixed, strength: &const shared Fixed): {
        var candidates: vector{int};
        .grid.query_circle(centre, radius, candidates);
        var index: int = 0;
        while index < candidates.size(): {
            let body: &unique = .bodies[candidates[index]];
            let offset = body.world_centre() - centre;
            let distance = offset.length();
            if distance < radius && distance.raw > LINEAR_EPSILON_RAW: {
                let falloff = one_fixed() - distance / radius;
                let direction = offset / distance;
                body.wake();
                body.apply_impulse_at(direction * strength * falloff, body.world_centre());
            }
            index += 1;
        }
    }

    

    fn total_kinetic_energy(self: &const shared) -> Fixed: {
        var total = zero_fixed();
        var index: int = 0;
        while index < .bodies.size(): {
            total = total + .bodies[index].kinetic_energy();
            index += 1;
        }
        return total;
    }

    fn total_potential_energy(self: &const shared) -> Fixed: {
        var total = zero_fixed();
        var index: int = 0;
        while index < .bodies.size(): {
            total = total + .bodies[index].potential_energy(.gravity, .bounds.lower.y);
            index += 1;
        }
        return total;
    }

    fn total_energy(self: &const shared) -> Fixed: {
        return .total_kinetic_energy() + .total_potential_energy()
            + .particles.kinetic_energy(.timestep) + .particles.spring_energy();
    }

    fn total_linear_momentum(self: &const shared) -> Vec2: {
        var total = vec2_zero();
        var index: int = 0;
        while index < .bodies.size(): {
            total = total + .bodies[index].linear_momentum();
            index += 1;
        }
        return total;
    }

    fn total_angular_momentum(self: &const shared) -> Fixed: {
        var total = zero_fixed();
        let origin = vec2_zero();
        var index: int = 0;
        while index < .bodies.size(): {
            total = total + .bodies[index].angular_momentum_about(origin);
            index += 1;
        }
        return total;
    }

    fn total_mass(self: &const shared) -> Fixed: {
        var total = zero_fixed();
        var index: int = 0;
        while index < .bodies.size(): {
            total = total + .bodies[index].mass;
            index += 1;
        }
        return total;
    }

    fn centre_of_mass(self: &const shared) -> Vec2: {
        let mass = .total_mass();
        if mass.raw == 0: {
            return vec2_zero();
        }
        var weighted = vec2_zero();
        var index: int = 0;
        while index < .bodies.size(): {
            weighted = weighted + .bodies[index].world_centre() * .bodies[index].mass;
            index += 1;
        }
        return weighted / mass;
    }

    bodies: vector{RigidBody};
    distance_joints: vector{DistanceJoint};
    revolute_joints: vector{RevoluteJoint};
    manifolds: vector{Manifold};
    previous_manifolds: vector{Manifold};
    candidate_pairs: vector{BodyPair};
    grid: SpatialHash;
    solver: ContactSolver;
    particles: ParticleSystem;
    statistics: StepStatistics;

    gravity: Vec2;
    bounds: AABB;
    timestep: Fixed;
    accumulator: Fixed;
    proxy_margin: Fixed;
    sleep_linear: Fixed;
    sleep_angular: Fixed;
    time_to_sleep: Fixed;
    substeps: int = 4;
    velocity_iterations: int = 8;
    position_iterations: int = 3;
    step_index: int = 0;
}

fn make_world() -> World: {
    var result: World;
    result.configure();
    return result;
}







fn make_body(kind: BodyKind, shape: Shape, material: Material,
             position: &const shared Vec2, angle: &const shared Fixed) -> RigidBody: {
    var body: RigidBody;
    body.kind = kind;
    body.shape = move(shape);
    body.material = material + make_material(zero_fixed(), zero_fixed(), zero_fixed(), zero_fixed());
    body.frame = make_transform(position, angle);
    body.gravity_scale = one_fixed();
    body.linear_damping = ratio(1, 100);
    body.angular_damping = ratio(5, 100);
    body.max_linear_speed = whole(200);
    body.max_angular_speed = whole(60);
    body.recompute_mass();
    return body;
}



fn impl (a + b)(l: &const shared Material, r: &const shared Material) -> Material: {
    return make_material(l.density + r.density,
                         l.restitution + r.restitution,
                         l.static_friction + r.static_friction,
                         l.dynamic_friction + r.dynamic_friction);
}

fn spawn_circle(world: &unique World, position: &const shared Vec2,
                radius: &const shared Fixed, material: &const shared Material) -> int: {
    let shape = shape_from_circle(make_circle(vec2_zero(), radius));
    return world.add_body(make_body(BodyKind::Dynamic, shape, material, position, zero_fixed()));
}

fn spawn_box(world: &unique World, position: &const shared Vec2,
             half_width: &const shared Fixed, half_height: &const shared Fixed,
             angle: &const shared Fixed, material: &const shared Material) -> int: {
    let shape = shape_box(half_width, half_height);
    return world.add_body(make_body(BodyKind::Dynamic, shape, material, position, angle));
}

fn spawn_polygon(world: &unique World, position: &const shared Vec2, sides: int,
                 circumradius: &const shared Fixed, material: &const shared Material) -> int: {
    let shape = shape_from_polygon(make_regular_polygon(sides, circumradius));
    return world.add_body(make_body(BodyKind::Dynamic, shape, material, position, zero_fixed()));
}

fn spawn_static_box(world: &unique World, position: &const shared Vec2,
                    half_width: &const shared Fixed, half_height: &const shared Fixed,
                    angle: &const shared Fixed) -> int: {
    let shape = shape_box(half_width, half_height);
    let index = world.add_body(make_body(BodyKind::Static, shape, material_steel(), position, angle));
    let body: &unique = world.bodies[index];
    body.never_sleeps = true;
    body.freeze();
    return index;
}


fn build_container(world: &unique World, thickness: &const shared Fixed): {
    let extent = world.bounds.half_extents();
    let centre = world.bounds.centre();
    discard spawn_static_box(world,
                             make_vec2(centre.x, world.bounds.lower.y + thickness),
                             extent.x, thickness, zero_fixed());
    discard spawn_static_box(world,
                             make_vec2(world.bounds.lower.x + thickness, centre.y),
                             thickness, extent.y, zero_fixed());
    discard spawn_static_box(world,
                             make_vec2(world.bounds.upper.x - thickness, centre.y),
                             thickness, extent.y, zero_fixed());
}




fn build_pyramid(world: &unique World, apex: &const shared Vec2, rows: int,
                 half_size: &const shared Fixed): {
    let spacing = half_size * 2 + raw_fixed(PENETRATION_SLOP_RAW);
    var row: int = 0;
    while row < rows: {
        var column: int = 0;
        while column <= row: {
            let position = make_vec2(
                apex.x + spacing * column - spacing * row / 2,
                apex.y - spacing * row);
            discard spawn_box(world, position, half_size, half_size, zero_fixed(), material_wood());
            column += 1;
        }
        row += 1;
    }
}


fn build_chain(world: &unique World, anchor: &const shared Vec2, links: int,
               half_length: &const shared Fixed): {
    let anchor_index = spawn_static_box(world, anchor, half_length / 4, half_length / 4, zero_fixed());
    var previous = anchor_index;
    var index: int = 1;
    while index <= links: {
        let position = make_vec2(anchor.x + half_length * 2 * index, anchor.y);
        let current = spawn_box(world, position, half_length, half_length / 4,
                                zero_fixed(), material_wood());
        discard world.add_revolute_joint(make_revolute_joint(
            previous, current,
            make_vec2(half_length, zero_fixed()),
            make_vec2(-half_length, zero_fixed())));
        previous = current;
        index += 1;
    }
}



fn build_motorised_wheel(world: &unique World, centre: &const shared Vec2,
                         radius: &const shared Fixed, speed: &const shared Fixed) -> int: {
    let hub = spawn_static_box(world, centre, radius / 8, radius / 8, zero_fixed());
    let wheel = spawn_circle(world, centre, radius, material_rubber());
    discard world.add_revolute_joint(make_motorised_joint(
        hub, wheel, vec2_zero(), vec2_zero(), speed, whole(500)));
    return wheel;
}



fn build_articulated_figure(world: &unique World, origin: &const shared Vec2,
                            scale: &const shared Fixed) -> int: {
    let torso = spawn_box(world, origin, scale, scale * 2, zero_fixed(), material_wood());
    var limb: int = 0;
    while limb < 4: {
        let side = limb % 2;
        let level = limb / 2;
        var offset_x = -scale;
        if side == 1: {
            offset_x = scale;
        }
        let offset_y = scale - scale * 2 * level;
        let position = make_vec2(origin.x + offset_x * 2, origin.y + offset_y);
        let arm = spawn_box(world, position, scale, scale / 2, zero_fixed(), material_wood());
        var joint = make_revolute_joint(torso, arm,
                                        make_vec2(raw_fixed(offset_x.raw), raw_fixed(offset_y.raw)),
                                        make_vec2(-offset_x, zero_fixed()));
        joint.limit_enabled = true;
        joint.lower_limit = -raw_fixed(FIXED_QUARTER_PI_RAW);
        joint.upper_limit = raw_fixed(FIXED_QUARTER_PI_RAW);
        discard world.add_revolute_joint(move(joint));
        limb += 1;
    }
    return torso;
}



fn build_newtons_cradle(world: &unique World, anchor: &const shared Vec2,
                        count: int, radius: &const shared Fixed,
                        cord_length: &const shared Fixed): {
    var index: int = 0;
    while index < count: {
        let offset_x = radius * 2 * index - radius * count;
        let pivot = make_vec2(anchor.x + offset_x, anchor.y);
        let hub = spawn_static_box(world, pivot, radius / 8, radius / 8, zero_fixed());
        let ball = spawn_circle(world, make_vec2(pivot.x, pivot.y - cord_length),
                                radius, material_steel());
        let body: &unique = world.bodies[ball];
        body.material.restitution = one_fixed();
        body.linear_damping = zero_fixed();
        body.angular_damping = zero_fixed();
        body.never_sleeps = true;
        discard world.add_distance_joint(make_distance_joint(hub, ball, vec2_zero(),
                                                             vec2_zero(), cord_length));
        index += 1;
    }
}



fn build_demo_scene() -> World: {
    var world = make_world();
    world.bounds = make_aabb(vec2_from_ints(-100, -10), vec2_from_ints(100, 120));
    world.grid.configure(whole(4), DEFAULT_BUCKET_COUNT);

    build_container(world, whole(2));
    build_pyramid(world, make_vec2(zero_fixed(), whole(40)), 8, one_fixed());
    build_chain(world, vec2_from_ints(-60, 100), 10, whole(2));
    discard build_motorised_wheel(world, vec2_from_ints(50, 30), whole(6), whole(3));
    build_newtons_cradle(world, vec2_from_ints(0, 110), 5, one_fixed(), whole(20));
    discard build_articulated_figure(world, vec2_from_ints(20, 60), one_fixed());

    build_cloth(world.particles, vec2_from_ints(-40, 110), 12, 10, one_fixed(), ratio(8, 10));
    discard build_rope(world.particles, vec2_from_ints(70, 110), 20, one_fixed(), ratio(9, 10));

    return world;
}



fn build_pair_scene() -> World: {
    var world = make_world();
    world.bounds = make_aabb(vec2_from_ints(-50, -5), vec2_from_ints(50, 50));
    discard spawn_static_box(world, vec2_from_ints(0, 0), whole(40), one_fixed(), zero_fixed());
    discard spawn_circle(world, vec2_from_ints(0, 20), one_fixed(), material_rubber());
    discard spawn_box(world, vec2_from_ints(10, 20), one_fixed(), one_fixed(),
                      zero_fixed(), material_wood());
    return world;
}






















static ENERGY_TOLERANCE_RAW: int = 1310;


static MOMENTUM_TOLERANCE_RAW: int = 655;





fn check_fixed_invariants(): {
    let one = one_fixed();
    let two = whole(2);
    let half = half_fixed();

    
    assert FIXED_ONE == 65536;
    assert FIXED_HALF * 2 == FIXED_ONE;
    assert FIXED_FRACTION_MASK + 1 == FIXED_ONE;
    prove one.raw == FIXED_ONE;

    
    prove (one * one).raw == FIXED_ONE;
    prove (two * half).raw == FIXED_ONE;
    assert one * two == two;

    
    prove (-(-one)).raw == one.raw;
    assert (-one) + one == zero_fixed();

    
    prove half < one;
    prove one <= one;
    prove two > one;
    prove one != two;

    
    
    let inverse_two = two.reciprocal();
    assert (inverse_two - half).magnitude() <= raw_fixed(4);
    assert (two * inverse_two - one).magnitude() <= raw_fixed(8);

    
    let four = whole(4);
    assert (four.square_root() - two).magnitude() <= raw_fixed(4);
    assert (whole(9).square_root() - whole(3)).magnitude() <= raw_fixed(4);
    prove whole(0).square_root().raw == 0;

    
    let awkward = ratio(1, 3);
    assert (awkward * whole(3) - one).magnitude() < one;
    assert awkward.floor_int() == 0;
    assert (-awkward).floor_int() == -1;
    assert (-awkward).ceil_int() == 0;
}



fn check_trigonometry(): {
    let one = one_fixed();
    
    let tolerance = raw_fixed(655);

    prove fixed_sin(zero_fixed()).magnitude() <= tolerance;
    assert (fixed_cos(zero_fixed()) - one).magnitude() <= tolerance;
    assert (fixed_sin(raw_fixed(FIXED_HALF_PI_RAW)) - one).magnitude() <= tolerance;
    assert fixed_cos(raw_fixed(FIXED_HALF_PI_RAW)).magnitude() <= tolerance;

    var step: int = 0;
    while step < 16: {
        let angle = tau_fixed() * step / 16;
        let s = fixed_sin(angle);
        let c = fixed_cos(angle);
        
        assert (s * s + c * c - one).magnitude() <= tolerance * 4;
        
        let rotation = mat2_rotation(angle);
        assert (rotation.determinant() - one).magnitude() <= tolerance * 4;
        
        let rotated = rotation * vec2_unit_x();
        assert (rotated.length() - one).magnitude() <= tolerance * 4;
        step += 1;
    }
}



fn check_vector_algebra(): {
    let a = vec2_from_ints(3, 4);
    let b = vec2_from_ints(-2, 5);
    let tolerance = raw_fixed(655);

    
    assert (a.length() - whole(5)).magnitude() <= tolerance;
    prove a.length_squared().raw == whole(25).raw;

    
    prove a.dot(b).raw == b.dot(a).raw;
    prove a.cross(b).raw == -b.cross(a).raw;
    assert a.cross(a) == zero_fixed();

    
    prove a.dot(a.perpendicular()).raw == 0;
    assert a.perpendicular().perpendicular() == -a;

    
    assert a + b == b + a;
    assert a + (-a) == vec2_zero();
    assert (a - b) + b == a;

    
    let s = whole(3);
    assert (a + b) * s == a * s + b * s;

    
    
    let unit = a.normalised();
    assert (unit.length() - one_fixed()).magnitude() <= tolerance;
    assert (unit.normalised() - unit).manhattan_length() <= tolerance;

    
    let product = a % b;
    prove product.x.raw == (a.x * b.x).raw;
    prove product.y.raw == (a.y * b.y).raw;
}

fn check_matrix_algebra(): {
    let tolerance = raw_fixed(655);
    let identity = mat2_identity();
    let rotation = mat2_rotation(raw_fixed(FIXED_QUARTER_PI_RAW));
    let v = vec2_from_ints(2, -7);

    prove identity.is_identity();
    assert identity * v == v;
    assert identity * identity == identity;

    
    let round_trip = rotation.transposed() * (rotation * v);
    assert (round_trip - v).manhattan_length() <= tolerance * 4;

    
    let inverse = rotation.inverted();
    let recovered = inverse * (rotation * v);
    assert (recovered - v).manhattan_length() <= tolerance * 8;

    
    let solved = rotation.solve(v);
    let by_inverse = inverse * v;
    assert (solved - by_inverse).manhattan_length() <= tolerance * 8;

    
    assert rotation + (-rotation) == mat2_zero();
    assert (rotation - rotation) == mat2_zero();

    
    
    let other = mat2_rotation(raw_fixed(FIXED_HALF_PI_RAW));
    let left = (rotation * other) * rotation;
    let right = rotation * (other * rotation);
    assert (left.col_x - right.col_x).manhattan_length() <= tolerance * 8;
    assert (left.col_y - right.col_y).manhattan_length() <= tolerance * 8;
}



fn check_shape_properties(): {
    let tolerance = raw_fixed(6553);
    let box_shape = make_box_polygon(whole(2), whole(3));

    
    assert (box_shape.area() - whole(24)).magnitude() <= tolerance;
    assert box_shape.centroid().manhattan_length() <= tolerance;
    prove box_shape.is_convex();
    prove box_shape.vertices.size() == 4;
    prove box_shape.normals.size() == 4;

    
    var index: int = 0;
    while index < box_shape.normals.size(): {
        let normal = box_shape.normals[index];
        assert (normal.length() - one_fixed()).magnitude() <= raw_fixed(655);
        let midpoint = (box_shape.vertex(index) + box_shape.vertex(index + 1)) / 2;
        assert normal.dot(midpoint) > zero_fixed();
        index += 1;
    }

    
    let ngon = make_regular_polygon(12, whole(5));
    prove ngon.is_convex();
    assert ngon.area() < pi_fixed() * whole(25);
    assert ngon.area() > pi_fixed() * whole(20);

    
    let disc = make_circle(vec2_zero(), whole(2));
    let disc_inertia = disc.inertia_for_mass(whole(10));
    assert (disc_inertia - whole(20)).magnitude() <= whole(1);
}

fn check_bounds_algebra(): {
    let a = make_aabb(vec2_from_ints(0, 0), vec2_from_ints(10, 10));
    let b = make_aabb(vec2_from_ints(5, 5), vec2_from_ints(15, 15));
    let far = make_aabb(vec2_from_ints(100, 100), vec2_from_ints(110, 110));

    prove a.overlaps(b);
    prove b.overlaps(a);
    prove !a.overlaps(far);
    prove a.contains_point(vec2_from_ints(5, 5));
    prove !a.contains_point(vec2_from_ints(11, 5));

    
    
    let merged = a + b;
    prove merged.contains_box(a);
    prove merged.contains_box(b);
    let overlap = a * b;
    prove a.contains_box(overlap);
    prove b.contains_box(overlap);

    
    let offset = vec2_from_ints(3, -4);
    assert a.expanded(one_fixed()).translated(offset) == a.translated(offset).expanded(one_fixed());

    
    assert a.expanded(one_fixed()).area() > a.area();
}






fn check_broad_phase(world: &unique World): {
    world.run_broad_phase(world.timestep);

    var index: int = 0;
    while index < world.candidate_pairs.size(): {
        let pair: &const shared = world.candidate_pairs[index];
        assert pair.low < pair.high;
        assert pair.low >= 0;
        assert pair.high < world.bodies.size();
        
        let box_a = world.bodies[pair.low].proxy_bounds(world.proxy_margin, world.timestep);
        let box_b = world.bodies[pair.high].proxy_bounds(world.proxy_margin, world.timestep);
        assert box_a.overlaps(box_b);
        
        
        if index > 0: {
            assert world.candidate_pairs[index - 1] < pair;
        }
        index += 1;
    }

    
    
    var first: int = 0;
    var missed: int = 0;
    while first < world.bodies.size(): {
        var second = first + 1;
        while second < world.bodies.size(): {
            let a: &const shared = world.bodies[first];
            let b: &const shared = world.bodies[second];
            if should_collide(a, b) && a.bounds().overlaps(b.bounds()): {
                let wanted = make_pair(first, second);
                var found: bool = false;
                var scan: int = 0;
                while scan < world.candidate_pairs.size(): {
                    if world.candidate_pairs[scan] == wanted: {
                        found = true;
                    }
                    scan += 1;
                }
                if !found: {
                    missed += 1;
                }
            }
            second += 1;
        }
        first += 1;
    }
    assert missed == 0;
}



fn check_manifold_shape(manifold: &const shared Manifold): {
    
    assert (manifold.normal.length() - one_fixed()).magnitude() <= raw_fixed(655);
    
    assert manifold.points.size() <= MAX_MANIFOLD_POINTS;
    var index: int = 0;
    while index < manifold.points.size(): {
        let point: &const shared = manifold.points[index];
        assert point.separation <= raw_fixed(PENETRATION_SLOP_RAW);
        
        
        prove point.normal_impulse >= zero_fixed();
        
        assert point.tangent_impulse.magnitude()
            <= manifold.friction * point.normal_impulse + raw_fixed(655);
        index += 1;
    }
}



fn check_circle_circle(): {
    let tolerance = raw_fixed(655);
    var manifold = make_manifold(0, 1);
    let circle = make_circle(vec2_zero(), one_fixed());
    let frame_a = make_transform(vec2_from_ints(0, 0), zero_fixed());
    let frame_b = make_transform(vec2_from_ints(1, 0), zero_fixed());
    collide_circle_circle(manifold, circle, frame_a, circle, frame_b);

    assert manifold.state == ContactState::Penetrating;
    assert manifold.points.size() == 1;
    assert (manifold.normal.x - one_fixed()).magnitude() <= tolerance;
    assert manifold.normal.y.magnitude() <= tolerance;
    assert (manifold.points[0].separation + one_fixed()).magnitude() <= tolerance;
    check_manifold_shape(manifold);

    
    let far_frame = make_transform(vec2_from_ints(10, 0), zero_fixed());
    collide_circle_circle(manifold, circle, frame_a, circle, far_frame);
    assert manifold.state == ContactState::Separated;
    prove manifold.points.size() == 0;
}



fn check_polygon_polygon(): {
    let tolerance = raw_fixed(1310);
    var manifold = make_manifold(0, 1);
    let box_shape = make_box_polygon(whole(2), whole(2));
    let lower = make_transform(vec2_from_ints(0, 0), zero_fixed());
    let upper = make_transform(vec2_from_ints(0, 3), zero_fixed());
    collide_polygon_polygon(manifold, box_shape, lower, box_shape, upper);

    assert manifold.state == ContactState::Penetrating;
    assert manifold.points.size() == 2;
    assert manifold.normal.x.magnitude() <= tolerance;
    assert (manifold.normal.y.magnitude() - one_fixed()).magnitude() <= tolerance;
    check_manifold_shape(manifold);

    
    let depth_difference = manifold.points[0].separation - manifold.points[1].separation;
    assert depth_difference.magnitude() <= tolerance;

    
    let distant = make_transform(vec2_from_ints(0, 40), zero_fixed());
    collide_polygon_polygon(manifold, box_shape, lower, box_shape, distant);
    assert manifold.state == ContactState::Separated;
}



fn check_circle_polygon(): {
    let tolerance = raw_fixed(1310);
    var manifold = make_manifold(0, 1);
    let circle = make_circle(vec2_zero(), one_fixed());
    let box_shape = make_box_polygon(whole(5), whole(1));
    let circle_frame = make_transform(vec2_from_ints(0, 2), zero_fixed());
    let box_frame = make_transform(vec2_from_ints(0, 0), zero_fixed());
    collide_circle_polygon(manifold, circle, circle_frame, box_shape, box_frame, false);

    assert manifold.state == ContactState::Penetrating;
    assert manifold.points.size() == 1;
    assert manifold.normal.x.magnitude() <= tolerance;
    assert manifold.normal.y > zero_fixed();
    check_manifold_shape(manifold);
}






fn check_contacts_are_separating(world: &const shared World): {
    let tolerance = raw_fixed(1310);
    var index: int = 0;
    while index < world.manifolds.size(): {
        let manifold: &const shared = world.manifolds[index];
        let body_a: &const shared = world.bodies[manifold.body_a];
        let body_b: &const shared = world.bodies[manifold.body_b];
        var point_index: int = 0;
        while point_index < manifold.points.size(): {
            let point: &const shared = manifold.points[point_index];
            let velocity_a = body_a.velocity_at(point.position);
            let velocity_b = body_b.velocity_at(point.position);
            
            
            
            let closing = manifold.normal.x * (velocity_b.x - velocity_a.x)
                + manifold.normal.y * (velocity_b.y - velocity_a.y);
            assert closing >= -tolerance - point.velocity_bias;
            point_index += 1;
        }
        index += 1;
    }
}





fn check_momentum_conservation(): {
    let tolerance = raw_fixed(MOMENTUM_TOLERANCE_RAW);
    var world = make_world();
    world.gravity = vec2_zero();
    world.bounds = make_aabb(vec2_from_ints(-200, -200), vec2_from_ints(200, 200));

    let left = spawn_circle(world, vec2_from_ints(-10, 0), one_fixed(), material_steel());
    let right = spawn_circle(world, vec2_from_ints(10, 0), one_fixed(), material_steel());
    world.bodies[left].set_velocity(vec2_from_ints(5, 0));
    world.bodies[right].set_velocity(vec2_from_ints(-5, 0));
    world.bodies[left].never_sleeps = true;
    world.bodies[right].never_sleeps = true;

    let initial_momentum = world.total_linear_momentum();
    let initial_angular = world.total_angular_momentum();

    var step: int = 0;
    while step < 120: {
        world.step();
        let momentum = world.total_linear_momentum();
        
        assert (momentum.x - initial_momentum.x).magnitude() <= tolerance * (step + 1);
        assert (momentum.y - initial_momentum.y).magnitude() <= tolerance * (step + 1);
        step += 1;
    }

    let final_angular = world.total_angular_momentum();
    assert (final_angular - initial_angular).magnitude() <= tolerance * 120;
    destroy world;
}




fn check_energy_conservation(): {
    var world = make_world();
    world.bounds = make_aabb(vec2_from_ints(-60, -5), vec2_from_ints(60, 80));
    build_container(world, one_fixed());

    let ball = spawn_circle(world, vec2_from_ints(0, 40), one_fixed(), material_rubber());
    let body: &unique = world.bodies[ball];
    body.material.restitution = one_fixed();
    body.linear_damping = zero_fixed();
    body.angular_damping = zero_fixed();
    body.never_sleeps = true;

    let initial_energy = world.total_energy();
    var peak_energy = initial_energy + zero_fixed();
    var minimum_energy = initial_energy + zero_fixed();

    var step: int = 0;
    while step < 240: {
        let before = world.total_energy();
        world.step();
        let after = world.total_energy();

        
        
        
        let allowed = before.magnitude() * raw_fixed(ENERGY_TOLERANCE_RAW) + one_fixed();
        assert after <= before + allowed;

        peak_energy = fixed_max(peak_energy, after);
        minimum_energy = fixed_min(minimum_energy, after);
        check_contacts_are_separating(world);
        step += 1;
    }

    
    
    let cumulative_allowance = initial_energy.magnitude()
        * raw_fixed(ENERGY_TOLERANCE_RAW) * 8 + whole(10);
    assert peak_energy <= initial_energy + cumulative_allowance;
    assert minimum_energy >= zero_fixed();
    prove peak_energy >= minimum_energy;
    destroy world;
}



fn check_energy_dissipation(): {
    var world = build_pair_scene();
    let initial_energy = world.total_energy();
    var step: int = 0;
    while step < 300: {
        world.step();
        step += 1;
    }
    let final_energy = world.total_energy();

    
    
    let allowance = initial_energy.magnitude() * raw_fixed(ENERGY_TOLERANCE_RAW) + whole(1);
    assert final_energy <= initial_energy + allowance;

    
    var index: int = 0;
    while index < world.bodies.size(): {
        let body: &const shared = world.bodies[index];
        if body.kind == BodyKind::Dynamic: {
            assert !body.awake || body.velocity.length_squared() <= one_fixed();
        }
        index += 1;
    }
    destroy world;
}





fn check_particle_integration(): {
    let tolerance = raw_fixed(655);
    let dt = raw_fixed(DEFAULT_TIMESTEP_RAW);
    var system = make_particle_system();
    system.damping = one_fixed();

    let index = system.add_particle(vec2_from_ints(0, 0), one_fixed());
    system.particles[index].set_velocity(vec2_from_ints(10, 0), dt);
    let initial_speed = system.particles[index].velocity(dt).length();

    var step: int = 0;
    while step < 60: {
        system.integrate(vec2_zero(), dt);
        let speed = system.particles[index].velocity(dt).length();
        assert (speed - initial_speed).magnitude() <= tolerance * 4;
        
        assert system.particles[index].position.y.magnitude() <= tolerance;
        step += 1;
    }

    
    assert (system.particles[index].position.x - whole(10)).magnitude() <= one_fixed();
    destroy system;
}

fn check_spring_relaxation(): {
    let tolerance = raw_fixed(6553);
    var system = make_particle_system();
    system.relaxation_passes = 16;

    let anchor = system.add_pinned(vec2_from_ints(0, 0));
    let free = system.add_particle(vec2_from_ints(10, 0), one_fixed());
    let spring = system.connect_at(anchor, free, whole(5), one_fixed());

    
    let start = system.particles[anchor].position + vec2_zero();
    system.relax_springs();
    assert system.particles[anchor].position == start;

    
    let length = system.springs[spring].current_length(system.particles);
    assert (length - whole(5)).magnitude() <= tolerance;
    assert system.springs[spring].strain(system.particles).magnitude() <= tolerance;
    prove !system.springs[spring].broken;
    destroy system;
}



fn check_cloth_stability(): {
    var system = make_particle_system();
    let bounds = make_aabb(vec2_from_ints(-100, -100), vec2_from_ints(100, 100));
    build_cloth(system, vec2_from_ints(-10, 50), 8, 8, one_fixed(), ratio(9, 10));
    let gravity = make_vec2(zero_fixed(), -raw_fixed(GRAVITY_RAW));
    let dt = raw_fixed(DEFAULT_TIMESTEP_RAW);

    var step: int = 0;
    while step < 180: {
        system.step(gravity, dt, bounds);
        step += 1;
    }

    assert system.broken_spring_count() == 0;
    var index: int = 0;
    while index < system.particles.size(): {
        let particle: &const shared = system.particles[index];
        assert bounds.contains_point(particle.position);
        
        
        assert particle.velocity(dt).length_squared() <= whole(10000);
        index += 1;
    }

    
    prove system.particles[0].pinned;
    destroy system;
}





fn check_distance_joint(): {
    let tolerance = raw_fixed(6553);
    var world = make_world();
    world.bounds = make_aabb(vec2_from_ints(-100, -100), vec2_from_ints(100, 100));

    let anchor = spawn_static_box(world, vec2_from_ints(0, 50), one_fixed(), one_fixed(), zero_fixed());
    let bob = spawn_circle(world, vec2_from_ints(10, 50), one_fixed(), material_steel());
    world.bodies[bob].never_sleeps = true;
    let joint = world.add_distance_joint(
        make_distance_joint(anchor, bob, vec2_zero(), vec2_zero(), whole(10)));

    var step: int = 0;
    while step < 240: {
        world.step();
        let length = (world.bodies[bob].world_centre()
                      - world.bodies[anchor].world_centre()).length();
        assert (length - whole(10)).magnitude() <= tolerance * 4;
        assert world.distance_joints[joint].status != JointStatus::Broken;
        step += 1;
    }

    
    
    let ratio_now = world.distance_joints[joint].stretch_ratio();
    assert (ratio_now - one_fixed()).magnitude() <= tolerance;
    destroy world;
}


fn check_revolute_joint(): {
    let tolerance = raw_fixed(6553);
    var world = make_world();
    world.bounds = make_aabb(vec2_from_ints(-100, -100), vec2_from_ints(100, 100));
    build_chain(world, vec2_from_ints(0, 60), 6, one_fixed());

    var step: int = 0;
    while step < 180: {
        world.step();
        step += 1;
    }

    var index: int = 0;
    while index < world.revolute_joints.size(): {
        let joint: &const shared = world.revolute_joints[index];
        let world_a = world.bodies[joint.body_a].to_world(joint.local_anchor_a);
        let world_b = world.bodies[joint.body_b].to_world(joint.local_anchor_b);
        
        assert (world_b - world_a).manhattan_length() <= tolerance * 8;
        index += 1;
    }
    destroy world;
}






fn check_determinism(): {
    var first = build_pair_scene();
    var second = build_pair_scene();

    var step: int = 0;
    while step < 120: {
        first.step();
        second.step();
        step += 1;
    }

    assert first.bodies.size() == second.bodies.size();
    var index: int = 0;
    while index < first.bodies.size(): {
        let a: &const shared = first.bodies[index];
        let b: &const shared = second.bodies[index];
        
        prove a.frame.position.x.raw == b.frame.position.x.raw;
        prove a.frame.position.y.raw == b.frame.position.y.raw;
        prove a.frame.angle.raw == b.frame.angle.raw;
        prove a.velocity.x.raw == b.velocity.x.raw;
        prove a.velocity.y.raw == b.velocity.y.raw;
        prove a.angular_velocity.raw == b.angular_velocity.raw;
        index += 1;
    }
    assert first.step_index == second.step_index;
    destroy first;
    destroy second;
}





fn check_fixed_timestep(): {
    var world = make_world();
    let dt = world.timestep + zero_fixed();

    
    let one_step = world.update(dt);
    assert one_step == 1;
    assert world.accumulator < dt;

    
    let no_steps = world.update(dt / 2);
    assert no_steps == 0;
    assert world.accumulator >= zero_fixed();
    assert world.accumulator < dt;

    
    let three_steps = world.update(dt * 3);
    assert three_steps == 3;
    prove world.accumulator < dt;

    
    let capped = world.update(dt * 1000);
    assert capped <= MAX_STEPS_PER_UPDATE;
    assert world.interpolation_alpha() <= one_fixed();
    assert world.interpolation_alpha() >= zero_fixed();
    destroy world;
}






fn run_all_checks(): {
    check_fixed_invariants();
    check_trigonometry();
    check_vector_algebra();
    check_matrix_algebra();
    check_shape_properties();
    check_bounds_algebra();

    check_circle_circle();
    check_circle_polygon();
    check_polygon_polygon();

    var scene = build_demo_scene();
    check_broad_phase(scene);
    destroy scene;

    check_momentum_conservation();
    check_energy_conservation();
    check_energy_dissipation();

    check_particle_integration();
    check_spring_relaxation();
    check_cloth_stability();

    check_distance_joint();
    check_revolute_joint();

    check_determinism();
    check_fixed_timestep();

    println("particle_sim: all checks passed");
    println(to_string(fixed_multiply_count));
    println(to_string(narrow_phase_test_count));
    println(to_string(solver_iteration_count));
}



fn run_demo(step_count: int) -> int: {
    var world = build_demo_scene();
    var step: int = 0;
    while step < step_count: {
        world.step();
        if step % 60 == 0: {
            
            world.apply_radial_impulse(vec2_from_ints(0, 20), whole(15), whole(40));
        }
        step += 1;
    }
    let total = world.statistics.broad_phase_pairs
        + world.statistics.narrow_phase_tests
        + world.statistics.manifold_count;
    destroy world;
    return total;
}

}

















namespace red_black_tree: {



enum Colour: {
    Red;
    Black = 1;
}

enum ChildSide: {
    LeftChild;
    RightChild;
    NoChild = 2;
}


enum FindOutcome: {
    FoundExact;
    FoundPredecessor;
    FoundSuccessor;
    NotFound = 3;
}



static RB_NIL: int = -1;



static RB_MAX_HEIGHT: int = 96;


static RB_INITIAL_CAPACITY: int = 32;


static RB_GROWTH_PERCENT: int = 200;



template(K: type, V: type)
struct RbNode: {

    fn has_left(self: &const shared) -> bool: {
        return .left != RB_NIL;
    }

    fn has_right(self: &const shared) -> bool: {
        return .right != RB_NIL;
    }

    fn is_leaf(self: &const shared) -> bool: {
        return .left == RB_NIL && .right == RB_NIL;
    }

    fn child_count(self: &const shared) -> int: {
        var n: int = 0;
        if .left != RB_NIL: {
            n += 1;
        }
        if .right != RB_NIL: {
            n += 1;
        }
        return n;
    }

    fn reset_links(self: &unique): {
        .left = RB_NIL;
        .right = RB_NIL;
        .parent = RB_NIL;
    }

    key: K;
    value: V;
    left: int = -1;
    right: int = -1;
    parent: int = -1;
    colour: Colour = Colour::Red;
    live: bool = true;
}



template(K: type, V: type)
struct RedBlackTree: {

    

    fn size(self: &const shared) -> int: {
        return .count;
    }

    fn empty(self: &const shared) -> bool: {
        return .count == 0;
    }

    fn arena_size(self: &const shared) -> int: {
        return .nodes.size();
    }

    fn is_nil(self: &const shared, i: int) -> bool: {
        return i == RB_NIL;
    }

    fn alive(self: &const shared, i: int) -> bool: {
        if i == RB_NIL: {
            return false;
        }
        return .nodes[i].live;
    }

    
    
    
    

    fn colour_of(self: &const shared, i: int) -> Colour: {
        if i == RB_NIL: {
            return Colour::Black;
        }
        return .nodes[i].colour;
    }

    fn is_red(self: &const shared, i: int) -> bool: {
        if i == RB_NIL: {
            return false;
        }
        return .nodes[i].colour == Colour::Red;
    }

    fn is_black(self: &const shared, i: int) -> bool: {
        if i == RB_NIL: {
            return true;
        }
        return .nodes[i].colour == Colour::Black;
    }

    fn set_colour(self: &unique, i: int, c: Colour): {
        if i != RB_NIL: {
            .nodes[i].colour = c;
        }
    }

    fn paint_red(self: &unique, i: int): {
        .set_colour(i, Colour::Red);
    }

    fn paint_black(self: &unique, i: int): {
        .set_colour(i, Colour::Black);
    }

    fn swap_colours(self: &unique, a: int, b: int): {
        if a != RB_NIL && b != RB_NIL: {
            swap(.nodes[a].colour, .nodes[b].colour);
        }
    }

    

    fn left_of(self: &const shared, i: int) -> int: {
        if i == RB_NIL: {
            return RB_NIL;
        }
        return .nodes[i].left;
    }

    fn right_of(self: &const shared, i: int) -> int: {
        if i == RB_NIL: {
            return RB_NIL;
        }
        return .nodes[i].right;
    }

    fn parent_of(self: &const shared, i: int) -> int: {
        if i == RB_NIL: {
            return RB_NIL;
        }
        return .nodes[i].parent;
    }

    fn grandparent_of(self: &const shared, i: int) -> int: {
        return .parent_of(.parent_of(i));
    }

    
    fn side_of(self: &const shared, i: int) -> ChildSide: {
        let p = .parent_of(i);
        if p == RB_NIL: {
            return ChildSide::NoChild;
        } else: {
            if .nodes[p].left == i: {
                return ChildSide::LeftChild;
            } else: {
                return ChildSide::RightChild;
            }
        }
    }

    fn sibling_of(self: &const shared, i: int) -> int: {
        let p = .parent_of(i);
        if p == RB_NIL: {
            return RB_NIL;
        } else: {
            if .nodes[p].left == i: {
                return .nodes[p].right;
            } else: {
                return .nodes[p].left;
            }
        }
    }

    fn uncle_of(self: &const shared, i: int) -> int: {
        return .sibling_of(.parent_of(i));
    }

    fn is_left_child(self: &const shared, i: int) -> bool: {
        return .side_of(i) == ChildSide::LeftChild;
    }

    fn is_right_child(self: &const shared, i: int) -> bool: {
        return .side_of(i) == ChildSide::RightChild;
    }

    
    fn attach(self: &unique, parent: int, child: int, side: ChildSide): {
        if parent == RB_NIL: {
            .root = child;
        } else: {
            if side == ChildSide::LeftChild: {
                .nodes[parent].left = child;
            } else: {
                .nodes[parent].right = child;
            }
        }
        if child != RB_NIL: {
            .nodes[child].parent = parent;
        }
    }

    
    
    
    
    
    
    

    fn rotate_left(self: &unique, x: int): {
        if x == RB_NIL: {
            return;
        }
        let y = .nodes[x].right;
        if y == RB_NIL: {
            
            return;
        }
        .nodes[x].right = .nodes[y].left;
        if .nodes[y].left != RB_NIL: {
            .nodes[.nodes[y].left].parent = x;
        }
        .nodes[y].parent = .nodes[x].parent;
        if .nodes[x].parent == RB_NIL: {
            .root = y;
        } else: {
            if x == .nodes[.nodes[x].parent].left: {
                .nodes[.nodes[x].parent].left = y;
            } else: {
                .nodes[.nodes[x].parent].right = y;
            }
        }
        .nodes[y].left = x;
        .nodes[x].parent = y;
        .rotations += 1;
    }

    
    
    
    
    

    fn rotate_right(self: &unique, y: int): {
        if y == RB_NIL: {
            return;
        }
        let x = .nodes[y].left;
        if x == RB_NIL: {
            return;
        }
        .nodes[y].left = .nodes[x].right;
        if .nodes[x].right != RB_NIL: {
            .nodes[.nodes[x].right].parent = y;
        }
        .nodes[x].parent = .nodes[y].parent;
        if .nodes[y].parent == RB_NIL: {
            .root = x;
        } else: {
            if y == .nodes[.nodes[y].parent].right: {
                .nodes[.nodes[y].parent].right = x;
            } else: {
                .nodes[.nodes[y].parent].left = x;
            }
        }
        .nodes[x].right = y;
        .nodes[y].parent = x;
        .rotations += 1;
    }

    
    fn rotate_towards(self: &unique, i: int, side: ChildSide): {
        if side == ChildSide::LeftChild: {
            .rotate_right(i);
        } else: {
            if side == ChildSide::RightChild: {
                .rotate_left(i);
            } else: {
                discard i;
            }
        }
    }

    

    fn reserve(self: &unique, capacity: int): {
        if capacity > .nodes.size(): {
            .nodes.reserve(capacity);
        }
    }

    fn allocate(self: &unique, key: K, value: V) -> int: {
        if .free_list != RB_NIL: {
            
            let slot = .free_list;
            .free_list = .nodes[slot].right;
            .nodes[slot].key = key;
            .nodes[slot].value = value;
            .nodes[slot].reset_links();
            .nodes[slot].colour = Colour::Red;
            .nodes[slot].live = true;
            return slot;
        }
        var fresh = RbNode{K, V}(key: key, value: value);
        fresh.colour = Colour::Red;
        .nodes.push_back(fresh);
        return .nodes.size() - 1;
    }

    fn release(self: &unique, i: int): {
        if i == RB_NIL: {
            return;
        }
        .nodes[i].live = false;
        .nodes[i].left = RB_NIL;
        .nodes[i].parent = RB_NIL;
        .nodes[i].right = .free_list;
        .free_list = i;
    }

    

    fn find_index(self: &const shared, key: &const K) -> int: {
        var current = .root;
        while current != RB_NIL: {
            let order = compare_keys(.nodes[current].key, *key);
            if order == 0: {
                return current;
            } else: {
                if order > 0: {
                    current = .nodes[current].left;
                } else: {
                    current = .nodes[current].right;
                }
            }
        }
        return RB_NIL;
    }

    fn contains(self: &const shared, key: &const K) -> bool: {
        return .find_index(key) != RB_NIL;
    }

    fn at(self: &shared, key: &const K) -> &shared[self] V: {
        let i = .find_index(key);
        if i == RB_NIL: {
            return .missing;
        }
        return .nodes[i].value;
    }

    
    fn lower_bound(self: &const shared, key: &const K) -> int: {
        var current = .root;
        var best = RB_NIL;
        while current != RB_NIL: {
            let order = compare_keys(.nodes[current].key, *key);
            if order < 0: {
                current = .nodes[current].right;
            } else: {
                best = current;
                if order == 0: {
                    
                    
                    return current;
                } else: {
                    current = .nodes[current].left;
                }
            }
        }
        return best;
    }

    
    fn upper_bound(self: &const shared, key: &const K) -> int: {
        var current = .root;
        var best = RB_NIL;
        while current != RB_NIL: {
            let order = compare_keys(.nodes[current].key, *key);
            if order > 0: {
                best = current;
                current = .nodes[current].left;
            } else: {
                current = .nodes[current].right;
            }
        }
        return best;
    }

    

    fn subtree_minimum(self: &const shared, start: int) -> int: {
        var current = start;
        if current == RB_NIL: {
            return RB_NIL;
        }
        while .nodes[current].left != RB_NIL: {
            current = .nodes[current].left;
        }
        return current;
    }

    fn subtree_maximum(self: &const shared, start: int) -> int: {
        var current = start;
        if current == RB_NIL: {
            return RB_NIL;
        }
        while .nodes[current].right != RB_NIL: {
            current = .nodes[current].right;
        }
        return current;
    }

    fn minimum(self: &const shared) -> int: {
        return .subtree_minimum(.root);
    }

    fn maximum(self: &const shared) -> int: {
        return .subtree_maximum(.root);
    }

    fn successor(self: &const shared, i: int) -> int: {
        if i == RB_NIL: {
            return RB_NIL;
        }
        if .nodes[i].right != RB_NIL: {
            return .subtree_minimum(.nodes[i].right);
        }
        var current = i;
        var up = .nodes[i].parent;
        while up != RB_NIL && current == .nodes[up].right: {
            current = up;
            up = .nodes[up].parent;
        }
        return up;
    }

    fn predecessor(self: &const shared, i: int) -> int: {
        if i == RB_NIL: {
            return RB_NIL;
        }
        if .nodes[i].left != RB_NIL: {
            return .subtree_maximum(.nodes[i].left);
        }
        var current = i;
        var up = .nodes[i].parent;
        while up != RB_NIL && current == .nodes[up].left: {
            current = up;
            up = .nodes[up].parent;
        }
        return up;
    }

    
    
    
    

    fn insert(self: &unique, key: K, value: V) -> bool: {
        if .nodes.size() == 0: {
            .reserve(RB_INITIAL_CAPACITY);
        }

        var parent = RB_NIL;
        var current = .root;
        var side = ChildSide::NoChild;

        while current != RB_NIL: {
            parent = current;
            let order = compare_keys(.nodes[current].key, key);
            if order == 0: {
                
                .nodes[current].value = value;
                return false;
            } else: {
                if order > 0: {
                    side = ChildSide::LeftChild;
                    current = .nodes[current].left;
                } else: {
                    side = ChildSide::RightChild;
                    current = .nodes[current].right;
                }
            }
        }

        let fresh = .allocate(key, value);
        .nodes[fresh].parent = parent;
        if parent == RB_NIL: {
            .root = fresh;
        } else: {
            if side == ChildSide::LeftChild: {
                .nodes[parent].left = fresh;
            } else: {
                .nodes[parent].right = fresh;
            }
        }
        .count += 1;
        .insert_fixup(fresh);
        .paint_black(.root);
        return true;
    }

    
    
    
    
    
    
    fn insert_fixup(self: &unique, start: int): {
        var z = start;
        var guard: int = 0;

        while z != RB_NIL && guard < RB_MAX_HEIGHT: {
            guard += 1;
            let parent = .nodes[z].parent;

            if parent == RB_NIL: {
                
                .paint_black(z);
                break;
            } else: {
                if .is_black(parent): {
                    
                    break;
                } else: {
                    let grand = .nodes[parent].parent;
                    if grand == RB_NIL: {
                        
                        .paint_black(parent);
                        break;
                    } else: {
                        if parent == .nodes[grand].left: {
                            
                            let uncle = .nodes[grand].right;
                            if uncle != RB_NIL && .is_red(uncle): {
                                
                                .paint_black(parent);
                                .paint_black(uncle);
                                .paint_red(grand);
                                .recolours += 3;
                                z = grand;
                            } else: {
                                
                                if z == .nodes[parent].right: {
                                    
                                    
                                    
                                    z = parent;
                                    .rotate_left(z);
                                    let np = .nodes[z].parent;
                                    if np == RB_NIL: {
                                        .paint_black(z);
                                        break;
                                    } else: {
                                        let ng = .nodes[np].parent;
                                        if ng == RB_NIL: {
                                            .paint_black(np);
                                            break;
                                        } else: {
                                            
                                            .paint_black(np);
                                            .paint_red(ng);
                                            .recolours += 2;
                                            .rotate_right(ng);
                                        }
                                    }
                                } else: {
                                    
                                    .paint_black(parent);
                                    .paint_red(grand);
                                    .recolours += 2;
                                    .rotate_right(grand);
                                }
                            }
                        } else: {
                            
                            let uncle = .nodes[grand].left;
                            if uncle != RB_NIL && .is_red(uncle): {
                                
                                .paint_black(parent);
                                .paint_black(uncle);
                                .paint_red(grand);
                                .recolours += 3;
                                z = grand;
                            } else: {
                                if z == .nodes[parent].left: {
                                    
                                    z = parent;
                                    .rotate_right(z);
                                    let np = .nodes[z].parent;
                                    if np == RB_NIL: {
                                        .paint_black(z);
                                        break;
                                    } else: {
                                        let ng = .nodes[np].parent;
                                        if ng == RB_NIL: {
                                            .paint_black(np);
                                            break;
                                        } else: {
                                            
                                            .paint_black(np);
                                            .paint_red(ng);
                                            .recolours += 2;
                                            .rotate_left(ng);
                                        }
                                    }
                                } else: {
                                    
                                    .paint_black(parent);
                                    .paint_red(grand);
                                    .recolours += 2;
                                    .rotate_left(grand);
                                }
                            }
                        }
                    }
                }
            }
        }

        .paint_black(.root);
    }

    

    
    
    fn transplant(self: &unique, target: int, replacement: int): {
        let parent = .parent_of(target);
        if parent == RB_NIL: {
            .root = replacement;
        } else: {
            if target == .nodes[parent].left: {
                .nodes[parent].left = replacement;
            } else: {
                .nodes[parent].right = replacement;
            }
        }
        if replacement != RB_NIL: {
            .nodes[replacement].parent = parent;
        }
    }

    fn erase(self: &unique, key: &const K) -> bool: {
        let victim = .find_index(key);
        if victim == RB_NIL: {
            return false;
        }
        .erase_index(victim);
        return true;
    }

    fn erase_index(self: &unique, victim: int): {
        if victim == RB_NIL: {
            return;
        }

        
        
        
        var removed = victim;
        var removed_colour = .nodes[victim].colour;
        var fixup_at = RB_NIL;
        var fixup_parent = RB_NIL;

        if .nodes[victim].left == RB_NIL: {
            
            fixup_at = .nodes[victim].right;
            fixup_parent = .nodes[victim].parent;
            .transplant(victim, .nodes[victim].right);
        } else: {
            if .nodes[victim].right == RB_NIL: {
                
                fixup_at = .nodes[victim].left;
                fixup_parent = .nodes[victim].parent;
                .transplant(victim, .nodes[victim].left);
            } else: {
                
                removed = .subtree_minimum(.nodes[victim].right);
                removed_colour = .nodes[removed].colour;
                fixup_at = .nodes[removed].right;
                if .nodes[removed].parent == victim: {
                    
                    fixup_parent = removed;
                    if fixup_at != RB_NIL: {
                        .nodes[fixup_at].parent = removed;
                    }
                } else: {
                    fixup_parent = .nodes[removed].parent;
                    .transplant(removed, .nodes[removed].right);
                    .nodes[removed].right = .nodes[victim].right;
                    .nodes[.nodes[removed].right].parent = removed;
                }
                .transplant(victim, removed);
                .nodes[removed].left = .nodes[victim].left;
                .nodes[.nodes[removed].left].parent = removed;
                .nodes[removed].colour = .nodes[victim].colour;
            }
        }

        .release(victim);
        .count -= 1;

        if removed_colour == Colour::Black: {
            
            
            .delete_fixup(fixup_at, fixup_parent);
        }
        .paint_black(.root);
    }

    
    
    
    
    
    fn delete_fixup(self: &unique, start: int, start_parent: int): {
        var x = start;
        var parent = start_parent;
        var guard: int = 0;

        while x != .root && guard < RB_MAX_HEIGHT: {
            guard += 1;
            if .is_red(x): {
                
                .paint_black(x);
                break;
            } else: {
                if parent == RB_NIL: {
                    
                    break;
                } else: {
                    if x == .nodes[parent].left: {
                        
                        var w = .nodes[parent].right;
                        if .is_red(w): {
                            
                            
                            .paint_black(w);
                            .paint_red(parent);
                            .recolours += 2;
                            .rotate_left(parent);
                            w = .nodes[parent].right;
                        }
                        if w == RB_NIL: {
                            
                            x = parent;
                            parent = .nodes[x].parent;
                        } else: {
                            if .is_black(.nodes[w].left) && .is_black(.nodes[w].right): {
                                
                                
                                .paint_red(w);
                                .recolours += 1;
                                x = parent;
                                parent = .nodes[x].parent;
                            } else: {
                                if .is_black(.nodes[w].right): {
                                    
                                    
                                    
                                    if .nodes[w].left != RB_NIL: {
                                        .paint_black(.nodes[w].left);
                                        .recolours += 1;
                                    }
                                    .paint_red(w);
                                    .rotate_right(w);
                                    w = .nodes[parent].right;
                                }
                                if w == RB_NIL: {
                                    x = parent;
                                    parent = .nodes[x].parent;
                                } else: {
                                    
                                    
                                    .set_colour(w, .colour_of(parent));
                                    .paint_black(parent);
                                    if .nodes[w].right != RB_NIL: {
                                        .paint_black(.nodes[w].right);
                                        .recolours += 1;
                                    }
                                    .rotate_left(parent);
                                    x = .root;
                                    parent = RB_NIL;
                                }
                            }
                        }
                    } else: {
                        
                        var w = .nodes[parent].left;
                        if .is_red(w): {
                            
                            .paint_black(w);
                            .paint_red(parent);
                            .recolours += 2;
                            .rotate_right(parent);
                            w = .nodes[parent].left;
                        }
                        if w == RB_NIL: {
                            x = parent;
                            parent = .nodes[x].parent;
                        } else: {
                            if .is_black(.nodes[w].left) && .is_black(.nodes[w].right): {
                                
                                .paint_red(w);
                                .recolours += 1;
                                x = parent;
                                parent = .nodes[x].parent;
                            } else: {
                                if .is_black(.nodes[w].left): {
                                    
                                    if .nodes[w].right != RB_NIL: {
                                        .paint_black(.nodes[w].right);
                                        .recolours += 1;
                                    }
                                    .paint_red(w);
                                    .rotate_left(w);
                                    w = .nodes[parent].left;
                                }
                                if w == RB_NIL: {
                                    x = parent;
                                    parent = .nodes[x].parent;
                                } else: {
                                    
                                    .set_colour(w, .colour_of(parent));
                                    .paint_black(parent);
                                    if .nodes[w].left != RB_NIL: {
                                        .paint_black(.nodes[w].left);
                                        .recolours += 1;
                                    }
                                    .rotate_right(parent);
                                    x = .root;
                                    parent = RB_NIL;
                                }
                            }
                        }
                    }
                }
            }
        }

        .paint_black(x);
    }

    
    
    
    
    

    fn in_order(self: &const shared, out: &unique vector{int}): {
        var stack = vector{int}();
        stack.reserve(RB_MAX_HEIGHT);
        var current = .root;
        while current != RB_NIL || stack.size() > 0: {
            if current != RB_NIL: {
                stack.push_back(current);
                current = .nodes[current].left;
            } else: {
                let top = stack.back();
                stack.pop_back();
                out.push_back(top);
                current = .nodes[top].right;
            }
        }
        destroy stack;
    }

    fn pre_order(self: &const shared, out: &unique vector{int}): {
        if .root == RB_NIL: {
            return;
        }
        var stack = vector{int}();
        stack.reserve(RB_MAX_HEIGHT);
        stack.push_back(.root);
        while stack.size() > 0: {
            let top = stack.back();
            stack.pop_back();
            out.push_back(top);
            
            if .nodes[top].right != RB_NIL: {
                stack.push_back(.nodes[top].right);
            }
            if .nodes[top].left != RB_NIL: {
                stack.push_back(.nodes[top].left);
            }
        }
        destroy stack;
    }

    fn keys_in_order(self: &const shared, out: &unique vector{K}): {
        var order = vector{int}();
        .in_order(order);
        for i: &const in order: {
            out.push_back(.nodes[i].key);
        }
        destroy order;
    }

    

    fn height(self: &const shared) -> int: {
        return .subtree_height(.root);
    }

    fn subtree_height(self: &const shared, start: int) -> int: {
        if start == RB_NIL: {
            return 0;
        }
        var stack = vector{int}();
        var depths = vector{int}();
        stack.push_back(start);
        depths.push_back(1);
        var best: int = 0;
        while stack.size() > 0: {
            let node = stack.back();
            let depth = depths.back();
            stack.pop_back();
            depths.pop_back();
            if depth > best: {
                best = depth;
            }
            if .nodes[node].left != RB_NIL: {
                stack.push_back(.nodes[node].left);
                depths.push_back(depth + 1);
            }
            if .nodes[node].right != RB_NIL: {
                stack.push_back(.nodes[node].right);
                depths.push_back(depth + 1);
            }
        }
        destroy stack;
        destroy depths;
        return best;
    }

    
    
    fn black_height(self: &const shared) -> int: {
        var current = .root;
        var blacks: int = 0;
        while current != RB_NIL: {
            if .is_black(current): {
                blacks += 1;
            }
            current = .nodes[current].left;
        }
        
        return blacks + 1;
    }

    
    
    fn measured_black_height(self: &const shared, start: int) -> int: {
        if start == RB_NIL: {
            return 1;
        }
        let left = .measured_black_height(.nodes[start].left);
        if left < 0: {
            return -1;
        } else: {
            let right = .measured_black_height(.nodes[start].right);
            if right < 0: {
                return -1;
            } else: {
                if left != right: {
                    return -1;
                } else: {
                    if .is_black(start): {
                        return left + 1;
                    } else: {
                        return left;
                    }
                }
            }
        }
    }

    fn min_key(self: &shared) -> &shared[self] K: {
        let i = .minimum();
        if i == RB_NIL: {
            return .missing_key;
        }
        return .nodes[i].key;
    }

    fn max_key(self: &shared) -> &shared[self] K: {
        let i = .maximum();
        if i == RB_NIL: {
            return .missing_key;
        }
        return .nodes[i].key;
    }

    
    
    
    

    fn check_validity(self: &const shared) -> bool: {
        assert .count >= 0;
        assert .count <= .nodes.size();

        if .root == RB_NIL: {
            
            assert .count == 0;
            prove .count == 0;
            return true;
        }

        
        assert .is_black(.root);
        prove .colour_of(.root) == Colour::Black;

        
        assert .is_black(RB_NIL);
        prove .colour_of(RB_NIL) == Colour::Black;

        var order = vector{int}();
        .in_order(order);

        
        assert order.size() == .count;
        prove order.size() == .count;

        var index: int = 0;
        while index < order.size(): {
            let node = order[index];
            assert .nodes[node].live;

            
            assert .colour_of(node) == Colour::Red || .colour_of(node) == Colour::Black;

            
            if .is_red(node): {
                assert .is_black(.nodes[node].left);
                assert .is_black(.nodes[node].right);
                prove .is_black(.left_of(node)) && .is_black(.right_of(node));
            } else: {
                
                
                if .nodes[node].left != RB_NIL: {
                    assert .parent_of(.nodes[node].left) == node;
                }
                if .nodes[node].right != RB_NIL: {
                    assert .parent_of(.nodes[node].right) == node;
                }
            }

            
            if index > 0: {
                let previous = order[index - 1];
                assert compare_keys(.nodes[previous].key, .nodes[node].key) < 0;
                prove compare_keys(.nodes[previous].key, .nodes[node].key) < 0;
            }

            index += 1;
        }
        destroy order;

        
        let measured = .measured_black_height(.root);
        assert measured > 0;
        assert measured == .black_height();
        prove measured == .black_height();

        
        assert .height() <= 2 * measured;
        prove .height() <= 2 * .black_height();

        return true;
    }

    

    fn clear(self: &unique): {
        for node: &unique in .nodes: {
            node.live = false;
            node.reset_links();
        }
        .nodes.clear();
        .root = RB_NIL;
        .free_list = RB_NIL;
        .count = 0;
        .rotations = 0;
        .recolours = 0;
    }

    nodes: vector{RbNode{K, V}};
    root: int = -1;
    free_list: int = -1;
    count: int = 0;
    rotations: int = 0;
    recolours: int = 0;
    missing: V;
    missing_key: K;
}




template(T: type)
fn compare_keys(a: &const T, b: &const T) -> int: {
    if a < b: {
        return -1;
    } else: {
        if b < a: {
            return 1;
        } else: {
            return 0;
        }
    }
}


template(K: type, V: type)
fn merge_into(target: &unique RedBlackTree{K, V}, source: &const shared RedBlackTree{K, V}): {
    var order = vector{int}();
    source.in_order(order);
    for i: &const in order: {
        target.insert(source.nodes[i].key, source.nodes[i].value);
    }
    destroy order;
}


template(K: type, V: type)
fn erase_range(tree: &unique RedBlackTree{K, V}, low: &const K, high: &const K) -> int: {
    var removed: int = 0;
    loop: {
        let node = tree.lower_bound(low);
        if node == RB_NIL: {
            break;
        } else: {
            if compare_keys(tree.nodes[node].key, *high) >= 0: {
                break;
            } else: {
                tree.erase_index(node);
                removed += 1;
            }
        }
    }
    return removed;
}

fn describe_tree(): {
    var tree = RedBlackTree{int, string}();
    tree.reserve(RB_INITIAL_CAPACITY);
    for i in range(0, 32): {
        tree.insert(i * 7 % 32, to_string(i));
    }
    println(to_string(tree.size()));
    println(to_string(tree.height()));
    println(to_string(tree.black_height()));
    if !tree.check_validity(): {
        panic("red-black invariants violated after bulk insert");
    }
    var index: int = 0;
    while index < 32: {
        if index % 2 == 0: {
            discard tree.erase(index);
        }
        index += 1;
    }
    if !tree.check_validity(): {
        panic("red-black invariants violated after bulk erase");
    }
    destroy tree;
}

}

namespace containers: {

enum SlotState: {
    Empty;
    Occupied;
    Tombstone = 2;
}

static DEFAULT_CAPACITY: int = 16;
static MAX_LOAD_PERCENT: int = 75;

template(K: type, V: type)
struct Slot: {
    key: K;
    value: V;
    hash: int = 0;
    distance: int = 0;
    state: SlotState = SlotState::Empty;
}

template(K: type, V: type)
struct HashMap: {

    fn size(self: &const shared) -> int: {
        return .count;
    }

    fn empty(self: &const shared) -> bool: {
        return .count == 0;
    }

    fn slot_index(self: &const shared, h: int) -> int: {
        return h & (.slots.size() - 1);
    }

    fn should_grow(self: &const shared) -> bool: {
        let limit = .slots.size() * MAX_LOAD_PERCENT;
        return .count * 100 >= limit;
    }

    fn find(self: &shared, key: &const K) -> &shared[self] V: {
        let h = hash_of(key);
        var index = .slot_index(h);
        var probe: int = 0;
        loop: {
            let slot: &shared = .slots[index];
            if slot.state == SlotState::Empty: {
                break;
            }
            if slot.state == SlotState::Occupied && slot.hash == h: {
                if slot.key == *key: {
                    return slot.value;
                }
            }
            if probe > slot.distance: {
                break;
            }
            index = .slot_index(index + 1);
            probe += 1;
        }
        return .missing;
    }

    fn insert(self: &unique, key: K, value: V) -> bool: {
        if .should_grow(): {
            .rehash(.slots.size() * 2);
        }
        let h = hash_of(key);
        var index = .slot_index(h);
        var distance: int = 0;
        var pending = Slot{K, V}(key: key, value: value, hash: h);
        loop: {
            let slot: &unique = .slots[index];
            if slot.state != SlotState::Occupied: {
                slot.key = pending.key;
                slot.value = pending.value;
                slot.hash = pending.hash;
                slot.distance = distance;
                slot.state = SlotState::Occupied;
                .count += 1;
                return true;
            }
            if slot.hash == h && slot.key == pending.key: {
                slot.value = pending.value;
                return false;
            }
            if slot.distance < distance: {
                swap(slot.key, pending.key);
                swap(slot.value, pending.value);
                swap(slot.distance, distance);
            }
            index = .slot_index(index + 1);
            distance += 1;
        }
    }

    fn erase(self: &unique, key: &const K) -> bool: {
        var index = .slot_index(hash_of(key));
        var probe: int = 0;
        while probe < .slots.size(): {
            let slot: &unique = .slots[index];
            if slot.state == SlotState::Empty: {
                return false;
            }
            if slot.state == SlotState::Occupied && slot.key == *key: {
                slot.state = SlotState::Tombstone;
                .count -= 1;
                return true;
            }
            index = .slot_index(index + 1);
            probe += 1;
        }
        return false;
    }

    fn rehash(self: &unique, capacity: int): {
        var old = move(.slots);
        .slots = vector{Slot{K, V}}(capacity);
        .count = 0;
        for entry: &const in old: {
            if entry.state == SlotState::Occupied: {
                .insert(entry.key, entry.value);
            } else: {
                discard entry;
            }
        }
        destroy old;
    }

    fn clear(self: &unique): {
        for slot: &unique in .slots: {
            slot.state = SlotState::Empty;
            slot.distance = 0;
        }
        .count = 0;
    }

    slots: vector{Slot{K, V}};
    count: int = 0;
    missing: V;
}

}
























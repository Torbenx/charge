static MAX_MOVES: int = 256;
static MAX_PLY: int = 512;
static MAX_GAME_MOVES: int = 1024;


static FIFTY_MOVE_PLIES: int = 100;



static CHAR_ZERO: int = 48;               
static CHAR_NINE: int = 57;               
static CHAR_LOWER_A: int = 97;            
static CHAR_LOWER_H: int = 104;           
static CHAR_UPPER_A: int = 65;            
static CHAR_SPACE: int = 32;              
static CHAR_SLASH: int = 47;              
static CHAR_DASH: int = 45;               

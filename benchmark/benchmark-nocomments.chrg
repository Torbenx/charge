namespace b_tree: {




enum SplitOutcome: {
    NoSplit;
    SplitPerformed;
    RootGrew = 2;
}


enum RebalanceAction: {
    BorrowedFromLeft;
    BorrowedFromRight;
    MergedWithLeft;
    MergedWithRight;
    NoActionNeeded = 4;
}


enum SlotKind: {
    ExactMatch;
    DescendLeft;
    DescendRight;
    MissingSlot = 3;
}


enum ScanOrder: {
    Ascending;
    Descending = 1;
}




static BTREE_NIL: int = -1;


static BTREE_DEFAULT_ORDER: int = 6;



static BTREE_MAX_HEIGHT: int = 48;


static BTREE_INITIAL_CAPACITY: int = 32;



static BTREE_GROWTH_PERCENT: int = 200;




static BTREE_BULK_FILL_PERCENT: int = 75;


static BTREE_SAMPLE_LIMIT: int = 8;









template(K: type, V: type, ORDER: int)
struct BTreeNode: {

    

    fn max_children(self: &const shared) -> int: {
        return ORDER;
    }

    fn max_keys(self: &const shared) -> int: {
        return ORDER - 1;
    }

    
    
    fn min_keys(self: &const shared) -> int: {
        return ORDER / 2 - 1;
    }

    fn min_children(self: &const shared) -> int: {
        return ORDER / 2;
    }

    fn is_full(self: &const shared) -> bool: {
        return .count >= ORDER - 1;
    }

    fn is_minimal(self: &const shared) -> bool: {
        return .count <= ORDER / 2 - 1;
    }

    
    fn has_spare_key(self: &const shared) -> bool: {
        return .count > ORDER / 2 - 1;
    }

    fn is_leaf(self: &const shared) -> bool: {
        return .leaf;
    }

    fn key_count(self: &const shared) -> int: {
        return .count;
    }

    fn child_count(self: &const shared) -> int: {
        if .leaf: {
            return 0;
        }
        return .count + 1;
    }

    fn occupancy_percent(self: &const shared) -> int: {
        if ORDER <= 1: {
            return 0;
        }
        return .count * 100 / (ORDER - 1);
    }

    

    fn key_at(self: &shared, index: int) -> &shared[self] K: {
        return .keys[index];
    }

    fn value_at(self: &shared, index: int) -> &shared[self] V: {
        return .values[index];
    }

    fn child_at(self: &const shared, index: int) -> int: {
        if .leaf: {
            return BTREE_NIL;
        }
        if index < 0 || index > .count: {
            return BTREE_NIL;
        }
        return .children[index];
    }

    
    
    fn entry_at(self: &const shared, index: int) -> pair{K, V}: {
        return pair{K, V}(first: .keys[index], second: .values[index]);
    }

    
    
    fn entries(self: &const shared) -> vector{pair{K, V}}: {
        var out = vector{pair{K, V}}();
        out.reserve(.count);
        var i: int = 0;
        while i < .count: {
            out.push_back(pair{K, V}(first: .keys[i], second: .values[i]));
            i += 1;
        }
        return out;
    }

    
    fn separators(self: &const shared) -> vector{pair{K, int}}: {
        var out = vector{pair{K, int}}();
        if .leaf: {
            return out;
        }
        var i: int = 0;
        while i < .count: {
            out.push_back(pair{K, int}(first: .keys[i], second: .children[i]));
            i += 1;
        }
        return out;
    }

    

    
    
    
    fn lower_bound(self: &const shared, key: &const K) -> int: {
        var lo: int = 0;
        var hi: int = .count;
        while lo < hi: {
            let mid = lo + (hi - lo) / 2;
            if compare_keys(.keys[mid], *key) < 0: {
                lo = mid + 1;
            } else: {
                hi = mid;
            }
        }
        return lo;
    }

    
    fn upper_bound(self: &const shared, key: &const K) -> int: {
        var lo: int = 0;
        var hi: int = .count;
        while lo < hi: {
            let mid = lo + (hi - lo) / 2;
            if compare_keys(.keys[mid], *key) <= 0: {
                lo = mid + 1;
            } else: {
                hi = mid;
            }
        }
        return lo;
    }

    
    
    
    fn linear_find(self: &const shared, key: &const K) -> int: {
        var i: int = 0;
        while i < .count: {
            if compare_keys(.keys[i], *key) == 0: {
                return i;
            }
            i += 1;
        }
        return -1;
    }

    fn contains_key(self: &const shared, key: &const K) -> bool: {
        let slot = .lower_bound(key);
        if slot >= .count: {
            return false;
        }
        return compare_keys(.keys[slot], *key) == 0;
    }

    
    
    fn classify(self: &const shared, key: &const K) -> SlotKind: {
        if .count == 0: {
            return SlotKind::MissingSlot;
        }
        let slot = .lower_bound(key);
        if slot < .count: {
            if compare_keys(.keys[slot], *key) == 0: {
                return SlotKind::ExactMatch;
            } else: {
                return SlotKind::DescendLeft;
            }
        } else: {
            return SlotKind::DescendRight;
        }
    }

    
    
    fn probe(self: &const shared, key: &const K) -> pair{int, bool}: {
        let slot = .lower_bound(key);
        if slot < .count: {
            if compare_keys(.keys[slot], *key) == 0: {
                return pair{int, bool}(first: slot, second: true);
            }
        }
        return pair{int, bool}(first: slot, second: false);
    }

    
    
    
    
    

    
    fn shift_keys_right(self: &unique, at: int): {
        .keys.push_back(.keys[.count - 1]);
        .values.push_back(.values[.count - 1]);
        var i = .count - 1;
        while i > at: {
            .keys[i] = .keys[i - 1];
            .values[i] = .values[i - 1];
            i -= 1;
        }
    }

    
    fn shift_keys_left(self: &unique, at: int): {
        var i = at;
        while i + 1 < .count: {
            .keys[i] = .keys[i + 1];
            .values[i] = .values[i + 1];
            i += 1;
        }
        .keys.pop_back();
        .values.pop_back();
    }

    fn shift_children_right(self: &unique, at: int): {
        if .leaf: {
            return;
        }
        .children.push_back(.children[.count]);
        var i = .count;
        while i > at: {
            .children[i] = .children[i - 1];
            i -= 1;
        }
    }

    fn shift_children_left(self: &unique, at: int): {
        if .leaf: {
            return;
        }
        var i = at;
        while i + 1 <= .count: {
            .children[i] = .children[i + 1];
            i += 1;
        }
        .children.pop_back();
    }

    

    fn insert_entry_at(self: &unique, at: int, key: K, value: V): {
        if .count == 0: {
            .keys.push_back(key);
            .values.push_back(value);
            .count = 1;
            return;
        }
        if at >= .count: {
            .keys.push_back(key);
            .values.push_back(value);
            .count += 1;
            return;
        }
        .shift_keys_right(at);
        .keys[at] = key;
        .values[at] = value;
        .count += 1;
    }

    fn remove_entry_at(self: &unique, at: int) -> pair{K, V}: {
        let taken = pair{K, V}(first: .keys[at], second: .values[at]);
        .shift_keys_left(at);
        .count -= 1;
        return taken;
    }

    fn insert_child_at(self: &unique, at: int, child: int): {
        if .leaf: {
            return;
        }
        if at > .count: {
            .children.push_back(child);
            return;
        }
        .shift_children_right(at);
        .children[at] = child;
    }

    fn remove_child_at(self: &unique, at: int) -> int: {
        if .leaf: {
            return BTREE_NIL;
        }
        let taken = .children[at];
        .shift_children_left(at);
        return taken;
    }

    fn push_entry(self: &unique, key: K, value: V): {
        .keys.push_back(key);
        .values.push_back(value);
        .count += 1;
    }

    fn push_pair(self: &unique, entry: pair{K, V}): {
        .keys.push_back(entry.first);
        .values.push_back(entry.second);
        .count += 1;
    }

    fn pop_entry(self: &unique) -> pair{K, V}: {
        let taken = pair{K, V}(first: .keys[.count - 1], second: .values[.count - 1]);
        .keys.pop_back();
        .values.pop_back();
        .count -= 1;
        return taken;
    }

    fn reset_slots(self: &unique): {
        .keys.clear();
        .values.clear();
        .children.clear();
        .count = 0;
        .leaf = true;
        .parent = BTREE_NIL;
        .depth = 0;
    }

    keys: vector{K};
    values: vector{V};
    children: vector{int};
    count: int = 0;
    leaf: bool = true;
    parent: int = -1;
    depth: int = 0;
    live: bool = true;
}






template(K: type, V: type)
struct BTreeStats: {

    fn average_occupancy(self: &const shared) -> int: {
        if .node_count == 0: {
            return 0;
        }
        return .key_count * 100 / .node_count;
    }

    fn leaf_fraction_percent(self: &const shared) -> int: {
        if .node_count == 0: {
            return 0;
        }
        return .leaf_count * 100 / .node_count;
    }

    fn balanced(self: &const shared) -> bool: {
        return .min_leaf_depth == .max_leaf_depth;
    }

    fn record_sample(self: &unique, entry: pair{K, V}): {
        if .samples.size() < BTREE_SAMPLE_LIMIT: {
            .samples.push_back(entry);
        }
    }

    
    fn level_widths(self: &const shared) -> vector{pair{int, int}}: {
        var out = vector{pair{int, int}}();
        for row: &const in .per_depth: {
            out.push_back(pair{int, int}(first: row.first, second: row.second));
        }
        return out;
    }

    fn describe(self: &const shared) -> string: {
        var text = string();
        text.append("height=");
        text.append(to_string(.height));
        text.append(" nodes=");
        text.append(to_string(.node_count));
        text.append(" keys=");
        text.append(to_string(.key_count));
        text.append(" fill=");
        text.append(to_string(.average_occupancy()));
        return text;
    }

    height: int = 0;
    node_count: int = 0;
    leaf_count: int = 0;
    key_count: int = 0;
    min_occupancy: int = 0;
    max_occupancy: int = 0;
    min_leaf_depth: int = 0;
    max_leaf_depth: int = 0;
    splits_seen: int = 0;
    merges_seen: int = 0;
    per_depth: vector{pair{int, int}};
    occupancy_histogram: vector{pair{int, int}};
    samples: vector{pair{K, V}};
}






template(K: type, V: type, ORDER: int)
struct BTreeCursor: {

    fn valid(self: &const shared) -> bool: {
        return .node != BTREE_NIL && .slot >= 0;
    }

    fn depth(self: &const shared) -> int: {
        return .path.size();
    }

    fn push_step(self: &unique, node: int, child: int): {
        .path.push_back(pair{int, int}(first: node, second: child));
    }

    fn pop_step(self: &unique) -> pair{int, int}: {
        if .path.size() == 0: {
            return pair{int, int}(first: BTREE_NIL, second: -1);
        }
        let top = .path.back();
        .path.pop_back();
        return pair{int, int}(first: top.first, second: top.second);
    }

    fn parent_step(self: &const shared) -> pair{int, int}: {
        if .path.size() == 0: {
            return pair{int, int}(first: BTREE_NIL, second: -1);
        }
        return .path[.path.size() - 1];
    }

    fn invalidate(self: &unique): {
        .node = BTREE_NIL;
        .slot = -1;
        .path.clear();
    }

    node: int = -1;
    slot: int = -1;
    order: ScanOrder = ScanOrder::Ascending;
    path: vector{pair{int, int}};
    pending: vector{pair{K, V}};
}



template(K: type, V: type, ORDER: int)
struct BTree: {

    

    fn size(self: &const shared) -> int: {
        return .count;
    }

    fn empty(self: &const shared) -> bool: {
        return .count == 0;
    }

    fn order(self: &const shared) -> int: {
        return ORDER;
    }

    fn max_keys(self: &const shared) -> int: {
        return ORDER - 1;
    }

    fn min_keys(self: &const shared) -> int: {
        return ORDER / 2 - 1;
    }

    fn arena_size(self: &const shared) -> int: {
        return .nodes.size();
    }

    fn is_nil(self: &const shared, i: int) -> bool: {
        return i == BTREE_NIL;
    }

    fn alive(self: &const shared, i: int) -> bool: {
        if i == BTREE_NIL: {
            return false;
        }
        return .nodes[i].live;
    }

    fn node_at(self: &shared, i: int) -> &shared[self] BTreeNode{K, V, ORDER}: {
        return .nodes[i];
    }

    fn root_node(self: &shared) -> &shared[self] BTreeNode{K, V, ORDER}: {
        return .nodes[.root];
    }

    

    fn reserve(self: &unique, capacity: int): {
        .nodes.reserve(capacity);
    }

    fn grow_if_needed(self: &unique): {
        if .nodes.size() >= .nodes.capacity(): {
            let target = .nodes.capacity() * BTREE_GROWTH_PERCENT / 100;
            if target <= .nodes.size(): {
                .nodes.reserve(.nodes.size() + BTREE_INITIAL_CAPACITY);
            } else: {
                .nodes.reserve(target);
            }
        }
    }

    
    fn allocate_node(self: &unique, leaf: bool, depth: int) -> int: {
        if .free_list != BTREE_NIL: {
            let recycled = .free_list;
            .free_list = .nodes[recycled].parent;
            .nodes[recycled].reset_slots();
            .nodes[recycled].leaf = leaf;
            .nodes[recycled].depth = depth;
            .nodes[recycled].live = true;
            return recycled;
        }
        .grow_if_needed();
        var fresh = BTreeNode{K, V, ORDER}(leaf: leaf, depth: depth);
        .nodes.push_back(fresh);
        return .nodes.size() - 1;
    }

    
    
    fn release_node(self: &unique, i: int): {
        if i == BTREE_NIL: {
            return;
        }
        .nodes[i].reset_slots();
        .nodes[i].live = false;
        .nodes[i].parent = .free_list;
        .free_list = i;
    }

    fn set_parent(self: &unique, child: int, parent: int): {
        if child != BTREE_NIL: {
            .nodes[child].parent = parent;
        }
    }

    
    
    fn restamp_depths(self: &unique, start: int, depth: int): {
        if start == BTREE_NIL: {
            return;
        }
        var stack = vector{pair{int, int}}();
        stack.reserve(BTREE_MAX_HEIGHT);
        stack.push_back(pair{int, int}(first: start, second: depth));
        while stack.size() > 0: {
            let top = stack.back();
            stack.pop_back();
            .nodes[top.first].depth = top.second;
            if !.nodes[top.first].leaf: {
                var c: int = 0;
                while c <= .nodes[top.first].count: {
                    let child = .nodes[top.first].children[c];
                    if child != BTREE_NIL: {
                        stack.push_back(pair{int, int}(first: child, second: top.second + 1));
                    }
                    c += 1;
                }
            }
        }
        destroy stack;
    }

    

    
    fn find_in_node(self: &const shared, node: int, key: &const K) -> pair{int, bool}: {
        if node == BTREE_NIL: {
            return pair{int, bool}(first: -1, second: false);
        }
        return .nodes[node].probe(key);
    }

    
    
    fn locate(self: &const shared, key: &const K) -> pair{int, int}: {
        var current = .root;
        while current != BTREE_NIL: {
            let hit = .nodes[current].probe(key);
            if hit.second: {
                return pair{int, int}(first: current, second: hit.first);
            }
            if .nodes[current].leaf: {
                return pair{int, int}(first: BTREE_NIL, second: -1);
            }
            current = .nodes[current].children[hit.first];
        }
        return pair{int, int}(first: BTREE_NIL, second: -1);
    }

    
    
    fn locate_with_path(self: &const shared, key: &const K) -> BTreeCursor{K, V, ORDER}: {
        var cursor = BTreeCursor{K, V, ORDER}();
        var current = .root;
        while current != BTREE_NIL: {
            let hit = .nodes[current].probe(key);
            if hit.second: {
                cursor.node = current;
                cursor.slot = hit.first;
                return cursor;
            }
            if .nodes[current].leaf: {
                cursor.node = BTREE_NIL;
                cursor.slot = -1;
                return cursor;
            }
            cursor.push_step(current, hit.first);
            current = .nodes[current].children[hit.first];
        }
        cursor.invalidate();
        return cursor;
    }

    fn contains(self: &const shared, key: &const K) -> bool: {
        let found = .locate(key);
        return found.first != BTREE_NIL;
    }

    fn find(self: &shared, key: &const K) -> &shared[self] V: {
        let found = .locate(key);
        if found.first == BTREE_NIL: {
            return .missing;
        }
        return .nodes[found.first].values[found.second];
    }

    
    
    fn depth_of(self: &const shared, key: &const K) -> int: {
        var current = .root;
        var depth: int = 0;
        while current != BTREE_NIL: {
            let hit = .nodes[current].probe(key);
            if hit.second: {
                return depth;
            }
            if .nodes[current].leaf: {
                return -1;
            }
            current = .nodes[current].children[hit.first];
            depth += 1;
        }
        return -1;
    }

    

    fn minimum_in(self: &const shared, start: int) -> pair{int, int}: {
        var current = start;
        while current != BTREE_NIL: {
            if .nodes[current].leaf: {
                if .nodes[current].count == 0: {
                    return pair{int, int}(first: BTREE_NIL, second: -1);
                }
                return pair{int, int}(first: current, second: 0);
            }
            current = .nodes[current].children[0];
        }
        return pair{int, int}(first: BTREE_NIL, second: -1);
    }

    fn maximum_in(self: &const shared, start: int) -> pair{int, int}: {
        var current = start;
        while current != BTREE_NIL: {
            if .nodes[current].leaf: {
                if .nodes[current].count == 0: {
                    return pair{int, int}(first: BTREE_NIL, second: -1);
                }
                return pair{int, int}(first: current, second: .nodes[current].count - 1);
            }
            current = .nodes[current].children[.nodes[current].count];
        }
        return pair{int, int}(first: BTREE_NIL, second: -1);
    }

    fn minimum(self: &const shared) -> pair{int, int}: {
        return .minimum_in(.root);
    }

    fn maximum(self: &const shared) -> pair{int, int}: {
        return .maximum_in(.root);
    }

    fn min_key(self: &shared) -> &shared[self] K: {
        let at = .minimum();
        if at.first == BTREE_NIL: {
            return .missing_key;
        }
        return .nodes[at.first].keys[at.second];
    }

    fn max_key(self: &shared) -> &shared[self] K: {
        let at = .maximum();
        if at.first == BTREE_NIL: {
            return .missing_key;
        }
        return .nodes[at.first].keys[at.second];
    }

    fn min_entry(self: &const shared) -> pair{K, V}: {
        let at = .minimum();
        if at.first == BTREE_NIL: {
            return pair{K, V}(first: .missing_key, second: .missing);
        }
        return .nodes[at.first].entry_at(at.second);
    }

    fn max_entry(self: &const shared) -> pair{K, V}: {
        let at = .maximum();
        if at.first == BTREE_NIL: {
            return pair{K, V}(first: .missing_key, second: .missing);
        }
        return .nodes[at.first].entry_at(at.second);
    }

    
    
    
    
    

    
    
    
    fn split_child(self: &unique, parent: int, index: int) -> int: {
        let full = .nodes[parent].children[index];
        let median = (ORDER - 1) / 2;
        let sibling = .allocate_node(.nodes[full].leaf, .nodes[full].depth);

        
        var i = median + 1;
        while i < .nodes[full].count: {
            .nodes[sibling].push_entry(.nodes[full].keys[i], .nodes[full].values[i]);
            i += 1;
        }

        
        if !.nodes[full].leaf: {
            var c = median + 1;
            while c <= .nodes[full].count: {
                let moved = .nodes[full].children[c];
                .nodes[sibling].children.push_back(moved);
                .set_parent(moved, sibling);
                c += 1;
            }
            var trim = .nodes[full].count;
            while trim > median: {
                .nodes[full].children.pop_back();
                trim -= 1;
            }
        }

        
        let promoted_key = .nodes[full].keys[median];
        let promoted_value = .nodes[full].values[median];
        var drop = .nodes[full].count;
        while drop > median: {
            .nodes[full].keys.pop_back();
            .nodes[full].values.pop_back();
            drop -= 1;
        }
        .nodes[full].count = median;

        .nodes[parent].insert_entry_at(index, promoted_key, promoted_value);
        .nodes[parent].insert_child_at(index + 1, sibling);
        .set_parent(sibling, parent);
        .set_parent(full, parent);
        .splits += 1;
        return sibling;
    }

    
    fn grow_root(self: &unique) -> int: {
        let old_root = .root;
        let fresh = .allocate_node(false, 0);
        .nodes[fresh].children.push_back(old_root);
        .set_parent(old_root, fresh);
        .root = fresh;
        .restamp_depths(fresh, 0);
        let sibling = .split_child(fresh, 0);
        discard sibling;
        .height_hint += 1;
        return fresh;
    }

    
    fn insert_non_full(self: &unique, start: int, key: K, value: V) -> bool: {
        var current = start;
        loop: {
            let hit = .nodes[current].probe(key);
            if hit.second: {
                
                .nodes[current].values[hit.first] = value;
                return false;
            }
            if .nodes[current].leaf: {
                .nodes[current].insert_entry_at(hit.first, key, value);
                .count += 1;
                return true;
            } else: {
                var slot = hit.first;
                let child = .nodes[current].children[slot];
                if .nodes[child].is_full(): {
                    let sibling = .split_child(current, slot);
                    discard sibling;
                    
                    if compare_keys(.nodes[current].keys[slot], key) == 0: {
                        .nodes[current].values[slot] = value;
                        return false;
                    }
                    if compare_keys(key, .nodes[current].keys[slot]) > 0: {
                        slot += 1;
                    }
                }
                current = .nodes[current].children[slot];
            }
        }
    }

    fn insert(self: &unique, key: K, value: V) -> bool: {
        if .root == BTREE_NIL: {
            .root = .allocate_node(true, 0);
            .nodes[.root].push_entry(key, value);
            .count += 1;
            .height_hint = 1;
            return true;
        }
        if .nodes[.root].is_full(): {
            let grown = .grow_root();
            discard grown;
        }
        return .insert_non_full(.root, key, value);
    }

    fn insert_pair(self: &unique, entry: pair{K, V}) -> bool: {
        return .insert(entry.first, entry.second);
    }

    
    
    fn insert_all(self: &unique, entries: &const shared vector{pair{K, V}}) -> int: {
        var added: int = 0;
        for entry: &const in entries: {
            if .insert(entry.first, entry.second): {
                added += 1;
            }
        }
        return added;
    }

    
    
    fn append_value(self: &unique, key: K, value: V) -> bool: {
        let found = .locate(key);
        if found.first == BTREE_NIL: {
            return .insert(key, value);
        }
        .nodes[found.first].values[found.second] = value;
        return false;
    }

    
    
    
    
    

    
    
    fn borrow_from_left(self: &unique, parent: int, index: int): {
        let child = .nodes[parent].children[index];
        let left = .nodes[parent].children[index - 1];

        
        .nodes[child].insert_entry_at(0, .nodes[parent].keys[index - 1],
                                      .nodes[parent].values[index - 1]);

        
        let lifted = .nodes[left].pop_entry();
        .nodes[parent].keys[index - 1] = lifted.first;
        .nodes[parent].values[index - 1] = lifted.second;

        
        if !.nodes[child].leaf: {
            let moved = .nodes[left].children[.nodes[left].count + 1];
            .nodes[left].children.pop_back();
            .nodes[child].insert_child_at(0, moved);
            .set_parent(moved, child);
            .restamp_depths(moved, .nodes[child].depth + 1);
        }
        .borrows += 1;
    }

    
    fn borrow_from_right(self: &unique, parent: int, index: int): {
        let child = .nodes[parent].children[index];
        let right = .nodes[parent].children[index + 1];

        
        .nodes[child].push_entry(.nodes[parent].keys[index], .nodes[parent].values[index]);

        
        let lifted = .nodes[right].remove_entry_at(0);
        .nodes[parent].keys[index] = lifted.first;
        .nodes[parent].values[index] = lifted.second;

        if !.nodes[child].leaf: {
            let moved = .nodes[right].remove_child_at(0);
            .nodes[child].children.push_back(moved);
            .set_parent(moved, child);
            .restamp_depths(moved, .nodes[child].depth + 1);
        }
        .borrows += 1;
    }

    
    
    fn merge_children(self: &unique, parent: int, index: int) -> int: {
        let left = .nodes[parent].children[index];
        let right = .nodes[parent].children[index + 1];

        
        let separator = .nodes[parent].remove_entry_at(index);
        .nodes[left].push_entry(separator.first, separator.second);

        
        var i: int = 0;
        while i < .nodes[right].count: {
            .nodes[left].push_entry(.nodes[right].keys[i], .nodes[right].values[i]);
            i += 1;
        }

        if !.nodes[right].leaf: {
            var c: int = 0;
            while c <= .nodes[right].count: {
                let moved = .nodes[right].children[c];
                if moved != BTREE_NIL: {
                    .nodes[left].children.push_back(moved);
                    .set_parent(moved, left);
                    .restamp_depths(moved, .nodes[left].depth + 1);
                }
                c += 1;
            }
        }

        
        let dropped = .nodes[parent].remove_child_at(index + 1);
        discard dropped;
        .release_node(right);
        .merges += 1;

        
        if parent == .root && .nodes[parent].count == 0: {
            .release_node(.root);
            .root = left;
            .set_parent(left, BTREE_NIL);
            .restamp_depths(left, 0);
            if .height_hint > 0: {
                .height_hint -= 1;
            }
        }
        return left;
    }

    
    
    
    fn fill_child(self: &unique, parent: int, index: int) -> pair{RebalanceAction, int}: {
        let child = .nodes[parent].children[index];
        if .nodes[child].has_spare_key(): {
            return pair{RebalanceAction, int}(first: RebalanceAction::NoActionNeeded,
                                              second: index);
        }

        if index > 0: {
            let left = .nodes[parent].children[index - 1];
            if .nodes[left].has_spare_key(): {
                .borrow_from_left(parent, index);
                return pair{RebalanceAction, int}(first: RebalanceAction::BorrowedFromLeft,
                                                  second: index);
            } else: {
                if index < .nodes[parent].count: {
                    let right = .nodes[parent].children[index + 1];
                    if .nodes[right].has_spare_key(): {
                        .borrow_from_right(parent, index);
                        return pair{RebalanceAction, int}(
                            first: RebalanceAction::BorrowedFromRight, second: index);
                    } else: {
                        
                        
                        let merged = .merge_children(parent, index - 1);
                        discard merged;
                        return pair{RebalanceAction, int}(
                            first: RebalanceAction::MergedWithLeft, second: index - 1);
                    }
                } else: {
                    let merged = .merge_children(parent, index - 1);
                    discard merged;
                    return pair{RebalanceAction, int}(
                        first: RebalanceAction::MergedWithLeft, second: index - 1);
                }
            }
        } else: {
            
            if index < .nodes[parent].count: {
                let right = .nodes[parent].children[index + 1];
                if .nodes[right].has_spare_key(): {
                    .borrow_from_right(parent, index);
                    return pair{RebalanceAction, int}(
                        first: RebalanceAction::BorrowedFromRight, second: index);
                } else: {
                    let merged = .merge_children(parent, index);
                    discard merged;
                    return pair{RebalanceAction, int}(
                        first: RebalanceAction::MergedWithRight, second: index);
                }
            } else: {
                return pair{RebalanceAction, int}(first: RebalanceAction::NoActionNeeded,
                                                  second: index);
            }
        }
    }

    
    
    fn remove_from_leaf(self: &unique, node: int, slot: int) -> pair{K, V}: {
        let taken = .nodes[node].remove_entry_at(slot);
        .count -= 1;
        return taken;
    }

    
    
    
    fn remove_from_branch(self: &unique, node: int, slot: int) -> bool: {
        let left = .nodes[node].children[slot];
        let right = .nodes[node].children[slot + 1];

        if .nodes[left].has_spare_key(): {
            let at = .maximum_in(left);
            let replacement = .nodes[at.first].entry_at(at.second);
            .nodes[node].keys[slot] = replacement.first;
            .nodes[node].values[slot] = replacement.second;
            return .erase_from(left, replacement.first);
        } else: {
            if .nodes[right].has_spare_key(): {
                let at = .minimum_in(right);
                let replacement = .nodes[at.first].entry_at(at.second);
                .nodes[node].keys[slot] = replacement.first;
                .nodes[node].values[slot] = replacement.second;
                return .erase_from(right, replacement.first);
            } else: {
                
                
                let doomed_key = .nodes[node].keys[slot];
                let merged = .merge_children(node, slot);
                return .erase_from(merged, doomed_key);
            }
        }
    }

    
    
    fn erase_from(self: &unique, start: int, key: K) -> bool: {
        var current = start;
        loop: {
            if current == BTREE_NIL: {
                return false;
            }
            let hit = .nodes[current].probe(key);
            if hit.second: {
                if .nodes[current].leaf: {
                    let taken = .remove_from_leaf(current, hit.first);
                    discard taken;
                    return true;
                } else: {
                    return .remove_from_branch(current, hit.first);
                }
            }
            if .nodes[current].leaf: {
                return false;
            }
            var slot = hit.first;
            let child = .nodes[current].children[slot];
            if .nodes[child].is_minimal(): {
                let action = .fill_child(current, slot);
                slot = action.second;
                if action.first == RebalanceAction::MergedWithLeft: {
                    
                    if .nodes[current].count == 0 && current == .root: {
                        current = .root;
                        slot = 0;
                    }
                }
                if slot > .nodes[current].count: {
                    slot = .nodes[current].count;
                }
            }
            current = .nodes[current].children[slot];
        }
    }

    fn erase(self: &unique, key: K) -> bool: {
        if .root == BTREE_NIL: {
            return false;
        }
        let removed = .erase_from(.root, key);
        if .root != BTREE_NIL: {
            if .nodes[.root].count == 0 && .nodes[.root].leaf: {
                .release_node(.root);
                .root = BTREE_NIL;
                .height_hint = 0;
            }
        }
        return removed;
    }

    fn erase_min(self: &unique) -> pair{K, V}: {
        let at = .minimum();
        if at.first == BTREE_NIL: {
            return pair{K, V}(first: .missing_key, second: .missing);
        }
        let entry = .nodes[at.first].entry_at(at.second);
        discard .erase(entry.first);
        return entry;
    }

    fn erase_max(self: &unique) -> pair{K, V}: {
        let at = .maximum();
        if at.first == BTREE_NIL: {
            return pair{K, V}(first: .missing_key, second: .missing);
        }
        let entry = .nodes[at.first].entry_at(at.second);
        discard .erase(entry.first);
        return entry;
    }

    
    
    
    
    

    fn predecessor(self: &const shared, key: &const K) -> pair{K, V}: {
        var cursor = .locate_with_path(key);
        if !cursor.valid(): {
            
            return .largest_below(key);
        }
        if !.nodes[cursor.node].leaf: {
            let at = .maximum_in(.nodes[cursor.node].children[cursor.slot]);
            if at.first != BTREE_NIL: {
                return .nodes[at.first].entry_at(at.second);
            }
        }
        if cursor.slot > 0: {
            return .nodes[cursor.node].entry_at(cursor.slot - 1);
        }
        
        
        while cursor.depth() > 0: {
            let step = cursor.pop_step();
            if step.second > 0: {
                return .nodes[step.first].entry_at(step.second - 1);
            }
        }
        return pair{K, V}(first: .missing_key, second: .missing);
    }

    fn successor(self: &const shared, key: &const K) -> pair{K, V}: {
        var cursor = .locate_with_path(key);
        if !cursor.valid(): {
            return .smallest_above(key);
        }
        if !.nodes[cursor.node].leaf: {
            let at = .minimum_in(.nodes[cursor.node].children[cursor.slot + 1]);
            if at.first != BTREE_NIL: {
                return .nodes[at.first].entry_at(at.second);
            }
        }
        if cursor.slot + 1 < .nodes[cursor.node].count: {
            return .nodes[cursor.node].entry_at(cursor.slot + 1);
        }
        while cursor.depth() > 0: {
            let step = cursor.pop_step();
            if step.second < .nodes[step.first].count: {
                return .nodes[step.first].entry_at(step.second);
            }
        }
        return pair{K, V}(first: .missing_key, second: .missing);
    }

    
    fn largest_below(self: &const shared, key: &const K) -> pair{K, V}: {
        var current = .root;
        var best = pair{K, V}(first: .missing_key, second: .missing);
        var found: bool = false;
        while current != BTREE_NIL: {
            let slot = .nodes[current].lower_bound(key);
            if slot > 0: {
                best = .nodes[current].entry_at(slot - 1);
                found = true;
            }
            if .nodes[current].leaf: {
                current = BTREE_NIL;
            } else: {
                current = .nodes[current].children[slot];
            }
        }
        if !found: {
            return pair{K, V}(first: .missing_key, second: .missing);
        }
        return best;
    }

    
    fn smallest_above(self: &const shared, key: &const K) -> pair{K, V}: {
        var current = .root;
        var best = pair{K, V}(first: .missing_key, second: .missing);
        var found: bool = false;
        while current != BTREE_NIL: {
            let slot = .nodes[current].upper_bound(key);
            if slot < .nodes[current].count: {
                best = .nodes[current].entry_at(slot);
                found = true;
            }
            if .nodes[current].leaf: {
                current = BTREE_NIL;
            } else: {
                current = .nodes[current].children[slot];
            }
        }
        if !found: {
            return pair{K, V}(first: .missing_key, second: .missing);
        }
        return best;
    }

    
    
    
    
    

    fn in_order(self: &const shared, out: &unique vector{pair{K, V}}): {
        if .root == BTREE_NIL: {
            return;
        }
        var stack = vector{pair{int, int}}();
        stack.reserve(BTREE_MAX_HEIGHT);
        stack.push_back(pair{int, int}(first: .root, second: 0));
        while stack.size() > 0: {
            let top = stack.back();
            stack.pop_back();
            let node = top.first;
            let step = top.second;
            if .nodes[node].leaf: {
                var i: int = 0;
                while i < .nodes[node].count: {
                    out.push_back(.nodes[node].entry_at(i));
                    i += 1;
                }
            } else: {
                if step <= .nodes[node].count: {
                    
                    stack.push_back(pair{int, int}(first: node, second: step + 1));
                    if step > 0: {
                        
                        out.push_back(.nodes[node].entry_at(step - 1));
                    }
                    let child = .nodes[node].children[step];
                    if child != BTREE_NIL: {
                        stack.push_back(pair{int, int}(first: child, second: 0));
                    }
                }
            }
        }
        destroy stack;
    }

    fn keys_in_order(self: &const shared, out: &unique vector{K}): {
        var entries = vector{pair{K, V}}();
        .in_order(entries);
        for entry: &const in entries: {
            out.push_back(entry.first);
        }
        destroy entries;
    }

    fn values_in_order(self: &const shared, out: &unique vector{V}): {
        var entries = vector{pair{K, V}}();
        .in_order(entries);
        for entry: &const in entries: {
            out.push_back(entry.second);
        }
        destroy entries;
    }

    fn to_pairs(self: &const shared) -> vector{pair{K, V}}: {
        var out = vector{pair{K, V}}();
        out.reserve(.count);
        .in_order(out);
        return out;
    }

    
    fn level_order(self: &const shared) -> vector{vector{int}}: {
        var levels = vector{vector{int}}();
        if .root == BTREE_NIL: {
            return levels;
        }
        var frontier = vector{int}();
        frontier.push_back(.root);
        while frontier.size() > 0: {
            var next = vector{int}();
            var row = vector{int}();
            for node: &const in frontier: {
                row.push_back(node);
                if !.nodes[node].leaf: {
                    var c: int = 0;
                    while c <= .nodes[node].count: {
                        let child = .nodes[node].children[c];
                        if child != BTREE_NIL: {
                            next.push_back(child);
                        }
                        c += 1;
                    }
                }
            }
            levels.push_back(row);
            frontier = next;
        }
        return levels;
    }

    
    fn leaves(self: &const shared) -> vector{int}: {
        var out = vector{int}();
        if .root == BTREE_NIL: {
            return out;
        }
        var stack = vector{int}();
        stack.reserve(BTREE_MAX_HEIGHT);
        stack.push_back(.root);
        while stack.size() > 0: {
            let node = stack.back();
            stack.pop_back();
            if .nodes[node].leaf: {
                out.push_back(node);
            } else: {
                var c = .nodes[node].count;
                while c >= 0: {
                    let child = .nodes[node].children[c];
                    if child != BTREE_NIL: {
                        stack.push_back(child);
                    }
                    c -= 1;
                }
            }
        }
        destroy stack;
        return out;
    }

    

    
    
    
    
    fn range_query(self: &const shared, low: &const K, high: &const K,
                   out: &unique vector{pair{K, V}}) -> int: {
        if .root == BTREE_NIL: {
            return 0;
        }
        var emitted: int = 0;
        var stack = vector{int}();
        stack.reserve(BTREE_MAX_HEIGHT);
        stack.push_back(.root);
        while stack.size() > 0: {
            let node = stack.back();
            stack.pop_back();
            let first = .nodes[node].lower_bound(low);
            var i = first;
            while i < .nodes[node].count: {
                if compare_keys(.nodes[node].keys[i], *high) >= 0: {
                    i = .nodes[node].count;
                } else: {
                    out.push_back(.nodes[node].entry_at(i));
                    emitted += 1;
                    i += 1;
                }
            }
            if !.nodes[node].leaf: {
                let last = .nodes[node].upper_bound(high);
                var c = first;
                while c <= last: {
                    if c <= .nodes[node].count: {
                        let child = .nodes[node].children[c];
                        if child != BTREE_NIL: {
                            stack.push_back(child);
                        }
                    }
                    c += 1;
                }
            }
        }
        destroy stack;
        return emitted;
    }

    
    fn count_range(self: &const shared, low: &const K, high: &const K) -> int: {
        var scratch = vector{pair{K, V}}();
        let total = .range_query(low, high, scratch);
        destroy scratch;
        return total;
    }

    
    
    fn range_by_leaf(self: &const shared, low: &const K,
                     high: &const K) -> map{int, vector{pair{K, V}}}: {
        var buckets = map{int, vector{pair{K, V}}}();
        let leaf_list = .leaves();
        for leaf: &const in leaf_list: {
            var row = vector{pair{K, V}}();
            var i: int = 0;
            while i < .nodes[leaf].count: {
                let entry = .nodes[leaf].entry_at(i);
                if compare_keys(entry.first, *low) >= 0 &&
                   compare_keys(entry.first, *high) < 0: {
                    row.push_back(entry);
                }
                i += 1;
            }
            if row.size() > 0: {
                discard buckets.insert(leaf, row);
            }
            destroy row;
        }
        return buckets;
    }

    
    
    
    fn range_grouped(self: &const shared, low: &const K,
                     high: &const K) -> map{K, vector{pair{K, vector{V}}}}: {
        var grouped = map{K, vector{pair{K, vector{V}}}}();
        var hits = vector{pair{K, V}}();
        let total = .range_query(low, high, hits);
        if total == 0: {
            destroy hits;
            return grouped;
        }
        var current_group = vector{pair{K, vector{V}}}();
        var group_key = hits[0].first;
        var index: int = 0;
        while index < hits.size(): {
            let entry = hits[index];
            var bag = vector{V}();
            bag.push_back(entry.second);
            current_group.push_back(pair{K, vector{V}}(first: entry.first, second: bag));
            if current_group.size() >= ORDER - 1: {
                discard grouped.insert(group_key, current_group);
                current_group.clear();
                if index + 1 < hits.size(): {
                    group_key = hits[index + 1].first;
                }
            }
            destroy bag;
            index += 1;
        }
        if current_group.size() > 0: {
            discard grouped.insert(group_key, current_group);
        }
        destroy current_group;
        destroy hits;
        return grouped;
    }

    
    fn lower_bound(self: &const shared, key: &const K) -> pair{K, V}: {
        let found = .locate(key);
        if found.first != BTREE_NIL: {
            return .nodes[found.first].entry_at(found.second);
        }
        return .smallest_above(key);
    }

    fn upper_bound(self: &const shared, key: &const K) -> pair{K, V}: {
        return .smallest_above(key);
    }

    
    
    
    
    
    

    fn bulk_fill_width(self: &const shared) -> int: {
        let width = (ORDER - 1) * BTREE_BULK_FILL_PERCENT / 100;
        if width < 1: {
            return 1;
        }
        return width;
    }

    
    
    fn build_leaf_level(self: &unique, sorted: &const shared vector{pair{K, V}},
                        out_separators: &unique vector{pair{K, V}}) -> vector{int}: {
        var level = vector{int}();
        let width = .bulk_fill_width();
        var index: int = 0;
        while index < sorted.size(): {
            let leaf = .allocate_node(true, 0);
            var packed: int = 0;
            while packed < width && index < sorted.size(): {
                .nodes[leaf].push_pair(sorted[index]);
                .count += 1;
                packed += 1;
                index += 1;
            }
            level.push_back(leaf);
            
            
            if index < sorted.size(): {
                out_separators.push_back(sorted[index]);
                index += 1;
            }
        }
        return level;
    }

    
    fn build_branch_level(self: &unique, children: &const shared vector{int},
                          separators: &const shared vector{pair{K, V}},
                          out_separators: &unique vector{pair{K, V}}) -> vector{int}: {
        var level = vector{int}();
        let width = .bulk_fill_width();
        var index: int = 0;
        var sep_index: int = 0;
        while index < children.size(): {
            let branch = .allocate_node(false, 0);
            .nodes[branch].children.push_back(children[index]);
            .set_parent(children[index], branch);
            index += 1;
            var packed: int = 0;
            while packed < width && index < children.size(): {
                if sep_index < separators.size(): {
                    .nodes[branch].push_pair(separators[sep_index]);
                    sep_index += 1;
                }
                .nodes[branch].children.push_back(children[index]);
                .set_parent(children[index], branch);
                packed += 1;
                index += 1;
            }
            level.push_back(branch);
            
            if index < children.size() && sep_index < separators.size(): {
                out_separators.push_back(separators[sep_index]);
                sep_index += 1;
            }
        }
        return level;
    }

    
    
    fn bulk_load(self: &unique, sorted: &const shared vector{pair{K, V}}) -> bool: {
        .clear();
        if sorted.size() == 0: {
            return true;
        }
        var separators = vector{pair{K, V}}();
        var level = .build_leaf_level(sorted, separators);
        var depth: int = 1;
        while level.size() > 1: {
            var next_separators = vector{pair{K, V}}();
            let parents = .build_branch_level(level, separators, next_separators);
            separators = next_separators;
            level = parents;
            depth += 1;
            if depth > BTREE_MAX_HEIGHT: {
                
                
                panic("bulk load exceeded the maximum supported height");
            }
            destroy next_separators;
        }
        .root = level[0];
        .set_parent(.root, BTREE_NIL);
        .restamp_depths(.root, 0);
        .height_hint = depth;
        destroy separators;
        destroy level;
        return true;
    }

    
    
    fn compact(self: &unique) -> bool: {
        var entries = .to_pairs();
        let ok = .bulk_load(entries);
        destroy entries;
        return ok;
    }

    

    fn height(self: &const shared) -> int: {
        if .root == BTREE_NIL: {
            return 0;
        }
        var current = .root;
        var levels: int = 0;
        while current != BTREE_NIL: {
            levels += 1;
            if .nodes[current].leaf: {
                current = BTREE_NIL;
            } else: {
                current = .nodes[current].children[0];
            }
        }
        return levels;
    }

    
    fn leaf_depths(self: &const shared) -> vector{pair{int, int}}: {
        var out = vector{pair{int, int}}();
        if .root == BTREE_NIL: {
            return out;
        }
        var stack = vector{pair{int, int}}();
        stack.reserve(BTREE_MAX_HEIGHT);
        stack.push_back(pair{int, int}(first: .root, second: 0));
        while stack.size() > 0: {
            let top = stack.back();
            stack.pop_back();
            if .nodes[top.first].leaf: {
                out.push_back(pair{int, int}(first: top.first, second: top.second));
            } else: {
                var c: int = 0;
                while c <= .nodes[top.first].count: {
                    let child = .nodes[top.first].children[c];
                    if child != BTREE_NIL: {
                        stack.push_back(pair{int, int}(first: child, second: top.second + 1));
                    }
                    c += 1;
                }
            }
        }
        destroy stack;
        return out;
    }

    
    fn occupancy_histogram(self: &const shared) -> vector{pair{int, int}}: {
        var buckets = vector{pair{int, int}}();
        var slot: int = 0;
        while slot < ORDER: {
            buckets.push_back(pair{int, int}(first: slot, second: 0));
            slot += 1;
        }
        let levels = .level_order();
        for row: &const in levels: {
            for node: &const in row: {
                let filled = .nodes[node].count;
                if filled >= 0 && filled < buckets.size(): {
                    buckets[filled].second += 1;
                }
            }
        }
        return buckets;
    }

    
    fn statistics(self: &const shared) -> BTreeStats{K, V}: {
        var stats = BTreeStats{K, V}();
        stats.splits_seen = .splits;
        stats.merges_seen = .merges;
        if .root == BTREE_NIL: {
            return stats;
        }

        let levels = .level_order();
        stats.height = levels.size();
        var depth: int = 0;
        var lowest = ORDER;
        var highest: int = 0;
        while depth < levels.size(): {
            let row = levels[depth];
            var row_keys: int = 0;
            for node: &const in row: {
                stats.node_count += 1;
                row_keys += .nodes[node].count;
                stats.key_count += .nodes[node].count;
                if .nodes[node].leaf: {
                    stats.leaf_count += 1;
                }
                if .nodes[node].count < lowest: {
                    lowest = .nodes[node].count;
                }
                if .nodes[node].count > highest: {
                    highest = .nodes[node].count;
                }
            }
            stats.per_depth.push_back(pair{int, int}(first: depth, second: row.size()));
            depth += 1;
        }
        stats.min_occupancy = lowest;
        stats.max_occupancy = highest;

        let depths = .leaf_depths();
        var shallowest = BTREE_MAX_HEIGHT;
        var deepest: int = 0;
        for row: &const in depths: {
            if row.second < shallowest: {
                shallowest = row.second;
            }
            if row.second > deepest: {
                deepest = row.second;
            }
        }
        stats.min_leaf_depth = shallowest;
        stats.max_leaf_depth = deepest;
        stats.occupancy_histogram = .occupancy_histogram();

        
        var entries = vector{pair{K, V}}();
        .in_order(entries);
        var taken: int = 0;
        while taken < entries.size() && taken < BTREE_SAMPLE_LIMIT: {
            stats.record_sample(entries[taken]);
            taken += 1;
        }
        destroy entries;
        return stats;
    }

    
    
    
    

    fn check_node_ordering(self: &const shared, node: int) -> bool: {
        var i: int = 1;
        while i < .nodes[node].count: {
            
            assert compare_keys(.nodes[node].keys[i - 1], .nodes[node].keys[i]) < 0;
            prove compare_keys(.nodes[node].keys[i - 1], .nodes[node].keys[i]) < 0;
            i += 1;
        }
        return true;
    }

    fn check_node_arity(self: &const shared, node: int) -> bool: {
        
        
        if .nodes[node].leaf: {
            assert .nodes[node].children.size() == 0;
            prove .nodes[node].child_count() == 0;
        } else: {
            assert .nodes[node].children.size() == .nodes[node].count + 1;
            prove .nodes[node].child_count() == .nodes[node].key_count() + 1;
        }
        return true;
    }

    fn check_occupancy(self: &const shared, node: int) -> bool: {
        
        assert .nodes[node].count <= ORDER - 1;
        prove .nodes[node].count <= .nodes[node].max_keys();
        if node == .root: {
            assert .nodes[node].count >= 1 || .count == 0;
        } else: {
            assert .nodes[node].count >= ORDER / 2 - 1;
            prove .nodes[node].count >= .nodes[node].min_keys();
        }
        return true;
    }

    fn check_separator_bounds(self: &const shared, node: int) -> bool: {
        if .nodes[node].leaf: {
            return true;
        }
        var slot: int = 0;
        while slot <= .nodes[node].count: {
            let child = .nodes[node].children[slot];
            assert child != BTREE_NIL;
            assert .nodes[child].parent == node;
            assert .nodes[child].depth == .nodes[node].depth + 1;

            
            
            if slot > 0: {
                let lower = .nodes[node].keys[slot - 1];
                let least = .minimum_in(child);
                if least.first != BTREE_NIL: {
                    assert compare_keys(lower, .nodes[least.first].keys[least.second]) < 0;
                    prove compare_keys(lower, .nodes[least.first].keys[least.second]) < 0;
                }
            }
            if slot < .nodes[node].count: {
                let upper = .nodes[node].keys[slot];
                let greatest = .maximum_in(child);
                if greatest.first != BTREE_NIL: {
                    assert compare_keys(.nodes[greatest.first].keys[greatest.second],
                                        upper) < 0;
                    prove compare_keys(.nodes[greatest.first].keys[greatest.second],
                                       upper) < 0;
                }
            }
            slot += 1;
        }
        return true;
    }

    fn check_validity(self: &const shared) -> bool: {
        assert .count >= 0;
        assert .count <= .nodes.size() * (ORDER - 1);
        assert ORDER >= 3;

        if .root == BTREE_NIL: {
            
            assert .count == 0;
            prove .count == 0;
            return true;
        }

        assert .nodes[.root].live;
        assert .nodes[.root].parent == BTREE_NIL;
        assert .nodes[.root].depth == 0;
        prove .nodes[.root].parent == BTREE_NIL;

        let levels = .level_order();
        var depth: int = 0;
        while depth < levels.size(): {
            let row = levels[depth];
            for node: &const in row: {
                assert .nodes[node].live;
                assert .nodes[node].depth == depth;
                discard .check_node_ordering(node);
                discard .check_node_arity(node);
                discard .check_occupancy(node);
                discard .check_separator_bounds(node);
            }
            depth += 1;
        }

        
        let depths = .leaf_depths();
        assert depths.size() > 0;
        var index: int = 1;
        while index < depths.size(): {
            assert depths[index].second == depths[0].second;
            prove depths[index].second == depths[0].second;
            index += 1;
        }
        prove depths.size() > 0;

        
        
        var entries = vector{pair{K, V}}();
        .in_order(entries);
        assert entries.size() == .count;
        prove entries.size() == .count;
        var walk: int = 1;
        while walk < entries.size(): {
            assert compare_keys(entries[walk - 1].first, entries[walk].first) < 0;
            prove compare_keys(entries[walk - 1].first, entries[walk].first) < 0;
            walk += 1;
        }
        destroy entries;

        
        
        let measured = .height();
        assert measured > 0;
        assert measured <= BTREE_MAX_HEIGHT;
        prove measured <= BTREE_MAX_HEIGHT;
        return true;
    }

    

    fn clear(self: &unique): {
        for node: &unique in .nodes: {
            node.reset_slots();
            node.live = false;
        }
        .nodes.clear();
        .root = BTREE_NIL;
        .free_list = BTREE_NIL;
        .count = 0;
        .height_hint = 0;
        .splits = 0;
        .merges = 0;
        .borrows = 0;
    }

    fn copy_into(self: &const shared, target: &unique BTree{K, V, ORDER}) -> int: {
        var entries = .to_pairs();
        let added = target.insert_all(entries);
        destroy entries;
        return added;
    }

    nodes: vector{BTreeNode{K, V, ORDER}};
    overflow: map{K, vector{pair{K, V}}};
    pending: vector{pair{K, vector{V}}};
    root: int = -1;
    free_list: int = -1;
    count: int = 0;
    height_hint: int = 0;
    splits: int = 0;
    merges: int = 0;
    borrows: int = 0;
    missing: V;
    missing_key: K;
}






template(T: type)
fn compare_keys(a: &const T, b: &const T) -> int: {
    if a < b: {
        return -1;
    } else: {
        if b < a: {
            return 1;
        } else: {
            return 0;
        }
    }
}



template(K: type, V: type)
fn is_sorted_by_key(entries: &const shared vector{pair{K, V}}) -> bool: {
    var i: int = 1;
    while i < entries.size(): {
        if compare_keys(entries[i - 1].first, entries[i].first) >= 0: {
            return false;
        }
        i += 1;
    }
    return true;
}



template(K: type, V: type)
fn merge_sorted(left: &const shared vector{pair{K, V}},
                right: &const shared vector{pair{K, V}}) -> vector{pair{K, V}}: {
    var out = vector{pair{K, V}}();
    out.reserve(left.size() + right.size());
    var i: int = 0;
    var j: int = 0;
    while i < left.size() && j < right.size(): {
        let order = compare_keys(left[i].first, right[j].first);
        if order < 0: {
            out.push_back(left[i]);
            i += 1;
        } else: {
            if order > 0: {
                out.push_back(right[j]);
                j += 1;
            } else: {
                out.push_back(left[i]);
                i += 1;
                j += 1;
            }
        }
    }
    while i < left.size(): {
        out.push_back(left[i]);
        i += 1;
    }
    while j < right.size(): {
        out.push_back(right[j]);
        j += 1;
    }
    return out;
}


template(K: type, V: type, ORDER: int)
fn merge_into(target: &unique BTree{K, V, ORDER},
              source: &const shared BTree{K, V, ORDER}) -> int: {
    var entries = source.to_pairs();
    let added = target.insert_all(entries);
    destroy entries;
    return added;
}



template(K: type, V: type, ORDER: int)
fn union_of(left: &const shared BTree{K, V, ORDER},
            right: &const shared BTree{K, V, ORDER}) -> BTree{K, V, ORDER}: {
    var out = BTree{K, V, ORDER}();
    var a = left.to_pairs();
    var b = right.to_pairs();
    var merged = merge_sorted{K, V}(a, b);
    discard out.bulk_load(merged);
    destroy merged;
    destroy a;
    destroy b;
    return out;
}


template(K: type, V: type, ORDER: int)
fn intersection_of(left: &const shared BTree{K, V, ORDER},
                   right: &const shared BTree{K, V, ORDER}) -> vector{pair{K, V}}: {
    var out = vector{pair{K, V}}();
    var entries = left.to_pairs();
    for entry: &const in entries: {
        if right.contains(entry.first): {
            out.push_back(entry);
        }
    }
    destroy entries;
    return out;
}



template(K: type, V: type, ORDER: int)
fn erase_range(tree: &unique BTree{K, V, ORDER}, low: &const K, high: &const K) -> int: {
    var doomed = vector{pair{K, V}}();
    let found = tree.range_query(low, high, doomed);
    var removed: int = 0;
    if found == 0: {
        destroy doomed;
        return 0;
    }
    for entry: &const in doomed: {
        if tree.erase(entry.first): {
            removed += 1;
        }
    }
    destroy doomed;
    return removed;
}




template(K: type, V: type, ORDER: int)
fn chunk_by_width(tree: &const shared BTree{K, V, ORDER},
                  width: int) -> map{K, vector{pair{K, vector{V}}}}: {
    var chunks = map{K, vector{pair{K, vector{V}}}}();
    var entries = tree.to_pairs();
    if entries.size() == 0: {
        destroy entries;
        return chunks;
    }
    var bucket = vector{pair{K, vector{V}}}();
    var bucket_key = entries[0].first;
    var index: int = 0;
    while index < entries.size(): {
        var values = vector{V}();
        values.push_back(entries[index].second);
        bucket.push_back(pair{K, vector{V}}(first: entries[index].first, second: values));
        destroy values;
        if bucket.size() >= width: {
            discard chunks.insert(bucket_key, bucket);
            bucket.clear();
            if index + 1 < entries.size(): {
                bucket_key = entries[index + 1].first;
            }
        }
        index += 1;
    }
    if bucket.size() > 0: {
        discard chunks.insert(bucket_key, bucket);
    }
    destroy bucket;
    destroy entries;
    return chunks;
}


template(K: type, V: type)
fn flatten_groups(groups: &const shared vector{pair{K, vector{V}}}) -> vector{pair{K, V}}: {
    var out = vector{pair{K, V}}();
    for group: &const in groups: {
        for value: &const in group.second: {
            out.push_back(pair{K, V}(first: group.first, second: value));
        }
    }
    return out;
}


template(K: type, V: type, ORDER: int)
fn tree_equal(left: &const shared BTree{K, V, ORDER},
              right: &const shared BTree{K, V, ORDER}) -> bool: {
    if left.size() != right.size(): {
        return false;
    }
    var a = left.to_pairs();
    var b = right.to_pairs();
    var index: int = 0;
    var same: bool = true;
    while index < a.size(): {
        if compare_keys(a[index].first, b[index].first) != 0: {
            same = false;
            index = a.size();
        } else: {
            index += 1;
        }
    }
    destroy a;
    destroy b;
    return same;
}




template(K: type, V: type, FROM: int, TO: int)
fn rebalance_to_order(source: &const shared BTree{K, V, FROM},
                      target: &unique BTree{K, V, TO}) -> bool: {
    var entries = source.to_pairs();
    if !is_sorted_by_key{K, V}(entries): {
        destroy entries;
        return false;
    }
    let ok = target.bulk_load(entries);
    destroy entries;
    return ok;
}


template(K: type, V: type, ORDER: int)
fn describe_shape(tree: &const shared BTree{K, V, ORDER}) -> string: {
    var stats = tree.statistics();
    var text = stats.describe();
    text.append(" order=");
    text.append(to_string(ORDER));
    text.append(" balanced=");
    if stats.balanced(): {
        text.append("yes");
    } else: {
        text.append("no");
    }
    return text;
}





fn demo_b_tree(): {
    var tree = BTree{int, string, 6}();
    tree.reserve(BTREE_INITIAL_CAPACITY);

    
    for i in range(0, 64): {
        discard tree.insert(i * 37 % 64, to_string(i));
    }
    println(describe_shape{int, string, 6}(tree));
    if !tree.check_validity(): {
        panic("B-tree invariants violated after bulk insert");
    }

    
    var index: int = 0;
    while index < 64: {
        if index % 3 == 0: {
            discard tree.erase(index);
        }
        index += 1;
    }
    if !tree.check_validity(): {
        panic("B-tree invariants violated after bulk erase");
    }

    
    var window = vector{pair{int, string}}();
    let hits = tree.range_query(16, 48, window);
    println(to_string(hits));
    for entry: &const in window: {
        println(entry.second);
    }
    destroy window;

    
    var grouped = tree.range_grouped(0, 64);
    println(to_string(grouped.size()));
    destroy grouped;

    
    var wide = BTree{int, string, 16}();
    if !rebalance_to_order{int, string, 6, 16}(tree, wide): {
        panic("rebalance produced an unsorted run");
    }
    if !wide.check_validity(): {
        panic("B-tree invariants violated after bulk load");
    }
    println(describe_shape{int, string, 16}(wide));

    
    let before = tree.predecessor(32);
    let after = tree.successor(32);
    println(to_string(before.first));
    println(to_string(after.first));

    
    var stats = tree.statistics();
    println(to_string(stats.height));
    println(to_string(stats.average_occupancy()));
    println(to_string(stats.leaf_fraction_percent()));
    for bucket: &const in stats.occupancy_histogram: {
        println(to_string(bucket.second));
    }
    destroy stats;

    destroy wide;
    destroy tree;
}

}







namespace bignum: {





static LIMB_BITS: int = 30;


static LIMB_BASE: int = 1073741824;


static LIMB_MASK: int = 1073741823;


static LIMB_HALF: int = 536870912;



static DECIMAL_DIGITS_PER_CHUNK: int = 8;


static DECIMAL_CHUNK_BASE: int = 100000000;



static KARATSUBA_THRESHOLD: int = 24;


static DIVISION_ITERATION_LIMIT: int = 100000;


static CHAR_ZERO: int = 48;      
static CHAR_NINE: int = 57;      
static CHAR_MINUS: int = 45;     
static CHAR_PLUS: int = 43;      
static CHAR_UNDERSCORE: int = 95; 


static var limb_product_count: int = 0;




enum Ordering: {
    Less;
    Equal;
    Greater = 2;
}


enum Sign: {
    Negative;
    Zero;
    Positive = 2;
}


enum ParseStatus: {
    Ok;
    EmptyInput;
    BadDigit;
    Overflow = 3;
}



struct BigInt: {

    

    
    
    fn is_zero(self: &const shared) -> bool: {
        return .limbs.size() == 0;
    }

    fn limb_count(self: &const shared) -> int: {
        return .limbs.size();
    }

    
    
    fn limb_at(self: &const shared, index: int) -> int: {
        if index < 0 || index >= .limbs.size(): {
            return 0;
        }
        return .limbs[index];
    }

    fn sign(self: &const shared) -> Sign: {
        if .limbs.size() == 0: {
            return Sign::Zero;
        }
        if .negative: {
            return Sign::Negative;
        }
        return Sign::Positive;
    }

    fn is_negative(self: &const shared) -> bool: {
        return .negative && .limbs.size() > 0;
    }

    fn is_positive(self: &const shared) -> bool: {
        return !.negative && .limbs.size() > 0;
    }

    fn is_even(self: &const shared) -> bool: {
        return .limbs.size() == 0 || (.limbs[0] & 1) == 0;
    }

    fn is_odd(self: &const shared) -> bool: {
        return .limbs.size() > 0 && (.limbs[0] & 1) == 1;
    }

    
    fn fits_in_limb(self: &const shared) -> bool: {
        return .limbs.size() <= 1;
    }

    

    
    fn ensure_limb(self: &unique, index: int): {
        while .limbs.size() <= index: {
            .limbs.push_back(0);
        }
    }

    fn set_limb(self: &unique, index: int, value: int): {
        .ensure_limb(index);
        .limbs[index] = value & LIMB_MASK;
    }

    
    
    fn normalise(self: &unique): {
        while .limbs.size() > 0 && .limbs[.limbs.size() - 1] == 0: {
            .limbs.pop_back();
        }
        if .limbs.size() == 0: {
            .negative = false;
        }
    }

    fn set_zero(self: &unique): {
        .limbs.clear();
        .negative = false;
    }

    
    fn assign_small(self: &unique, value: int): {
        .limbs.clear();
        .negative = value < 0;
        var magnitude = abs(value);
        while magnitude > 0: {
            .limbs.push_back(magnitude & LIMB_MASK);
            magnitude = magnitude >> LIMB_BITS;
        }
        .normalise();
    }

    fn clone(self: &const shared) -> BigInt: {
        var out = BigInt();
        out.negative = .negative;
        for limb: &const in .limbs: {
            out.limbs.push_back(limb);
        }
        return out;
    }

    
    fn negate(self: &unique): {
        if .limbs.size() > 0: {
            .negative = !.negative;
        }
    }

    fn absolute(self: &const shared) -> BigInt: {
        var out = .clone();
        out.negative = false;
        return out;
    }

    

    
    fn bit_length(self: &const shared) -> int: {
        if .limbs.size() == 0: {
            return 0;
        }
        var top = .limbs[.limbs.size() - 1];
        var bits: int = 0;
        while top > 0: {
            bits += 1;
            top = top >> 1;
        }
        return (.limbs.size() - 1) * LIMB_BITS + bits;
    }

    fn get_bit(self: &const shared, position: int) -> int: {
        if position < 0: {
            return 0;
        }
        return (.limb_at(position / LIMB_BITS) >> (position % LIMB_BITS)) & 1;
    }

    fn set_bit(self: &unique, position: int): {
        let index = position / LIMB_BITS;
        .ensure_limb(index);
        .limbs[index] = .limbs[index] | (1 << (position % LIMB_BITS));
    }

    fn clear_bit(self: &unique, position: int): {
        let index = position / LIMB_BITS;
        if index < .limbs.size(): {
            .limbs[index] = .limbs[index] & (LIMB_MASK ^ (1 << (position % LIMB_BITS)));
            .normalise();
        }
    }

    
    fn population_count(self: &const shared) -> int: {
        var total: int = 0;
        for limb: &const in .limbs: {
            var word = limb;
            while word > 0: {
                total += word & 1;
                word = word >> 1;
            }
        }
        return total;
    }

    
    fn lowest_set_bit(self: &const shared) -> int: {
        var index: int = 0;
        while index < .limbs.size(): {
            if .limbs[index] != 0: {
                var word = .limbs[index];
                var offset: int = 0;
                while (word & 1) == 0: {
                    word = word >> 1;
                    offset += 1;
                }
                return index * LIMB_BITS + offset;
            }
            index += 1;
        }
        return -1;
    }

    

    
    
    fn compare_magnitude(self: &const shared, other: &const shared BigInt) -> Ordering: {
        if .limbs.size() != other.limbs.size(): {
            if .limbs.size() < other.limbs.size(): {
                return Ordering::Less;
            }
            return Ordering::Greater;
        }
        var index = .limbs.size() - 1;
        while index >= 0: {
            if .limbs[index] != other.limbs[index]: {
                if .limbs[index] < other.limbs[index]: {
                    return Ordering::Less;
                }
                return Ordering::Greater;
            }
            index -= 1;
        }
        return Ordering::Equal;
    }

    
    fn compare(self: &const shared, other: &const shared BigInt) -> Ordering: {
        if .is_negative() && !other.is_negative(): {
            return Ordering::Less;
        }
        if !.is_negative() && other.is_negative(): {
            return Ordering::Greater;
        }
        let magnitude = .compare_magnitude(other);
        if !.is_negative(): {
            return magnitude;
        }
        if magnitude == Ordering::Less: {
            return Ordering::Greater;
        }
        if magnitude == Ordering::Greater: {
            return Ordering::Less;
        }
        return Ordering::Equal;
    }

    fn equals(self: &const shared, other: &const shared BigInt) -> bool: {
        return .compare(other) == Ordering::Equal;
    }

    fn less_than(self: &const shared, other: &const shared BigInt) -> bool: {
        return .compare(other) == Ordering::Less;
    }

    
    
    fn compare_small(self: &const shared, value: int) -> Ordering: {
        var scratch = BigInt();
        scratch.assign_small(value);
        return .compare(scratch);
    }

    limbs: vector{int};
    negative: bool = false;
}




fn make_zero() -> BigInt: {
    var out = BigInt();
    out.negative = false;
    return out;
}

fn make_one() -> BigInt: {
    var out = BigInt();
    out.limbs.push_back(1);
    return out;
}

fn make_from_int(value: int) -> BigInt: {
    var out = BigInt();
    out.assign_small(value);
    return out;
}



fn make_from_limbs(source: &const shared vector{int}, negative: bool) -> BigInt: {
    var out = BigInt();
    out.negative = negative;
    for limb: &const in source: {
        out.limbs.push_back(limb & LIMB_MASK);
    }
    out.normalise();
    return out;
}








fn add_magnitude(a: &const shared BigInt, b: &const shared BigInt) -> BigInt: {
    var out = BigInt();
    let length = max(a.limb_count(), b.limb_count());
    var carry: int = 0;
    var index: int = 0;
    while index < length: {
        let total = carry + a.limb_at(index) + b.limb_at(index);
        out.limbs.push_back(total & LIMB_MASK);
        carry = total >> LIMB_BITS;
        index += 1;
    }
    if carry > 0: {
        out.limbs.push_back(carry & LIMB_MASK);
    }
    out.normalise();
    return out;
}






fn sub_magnitude(a: &const shared BigInt, b: &const shared BigInt) -> BigInt: {
    var out = BigInt();
    var borrow: int = 0;
    var index: int = 0;
    while index < a.limb_count(): {
        let difference = a.limb_at(index) - b.limb_at(index) - borrow + LIMB_BASE;
        out.limbs.push_back(difference & LIMB_MASK);
        borrow = 1 - (difference >> LIMB_BITS);
        index += 1;
    }
    out.normalise();
    return out;
}


fn add_small_magnitude(a: &const shared BigInt, small: int) -> BigInt: {
    var out = a.absolute();
    var carry = small;
    var index: int = 0;
    while carry > 0: {
        out.ensure_limb(index);
        let total = out.limbs[index] + (carry & LIMB_MASK);
        out.limbs[index] = total & LIMB_MASK;
        carry = (carry >> LIMB_BITS) + (total >> LIMB_BITS);
        index += 1;
    }
    out.normalise();
    return out;
}





fn add(a: &const shared BigInt, b: &const shared BigInt) -> BigInt: {
    if a.is_negative() == b.is_negative(): {
        var out = add_magnitude(a, b);
        out.negative = a.is_negative() && out.limbs.size() > 0;
        return out;
    }
    let ordering = a.compare_magnitude(b);
    if ordering == Ordering::Equal: {
        return make_zero();
    }
    if ordering == Ordering::Greater: {
        var out = sub_magnitude(a, b);
        out.negative = a.is_negative() && out.limbs.size() > 0;
        return out;
    }
    var out = sub_magnitude(b, a);
    out.negative = b.is_negative() && out.limbs.size() > 0;
    return out;
}



fn subtract(a: &const shared BigInt, b: &const shared BigInt) -> BigInt: {
    var flipped = b.clone();
    flipped.negate();
    let out = add(a, flipped);
    destroy flipped;
    return out;
}

fn negated(a: &const shared BigInt) -> BigInt: {
    var out = a.clone();
    out.negate();
    return out;
}



fn add_small(a: &const shared BigInt, small: int) -> BigInt: {
    if small == 0: {
        return a.clone();
    }
    if a.is_negative() == (small < 0): {
        var out = add_small_magnitude(a, abs(small));
        out.negative = a.is_negative() || small < 0;
        out.normalise();
        return out;
    }
    let other = make_from_int(small);
    return add(a, other);
}







fn schoolbook_multiply(a: &const shared BigInt, b: &const shared BigInt) -> BigInt: {
    var result = BigInt();
    if a.is_zero() || b.is_zero(): {
        return result;
    }
    result.limbs.resize(a.limb_count() + b.limb_count());
    var i: int = 0;
    while i < a.limb_count(): {
        var carry: int = 0;
        var j: int = 0;
        while j < b.limb_count(): {
            let total = carry + a.limbs[i] * b.limbs[j] + result.limbs[i + j];
            result.limbs[i + j] = total & LIMB_MASK;
            carry = total >> LIMB_BITS;
            limb_product_count += 1;
            j += 1;
        }
        
        
        var k = i + b.limb_count();
        while carry > 0: {
            let total = carry + result.limbs[k];
            result.limbs[k] = total & LIMB_MASK;
            carry = total >> LIMB_BITS;
            k += 1;
        }
        i += 1;
    }
    result.negative = a.is_negative() != b.is_negative();
    result.normalise();
    return result;
}



fn multiply_small(a: &const shared BigInt, small: int) -> BigInt: {
    var result = BigInt();
    if a.is_zero() || small == 0: {
        return result;
    }
    let magnitude = abs(small);
    var carry: int = 0;
    var index: int = 0;
    while index < a.limb_count(): {
        let total = carry + a.limbs[index] * (magnitude & LIMB_MASK);
        result.limbs.push_back(total & LIMB_MASK);
        carry = total >> LIMB_BITS;
        index += 1;
    }
    while carry > 0: {
        result.limbs.push_back(carry & LIMB_MASK);
        carry = carry >> LIMB_BITS;
    }
    result.negative = a.is_negative() != (small < 0);
    result.normalise();
    return result;
}




fn square(a: &const shared BigInt) -> BigInt: {
    var result = BigInt();
    if a.is_zero(): {
        return result;
    }
    result.limbs.resize(a.limb_count() * 2 + 1);
    var i: int = 0;
    while i < a.limb_count(): {
        let diagonal = result.limbs[i + i] + a.limbs[i] * a.limbs[i];
        result.limbs[i + i] = diagonal & LIMB_MASK;
        var carry = diagonal >> LIMB_BITS;
        var j = i + 1;
        while j < a.limb_count(): {
            let total = carry + result.limbs[i + j] + a.limbs[i] * a.limbs[j] * 2;
            result.limbs[i + j] = total & LIMB_MASK;
            carry = total >> LIMB_BITS;
            limb_product_count += 1;
            j += 1;
        }
        var k = i + a.limb_count();
        while carry > 0: {
            let total = carry + result.limbs[k];
            result.limbs[k] = total & LIMB_MASK;
            carry = total >> LIMB_BITS;
            k += 1;
        }
        i += 1;
    }
    result.negative = false;
    result.normalise();
    return result;
}




fn shift_left_limbs(a: &const shared BigInt, count: int) -> BigInt: {
    var out = BigInt();
    if a.is_zero() || count < 0: {
        return out;
    }
    for i in range(0, count): {
        out.limbs.push_back(0);
    }
    for limb: &const in a.limbs: {
        out.limbs.push_back(limb);
    }
    out.negative = a.is_negative();
    out.normalise();
    return out;
}



fn shift_right_limbs(a: &const shared BigInt, count: int) -> BigInt: {
    var out = BigInt();
    var index = count;
    while index < a.limb_count(): {
        out.limbs.push_back(a.limbs[index]);
        index += 1;
    }
    out.negative = a.is_negative();
    out.normalise();
    return out;
}




fn shift_left(a: &const shared BigInt, bits: int) -> BigInt: {
    if bits <= 0 || a.is_zero(): {
        return a.clone();
    }
    let whole = bits / LIMB_BITS;
    let partial = bits % LIMB_BITS;
    var out = BigInt();
    for i in range(0, whole): {
        out.limbs.push_back(0);
    }
    if partial == 0: {
        for limb: &const in a.limbs: {
            out.limbs.push_back(limb);
        }
    } else: {
        var carry: int = 0;
        var index: int = 0;
        while index < a.limb_count(): {
            let total = ((a.limbs[index] << partial) & LIMB_MASK) | carry;
            out.limbs.push_back(total & LIMB_MASK);
            carry = (a.limbs[index] >> (LIMB_BITS - partial)) & LIMB_MASK;
            index += 1;
        }
        if carry > 0: {
            out.limbs.push_back(carry);
        }
    }
    out.negative = a.is_negative();
    out.normalise();
    return out;
}




fn shift_right(a: &const shared BigInt, bits: int) -> BigInt: {
    if bits <= 0 || a.is_zero(): {
        return a.clone();
    }
    let whole = bits / LIMB_BITS;
    let partial = bits % LIMB_BITS;
    var out = BigInt();
    if whole >= a.limb_count(): {
        return out;
    }
    var index = whole;
    while index < a.limb_count(): {
        if partial == 0: {
            out.limbs.push_back(a.limbs[index]);
        } else: {
            let assembled = (a.limbs[index] >> partial)
                | ((a.limb_at(index + 1) << (LIMB_BITS - partial)) & LIMB_MASK);
            out.limbs.push_back(assembled & LIMB_MASK);
        }
        index += 1;
    }
    out.negative = a.is_negative();
    out.normalise();
    return out;
}







fn bitwise_and(a: &const shared BigInt, b: &const shared BigInt) -> BigInt: {
    var out = BigInt();
    let length = min(a.limb_count(), b.limb_count());
    var index: int = 0;
    while index < length: {
        out.limbs.push_back(a.limbs[index] & b.limbs[index]);
        index += 1;
    }
    out.negative = a.is_negative() && b.is_negative();
    out.normalise();
    return out;
}

fn bitwise_or(a: &const shared BigInt, b: &const shared BigInt) -> BigInt: {
    var out = BigInt();
    let length = max(a.limb_count(), b.limb_count());
    var index: int = 0;
    while index < length: {
        out.limbs.push_back(a.limb_at(index) | b.limb_at(index));
        index += 1;
    }
    out.negative = a.is_negative() || b.is_negative();
    out.normalise();
    return out;
}

fn bitwise_xor(a: &const shared BigInt, b: &const shared BigInt) -> BigInt: {
    var out = BigInt();
    let length = max(a.limb_count(), b.limb_count());
    var index: int = 0;
    while index < length: {
        out.limbs.push_back(a.limb_at(index) ^ b.limb_at(index));
        index += 1;
    }
    out.negative = a.is_negative() != b.is_negative();
    out.normalise();
    return out;
}



fn bitwise_not_width(a: &const shared BigInt, width: int) -> BigInt: {
    var out = BigInt();
    let limbs_needed = (width + LIMB_BITS - 1) / LIMB_BITS;
    var index: int = 0;
    while index < limbs_needed: {
        out.limbs.push_back((~a.limb_at(index)) & LIMB_MASK);
        index += 1;
    }
    let overhang = width % LIMB_BITS;
    if overhang != 0 && out.limbs.size() > 0: {
        let top = out.limbs.size() - 1;
        out.limbs[top] = out.limbs[top] & ((1 << overhang) - 1);
    }
    out.negative = false;
    out.normalise();
    return out;
}




fn low_part(a: &const shared BigInt, count: int) -> BigInt: {
    var out = BigInt();
    var index: int = 0;
    while index < count && index < a.limb_count(): {
        out.limbs.push_back(a.limbs[index]);
        index += 1;
    }
    out.negative = false;
    out.normalise();
    return out;
}


fn high_part(a: &const shared BigInt, count: int) -> BigInt: {
    var out = BigInt();
    var index = count;
    while index < a.limb_count(): {
        out.limbs.push_back(a.limbs[index]);
        index += 1;
    }
    out.negative = false;
    out.normalise();
    return out;
}







fn karatsuba_multiply(a: &const shared BigInt, b: &const shared BigInt) -> BigInt: {
    if a.is_zero() || b.is_zero(): {
        return make_zero();
    }
    if a.limb_count() < KARATSUBA_THRESHOLD || b.limb_count() < KARATSUBA_THRESHOLD: {
        return schoolbook_multiply(a, b);
    }

    let split = max(a.limb_count(), b.limb_count()) / 2;
    let a_low = low_part(a, split);
    let a_high = high_part(a, split);
    let b_low = low_part(b, split);
    let b_high = high_part(b, split);

    let high_product = karatsuba_multiply(a_high, b_high);
    let low_product = karatsuba_multiply(a_low, b_low);
    let cross_sum_a = add_magnitude(a_low, a_high);
    let cross_sum_b = add_magnitude(b_low, b_high);
    let cross_raw = karatsuba_multiply(cross_sum_a, cross_sum_b);
    let middle = subtract(subtract(cross_raw, high_product), low_product);

    
    var result = add(add(shift_left_limbs(high_product, split + split),
        shift_left_limbs(middle, split)), low_product);
    result.negative = a.is_negative() != b.is_negative() && !result.is_zero();
    result.normalise();
    return result;
}


fn multiply(a: &const shared BigInt, b: &const shared BigInt) -> BigInt: {
    if a.is_zero() || b.is_zero(): {
        return make_zero();
    }
    if a.limb_count() == 1 && b.limb_count() == 1: {
        
        
        var out = BigInt();
        let total = a.limbs[0] * b.limbs[0];
        out.limbs.push_back(total & LIMB_MASK);
        out.limbs.push_back(total >> LIMB_BITS);
        out.negative = a.is_negative() != b.is_negative();
        out.normalise();
        return out;
    }
    if a.limb_count() + b.limb_count() < KARATSUBA_THRESHOLD * 2: {
        return schoolbook_multiply(a, b);
    }
    return karatsuba_multiply(a, b);
}




struct DivisionResult: {
    quotient: BigInt;
    remainder: BigInt;
    exact: bool = false;
}






fn divide_small(a: &const shared BigInt, divisor: int) -> DivisionResult: {
    var out = DivisionResult();
    if divisor == 0: {
        panic("bignum: division by zero");
        return out;
    }
    let magnitude = abs(divisor);
    out.quotient.limbs.resize(a.limb_count());
    var rest: int = 0;
    var index = a.limb_count() - 1;
    while index >= 0: {
        let numerator = rest * LIMB_BASE + a.limbs[index];
        out.quotient.limbs[index] = (numerator / magnitude) & LIMB_MASK;
        rest = numerator % magnitude;
        index -= 1;
    }
    out.quotient.negative = a.is_negative() != (divisor < 0);
    out.quotient.normalise();
    out.remainder.assign_small(rest);
    out.remainder.negative = a.is_negative() && rest != 0;
    out.remainder.normalise();
    out.exact = rest == 0;
    return out;
}




fn estimate_quotient_limb(rest: &const shared BigInt, divisor: &const shared BigInt, offset: int) -> int: {
    let top = divisor.limbs[divisor.limb_count() - 1];
    let high = rest.limb_at(offset + divisor.limb_count());
    let low = rest.limb_at(offset + divisor.limb_count() - 1);
    var guess = (high * LIMB_BASE + low) / top;
    if guess > LIMB_MASK: {
        guess = LIMB_MASK;
    }
    if guess < 0: {
        guess = 0;
    }
    return guess;
}






fn long_divide(a: &const shared BigInt, b: &const shared BigInt) -> DivisionResult: {
    var out = DivisionResult();
    if b.is_zero(): {
        panic("bignum: division by zero");
        return out;
    }
    let dividend = a.absolute();
    let divisor = b.absolute();
    if dividend.compare_magnitude(divisor) == Ordering::Less: {
        out.quotient = make_zero();
        out.remainder = a.clone();
        out.exact = a.is_zero();
        return out;
    }
    if divisor.limb_count() == 1: {
        var small = divide_small(dividend, divisor.limbs[0]);
        small.quotient.negative = a.is_negative() != b.is_negative() && !small.quotient.is_zero();
        small.remainder.negative = a.is_negative() && !small.remainder.is_zero();
        small.quotient.normalise();
        small.remainder.normalise();
        return small;
    }

    var rest = dividend.clone();
    let steps = dividend.limb_count() - divisor.limb_count();
    out.quotient.limbs.resize(steps + 1);
    var offset = steps;
    var guard: int = 0;
    while offset >= 0: {
        var guess = estimate_quotient_limb(rest, divisor, offset);
        var trial = shift_left_limbs(multiply_small(divisor, guess), offset);
        
        
        while trial.compare_magnitude(rest) == Ordering::Greater && guess > 0: {
            guess -= 1;
            trial = shift_left_limbs(multiply_small(divisor, guess), offset);
            guard += 1;
            if guard > DIVISION_ITERATION_LIMIT: {
                panic("bignum: division failed to converge");
                return out;
            }
        }
        
        var next_trial = shift_left_limbs(multiply_small(divisor, guess + 1), offset);
        while next_trial.compare_magnitude(rest) != Ordering::Greater: {
            guess += 1;
            trial = next_trial;
            next_trial = shift_left_limbs(multiply_small(divisor, guess + 1), offset);
            guard += 1;
            if guard > DIVISION_ITERATION_LIMIT: {
                panic("bignum: division failed to converge");
                return out;
            }
        }
        rest = sub_magnitude(rest, trial);
        out.quotient.limbs[offset] = guess & LIMB_MASK;
        destroy trial;
        offset -= 1;
    }

    out.quotient.negative = a.is_negative() != b.is_negative();
    out.quotient.normalise();
    out.remainder = rest;
    out.remainder.negative = a.is_negative() && !rest.is_zero();
    out.remainder.normalise();
    out.exact = out.remainder.is_zero();
    return out;
}

fn divide(a: &const shared BigInt, b: &const shared BigInt) -> BigInt: {
    let result = long_divide(a, b);
    return result.quotient;
}

fn remainder(a: &const shared BigInt, b: &const shared BigInt) -> BigInt: {
    let result = long_divide(a, b);
    return result.remainder;
}



fn modulus(a: &const shared BigInt, b: &const shared BigInt) -> BigInt: {
    var rest = remainder(a, b);
    if rest.is_negative(): {
        let magnitude = b.absolute();
        rest = add(rest, magnitude);
    }
    rest.normalise();
    return rest;
}

fn divides_evenly(a: &const shared BigInt, b: &const shared BigInt) -> bool: {
    return long_divide(a, b).exact;
}



fn mod_add(a: &const shared BigInt, b: &const shared BigInt, m: &const shared BigInt) -> BigInt: {
    return modulus(add(a, b), m);
}

fn mod_sub(a: &const shared BigInt, b: &const shared BigInt, m: &const shared BigInt) -> BigInt: {
    return modulus(subtract(a, b), m);
}

fn mod_mul(a: &const shared BigInt, b: &const shared BigInt, m: &const shared BigInt) -> BigInt: {
    return modulus(multiply(a, b), m);
}



fn mod_pow(base: &const shared BigInt, exponent: &const shared BigInt, m: &const shared BigInt) -> BigInt: {
    if m.is_zero(): {
        panic("bignum: modulus must be non-zero");
        return make_zero();
    }
    var result = make_one();
    var running = modulus(base, m);
    let bits = exponent.bit_length();
    var index: int = 0;
    while index < bits: {
        if exponent.get_bit(index) == 1: {
            result = modulus(multiply(result, running), m);
        }
        running = modulus(square(running), m);
        index += 1;
    }
    result.normalise();
    return result;
}


fn power(base: &const shared BigInt, exponent: int) -> BigInt: {
    if exponent < 0: {
        panic("bignum: negative exponent");
        return make_zero();
    }
    var result = make_one();
    var running = base.clone();
    var rest = exponent;
    while rest > 0: {
        if (rest & 1) == 1: {
            result = multiply(result, running);
        }
        running = square(running);
        rest = rest >> 1;
    }
    return result;
}





fn gcd_euclid(a: &const shared BigInt, b: &const shared BigInt) -> BigInt: {
    var x = a.absolute();
    var y = b.absolute();
    while !y.is_zero(): {
        let rest = remainder(x, y);
        x = y;
        y = rest;
    }
    x.normalise();
    return x;
}



fn gcd(a: &const shared BigInt, b: &const shared BigInt) -> BigInt: {
    var x = a.absolute();
    var y = b.absolute();
    if x.is_zero(): {
        return y;
    }
    if y.is_zero(): {
        return x;
    }
    let common = min(x.lowest_set_bit(), y.lowest_set_bit());
    x = shift_right(x, x.lowest_set_bit());
    y = shift_right(y, y.lowest_set_bit());
    while !y.is_zero(): {
        if x.compare_magnitude(y) == Ordering::Greater: {
            swap(x, y);
        }
        y = sub_magnitude(y, x);
        if !y.is_zero(): {
            y = shift_right(y, y.lowest_set_bit());
        }
    }
    return shift_left(x, common);
}

fn lcm(a: &const shared BigInt, b: &const shared BigInt) -> BigInt: {
    if a.is_zero() || b.is_zero(): {
        return make_zero();
    }
    let divisor = gcd(a, b);
    return divide(multiply(a, b).absolute(), divisor);
}










fn impl (a + b)(l: &const shared BigInt, r: &const shared BigInt) -> BigInt: {
    return add(l, r);
}


fn impl (a - b)(l: &const shared BigInt, r: &const shared BigInt) -> BigInt: {
    return subtract(l, r);
}


fn impl (a * b)(l: &const shared BigInt, r: &const shared BigInt) -> BigInt: {
    return multiply(l, r);
}



fn impl (a / b)(l: &const shared BigInt, r: &const shared BigInt) -> BigInt: {
    return divide(l, r);
}



fn impl (a % b)(l: &const shared BigInt, r: &const shared BigInt) -> BigInt: {
    return remainder(l, r);
}






fn impl (a < b)(l: &const shared BigInt, r: &const shared BigInt) -> bool: {
    return l.compare(r) == Ordering::Less;
}

fn impl (a <= b)(l: &const shared BigInt, r: &const shared BigInt) -> bool: {
    return l.compare(r) != Ordering::Greater;
}

fn impl (a > b)(l: &const shared BigInt, r: &const shared BigInt) -> bool: {
    return l.compare(r) == Ordering::Greater;
}

fn impl (a >= b)(l: &const shared BigInt, r: &const shared BigInt) -> bool: {
    return l.compare(r) != Ordering::Less;
}

fn impl (a == b)(l: &const shared BigInt, r: &const shared BigInt) -> bool: {
    return l.compare(r) == Ordering::Equal;
}

fn impl (a != b)(l: &const shared BigInt, r: &const shared BigInt) -> bool: {
    return l.compare(r) != Ordering::Equal;
}




fn impl (-a)(l: &const shared BigInt) -> BigInt: {
    return negated(l);
}








static DIGIT_TABLE_LOWER: string = "0123456789abcdefghijklmnopqrstuvwxyz";
static DIGIT_TABLE_UPPER: string = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ";


static MAX_RADIX: int = 36;
static BITS_PER_NIBBLE: int = 4;
static NIBBLE_MASK: int = 15;



fn code_of(c: char) -> int: {
    return c;
}



fn power_of_ten(count: int) -> int: {
    var result: int = 1;
    var index: int = 0;
    while index < count: {
        result = result * 10;
        index += 1;
    }
    return result;
}


fn decimal_digit_value(code: int) -> int: {
    if code < CHAR_ZERO || code > CHAR_NINE: {
        return -1;
    }
    return code - CHAR_ZERO;
}


fn digit_char(value: int, upper: bool) -> char: {
    if upper: {
        return DIGIT_TABLE_UPPER.at(value);
    }
    return DIGIT_TABLE_LOWER.at(value);
}






struct ParseResult: {
    value: BigInt;
    status: ParseStatus = ParseStatus::Ok;
    consumed: int = 0;
    negative: bool = false;
}









fn parse_decimal(text: &const shared string) -> ParseResult: {
    var out = ParseResult();
    if text.size() == 0: {
        out.status = ParseStatus::EmptyInput;
        return out;
    }

    var index: int = 0;
    let first = code_of(text.at(0));
    if first == CHAR_MINUS || first == CHAR_PLUS: {
        out.negative = first == CHAR_MINUS;
        index = 1;
    }
    if index >= text.size(): {
        out.status = ParseStatus::EmptyInput;
        return out;
    }

    var value = make_zero();
    var chunk: int = 0;
    var chunk_digits: int = 0;
    var seen_digit = false;
    while index < text.size(): {
        let code = code_of(text.at(index));
        if code == CHAR_UNDERSCORE: {
            
            if !seen_digit: {
                out.status = ParseStatus::BadDigit;
                out.consumed = index;
                return out;
            }
            index += 1;
            continue;
        }
        let digit = decimal_digit_value(code);
        if digit < 0: {
            out.status = ParseStatus::BadDigit;
            out.consumed = index;
            return out;
        }
        seen_digit = true;
        chunk = chunk * 10 + digit;
        chunk_digits += 1;
        if chunk_digits == DECIMAL_DIGITS_PER_CHUNK: {
            value = add_small(multiply_small(value, DECIMAL_CHUNK_BASE), chunk);
            chunk = 0;
            chunk_digits = 0;
        }
        index += 1;
    }

    if !seen_digit: {
        out.status = ParseStatus::EmptyInput;
        out.consumed = index;
        return out;
    }
    
    if chunk_digits > 0: {
        value = add_small(multiply_small(value, power_of_ten(chunk_digits)), chunk);
    }

    value.negative = out.negative && !value.is_zero();
    value.normalise();
    out.value = value;
    out.consumed = index;
    out.status = ParseStatus::Ok;
    return out;
}


fn from_decimal_string(text: &const shared string) -> BigInt: {
    let parsed = parse_decimal(text);
    if parsed.status != ParseStatus::Ok: {
        panic("bignum: malformed decimal literal");
        return make_zero();
    }
    return parsed.value;
}







fn append_padded_decimal(target: &unique string, value: int, width: int): {
    var digits = vector{int}();
    var rest = abs(value);
    if rest == 0: {
        digits.push_back(0);
    }
    while rest > 0: {
        digits.push_back(rest % 10);
        rest = rest / 10;
    }
    while digits.size() < width: {
        digits.push_back(0);
    }
    var index = digits.size() - 1;
    while index >= 0: {
        target.push_back(digit_char(digits[index], false));
        index -= 1;
    }
}








fn to_decimal_string(a: &const shared BigInt) -> string: {
    var out = string();
    if a.is_zero(): {
        out.push_back('0');
        return out;
    }

    var chunks = vector{int}();
    var rest = a.absolute();
    var guard: int = 0;
    while !rest.is_zero(): {
        let step = divide_small(rest, DECIMAL_CHUNK_BASE);
        
        chunks.push_back(step.remainder.limb_at(0));
        rest = step.quotient;
        guard += 1;
        if guard > DIVISION_ITERATION_LIMIT: {
            panic("bignum: decimal conversion failed to terminate");
            return out;
        }
    }

    if a.is_negative(): {
        out.push_back('-');
    }
    var index = chunks.size() - 1;
    append_padded_decimal(out, chunks[index], 0);
    index -= 1;
    while index >= 0: {
        append_padded_decimal(out, chunks[index], DECIMAL_DIGITS_PER_CHUNK);
        index -= 1;
    }
    return out;
}








fn to_hex_string(a: &const shared BigInt, upper: bool) -> string: {
    var out = string();
    if a.is_zero(): {
        out.push_back('0');
        return out;
    }
    if a.is_negative(): {
        out.push_back('-');
    }
    
    var position = ((a.bit_length() + BITS_PER_NIBBLE - 1) / BITS_PER_NIBBLE)
        * BITS_PER_NIBBLE - BITS_PER_NIBBLE;
    while position >= 0: {
        let nibble = (a.get_bit(position + 3) << 3) | (a.get_bit(position + 2) << 2)
            | (a.get_bit(position + 1) << 1) | a.get_bit(position);
        out.push_back(digit_char(nibble & NIBBLE_MASK, upper));
        position -= BITS_PER_NIBBLE;
    }
    return out;
}






fn to_binary_string(a: &const shared BigInt, group: int) -> string: {
    var out = string();
    if a.is_zero(): {
        out.push_back('0');
        return out;
    }
    if a.is_negative(): {
        out.push_back('-');
    }
    var position = a.bit_length() - 1;
    while position >= 0: {
        out.push_back(digit_char(a.get_bit(position) & 1, false));
        if group > 0 && position > 0 && position % group == 0: {
            out.push_back('_');
        }
        position -= 1;
    }
    return out;
}






struct ExtendedGcd: {
    divisor: BigInt;
    x: BigInt;
    y: BigInt;
}







fn extended_gcd(a: &const shared BigInt, b: &const shared BigInt) -> ExtendedGcd: {
    var out = ExtendedGcd();
    var old_rest = a.clone();
    var rest = b.clone();
    var old_x = make_one();
    var x = make_zero();
    var old_y = make_zero();
    var y = make_one();
    var guard: int = 0;
    while !rest.is_zero(): {
        let quotient = old_rest / rest;
        let next_rest = old_rest - quotient * rest;
        let next_x = old_x - quotient * x;
        let next_y = old_y - quotient * y;
        old_rest = rest;
        rest = next_rest;
        old_x = x;
        x = next_x;
        old_y = y;
        y = next_y;
        guard += 1;
        if guard > DIVISION_ITERATION_LIMIT: {
            panic("bignum: extended gcd failed to converge");
            return out;
        }
    }
    out.divisor = old_rest;
    out.x = old_x;
    out.y = old_y;
    return out;
}




fn mod_inverse(a: &const shared BigInt, m: &const shared BigInt) -> BigInt: {
    if m.is_zero(): {
        panic("bignum: modulus must be non-zero");
        return make_zero();
    }
    let reduced = modulus(a, m);
    let bezout = extended_gcd(reduced, m.absolute());
    if bezout.divisor != make_one(): {
        panic("bignum: value is not invertible modulo m");
        return make_zero();
    }
    let inverse = modulus(bezout.x, m.absolute());
    assert inverse.is_negative() == false;
    return inverse;
}









fn isqrt(a: &const shared BigInt) -> BigInt: {
    if a.is_negative(): {
        panic("bignum: square root of a negative number");
        return make_zero();
    }
    if a.is_zero() || a.compare_small(1) == Ordering::Equal: {
        return a.clone();
    }

    var guess = shift_left(make_one(), a.bit_length() / 2 + 1);
    var guard: int = 0;
    loop: {
        let next = (guess + a / guess) >> 1;
        if next >= guess: {
            break;
        }
        guess = next;
        guard += 1;
        if guard > DIVISION_ITERATION_LIMIT: {
            panic("bignum: square root failed to converge");
            break;
        }
    }
    
    while guess * guess > a: {
        guess = guess - make_one();
    }
    prove guess * guess <= a;
    return guess;
}

fn is_perfect_square(a: &const shared BigInt) -> bool: {
    if a.is_negative(): {
        return false;
    }
    let root = isqrt(a);
    return root * root == a;
}





fn factorial(n: int) -> BigInt: {
    if n < 0: {
        panic("bignum: factorial of a negative number");
        return make_zero();
    }
    var result = make_one();
    var index: int = 2;
    while index <= n: {
        result = multiply_small(result, index);
        index += 1;
    }
    return result;
}








fn binomial(n: int, k: int) -> BigInt: {
    if k < 0 || k > n: {
        return make_zero();
    }
    let chosen = min(k, n - k);
    var result = make_one();
    var index: int = 1;
    while index <= chosen: {
        result = divide_small(multiply_small(result, n - chosen + index), index).quotient;
        index += 1;
    }
    result.normalise();
    return result;
}

}















namespace vm: {



static STACK_MAX: int = 4096;
static FRAMES_MAX: int = 256;
static UPVALUE_MAX: int = 128;
static CONSTANTS_MAX: int = 65536;
static LOCALS_MAX: int = 256;


static FIXED_SCALE: int = 1000;


static OPCODE_MASK: int = 255;            
static OPERAND_MASK: int = 16777215;      
static OPERAND_SHIFT: int = 8;
static SHORT_MASK: int = 65535;           
static BYTE_BITS: int = 8;


static GC_INITIAL_THRESHOLD: int = 1048576;
static GC_GROWTH_PERCENT: int = 200;
static GC_MIN_THRESHOLD: int = 8192;
static GC_GRAY_INITIAL: int = 64;



enum ValueKind: {
    Nil;
    Bool;
    Number;
    Object;
}

enum ObjectKind: {
    String;
    Array;
    Map;
    Function;
    Closure;
    Upvalue;
    Native;
    BoundMethod;
    Instance;
    Class;
}




struct Obj: {
    kind: ObjectKind = ObjectKind::String;
    marked: bool = false;
    
    next: int = -1;
    
    handle: int = -1;
}



struct Value: {

    fn is_nil(self: &const shared) -> bool: {
        return .kind == ValueKind::Nil;
    }

    fn is_bool(self: &const shared) -> bool: {
        return .kind == ValueKind::Bool;
    }

    fn is_number(self: &const shared) -> bool: {
        return .kind == ValueKind::Number;
    }

    fn is_object(self: &const shared) -> bool: {
        return .kind == ValueKind::Object;
    }

    
    
    fn is_truthy(self: &const shared) -> bool: {
        if .kind == ValueKind::Nil: {
            return false;
        } else: {
            if .kind == ValueKind::Bool: {
                return .boolean;
            } else: {
                return true;
            }
        }
    }

    fn as_number(self: &const shared) -> int: {
        assert .kind == ValueKind::Number;
        return .number;
    }

    fn as_object(self: &const shared) -> int: {
        assert .kind == ValueKind::Object;
        return .object;
    }

    kind: ValueKind = ValueKind::Nil;
    boolean: bool = false;
    number: int = 0;
    
    
    object: int = -1;
}

fn make_nil() -> Value: {
    var v: Value;
    v.kind = ValueKind::Nil;
    return v;
}

fn make_bool(b: bool) -> Value: {
    var v: Value;
    v.kind = ValueKind::Bool;
    v.boolean = b;
    return v;
}

fn make_number(n: int) -> Value: {
    var v: Value;
    v.kind = ValueKind::Number;
    v.number = n;
    return v;
}

fn make_object(handle: int) -> Value: {
    var v: Value;
    v.kind = ValueKind::Object;
    v.object = handle;
    return v;
}

fn values_equal(a: &const shared Value, b: &const shared Value) -> bool: {
    if a.kind != b.kind: {
        return false;
    }
    if a.kind == ValueKind::Nil: {
        return true;
    } else: {
        if a.kind == ValueKind::Bool: {
            return a.boolean == b.boolean;
        } else: {
            if a.kind == ValueKind::Number: {
                return a.number == b.number;
            } else: {
                return a.object == b.object;
            }
        }
    }
}







enum OpCode: {
    
    Constant = 0;                         
    ConstantLong = 1;                     
    Nil = 2;                              
    True = 3;                             
    False = 4;                            
    Pop = 5;                              
    PopN = 6;                             
    Dup = 7;                              
    Swap = 8;                             
    Rotate = 9;                           

    
    GetLocal = 10;                        
    SetLocal = 11;                        
    GetGlobal = 12;                       
    SetGlobal = 13;                       
    DefineGlobal = 14;                    
    GetUpvalue = 15;                      
    SetUpvalue = 16;                      
    GetProperty = 17;                     
    SetProperty = 18;                     
    GetIndex = 19;                        
    SetIndex = 20;                        

    
    Equal = 21;                           
    NotEqual = 22;                        
    Greater = 23;                         
    GreaterEqual = 24;                    
    Less = 25;                            
    LessEqual = 26;                       

    
    Add = 27;                             
    Subtract = 28;                        
    Multiply = 29;                        
    Divide = 30;                          
    Modulo = 31;                          
    Power = 32;                           

    
    Negate = 33;                          
    Increment = 34;                       
    Decrement = 35;                       
    Not = 36;                             

    
    BitAnd = 37;                          
    BitOr = 38;                           
    BitXor = 39;                          
    BitNot = 40;                          
    ShiftLeft = 41;                       
    ShiftRight = 42;                      
    ShiftRightLogical = 43;               

    
    Jump = 44;                            
    JumpIfFalse = 45;                     
    JumpIfTrue = 46;                      
    JumpIfNil = 47;                       
    JumpIfNotNil = 48;                    
    Loop = 49;                            

    
    Call = 50;                            
    Invoke = 51;                          
    TailCall = 52;                        
    CallNative = 53;                      

    
    Closure = 54;                         
    CloseUpvalue = 55;                    
    Return = 56;                          
    ReturnNil = 57;                       

    
    NewArray = 58;                        
    ArrayPush = 59;                       
    ArrayLength = 60;                     
    ArraySlice = 61;                      
    ArrayConcat = 62;                     

    
    NewMap = 63;                          
    MapInsert = 64;                       
    MapLookup = 65;                       
    MapErase = 66;                        
    MapLength = 67;                       

    
    Concat = 68;                          
    Length = 69;                          
    TypeOf = 70;                          
    Print = 71;                           
    Assert = 72;                          
    Import = 73;                          
    Nop = 74;                             
    Halt = 75;                            
}




struct Instruction: {

    fn packed(self: &const shared) -> int: {
        return (.operand << OPERAND_SHIFT) | (.opcode_byte() & OPCODE_MASK);
    }

    fn opcode_byte(self: &const shared) -> int: {
        return .raw & OPCODE_MASK;
    }

    fn is_jump(self: &const shared) -> bool: {
        if .op == OpCode::Jump: {
            return true;
        }
        if .op == OpCode::JumpIfFalse: {
            return true;
        }
        if .op == OpCode::JumpIfTrue: {
            return true;
        }
        if .op == OpCode::JumpIfNil: {
            return true;
        }
        if .op == OpCode::JumpIfNotNil: {
            return true;
        }
        return .op == OpCode::Loop;
    }

    op: OpCode = OpCode::Nop;
    operand: int = 0;
    extra: int = 0;
    raw: int = 0;
    line: int = 0;
}

fn decode(raw: int) -> Instruction: {
    var ins: Instruction;
    ins.raw = raw;
    ins.operand = (raw >> OPERAND_SHIFT) & OPERAND_MASK;
    return ins;
}



struct LineRun: {
    line: int = 0;
    count: int = 0;
}





struct Chunk: {

    fn size(self: &const shared) -> int: {
        return .code.size();
    }

    fn empty(self: &const shared) -> bool: {
        return .code.empty();
    }

    fn write(self: &unique, op: OpCode, operand: int, line: int) -> int: {
        var ins: Instruction;
        ins.op = op;
        ins.operand = operand;
        ins.line = line;
        ins.raw = ins.packed();
        .code.push_back(ins);
        .note_line(line);
        return .code.size() - 1;
    }

    fn write_simple(self: &unique, op: OpCode, line: int) -> int: {
        return .write(op, 0, line);
    }

    fn write_invoke(self: &unique, name_slot: int, argc: int, line: int) -> int: {
        let index = .write(OpCode::Invoke, name_slot, line);
        let slot: &unique = .code.at(index);
        slot.extra = argc;
        return index;
    }

    
    fn note_line(self: &unique, line: int): {
        if .lines.empty(): {
            .lines.push_back(LineRun(line: line, count: 1));
            return;
        }
        let last: &unique = .lines.back();
        if last.line == line: {
            last.count += 1;
        } else: {
            .lines.push_back(LineRun(line: line, count: 1));
        }
    }

    fn line_at(self: &const shared, offset: int) -> int: {
        var seen: int = 0;
        for run: &const in .lines: {
            seen += run.count;
            if offset < seen: {
                return run.line;
            }
        }
        return 0;
    }

    
    fn add_constant(self: &unique, value: Value) -> int: {
        var i: int = 0;
        while i < .constants.size(): {
            if values_equal(.constants.at(i), value): {
                return i;
            }
            i += 1;
        }
        assert .constants.size() < CONSTANTS_MAX;
        .constants.push_back(value);
        return .constants.size() - 1;
    }

    fn constant_at(self: &const shared, index: int) -> &const[self] Value: {
        assert index >= 0;
        assert index < .constants.size();
        return .constants.at(index);
    }

    fn patch_jump(self: &unique, offset: int, target: int): {
        let slot: &unique = .code.at(offset);
        assert slot.is_jump();
        slot.operand = target;
        slot.raw = slot.packed();
    }

    fn emit_loop(self: &unique, start: int, line: int) -> int: {
        return .write(OpCode::Loop, start, line);
    }

    fn clear(self: &unique): {
        .code.clear();
        .constants.clear();
        .lines.clear();
    }

    code: vector{Instruction};
    constants: vector{Value};
    lines: vector{LineRun};
    name: string;
    arity: int = 0;
    upvalue_count: int = 0;
}







fn opcode_name(op: OpCode) -> string: {
    
    if op == OpCode::Constant: {
        return "OP_CONSTANT";
    } else: { if op == OpCode::ConstantLong: {
        return "OP_CONSTANT_LONG";
    } else: { if op == OpCode::Nil: {
        return "OP_NIL";
    } else: { if op == OpCode::True: {
        return "OP_TRUE";
    } else: { if op == OpCode::False: {
        return "OP_FALSE";
    } else: { if op == OpCode::Pop: {
        return "OP_POP";
    } else: { if op == OpCode::PopN: {
        return "OP_POP_N";
    } else: { if op == OpCode::Dup: {
        return "OP_DUP";
    } else: { if op == OpCode::Swap: {
        return "OP_SWAP";
    } else: { if op == OpCode::Rotate: {
        return "OP_ROTATE";
    
    } else: { if op == OpCode::GetLocal: {
        return "OP_GET_LOCAL";
    } else: { if op == OpCode::SetLocal: {
        return "OP_SET_LOCAL";
    } else: { if op == OpCode::GetGlobal: {
        return "OP_GET_GLOBAL";
    } else: { if op == OpCode::SetGlobal: {
        return "OP_SET_GLOBAL";
    } else: { if op == OpCode::DefineGlobal: {
        return "OP_DEFINE_GLOBAL";
    } else: { if op == OpCode::GetUpvalue: {
        return "OP_GET_UPVALUE";
    } else: { if op == OpCode::SetUpvalue: {
        return "OP_SET_UPVALUE";
    } else: { if op == OpCode::GetProperty: {
        return "OP_GET_PROPERTY";
    } else: { if op == OpCode::SetProperty: {
        return "OP_SET_PROPERTY";
    } else: { if op == OpCode::GetIndex: {
        return "OP_GET_INDEX";
    } else: { if op == OpCode::SetIndex: {
        return "OP_SET_INDEX";
    
    } else: { if op == OpCode::Equal: {
        return "OP_EQUAL";
    } else: { if op == OpCode::NotEqual: {
        return "OP_NOT_EQUAL";
    } else: { if op == OpCode::Greater: {
        return "OP_GREATER";
    } else: { if op == OpCode::GreaterEqual: {
        return "OP_GREATER_EQUAL";
    } else: { if op == OpCode::Less: {
        return "OP_LESS";
    } else: { if op == OpCode::LessEqual: {
        return "OP_LESS_EQUAL";
    
    } else: { if op == OpCode::Add: {
        return "OP_ADD";
    } else: { if op == OpCode::Subtract: {
        return "OP_SUBTRACT";
    } else: { if op == OpCode::Multiply: {
        return "OP_MULTIPLY";
    } else: { if op == OpCode::Divide: {
        return "OP_DIVIDE";
    } else: { if op == OpCode::Modulo: {
        return "OP_MODULO";
    } else: { if op == OpCode::Power: {
        return "OP_POWER";
    
    } else: { if op == OpCode::Negate: {
        return "OP_NEGATE";
    } else: { if op == OpCode::Increment: {
        return "OP_INCREMENT";
    } else: { if op == OpCode::Decrement: {
        return "OP_DECREMENT";
    } else: { if op == OpCode::Not: {
        return "OP_NOT";
    
    } else: { if op == OpCode::BitAnd: {
        return "OP_BIT_AND";
    } else: { if op == OpCode::BitOr: {
        return "OP_BIT_OR";
    } else: { if op == OpCode::BitXor: {
        return "OP_BIT_XOR";
    } else: { if op == OpCode::BitNot: {
        return "OP_BIT_NOT";
    } else: { if op == OpCode::ShiftLeft: {
        return "OP_SHIFT_LEFT";
    } else: { if op == OpCode::ShiftRight: {
        return "OP_SHIFT_RIGHT";
    } else: { if op == OpCode::ShiftRightLogical: {
        return "OP_SHIFT_RIGHT_LOGICAL";
    
    } else: { if op == OpCode::Jump: {
        return "OP_JUMP";
    } else: { if op == OpCode::JumpIfFalse: {
        return "OP_JUMP_IF_FALSE";
    } else: { if op == OpCode::JumpIfTrue: {
        return "OP_JUMP_IF_TRUE";
    } else: { if op == OpCode::JumpIfNil: {
        return "OP_JUMP_IF_NIL";
    } else: { if op == OpCode::JumpIfNotNil: {
        return "OP_JUMP_IF_NOT_NIL";
    } else: { if op == OpCode::Loop: {
        return "OP_LOOP";
    
    } else: { if op == OpCode::Call: {
        return "OP_CALL";
    } else: { if op == OpCode::Invoke: {
        return "OP_INVOKE";
    } else: { if op == OpCode::TailCall: {
        return "OP_TAIL_CALL";
    } else: { if op == OpCode::CallNative: {
        return "OP_CALL_NATIVE";
    
    } else: { if op == OpCode::Closure: {
        return "OP_CLOSURE";
    } else: { if op == OpCode::CloseUpvalue: {
        return "OP_CLOSE_UPVALUE";
    } else: { if op == OpCode::Return: {
        return "OP_RETURN";
    } else: { if op == OpCode::ReturnNil: {
        return "OP_RETURN_NIL";
    
    } else: { if op == OpCode::NewArray: {
        return "OP_NEW_ARRAY";
    } else: { if op == OpCode::ArrayPush: {
        return "OP_ARRAY_PUSH";
    } else: { if op == OpCode::ArrayLength: {
        return "OP_ARRAY_LENGTH";
    } else: { if op == OpCode::ArraySlice: {
        return "OP_ARRAY_SLICE";
    } else: { if op == OpCode::ArrayConcat: {
        return "OP_ARRAY_CONCAT";
    
    } else: { if op == OpCode::NewMap: {
        return "OP_NEW_MAP";
    } else: { if op == OpCode::MapInsert: {
        return "OP_MAP_INSERT";
    } else: { if op == OpCode::MapLookup: {
        return "OP_MAP_LOOKUP";
    } else: { if op == OpCode::MapErase: {
        return "OP_MAP_ERASE";
    } else: { if op == OpCode::MapLength: {
        return "OP_MAP_LENGTH";
    
    } else: { if op == OpCode::Concat: {
        return "OP_CONCAT";
    } else: { if op == OpCode::Length: {
        return "OP_LENGTH";
    } else: { if op == OpCode::TypeOf: {
        return "OP_TYPE_OF";
    } else: { if op == OpCode::Print: {
        return "OP_PRINT";
    } else: { if op == OpCode::Assert: {
        return "OP_ASSERT";
    } else: { if op == OpCode::Import: {
        return "OP_IMPORT";
    } else: { if op == OpCode::Nop: {
        return "OP_NOP";
    } else: { if op == OpCode::Halt: {
        return "OP_HALT";
    } else: {
        
        
        return "OP_UNKNOWN";
    }
    } } } } } } } } } } } } } } } } } } }
    } } } } } } } } } } } } } } } } } } }
    } } } } } } } } } } } } } } } } } } }
    } } } } } } } } } } } } } } } } } }
}



fn opcode_operand_count(op: OpCode) -> int: {
    if op == OpCode::Invoke: {
        
        return 2;
    }
    if op == OpCode::Constant || op == OpCode::ConstantLong || op == OpCode::PopN: {
        return 1;
    }
    if op == OpCode::Rotate || op == OpCode::GetLocal || op == OpCode::SetLocal: {
        return 1;
    }
    if op == OpCode::GetGlobal || op == OpCode::SetGlobal || op == OpCode::DefineGlobal: {
        return 1;
    }
    if op == OpCode::GetUpvalue || op == OpCode::SetUpvalue: {
        return 1;
    }
    if op == OpCode::GetProperty || op == OpCode::SetProperty: {
        return 1;
    }
    if op == OpCode::Jump || op == OpCode::JumpIfFalse || op == OpCode::JumpIfTrue: {
        return 1;
    }
    if op == OpCode::JumpIfNil || op == OpCode::JumpIfNotNil || op == OpCode::Loop: {
        return 1;
    }
    if op == OpCode::Call || op == OpCode::TailCall || op == OpCode::CallNative: {
        return 1;
    }
    if op == OpCode::Closure || op == OpCode::NewArray || op == OpCode::NewMap: {
        return 1;
    }
    if op == OpCode::Assert || op == OpCode::Import: {
        return 1;
    }
    return 0;
}


enum OperandKind: {
    None;
    ConstantSlot;
    LocalSlot;
    UpvalueSlot;
    GlobalSlot;
    JumpTarget;
    ArgumentCount;
    Count;
}

fn opcode_operand_kind(op: OpCode) -> OperandKind: {
    if op == OpCode::Constant || op == OpCode::ConstantLong: {
        return OperandKind::ConstantSlot;
    }
    if op == OpCode::GetProperty || op == OpCode::SetProperty || op == OpCode::Invoke: {
        return OperandKind::ConstantSlot;
    }
    if op == OpCode::GetLocal || op == OpCode::SetLocal: {
        return OperandKind::LocalSlot;
    }
    if op == OpCode::GetUpvalue || op == OpCode::SetUpvalue: {
        return OperandKind::UpvalueSlot;
    }
    if op == OpCode::GetGlobal || op == OpCode::SetGlobal || op == OpCode::DefineGlobal: {
        return OperandKind::GlobalSlot;
    }
    if op == OpCode::Jump || op == OpCode::JumpIfFalse || op == OpCode::JumpIfTrue: {
        return OperandKind::JumpTarget;
    }
    if op == OpCode::JumpIfNil || op == OpCode::JumpIfNotNil || op == OpCode::Loop: {
        return OperandKind::JumpTarget;
    }
    if op == OpCode::Call || op == OpCode::TailCall || op == OpCode::CallNative: {
        return OperandKind::ArgumentCount;
    }
    if op == OpCode::PopN || op == OpCode::Rotate: {
        return OperandKind::Count;
    }
    if op == OpCode::NewArray || op == OpCode::NewMap: {
        return OperandKind::Count;
    }
    return OperandKind::None;
}

fn operand_kind_name(kind: OperandKind) -> string: {
    if kind == OperandKind::ConstantSlot: {
        return "const";
    } else: { if kind == OperandKind::LocalSlot: {
        return "local";
    } else: { if kind == OperandKind::UpvalueSlot: {
        return "upval";
    } else: { if kind == OperandKind::GlobalSlot: {
        return "global";
    } else: { if kind == OperandKind::JumpTarget: {
        return "->";
    } else: { if kind == OperandKind::ArgumentCount: {
        return "argc";
    } else: { if kind == OperandKind::Count: {
        return "n";
    } else: {
        return "";
    }
    } } } } } }
}



fn stack_effect(op: OpCode, operand: int) -> int: {
    if op == OpCode::PopN: {
        return -operand;
    }
    if op == OpCode::Call || op == OpCode::TailCall || op == OpCode::CallNative: {
        return -operand;
    }
    if op == OpCode::Invoke: {
        return -operand;
    }
    if op == OpCode::NewArray: {
        return 1 - operand;
    }
    if op == OpCode::NewMap: {
        return 1 - operand * 2;
    }
    if op == OpCode::SetIndex || op == OpCode::MapInsert: {
        return -2;
    }
    if op == OpCode::ArraySlice: {
        return -2;
    }
    if is_binary_op(op): {
        return -1;
    }
    if is_unary_op(op): {
        return 0;
    }
    if pushes_value(op): {
        return 1;
    }
    if pops_value(op): {
        return -1;
    }
    return 0;
}

fn is_binary_op(op: OpCode) -> bool: {
    if op == OpCode::Add || op == OpCode::Subtract || op == OpCode::Multiply: {
        return true;
    }
    if op == OpCode::Divide || op == OpCode::Modulo || op == OpCode::Power: {
        return true;
    }
    if op == OpCode::Equal || op == OpCode::NotEqual: {
        return true;
    }
    if op == OpCode::Greater || op == OpCode::GreaterEqual: {
        return true;
    }
    if op == OpCode::Less || op == OpCode::LessEqual: {
        return true;
    }
    if op == OpCode::BitAnd || op == OpCode::BitOr || op == OpCode::BitXor: {
        return true;
    }
    if op == OpCode::ShiftLeft || op == OpCode::ShiftRight: {
        return true;
    }
    if op == OpCode::ShiftRightLogical || op == OpCode::Concat: {
        return true;
    }
    return op == OpCode::GetIndex || op == OpCode::ArrayConcat;
}

fn is_unary_op(op: OpCode) -> bool: {
    if op == OpCode::Negate || op == OpCode::Not || op == OpCode::BitNot: {
        return true;
    }
    if op == OpCode::Increment || op == OpCode::Decrement: {
        return true;
    }
    if op == OpCode::Length || op == OpCode::TypeOf || op == OpCode::ArrayLength: {
        return true;
    }
    return op == OpCode::MapLength;
}

fn pushes_value(op: OpCode) -> bool: {
    if op == OpCode::Constant || op == OpCode::ConstantLong: {
        return true;
    }
    if op == OpCode::Nil || op == OpCode::True || op == OpCode::False: {
        return true;
    }
    if op == OpCode::Dup || op == OpCode::Closure || op == OpCode::Import: {
        return true;
    }
    return op == OpCode::GetLocal || op == OpCode::GetGlobal || op == OpCode::GetUpvalue;
}

fn pops_value(op: OpCode) -> bool: {
    if op == OpCode::Pop || op == OpCode::Print || op == OpCode::Assert: {
        return true;
    }
    if op == OpCode::DefineGlobal || op == OpCode::SetProperty: {
        return true;
    }
    if op == OpCode::JumpIfFalse || op == OpCode::JumpIfTrue: {
        return true;
    }
    if op == OpCode::ArrayPush || op == OpCode::MapLookup || op == OpCode::MapErase: {
        return true;
    }
    return op == OpCode::CloseUpvalue || op == OpCode::Return;
}


fn disassemble_instruction(chunk: &const shared Chunk, offset: int) -> string: {
    let ins: &const = chunk.code.at(offset);
    var text = to_string(offset);
    text.append("  ");
    text.append(to_string(chunk.line_at(offset)));
    text.append("  ");
    text.append(opcode_name(ins.op));
    let count = opcode_operand_count(ins.op);
    if count > 0: {
        text.append(" ");
        text.append(operand_kind_name(opcode_operand_kind(ins.op)));
        text.append(" ");
        text.append(to_string(ins.operand));
    }
    if count > 1: {
        text.append(" argc ");
        text.append(to_string(ins.extra));
    }
    return text;
}

fn disassemble_chunk(chunk: &const shared Chunk): {
    println(chunk.name);
    var depth: int = 0;
    for i in range(0, chunk.size()): {
        println(disassemble_instruction(chunk, i));
        let ins: &const = chunk.code.at(i);
        depth += stack_effect(ins.op, ins.operand);
        assert depth >= 0;
    }
    println("-- end of chunk --");
}





struct ObjString: {

    fn size(self: &const shared) -> int: {
        return .text.size();
    }

    fn rehash(self: &unique): {
        .hash = hash_of(.text);
    }

    header: Obj;
    text: string;
    hash: int = 0;
}



struct ObjArray: {

    fn size(self: &const shared) -> int: {
        return .items.size();
    }

    fn in_bounds(self: &const shared, index: int) -> bool: {
        return index >= 0 && index < .items.size();
    }

    fn at(self: &shared, index: int) -> &shared[self] Value: {
        assert .in_bounds(index);
        return .items.at(index);
    }

    header: Obj;
    items: vector{Value};
}



struct ObjMap: {

    fn size(self: &const shared) -> int: {
        return .keys.size();
    }

    fn find(self: &const shared, key: &const shared Value) -> int: {
        for i in range(0, .keys.size()): {
            if values_equal(.keys.at(i), key): {
                return i;
            }
        }
        return -1;
    }

    header: Obj;
    keys: vector{Value};
    values: vector{Value};
}


struct ObjFunction: {

    fn name(self: &const shared) -> &const[self] string: {
        return .chunk.name;
    }

    header: Obj;
    chunk: Chunk;
    arity: int = 0;
    upvalue_count: int = 0;
    is_variadic: bool = false;
}



struct ObjUpvalue: {

    fn is_open(self: &const shared) -> bool: {
        return .location >= 0;
    }

    fn read(self: &shared) -> &shared[self] Value: {
        return .closed;
    }

    header: Obj;
    location: int = -1;
    closed: Value;
    next_open: int = -1;
}


struct ObjClosure: {

    fn arity(self: &const shared) -> int: {
        return .function.arity;
    }

    header: Obj;
    function: ObjFunction;
    upvalues: vector{int};
}


struct ObjNative: {
    header: Obj;
    slot: int = 0;
    arity: int = 0;
    name: string;
}





struct CallFrame: {

    fn local(self: &shared, index: int) -> int: {
        assert index >= 0;
        assert index < LOCALS_MAX;
        return .slot_base + index;
    }

    fn advance(self: &unique) -> int: {
        let here = .ip;
        .ip += 1;
        return here;
    }

    fn jump_to(self: &unique, target: int): {
        assert target >= 0;
        .ip = target;
    }

    
    
    closure: int = -1;
    ip: int = 0;
    slot_base: int = 0;
    argument_count: int = 0;
    is_tail: bool = false;
}

enum InterpretResult: {
    Ok;
    CompileError;
    RuntimeError;
    Halted;
}





struct VM: {

    

    fn push(self: &unique, value: Value): {
        assert .stack_top < STACK_MAX;
        .stack.push_back(value);
        .stack_top += 1;
    }

    fn pop(self: &unique) -> Value: {
        assert .stack_top > 0;
        .stack_top -= 1;
        let value = .stack.back();
        .stack.pop_back();
        return value;
    }

    fn pop_n(self: &unique, count: int): {
        var i: int = 0;
        while i < count: {
            discard .pop();
            i += 1;
        }
    }

    
    fn peek(self: &shared, distance: int) -> &shared[self] Value: {
        assert distance < .stack_top;
        return .stack.at(.stack_top - 1 - distance);
    }

    fn store_slot(self: &unique, index: int, value: &const shared Value): {
        assert index >= 0;
        assert index < .stack_top;
        let slot: &unique = .stack.at(index);
        slot.kind = value.kind;
        slot.boolean = value.boolean;
        slot.number = value.number;
        slot.object = value.object;
    }

    fn swap_top(self: &unique): {
        let a = .pop();
        let b = .pop();
        .push(a);
        .push(b);
    }

    
    fn rotate(self: &unique, depth: int): {
        if depth <= 0: {
            return;
        }
        let lifted = .stack.at(.stack_top - 1 - depth);
        var i = .stack_top - 1 - depth;
        while i < .stack_top - 1: {
            .store_slot(i, .stack.at(i + 1));
            i += 1;
        }
        .store_slot(.stack_top - 1, lifted);
    }

    fn reset_stack(self: &unique): {
        .stack.clear();
        .stack_top = 0;
        .frame_count = 0;
        .open_upvalues.clear();
    }

    

    fn runtime_error(self: &unique, message: &const shared string, line: int): {
        var text = string();
        text.append("runtime error: ");
        text.append(message);
        text.append(" (line ");
        text.append(to_string(line));
        text.append(")");
        println(text);
        .print_backtrace();
        .had_error = true;
    }

    fn print_backtrace(self: &const shared): {
        var i = .frame_count - 1;
        while i >= 0: {
            let frame: &const = .frames.at(i);
            var line = string();
            line.append("  at frame ");
            line.append(to_string(i));
            line.append(" ip ");
            line.append(to_string(frame.ip));
            println(line);
            i -= 1;
        }
    }

    fn print_stack(self: &const shared): {
        for value: &const in .stack: {
            print(.to_display(value));
            print(" ");
        }
        println("");
    }

    

    fn load_global(self: &unique, name: &const shared Value): {
        let key = .string_of(name);
        if !.globals.contains(key): {
            .runtime_error("undefined variable", 0);
            return;
        }
        .push(.globals.at(key));
    }

    fn assign_global(self: &unique, name: &const shared Value): {
        let key = .string_of(name);
        if !.globals.contains(key): {
            .runtime_error("assignment to undefined variable", 0);
            return;
        }
        discard .globals.insert(key, .peek(0));
    }

    fn define_global(self: &unique, name: &const shared Value): {
        discard .globals.insert(.string_of(name), .pop());
    }

    fn string_of(self: &const shared, value: &const shared Value) -> string: {
        assert value.is_object();
        return .strings_by_handle.at(value.object);
    }

    

    fn get_property(self: &unique, name: &const shared Value): {
        let target = .pop();
        if !target.is_object(): {
            .runtime_error("only objects have properties", 0);
            return;
        }
        .push(.lookup_field(target.object, .string_of(name)));
    }

    fn set_property(self: &unique, name: &const shared Value): {
        let value = .pop();
        let target = .peek(0);
        if !target.is_object(): {
            .runtime_error("only objects have properties", 0);
            return;
        }
        .store_field(target.object, .string_of(name), value);
    }

    fn lookup_field(self: &shared, handle: int, name: &const shared string) -> Value: {
        discard handle;
        discard name;
        return make_nil();
    }

    fn store_field(self: &unique, handle: int, name: &const shared string, value: &const shared Value): {
        discard handle;
        discard name;
        discard value;
    }

    fn index_get(self: &unique): {
        let key = .pop();
        let target = .pop();
        if !target.is_object(): {
            .runtime_error("value is not indexable", 0);
            return;
        }
        let container: &shared = .arrays.at(target.object);
        let index = key.as_number() / FIXED_SCALE;
        if !container.in_bounds(index): {
            .runtime_error("index out of range", 0);
            return;
        }
        .push(container.at(index));
    }

    fn index_set(self: &unique): {
        let value = .pop();
        let key = .pop();
        let target = .pop();
        let container: &unique = .arrays.at(target.object);
        let index = key.as_number() / FIXED_SCALE;
        if !container.in_bounds(index): {
            .runtime_error("index out of range", 0);
            return;
        }
        let slot: &unique = container.at(index);
        slot.kind = value.kind;
        slot.number = value.number;
        slot.object = value.object;
        .push(value);
    }

    

    fn compare_equal(self: &unique, invert: bool): {
        let b = .pop();
        let a = .pop();
        let same = values_equal(a, b);
        if invert: {
            .push(make_bool(!same));
        } else: {
            .push(make_bool(same));
        }
    }

    fn compare_order(self: &unique, op: OpCode): {
        let b = .pop();
        let a = .pop();
        if !a.is_number() || !b.is_number(): {
            .runtime_error("operands must be numbers", 0);
            return;
        }
        let l = a.as_number();
        let r = b.as_number();
        if op == OpCode::Greater: {
            .push(make_bool(l > r));
        } else: { if op == OpCode::GreaterEqual: {
            .push(make_bool(l >= r));
        } else: { if op == OpCode::Less: {
            .push(make_bool(l < r));
        } else: {
            .push(make_bool(l <= r));
        }
        } }
    }

    

    
    
    fn arith(self: &unique, op: OpCode): {
        let b = .pop();
        let a = .pop();
        if !a.is_number() || !b.is_number(): {
            .runtime_error("operands must be numbers", 0);
            return;
        }
        let l = a.as_number();
        let r = b.as_number();
        if op == OpCode::Add: {
            .push(make_number(l + r));
        } else: { if op == OpCode::Subtract: {
            .push(make_number(l - r));
        } else: { if op == OpCode::Multiply: {
            .push(make_number(l * r / FIXED_SCALE));
        } else: { if op == OpCode::Divide: {
            .push(make_number(l * FIXED_SCALE / r));
        } else: { if op == OpCode::Modulo: {
            .push(make_number(l % r));
        } else: {
            .push(make_number(.power(l, r / FIXED_SCALE)));
        }
        } } } }
    }

    fn power(self: &const shared, base: int, exponent: int) -> int: {
        var result = FIXED_SCALE;
        var i: int = 0;
        while i < exponent: {
            result = result * base / FIXED_SCALE;
            i += 1;
        }
        return result;
    }

    fn negate(self: &unique): {
        let value = .pop();
        if !value.is_number(): {
            .runtime_error("operand must be a number", 0);
            return;
        }
        .push(make_number(-value.as_number()));
    }

    fn adjust(self: &unique, delta: int): {
        let value = .pop();
        .push(make_number(value.as_number() + delta));
    }

    

    fn bitwise(self: &unique, op: OpCode): {
        let b = .pop();
        let a = .pop();
        let l = a.as_number() / FIXED_SCALE;
        let r = b.as_number() / FIXED_SCALE;
        if op == OpCode::BitAnd: {
            .push(make_number((l & r) * FIXED_SCALE));
        } else: { if op == OpCode::BitOr: {
            .push(make_number((l | r) * FIXED_SCALE));
        } else: { if op == OpCode::BitXor: {
            .push(make_number((l ^ r) * FIXED_SCALE));
        } else: { if op == OpCode::ShiftLeft: {
            .push(make_number((l << r) * FIXED_SCALE));
        } else: { if op == OpCode::ShiftRight: {
            .push(make_number((l >> r) * FIXED_SCALE));
        } else: {
            .push(make_number(((l >> r) & OPERAND_MASK) * FIXED_SCALE));
        }
        } } } }
    }

    fn bit_not(self: &unique): {
        let value = .pop();
        let raw = value.as_number() / FIXED_SCALE;
        .push(make_number(~raw * FIXED_SCALE));
    }

    

    fn concat_strings(self: &unique): {
        let b = .pop();
        let a = .pop();
        var joined = .string_of(a);
        joined.append(.string_of(b));
        .push(.intern(joined));
    }

    fn intern(self: &unique, text: &const shared string) -> Value: {
        if .interned.contains(text): {
            return make_object(.interned.at(text));
        }
        let handle = .allocate(ObjectKind::String, text.size());
        discard .interned.insert(text, handle);
        discard .strings_by_handle.insert(handle, text);
        return make_object(handle);
    }

    fn new_array(self: &unique, count: int): {
        let handle = .allocate(ObjectKind::Array, count);
        let target: &unique = .arrays.at(handle);
        var i: int = 0;
        while i < count: {
            target.items.push_back(.peek(count - 1 - i));
            i += 1;
        }
        .pop_n(count);
        .push(make_object(handle));
    }

    fn array_push(self: &unique): {
        let value = .pop();
        let target: &unique = .arrays.at(.peek(0).as_object());
        target.items.push_back(value);
    }

    fn array_length(self: &unique): {
        let target = .pop();
        .push(make_number(.arrays.at(target.as_object()).size() * FIXED_SCALE));
    }

    fn array_slice(self: &unique): {
        let length = .pop().as_number() / FIXED_SCALE;
        let begin = .pop().as_number() / FIXED_SCALE;
        let source = .pop();
        let handle = .allocate(ObjectKind::Array, length);
        let target: &unique = .arrays.at(handle);
        let original: &const = .arrays.at(source.as_object());
        for i in range(begin, begin + length): {
            if original.in_bounds(i): {
                target.items.push_back(original.at(i));
            }
        }
        .push(make_object(handle));
    }

    fn array_concat(self: &unique): {
        let b = .pop();
        let a = .pop();
        let handle = .allocate(ObjectKind::Array, 0);
        let target: &unique = .arrays.at(handle);
        for value: &const in .arrays.at(a.as_object()).items: {
            target.items.push_back(value);
        }
        for value: &const in .arrays.at(b.as_object()).items: {
            target.items.push_back(value);
        }
        .push(make_object(handle));
    }

    fn new_map(self: &unique, pair_count: int): {
        let handle = .allocate(ObjectKind::Map, pair_count);
        let target: &unique = .maps.at(handle);
        var i: int = 0;
        while i < pair_count: {
            target.values.push_back(.pop());
            target.keys.push_back(.pop());
            i += 1;
        }
        .push(make_object(handle));
    }

    fn map_insert(self: &unique): {
        let value = .pop();
        let key = .pop();
        let target: &unique = .maps.at(.peek(0).as_object());
        let existing = target.find(key);
        if existing >= 0: {
            .store_slot_in(target.values, existing, value);
        } else: {
            target.keys.push_back(key);
            target.values.push_back(value);
        }
    }

    fn store_slot_in(self: &unique, slots: &unique vector{Value}, index: int, value: &const shared Value): {
        let slot: &unique = slots.at(index);
        slot.kind = value.kind;
        slot.number = value.number;
        slot.object = value.object;
        slot.boolean = value.boolean;
    }

    fn map_lookup(self: &unique): {
        let key = .pop();
        let target: &const = .maps.at(.pop().as_object());
        let index = target.find(key);
        if index < 0: {
            .push(make_nil());
        } else: {
            .push(target.values.at(index));
        }
    }

    fn map_erase(self: &unique): {
        let key = .pop();
        let target: &unique = .maps.at(.peek(0).as_object());
        let index = target.find(key);
        if index >= 0: {
            target.keys.erase(index);
            target.values.erase(index);
        }
    }

    fn map_length(self: &unique): {
        let target = .pop();
        .push(make_number(.maps.at(target.as_object()).size() * FIXED_SCALE));
    }

    fn length_of(self: &unique): {
        let value = .peek(0);
        if !value.is_object(): {
            .runtime_error("value has no length", 0);
            return;
        }
        let kind = .objects.at(value.as_object()).kind;
        if kind == ObjectKind::Array: {
            .array_length();
        } else: { if kind == ObjectKind::Map: {
            .map_length();
        } else: {
            let text = .string_of(.pop());
            .push(make_number(text.size() * FIXED_SCALE));
        }
        }
    }

    fn type_of(self: &unique): {
        let value = .pop();
        .push(.intern(.type_name(value)));
    }

    fn type_name(self: &const shared, value: &const shared Value) -> string: {
        if value.is_nil(): {
            return "nil";
        } else: { if value.is_bool(): {
            return "bool";
        } else: { if value.is_number(): {
            return "number";
        } else: {
            return object_kind_name(.objects.at(value.object).kind);
        }
        } }
    }

    fn to_display(self: &const shared, value: &const shared Value) -> string: {
        if value.is_nil(): {
            return "nil";
        }
        if value.is_bool(): {
            if value.boolean: {
                return "true";
            } else: {
                return "false";
            }
        }
        if value.is_number(): {
            return format_fixed(value.number);
        }
        return .string_of(value);
    }

    fn import_module(self: &unique, name: &const shared Value) -> Value: {
        let key = .string_of(name);
        if .modules.contains(key): {
            return .modules.at(key);
        }
        .runtime_error("no such module", 0);
        return make_nil();
    }

    
    fn check_interrupt(self: &unique): {
        .steps += 1;
        if .steps % 4096 == 0: {
            if .interrupted: {
                .runtime_error("execution interrupted", 0);
            }
        }
    }

    

    fn call_value(self: &unique, callee: &const shared Value, argument_count: int): {
        if !callee.is_object(): {
            .runtime_error("can only call functions", 0);
            return;
        }
        let kind = .objects.at(callee.as_object()).kind;
        if kind == ObjectKind::Closure: {
            .call_closure(callee.as_object(), argument_count, false);
        } else: { if kind == ObjectKind::Native: {
            .call_native(argument_count);
        } else: { if kind == ObjectKind::BoundMethod: {
            .call_closure(.bound_target(callee.as_object()), argument_count, false);
        } else: {
            .runtime_error("value is not callable", 0);
        }
        } }
    }

    fn call_closure(self: &unique, handle: int, argument_count: int, tail: bool): {
        let closure: &const = .closures.at(handle);
        if argument_count != closure.arity(): {
            .runtime_error("wrong number of arguments", 0);
            return;
        }
        if .frame_count >= FRAMES_MAX: {
            .runtime_error("stack overflow", 0);
            return;
        }
        var frame: CallFrame;
        frame.closure = handle;
        frame.ip = 0;
        frame.slot_base = .stack_top - argument_count - 1;
        frame.argument_count = argument_count;
        frame.is_tail = tail;
        .frames.push_back(frame);
        .frame_count += 1;
    }

    fn tail_call(self: &unique, argument_count: int): {
        let callee = .peek(argument_count);
        let frame: &unique = .frames.at(.frame_count - 1);
        let base = frame.slot_base;
        .frame_count -= 1;
        .frames.pop_back();
        .shift_arguments(base, argument_count);
        .call_closure(callee.as_object(), argument_count, true);
    }

    
    fn shift_arguments(self: &unique, base: int, argument_count: int): {
        var i: int = 0;
        while i <= argument_count: {
            .store_slot(base + i, .stack.at(.stack_top - argument_count - 1 + i));
            i += 1;
        }
        .stack_top = base + argument_count + 1;
    }

    fn invoke(self: &unique, name: &const shared Value, argument_count: int): {
        let receiver = .peek(argument_count);
        if !receiver.is_object(): {
            .runtime_error("only objects have methods", 0);
            return;
        }
        let method = .lookup_field(receiver.as_object(), .string_of(name));
        .call_value(method, argument_count);
    }

    fn call_native(self: &unique, argument_count: int): {
        let callee = .peek(argument_count);
        let slot = .natives.at(callee.as_object()).slot;
        let result = .dispatch_native(slot, argument_count);
        .pop_n(argument_count + 1);
        .push(result);
    }

    fn dispatch_native(self: &unique, slot: int, argument_count: int) -> Value: {
        discard slot;
        discard argument_count;
        return make_nil();
    }

    fn bound_target(self: &const shared, handle: int) -> int: {
        return .bound_methods.at(handle);
    }

    fn return_from(self: &unique, result: Value): {
        let frame: &const = .frames.at(.frame_count - 1);
        let base = frame.slot_base;
        .close_upvalues(base);
        .frame_count -= 1;
        .frames.pop_back();
        while .stack_top > base: {
            discard .pop();
        }
        if .frame_count > 0: {
            .push(result);
        } else: {
            .last_result = result;
        }
    }

    

    
    
    
    fn capture_upvalue(self: &unique, index: int) -> int: {
        for handle: &const in .open_upvalues: {
            if .upvalues.at(handle).location == index: {
                return handle;
            }
        }
        let created = .allocate(ObjectKind::Upvalue, 0);
        let target: &unique = .upvalues.at(created);
        target.location = index;
        .open_upvalues.push_back(created);
        return created;
    }

    
    
    fn close_upvalues(self: &unique, floor: int): {
        var i: int = 0;
        while i < .open_upvalues.size(): {
            let handle = .open_upvalues.at(i);
            let target: &unique = .upvalues.at(handle);
            if target.location >= floor: {
                target.closed = .stack.at(target.location);
                target.location = -1;
                .open_upvalues.erase(i);
            } else: {
                i += 1;
            }
        }
    }

    fn read_upvalue(self: &shared, closure: int, index: int) -> Value: {
        let handle = .closures.at(closure).upvalues.at(index);
        let target: &const = .upvalues.at(handle);
        if target.is_open(): {
            return .stack.at(target.location);
        }
        return target.closed;
    }

    fn write_upvalue(self: &unique, closure: int, index: int, value: &const shared Value): {
        let handle = .closures.at(closure).upvalues.at(index);
        let target: &unique = .upvalues.at(handle);
        if target.is_open(): {
            .store_slot(target.location, value);
        } else: {
            target.closed = value;
        }
    }

    fn make_closure(self: &unique, function: &const shared Value, frame: &const shared CallFrame): {
        let handle = .allocate(ObjectKind::Closure, 0);
        let created: &unique = .closures.at(handle);
        created.function = .functions.at(function.as_object());
        for i in range(0, created.function.upvalue_count): {
            let descriptor: &const = .upvalue_plan.at(i);
            if descriptor.first: {
                created.upvalues.push_back(.capture_upvalue(frame.slot_base + descriptor.second));
            } else: {
                created.upvalues.push_back(.closures.at(frame.closure).upvalues.at(descriptor.second));
            }
        }
        .push(make_object(handle));
    }

    

    
    
    
    
    
    fn run(self: &unique) -> InterpretResult: {
        .steps = 0;
        .had_error = false;
        loop: {
            if .frame_count == 0: {
                break;
            }
            let frame: &unique = .frames.at(.frame_count - 1);
            let chunk: &const = .closures.at(frame.closure).function.chunk;
            if frame.ip >= chunk.size(): {
                
                .return_from(make_nil());
                continue;
            }
            if .trace_execution: {
                .print_stack();
                println(disassemble_instruction(chunk, frame.ip));
            }
            let ins: &const = chunk.code.at(frame.ip);
            let op = ins.op;
            frame.ip += 1;
            if .bytes_allocated > .next_gc: {
                .collect_garbage();
            }

            
            if op == OpCode::Constant: {
                .push(chunk.constant_at(ins.operand));
            } else: { if op == OpCode::ConstantLong: {
                .push(chunk.constant_at(ins.operand & OPERAND_MASK));
            } else: { if op == OpCode::Nil: {
                .push(make_nil());
            } else: { if op == OpCode::True: {
                .push(make_bool(true));
            } else: { if op == OpCode::False: {
                .push(make_bool(false));
            } else: { if op == OpCode::Pop: {
                discard .pop();
            } else: { if op == OpCode::PopN: {
                .pop_n(ins.operand);
            } else: { if op == OpCode::Dup: {
                .push(.peek(0));
            } else: { if op == OpCode::Swap: {
                .swap_top();
            } else: { if op == OpCode::Rotate: {
                
                .rotate(ins.operand);
            
            } else: { if op == OpCode::GetLocal: {
                .push(.stack.at(frame.local(ins.operand)));
            } else: { if op == OpCode::SetLocal: {
                .store_slot(frame.local(ins.operand), .peek(0));
            } else: { if op == OpCode::GetGlobal: {
                .load_global(chunk.constant_at(ins.operand));
            } else: { if op == OpCode::SetGlobal: {
                .assign_global(chunk.constant_at(ins.operand));
            } else: { if op == OpCode::DefineGlobal: {
                .define_global(chunk.constant_at(ins.operand));
            } else: { if op == OpCode::GetUpvalue: {
                .push(.read_upvalue(frame.closure, ins.operand));
            } else: { if op == OpCode::SetUpvalue: {
                .write_upvalue(frame.closure, ins.operand, .peek(0));
            } else: { if op == OpCode::GetProperty: {
                .get_property(chunk.constant_at(ins.operand));
            } else: { if op == OpCode::SetProperty: {
                .set_property(chunk.constant_at(ins.operand));
            } else: { if op == OpCode::GetIndex: {
                .index_get();
            } else: { if op == OpCode::SetIndex: {
                .index_set();
            
            } else: { if op == OpCode::Equal: {
                .compare_equal(false);
            } else: { if op == OpCode::NotEqual: {
                .compare_equal(true);
            } else: { if op == OpCode::Greater: {
                .compare_order(OpCode::Greater);
            } else: { if op == OpCode::GreaterEqual: {
                .compare_order(OpCode::GreaterEqual);
            } else: { if op == OpCode::Less: {
                .compare_order(OpCode::Less);
            } else: { if op == OpCode::LessEqual: {
                .compare_order(OpCode::LessEqual);
            
            } else: { if op == OpCode::Add: {
                
                if .peek(0).is_object() && .peek(1).is_object(): {
                    .concat_strings();
                } else: {
                    .arith(OpCode::Add);
                }
            } else: { if op == OpCode::Subtract: {
                .arith(OpCode::Subtract);
            } else: { if op == OpCode::Multiply: {
                .arith(OpCode::Multiply);
            } else: { if op == OpCode::Divide: {
                if .peek(0).as_number() == 0: {
                    .runtime_error("division by zero", chunk.line_at(frame.ip));
                } else: {
                    .arith(OpCode::Divide);
                }
            } else: { if op == OpCode::Modulo: {
                if .peek(0).as_number() == 0: {
                    .runtime_error("modulo by zero", chunk.line_at(frame.ip));
                } else: {
                    .arith(OpCode::Modulo);
                }
            } else: { if op == OpCode::Power: {
                .arith(OpCode::Power);
            
            } else: { if op == OpCode::Negate: {
                .negate();
            } else: { if op == OpCode::Increment: {
                .adjust(FIXED_SCALE);
            } else: { if op == OpCode::Decrement: {
                .adjust(-FIXED_SCALE);
            } else: { if op == OpCode::Not: {
                let value = .pop();
                .push(make_bool(!value.is_truthy()));
            
            } else: { if op == OpCode::BitAnd: {
                .bitwise(OpCode::BitAnd);
            } else: { if op == OpCode::BitOr: {
                .bitwise(OpCode::BitOr);
            } else: { if op == OpCode::BitXor: {
                .bitwise(OpCode::BitXor);
            } else: { if op == OpCode::BitNot: {
                .bit_not();
            } else: { if op == OpCode::ShiftLeft: {
                .bitwise(OpCode::ShiftLeft);
            } else: { if op == OpCode::ShiftRight: {
                .bitwise(OpCode::ShiftRight);
            } else: { if op == OpCode::ShiftRightLogical: {
                .bitwise(OpCode::ShiftRightLogical);
            
            } else: { if op == OpCode::Jump: {
                frame.jump_to(ins.operand);
            } else: { if op == OpCode::JumpIfFalse: {
                let cond = .pop();
                if !cond.is_truthy(): {
                    frame.jump_to(ins.operand);
                }
            } else: { if op == OpCode::JumpIfTrue: {
                let cond = .pop();
                if cond.is_truthy(): {
                    frame.jump_to(ins.operand);
                }
            } else: { if op == OpCode::JumpIfNil: {
                
                if .peek(0).is_nil(): {
                    frame.jump_to(ins.operand);
                }
            } else: { if op == OpCode::JumpIfNotNil: {
                if !.peek(0).is_nil(): {
                    frame.jump_to(ins.operand);
                }
            } else: { if op == OpCode::Loop: {
                
                frame.jump_to(ins.operand);
                .check_interrupt();
            
            } else: { if op == OpCode::Call: {
                .call_value(.peek(ins.operand), ins.operand);
            } else: { if op == OpCode::Invoke: {
                .invoke(chunk.constant_at(ins.operand), ins.extra);
            } else: { if op == OpCode::TailCall: {
                
                .tail_call(ins.operand);
            } else: { if op == OpCode::CallNative: {
                .call_native(ins.operand);
            
            } else: { if op == OpCode::Closure: {
                .make_closure(chunk.constant_at(ins.operand), frame);
            } else: { if op == OpCode::CloseUpvalue: {
                .close_upvalues(.stack_top - 1);
                discard .pop();
            } else: { if op == OpCode::Return: {
                .return_from(.pop());
            } else: { if op == OpCode::ReturnNil: {
                .return_from(make_nil());
            
            } else: { if op == OpCode::NewArray: {
                .new_array(ins.operand);
            } else: { if op == OpCode::ArrayPush: {
                .array_push();
            } else: { if op == OpCode::ArrayLength: {
                .array_length();
            } else: { if op == OpCode::ArraySlice: {
                .array_slice();
            } else: { if op == OpCode::ArrayConcat: {
                .array_concat();
            
            } else: { if op == OpCode::NewMap: {
                .new_map(ins.operand);
            } else: { if op == OpCode::MapInsert: {
                .map_insert();
            } else: { if op == OpCode::MapLookup: {
                .map_lookup();
            } else: { if op == OpCode::MapErase: {
                .map_erase();
            } else: { if op == OpCode::MapLength: {
                .map_length();
            
            } else: { if op == OpCode::Concat: {
                .concat_strings();
            } else: { if op == OpCode::Length: {
                .length_of();
            } else: { if op == OpCode::TypeOf: {
                .type_of();
            } else: { if op == OpCode::Print: {
                let value = .pop();
                println(.to_display(value));
            } else: { if op == OpCode::Assert: {
                let cond = .pop();
                if !cond.is_truthy(): {
                    .runtime_error("assertion failed", ins.operand);
                }
            } else: { if op == OpCode::Import: {
                .push(.import_module(chunk.constant_at(ins.operand)));
            } else: { if op == OpCode::Nop: {
                
                discard ins.operand;
            } else: { if op == OpCode::Halt: {
                .frame_count = 0;
                break;
            } else: {
                
                
                .runtime_error("unknown opcode", chunk.line_at(frame.ip));
            }
            } } } } } } } } } } } } } } } } } } }
            } } } } } } } } } } } } } } } } } } }
            } } } } } } } } } } } } } } } } } } }
            } } } } } } } } } } } } } } } } } }

            if .had_error: {
                .reset_stack();
                return InterpretResult::RuntimeError;
            }
        }
        return InterpretResult::Ok;
    }

    

    
    
    
    fn allocate(self: &unique, kind: ObjectKind, hint: int) -> int: {
        .bytes_allocated += 32 + hint * 16;
        if .bytes_allocated > .next_gc: {
            .collect_garbage();
        }
        var header: Obj;
        header.kind = kind;
        header.marked = false;
        header.handle = .objects.size();
        .objects.push_back(header);
        return header.handle;
    }

    fn collect_garbage(self: &unique): {
        let before = .bytes_allocated;
        .gray_stack.clear();
        .mark_roots();
        .trace_references();
        .sweep();
        .next_gc = .bytes_allocated * GC_GROWTH_PERCENT / 100;
        if .next_gc < GC_MIN_THRESHOLD: {
            .next_gc = GC_MIN_THRESHOLD;
        }
        if .trace_gc: {
            var line = string();
            line.append("gc: reclaimed ");
            line.append(to_string(before - .bytes_allocated));
            line.append(" bytes");
            println(line);
        }
    }

    
    
    fn mark_roots(self: &unique): {
        for value: &const in .stack: {
            .mark_value(value);
        }
        for frame: &const in .frames: {
            if frame.closure >= 0: {
                .mark_object(frame.closure);
            }
        }
        for handle: &const in .open_upvalues: {
            .mark_object(handle);
        }
        for entry: &const in .globals: {
            .mark_value(entry.second);
        }
        for entry: &const in .modules: {
            .mark_value(entry.second);
        }
        .mark_value(.last_result);
    }

    fn mark_value(self: &unique, value: &const shared Value): {
        if !value.is_object(): {
            return;
        }
        .mark_object(value.object);
    }

    fn mark_object(self: &unique, handle: int): {
        if handle < 0: {
            return;
        }
        let header: &unique = .objects.at(handle);
        if header.marked: {
            return;
        }
        header.marked = true;
        .gray_stack.push_back(handle);
    }

    
    fn trace_references(self: &unique): {
        while !.gray_stack.empty(): {
            let handle = .gray_stack.back();
            .gray_stack.pop_back();
            .blacken_object(handle);
        }
    }

    fn blacken_object(self: &unique, handle: int): {
        let kind = .objects.at(handle).kind;
        if kind == ObjectKind::Array: {
            for value: &const in .arrays.at(handle).items: {
                .mark_value(value);
            }
        } else: { if kind == ObjectKind::Map: {
            for value: &const in .maps.at(handle).keys: {
                .mark_value(value);
            }
            for value: &const in .maps.at(handle).values: {
                .mark_value(value);
            }
        } else: { if kind == ObjectKind::Closure: {
            for upvalue: &const in .closures.at(handle).upvalues: {
                .mark_object(upvalue);
            }
            .mark_chunk(.closures.at(handle).function.chunk);
        } else: { if kind == ObjectKind::Upvalue: {
            .mark_value(.upvalues.at(handle).closed);
        } else: { if kind == ObjectKind::Function: {
            .mark_chunk(.functions.at(handle).chunk);
        } else: { if kind == ObjectKind::BoundMethod: {
            .mark_object(.bound_methods.at(handle));
        } else: {
            
            discard handle;
        }
        } } } } }
    }

    fn mark_chunk(self: &unique, chunk: &const shared Chunk): {
        for value: &const in chunk.constants: {
            .mark_value(value);
        }
    }

    
    
    fn sweep(self: &unique): {
        var i: int = 0;
        while i < .objects.size(): {
            let header: &unique = .objects.at(i);
            if header.marked: {
                header.marked = false;
                i += 1;
            } else: {
                .free_object(i);
                i += 1;
            }
        }
    }

    fn free_object(self: &unique, handle: int): {
        let header: &unique = .objects.at(handle);
        .bytes_allocated -= 32;
        if header.kind == ObjectKind::Array: {
            .arrays.at(handle).items.clear();
        } else: { if header.kind == ObjectKind::Map: {
            .maps.at(handle).keys.clear();
            .maps.at(handle).values.clear();
        } else: { if header.kind == ObjectKind::Closure: {
            .closures.at(handle).upvalues.clear();
        } else: {
            discard handle;
        }
        } }
        header.handle = -1;
    }

    

    stack: vector{Value};
    stack_top: int = 0;
    frames: vector{CallFrame};
    frame_count: int = 0;

    globals: map{string, Value};
    modules: map{string, Value};
    interned: map{string, int};
    strings_by_handle: map{int, string};

    
    objects: vector{Obj};
    arrays: vector{ObjArray};
    maps: vector{ObjMap};
    closures: vector{ObjClosure};
    functions: vector{ObjFunction};
    upvalues: vector{ObjUpvalue};
    natives: vector{ObjNative};
    bound_methods: vector{int};

    
    
    upvalue_plan: vector{pair{bool, int}};
    open_upvalues: vector{int};
    gray_stack: vector{int};

    bytes_allocated: int = 0;
    next_gc: int = 1048576;
    steps: int = 0;
    last_result: Value;

    had_error: bool = false;
    interrupted: bool = false;
    trace_execution: bool = false;
    trace_gc: bool = false;
}



fn object_kind_name(kind: ObjectKind) -> string: {
    if kind == ObjectKind::String: {
        return "string";
    } else: { if kind == ObjectKind::Array: {
        return "array";
    } else: { if kind == ObjectKind::Map: {
        return "map";
    } else: { if kind == ObjectKind::Function: {
        return "function";
    } else: { if kind == ObjectKind::Closure: {
        return "closure";
    } else: { if kind == ObjectKind::Upvalue: {
        return "upvalue";
    } else: { if kind == ObjectKind::Native: {
        return "native";
    } else: { if kind == ObjectKind::BoundMethod: {
        return "method";
    } else: { if kind == ObjectKind::Instance: {
        return "instance";
    } else: {
        return "class";
    }
    } } } } } } } }
}


fn format_fixed(value: int) -> string: {
    var text = string();
    if value < 0: {
        text.append("-");
    }
    let magnitude = abs(value);
    text.append(to_string(magnitude / FIXED_SCALE));
    let fraction = magnitude % FIXED_SCALE;
    if fraction != 0: {
        text.append(".");
        var divisor = FIXED_SCALE / 10;
        while divisor > 0: {
            text.append(to_string(fraction / divisor % 10));
            divisor /= 10;
        }
    }
    return text;
}




fn interpret(machine: &unique VM, chunk: Chunk) -> InterpretResult: {
    machine.reset_stack();
    let handle = machine.allocate(ObjectKind::Closure, 0);
    let entry: &unique = machine.closures.at(handle);
    entry.function.chunk = chunk;
    entry.function.arity = 0;
    machine.push(make_object(handle));
    machine.call_closure(handle, 0, false);
    let result = machine.run();
    if result == InterpretResult::RuntimeError: {
        println("execution aborted");
    }
    return result;
}



fn verify_chunk(chunk: &const shared Chunk) -> bool: {
    var depth: int = 0;
    for i in range(0, chunk.size()): {
        let ins: &const = chunk.code.at(i);
        depth += stack_effect(ins.op, ins.operand);
        if depth < 0: {
            return false;
        }
        if ins.is_jump(): {
            if ins.operand < 0 || ins.operand >= chunk.size(): {
                return false;
            }
        }
        if opcode_operand_count(ins.op) > 0: {
            if opcode_operand_kind(ins.op) == OperandKind::ConstantSlot: {
                if ins.operand >= chunk.constants.size(): {
                    return false;
                }
            }
        }
    }
    prove depth >= 0;
    return true;
}

}






















namespace chess: {



static BOARD_FILES: int = 8;
static BOARD_RANKS: int = 8;
static SQUARE_COUNT: int = 64;
static COLOR_COUNT: int = 2;
static PIECE_KIND_COUNT: int = 6;
static PIECE_CODE_COUNT: int = 12;



static NO_SQUARE: int = -1;



static SQUARE_BITS: int = 6;
static SQUARE_MASK: int = 63;             
static FILE_MASK_BITS: int = 7;           
static RANK_SHIFT: int = 3;
static BYTE_MASK: int = 255;              
static WORD_MASK: int = 65535;            



static FULL_BOARD: int = -1;
static EMPTY_BOARD: int = 0;



static DIR_NORTH: int = 8;
static DIR_SOUTH: int = -8;
static DIR_EAST: int = 1;
static DIR_WEST: int = -1;
static DIR_NORTH_EAST: int = 9;
static DIR_NORTH_WEST: int = 7;
static DIR_SOUTH_EAST: int = -7;
static DIR_SOUTH_WEST: int = -9;




static RAY_NORTH: int = 0;
static RAY_NORTH_EAST: int = 1;
static RAY_EAST: int = 2;
static RAY_SOUTH_EAST: int = 3;
static RAY_SOUTH: int = 4;
static RAY_SOUTH_WEST: int = 5;
static RAY_WEST: int = 6;
static RAY_NORTH_WEST: int = 7;
static RAY_COUNT: int = 8;



static ROOK_RAY_COUNT: int = 4;
static BISHOP_RAY_COUNT: int = 4;


static SQ_A1: int = 0;
static SQ_B1: int = 1;
static SQ_C1: int = 2;
static SQ_D1: int = 3;
static SQ_E1: int = 4;
static SQ_F1: int = 5;
static SQ_G1: int = 6;
static SQ_H1: int = 7;
static SQ_A8: int = 56;
static SQ_B8: int = 57;
static SQ_C8: int = 58;
static SQ_D8: int = 59;
static SQ_E8: int = 60;
static SQ_F8: int = 61;
static SQ_G8: int = 62;
static SQ_H8: int = 63;


static CASTLE_WHITE_KING: int = 1;        
static CASTLE_WHITE_QUEEN: int = 2;       
static CASTLE_BLACK_KING: int = 4;        
static CASTLE_BLACK_QUEEN: int = 8;       

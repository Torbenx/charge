static HANGUL_T_FIRST: int = 4519;             
static HANGUL_T_COUNT: int = 28;
static HANGUL_NV_COUNT: int = 588;             

static ZERO_WIDTH_JOINER: int = 8205;          
static ZERO_WIDTH_NON_JOINER: int = 8204;      
static COMBINING_ENCLOSING_KEYCAP: int = 8419; 
static REGIONAL_INDICATOR_FIRST: int = 127462; 
static REGIONAL_INDICATOR_LAST: int = 127487;  
static VARIATION_SELECTOR_FIRST: int = 65024;  
static VARIATION_SELECTOR_LAST: int = 65039;   

fn is_hangul_syllable(scalar: int) => scalar >= HANGUL_SYLLABLE_FIRST && scalar <= HANGUL_SYLLABLE_LAST;

fn hangul_is_lv(scalar: int) -> bool: {
    if is_hangul_syllable(scalar) == false: {
        return false;
    }
    return ((scalar - HANGUL_SYLLABLE_FIRST) % HANGUL_T_COUNT) == 0;
}

fn hangul_is_lvt(scalar: int) -> bool: {
    if is_hangul_syllable(scalar) == false: {
        return false;
    }
    return ((scalar - HANGUL_SYLLABLE_FIRST) % HANGUL_T_COUNT) != 0;
}



enum DecodeError: {
    None;
    TruncatedSequence;          
    UnexpectedContinuation;     
    InvalidLeadByte;            
    MissingContinuation;        
    OverlongEncoding;           
    SurrogateCodePoint;         
    CodePointTooLarge;          
    UnpairedHighSurrogate;
    UnpairedLowSurrogate;
    BufferTooSmall;
    EmptyInput;
}




    var rows: vector{CombiningRange};
    rows.push_back(CombiningRange(first: 768, last: 788, combining: 230));      
    rows.push_back(CombiningRange(first: 789, last: 789, combining: 232));      
    rows.push_back(CombiningRange(first: 790, last: 793, combining: 220));      

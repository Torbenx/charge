static var generated_move_count: int = 0;
static var legality_test_count: int = 0;
static var attack_query_count: int = 0;
static var make_move_count: int = 0;





enum Color: {
    White;
    Black;
    ColorNone = 2;
}



enum PieceKind: {
    Pawn;
    Knight;
    Bishop;
    Rook;
    Queen;
    King;
    KindNone = 6;
}




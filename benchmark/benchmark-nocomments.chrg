fn is_digit(c: char) -> bool: {
    if c < CHAR_ZERO: {
        return false;
    }
    if c > CHAR_NINE: {
        return false;
    }
    return true;
}

fn is_octal_digit(c: char) -> bool: {
    if c < CHAR_ZERO: {
        return false;
    }
    if c > CHAR_SEVEN: {
        return false;
    }
    return true;
}

fn is_lower(c: char) -> bool: {
    if c < CHAR_LOWER_A: {
        return false;
    }
    if c > CHAR_LOWER_Z: {
        return false;
    }
    return true;
}

fn is_upper(c: char) -> bool: {
    if c < CHAR_UPPER_A: {
        return false;
    }
    if c > CHAR_UPPER_Z: {
        return false;
    }
    return true;
}

fn is_alpha(c: char) -> bool: {
    if is_lower(c): {
        return true;
    }
    if is_upper(c): {
        return true;
    }
    return false;
}

fn is_alnum(c: char) -> bool: {
    if is_alpha(c): {
        return true;
    }
    return is_digit(c);
}


fn is_word_char(c: char) -> bool: {
    if is_alnum(c): {
        return true;
    }
    if c == CHAR_UNDERSCORE: {
        return true;
    }
    return false;
}

fn is_hex_digit(c: char) -> bool: {
    if is_digit(c): {
        return true;
    }
    if c >= CHAR_LOWER_A && c <= CHAR_LOWER_F: {
        return true;
    }
    if c >= CHAR_UPPER_A && c <= CHAR_UPPER_F: {
        return true;
    }
    return false;
}


fn is_horizontal_space(c: char) -> bool: {
    if c == CHAR_SPACE: {
        return true;
    }
    if c == CHAR_TAB: {
        return true;
    }
    return false;
}


fn is_vertical_space(c: char) -> bool: {
    if c == CHAR_NEWLINE: {
        return true;
    }
    if c == CHAR_RETURN: {
        return true;
    }
    if c == CHAR_FORMFEED: {
        return true;
    }
    return false;
}

fn is_space_char(c: char) -> bool: {
    if is_horizontal_space(c): {
        return true;
    }
    if is_vertical_space(c): {
        return true;
    }
    return false;
}


fn is_control(c: char) -> bool: {
    let code = char_code(c);
    if code < 32: {
        return true;
    }
    if code == 127: {
        return true;
    }
    return false;
}

fn is_printable(c: char) -> bool: {
    let code = char_code(c);
    if code < 32: {
        return false;
    }
    if code > 126: {
        return false;
    }
    return true;
}


fn is_graphic(c: char) -> bool: {
    if !is_printable(c): {
        return false;
    }
    return c != CHAR_SPACE;
}

fn is_punctuation(c: char) -> bool: {
    if !is_graphic(c): {
        return false;
    }
    if is_alnum(c): {
        return false;
    }
    return true;
}


fn is_metacharacter(c: char) -> bool: {
    if c == CHAR_BACKSLASH: {
        return true;
    }
    if c == CHAR_CARET: {
        return true;
    }
    if c == CHAR_DOLLAR: {
        return true;
    }
    if c == CHAR_DOT: {
        return true;
    }
    if c == CHAR_STAR: {
        return true;
    }
    if c == CHAR_PLUS: {
        return true;
    }
    if c == CHAR_QUESTION: {
        return true;
    }
    if c == CHAR_PIPE: {
        return true;
    }
    if c == CHAR_LPAREN: {
        return true;
    }
    if c == CHAR_RPAREN: {
        return true;
    }
    if c == CHAR_LBRACKET: {
        return true;
    }
    if c == CHAR_RBRACKET: {
        return true;
    }
    if c == CHAR_LBRACE: {
        return true;
    }
    if c == CHAR_RBRACE: {
        return true;
    }
    return false;
}


fn is_class_metacharacter(c: char) -> bool: {
    if c == CHAR_BACKSLASH: {
        return true;
    }
    if c == CHAR_RBRACKET: {
        return true;
    }
    if c == CHAR_MINUS: {
        return true;
    }
    if c == CHAR_CARET: {
        return true;
    }
    if c == CHAR_LBRACKET: {
        return true;
    }
    return false;
}



fn to_lower(c: char) -> char: {
    if is_upper(c): {
        return code_char(char_code(c) + 32);
    }
    return c;
}

fn to_upper(c: char) -> char: {
    if is_lower(c): {
        return code_char(char_code(c) - 32);
    }
    return c;
}


fn hex_value(c: char) -> int: {
    if is_digit(c): {
        return char_code(c) - char_code(CHAR_ZERO);
    }
    if c >= CHAR_LOWER_A && c <= CHAR_LOWER_F: {
        return 10 + char_code(c) - char_code(CHAR_LOWER_A);
    }
    if c >= CHAR_UPPER_A && c <= CHAR_UPPER_F: {
        return 10 + char_code(c) - char_code(CHAR_UPPER_A);
    }
    return NONE;
}

fn digit_value(c: char) -> int: {
    if !is_digit(c): {
        return NONE;
    }
    return char_code(c) - char_code(CHAR_ZERO);
}


fn char_code(c: char) -> int: {
    var code: int = 0;
    code = c;
    return code;
}

fn code_char(code: int) -> char: {
    var c: char = CHAR_NUL;
    c = code;
    return c;
}



fn same_char_folded(a: char, b: char) -> bool: {
    if a == b: {
        return true;
    }
    return to_lower(a) == to_lower(b);
}










enum TokenKind: {
    EndOfPattern;
    Literal;            
    AnyChar;            
    AlternationBar;     
    GroupOpen;          
    GroupClose;         
    ClassOpen;          
    ClassClose;         
    Star;               
    Plus;               
    Question;           
    RepeatOpen;         
    CaretAnchor;        
    DollarAnchor;       
    TextStartAnchor;    
    TextEndAnchor;      
    WordBoundary;       
    NotWordBoundary;    
    ShorthandClass;     
    Backreference;      
    Invalid = 21;
}


enum Shorthand: {
    ShortDigit;
    ShortNotDigit;
    ShortWord;
    ShortNotWord;
    ShortSpace;
    ShortNotSpace;
    ShortHorizontal;
    ShortVertical;
    ShortNone = 8;
}


enum GroupKind: {
    Capturing;          
    NonCapturing;       
    Named;              
    Atomic = 3;         
}

struct Token: {

    fn is_end(self: &const shared) -> bool: {
        return .kind == TokenKind::EndOfPattern;
    }

    fn is_literal(self: &const shared) -> bool: {
        return .kind == TokenKind::Literal;
    }

    
    
    fn is_quantifier(self: &const shared) -> bool: {
        if .kind == TokenKind::Star: {
            return true;
        }
        if .kind == TokenKind::Plus: {
            return true;
        }
        if .kind == TokenKind::Question: {
            return true;
        }
        if .kind == TokenKind::RepeatOpen: {
            return true;
        }
        return false;
    }

    fn is_anchor(self: &const shared) -> bool: {
        if .kind == TokenKind::CaretAnchor: {
            return true;
        }
        if .kind == TokenKind::DollarAnchor: {
            return true;
        }
        if .kind == TokenKind::TextStartAnchor: {
            return true;
        }
        if .kind == TokenKind::TextEndAnchor: {
            return true;
        }
        if .kind == TokenKind::WordBoundary: {
            return true;
        }
        if .kind == TokenKind::NotWordBoundary: {
            return true;
        }
        return false;
    }

    
    
    fn starts_atom(self: &const shared) -> bool: {
        if .is_literal(): {
            return true;
        }
        if .kind == TokenKind::AnyChar: {
            return true;
        }
        if .kind == TokenKind::ClassOpen: {
            return true;
        }
        if .kind == TokenKind::GroupOpen: {
            return true;
        }
        if .kind == TokenKind::ShorthandClass: {
            return true;
        }
        if .kind == TokenKind::Backreference: {
            return true;
        }
        return .is_anchor();
    }

    kind: TokenKind = TokenKind::Invalid;
    value: char = '\0';
    text: string;
    shorthand: Shorthand = Shorthand::ShortNone;
    group_kind: GroupKind = GroupKind::Capturing;
    lower: int = 0;
    upper: int = -1;
    position: int = 0;
    
    
    escaped: bool = false;
}



struct PatternLexer: {

    fn at_end(self: &const shared) -> bool: {
        return .pos >= .source.size();
    }

    fn remaining(self: &const shared) -> int: {
        return .source.size() - .pos;
    }

    fn peek(self: &const shared) -> char: {
        if .at_end(): {
            return CHAR_NUL;
        }
        return .source.at(.pos);
    }

    fn peek_at(self: &const shared, offset: int) -> char: {
        let index = .pos + offset;
        if index < 0: {
            return CHAR_NUL;
        }
        if index >= .source.size(): {
            return CHAR_NUL;
        }
        return .source.at(index);
    }

    fn advance(self: &unique) -> char: {
        if .at_end(): {
            return CHAR_NUL;
        }
        let c = .source.at(.pos);
        .pos += 1;
        return c;
    }

    fn accept(self: &unique, expected: char) -> bool: {
        if .peek() != expected: {
            return false;
        }
        .pos += 1;
        return true;
    }

    fn fail(self: &unique, message: &const shared string): {
        if .ok: {
            .ok = false;
            .error = message;
            .error_position = .pos;
        }
    }

    

    fn make_token(self: &const shared, kind: TokenKind, at: int) -> Token: {
        var t = Token(kind: kind, position: at);
        return t;
    }

    fn make_literal(self: &const shared, c: char, at: int, escaped: bool) -> Token: {
        var t = Token(kind: TokenKind::Literal, value: c, position: at);
        t.escaped = escaped;
        return t;
    }

    fn make_shorthand(self: &const shared, which: Shorthand, at: int) -> Token: {
        var t = Token(kind: TokenKind::ShorthandClass, position: at);
        t.shorthand = which;
        return t;
    }

    

    fn tokenize(self: &unique) -> bool: {
        .tokens.clear();
        .pos = 0;
        .ok = true;
        .error = ERROR_NONE;
        while !.at_end(): {
            let t = .next_token();
            if !.ok: {
                return false;
            }
            .tokens.push_back(t);
        }
        .tokens.push_back(.make_token(TokenKind::EndOfPattern, .source.size()));
        return true;
    }

    
    
    
    fn next_token(self: &unique) -> Token: {
        let at = .pos;
        let c = .advance();
        if c == CHAR_BACKSLASH: {
            return .lex_escape(at);
        }
        if c == CHAR_DOT: {
            return .make_token(TokenKind::AnyChar, at);
        }
        if c == CHAR_PIPE: {
            return .make_token(TokenKind::AlternationBar, at);
        }
        if c == CHAR_LPAREN: {
            return .lex_group_open(at);
        }
        if c == CHAR_RPAREN: {
            return .make_token(TokenKind::GroupClose, at);
        }
        if c == CHAR_LBRACKET: {
            return .make_token(TokenKind::ClassOpen, at);
        }
        if c == CHAR_RBRACKET: {
            
            
            return .make_literal(c, at, false);
        }
        if c == CHAR_STAR: {
            return .make_token(TokenKind::Star, at);
        }
        if c == CHAR_PLUS: {
            return .make_token(TokenKind::Plus, at);
        }
        if c == CHAR_QUESTION: {
            return .make_token(TokenKind::Question, at);
        }
        if c == CHAR_LBRACE: {
            return .lex_repeat_bound(at);
        }
        if c == CHAR_RBRACE: {
            return .make_literal(c, at, false);
        }
        if c == CHAR_CARET: {
            return .make_token(TokenKind::CaretAnchor, at);
        }
        if c == CHAR_DOLLAR: {
            return .make_token(TokenKind::DollarAnchor, at);
        }
        return .make_literal(c, at, false);
    }

    
    
    
    
    

    fn lex_escape(self: &unique, at: int) -> Token: {
        if .at_end(): {
            .fail(ERROR_TRAILING_BACKSLASH);
            return .make_token(TokenKind::Invalid, at);
        }
        let c = .advance();
        if c == CHAR_LOWER_D: {
            return .make_shorthand(Shorthand::ShortDigit, at);
        }
        if c == CHAR_UPPER_D: {
            return .make_shorthand(Shorthand::ShortNotDigit, at);
        }
        if c == CHAR_LOWER_W: {
            return .make_shorthand(Shorthand::ShortWord, at);
        }
        if c == CHAR_UPPER_W: {
            return .make_shorthand(Shorthand::ShortNotWord, at);
        }
        if c == CHAR_LOWER_S: {
            return .make_shorthand(Shorthand::ShortSpace, at);
        }
        if c == CHAR_UPPER_S: {
            return .make_shorthand(Shorthand::ShortNotSpace, at);
        }
        if c == CHAR_LOWER_H: {
            return .make_shorthand(Shorthand::ShortHorizontal, at);
        }
        if c == CHAR_LOWER_V: {
            return .make_shorthand(Shorthand::ShortVertical, at);
        }
        if c == CHAR_LOWER_B: {
            return .make_token(TokenKind::WordBoundary, at);
        }
        if c == CHAR_UPPER_B: {
            return .make_token(TokenKind::NotWordBoundary, at);
        }
        if c == CHAR_UPPER_A: {
            return .make_token(TokenKind::TextStartAnchor, at);
        }
        if c == CHAR_LOWER_Z: {
            return .make_token(TokenKind::TextEndAnchor, at);
        }
        if c == CHAR_LOWER_K: {
            return .lex_named_backreference(at);
        }
        if is_digit(c) && c != CHAR_ZERO: {
            return .lex_numeric_backreference(c, at);
        }
        if c == CHAR_LOWER_X: {
            return .lex_hex_escape(at);
        }
        return .make_literal(decode_escape(c), at, true);
    }

    
    
    fn lex_named_backreference(self: &unique, at: int) -> Token: {
        var t = .make_token(TokenKind::Backreference, at);
        if !.accept(CHAR_LESS): {
            .fail(ERROR_BAD_BACKREF);
            return .make_token(TokenKind::Invalid, at);
        }
        var name = TEXT_EMPTY;
        while !.at_end(): {
            let c = .peek();
            if c == CHAR_GREATER: {
                break;
            }
            if !is_word_char(c): {
                .fail(ERROR_BAD_BACKREF);
                return .make_token(TokenKind::Invalid, at);
            }
            name.push_back(c);
            .pos += 1;
        }
        if !.accept(CHAR_GREATER): {
            .fail(ERROR_BAD_BACKREF);
            return .make_token(TokenKind::Invalid, at);
        }
        if name.empty(): {
            .fail(ERROR_BAD_BACKREF);
            return .make_token(TokenKind::Invalid, at);
        }
        t.text = name;
        t.lower = NONE;
        return t;
    }

    
    
    fn lex_numeric_backreference(self: &unique, first: char, at: int) -> Token: {
        var value = digit_value(first);
        while !.at_end(): {
            let c = .peek();
            if !is_digit(c): {
                break;
            }
            let next = value * 10 + digit_value(c);
            if next >= MAX_CAPTURES: {
                break;
            }
            value = next;
            .pos += 1;
        }
        var t = .make_token(TokenKind::Backreference, at);
        t.lower = value;
        return t;
    }

    
    
    fn lex_hex_escape(self: &unique, at: int) -> Token: {
        if .remaining() < 2: {
            .fail(ERROR_BAD_ESCAPE);
            return .make_token(TokenKind::Invalid, at);
        }
        let high = .advance();
        let low = .advance();
        if !is_hex_digit(high): {
            .fail(ERROR_BAD_ESCAPE);
            return .make_token(TokenKind::Invalid, at);
        }
        if !is_hex_digit(low): {
            .fail(ERROR_BAD_ESCAPE);
            return .make_token(TokenKind::Invalid, at);
        }
        let code = hex_value(high) * 16 + hex_value(low);
        return .make_literal(code_char(code), at, true);
    }

    

    fn lex_group_open(self: &unique, at: int) -> Token: {
        var t = .make_token(TokenKind::GroupOpen, at);
        if .peek() != CHAR_QUESTION: {
            t.group_kind = GroupKind::Capturing;
            return t;
        }
        .pos += 1;
        let c = .advance();
        if c == CHAR_COLON: {
            t.group_kind = GroupKind::NonCapturing;
            return t;
        }
        if c == CHAR_GREATER: {
            t.group_kind = GroupKind::Atomic;
            return t;
        }
        if c == CHAR_LESS: {
            var name = TEXT_EMPTY;
            while !.at_end(): {
                let n = .peek();
                if n == CHAR_GREATER: {
                    break;
                }
                if !is_word_char(n): {
                    .fail(ERROR_BAD_GROUP);
                    return .make_token(TokenKind::Invalid, at);
                }
                name.push_back(n);
                .pos += 1;
            }
            if !.accept(CHAR_GREATER): {
                .fail(ERROR_BAD_GROUP);
                return .make_token(TokenKind::Invalid, at);
            }
            if name.empty(): {
                .fail(ERROR_BAD_GROUP);
                return .make_token(TokenKind::Invalid, at);
            }
            t.group_kind = GroupKind::Named;
            t.text = name;
            return t;
        }
        .fail(ERROR_BAD_GROUP);
        return .make_token(TokenKind::Invalid, at);
    }

    
    
    
    
    

    fn lex_repeat_bound(self: &unique, at: int) -> Token: {
        let save = .pos;
        if !is_digit(.peek()): {
            .pos = save;
            return .make_literal(CHAR_LBRACE, at, false);
        }
        var lower: int = 0;
        var digits: int = 0;
        while is_digit(.peek()): {
            lower = lower * 10 + digit_value(.peek());
            digits += 1;
            .pos += 1;
            if lower > MAX_REPEAT: {
                .fail(ERROR_REPEAT_TOO_LARGE);
                return .make_token(TokenKind::Invalid, at);
            }
        }
        var t = .make_token(TokenKind::RepeatOpen, at);
        t.lower = lower;
        if .accept(CHAR_RBRACE): {
            t.upper = lower;
            return t;
        }
        if !.accept(CHAR_COMMA): {
            .pos = save;
            return .make_literal(CHAR_LBRACE, at, false);
        }
        if .accept(CHAR_RBRACE): {
            
            t.upper = NONE;
            return t;
        }
        if !is_digit(.peek()): {
            .pos = save;
            return .make_literal(CHAR_LBRACE, at, false);
        }
        var upper: int = 0;
        while is_digit(.peek()): {
            upper = upper * 10 + digit_value(.peek());
            .pos += 1;
            if upper > MAX_REPEAT: {
                .fail(ERROR_REPEAT_TOO_LARGE);
                return .make_token(TokenKind::Invalid, at);
            }
        }
        if !.accept(CHAR_RBRACE): {
            .pos = save;
            return .make_literal(CHAR_LBRACE, at, false);
        }
        if upper < lower: {
            .fail(ERROR_BAD_REPEAT);
            return .make_token(TokenKind::Invalid, at);
        }
        t.upper = upper;
        return t;
    }

    source: string;
    tokens: vector{Token};
    pos: int = 0;
    error: string;
    error_position: int = 0;
    ok: bool = true;
}



fn decode_escape(marker: char) -> char: {
    if marker == CHAR_LOWER_N: {
        return CHAR_NEWLINE;
    }
    if marker == CHAR_LOWER_T: {
        return CHAR_TAB;
    }
    if marker == CHAR_LOWER_R: {
        return CHAR_RETURN;
    }
    if marker == CHAR_LOWER_F: {
        return CHAR_FORMFEED;
    }
    if marker == CHAR_ZERO: {
        return CHAR_NUL;
    }
    if marker == CHAR_LOWER_E: {
        return code_char(27);
    }
    return marker;
}


fn escape_spelling(c: char) -> string: {
    if c == CHAR_NEWLINE: {
        return ESCAPE_NEWLINE;
    }
    if c == CHAR_TAB: {
        return ESCAPE_TAB;
    }
    if c == CHAR_RETURN: {
        return ESCAPE_RETURN;
    }
    if c == CHAR_FORMFEED: {
        return ESCAPE_FORMFEED;
    }
    if c == CHAR_BACKSLASH: {
        return ESCAPE_BACKSLASH;
    }
    var out = TEXT_EMPTY;
    if is_metacharacter(c): {
        out.push_back(CHAR_BACKSLASH);
    }
    out.push_back(c);
    return out;
}








struct ClassRange: {

    fn contains(self: &const shared, code: int) -> bool: {
        if code < .low: {
            return false;
        }
        if code > .high: {
            return false;
        }
        return true;
    }

    fn width(self: &const shared) -> int: {
        return .high - .low + 1;
    }

    fn is_single(self: &const shared) -> bool: {
        return .low == .high;
    }

    
    fn touches(self: &const shared, other: &const shared ClassRange) -> bool: {
        if other.low > .high + 1: {
            return false;
        }
        if .low > other.high + 1: {
            return false;
        }
        return true;
    }

    fn fuse(self: &unique, other: &const shared ClassRange): {
        if other.low < .low: {
            .low = other.low;
        }
        if other.high > .high: {
            .high = other.high;
        }
    }

    low: int = 0;
    high: int = 0;
}

fn make_range(low: int, high: int) -> ClassRange: {
    var r = ClassRange(low: low, high: high);
    if high < low: {
        r.low = high;
        r.high = low;
    }
    return r;
}

fn single_range(c: char) -> ClassRange: {
    let code = char_code(c);
    return make_range(code, code);
}

struct CharClass: {

    fn empty(self: &const shared) -> bool: {
        return .ranges.empty();
    }

    fn range_count(self: &const shared) -> int: {
        return .ranges.size();
    }

    fn add_range(self: &unique, low: int, high: int): {
        .ranges.push_back(make_range(low, high));
        .normalised = false;
    }

    fn add_char(self: &unique, c: char): {
        let code = char_code(c);
        .add_range(code, code);
    }

    fn add_char_range(self: &unique, low: char, high: char): {
        .add_range(char_code(low), char_code(high));
    }

    
    
    
    fn add_class(self: &unique, other: &const shared CharClass): {
        for r: &const in other.ranges: {
            .add_range(r.low, r.high);
        }
        .normalised = false;
    }

    fn negate(self: &unique): {
        .negated = !.negated;
    }

    
    
    
    fn sort_ranges(self: &unique): {
        var i: int = 1;
        while i < .ranges.size(): {
            var j = i;
            while j > 0: {
                let left: &const = .ranges[j - 1];
                let right: &const = .ranges[j];
                if left.low <= right.low: {
                    break;
                }
                swap(.ranges[j - 1], .ranges[j]);
                j -= 1;
            }
            i += 1;
        }
    }

    
    
    
    fn normalise(self: &unique): {
        if .normalised: {
            return;
        }
        if .ranges.empty(): {
            .normalised = true;
            return;
        }
        .sort_ranges();
        var merged = vector{ClassRange}();
        merged.push_back(.ranges[0]);
        var i: int = 1;
        while i < .ranges.size(): {
            let next: &const = .ranges[i];
            let last: &unique = merged.back();
            if last.touches(next): {
                last.fuse(next);
            } else: {
                merged.push_back(next);
            }
            i += 1;
        }
        .ranges = move(merged);
        .normalised = true;
    }

    fn contains_code(self: &const shared, code: int) -> bool: {
        var found = false;
        for r: &const in .ranges: {
            if r.contains(code): {
                found = true;
                break;
            }
        }
        if .negated: {
            return !found;
        }
        return found;
    }

    fn matches(self: &const shared, c: char) -> bool: {
        return .contains_code(char_code(c));
    }

    
    
    
    fn matches_folded(self: &const shared, c: char) -> bool: {
        if .matches(c): {
            return true;
        }
        if is_lower(c): {
            return .matches(to_upper(c));
        }
        if is_upper(c): {
            return .matches(to_lower(c));
        }
        return false;
    }

    
    
    fn cardinality(self: &const shared) -> int: {
        var total: int = 0;
        for r: &const in .ranges: {
            total += r.width();
        }
        if .negated: {
            return ALPHABET_SIZE - total;
        }
        return total;
    }

    fn is_single_char(self: &const shared) -> bool: {
        if .negated: {
            return false;
        }
        if .ranges.size() != 1: {
            return false;
        }
        let only: &const = .ranges[0];
        return only.is_single();
    }

    fn single_char(self: &const shared) -> char: {
        let only: &const = .ranges[0];
        return code_char(only.low);
    }

    fn equals(self: &const shared, other: &const shared CharClass) -> bool: {
        if .negated != other.negated: {
            return false;
        }
        if .ranges.size() != other.ranges.size(): {
            return false;
        }
        var i: int = 0;
        while i < .ranges.size(): {
            let a: &const = .ranges[i];
            let b: &const = other.ranges[i];
            if a.low != b.low: {
                return false;
            }
            if a.high != b.high: {
                return false;
            }
            i += 1;
        }
        return true;
    }

    
    fn spell(self: &const shared) -> string: {
        var out = TEXT_LBRACKET;
        if .negated: {
            out.push_back(CHAR_CARET);
        }
        for r: &const in .ranges: {
            out.append(escape_spelling(code_char(r.low)));
            if !r.is_single(): {
                out.push_back(CHAR_MINUS);
                out.append(escape_spelling(code_char(r.high)));
            }
        }
        out.append(TEXT_RBRACKET);
        return out;
    }

    ranges: vector{ClassRange};
    negated: bool = false;
    normalised: bool = true;
}






fn class_of_digits() -> CharClass: {
    var c = CharClass();
    c.add_char_range(CHAR_ZERO, CHAR_NINE);
    return c;
}

fn class_of_word() -> CharClass: {
    var c = CharClass();
    c.add_char_range(CHAR_LOWER_A, CHAR_LOWER_Z);
    c.add_char_range(CHAR_UPPER_A, CHAR_UPPER_Z);
    c.add_char_range(CHAR_ZERO, CHAR_NINE);
    c.add_char(CHAR_UNDERSCORE);
    return c;
}

fn class_of_space() -> CharClass: {
    var c = CharClass();
    c.add_char(CHAR_SPACE);
    c.add_char(CHAR_TAB);
    c.add_char(CHAR_NEWLINE);
    c.add_char(CHAR_RETURN);
    c.add_char(CHAR_FORMFEED);
    c.add_char(code_char(11));
    return c;
}

fn class_of_horizontal() -> CharClass: {
    var c = CharClass();
    c.add_char(CHAR_SPACE);
    c.add_char(CHAR_TAB);
    return c;
}

fn class_of_vertical() -> CharClass: {
    var c = CharClass();
    c.add_char(CHAR_NEWLINE);
    c.add_char(CHAR_RETURN);
    c.add_char(CHAR_FORMFEED);
    c.add_char(code_char(11));
    return c;
}

fn class_of_alpha() -> CharClass: {
    var c = CharClass();
    c.add_char_range(CHAR_LOWER_A, CHAR_LOWER_Z);
    c.add_char_range(CHAR_UPPER_A, CHAR_UPPER_Z);
    return c;
}

fn class_of_alnum() -> CharClass: {
    var c = class_of_alpha();
    c.add_char_range(CHAR_ZERO, CHAR_NINE);
    return c;
}

fn class_of_upper() -> CharClass: {
    var c = CharClass();
    c.add_char_range(CHAR_UPPER_A, CHAR_UPPER_Z);
    return c;
}

fn class_of_lower() -> CharClass: {
    var c = CharClass();
    c.add_char_range(CHAR_LOWER_A, CHAR_LOWER_Z);
    return c;
}

fn class_of_xdigit() -> CharClass: {
    var c = class_of_digits();
    c.add_char_range(CHAR_LOWER_A, CHAR_LOWER_F);
    c.add_char_range(CHAR_UPPER_A, CHAR_UPPER_F);
    return c;
}

fn class_of_punct() -> CharClass: {
    var c = CharClass();
    c.add_range(33, 47);
    c.add_range(58, 64);
    c.add_range(91, 96);
    c.add_range(123, 126);
    return c;
}

fn class_of_print() -> CharClass: {
    var c = CharClass();
    c.add_range(32, 126);
    return c;
}

fn class_of_graph() -> CharClass: {
    var c = CharClass();
    c.add_range(33, 126);
    return c;
}

fn class_of_cntrl() -> CharClass: {
    var c = CharClass();
    c.add_range(0, 31);
    c.add_range(127, 127);
    return c;
}

fn class_of_any(dot_matches_newline: bool) -> CharClass: {
    var c = CharClass();
    if dot_matches_newline: {
        c.add_range(CODE_MIN, CODE_MAX);
        return c;
    }
    c.add_char(CHAR_NEWLINE);
    c.negate();
    return c;
}



fn class_of_shorthand(which: Shorthand) -> CharClass: {
    if which == Shorthand::ShortDigit: {
        return class_of_digits();
    }
    if which == Shorthand::ShortNotDigit: {
        var c = class_of_digits();
        c.negate();
        return c;
    }
    if which == Shorthand::ShortWord: {
        return class_of_word();
    }
    if which == Shorthand::ShortNotWord: {
        var c = class_of_word();
        c.negate();
        return c;
    }
    if which == Shorthand::ShortSpace: {
        return class_of_space();
    }
    if which == Shorthand::ShortNotSpace: {
        var c = class_of_space();
        c.negate();
        return c;
    }
    if which == Shorthand::ShortHorizontal: {
        return class_of_horizontal();
    }
    if which == Shorthand::ShortVertical: {
        return class_of_vertical();
    }
    return CharClass();
}



fn class_of_posix_name(name: &const shared string, found: &unique bool) -> CharClass: {
    found = true;
    if name.compare(POSIX_ALPHA) == 0: {
        return class_of_alpha();
    }
    if name.compare(POSIX_DIGIT) == 0: {
        return class_of_digits();
    }
    if name.compare(POSIX_ALNUM) == 0: {
        return class_of_alnum();
    }
    if name.compare(POSIX_UPPER) == 0: {
        return class_of_upper();
    }
    if name.compare(POSIX_LOWER) == 0: {
        return class_of_lower();
    }
    if name.compare(POSIX_SPACE) == 0: {
        return class_of_space();
    }
    if name.compare(POSIX_BLANK) == 0: {
        return class_of_horizontal();
    }
    if name.compare(POSIX_PUNCT) == 0: {
        return class_of_punct();
    }
    if name.compare(POSIX_PRINT) == 0: {
        return class_of_print();
    }
    if name.compare(POSIX_GRAPH) == 0: {
        return class_of_graph();
    }
    if name.compare(POSIX_CNTRL) == 0: {
        return class_of_cntrl();
    }
    if name.compare(POSIX_XDIGIT) == 0: {
        return class_of_xdigit();
    }
    if name.compare(POSIX_WORD) == 0: {
        return class_of_word();
    }
    found = false;
    return CharClass();
}








enum NodeKind: {
    NodeEmpty;          
    NodeLiteral;        
    NodeString;         
    NodeAny;            
    NodeClass;          
    NodeConcat;         
    NodeAlternate;      
    NodeRepeat;         
    NodeGroup;          
    NodeAnchor;         
    NodeBackreference;  
    NodeInvalid = 11;
}

enum AnchorKind: {
    AnchorLineStart;
    AnchorLineEnd;
    AnchorTextStart;
    AnchorTextEnd;
    AnchorWordBoundary;
    AnchorNotWordBoundary = 5;
}


enum Greediness: {
    Greedy;
    Lazy;
    Possessive = 2;
}

struct Node: {

    fn is_leaf(self: &const shared) -> bool: {
        if .kind == NodeKind::NodeLiteral: {
            return true;
        }
        if .kind == NodeKind::NodeString: {
            return true;
        }
        if .kind == NodeKind::NodeAny: {
            return true;
        }
        if .kind == NodeKind::NodeClass: {
            return true;
        }
        if .kind == NodeKind::NodeAnchor: {
            return true;
        }
        if .kind == NodeKind::NodeBackreference: {
            return true;
        }
        if .kind == NodeKind::NodeEmpty: {
            return true;
        }
        return false;
    }

    fn has_children(self: &const shared) -> bool: {
        if !.children.empty(): {
            return true;
        }
        return .first != NONE;
    }

    fn child_count(self: &const shared) -> int: {
        if .first != NONE: {
            return 1;
        }
        return .children.size();
    }

    
    
    fn is_zero_width(self: &const shared) -> bool: {
        if .kind == NodeKind::NodeAnchor: {
            return true;
        }
        if .kind == NodeKind::NodeEmpty: {
            return true;
        }
        return false;
    }

    fn is_unbounded(self: &const shared) -> bool: {
        return .upper == NONE;
    }

    fn is_optional(self: &const shared) -> bool: {
        return .lower == 0;
    }

    kind: NodeKind = NodeKind::NodeInvalid;
    value: char = '\0';
    text: string;
    charclass: CharClass;
    anchor: AnchorKind = AnchorKind::AnchorLineStart;
    greed: Greediness = Greediness::Greedy;
    group_kind: GroupKind = GroupKind::Capturing;
    group_index: int = -1;
    reference: int = -1;
    lower: int = 0;
    upper: int = -1;
    first: int = -1;
    children: vector{int};
    position: int = 0;
}

























struct GroupName: {
    name: string;
    index: int = 0;
}

struct PatternParser: {

    

    fn token_count(self: &const shared) -> int: {
        return .tokens.size();
    }

    fn at_end(self: &const shared) -> bool: {
        if .index >= .tokens.size(): {
            return true;
        }
        let t: &const shared = .tokens[.index];
        return t.is_end();
    }

    fn current(self: &shared) -> &shared[self] Token: {
        return .tokens[.index];
    }

    fn current_kind(self: &const shared) -> TokenKind: {
        if .index >= .tokens.size(): {
            return TokenKind::EndOfPattern;
        }
        let t: &const shared = .tokens[.index];
        return t.kind;
    }

    fn peek_kind(self: &const shared, offset: int) -> TokenKind: {
        let at = .index + offset;
        if at >= .tokens.size(): {
            return TokenKind::EndOfPattern;
        }
        let t: &const shared = .tokens[at];
        return t.kind;
    }

    fn current_offset(self: &const shared) -> int: {
        if .index >= .tokens.size(): {
            return .source.size();
        }
        let t: &const shared = .tokens[.index];
        return t.position;
    }

    fn step(self: &unique): {
        if .index < .tokens.size(): {
            .index += 1;
        }
    }

    fn accept_kind(self: &unique, kind: TokenKind) -> bool: {
        if .current_kind() != kind: {
            return false;
        }
        .step();
        return true;
    }

    
    
    
    fn sync_to_offset(self: &unique, offset: int): {
        while .index < .tokens.size(): {
            let t: &const shared = .tokens[.index];
            if t.position >= offset: {
                break;
            }
            if t.is_end(): {
                break;
            }
            .index += 1;
        }
    }

    fn fail(self: &unique, message: &const shared string) -> int: {
        if .ok: {
            .ok = false;
            .error = message;
            .error_position = .current_offset();
        }
        return NONE;
    }

    

    fn node_count(self: &const shared) -> int: {
        return .nodes.size();
    }

    fn node_at(self: &shared, index: int) -> &shared[self] Node: {
        return .nodes[index];
    }

    fn new_node(self: &unique, kind: NodeKind) -> int: {
        let index = .nodes.size();
        var n = Node(kind: kind);
        n.position = .current_offset();
        .nodes.push_back(n);
        return index;
    }

    fn new_literal(self: &unique, c: char) -> int: {
        let index = .new_node(NodeKind::NodeLiteral);
        let n: &unique = .nodes[index];
        n.value = c;
        n.charclass.add_char(c);
        return index;
    }

    fn new_class(self: &unique, cls: CharClass) -> int: {
        let index = .new_node(NodeKind::NodeClass);
        let n: &unique = .nodes[index];
        n.charclass = cls;
        n.charclass.normalise();
        return index;
    }

    fn new_anchor(self: &unique, which: AnchorKind) -> int: {
        let index = .new_node(NodeKind::NodeAnchor);
        let n: &unique = .nodes[index];
        n.anchor = which;
        return index;
    }

    

    fn find_group_named(self: &const shared, name: &const shared string) -> int: {
        for entry: &const in .names: {
            if entry.name.compare(name) == 0: {
                return entry.index;
            }
        }
        return NONE;
    }

    fn register_group_name(self: &unique, name: &const shared string, index: int): {
        var entry = GroupName(index: index);
        entry.name = name;
        .names.push_back(entry);
    }

    

    fn parse(self: &unique, pattern: &const shared string) -> int: {
        .source = pattern;
        .nodes.clear();
        .names.clear();
        .index = 0;
        .depth = 0;
        .group_count = 0;
        .ok = true;
        .error = ERROR_NONE;

        var lexer = PatternLexer();
        lexer.source = pattern;
        if !lexer.tokenize(): {
            .ok = false;
            .error = lexer.error;
            .error_position = lexer.error_position;
            return NONE;
        }
        .tokens = move(lexer.tokens);

        let root = .parse_alternation();
        if !.ok: {
            return NONE;
        }
        if !.at_end(): {
            
            
            return .fail(ERROR_UNBALANCED_PAREN);
        }
        .root = root;
        return root;
    }

    

    fn parse_alternation(self: &unique) -> int: {
        let first = .parse_concatenation();
        if !.ok: {
            return NONE;
        }
        if .current_kind() != TokenKind::AlternationBar: {
            return first;
        }
        let index = .new_node(NodeKind::NodeAlternate);
        var branches = vector{int}();
        branches.push_back(first);
        while .accept_kind(TokenKind::AlternationBar): {
            let branch = .parse_concatenation();
            if !.ok: {
                return NONE;
            }
            branches.push_back(branch);
        }
        let n: &unique = .nodes[index];
        n.children = move(branches);
        return index;
    }

    
    
    
    
    

    fn parse_concatenation(self: &unique) -> int: {
        var items = vector{int}();
        loop: {
            if .at_end(): {
                break;
            }
            if .current_kind() == TokenKind::AlternationBar: {
                break;
            }
            if .current_kind() == TokenKind::GroupClose: {
                break;
            }
            let item = .parse_quantified();
            if !.ok: {
                return NONE;
            }
            if item == NONE: {
                break;
            }
            items.push_back(item);
        }
        if items.empty(): {
            return .new_node(NodeKind::NodeEmpty);
        }
        if items.size() == 1: {
            return items[0];
        }
        let index = .new_node(NodeKind::NodeConcat);
        let n: &unique = .nodes[index];
        n.children = move(items);
        return index;
    }

    
    
    
    

    fn parse_quantified(self: &unique) -> int: {
        var atom = .parse_atom();
        if !.ok: {
            return NONE;
        }
        if atom == NONE: {
            return NONE;
        }
        loop: {
            let t: &const shared = .tokens[.index];
            if !t.is_quantifier(): {
                break;
            }
            let inner: &const shared = .nodes[atom];
            if inner.kind == NodeKind::NodeAnchor: {
                
                return .fail(ERROR_NOTHING_TO_REPEAT);
            }
            atom = .parse_quantifier(atom);
            if !.ok: {
                return NONE;
            }
        }
        return atom;
    }

    
    
    
    
    fn parse_quantifier(self: &unique, target: int) -> int: {
        let kind = .current_kind();
        var lower: int = 0;
        var upper: int = NONE;
        if kind == TokenKind::Star: {
            lower = 0;
            upper = NONE;
        } else: {
            if kind == TokenKind::Plus: {
                lower = 1;
                upper = NONE;
            } else: {
                if kind == TokenKind::Question: {
                    lower = 0;
                    upper = 1;
                } else: {
                    let t: &const shared = .tokens[.index];
                    lower = t.lower;
                    upper = t.upper;
                    if upper != NONE && upper < lower: {
                        return .fail(ERROR_BAD_REPEAT);
                    }
                    if lower > MAX_REPEAT: {
                        return .fail(ERROR_REPEAT_TOO_LARGE);
                    }
                }
            }
        }
        .step();
        var greed = Greediness::Greedy;
        if .current_kind() == TokenKind::Question: {
            greed = Greediness::Lazy;
            .step();
        } else: {
            if .current_kind() == TokenKind::Plus: {
                greed = Greediness::Possessive;
                .step();
            }
        }
        let index = .new_node(NodeKind::NodeRepeat);
        let n: &unique = .nodes[index];
        n.first = target;
        n.lower = lower;
        n.upper = upper;
        n.greed = greed;
        return index;
    }

    
    
    
    
    

    fn parse_atom(self: &unique) -> int: {
        if .at_end(): {
            return NONE;
        }
        let kind = .current_kind();
        if kind == TokenKind::Literal: {
            let t: &const shared = .tokens[.index];
            let c = t.value;
            .step();
            return .new_literal(c);
        }
        if kind == TokenKind::AnyChar: {
            .step();
            let index = .new_node(NodeKind::NodeAny);
            let n: &unique = .nodes[index];
            n.charclass = class_of_any(.dot_matches_newline);
            return index;
        }
        if kind == TokenKind::ShorthandClass: {
            let t: &const shared = .tokens[.index];
            let which = t.shorthand;
            .step();
            return .new_class(class_of_shorthand(which));
        }
        if kind == TokenKind::ClassOpen: {
            return .parse_class();
        }
        if kind == TokenKind::GroupOpen: {
            return .parse_group();
        }
        if kind == TokenKind::Backreference: {
            return .parse_backreference();
        }
        if kind == TokenKind::CaretAnchor: {
            .step();
            return .new_anchor(AnchorKind::AnchorLineStart);
        }
        if kind == TokenKind::DollarAnchor: {
            .step();
            return .new_anchor(AnchorKind::AnchorLineEnd);
        }
        if kind == TokenKind::TextStartAnchor: {
            .step();
            return .new_anchor(AnchorKind::AnchorTextStart);
        }
        if kind == TokenKind::TextEndAnchor: {
            .step();
            return .new_anchor(AnchorKind::AnchorTextEnd);
        }
        if kind == TokenKind::WordBoundary: {
            .step();
            return .new_anchor(AnchorKind::AnchorWordBoundary);
        }
        if kind == TokenKind::NotWordBoundary: {
            .step();
            return .new_anchor(AnchorKind::AnchorNotWordBoundary);
        }
        if kind == TokenKind::Star: {
            return .fail(ERROR_NOTHING_TO_REPEAT);
        }
        if kind == TokenKind::Plus: {
            return .fail(ERROR_NOTHING_TO_REPEAT);
        }
        if kind == TokenKind::RepeatOpen: {
            return .fail(ERROR_NOTHING_TO_REPEAT);
        }
        if kind == TokenKind::Invalid: {
            return .fail(ERROR_BAD_ESCAPE);
        }
        return NONE;
    }

    
    
    
    
    

    fn parse_group(self: &unique) -> int: {
        let t: &const shared = .tokens[.index];
        let group_kind = t.group_kind;
        var name = t.text;
        .step();
        .depth += 1;
        if .depth > MAX_GROUP_DEPTH: {
            .depth -= 1;
            return .fail(ERROR_DEPTH_EXCEEDED);
        }
        var number = NONE;
        if group_kind == GroupKind::Capturing: {
            .group_count += 1;
            number = .group_count;
        }
        if group_kind == GroupKind::Named: {
            .group_count += 1;
            number = .group_count;
            .register_group_name(name, number);
        }
        let body = .parse_alternation();
        if !.ok: {
            .depth -= 1;
            return NONE;
        }
        if !.accept_kind(TokenKind::GroupClose): {
            .depth -= 1;
            return .fail(ERROR_UNBALANCED_PAREN);
        }
        .depth -= 1;
        let index = .new_node(NodeKind::NodeGroup);
        let n: &unique = .nodes[index];
        n.first = body;
        n.group_kind = group_kind;
        n.group_index = number;
        n.text = name;
        return index;
    }

    

    fn parse_backreference(self: &unique) -> int: {
        let t: &const shared = .tokens[.index];
        var target = t.lower;
        if target == NONE: {
            target = .find_group_named(t.text);
            if target == NONE: {
                return .fail(ERROR_BAD_BACKREF);
            }
        }
        if target > .group_count: {
            
            
            
            return .fail(ERROR_BAD_BACKREF);
        }
        .step();
        let index = .new_node(NodeKind::NodeBackreference);
        let n: &unique = .nodes[index];
        n.reference = target;
        return index;
    }

    
    
    
    
    
    
    
    
    
    
    
    
    

    fn parse_class(self: &unique) -> int: {
        let open = .current_offset();
        var at = open + 1;
        var cls = CharClass();
        if at < .source.size(): {
            if .source.at(at) == CHAR_CARET: {
                cls.negate();
                at += 1;
            }
        }
        var first = true;
        var closed = false;
        loop: {
            if at >= .source.size(): {
                break;
            }
            let c = .source.at(at);
            if c == CHAR_RBRACKET && !first: {
                at += 1;
                closed = true;
                break;
            }
            first = false;
            if c == CHAR_RBRACKET: {
                
                cls.add_char(c);
                at += 1;
                continue;
            }
            if c == CHAR_LBRACKET && .looks_like_posix(at): {
                at = .parse_posix_class(at, cls);
                if !.ok: {
                    return NONE;
                }
                continue;
            }
            if c == CHAR_BACKSLASH: {
                at = .parse_class_escape(at, cls);
                if !.ok: {
                    return NONE;
                }
                continue;
            }
            
            
            let low = c;
            at += 1;
            if !.class_range_follows(at): {
                cls.add_char(low);
                continue;
            }
            
            at += 1;
            let high_char = .source.at(at);
            if high_char == CHAR_BACKSLASH: {
                var scratch = CharClass();
                let after = .parse_class_escape(at, scratch);
                if !.ok: {
                    return NONE;
                }
                if !scratch.is_single_char(): {
                    
                    
                    cls.add_char(low);
                    cls.add_char(CHAR_MINUS);
                    cls.add_class(scratch);
                    at = after;
                    continue;
                }
                let high = scratch.single_char();
                if char_code(high) < char_code(low): {
                    return .fail(ERROR_BAD_RANGE);
                }
                cls.add_char_range(low, high);
                at = after;
                continue;
            }
            if char_code(high_char) < char_code(low): {
                return .fail(ERROR_BAD_RANGE);
            }
            cls.add_char_range(low, high_char);
            at += 1;
        }
        if !closed: {
            return .fail(ERROR_UNCLOSED_CLASS);
        }
        .sync_to_offset(at);
        cls.normalise();
        return .new_class(cls);
    }

    
    
    fn class_range_follows(self: &const shared, at: int) -> bool: {
        if at >= .source.size(): {
            return false;
        }
        if .source.at(at) != CHAR_MINUS: {
            return false;
        }
        let next = at + 1;
        if next >= .source.size(): {
            return false;
        }
        if .source.at(next) == CHAR_RBRACKET: {
            return false;
        }
        return true;
    }

    
    
    fn looks_like_posix(self: &const shared, at: int) -> bool: {
        let colon = at + 1;
        if colon >= .source.size(): {
            return false;
        }
        if .source.at(colon) != CHAR_COLON: {
            return false;
        }
        var scan = colon + 1;
        if scan < .source.size(): {
            if .source.at(scan) == CHAR_CARET: {
                scan += 1;
            }
        }
        while scan < .source.size(): {
            let c = .source.at(scan);
            if c == CHAR_COLON: {
                let close = scan + 1;
                if close >= .source.size(): {
                    return false;
                }
                return .source.at(close) == CHAR_RBRACKET;
            }
            if !is_alpha(c): {
                return false;
            }
            scan += 1;
        }
        return false;
    }

    
    
    
    
    fn parse_posix_class(self: &unique, at: int, into: &unique CharClass) -> int: {
        var scan = at + 2;
        var complement = false;
        if scan < .source.size(): {
            if .source.at(scan) == CHAR_CARET: {
                complement = true;
                scan += 1;
            }
        }
        var name = TEXT_EMPTY;
        while scan < .source.size(): {
            let c = .source.at(scan);
            if c == CHAR_COLON: {
                break;
            }
            name.push_back(c);
            scan += 1;
        }
        
        scan += 2;
        var known = false;
        var expanded = class_of_posix_name(name, known);
        if !known: {
            discard .fail(ERROR_UNKNOWN_CLASS);
            return scan;
        }
        if complement: {
            expanded.normalise();
            var inverted = complement_of(expanded);
            into.add_class(inverted);
            return scan;
        }
        into.add_class(expanded);
        return scan;
    }

    
    
    
    fn parse_class_escape(self: &unique, at: int, into: &unique CharClass) -> int: {
        let marker_at = at + 1;
        if marker_at >= .source.size(): {
            discard .fail(ERROR_TRAILING_BACKSLASH);
            return .source.size();
        }
        let marker = .source.at(marker_at);
        if marker == CHAR_LOWER_D: {
            into.add_class(class_of_digits());
            return marker_at + 1;
        }
        if marker == CHAR_UPPER_D: {
            into.add_class(complement_of(class_of_digits()));
            return marker_at + 1;
        }
        if marker == CHAR_LOWER_W: {
            into.add_class(class_of_word());
            return marker_at + 1;
        }
        if marker == CHAR_UPPER_W: {
            into.add_class(complement_of(class_of_word()));
            return marker_at + 1;
        }
        if marker == CHAR_LOWER_S: {
            into.add_class(class_of_space());
            return marker_at + 1;
        }
        if marker == CHAR_UPPER_S: {
            into.add_class(complement_of(class_of_space()));
            return marker_at + 1;
        }
        if marker == CHAR_LOWER_H: {
            into.add_class(class_of_horizontal());
            return marker_at + 1;
        }
        if marker == CHAR_LOWER_V: {
            into.add_class(class_of_vertical());
            return marker_at + 1;
        }
        if marker == CHAR_LOWER_X: {
            let high_at = marker_at + 1;
            let low_at = marker_at + 2;
            if low_at >= .source.size(): {
                discard .fail(ERROR_BAD_ESCAPE);
                return .source.size();
            }
            let high = .source.at(high_at);
            let low = .source.at(low_at);
            if !is_hex_digit(high) || !is_hex_digit(low): {
                discard .fail(ERROR_BAD_ESCAPE);
                return low_at + 1;
            }
            into.add_range(hex_value(high) * 16 + hex_value(low), hex_value(high) * 16 + hex_value(low));
            return low_at + 1;
        }
        if marker == CHAR_LOWER_B: {
            
            into.add_char(CHAR_BACKSPACE);
            return marker_at + 1;
        }
        into.add_char(decode_escape(marker));
        return marker_at + 1;
    }

    source: string;
    tokens: vector{Token};
    nodes: vector{Node};
    names: vector{GroupName};
    index: int = 0;
    depth: int = 0;
    group_count: int = 0;
    root: int = -1;
    error: string;
    error_position: int = 0;
    ok: bool = true;
    dot_matches_newline: bool = false;
    ignore_case: bool = false;
}




fn complement_of(cls: &const shared CharClass) -> CharClass: {
    var source = cls;
    source.normalise();
    var out = CharClass();
    var cursor = CODE_MIN;
    for r: &const in source.ranges: {
        if r.low > cursor: {
            out.add_range(cursor, r.low - 1);
        }
        if r.high + 1 > cursor: {
            cursor = r.high + 1;
        }
    }
    if cursor <= CODE_MAX: {
        out.add_range(cursor, CODE_MAX);
    }
    out.normalise();
    return out;
}














enum StateKind: {
    StateChar;          
    StateSplit;         
    StateJump;          
    StateSave;          
    StateAssert;        
    StateBackref;       
    StateMatch = 6;     
}

struct NfaState: {

    fn consumes(self: &const shared) -> bool: {
        return .kind == StateKind::StateChar;
    }

    fn is_epsilon(self: &const shared) -> bool: {
        if .kind == StateKind::StateSplit: {
            return true;
        }
        if .kind == StateKind::StateJump: {
            return true;
        }
        if .kind == StateKind::StateSave: {
            return true;
        }
        if .kind == StateKind::StateAssert: {
            return true;
        }
        return false;
    }

    fn is_accepting(self: &const shared) -> bool: {
        return .kind == StateKind::StateMatch;
    }

    fn accepts(self: &const shared, c: char, folded: bool) -> bool: {
        if .kind != StateKind::StateChar: {
            return false;
        }
        if folded: {
            return .charclass.matches_folded(c);
        }
        return .charclass.matches(c);
    }

    kind: StateKind = StateKind::StateJump;
    charclass: CharClass;
    anchor: AnchorKind = AnchorKind::AnchorLineStart;
    slot: int = 0;
    reference: int = 0;
    out: int = -1;
    alternate: int = -1;
}


struct Patch: {
    state: int = 0;
    second: bool = false;
}


struct Fragment: {

    fn valid(self: &const shared) -> bool: {
        return .start != NONE;
    }

    fn exit_count(self: &const shared) -> int: {
        return .exits.size();
    }

    fn absorb(self: &unique, other: &const shared Fragment): {
        for p: &const in other.exits: {
            .exits.push_back(p);
        }
    }

    start: int = -1;
    exits: vector{Patch};
}

struct NfaBuilder: {

    fn state_count(self: &const shared) -> int: {
        return .states.size();
    }

    fn new_state(self: &unique, kind: StateKind) -> int: {
        let index = .states.size();
        .states.push_back(NfaState(kind: kind));
        return index;
    }

    
    fn patch(self: &unique, frag: &const shared Fragment, target: int): {
        for p: &const in frag.exits: {
            let s: &unique = .states[p.state];
            if p.second: {
                s.alternate = target;
            } else: {
                s.out = target;
            }
        }
    }

    fn single_exit(self: &const shared, state: int, second: bool) -> Fragment: {
        var frag = Fragment(start: state);
        frag.exits.push_back(Patch(state: state, second: second));
        return frag;
    }

    

    fn build(self: &unique, parser: &shared PatternParser, root: int) -> bool: {
        .states.clear();
        .has_backreference = false;
        .ok = true;
        let frag = .build_node(parser, root);
        if !.ok: {
            return false;
        }
        let accept = .new_state(StateKind::StateMatch);
        .patch(frag, accept);
        .start = frag.start;
        .accept = accept;
        return true;
    }

    

    fn build_node(self: &unique, parser: &shared PatternParser, index: int) -> Fragment: {
        if index == NONE: {
            return .build_empty();
        }
        let n: &const shared = parser.nodes[index];
        if n.kind == NodeKind::NodeEmpty: {
            return .build_empty();
        }
        if n.kind == NodeKind::NodeLiteral: {
            return .build_class(n.charclass);
        }
        if n.kind == NodeKind::NodeAny: {
            return .build_class(n.charclass);
        }
        if n.kind == NodeKind::NodeClass: {
            return .build_class(n.charclass);
        }
        if n.kind == NodeKind::NodeString: {
            return .build_string(n.text);
        }
        if n.kind == NodeKind::NodeAnchor: {
            return .build_anchor(n.anchor);
        }
        if n.kind == NodeKind::NodeBackreference: {
            return .build_backreference(n.reference);
        }
        if n.kind == NodeKind::NodeConcat: {
            return .build_concat(parser, index);
        }
        if n.kind == NodeKind::NodeAlternate: {
            return .build_alternate(parser, index);
        }
        if n.kind == NodeKind::NodeRepeat: {
            return .build_repeat(parser, index);
        }
        if n.kind == NodeKind::NodeGroup: {
            return .build_group(parser, index);
        }
        .ok = false;
        return Fragment();
    }

    fn build_empty(self: &unique) -> Fragment: {
        let s = .new_state(StateKind::StateJump);
        return .single_exit(s, false);
    }

    fn build_class(self: &unique, cls: &const shared CharClass) -> Fragment: {
        let s = .new_state(StateKind::StateChar);
        let state: &unique = .states[s];
        state.charclass = cls;
        state.charclass.normalise();
        return .single_exit(s, false);
    }

    
    
    fn build_string(self: &unique, text: &const shared string) -> Fragment: {
        if text.empty(): {
            return .build_empty();
        }
        var head = NONE;
        var previous = NONE;
        var i: int = 0;
        while i < text.size(): {
            let s = .new_state(StateKind::StateChar);
            let state: &unique = .states[s];
            state.charclass.add_char(text.at(i));
            if head == NONE: {
                head = s;
            } else: {
                let prior: &unique = .states[previous];
                prior.out = s;
            }
            previous = s;
            i += 1;
        }
        var frag = Fragment(start: head);
        frag.exits.push_back(Patch(state: previous, second: false));
        return frag;
    }

    fn build_anchor(self: &unique, which: AnchorKind) -> Fragment: {
        let s = .new_state(StateKind::StateAssert);
        let state: &unique = .states[s];
        state.anchor = which;
        return .single_exit(s, false);
    }

    fn build_backreference(self: &unique, group: int) -> Fragment: {
        .has_backreference = true;
        let s = .new_state(StateKind::StateBackref);
        let state: &unique = .states[s];
        state.reference = group;
        return .single_exit(s, false);
    }

    
    
    
    fn build_concat(self: &unique, parser: &shared PatternParser, index: int) -> Fragment: {
        let n: &const shared = parser.nodes[index];
        var result = Fragment();
        var started = false;
        for child: &const in n.children: {
            let piece = .build_node(parser, child);
            if !.ok: {
                return Fragment();
            }
            if !started: {
                result = piece;
                started = true;
            } else: {
                .patch(result, piece.start);
                result.exits.clear();
                result.absorb(piece);
            }
        }
        if !started: {
            return .build_empty();
        }
        return result;
    }

    
    
    
    fn build_alternate(self: &unique, parser: &shared PatternParser, index: int) -> Fragment: {
        let n: &const shared = parser.nodes[index];
        var result = Fragment();
        var previous_split = NONE;
        var count: int = 0;
        let total = n.children.size();
        for child: &const in n.children: {
            let piece = .build_node(parser, child);
            if !.ok: {
                return Fragment();
            }
            count += 1;
            if count == total: {
                if previous_split == NONE: {
                    return piece;
                }
                let split: &unique = .states[previous_split];
                split.alternate = piece.start;
                result.absorb(piece);
                return result;
            }
            let split = .new_state(StateKind::StateSplit);
            let s: &unique = .states[split];
            s.out = piece.start;
            if previous_split == NONE: {
                result.start = split;
            } else: {
                let prior: &unique = .states[previous_split];
                prior.alternate = split;
            }
            result.absorb(piece);
            previous_split = split;
        }
        return result;
    }

    fn build_group(self: &unique, parser: &shared PatternParser, index: int) -> Fragment: {
        let n: &const shared = parser.nodes[index];
        let group = n.group_index;
        if group == NONE: {
            return .build_node(parser, n.first);
        }
        let open = .new_state(StateKind::StateSave);
        let open_state: &unique = .states[open];
        open_state.slot = group * 2;
        let body = .build_node(parser, n.first);
        if !.ok: {
            return Fragment();
        }
        open_state.out = body.start;
        let close = .new_state(StateKind::StateSave);
        let close_state: &unique = .states[close];
        close_state.slot = group * 2 + 1;
        .patch(body, close);
        return .single_exit_from(open, close);
    }

    
    fn single_exit_from(self: &const shared, start: int, exit: int) -> Fragment: {
        var frag = Fragment(start: start);
        frag.exits.push_back(Patch(state: exit, second: false));
        return frag;
    }

    
    
    
    
    
    
    

    fn build_repeat(self: &unique, parser: &shared PatternParser, index: int) -> Fragment: {
        let n: &const shared = parser.nodes[index];
        let lower = n.lower;
        let upper = n.upper;
        let body = n.first;
        let lazy = n.greed == Greediness::Lazy;
        if lower == 0 && upper == NONE: {
            return .build_star(parser, body, lazy);
        }
        if lower == 1 && upper == NONE: {
            return .build_plus(parser, body, lazy);
        }
        if lower == 0 && upper == 1: {
            return .build_optional(parser, body, lazy);
        }
        var result = Fragment();
        var started = false;
        var i: int = 0;
        while i < lower: {
            let piece = .build_node(parser, body);
            if !.ok: {
                return Fragment();
            }
            if !started: {
                result = piece;
                started = true;
            } else: {
                .patch(result, piece.start);
                result.exits.clear();
                result.absorb(piece);
            }
            i += 1;
        }
        if upper == NONE: {
            let tail = .build_star(parser, body, lazy);
            if !started: {
                return tail;
            }
            .patch(result, tail.start);
            result.exits.clear();
            result.absorb(tail);
            return result;
        }
        var extra = upper - lower;
        while extra > 0: {
            let piece = .build_optional(parser, body, lazy);
            if !.ok: {
                return Fragment();
            }
            if !started: {
                result = piece;
                started = true;
            } else: {
                .patch(result, piece.start);
                result.exits.clear();
                result.absorb(piece);
            }
            extra -= 1;
        }
        if !started: {
            return .build_empty();
        }
        return result;
    }

    
    
    fn build_star(self: &unique, parser: &shared PatternParser, body: int, lazy: bool) -> Fragment: {
        let split = .new_state(StateKind::StateSplit);
        let piece = .build_node(parser, body);
        if !.ok: {
            return Fragment();
        }
        .patch(piece, split);
        let s: &unique = .states[split];
        if lazy: {
            s.alternate = piece.start;
            return .single_exit(split, false);
        }
        s.out = piece.start;
        return .single_exit(split, true);
    }

    
    fn build_plus(self: &unique, parser: &shared PatternParser, body: int, lazy: bool) -> Fragment: {
        let piece = .build_node(parser, body);
        if !.ok: {
            return Fragment();
        }
        let split = .new_state(StateKind::StateSplit);
        .patch(piece, split);
        let s: &unique = .states[split];
        if lazy: {
            s.alternate = piece.start;
            return .single_exit_from(piece.start, split);
        }
        s.out = piece.start;
        var frag = Fragment(start: piece.start);
        frag.exits.push_back(Patch(state: split, second: true));
        return frag;
    }

    
    fn build_optional(self: &unique, parser: &shared PatternParser, body: int, lazy: bool) -> Fragment: {
        let split = .new_state(StateKind::StateSplit);
        let piece = .build_node(parser, body);
        if !.ok: {
            return Fragment();
        }
        let s: &unique = .states[split];
        var frag = Fragment(start: split);
        if lazy: {
            s.alternate = piece.start;
            frag.exits.push_back(Patch(state: split, second: false));
        } else: {
            s.out = piece.start;
            frag.exits.push_back(Patch(state: split, second: true));
        }
        frag.absorb(piece);
        return frag;
    }

    states: vector{NfaState};
    start: int = -1;
    accept: int = -1;
    has_backreference: bool = false;
    ok: bool = true;
}














struct StateSet: {

    fn size(self: &const shared) -> int: {
        return .dense.size();
    }

    fn empty(self: &const shared) -> bool: {
        return .dense.empty();
    }

    fn prepare(self: &unique, capacity: int): {
        .stamp.resize(capacity);
        .generation = 1;
        var i: int = 0;
        while i < capacity: {
            .stamp[i] = 0;
            i += 1;
        }
        .dense.clear();
    }

    fn clear(self: &unique): {
        .generation += 1;
        .dense.clear();
    }

    fn contains(self: &const shared, state: int) -> bool: {
        if state < 0: {
            return false;
        }
        if state >= .stamp.size(): {
            return false;
        }
        return .stamp[state] == .generation;
    }

    
    
    fn insert(self: &unique, state: int) -> bool: {
        if .contains(state): {
            return false;
        }
        .stamp[state] = .generation;
        .dense.push_back(state);
        return true;
    }

    fn at(self: &const shared, i: int) -> int: {
        return .dense[i];
    }

    dense: vector{int};
    stamp: vector{int};
    generation: int = 1;
}


fn assertion_holds(which: AnchorKind, text: &const shared string, pos: int, multiline: bool) -> bool: {
    if which == AnchorKind::AnchorTextStart: {
        return pos == 0;
    }
    if which == AnchorKind::AnchorTextEnd: {
        return pos == text.size();
    }
    if which == AnchorKind::AnchorLineStart: {
        if pos == 0: {
            return true;
        }
        if !multiline: {
            return false;
        }
        return text.at(pos - 1) == CHAR_NEWLINE;
    }
    if which == AnchorKind::AnchorLineEnd: {
        if pos == text.size(): {
            return true;
        }
        if !multiline: {
            return false;
        }
        return text.at(pos) == CHAR_NEWLINE;
    }
    let before = word_char_before(text, pos);
    let after = word_char_at(text, pos);
    if which == AnchorKind::AnchorWordBoundary: {
        return before != after;
    }
    return before == after;
}

fn word_char_before(text: &const shared string, pos: int) -> bool: {
    if pos <= 0: {
        return false;
    }
    return is_word_char(text.at(pos - 1));
}

fn word_char_at(text: &const shared string, pos: int) -> bool: {
    if pos >= text.size(): {
        return false;
    }
    return is_word_char(text.at(pos));
}

struct NfaSimulator: {

    fn ready(self: &const shared) -> bool: {
        if .states.empty(): {
            return false;
        }
        return .start != NONE;
    }

    fn load(self: &unique, builder: &const shared NfaBuilder): {
        .states = builder.states;
        .start = builder.start;
        .accept = builder.accept;
        .current.prepare(.states.size());
        .next.prepare(.states.size());
    }

    
    
    
    fn add_state(self: &unique, set: &unique StateSet, state: int, pos: int): {
        if state == NONE: {
            return;
        }
        if !set.insert(state): {
            return;
        }
        let s: &const shared = .states[state];
        if s.kind == StateKind::StateSplit: {
            .add_state(set, s.out, pos);
            .add_state(set, s.alternate, pos);
            return;
        }
        if s.kind == StateKind::StateJump: {
            .add_state(set, s.out, pos);
            return;
        }
        if s.kind == StateKind::StateSave: {
            
            .add_state(set, s.out, pos);
            return;
        }
        if s.kind == StateKind::StateAssert: {
            if assertion_holds(s.anchor, .text, pos, .multiline): {
                .add_state(set, s.out, pos);
            }
            return;
        }
    }

    fn set_contains_accept(self: &const shared, set: &const shared StateSet) -> bool: {
        var i: int = 0;
        while i < set.size(): {
            let index = set.at(i);
            let s: &const shared = .states[index];
            if s.is_accepting(): {
                return true;
            }
            i += 1;
        }
        return false;
    }

    
    fn step(self: &unique, c: char, pos: int): {
        .next.clear();
        var i: int = 0;
        while i < .current.size(): {
            let index = .current.at(i);
            let s: &const shared = .states[index];
            if s.consumes(): {
                if s.accepts(c, .ignore_case): {
                    .add_state(.next, s.out, pos + 1);
                }
            }
            i += 1;
        }
        swap(.current, .next);
    }

    
    
    fn run_from(self: &unique, from: int) -> int: {
        .current.clear();
        .add_state(.current, .start, from);
        var best = NONE;
        if .set_contains_accept(.current): {
            best = from;
        }
        var pos = from;
        while pos < .text.size(): {
            if .current.empty(): {
                break;
            }
            .step(.text.at(pos), pos);
            pos += 1;
            if .set_contains_accept(.current): {
                best = pos;
            }
            .steps += 1;
        }
        return best;
    }

    
    
    
    fn search_from(self: &unique, from: int) -> bool: {
        var start = from;
        while start <= .text.size(): {
            let end = .run_from(start);
            if end != NONE: {
                .match_begin = start;
                .match_end = end;
                return true;
            }
            start += 1;
        }
        .match_begin = NONE;
        .match_end = NONE;
        return false;
    }

    fn matches_whole(self: &unique) -> bool: {
        let end = .run_from(0);
        if end == NONE: {
            return false;
        }
        return end == .text.size();
    }

    states: vector{NfaState};
    current: StateSet;
    next: StateSet;
    text: string;
    start: int = -1;
    accept: int = -1;
    match_begin: int = -1;
    match_end: int = -1;
    steps: int = 0;
    ignore_case: bool = false;
    multiline: bool = false;
}

















enum MatchStatus: {
    Matched;
    NoMatch;
    Exhausted = 2;
}

enum ContKind: {
    ContNode;           
    ContGroupEnd;       
    ContRepeat;         
    ContDone = 3;       
}

struct Capture: {

    fn valid(self: &const shared) -> bool: {
        if .begin < 0: {
            return false;
        }
        return .end >= .begin;
    }

    fn length(self: &const shared) -> int: {
        if !.valid(): {
            return 0;
        }
        return .end - .begin;
    }

    fn text_of(self: &const shared, subject: &const shared string) -> string: {
        if !.valid(): {
            return TEXT_EMPTY;
        }
        return subject.substr(.begin, .length());
    }

    begin: int = -1;
    end: int = -1;
}

struct ContFrame: {
    kind: ContKind = ContKind::ContDone;
    node: int = -1;
    next: int = -1;
    slot: int = -1;
    mark: int = 0;
    count: int = 0;
}

struct BacktrackMatcher: {

    

    fn load(self: &unique, parser: &const shared PatternParser): {
        .nodes = parser.nodes;
        .root = parser.root;
        .group_count = parser.group_count;
        .names = parser.names;
    }

    fn reset(self: &unique): {
        .frames.clear();
        .steps = 0;
        .status = MatchStatus::NoMatch;
        .captures.clear();
        var i: int = 0;
        while i <= .group_count: {
            .captures.push_back(Capture());
            i += 1;
        }
    }

    fn capture_count(self: &const shared) -> int: {
        return .captures.size();
    }

    fn capture_at(self: &shared, index: int) -> &shared[self] Capture: {
        return .captures[index];
    }

    fn group_named(self: &const shared, name: &const shared string) -> int: {
        for entry: &const in .names: {
            if entry.name.compare(name) == 0: {
                return entry.index;
            }
        }
        return NONE;
    }

    
    
    
    fn spend(self: &unique) -> bool: {
        .steps += 1;
        if .steps > .budget: {
            .status = MatchStatus::Exhausted;
            return false;
        }
        return true;
    }

    fn exhausted(self: &const shared) -> bool: {
        return .status == MatchStatus::Exhausted;
    }

    

    fn push_frame(self: &unique, frame: ContFrame) -> int: {
        let index = .frames.size();
        .frames.push_back(frame);
        return index;
    }

    fn push_node(self: &unique, node: int, next: int) -> int: {
        var f = ContFrame(kind: ContKind::ContNode, node: node, next: next);
        return .push_frame(f);
    }

    fn push_group_end(self: &unique, slot: int, mark: int, next: int) -> int: {
        var f = ContFrame(kind: ContKind::ContGroupEnd, next: next);
        f.slot = slot;
        f.mark = mark;
        return .push_frame(f);
    }

    fn push_repeat(self: &unique, node: int, count: int, mark: int, next: int) -> int: {
        var f = ContFrame(kind: ContKind::ContRepeat, node: node, next: next);
        f.count = count;
        f.mark = mark;
        return .push_frame(f);
    }

    
    
    

    fn run_continuation(self: &unique, cont: int, pos: int) -> int: {
        if !.spend(): {
            return NONE;
        }
        if cont == NONE: {
            
            return pos;
        }
        let kind = .frames[cont].kind;
        if kind == ContKind::ContDone: {
            return pos;
        }
        if kind == ContKind::ContNode: {
            let node = .frames[cont].node;
            let next = .frames[cont].next;
            return .match_node(node, pos, next);
        }
        if kind == ContKind::ContGroupEnd: {
            let slot = .frames[cont].slot;
            let mark = .frames[cont].mark;
            let next = .frames[cont].next;
            var saved_begin = NONE;
            var saved_end = NONE;
            if slot < .captures.size(): {
                let existing: &const shared = .captures[slot];
                saved_begin = existing.begin;
                saved_end = existing.end;
                let cap: &unique = .captures[slot];
                cap.begin = mark;
                cap.end = pos;
            }
            let result = .run_continuation(next, pos);
            if result == NONE: {
                
                
                if slot < .captures.size(): {
                    let cap: &unique = .captures[slot];
                    cap.begin = saved_begin;
                    cap.end = saved_end;
                }
            }
            return result;
        }
        let node = .frames[cont].node;
        let count = .frames[cont].count;
        let mark = .frames[cont].mark;
        let next = .frames[cont].next;
        if pos == mark: {
            
            
            let n: &const shared = .nodes[node];
            if count >= n.lower: {
                return .run_continuation(next, pos);
            }
            return NONE;
        }
        return .match_repeat(node, pos, count, next);
    }

    

    fn match_node(self: &unique, node: int, pos: int, cont: int) -> int: {
        if !.spend(): {
            return NONE;
        }
        if node == NONE: {
            return .run_continuation(cont, pos);
        }
        let kind = .nodes[node].kind;
        if kind == NodeKind::NodeEmpty: {
            return .run_continuation(cont, pos);
        }
        if kind == NodeKind::NodeLiteral: {
            return .match_literal(node, pos, cont);
        }
        if kind == NodeKind::NodeString: {
            return .match_string(node, pos, cont);
        }
        if kind == NodeKind::NodeAny: {
            return .match_class(node, pos, cont);
        }
        if kind == NodeKind::NodeClass: {
            return .match_class(node, pos, cont);
        }
        if kind == NodeKind::NodeAnchor: {
            return .match_anchor(node, pos, cont);
        }
        if kind == NodeKind::NodeBackreference: {
            return .match_backreference(node, pos, cont);
        }
        if kind == NodeKind::NodeConcat: {
            return .match_concat(node, pos, cont);
        }
        if kind == NodeKind::NodeAlternate: {
            return .match_alternate(node, pos, cont);
        }
        if kind == NodeKind::NodeGroup: {
            return .match_group(node, pos, cont);
        }
        if kind == NodeKind::NodeRepeat: {
            return .match_repeat(node, pos, 0, cont);
        }
        return NONE;
    }

    fn match_literal(self: &unique, node: int, pos: int, cont: int) -> int: {
        if pos >= .text.size(): {
            return NONE;
        }
        let expected = .nodes[node].value;
        let actual = .text.at(pos);
        if .ignore_case: {
            if !same_char_folded(expected, actual): {
                return NONE;
            }
        } else: {
            if expected != actual: {
                return NONE;
            }
        }
        return .run_continuation(cont, pos + 1);
    }

    
    
    
    fn match_string(self: &unique, node: int, pos: int, cont: int) -> int: {
        let text: &const shared = .nodes[node].text;
        if pos + text.size() > .text.size(): {
            return NONE;
        }
        var i: int = 0;
        while i < text.size(): {
            let expected = text.at(i);
            let actual = .text.at(pos + i);
            if .ignore_case: {
                if !same_char_folded(expected, actual): {
                    return NONE;
                }
            } else: {
                if expected != actual: {
                    return NONE;
                }
            }
            i += 1;
        }
        return .run_continuation(cont, pos + text.size());
    }

    fn match_class(self: &unique, node: int, pos: int, cont: int) -> int: {
        if pos >= .text.size(): {
            return NONE;
        }
        let c = .text.at(pos);
        let cls: &const shared = .nodes[node].charclass;
        var hit = false;
        if .ignore_case: {
            hit = cls.matches_folded(c);
        } else: {
            hit = cls.matches(c);
        }
        if !hit: {
            return NONE;
        }
        return .run_continuation(cont, pos + 1);
    }

    fn match_anchor(self: &unique, node: int, pos: int, cont: int) -> int: {
        let which = .nodes[node].anchor;
        if !assertion_holds(which, .text, pos, .multiline): {
            return NONE;
        }
        return .run_continuation(cont, pos);
    }

    
    
    fn match_backreference(self: &unique, node: int, pos: int, cont: int) -> int: {
        let group = .nodes[node].reference;
        if group >= .captures.size(): {
            return NONE;
        }
        let cap: &const shared = .captures[group];
        if !cap.valid(): {
            return .run_continuation(cont, pos);
        }
        let length = cap.length();
        if pos + length > .text.size(): {
            return NONE;
        }
        var i: int = 0;
        while i < length: {
            let expected = .text.at(cap.begin + i);
            let actual = .text.at(pos + i);
            if .ignore_case: {
                if !same_char_folded(expected, actual): {
                    return NONE;
                }
            } else: {
                if expected != actual: {
                    return NONE;
                }
            }
            i += 1;
        }
        return .run_continuation(cont, pos + length);
    }

    
    
    fn match_concat(self: &unique, node: int, pos: int, cont: int) -> int: {
        let count = .nodes[node].children.size();
        if count == 0: {
            return .run_continuation(cont, pos);
        }
        var chain = cont;
        var i = count - 1;
        while i >= 0: {
            let child = .nodes[node].children[i];
            chain = .push_node(child, chain);
            i -= 1;
        }
        return .run_continuation(chain, pos);
    }

    
    
    fn match_alternate(self: &unique, node: int, pos: int, cont: int) -> int: {
        let count = .nodes[node].children.size();
        var i: int = 0;
        while i < count: {
            let child = .nodes[node].children[i];
            let result = .match_node(child, pos, cont);
            if result != NONE: {
                return result;
            }
            if .exhausted(): {
                return NONE;
            }
            i += 1;
        }
        return NONE;
    }

    fn match_group(self: &unique, node: int, pos: int, cont: int) -> int: {
        let body = .nodes[node].first;
        let group = .nodes[node].group_index;
        if group == NONE: {
            return .match_node(body, pos, cont);
        }
        let closing = .push_group_end(group, pos, cont);
        return .match_node(body, pos, closing);
    }

    
    
    
    
    
    

    fn match_repeat(self: &unique, node: int, pos: int, count: int, cont: int) -> int: {
        if !.spend(): {
            return NONE;
        }
        let lower = .nodes[node].lower;
        let upper = .nodes[node].upper;
        let body = .nodes[node].first;
        let greed = .nodes[node].greed;
        var may_continue = count >= lower;
        var may_repeat = true;
        if upper != NONE: {
            if count >= upper: {
                may_repeat = false;
            }
        }
        if greed == Greediness::Possessive: {
            return .match_possessive(node, pos, count, cont);
        }
        if greed == Greediness::Lazy: {
            if may_continue: {
                let stop = .run_continuation(cont, pos);
                if stop != NONE: {
                    return stop;
                }
                if .exhausted(): {
                    return NONE;
                }
            }
            if !may_repeat: {
                return NONE;
            }
            let resume = .push_repeat(node, count + 1, pos, cont);
            return .match_node(body, pos, resume);
        }
        if may_repeat: {
            let resume = .push_repeat(node, count + 1, pos, cont);
            let more = .match_node(body, pos, resume);
            if more != NONE: {
                return more;
            }
            if .exhausted(): {
                return NONE;
            }
        }
        if may_continue: {
            return .run_continuation(cont, pos);
        }
        return NONE;
    }

    
    
    
    fn match_possessive(self: &unique, node: int, pos: int, count: int, cont: int) -> int: {
        let lower = .nodes[node].lower;
        let upper = .nodes[node].upper;
        let body = .nodes[node].first;
        var taken = count;
        var cursor = pos;
        loop: {
            if upper != NONE: {
                if taken >= upper: {
                    break;
                }
            }
            let advanced = .match_node(body, cursor, NONE);
            if advanced == NONE: {
                break;
            }
            if advanced == cursor: {
                
                break;
            }
            cursor = advanced;
            taken += 1;
            if .exhausted(): {
                return NONE;
            }
        }
        if taken < lower: {
            return NONE;
        }
        return .run_continuation(cont, cursor);
    }

    

    fn match_at(self: &unique, start: int) -> bool: {
        .reset();
        let end = .match_node(.root, start, NONE);
        if end == NONE: {
            if !.exhausted(): {
                .status = MatchStatus::NoMatch;
            }
            return false;
        }
        .status = MatchStatus::Matched;
        let whole: &unique = .captures[0];
        whole.begin = start;
        whole.end = end;
        return true;
    }

    fn search_from(self: &unique, from: int) -> bool: {
        var start = from;
        while start <= .text.size(): {
            if .match_at(start): {
                return true;
            }
            if .exhausted(): {
                return false;
            }
            start += 1;
        }
        return false;
    }

    fn match_whole(self: &unique) -> bool: {
        if !.match_at(0): {
            return false;
        }
        let whole: &const shared = .captures[0];
        return whole.end == .text.size();
    }

    nodes: vector{Node};
    names: vector{GroupName};
    frames: vector{ContFrame};
    captures: vector{Capture};
    text: string;
    root: int = -1;
    group_count: int = 0;
    steps: int = 0;
    budget: int = 1000000;
    status: MatchStatus = MatchStatus::NoMatch;
    ignore_case: bool = false;
    multiline: bool = false;
}












enum OpCode: {
    OpChar;             
    OpString;           
    OpClass;            
    OpAny;              
    OpSplit;            
    OpJump;             
    OpSave;             
    OpAssert;           
    OpBackref;          
    OpMatch;            
    OpFail = 10;        
}

struct Instruction: {

    fn consumes_input(self: &const shared) -> bool: {
        if .op == OpCode::OpChar: {
            return true;
        }
        if .op == OpCode::OpString: {
            return true;
        }
        if .op == OpCode::OpClass: {
            return true;
        }
        if .op == OpCode::OpAny: {
            return true;
        }
        return false;
    }

    fn is_branch(self: &const shared) -> bool: {
        if .op == OpCode::OpSplit: {
            return true;
        }
        if .op == OpCode::OpJump: {
            return true;
        }
        return false;
    }

    fn is_terminal(self: &const shared) -> bool: {
        if .op == OpCode::OpMatch: {
            return true;
        }
        return .op == OpCode::OpFail;
    }

    
    
    fn minimum_width(self: &const shared) -> int: {
        if .op == OpCode::OpString: {
            return .text.size();
        }
        if .consumes_input(): {
            return 1;
        }
        return 0;
    }

    op: OpCode = OpCode::OpFail;
    value: char = '\0';
    text: string;
    charclass: CharClass;
    anchor: AnchorKind = AnchorKind::AnchorLineStart;
    slot: int = 0;
    x: int = -1;
    y: int = -1;
}

struct Program: {

    fn size(self: &const shared) -> int: {
        return .code.size();
    }

    fn empty(self: &const shared) -> bool: {
        return .code.empty();
    }

    fn at(self: &shared, pc: int) -> &shared[self] Instruction: {
        return .code[pc];
    }

    fn op_at(self: &const shared, pc: int) -> OpCode: {
        if pc < 0: {
            return OpCode::OpFail;
        }
        if pc >= .code.size(): {
            return OpCode::OpFail;
        }
        return .code[pc].op;
    }

    fn emit(self: &unique, inst: Instruction) -> int: {
        let at = .code.size();
        .code.push_back(inst);
        return at;
    }

    fn emit_op(self: &unique, op: OpCode) -> int: {
        return .emit(Instruction(op: op));
    }

    fn emit_char(self: &unique, c: char) -> int: {
        var inst = Instruction(op: OpCode::OpChar, value: c);
        inst.charclass.add_char(c);
        return .emit(inst);
    }

    fn emit_class(self: &unique, cls: &const shared CharClass) -> int: {
        var inst = Instruction(op: OpCode::OpClass);
        inst.charclass = cls;
        inst.charclass.normalise();
        return .emit(inst);
    }

    fn emit_save(self: &unique, slot: int) -> int: {
        var inst = Instruction(op: OpCode::OpSave);
        inst.slot = slot;
        return .emit(inst);
    }

    fn emit_assert(self: &unique, which: AnchorKind) -> int: {
        var inst = Instruction(op: OpCode::OpAssert);
        inst.anchor = which;
        return .emit(inst);
    }

    fn emit_backref(self: &unique, slot: int) -> int: {
        var inst = Instruction(op: OpCode::OpBackref);
        inst.slot = slot;
        return .emit(inst);
    }

    fn set_target(self: &unique, pc: int, target: int): {
        let inst: &unique = .code[pc];
        inst.x = target;
    }

    fn set_alternate(self: &unique, pc: int, target: int): {
        let inst: &unique = .code[pc];
        inst.y = target;
    }

    fn instruction_count_of(self: &const shared, op: OpCode) -> int: {
        var total: int = 0;
        for inst: &const in .code: {
            if inst.op == op: {
                total += 1;
            }
        }
        return total;
    }

    
    
    
    fn minimum_length(self: &const shared) -> int: {
        var total: int = 0;
        for inst: &const in .code: {
            if inst.op == OpCode::OpSplit: {
                return total;
            }
            total += inst.minimum_width();
            if inst.op == OpCode::OpMatch: {
                break;
            }
        }
        return total;
    }

    fn disassemble(self: &const shared) -> string: {
        var out = TEXT_EMPTY;
        var pc: int = 0;
        while pc < .code.size(): {
            let inst: &const shared = .code[pc];
            out.append(to_string(pc));
            out.append(TEXT_SPACE_ARROW);
            out.append(opcode_name(inst.op));
            if inst.op == OpCode::OpChar: {
                out.append(TEXT_SPACE);
                out.append(escape_spelling(inst.value));
            }
            if inst.op == OpCode::OpString: {
                out.append(TEXT_SPACE);
                out.append(inst.text);
            }
            if inst.op == OpCode::OpClass: {
                out.append(TEXT_SPACE);
                out.append(inst.charclass.spell());
            }
            if inst.is_branch(): {
                out.append(TEXT_SPACE);
                out.append(to_string(inst.x));
            }
            if inst.op == OpCode::OpSplit: {
                out.append(TEXT_COMMA_SPACE);
                out.append(to_string(inst.y));
            }
            out.append(TEXT_NEWLINE);
            pc += 1;
        }
        return out;
    }

    code: vector{Instruction};
    names: vector{GroupName};
    prefix: string;
    group_count: int = 0;
    start: int = 0;
    anchored: bool = false;
    has_backreference: bool = false;
    ignore_case: bool = false;
    multiline: bool = false;
    dot_matches_newline: bool = false;
}

static TEXT_SPACE: string = " ";
static TEXT_NEWLINE: string = "\n";
static TEXT_COMMA_SPACE: string = ", ";
static TEXT_SPACE_ARROW: string = ": ";

fn opcode_name(op: OpCode) -> string: {
    if op == OpCode::OpChar: {
        return "char";
    }
    if op == OpCode::OpString: {
        return "string";
    }
    if op == OpCode::OpClass: {
        return "class";
    }
    if op == OpCode::OpAny: {
        return "any";
    }
    if op == OpCode::OpSplit: {
        return "split";
    }
    if op == OpCode::OpJump: {
        return "jump";
    }
    if op == OpCode::OpSave: {
        return "save";
    }
    if op == OpCode::OpAssert: {
        return "assert_at";
    }
    if op == OpCode::OpBackref: {
        return "backref";
    }
    if op == OpCode::OpMatch: {
        return "match";
    }
    return "fail";
}









struct Compiler: {

    fn compile(self: &unique, parser: &const shared PatternParser) -> bool: {
        .program = Program();
        .nodes = parser.nodes;
        .program.group_count = parser.group_count;
        .program.names = parser.names;
        .ok = true;
        discard .program.emit_save(0);
        .compile_node(parser.root);
        if !.ok: {
            return false;
        }
        discard .program.emit_save(1);
        discard .program.emit_op(OpCode::OpMatch);
        .program.anchored = .starts_anchored(parser.root);
        return true;
    }

    fn here(self: &const shared) -> int: {
        return .program.code.size();
    }

    fn compile_node(self: &unique, index: int): {
        if index == NONE: {
            return;
        }
        if !.ok: {
            return;
        }
        let kind = .nodes[index].kind;
        if kind == NodeKind::NodeEmpty: {
            return;
        }
        if kind == NodeKind::NodeLiteral: {
            discard .program.emit_char(.nodes[index].value);
            return;
        }
        if kind == NodeKind::NodeString: {
            var inst = Instruction(op: OpCode::OpString);
            inst.text = .nodes[index].text;
            discard .program.emit(inst);
            return;
        }
        if kind == NodeKind::NodeAny: {
            discard .program.emit_class(.nodes[index].charclass);
            return;
        }
        if kind == NodeKind::NodeClass: {
            discard .program.emit_class(.nodes[index].charclass);
            return;
        }
        if kind == NodeKind::NodeAnchor: {
            discard .program.emit_assert(.nodes[index].anchor);
            return;
        }
        if kind == NodeKind::NodeBackreference: {
            .program.has_backreference = true;
            discard .program.emit_backref(.nodes[index].reference);
            return;
        }
        if kind == NodeKind::NodeConcat: {
            .compile_concat(index);
            return;
        }
        if kind == NodeKind::NodeAlternate: {
            .compile_alternate(index);
            return;
        }
        if kind == NodeKind::NodeGroup: {
            .compile_group(index);
            return;
        }
        if kind == NodeKind::NodeRepeat: {
            .compile_repeat(index);
            return;
        }
        .ok = false;
    }

    fn compile_concat(self: &unique, index: int): {
        let count = .nodes[index].children.size();
        var i: int = 0;
        while i < count: {
            .compile_node(.nodes[index].children[i]);
            if !.ok: {
                return;
            }
            i += 1;
        }
    }

    
    
    
    fn compile_alternate(self: &unique, index: int): {
        let count = .nodes[index].children.size();
        if count == 0: {
            return;
        }
        var jumps = vector{int}();
        var i: int = 0;
        while i < count: {
            let child = .nodes[index].children[i];
            if i + 1 == count: {
                .compile_node(child);
                i += 1;
                continue;
            }
            let split = .program.emit_op(OpCode::OpSplit);
            .program.set_target(split, .here());
            .compile_node(child);
            if !.ok: {
                return;
            }
            let jump = .program.emit_op(OpCode::OpJump);
            jumps.push_back(jump);
            .program.set_alternate(split, .here());
            i += 1;
        }
        let join = .here();
        for jump: &const in jumps: {
            .program.set_target(jump, join);
        }
    }

    fn compile_group(self: &unique, index: int): {
        let group = .nodes[index].group_index;
        if group == NONE: {
            .compile_node(.nodes[index].first);
            return;
        }
        discard .program.emit_save(group * 2);
        .compile_node(.nodes[index].first);
        if !.ok: {
            return;
        }
        discard .program.emit_save(group * 2 + 1);
    }

    fn compile_repeat(self: &unique, index: int): {
        let lower = .nodes[index].lower;
        let upper = .nodes[index].upper;
        let body = .nodes[index].first;
        let lazy = .nodes[index].greed == Greediness::Lazy;
        var i: int = 0;
        while i < lower: {
            .compile_node(body);
            if !.ok: {
                return;
            }
            i += 1;
        }
        if upper == NONE: {
            .compile_star(body, lazy);
            return;
        }
        var extra = upper - lower;
        var splits = vector{int}();
        while extra > 0: {
            let split = .program.emit_op(OpCode::OpSplit);
            splits.push_back(split);
            if lazy: {
                .program.set_alternate(split, .here());
            } else: {
                .program.set_target(split, .here());
            }
            .compile_node(body);
            if !.ok: {
                return;
            }
            extra -= 1;
        }
        let after = .here();
        for split: &const in splits: {
            if lazy: {
                .program.set_target(split, after);
            } else: {
                .program.set_alternate(split, after);
            }
        }
    }

    
    
    fn compile_star(self: &unique, body: int, lazy: bool): {
        let split = .program.emit_op(OpCode::OpSplit);
        let body_at = .here();
        .compile_node(body);
        if !.ok: {
            return;
        }
        let jump = .program.emit_op(OpCode::OpJump);
        .program.set_target(jump, split);
        let after = .here();
        if lazy: {
            .program.set_target(split, after);
            .program.set_alternate(split, body_at);
        } else: {
            .program.set_target(split, body_at);
            .program.set_alternate(split, after);
        }
    }

    
    
    
    fn starts_anchored(self: &const shared, index: int) -> bool: {
        if index == NONE: {
            return false;
        }
        let kind = .nodes[index].kind;
        if kind == NodeKind::NodeAnchor: {
            let which = .nodes[index].anchor;
            if which == AnchorKind::AnchorTextStart: {
                return true;
            }
            return which == AnchorKind::AnchorLineStart;
        }
        if kind == NodeKind::NodeGroup: {
            return .starts_anchored(.nodes[index].first);
        }
        if kind == NodeKind::NodeConcat: {
            if .nodes[index].children.empty(): {
                return false;
            }
            return .starts_anchored(.nodes[index].children[0]);
        }
        if kind == NodeKind::NodeAlternate: {
            
            
            if .nodes[index].children.empty(): {
                return false;
            }
            for child: &const in .nodes[index].children: {
                if !.starts_anchored(child): {
                    return false;
                }
            }
            return true;
        }
        return false;
    }

    program: Program;
    nodes: vector{Node};
    ok: bool = true;
}


















struct OptimiserStats: {

    fn total(self: &const shared) -> int: {
        var sum = .literal_runs + .merged_classes;
        sum += .collapsed_repeats;
        sum += .threaded_jumps;
        sum += .dead_instructions;
        return sum;
    }

    fn describe(self: &const shared) -> string: {
        var out = TEXT_EMPTY;
        out.append("literal runs: ");
        out.append(to_string(.literal_runs));
        out.append(TEXT_COMMA_SPACE);
        out.append("merged classes: ");
        out.append(to_string(.merged_classes));
        out.append(TEXT_COMMA_SPACE);
        out.append("collapsed repeats: ");
        out.append(to_string(.collapsed_repeats));
        out.append(TEXT_COMMA_SPACE);
        out.append("threaded jumps: ");
        out.append(to_string(.threaded_jumps));
        out.append(TEXT_COMMA_SPACE);
        out.append("dead instructions: ");
        out.append(to_string(.dead_instructions));
        return out;
    }

    literal_runs: int = 0;
    merged_classes: int = 0;
    collapsed_repeats: int = 0;
    threaded_jumps: int = 0;
    dead_instructions: int = 0;
    rounds: int = 0;
}

struct Optimiser: {

    fn changed(self: &const shared) -> bool: {
        return .rewrites > 0;
    }

    fn spend(self: &unique) -> bool: {
        .work += 1;
        return .work <= OPTIMISER_BUDGET;
    }

    

    fn optimise_tree(self: &unique, parser: &unique PatternParser) -> int: {
        .rewrites = 0;
        var round: int = 0;
        while round < 4: {
            let before = .rewrites;
            .fuse_literals(parser, parser.root);
            .merge_alternate_classes(parser, parser.root);
            .collapse_repeats(parser, parser.root);
            .stats.rounds += 1;
            if .rewrites == before: {
                break;
            }
            round += 1;
        }
        return .rewrites;
    }

    
    
    
    fn fuse_literals(self: &unique, parser: &unique PatternParser, index: int): {
        if index == NONE: {
            return;
        }
        if !.spend(): {
            return;
        }
        let kind = parser.nodes[index].kind;
        if kind == NodeKind::NodeRepeat: {
            .fuse_literals(parser, parser.nodes[index].first);
            return;
        }
        if kind == NodeKind::NodeGroup: {
            .fuse_literals(parser, parser.nodes[index].first);
            return;
        }
        if kind == NodeKind::NodeAlternate: {
            let count = parser.nodes[index].children.size();
            var i: int = 0;
            while i < count: {
                .fuse_literals(parser, parser.nodes[index].children[i]);
                i += 1;
            }
            return;
        }
        if kind != NodeKind::NodeConcat: {
            return;
        }
        let count = parser.nodes[index].children.size();
        var i: int = 0;
        while i < count: {
            .fuse_literals(parser, parser.nodes[index].children[i]);
            i += 1;
        }
        var rebuilt = vector{int}();
        var run = TEXT_EMPTY;
        var run_start = NONE;
        i = 0;
        while i < count: {
            let child = parser.nodes[index].children[i];
            let child_kind = parser.nodes[child].kind;
            var literal = child_kind == NodeKind::NodeLiteral;
            if literal && i + 1 < count: {
                
                
                let next = parser.nodes[index].children[i + 1];
                if parser.nodes[next].kind == NodeKind::NodeRepeat: {
                    if parser.nodes[next].first == child: {
                        literal = false;
                    }
                }
            }
            if literal: {
                if run_start == NONE: {
                    run_start = child;
                }
                run.push_back(parser.nodes[child].value);
            } else: {
                if run.size() >= 2: {
                    let fused = .make_string_node(parser, run);
                    rebuilt.push_back(fused);
                    .rewrites += 1;
                    .stats.literal_runs += 1;
                } else: {
                    if run_start != NONE: {
                        rebuilt.push_back(run_start);
                    }
                }
                run = TEXT_EMPTY;
                run_start = NONE;
                rebuilt.push_back(child);
            }
            i += 1;
        }
        if run.size() >= 2: {
            let fused = .make_string_node(parser, run);
            rebuilt.push_back(fused);
            .rewrites += 1;
            .stats.literal_runs += 1;
        } else: {
            if run_start != NONE: {
                rebuilt.push_back(run_start);
            }
        }
        let n: &unique = parser.nodes[index];
        n.children = move(rebuilt);
    }

    fn make_string_node(self: &unique, parser: &unique PatternParser, text: &const shared string) -> int: {
        let index = parser.nodes.size();
        var n = Node(kind: NodeKind::NodeString);
        n.text = text;
        parser.nodes.push_back(n);
        return index;
    }

    
    
    
    
    fn merge_alternate_classes(self: &unique, parser: &unique PatternParser, index: int): {
        if index == NONE: {
            return;
        }
        if !.spend(): {
            return;
        }
        let kind = parser.nodes[index].kind;
        if kind == NodeKind::NodeRepeat: {
            .merge_alternate_classes(parser, parser.nodes[index].first);
            return;
        }
        if kind == NodeKind::NodeGroup: {
            .merge_alternate_classes(parser, parser.nodes[index].first);
            return;
        }
        if kind == NodeKind::NodeConcat: {
            let count = parser.nodes[index].children.size();
            var i: int = 0;
            while i < count: {
                .merge_alternate_classes(parser, parser.nodes[index].children[i]);
                i += 1;
            }
            return;
        }
        if kind != NodeKind::NodeAlternate: {
            return;
        }
        let count = parser.nodes[index].children.size();
        var i: int = 0;
        while i < count: {
            .merge_alternate_classes(parser, parser.nodes[index].children[i]);
            i += 1;
        }
        if count < 2: {
            return;
        }
        var mergeable = true;
        i = 0;
        while i < count: {
            let child = parser.nodes[index].children[i];
            let child_kind = parser.nodes[child].kind;
            var fine = false;
            if child_kind == NodeKind::NodeLiteral: {
                fine = true;
            }
            if child_kind == NodeKind::NodeClass: {
                
                
                
                if !parser.nodes[child].charclass.negated: {
                    fine = true;
                }
            }
            if !fine: {
                mergeable = false;
                break;
            }
            i += 1;
        }
        if !mergeable: {
            return;
        }
        var merged = CharClass();
        i = 0;
        while i < count: {
            let child = parser.nodes[index].children[i];
            merged.add_class(parser.nodes[child].charclass);
            i += 1;
        }
        merged.normalise();
        let n: &unique = parser.nodes[index];
        n.kind = NodeKind::NodeClass;
        n.charclass = merged;
        n.children.clear();
        .rewrites += 1;
        .stats.merged_classes += 1;
    }

    
    
    fn collapse_repeats(self: &unique, parser: &unique PatternParser, index: int): {
        if index == NONE: {
            return;
        }
        if !.spend(): {
            return;
        }
        let kind = parser.nodes[index].kind;
        if kind == NodeKind::NodeConcat: {
            let count = parser.nodes[index].children.size();
            var i: int = 0;
            while i < count: {
                .collapse_repeats(parser, parser.nodes[index].children[i]);
                i += 1;
            }
            return;
        }
        if kind == NodeKind::NodeAlternate: {
            let count = parser.nodes[index].children.size();
            var i: int = 0;
            while i < count: {
                .collapse_repeats(parser, parser.nodes[index].children[i]);
                i += 1;
            }
            return;
        }
        if kind == NodeKind::NodeGroup: {
            .collapse_repeats(parser, parser.nodes[index].first);
            return;
        }
        if kind != NodeKind::NodeRepeat: {
            return;
        }
        .collapse_repeats(parser, parser.nodes[index].first);
        let lower = parser.nodes[index].lower;
        let upper = parser.nodes[index].upper;
        if lower == 0 && upper == 0: {
            let n: &unique = parser.nodes[index];
            n.kind = NodeKind::NodeEmpty;
            n.first = NONE;
            .rewrites += 1;
            .stats.collapsed_repeats += 1;
            return;
        }
        if lower == 1 && upper == 1: {
            let body = parser.nodes[index].first;
            let source: &const shared = parser.nodes[body];
            var copy = source;
            let n: &unique = parser.nodes[index];
            n.kind = copy.kind;
            n.value = copy.value;
            n.text = copy.text;
            n.charclass = copy.charclass;
            n.anchor = copy.anchor;
            n.group_kind = copy.group_kind;
            n.group_index = copy.group_index;
            n.reference = copy.reference;
            n.lower = copy.lower;
            n.upper = copy.upper;
            n.first = copy.first;
            n.children = copy.children;
            .rewrites += 1;
            .stats.collapsed_repeats += 1;
        }
    }

    
    
    
    
    
    

    fn extract_prefix(self: &unique, parser: &const shared PatternParser, index: int) -> string: {
        var out = TEXT_EMPTY;
        .collect_prefix(parser, index, out);
        return out;
    }

    fn collect_prefix(self: &unique, parser: &const shared PatternParser, index: int, out: &unique string): {
        if index == NONE: {
            return;
        }
        if !.spend(): {
            return;
        }
        let kind = parser.nodes[index].kind;
        if kind == NodeKind::NodeLiteral: {
            out.push_back(parser.nodes[index].value);
            return;
        }
        if kind == NodeKind::NodeString: {
            out.append(parser.nodes[index].text);
            return;
        }
        if kind == NodeKind::NodeGroup: {
            if parser.nodes[index].group_kind == GroupKind::NonCapturing: {
                .collect_prefix(parser, parser.nodes[index].first, out);
            }
            return;
        }
        if kind == NodeKind::NodeAnchor: {
            
            return;
        }
        if kind == NodeKind::NodeRepeat: {
            if parser.nodes[index].lower >= 1: {
                
                
                var inner = TEXT_EMPTY;
                .collect_prefix(parser, parser.nodes[index].first, inner);
                out.append(inner);
            }
            return;
        }
        if kind != NodeKind::NodeConcat: {
            return;
        }
        let count = parser.nodes[index].children.size();
        var i: int = 0;
        while i < count: {
            let child = parser.nodes[index].children[i];
            let child_kind = parser.nodes[child].kind;
            if child_kind == NodeKind::NodeLiteral: {
                out.push_back(parser.nodes[child].value);
                i += 1;
                continue;
            }
            if child_kind == NodeKind::NodeString: {
                out.append(parser.nodes[child].text);
                i += 1;
                continue;
            }
            if child_kind == NodeKind::NodeAnchor: {
                i += 1;
                continue;
            }
            break;
        }
    }

    

    fn optimise_program(self: &unique, program: &unique Program) -> int: {
        .rewrites = 0;
        var round: int = 0;
        while round < 3: {
            let before = .rewrites;
            .thread_jumps(program);
            .mark_dead(program);
            if .rewrites == before: {
                break;
            }
            round += 1;
        }
        return .rewrites;
    }

    
    
    
    
    fn thread_jumps(self: &unique, program: &unique Program): {
        var pc: int = 0;
        while pc < program.code.size(): {
            if !.spend(): {
                return;
            }
            let inst: &const shared = program.code[pc];
            if inst.is_branch(): {
                let target = .final_target(program, inst.x);
                if target != inst.x: {
                    program.set_target(pc, target);
                    .rewrites += 1;
                    .stats.threaded_jumps += 1;
                }
            }
            let again: &const shared = program.code[pc];
            if again.op == OpCode::OpSplit: {
                let target = .final_target(program, again.y);
                if target != again.y: {
                    program.set_alternate(pc, target);
                    .rewrites += 1;
                    .stats.threaded_jumps += 1;
                }
            }
            pc += 1;
        }
    }

    fn final_target(self: &unique, program: &const shared Program, start: int) -> int: {
        var target = start;
        var hops: int = 0;
        while hops < 32: {
            if target < 0: {
                return start;
            }
            if target >= program.code.size(): {
                return start;
            }
            let inst: &const shared = program.code[target];
            if inst.op != OpCode::OpJump: {
                return target;
            }
            if inst.x == target: {
                return target;
            }
            target = inst.x;
            hops += 1;
        }
        return target;
    }

    
    
    
    fn mark_dead(self: &unique, program: &unique Program): {
        var reachable = vector{bool}();
        reachable.resize(program.code.size());
        var i: int = 0;
        while i < program.code.size(): {
            reachable[i] = false;
            i += 1;
        }
        var stack = vector{int}();
        stack.push_back(program.start);
        while !stack.empty(): {
            if !.spend(): {
                return;
            }
            let pc = stack.back();
            stack.pop_back();
            if pc < 0: {
                continue;
            }
            if pc >= program.code.size(): {
                continue;
            }
            if reachable[pc]: {
                continue;
            }
            reachable[pc] = true;
            let inst: &const shared = program.code[pc];
            if inst.op == OpCode::OpMatch: {
                continue;
            }
            if inst.op == OpCode::OpFail: {
                continue;
            }
            if inst.op == OpCode::OpJump: {
                stack.push_back(inst.x);
                continue;
            }
            if inst.op == OpCode::OpSplit: {
                stack.push_back(inst.x);
                stack.push_back(inst.y);
                continue;
            }
            stack.push_back(pc + 1);
        }
        i = 0;
        while i < program.code.size(): {
            if !reachable[i]: {
                let inst: &unique = program.code[i];
                if inst.op != OpCode::OpFail: {
                    inst.op = OpCode::OpFail;
                    .rewrites += 1;
                    .stats.dead_instructions += 1;
                }
            }
            i += 1;
        }
    }

    stats: OptimiserStats;
    rewrites: int = 0;
    work: int = 0;
}



struct MatchResult: {

    fn matched(self: &const shared) -> bool: {
        return .found;
    }

    fn begin(self: &const shared) -> int: {
        let whole: &const shared = .groups[0];
        return whole.begin;
    }

    fn end(self: &const shared) -> int: {
        let whole: &const shared = .groups[0];
        return whole.end;
    }

    fn length(self: &const shared) -> int: {
        return .end() - .begin();
    }

    fn group_count(self: &const shared) -> int: {
        return .groups.size();
    }

    fn group(self: &const shared, index: int) -> string: {
        if index < 0: {
            return TEXT_EMPTY;
        }
        if index >= .groups.size(): {
            return TEXT_EMPTY;
        }
        let cap: &const shared = .groups[index];
        return cap.text_of(.subject);
    }

    fn group_begin(self: &const shared, index: int) -> int: {
        if index >= .groups.size(): {
            return NONE;
        }
        let cap: &const shared = .groups[index];
        return cap.begin;
    }

    fn has_group(self: &const shared, index: int) -> bool: {
        if index >= .groups.size(): {
            return false;
        }
        let cap: &const shared = .groups[index];
        return cap.valid();
    }

    fn text(self: &const shared) -> string: {
        return .group(0);
    }

    fn prefix_text(self: &const shared) -> string: {
        return .subject.substr(0, .begin());
    }

    fn suffix_text(self: &const shared) -> string: {
        let from = .end();
        return .subject.substr(from, .subject.size() - from);
    }

    subject: string;
    groups: vector{Capture};
    names: vector{GroupName};
    found: bool = false;
    steps: int = 0;
    status: MatchStatus = MatchStatus::NoMatch;
}

fn empty_result(subject: &const shared string) -> MatchResult: {
    var r = MatchResult();
    r.subject = subject;
    r.groups.push_back(Capture());
    return r;
}








enum EngineChoice: {
    ChooseAutomatic;
    ForceBacktrack;
    ForceSimulation = 2;
}

struct Regex: {

    fn valid(self: &const shared) -> bool: {
        return .ok;
    }

    fn error_text(self: &const shared) -> string: {
        return .error;
    }

    fn error_offset(self: &const shared) -> int: {
        return .error_position;
    }

    fn group_count(self: &const shared) -> int: {
        return .parser.group_count;
    }

    fn pattern_text(self: &const shared) -> string: {
        return .pattern;
    }

    fn program_size(self: &const shared) -> int: {
        return .compiler.program.size();
    }

    fn state_count(self: &const shared) -> int: {
        return .builder.state_count();
    }

    fn literal_prefix(self: &const shared) -> string: {
        return .prefix;
    }

    

    fn compile(self: &unique, pattern: &const shared string) -> bool: {
        .pattern = pattern;
        .ok = true;
        .error = ERROR_NONE;
        .parser = PatternParser();
        .parser.dot_matches_newline = .dot_matches_newline;
        .parser.ignore_case = .ignore_case;
        let root = .parser.parse(pattern);
        if root == NONE: {
            .ok = false;
            .error = .parser.error;
            .error_position = .parser.error_position;
            return false;
        }
        .optimiser = Optimiser();
        discard .optimiser.optimise_tree(.parser);
        .prefix = .optimiser.extract_prefix(.parser, .parser.root);
        if !.builder.build(.parser, .parser.root): {
            .ok = false;
            .error = ERROR_BAD_GROUP;
            return false;
        }
        if !.compiler.compile(.parser): {
            .ok = false;
            .error = ERROR_BAD_GROUP;
            return false;
        }
        discard .optimiser.optimise_program(.compiler.program);
        .compiler.program.prefix = .prefix;
        .compiler.program.ignore_case = .ignore_case;
        .compiler.program.multiline = .multiline;
        .anchored = .compiler.program.anchored;
        return true;
    }

    fn prepare_backtracker(self: &unique, subject: &const shared string): {
        .matcher = BacktrackMatcher();
        .matcher.load(.parser);
        .matcher.text = subject;
        .matcher.ignore_case = .ignore_case;
        .matcher.multiline = .multiline;
        .matcher.budget = BACKTRACK_BUDGET;
    }

    fn prepare_simulator(self: &unique, subject: &const shared string): {
        .simulator = NfaSimulator();
        .simulator.load(.builder);
        .simulator.text = subject;
        .simulator.ignore_case = .ignore_case;
        .simulator.multiline = .multiline;
    }

    
    
    fn may_simulate(self: &const shared, want_captures: bool) -> bool: {
        if .engine == EngineChoice::ForceBacktrack: {
            return false;
        }
        if .engine == EngineChoice::ForceSimulation: {
            return true;
        }
        if .builder.has_backreference: {
            return false;
        }
        if want_captures: {
            return false;
        }
        return true;
    }

    
    
    
    
    

    fn next_candidate(self: &const shared, subject: &const shared string, from: int) -> int: {
        if .prefix.empty(): {
            return from;
        }
        var start = from;
        let limit = subject.size() - .prefix.size();
        while start <= limit: {
            var i: int = 0;
            var hit = true;
            while i < .prefix.size(): {
                let expected = .prefix.at(i);
                let actual = subject.at(start + i);
                if .ignore_case: {
                    if !same_char_folded(expected, actual): {
                        hit = false;
                        break;
                    }
                } else: {
                    if expected != actual: {
                        hit = false;
                        break;
                    }
                }
                i += 1;
            }
            if hit: {
                return start;
            }
            start += 1;
        }
        return NONE;
    }

    
    
    

    fn match_text(self: &unique, subject: &const shared string) -> MatchResult: {
        var result = empty_result(subject);
        if !.ok: {
            return result;
        }
        .prepare_backtracker(subject);
        if !.matcher.match_whole(): {
            result.status = .matcher.status;
            result.steps = .matcher.steps;
            return result;
        }
        result.found = true;
        result.groups = .matcher.captures;
        result.names = .parser.names;
        result.steps = .matcher.steps;
        result.status = MatchStatus::Matched;
        return result;
    }

    
    
    

    fn search(self: &unique, subject: &const shared string) -> MatchResult: {
        return .search_from(subject, 0);
    }

    fn search_from(self: &unique, subject: &const shared string, from: int) -> MatchResult: {
        var result = empty_result(subject);
        if !.ok: {
            return result;
        }
        if from > subject.size(): {
            return result;
        }
        .prepare_backtracker(subject);
        var start = from;
        loop: {
            if start > subject.size(): {
                break;
            }
            let candidate = .next_candidate(subject, start);
            if candidate == NONE: {
                break;
            }
            if .matcher.match_at(candidate): {
                result.found = true;
                result.groups = .matcher.captures;
                result.names = .parser.names;
                result.steps = .matcher.steps;
                result.status = MatchStatus::Matched;
                return result;
            }
            if .matcher.exhausted(): {
                result.status = MatchStatus::Exhausted;
                return result;
            }
            if .anchored: {
                
                
                
                if !.multiline: {
                    break;
                }
            }
            start = candidate + 1;
        }
        result.steps = .matcher.steps;
        return result;
    }

    
    
    fn contains(self: &unique, subject: &const shared string) -> bool: {
        if !.ok: {
            return false;
        }
        if .may_simulate(false): {
            .prepare_simulator(subject);
            return .simulator.search_from(0);
        }
        let found = .search(subject);
        return found.matched();
    }

    
    
    
    

    fn find_all(self: &unique, subject: &const shared string) -> vector{MatchResult}: {
        var out = vector{MatchResult}();
        if !.ok: {
            return out;
        }
        var cursor: int = 0;
        var guard: int = 0;
        while cursor <= subject.size(): {
            guard += 1;
            if guard > subject.size() + 2: {
                break;
            }
            let hit = .search_from(subject, cursor);
            if !hit.matched(): {
                break;
            }
            let stop = hit.end();
            let begin = hit.begin();
            out.push_back(hit);
            if stop == begin: {
                cursor = stop + 1;
            } else: {
                cursor = stop;
            }
        }
        return out;
    }

    fn count_matches(self: &unique, subject: &const shared string) -> int: {
        let all = .find_all(subject);
        return all.size();
    }

    
    
    
    

    fn replace_first(self: &unique, subject: &const shared string, replacement: &const shared string) -> string: {
        var out = TEXT_EMPTY;
        if !.ok: {
            return subject;
        }
        let hit = .search(subject);
        if !hit.matched(): {
            return subject;
        }
        out.append(subject.substr(0, hit.begin()));
        out.append(expand_replacement(replacement, hit));
        let tail = hit.end();
        out.append(subject.substr(tail, subject.size() - tail));
        return out;
    }

    fn replace_all(self: &unique, subject: &const shared string, replacement: &const shared string) -> string: {
        var out = TEXT_EMPTY;
        if !.ok: {
            return subject;
        }
        var cursor: int = 0;
        var guard: int = 0;
        while cursor <= subject.size(): {
            guard += 1;
            if guard > subject.size() + 2: {
                break;
            }
            let hit = .search_from(subject, cursor);
            if !hit.matched(): {
                break;
            }
            let begin = hit.begin();
            let stop = hit.end();
            out.append(subject.substr(cursor, begin - cursor));
            out.append(expand_replacement(replacement, hit));
            if stop == begin: {
                if begin < subject.size(): {
                    out.push_back(subject.at(begin));
                }
                cursor = begin + 1;
            } else: {
                cursor = stop;
            }
        }
        if cursor < subject.size(): {
            out.append(subject.substr(cursor, subject.size() - cursor));
        }
        return out;
    }

    
    
    
    
    

    fn split(self: &unique, subject: &const shared string, limit: int) -> vector{string}: {
        var out = vector{string}();
        if !.ok: {
            out.push_back(subject);
            return out;
        }
        var cursor: int = 0;
        var guard: int = 0;
        while cursor <= subject.size(): {
            guard += 1;
            if guard > subject.size() + 2: {
                break;
            }
            if limit > 0: {
                if out.size() + 1 >= limit: {
                    break;
                }
            }
            let hit = .search_from(subject, cursor);
            if !hit.matched(): {
                break;
            }
            let begin = hit.begin();
            let stop = hit.end();
            if stop == begin: {
                
                
                if begin >= subject.size(): {
                    break;
                }
                out.push_back(subject.substr(cursor, begin + 1 - cursor));
                cursor = begin + 1;
                continue;
            }
            out.push_back(subject.substr(cursor, begin - cursor));
            cursor = stop;
        }
        out.push_back(subject.substr(cursor, subject.size() - cursor));
        return out;
    }

    
    
    fn split_nonempty(self: &unique, subject: &const shared string, limit: int) -> vector{string}: {
        let pieces = .split(subject, limit);
        var out = vector{string}();
        for piece: &const in pieces: {
            if !piece.empty(): {
                out.push_back(piece);
            }
        }
        return out;
    }

    

    fn describe(self: &const shared) -> string: {
        var out = TEXT_EMPTY;
        out.append("pattern ");
        out.append(.pattern);
        out.append(TEXT_NEWLINE);
        if !.ok: {
            out.append("error: ");
            out.append(.error);
            out.append(" at ");
            out.append(to_string(.error_position));
            out.append(TEXT_NEWLINE);
            return out;
        }
        out.append("groups: ");
        out.append(to_string(.parser.group_count));
        out.append(TEXT_NEWLINE);
        out.append("nfa states: ");
        out.append(to_string(.builder.state_count()));
        out.append(TEXT_NEWLINE);
        out.append("program: ");
        out.append(to_string(.compiler.program.size()));
        out.append(TEXT_NEWLINE);
        out.append("prefix: ");
        out.append(.prefix);
        out.append(TEXT_NEWLINE);
        out.append(.optimiser.stats.describe());
        out.append(TEXT_NEWLINE);
        return out;
    }

    pattern: string;
    prefix: string;
    error: string;
    parser: PatternParser;
    builder: NfaBuilder;
    compiler: Compiler;
    optimiser: Optimiser;
    matcher: BacktrackMatcher;
    simulator: NfaSimulator;
    engine: EngineChoice = EngineChoice::ChooseAutomatic;
    error_position: int = 0;
    ok: bool = false;
    anchored: bool = false;
    ignore_case: bool = false;
    multiline: bool = false;
    dot_matches_newline: bool = false;
}


fn expand_replacement(template_text: &const shared string, hit: &const shared MatchResult) -> string: {
    var out = TEXT_EMPTY;
    var i: int = 0;
    while i < template_text.size(): {
        let c = template_text.at(i);
        if c != CHAR_DOLLAR: {
            out.push_back(c);
            i += 1;
            continue;
        }
        let next = i + 1;
        if next >= template_text.size(): {
            out.push_back(c);
            i += 1;
            continue;
        }
        let marker = template_text.at(next);
        if marker == CHAR_DOLLAR: {
            out.push_back(CHAR_DOLLAR);
            i += 2;
            continue;
        }
        if is_digit(marker): {
            out.append(hit.group(digit_value(marker)));
            i += 2;
            continue;
        }
        if marker == CHAR_LBRACE: {
            
            var scan = next + 1;
            var name = TEXT_EMPTY;
            while scan < template_text.size(): {
                let n = template_text.at(scan);
                if n == CHAR_RBRACE: {
                    break;
                }
                name.push_back(n);
                scan += 1;
            }
            var index = NONE;
            for entry: &const in hit.names: {
                if entry.name.compare(name) == 0: {
                    index = entry.index;
                    break;
                }
            }
            if index != NONE: {
                out.append(hit.group(index));
            }
            i = scan + 1;
            continue;
        }
        out.push_back(c);
        i += 1;
    }
    return out;
}







fn quick_match(pattern: &const shared string, subject: &const shared string) -> bool: {
    var re = Regex();
    if !re.compile(pattern): {
        return false;
    }
    let hit = re.match_text(subject);
    return hit.matched();
}

fn quick_search(pattern: &const shared string, subject: &const shared string) -> bool: {
    var re = Regex();
    if !re.compile(pattern): {
        return false;
    }
    return re.contains(subject);
}

fn quick_replace(pattern: &const shared string, subject: &const shared string, replacement: &const shared string) -> string: {
    var re = Regex();
    if !re.compile(pattern): {
        return subject;
    }
    return re.replace_all(subject, replacement);
}

fn quick_split(pattern: &const shared string, subject: &const shared string) -> vector{string}: {
    var re = Regex();
    var out = vector{string}();
    if !re.compile(pattern): {
        out.push_back(subject);
        return out;
    }
    return re.split(subject, 0);
}


fn quote_literal(text: &const shared string) -> string: {
    var out = TEXT_EMPTY;
    var i: int = 0;
    while i < text.size(): {
        let c = text.at(i);
        if is_metacharacter(c): {
            out.push_back(CHAR_BACKSLASH);
        }
        out.push_back(c);
        i += 1;
    }
    return out;
}







fn example_tokenise_words(subject: &const shared string) -> vector{string}: {
    var re = Regex();
    if !re.compile("[a-zA-Z_][a-zA-Z_0-9]*"): {
        return vector{string}();
    }
    var out = vector{string}();
    let hits = re.find_all(subject);
    for hit: &const in hits: {
        out.push_back(hit.text());
    }
    return out;
}

fn example_strip_comments(subject: &const shared string) -> string: {
    var re = Regex();
    if !re.compile("//[^\n]*"): {
        return subject;
    }
    return re.replace_all(subject, TEXT_EMPTY);
}

fn example_parse_date(subject: &const shared string) -> vector{int}: {
    var out = vector{int}();
    var re = Regex();
    if !re.compile("(\\d{4})-(\\d{2})-(\\d{2})"): {
        return out;
    }
    let hit = re.match_text(subject);
    if !hit.matched(): {
        return out;
    }
    out.push_back(parse_int(hit.group(1)));
    out.push_back(parse_int(hit.group(2)));
    out.push_back(parse_int(hit.group(3)));
    return out;
}

fn example_named_groups(subject: &const shared string) -> string: {
    var re = Regex();
    if !re.compile("(?<key>\\w+)\\s*=\\s*(?<value>[^;]+);"): {
        return TEXT_EMPTY;
    }
    return re.replace_all(subject, "${value} -> ${key}\n");
}

fn example_split_csv(subject: &const shared string) -> vector{string}: {
    return quick_split(",\\s*", subject);
}

fn example_repeated_word(subject: &const shared string) -> bool: {
    var re = Regex();
    
    if !re.compile("\\b(\\w+)\\s+\\1\\b"): {
        return false;
    }
    return re.contains(subject);
}

fn example_report(pattern: &const shared string): {
    var re = Regex();
    if !re.compile(pattern): {
        println(re.error_text());
        return;
    }
    println(re.describe());
    println(re.compiler.program.disassemble());
}



fn self_check(): {
    var re = Regex();
    if !re.compile("^(a|b)+c{2,4}[[:digit:]]*$"): {
        panic(re.error_text());
        return;
    }
    assert re.group_count() == 1;
    assert re.program_size() > 0;
    prove re.state_count() > 0;

    let hit = re.match_text("abbacc42");
    if hit.matched(): {
        println(hit.text());
    }
    let pieces = quick_split("\\s+", "one two   three");
    for piece: &const in pieces: {
        println(piece);
    }
    println(quick_replace("[aeiou]", "regular expressions", "*"));
    if quick_match("\\d+", "12345"): {
        println("all digits");
    }
    if example_repeated_word("the the end"): {
        println("repeated word found");
    }
    println(quote_literal("1 + 2 * (3 - 4)"));
}
}











namespace memory: {



static PAGE_SIZE: int = 4096;
static PAGE_SHIFT: int = 12;
static PAGE_MASK: int = 4095;              
static WORD_BITS: int = 64;
static WORD_SHIFT: int = 6;
static WORD_MASK: int = 63;                
static ALL_ONES: int = -1;                 

static MIN_ALIGNMENT: int = 8;
static MAX_ALIGNMENT: int = 4096;
static MIN_BLOCK_SIZE: int = 16;
static MAX_SMALL_SIZE: int = 2048;

static SLAB_TARGET_BLOCKS: int = 64;
static SLAB_MIN_BLOCKS: int = 4;
static SLAB_MAX_BLOCKS: int = 1024;

static ARENA_INITIAL_PAGES: int = 64;
static ARENA_GROWTH_NUMERATOR: int = 3;
static ARENA_GROWTH_DENOMINATOR: int = 2;



static PERMILLE: int = 1000;



static EVICT_THRESHOLD_PERMILLE: int = 125;
static EVICT_KEEP_SLABS: int = 2;


static POISON_FREED: int = 221;            
static POISON_FRESH: int = 205;            
static GUARD_MAGIC: int = 3735928559;      

static INVALID_INDEX: int = -1;



enum BlockState: {
    Free;
    Allocated;
    Split;
    Quarantined = 3;
}

enum SlabState: {
    Fresh;
    Partial;
    Full;
    Retired = 3;
}

enum ClassKind: {
    Tiny;
    Small;
    Medium;
    Large = 3;
}

enum ValidationCode: {
    Ok;
    BitmapCountMismatch;
    OverlappingBlocks;
    UnalignedBase;
    DanglingFreeNode;
    GuardCorrupted;
    OccupancyOutOfRange;
    ClassSizeMismatch = 7;
}

enum RefillOutcome: {
    Reused;
    GrewArena;
    Failed = 2;
}





fn align_up(value: int, alignment: int) -> int: {
    assert alignment > 0;
    let mask = alignment - 1;
    return (value + mask) & ~mask;
}

fn align_down(value: int, alignment: int) -> int: {
    assert alignment > 0;
    let mask = alignment - 1;
    return value & ~mask;
}

fn is_aligned(value: int, alignment: int) -> bool: {
    let mask = alignment - 1;
    return (value & mask) == 0;
}

fn alignment_mask(alignment: int) => alignment - 1;

fn is_power_of_two(value: int) -> bool: {
    if value <= 0: {
        return false;
    }
    return (value & (value - 1)) == 0;
}


fn next_power_of_two(value: int) -> int: {
    var result: int = 1;
    while result < value: {
        result <<= 1;
    }
    return result;
}

fn normalize_alignment(requested: int) -> int: {
    if requested < MIN_ALIGNMENT: {
        return MIN_ALIGNMENT;
    }
    if requested > MAX_ALIGNMENT: {
        return MAX_ALIGNMENT;
    }
    if is_power_of_two(requested): {
        return requested;
    }
    return next_power_of_two(requested);
}

fn page_of(offset: int) => offset >> PAGE_SHIFT;

fn page_base(offset: int) -> int: {
    return offset & ~PAGE_MASK;
}

fn pages_for(bytes: int) -> int: {
    return (bytes + PAGE_MASK) >> PAGE_SHIFT;
}


fn permille_of(part: int, whole: int) -> int: {
    if whole <= 0: {
        return 0;
    }
    return (part * PERMILLE) / whole;
}

fn word_index(bit: int) => bit >> WORD_SHIFT;

fn bit_within_word(bit: int) => bit & WORD_MASK;



fn popcount_word(word: int) -> int: {
    var value = word;
    var count: int = 0;
    while value != 0: {
        value &= value - 1;
        count += 1;
    }
    return count;
}

fn trailing_zeros(word: int) -> int: {
    if word == 0: {
        return WORD_BITS;
    }
    var value = word;
    var count: int = 0;
    while (value & 1) == 0: {
        value >>= 1;
        count += 1;
    }
    return count;
}






struct SizeClass: {

    fn stride_of(self: &const shared) -> int: {
        return .stride;
    }

    fn payload_of(self: &const shared) -> int: {
        return .payload;
    }

    fn waste_per_block(self: &const shared) -> int: {
        return .stride - .payload;
    }

    fn waste_permille(self: &const shared) -> int: {
        return permille_of(.waste_per_block(), .stride);
    }

    fn slab_bytes(self: &const shared) -> int: {
        return align_up(.stride * .blocks_per_slab, PAGE_SIZE);
    }

    fn slab_pages(self: &const shared) -> int: {
        return pages_for(.stride * .blocks_per_slab);
    }

    fn accepts(self: &const shared, bytes: int, alignment: int) -> bool: {
        if bytes > .payload: {
            return false;
        }
        return alignment <= .alignment;
    }

    fn describe(self: &const shared) -> string: {
        var text = to_string(.index);
        text.append(": ");
        text.append(to_string(.payload));
        text.append(" bytes, stride ");
        text.append(to_string(.stride));
        return text;
    }

    index: int = 0;
    payload: int = 0;
    stride: int = 0;
    alignment: int = 8;
    blocks_per_slab: int = 0;
    kind: ClassKind = ClassKind::Tiny;
}



struct SizeClassTable: {

    fn count(self: &const shared) -> int: {
        return .classes.size();
    }

    fn largest_payload(self: &const shared) -> int: {
        if .classes.empty(): {
            return 0;
        }
        return .classes.back().payload;
    }

    
    
    fn row(self: &const shared, index: int) -> &const[self] SizeClass: {
        assert index >= 0;
        assert index < .classes.size();
        return .classes[index];
    }

    
    
    fn class_for(self: &const shared, bytes: int, alignment: int) -> int: {
        if bytes <= 0: {
            return INVALID_INDEX;
        }
        if bytes > MAX_SMALL_SIZE: {
            return INVALID_INDEX;
        }
        var index: int = 0;
        while index < .classes.size(): {
            let candidate: &const shared = .classes[index];
            if candidate.accepts(bytes, alignment): {
                return index;
            }
            index += 1;
        }
        return INVALID_INDEX;
    }

    
    
    fn best_fit(self: &const shared, bytes: int) -> &const[self] SizeClass: {
        var index = .class_for(bytes, MIN_ALIGNMENT);
        if index == INVALID_INDEX: {
            index = .classes.size() - 1;
        }
        return .classes[index];
    }

    fn build(self: &unique): {
        .classes.clear();
        var payload = MIN_BLOCK_SIZE;
        var index: int = 0;
        while payload <= MAX_SMALL_SIZE: {
            var row = SizeClass();
            row.index = index;
            row.payload = payload;
            row.stride = align_up(payload + 8, MIN_ALIGNMENT);
            row.alignment = .alignment_for(payload);
            row.blocks_per_slab = .blocks_for(row.stride);
            row.kind = .kind_for(payload);
            .classes.push_back(row);
            index += 1;
            payload = .next_payload(payload);
        }
        prove .classes.size() == index;
    }

    fn next_payload(self: &const shared, payload: int) -> int: {
        if payload < 128: {
            return payload + 16;
        }
        if payload < 512: {
            return payload + 64;
        }
        return payload * 2;
    }

    fn alignment_for(self: &const shared, payload: int) -> int: {
        if payload <= 32: {
            return 8;
        }
        if payload <= 256: {
            return 16;
        }
        return 64;
    }

    fn kind_for(self: &const shared, payload: int) -> ClassKind: {
        if payload <= 64: {
            return ClassKind::Tiny;
        }
        if payload <= 512: {
            return ClassKind::Small;
        }
        if payload <= MAX_SMALL_SIZE: {
            return ClassKind::Medium;
        }
        return ClassKind::Large;
    }

    fn blocks_for(self: &const shared, stride: int) -> int: {
        var blocks = SLAB_TARGET_BLOCKS;
        if stride * blocks < PAGE_SIZE: {
            blocks = PAGE_SIZE / stride;
        }
        if blocks < SLAB_MIN_BLOCKS: {
            blocks = SLAB_MIN_BLOCKS;
        }
        if blocks > SLAB_MAX_BLOCKS: {
            blocks = SLAB_MAX_BLOCKS;
        }
        return blocks;
    }

    fn total_stride(self: &const shared) -> int: {
        var sum: int = 0;
        for row: &const in .classes: {
            sum += row.stride;
        }
        return sum;
    }

    classes: vector{SizeClass};
}






struct Bitmap: {

    fn bit_count(self: &const shared) -> int: {
        return .bits;
    }

    fn word_count(self: &const shared) -> int: {
        return .words.size();
    }

    fn reset(self: &unique, bits: int): {
        .bits = bits;
        .words.clear();
        .words.resize(word_index(bits + WORD_MASK));
        for word: &unique in .words: {
            *word = 0;
        }
        .set_bits = 0;
        prove .set_bits == 0;
    }

    fn test(self: &const shared, bit: int) -> bool: {
        assert bit >= 0;
        assert bit < .bits;
        let word = .words[word_index(bit)];
        return ((word >> bit_within_word(bit)) & 1) == 1;
    }

    fn mark(self: &unique, bit: int): {
        assert bit < .bits;
        let slot: &unique = .words[word_index(bit)];
        let before = *slot;
        *slot = before | (1 << bit_within_word(bit));
        if *slot != before: {
            .set_bits += 1;
        }
        prove .set_bits <= .bits;
    }

    fn unmark(self: &unique, bit: int): {
        assert bit < .bits;
        let slot: &unique = .words[word_index(bit)];
        let before = *slot;
        *slot = before & ~(1 << bit_within_word(bit));
        if *slot != before: {
            .set_bits -= 1;
        }
        prove .set_bits >= 0;
    }

    
    
    fn find_first_free(self: &const shared) -> int: {
        var index: int = 0;
        while index < .words.size(): {
            let word = .words[index];
            if word != ALL_ONES: {
                let bit = trailing_zeros(~word);
                let absolute = (index << WORD_SHIFT) + bit;
                if absolute < .bits: {
                    return absolute;
                }
            }
            index += 1;
        }
        return INVALID_INDEX;
    }

    
    
    fn find_free_run(self: &const shared, length: int) -> int: {
        var start: int = 0;
        var run: int = 0;
        var index: int = 0;
        while index < .bits: {
            if .test(index): {
                run = 0;
                start = index + 1;
            } else: {
                run += 1;
                if run >= length: {
                    return start;
                }
            }
            index += 1;
        }
        return INVALID_INDEX;
    }

    fn mark_run(self: &unique, start: int, length: int): {
        var index = start;
        while index < start + length: {
            .mark(index);
            index += 1;
        }
    }

    fn unmark_run(self: &unique, start: int, length: int): {
        var index = start;
        while index < start + length: {
            .unmark(index);
            index += 1;
        }
    }

    fn popcount(self: &const shared) -> int: {
        var total: int = 0;
        for word: &const in .words: {
            total += popcount_word(*word);
        }
        return total;
    }

    fn free_count(self: &const shared) -> int: {
        return .bits - .set_bits;
    }

    fn saturated(self: &const shared) -> bool: {
        return .set_bits >= .bits;
    }

    fn drained(self: &const shared) -> bool: {
        return .set_bits == 0;
    }

    
    
    fn counter_is_consistent(self: &const shared) -> bool: {
        return .popcount() == .set_bits;
    }

    fn clone_into(self: &const shared, target: &unique Bitmap): {
        target.reset(.bits);
        var index: int = 0;
        while index < .bits: {
            if .test(index): {
                target.mark(index);
            }
            index += 1;
        }
    }

    words: vector{int};
    bits: int = 0;
    set_bits: int = 0;
}






struct Block: {

    fn end_offset(self: &const shared) -> int: {
        return .offset + .size;
    }

    fn contains(self: &const shared, address: int) -> bool: {
        if address < .offset: {
            return false;
        }
        return address < .end_offset();
    }

    fn adjacent_to(self: &const shared, other: &const shared Block) -> bool: {
        if .end_offset() == other.offset: {
            return true;
        }
        return other.end_offset() == .offset;
    }

    fn is_free(self: &const shared) -> bool: {
        return .state == BlockState::Free;
    }

    fn guard_is_intact(self: &const shared) -> bool: {
        return .guard == GUARD_MAGIC;
    }

    fn stamp_guard(self: &unique): {
        .guard = GUARD_MAGIC;
    }

    fn absorb(self: &unique, other: &unique const Block): {
        assert .adjacent_to(other);
        if other.offset < .offset: {
            .offset = other.offset;
        }
        .size += other.size;
        .next = other.next;
    }

    offset: int = 0;
    size: int = 0;
    state: BlockState = BlockState::Free;
    class_index: int = INVALID_INDEX;
    slab_index: int = INVALID_INDEX;
    prev: int = INVALID_INDEX;
    next: int = INVALID_INDEX;
    guard: int = 0;
}




struct FreeList: {

    fn size(self: &const shared) -> int: {
        return .nodes.size();
    }

    fn empty(self: &const shared) -> bool: {
        return .nodes.empty();
    }

    fn total_bytes(self: &const shared) -> int: {
        var sum: int = 0;
        for node: &const in .nodes: {
            sum += node.size;
        }
        return sum;
    }

    fn largest_block(self: &const shared) -> int: {
        var best: int = 0;
        for node: &const in .nodes: {
            if node.size > best: {
                best = node.size;
            }
        }
        return best;
    }

    
    
    fn node_at(self: &shared, index: int) -> &shared[self] Block: {
        assert index >= 0;
        assert index < .nodes.size();
        return .nodes[index];
    }

    
    fn node_mut(self: &unique, index: int) -> &unique[self] Block: {
        assert index < .nodes.size();
        return .nodes[index];
    }

    
    
    fn head(self: &shared) -> &shared[unique self] Block: {
        assert .nodes.empty() == false;
        return .nodes.front();
    }

    fn tail(self: &shared) -> &shared[unique self] Block: {
        assert .nodes.empty() == false;
        return .nodes.back();
    }

    fn insertion_point(self: &const shared, offset: int) -> int: {
        var index: int = 0;
        while index < .nodes.size(): {
            let node: &const shared = .nodes[index];
            if node.offset > offset: {
                return index;
            }
            index += 1;
        }
        return .nodes.size();
    }

    fn push_sorted(self: &unique, block: Block): {
        let at = .insertion_point(block.offset);
        .nodes.insert(at, block);
        .bytes += block.size;
        prove .bytes >= 0;
    }

    fn push_back_raw(self: &unique, block: Block): {
        .bytes += block.size;
        .nodes.push_back(block);
    }

    fn pop_front(self: &unique) -> Block: {
        assert .nodes.empty() == false;
        var result = .nodes.front();
        .bytes -= result.size;
        .nodes.erase(0);
        return move(result);
    }

    fn remove_at(self: &unique, index: int) -> Block: {
        assert index < .nodes.size();
        var result = .nodes[index];
        .bytes -= result.size;
        .nodes.erase(index);
        return move(result);
    }

    
    
    fn find_fit(self: &const shared, bytes: int, alignment: int) -> int: {
        var index: int = 0;
        while index < .nodes.size(): {
            let node: &const shared = .nodes[index];
            if node.is_free(): {
                let aligned = align_up(node.offset, alignment);
                let overhead = aligned - node.offset;
                if node.size >= bytes + overhead: {
                    return index;
                }
            }
            index += 1;
        }
        return INVALID_INDEX;
    }

    
    fn find_best(self: &const shared, bytes: int) -> int: {
        var best = INVALID_INDEX;
        var best_size: int = 0;
        var index: int = 0;
        while index < .nodes.size(): {
            let node: &const shared = .nodes[index];
            if node.is_free() && node.size >= bytes: {
                if best == INVALID_INDEX || node.size < best_size: {
                    best = index;
                    best_size = node.size;
                }
            }
            index += 1;
        }
        return best;
    }

    
    
    
    fn split_at(self: &unique, index: int, bytes: int) -> Block: {
        var node = .remove_at(index);
        let leftover = node.size - bytes;
        if leftover >= MIN_BLOCK_SIZE: {
            var remainder = Block();
            remainder.offset = node.offset + bytes;
            remainder.size = leftover;
            remainder.state = BlockState::Free;
            remainder.slab_index = node.slab_index;
            remainder.class_index = node.class_index;
            remainder.stamp_guard();
            node.size = bytes;
            .push_sorted(remainder);
        }
        node.state = BlockState::Allocated;
        return move(node);
    }

    
    
    
    fn coalesce(self: &unique) -> int: {
        if .nodes.size() < 2: {
            return 0;
        }
        var merged: int = 0;
        var index: int = 0;
        while index + 1 < .nodes.size(): {
            let left: &const shared = .nodes[index];
            let right: &const shared = .nodes[index + 1];
            var can_merge = left.is_free() && right.is_free();
            if can_merge: {
                can_merge = left.end_offset() == right.offset;
            }
            if can_merge: {
                can_merge = left.slab_index == right.slab_index;
            }
            if can_merge: {
                var absorbed = .remove_at(index + 1);
                let target: &unique = .nodes[index];
                target.size += absorbed.size;
                target.next = absorbed.next;
                .bytes += absorbed.size;
                destroy absorbed;
                merged += 1;
            } else: {
                index += 1;
            }
        }
        .merge_events += merged;
        prove .merge_events >= merged;
        return merged;
    }

    
    fn evict_slab(self: &unique, slab_index: int) -> int: {
        var removed: int = 0;
        var index: int = 0;
        while index < .nodes.size(): {
            let node: &const shared = .nodes[index];
            if node.slab_index == slab_index: {
                var dead = .remove_at(index);
                discard dead;
                removed += 1;
            } else: {
                index += 1;
            }
        }
        return removed;
    }

    fn quarantine(self: &unique, index: int): {
        let node: &unique = .nodes[index];
        node.state = BlockState::Quarantined;
        .quarantined += 1;
    }

    fn release_quarantine(self: &unique) -> int: {
        var released: int = 0;
        for node: &unique in .nodes: {
            if node.state == BlockState::Quarantined: {
                node.state = BlockState::Free;
                released += 1;
            }
        }
        .quarantined -= released;
        prove .quarantined >= 0;
        return released;
    }

    fn clear(self: &unique): {
        .nodes.clear();
        .bytes = 0;
        .quarantined = 0;
    }

    nodes: vector{Block};
    bytes: int = 0;
    quarantined: int = 0;
    merge_events: int = 0;
}






struct Slab: {

    fn block_count(self: &const shared) -> int: {
        return .blocks;
    }

    fn free_count(self: &const shared) -> int: {
        return .blocks - .used;
    }

    fn used_count(self: &const shared) -> int: {
        return .used;
    }

    fn is_empty(self: &const shared) -> bool: {
        return .used == 0;
    }

    fn is_full(self: &const shared) -> bool: {
        return .used >= .blocks;
    }

    fn base(self: &const shared) -> int: {
        return .base_offset;
    }

    fn limit(self: &const shared) -> int: {
        return .base_offset + .blocks * .stride;
    }

    fn owns(self: &const shared, offset: int) -> bool: {
        if offset < .base_offset: {
            return false;
        }
        return offset < .limit();
    }

    fn block_index_of(self: &const shared, offset: int) -> int: {
        assert .owns(offset);
        return (offset - .base_offset) / .stride;
    }

    fn offset_of_block(self: &const shared, index: int) -> int: {
        assert index >= 0;
        assert index < .blocks;
        return .base_offset + index * .stride;
    }

    fn occupancy_permille(self: &const shared) -> int: {
        return permille_of(.used, .blocks);
    }

    fn bytes_live(self: &const shared) -> int: {
        return .used * .payload;
    }

    fn bytes_reserved(self: &const shared) -> int: {
        return .blocks * .stride;
    }

    fn internal_waste(self: &const shared) -> int: {
        return .used * (.stride - .payload);
    }

    
    
    fn map(self: &shared) -> &shared[unique self] Bitmap: {
        return .bitmap;
    }

    
    fn map_mut(self: &unique) -> &unique[self] Bitmap: {
        return .bitmap;
    }

    fn recycled(self: &shared) -> &shared[unique self] FreeList: {
        return .local_free;
    }

    fn initialize(self: &unique, base: int, row: &const shared SizeClass, index: int): {
        .base_offset = align_up(base, row.alignment);
        .stride = row.stride;
        .payload = row.payload;
        .alignment = row.alignment;
        .class_index = row.index;
        .slab_index = index;
        .blocks = row.blocks_per_slab;
        .used = 0;
        .state = SlabState::Fresh;
        .bitmap.reset(.blocks);
        .local_free.clear();
        assert is_aligned(.base_offset, .alignment);
        prove .used <= .blocks;
    }

    
    
    fn take_block(self: &unique) -> int: {
        if .is_full(): {
            return INVALID_INDEX;
        }
        if .local_free.empty() == false: {
            var recycled_block = .local_free.pop_front();
            let offset = recycled_block.offset;
            let index = .block_index_of(offset);
            .bitmap.mark(index);
            .used += 1;
            .hits += 1;
            destroy recycled_block;
            return offset;
        }
        let index = .bitmap.find_first_free();
        if index == INVALID_INDEX: {
            .state = SlabState::Full;
            return INVALID_INDEX;
        }
        .bitmap.mark(index);
        .used += 1;
        .misses += 1;
        if .is_full(): {
            .state = SlabState::Full;
        } else: {
            .state = SlabState::Partial;
        }
        prove .used <= .blocks;
        return .offset_of_block(index);
    }

    
    fn take_run(self: &unique, count: int) -> int: {
        if .free_count() < count: {
            return INVALID_INDEX;
        }
        let start = .bitmap.find_free_run(count);
        if start == INVALID_INDEX: {
            return INVALID_INDEX;
        }
        .bitmap.mark_run(start, count);
        .used += count;
        prove .used <= .blocks;
        return .offset_of_block(start);
    }

    fn give_block(self: &unique, offset: int): {
        assert .owns(offset);
        let index = .block_index_of(offset);
        if .bitmap.test(index) == false: {
            panic("double free detected in slab");
            return;
        }
        .bitmap.unmark(index);
        .used -= 1;
        if .used == 0: {
            .state = SlabState::Fresh;
        } else: {
            .state = SlabState::Partial;
        }
        prove .used >= 0;
    }

    
    
    fn defer_block(self: &unique, offset: int): {
        assert .owns(offset);
        var node = Block();
        node.offset = offset;
        node.size = .stride;
        node.state = BlockState::Free;
        node.slab_index = .slab_index;
        node.class_index = .class_index;
        node.stamp_guard();
        .bitmap.unmark(.block_index_of(offset));
        .used -= 1;
        .local_free.push_sorted(node);
        prove .used >= 0;
    }

    fn give_run(self: &unique, offset: int, count: int): {
        let start = .block_index_of(offset);
        .bitmap.unmark_run(start, count);
        .used -= count;
        prove .used >= 0;
    }

    fn drain_local(self: &unique) -> int: {
        let merged = .local_free.coalesce();
        .local_free.clear();
        return merged;
    }

    fn retire(self: &unique): {
        assert .is_empty();
        .state = SlabState::Retired;
        .local_free.clear();
        .bitmap.reset(0);
        .blocks = 0;
    }

    fn should_evict(self: &const shared) -> bool: {
        if .state == SlabState::Retired: {
            return false;
        }
        if .is_empty(): {
            return true;
        }
        return .occupancy_permille() < EVICT_THRESHOLD_PERMILLE;
    }

    fn hit_ratio_permille(self: &const shared) -> int: {
        return permille_of(.hits, .hits + .misses);
    }

    fn describe(self: &const shared) -> string: {
        var text = "slab ";
        text.append(to_string(.slab_index));
        text.append(" class ");
        text.append(to_string(.class_index));
        text.append(" used ");
        text.append(to_string(.used));
        text.append("/");
        text.append(to_string(.blocks));
        return text;
    }

    bitmap: Bitmap;
    local_free: FreeList;
    base_offset: int = 0;
    stride: int = 0;
    payload: int = 0;
    alignment: int = 8;
    blocks: int = 0;
    used: int = 0;
    class_index: int = INVALID_INDEX;
    slab_index: int = INVALID_INDEX;
    state: SlabState = SlabState::Fresh;
    hits: int = 0;
    misses: int = 0;
}

}








































namespace trie: {




enum TrieOutcome: {
    Inserted;
    Replaced;
    Rejected;
    Overflowed = 3;
}


enum NodeKind: {
    Branch;
    Terminal;
    Compressed;
    Pruned = 3;
}


enum EdgeAction: {
    NoAction;
    LabelSplit;
    LabelMerged;
    ChildAdopted;
    EdgeRemoved = 4;
}


enum MatchKind: {
    ExactMatch;
    PrefixMatch;
    FuzzyMatch;
    NoMatch = 3;
}


enum RankOrder: {
    ByWeightDescending;
    ByWeightAscending;
    Lexicographic;
    ByDepth = 3;
}


enum SerialTag: {
    TagEmpty;
    TagBranch;
    TagLeaf;
    TagEdge;
    TagPayload = 4;
}


enum WalkState: {
    Continue;
    Skip;
    Stop = 2;
}


enum TernaryLink: {
    LowLink;
    EqualLink;
    HighLink = 2;
}




static TRIE_NIL: int = -1;


static ALPHABET_LOWER: int = 26;
static ALPHABET_ASCII: int = 128;
static ALPHABET_BYTE: int = 256;


static TRIE_INITIAL_CAPACITY: int = 64;



static TRIE_GROWTH_PERCENT: int = 200;



static TRIE_MAX_DEPTH: int = 256;



static TRIE_MAX_KEY_LENGTH: int = 192;


static WEIGHT_SCALE: int = 1000;


static WEIGHT_DEFAULT: int = 1000;



static WEIGHT_FLOOR: int = 1;


static WEIGHT_DECAY_PERCENT: int = 90;


static SCORE_EXACT_BONUS: int = 5000;


static SCORE_EDIT_PENALTY: int = 1200;



static SCORE_LENGTH_PENALTY: int = 40;


static DEFAULT_TOP_K: int = 8;


static MAX_TOP_K: int = 64;


static DEFAULT_EDIT_BUDGET: int = 2;



static MAX_EDIT_BUDGET: int = 4;


static TRIE_SAMPLE_LIMIT: int = 8;



static RADIX_MIN_LABEL: int = 1;


static FANOUT_BUCKETS: int = 9;





static CHAR_NUL: char = '\0';
static CHAR_TAB: char = '\t';
static CHAR_NEWLINE: char = '\n';
static CHAR_RETURN: char = '\r';
static CHAR_SPACE: char = ' ';
static CHAR_MINUS: char = '-';
static CHAR_UNDERSCORE: char = '_';
static CHAR_DOT: char = '.';
static CHAR_SLASH: char = '/';
static CHAR_STAR: char = '*';
static CHAR_QUESTION: char = '?';
static CHAR_HASH: char = '#';
static CHAR_ZERO: char = '0';
static CHAR_NINE: char = '9';
static CHAR_LOWER_A: char = 'a';
static CHAR_LOWER_Z: char = 'z';
static CHAR_UPPER_A: char = 'A';
static CHAR_UPPER_Z: char = 'Z';



static APOSTROPHE: string = "'";



static SERIAL_TERMINATOR: char = '\0';





fn is_lower(c: char) -> bool: {
    return c >= CHAR_LOWER_A && c <= CHAR_LOWER_Z;
}

fn is_upper(c: char) -> bool: {
    return c >= CHAR_UPPER_A && c <= CHAR_UPPER_Z;
}

fn is_digit(c: char) -> bool: {
    return c >= CHAR_ZERO && c <= CHAR_NINE;
}

fn is_letter(c: char) -> bool: {
    return is_lower(c) || is_upper(c);
}


fn is_word_char(c: char) -> bool: {
    if is_letter(c): {
        return true;
    }
    if is_digit(c): {
        return true;
    }
    if c == CHAR_UNDERSCORE: {
        return true;
    }
    if c == CHAR_MINUS: {
        return true;
    }
    return false;
}

fn is_space(c: char) -> bool: {
    if c == CHAR_SPACE: {
        return true;
    }
    if c == CHAR_TAB: {
        return true;
    }
    if c == CHAR_NEWLINE: {
        return true;
    }
    if c == CHAR_RETURN: {
        return true;
    }
    return false;
}


fn to_lower(c: char) -> char: {
    if is_upper(c): {
        return c + (CHAR_LOWER_A - CHAR_UPPER_A);
    }
    return c;
}

fn to_upper(c: char) -> char: {
    if is_lower(c): {
        return c - (CHAR_LOWER_A - CHAR_UPPER_A);
    }
    return c;
}








template(ALPHABET: int)
fn slot_of(c: char) -> int: {
    if ALPHABET == 26: {
        if is_lower(c): {
            return c - CHAR_LOWER_A;
        }
        if is_upper(c): {
            return to_lower(c) - CHAR_LOWER_A;
        }
        return TRIE_NIL;
    }
    if c < 0: {
        return TRIE_NIL;
    }
    if c >= ALPHABET: {
        return TRIE_NIL;
    }
    return c;
}



template(ALPHABET: int)
fn char_of_slot(slot: int) -> char: {
    if ALPHABET == 26: {
        return CHAR_LOWER_A + slot;
    }
    return slot;
}


template(ALPHABET: int)
fn in_alphabet(c: char) -> bool: {
    return slot_of{ALPHABET}(c) != TRIE_NIL;
}




template(ALPHABET: int)
fn normalize_key(key: &const shared string) -> pair{string, int}: {
    var out = string();
    var dropped: int = 0;
    var index: int = 0;
    while index < key.size(): {
        let c = to_lower(key.at(index));
        if in_alphabet{ALPHABET}(c): {
            out.push_back(c);
        } else: {
            dropped += 1;
        }
        index += 1;
    }
    return pair{string, int}(first: out, second: dropped);
}




fn common_prefix_length(a: &const shared string, b: &const shared string) -> int: {
    var index: int = 0;
    let limit = min(a.size(), b.size());
    while index < limit: {
        if a.at(index) != b.at(index): {
            return index;
        }
        index += 1;
    }
    return limit;
}


fn starts_with(whole: &const shared string, prefix: &const shared string) -> bool: {
    if prefix.size() > whole.size(): {
        return false;
    }
    return common_prefix_length(whole, prefix) == prefix.size();
}



fn compare_strings(a: &const shared string, b: &const shared string) -> int: {
    let shared_len = common_prefix_length(a, b);
    if shared_len < a.size() && shared_len < b.size(): {
        if a.at(shared_len) < b.at(shared_len): {
            return -1;
        }
        return 1;
    }
    if a.size() < b.size(): {
        return -1;
    }
    if a.size() > b.size(): {
        return 1;
    }
    return 0;
}


fn concat(a: &const shared string, b: &const shared string) -> string: {
    var out = string();
    out.append(a);
    out.append(b);
    return out;
}


fn push_char(text: &const shared string, c: char) -> string: {
    var out = string();
    out.append(text);
    out.push_back(c);
    return out;
}



fn tokenize(text: &const shared string) -> vector{string}: {
    var out = vector{string}();
    var current = string();
    var index: int = 0;
    while index < text.size(): {
        let c = to_lower(text.at(index));
        if is_word_char(c): {
            current.push_back(c);
        } else: {
            if current.size() > 0: {
                out.push_back(current);
                current.clear();
            }
        }
        index += 1;
    }
    if current.size() > 0: {
        out.push_back(current);
    }
    destroy current;
    return out;
}











template(V: type, ALPHABET: int)
struct TrieNode: {

    

    fn width(self: &const shared) -> int: {
        return ALPHABET;
    }

    fn is_terminal(self: &const shared) -> bool: {
        return .terminal;
    }

    fn is_leaf(self: &const shared) -> bool: {
        return .degree() == 0;
    }

    
    fn dense_degree(self: &const shared) -> int: {
        var found: int = 0;
        var slot: int = 0;
        while slot < ALPHABET: {
            if .children[slot] != TRIE_NIL: {
                found += 1;
            }
            slot += 1;
        }
        return found;
    }

    fn sparse_degree(self: &const shared) -> int: {
        return .overflow.size();
    }

    fn degree(self: &const shared) -> int: {
        return .dense_degree() + .sparse_degree();
    }

    
    fn prunable(self: &const shared) -> bool: {
        if .terminal: {
            return false;
        }
        return .degree() == 0;
    }

    

    
    
    fn child_for(self: &const shared, c: char) -> int: {
        let slot = slot_of{ALPHABET}(c);
        if slot != TRIE_NIL: {
            return .children[slot];
        }
        if .overflow.contains(c): {
            return .overflow.at(c);
        }
        return TRIE_NIL;
    }

    fn child_at_slot(self: &const shared, slot: int) -> int: {
        if slot < 0: {
            return TRIE_NIL;
        }
        if slot >= ALPHABET: {
            return TRIE_NIL;
        }
        return .children[slot];
    }

    
    
    fn attach(self: &unique, c: char, node: int) -> bool: {
        let slot = slot_of{ALPHABET}(c);
        if slot != TRIE_NIL: {
            let existed = .children[slot] != TRIE_NIL;
            .children[slot] = node;
            if !existed: {
                .live_children += 1;
            }
            return !existed;
        }
        let fresh = !.overflow.contains(c);
        discard .overflow.insert(c, node);
        if fresh: {
            .live_children += 1;
        }
        return fresh;
    }

    
    fn detach(self: &unique, c: char) -> bool: {
        let slot = slot_of{ALPHABET}(c);
        if slot != TRIE_NIL: {
            if .children[slot] == TRIE_NIL: {
                return false;
            }
            .children[slot] = TRIE_NIL;
            .live_children -= 1;
            return true;
        }
        if !.overflow.contains(c): {
            return false;
        }
        discard .overflow.erase(c);
        .live_children -= 1;
        return true;
    }

    
    
    fn edges(self: &const shared) -> vector{pair{char, int}}: {
        var out = vector{pair{char, int}}();
        var slot: int = 0;
        while slot < ALPHABET: {
            if .children[slot] != TRIE_NIL: {
                out.push_back(pair{char, int}(first: char_of_slot{ALPHABET}(slot),
                                              second: .children[slot]));
            }
            slot += 1;
        }
        for entry: &const in .overflow: {
            out.push_back(pair{char, int}(first: entry.first, second: entry.second));
        }
        return out;
    }

    
    fn next_slot(self: &const shared, from: int) -> int: {
        var slot = from;
        while slot < ALPHABET: {
            if .children[slot] != TRIE_NIL: {
                return slot;
            }
            slot += 1;
        }
        return TRIE_NIL;
    }

    

    
    
    fn reset(self: &unique): {
        var slot: int = 0;
        while slot < ALPHABET: {
            .children[slot] = TRIE_NIL;
            slot += 1;
        }
        .overflow.clear();
        .terminal = false;
        .weight = 0;
        .subtree_weight = 0;
        .subtree_keys = 0;
        .live_children = 0;
        .parent = TRIE_NIL;
        .edge_char = CHAR_NUL;
        .depth = 0;
        .kind = NodeKind::Branch;
    }

    
    
    fn initialize(self: &unique, parent: int, edge: char, depth: int): {
        .children.resize(ALPHABET);
        var slot: int = 0;
        while slot < ALPHABET: {
            .children[slot] = TRIE_NIL;
            slot += 1;
        }
        .parent = parent;
        .edge_char = edge;
        .depth = depth;
        .kind = NodeKind::Branch;
        .live = true;
    }

    fn mark_terminal(self: &unique, value: V, weight: int): {
        .payload = value;
        .weight = weight;
        .terminal = true;
        .kind = NodeKind::Terminal;
    }

    fn clear_terminal(self: &unique): {
        .terminal = false;
        .weight = 0;
        .kind = NodeKind::Branch;
    }

    
    children: vector{int};

    
    overflow: map{char, int};

    
    payload: V;

    
    
    weight: int = 0;
    subtree_weight: int = 0;
    subtree_keys: int = 0;

    live_children: int = 0;
    parent: int = -1;
    edge_char: char = '\0';
    depth: int = 0;
    terminal: bool = false;
    live: bool = false;
    kind: NodeKind = NodeKind::Branch;
}




template(V: type)
struct Completion: {

    fn better_than(self: &const shared, other: &const shared Completion{V}) -> bool: {
        if .score != other.score: {
            return .score > other.score;
        }
        return compare_strings(.key, other.key) < 0;
    }

    fn describe(self: &const shared) -> string: {
        var text = string();
        text.append(.key);
        text.append(" score=");
        text.append(to_string(.score));
        text.append(" edits=");
        text.append(to_string(.edits));
        return text;
    }

    key: string;
    value: V;
    score: int = 0;
    weight: int = 0;
    edits: int = 0;
    node: int = -1;
    kind: MatchKind = MatchKind::NoMatch;
}


template(V: type)
struct WalkResult: {

    fn complete(self: &const shared) -> bool: {
        return .consumed == .requested;
    }

    fn describe(self: &const shared) -> string: {
        var text = string();
        text.append("consumed=");
        text.append(to_string(.consumed));
        text.append(" of ");
        text.append(to_string(.requested));
        return text;
    }

    
    payload: V;

    node: int = -1;
    consumed: int = 0;
    requested: int = 0;
    last_terminal: int = -1;
    last_terminal_length: int = 0;
    kind: MatchKind = MatchKind::NoMatch;
}









template(V: type, ALPHABET: int)
struct Trie: {

    

    fn size(self: &const shared) -> int: {
        return .count;
    }

    fn empty(self: &const shared) -> bool: {
        return .count == 0;
    }

    fn node_count(self: &const shared) -> int: {
        return .nodes.size() - .free_count;
    }

    fn alphabet_width(self: &const shared) -> int: {
        return ALPHABET;
    }

    fn root_index(self: &const shared) -> int: {
        return .root;
    }

    
    
    fn node_at(self: &shared, index: int) -> &shared[self] TrieNode{V, ALPHABET}: {
        return .nodes[index];
    }

    

    fn reserve(self: &unique, capacity: int): {
        .nodes.reserve(capacity);
    }

    
    
    fn ensure_root(self: &unique): {
        if .root != TRIE_NIL: {
            return;
        }
        .nodes.push_back(TrieNode{V, ALPHABET}());
        .root = .nodes.size() - 1;
        .nodes[.root].initialize(TRIE_NIL, CHAR_NUL, 0);
    }

    
    fn allocate_node(self: &unique, parent: int, edge: char, depth: int) -> int: {
        if .free_list != TRIE_NIL: {
            let recycled = .free_list;
            .free_list = .nodes[recycled].parent;
            .free_count -= 1;
            .nodes[recycled].reset();
            .nodes[recycled].initialize(parent, edge, depth);
            .allocations += 1;
            return recycled;
        }
        .nodes.push_back(TrieNode{V, ALPHABET}());
        let fresh = .nodes.size() - 1;
        .nodes[fresh].initialize(parent, edge, depth);
        .allocations += 1;
        return fresh;
    }

    
    
    fn release_node(self: &unique, index: int): {
        if index == .root: {
            return;
        }
        .nodes[index].reset();
        .nodes[index].live = false;
        .nodes[index].kind = NodeKind::Pruned;
        .nodes[index].parent = .free_list;
        .free_list = index;
        .free_count += 1;
        .releases += 1;
    }

    

    
    
    
    
    fn insert(self: &unique, key: &const shared string, value: V, weight: int) -> TrieOutcome: {
        if key.size() == 0: {
            return TrieOutcome::Rejected;
        }
        if key.size() > TRIE_MAX_KEY_LENGTH: {
            return TrieOutcome::Rejected;
        }
        .ensure_root();

        var current = .root;
        var index: int = 0;
        while index < key.size(): {
            let c = key.at(index);
            var next = .nodes[current].child_for(c);
            if next == TRIE_NIL: {
                next = .allocate_node(current, c, index + 1);
                discard .nodes[current].attach(c, next);
                .edges_created += 1;
            }
            current = next;
            index += 1;
        }

        let was_terminal = .nodes[current].terminal;
        .nodes[current].mark_terminal(value, weight);
        if was_terminal: {
            .replacements += 1;
            .refresh_path(current);
            return TrieOutcome::Replaced;
        }
        .count += 1;
        .refresh_path(current);
        return TrieOutcome::Inserted;
    }

    
    fn add(self: &unique, key: &const shared string, value: V) -> TrieOutcome: {
        return .insert(key, value, WEIGHT_DEFAULT);
    }

    
    
    fn insert_all(self: &unique, entries: &const shared vector{pair{string, V}}) -> int: {
        var added: int = 0;
        for entry: &const in entries: {
            if .insert(entry.first, entry.second, WEIGHT_DEFAULT) == TrieOutcome::Inserted: {
                added += 1;
            }
        }
        return added;
    }

    
    
    fn insert_weighted(self: &unique,
                       entries: &const shared vector{pair{string, pair{V, int}}}) -> int: {
        var added: int = 0;
        for entry: &const in entries: {
            let outcome = .insert(entry.first, entry.second.first, entry.second.second);
            if outcome == TrieOutcome::Inserted: {
                added += 1;
            }
        }
        return added;
    }

    
    
    
    fn refresh_path(self: &unique, node: int): {
        var current = node;
        var guard: int = 0;
        while current != TRIE_NIL && guard < TRIE_MAX_DEPTH: {
            .recompute_node(current);
            current = .nodes[current].parent;
            guard += 1;
        }
    }

    
    fn recompute_node(self: &unique, node: int): {
        var best = 0;
        var keys = 0;
        if .nodes[node].terminal: {
            best = .nodes[node].weight;
            keys = 1;
        }
        var edges = .nodes[node].edges();
        for edge: &const in edges: {
            let child = edge.second;
            if .nodes[child].subtree_weight > best: {
                best = .nodes[child].subtree_weight;
            }
            keys += .nodes[child].subtree_keys;
        }
        destroy edges;
        .nodes[node].subtree_weight = best;
        .nodes[node].subtree_keys = keys;
    }

    

    
    
    
    fn walk(self: &const shared, key: &const shared string) -> WalkResult{V}: {
        var result = WalkResult{V}();
        result.requested = key.size();
        if .root == TRIE_NIL: {
            return result;
        }

        var current = .root;
        var index: int = 0;
        while index < key.size(): {
            let next = .nodes[current].child_for(key.at(index));
            if next == TRIE_NIL: {
                result.node = current;
                result.consumed = index;
                result.kind = MatchKind::NoMatch;
                return result;
            }
            current = next;
            index += 1;
            if .nodes[current].terminal: {
                result.last_terminal = current;
                result.last_terminal_length = index;
            }
        }

        result.node = current;
        result.consumed = key.size();
        if .nodes[current].terminal: {
            result.kind = MatchKind::ExactMatch;
            result.payload = .nodes[current].payload;
        } else: {
            result.kind = MatchKind::PrefixMatch;
        }
        return result;
    }

    
    fn find_node(self: &const shared, key: &const shared string) -> int: {
        let result = .walk(key);
        if result.consumed != key.size(): {
            return TRIE_NIL;
        }
        return result.node;
    }

    fn contains(self: &const shared, key: &const shared string) -> bool: {
        let node = .find_node(key);
        if node == TRIE_NIL: {
            return false;
        }
        return .nodes[node].terminal;
    }

    
    fn contains_prefix(self: &const shared, prefix: &const shared string) -> bool: {
        return .find_node(prefix) != TRIE_NIL;
    }

    
    
    fn at(self: &shared, key: &const shared string) -> &shared[self] V: {
        let node = .find_node(key);
        if node == TRIE_NIL: {
            return .missing;
        }
        if !.nodes[node].terminal: {
            return .missing;
        }
        return .nodes[node].payload;
    }

    
    fn weight_of(self: &const shared, key: &const shared string) -> int: {
        let node = .find_node(key);
        if node == TRIE_NIL: {
            return 0;
        }
        return .nodes[node].weight;
    }

    
    fn bump(self: &unique, key: &const shared string, delta: int) -> bool: {
        let node = .find_node(key);
        if node == TRIE_NIL: {
            return false;
        }
        if !.nodes[node].terminal: {
            return false;
        }
        .nodes[node].weight += delta;
        if .nodes[node].weight < WEIGHT_FLOOR: {
            .nodes[node].weight = WEIGHT_FLOOR;
        }
        .refresh_path(node);
        return true;
    }

    

    
    
    fn longest_matching_prefix(self: &const shared, text: &const shared string) -> pair{string, int}: {
        let result = .walk(text);
        if result.last_terminal == TRIE_NIL: {
            return pair{string, int}(first: string(), second: 0);
        }
        return pair{string, int}(first: text.substr(0, result.last_terminal_length),
                                 second: result.last_terminal);
    }

    
    
    fn longest_common_prefix(self: &const shared) -> string: {
        var out = string();
        if .root == TRIE_NIL: {
            return out;
        }
        var current = .root;
        var guard: int = 0;
        while guard < TRIE_MAX_DEPTH: {
            if .nodes[current].terminal: {
                return out;
            }
            var edges = .nodes[current].edges();
            if edges.size() != 1: {
                destroy edges;
                return out;
            }
            out.push_back(edges[0].first);
            current = edges[0].second;
            destroy edges;
            guard += 1;
        }
        return out;
    }

    
    
    fn extend_unambiguously(self: &const shared, prefix: &const shared string) -> string: {
        var out = string();
        out.append(prefix);
        let start = .find_node(prefix);
        if start == TRIE_NIL: {
            return out;
        }
        var current = start;
        var guard: int = 0;
        while guard < TRIE_MAX_DEPTH: {
            if .nodes[current].terminal: {
                return out;
            }
            var edges = .nodes[current].edges();
            if edges.size() != 1: {
                destroy edges;
                return out;
            }
            out.push_back(edges[0].first);
            current = edges[0].second;
            destroy edges;
            guard += 1;
        }
        return out;
    }

    
    
    
    
    fn collect_under(self: &const shared, node: int, prefix: &const shared string,
                     limit: int) -> vector{pair{string, V}}: {
        var out = vector{pair{string, V}}();
        if node == TRIE_NIL: {
            return out;
        }
        var stack = vector{pair{int, string}}();
        stack.reserve(TRIE_MAX_DEPTH);
        stack.push_back(pair{int, string}(first: node, second: prefix));

        while stack.size() > 0: {
            let frame = stack.back();
            let here = frame.first;
            var path = frame.second;
            stack.pop_back();

            if .nodes[here].terminal: {
                out.push_back(pair{string, V}(first: path, second: .nodes[here].payload));
                if limit > 0 && out.size() >= limit: {
                    destroy stack;
                    destroy path;
                    return out;
                }
            }

            
            var edges = .nodes[here].edges();
            var index = edges.size() - 1;
            while index >= 0: {
                var child_path = push_char(path, edges[index].first);
                stack.push_back(pair{int, string}(first: edges[index].second,
                                                  second: child_path));
                destroy child_path;
                index -= 1;
            }
            destroy edges;
            destroy path;
        }
        destroy stack;
        return out;
    }

    
    fn keys_with_prefix(self: &const shared, prefix: &const shared string,
                        limit: int) -> vector{pair{string, V}}: {
        let start = .find_node(prefix);
        return .collect_under(start, prefix, limit);
    }

    
    
    fn weighted_with_prefix(self: &const shared,
                            prefix: &const shared string) -> vector{pair{string, pair{V, int}}}: {
        var out = vector{pair{string, pair{V, int}}}();
        var plain = .keys_with_prefix(prefix, 0);
        for entry: &const in plain: {
            let w = .weight_of(entry.first);
            var boxed = pair{V, int}(first: entry.second, second: w);
            out.push_back(pair{string, pair{V, int}}(first: entry.first, second: boxed));
            destroy boxed;
        }
        destroy plain;
        return out;
    }

    
    fn to_pairs(self: &const shared) -> vector{pair{string, V}}: {
        var empty_prefix = string();
        var out = .collect_under(.root, empty_prefix, 0);
        destroy empty_prefix;
        return out;
    }

    
    
    fn group_by_initial(self: &const shared) -> map{char, vector{pair{string, V}}}: {
        var groups = map{char, vector{pair{string, V}}}();
        var entries = .to_pairs();
        for entry: &const in entries: {
            if entry.first.size() == 0: {
                discard entry;
            } else: {
                let initial = entry.first.at(0);
                if !groups.contains(initial): {
                    var bucket = vector{pair{string, V}}();
                    discard groups.insert(initial, bucket);
                    destroy bucket;
                }
                groups.at(initial).push_back(entry);
            }
        }
        destroy entries;
        return groups;
    }

    

    
    
    
    
    
    fn erase(self: &unique, key: &const shared string) -> bool: {
        let node = .find_node(key);
        if node == TRIE_NIL: {
            return false;
        }
        if !.nodes[node].terminal: {
            return false;
        }

        .nodes[node].clear_terminal();
        .count -= 1;
        .prune_from(node);
        return true;
    }

    
    fn prune_from(self: &unique, start: int) -> int: {
        var current = start;
        var pruned: int = 0;
        var guard: int = 0;
        while current != TRIE_NIL && guard < TRIE_MAX_DEPTH: {
            if current == .root: {
                .recompute_node(current);
                return pruned;
            }
            if !.nodes[current].prunable(): {
                .refresh_path(current);
                return pruned;
            }
            let parent = .nodes[current].parent;
            let edge = .nodes[current].edge_char;
            discard .nodes[parent].detach(edge);
            .release_node(current);
            pruned += 1;
            current = parent;
            guard += 1;
        }
        return pruned;
    }

    
    
    fn erase_prefix(self: &unique, prefix: &const shared string) -> int: {
        let start = .find_node(prefix);
        if start == TRIE_NIL: {
            return 0;
        }
        let removed = .release_subtree(start);
        .count -= removed;

        if start == .root: {
            .recompute_node(.root);
            return removed;
        }
        let parent = .nodes[start].parent;
        let edge = .nodes[start].edge_char;
        discard .nodes[parent].detach(edge);
        .release_node(start);
        discard .prune_from(parent);
        return removed;
    }

    
    
    fn release_subtree(self: &unique, start: int) -> int: {
        var removed: int = 0;
        var stack = vector{int}();
        stack.reserve(TRIE_MAX_DEPTH);

        var seed = .nodes[start].edges();
        for edge: &const in seed: {
            stack.push_back(edge.second);
        }
        destroy seed;

        while stack.size() > 0: {
            let here = stack.back();
            stack.pop_back();
            if .nodes[here].terminal: {
                removed += 1;
            }
            var edges = .nodes[here].edges();
            for edge: &const in edges: {
                stack.push_back(edge.second);
            }
            destroy edges;
            .release_node(here);
        }
        destroy stack;

        if .nodes[start].terminal: {
            removed += 1;
            .nodes[start].clear_terminal();
        }
        return removed;
    }

    
    
    fn evict_below(self: &unique, threshold: int) -> int: {
        var doomed = vector{string}();
        var entries = .to_pairs();
        for entry: &const in entries: {
            if .weight_of(entry.first) < threshold: {
                doomed.push_back(entry.first);
            }
        }
        destroy entries;

        var evicted: int = 0;
        for key: &const in doomed: {
            if .erase(key): {
                evicted += 1;
            }
        }
        destroy doomed;
        return evicted;
    }

    
    
    fn decay(self: &unique) -> int: {
        var touched: int = 0;
        var index: int = 0;
        while index < .nodes.size(): {
            if .nodes[index].live && .nodes[index].terminal: {
                var scaled = .nodes[index].weight * WEIGHT_DECAY_PERCENT / 100;
                if scaled < WEIGHT_FLOOR: {
                    scaled = WEIGHT_FLOOR;
                }
                .nodes[index].weight = scaled;
                touched += 1;
            }
            index += 1;
        }
        if .root != TRIE_NIL: {
            .rebuild_aggregates();
        }
        return touched;
    }

    
    
    fn rebuild_aggregates(self: &unique): {
        var order = .post_order();
        for node: &const in order: {
            .recompute_node(node);
        }
        destroy order;
    }

    
    fn post_order(self: &const shared) -> vector{int}: {
        var out = vector{int}();
        if .root == TRIE_NIL: {
            return out;
        }
        var stack = vector{int}();
        stack.push_back(.root);
        while stack.size() > 0: {
            let here = stack.back();
            stack.pop_back();
            out.push_back(here);
            var edges = .nodes[here].edges();
            for edge: &const in edges: {
                stack.push_back(edge.second);
            }
            destroy edges;
        }
        destroy stack;

        
        var low: int = 0;
        var high = out.size() - 1;
        while low < high: {
            swap(out[low], out[high]);
            low += 1;
            high -= 1;
        }
        return out;
    }

    
    fn level_order(self: &const shared) -> vector{vector{int}}: {
        var levels = vector{vector{int}}();
        if .root == TRIE_NIL: {
            return levels;
        }
        var frontier = vector{int}();
        frontier.push_back(.root);
        var depth: int = 0;
        while frontier.size() > 0 && depth < TRIE_MAX_DEPTH: {
            levels.push_back(frontier);
            var next = vector{int}();
            for node: &const in frontier: {
                var edges = .nodes[node].edges();
                for edge: &const in edges: {
                    next.push_back(edge.second);
                }
                destroy edges;
            }
            frontier.clear();
            for node: &const in next: {
                frontier.push_back(node);
            }
            destroy next;
            depth += 1;
        }
        destroy frontier;
        return levels;
    }

    fn height(self: &const shared) -> int: {
        var levels = .level_order();
        let depth = levels.size();
        destroy levels;
        return depth;
    }

    

    fn clear(self: &unique): {
        for node: &unique in .nodes: {
            node.reset();
            node.live = false;
        }
        .nodes.clear();
        .root = TRIE_NIL;
        .free_list = TRIE_NIL;
        .free_count = 0;
        .count = 0;
        .allocations = 0;
        .releases = 0;
        .edges_created = 0;
        .replacements = 0;
    }

    
    fn copy_into(self: &const shared, target: &unique Trie{V, ALPHABET}) -> int: {
        var entries = .weighted_with_prefix(string());
        let added = target.insert_weighted(entries);
        destroy entries;
        return added;
    }

    

    
    
    
    
    
    
    
    fn check_validity(self: &const shared) -> bool: {
        assert .count >= 0;
        assert .free_count >= 0;
        assert ALPHABET > 0;

        if .root == TRIE_NIL: {
            assert .count == 0;
            prove .count == 0;
            return true;
        }

        assert .nodes[.root].parent == TRIE_NIL;
        assert .nodes[.root].depth == 0;
        prove .nodes[.root].depth == 0;

        var terminals: int = 0;
        var order = .post_order();
        for node: &const in order: {
            assert .nodes[node].live;
            if .nodes[node].terminal: {
                terminals += 1;
                assert .nodes[node].weight >= 0;
            }
            if node != .root: {
                let parent = .nodes[node].parent;
                assert parent != TRIE_NIL;
                assert .nodes[parent].child_for(.nodes[node].edge_char) == node;
                assert .nodes[node].depth == .nodes[parent].depth + 1;
                prove .nodes[node].depth == .nodes[parent].depth + 1;
            }
            assert .nodes[node].subtree_keys >= 0;
        }
        destroy order;

        assert terminals == .count;
        prove terminals == .count;

        let measured = .height();
        assert measured <= TRIE_MAX_DEPTH;
        prove measured <= TRIE_MAX_DEPTH;
        return true;
    }

    

    
    nodes: vector{TrieNode{V, ALPHABET}};

    
    
    
    cache: map{string, vector{pair{string, int}}};

    
    pending: vector{pair{string, pair{V, int}}};

    root: int = -1;
    free_list: int = -1;
    free_count: int = 0;
    count: int = 0;
    allocations: int = 0;
    releases: int = 0;
    edges_created: int = 0;
    replacements: int = 0;
    missing: V;
}











template(V: type, ALPHABET: int)
struct RadixNode: {

    fn is_terminal(self: &const shared) -> bool: {
        return .terminal;
    }

    fn degree(self: &const shared) -> int: {
        return .children.size();
    }

    fn is_leaf(self: &const shared) -> bool: {
        return .children.size() == 0;
    }

    fn label_length(self: &const shared) -> int: {
        return .label.size();
    }

    
    
    fn mergeable(self: &const shared) -> bool: {
        if .terminal: {
            return false;
        }
        return .children.size() == 1;
    }

    fn first_char(self: &const shared) -> char: {
        if .label.size() == 0: {
            return CHAR_NUL;
        }
        return .label.at(0);
    }

    fn child_for(self: &const shared, c: char) -> int: {
        if .children.contains(c): {
            return .children.at(c);
        }
        return TRIE_NIL;
    }

    fn attach(self: &unique, c: char, node: int) -> bool: {
        return .children.insert(c, node);
    }

    fn detach(self: &unique, c: char) -> bool: {
        return .children.erase(c);
    }

    
    fn edges(self: &const shared) -> vector{pair{char, int}}: {
        var out = vector{pair{char, int}}();
        for entry: &const in .children: {
            out.push_back(pair{char, int}(first: entry.first, second: entry.second));
        }
        return out;
    }

    fn reset(self: &unique): {
        .label.clear();
        .children.clear();
        .terminal = false;
        .weight = 0;
        .subtree_weight = 0;
        .parent = TRIE_NIL;
        .depth = 0;
        .kind = NodeKind::Compressed;
        .live = false;
    }

    
    label: string;

    
    children: map{char, int};

    payload: V;
    weight: int = 0;
    subtree_weight: int = 0;
    parent: int = -1;
    depth: int = 0;
    terminal: bool = false;
    live: bool = false;
    kind: NodeKind = NodeKind::Compressed;
}


struct EdgeMatch: {

    fn exhausted_label(self: &const shared) -> bool: {
        return .shared_len == .label_len;
    }

    fn exhausted_key(self: &const shared) -> bool: {
        return .shared_len == .key_len;
    }

    fn needs_split(self: &const shared) -> bool: {
        if .shared_len == 0: {
            return false;
        }
        return .shared_len < .label_len;
    }

    shared_len: int = 0;
    label_len: int = 0;
    key_len: int = 0;
    node: int = -1;
    action: EdgeAction = EdgeAction::NoAction;
}







template(V: type, ALPHABET: int)
struct RadixTree: {

    fn size(self: &const shared) -> int: {
        return .count;
    }

    fn empty(self: &const shared) -> bool: {
        return .count == 0;
    }

    fn node_count(self: &const shared) -> int: {
        return .nodes.size() - .free_count;
    }

    fn node_at(self: &shared, index: int) -> &shared[self] RadixNode{V, ALPHABET}: {
        return .nodes[index];
    }

    fn ensure_root(self: &unique): {
        if .root != TRIE_NIL: {
            return;
        }
        .nodes.push_back(RadixNode{V, ALPHABET}());
        .root = .nodes.size() - 1;
        .nodes[.root].live = true;
        .nodes[.root].parent = TRIE_NIL;
        .nodes[.root].depth = 0;
    }

    fn allocate_node(self: &unique, parent: int, label: &const shared string) -> int: {
        if .free_list != TRIE_NIL: {
            let recycled = .free_list;
            .free_list = .nodes[recycled].parent;
            .free_count -= 1;
            .nodes[recycled].reset();
            .nodes[recycled].label.append(label);
            .nodes[recycled].parent = parent;
            .nodes[recycled].live = true;
            return recycled;
        }
        .nodes.push_back(RadixNode{V, ALPHABET}());
        let fresh = .nodes.size() - 1;
        .nodes[fresh].label.append(label);
        .nodes[fresh].parent = parent;
        .nodes[fresh].live = true;
        return fresh;
    }

    fn release_node(self: &unique, index: int): {
        if index == .root: {
            return;
        }
        .nodes[index].reset();
        .nodes[index].parent = .free_list;
        .free_list = index;
        .free_count += 1;
    }

    

    
    
    
    
    
    
    
    
    fn split_edge(self: &unique, node: int, at: int) -> int: {
        let parent = .nodes[node].parent;
        var head = .nodes[node].label.substr(0, at);
        var tail = .nodes[node].label.substr(at, .nodes[node].label.size() - at);

        let fresh = .allocate_node(parent, head);
        .nodes[fresh].depth = .nodes[node].depth;
        .nodes[fresh].kind = NodeKind::Compressed;

        
        discard .nodes[parent].detach(head.at(0));
        discard .nodes[parent].attach(head.at(0), fresh);

        
        .nodes[node].label.clear();
        .nodes[node].label.append(tail);
        .nodes[node].parent = fresh;
        .nodes[node].depth = .nodes[fresh].depth + 1;
        discard .nodes[fresh].attach(tail.at(0), node);

        destroy head;
        destroy tail;
        .splits += 1;
        return fresh;
    }

    
    
    
    fn merge_edge(self: &unique, node: int) -> bool: {
        if node == .root: {
            return false;
        }
        if !.nodes[node].mergeable(): {
            return false;
        }
        var edges = .nodes[node].edges();
        if edges.size() != 1: {
            destroy edges;
            return false;
        }
        let child = edges[0].second;
        destroy edges;

        let parent = .nodes[node].parent;
        var combined = concat(.nodes[node].label, .nodes[child].label);

        discard .nodes[parent].detach(.nodes[node].label.at(0));
        .nodes[child].label.clear();
        .nodes[child].label.append(combined);
        .nodes[child].parent = parent;
        .nodes[child].depth = .nodes[parent].depth + 1;
        discard .nodes[parent].attach(combined.at(0), child);

        destroy combined;
        .release_node(node);
        .merges += 1;
        return true;
    }

    

    
    fn insert(self: &unique, key: &const shared string, value: V, weight: int) -> TrieOutcome: {
        if key.size() == 0: {
            return TrieOutcome::Rejected;
        }
        if key.size() > TRIE_MAX_KEY_LENGTH: {
            return TrieOutcome::Rejected;
        }
        .ensure_root();

        var current = .root;
        var offset: int = 0;
        var guard: int = 0;
        while guard < TRIE_MAX_DEPTH: {
            guard += 1;
            if offset == key.size(): {
                
                let was = .nodes[current].terminal;
                .nodes[current].terminal = true;
                .nodes[current].payload = value;
                .nodes[current].weight = weight;
                if was: {
                    return TrieOutcome::Replaced;
                }
                .count += 1;
                return TrieOutcome::Inserted;
            }

            let lead = key.at(offset);
            let child = .nodes[current].child_for(lead);
            if child == TRIE_NIL: {
                
                
                var suffix = key.substr(offset, key.size() - offset);
                let fresh = .allocate_node(current, suffix);
                .nodes[fresh].depth = .nodes[current].depth + 1;
                .nodes[fresh].terminal = true;
                .nodes[fresh].payload = value;
                .nodes[fresh].weight = weight;
                discard .nodes[current].attach(lead, fresh);
                destroy suffix;
                .count += 1;
                return TrieOutcome::Inserted;
            }

            var remainder = key.substr(offset, key.size() - offset);
            let shared_len = common_prefix_length(remainder, .nodes[child].label);
            let label_len = .nodes[child].label.size();
            destroy remainder;

            if shared_len == label_len: {
                
                current = child;
                offset += shared_len;
            } else: {
                
                
                let interposed = .split_edge(child, shared_len);
                current = interposed;
                offset += shared_len;
            }
        }
        return TrieOutcome::Overflowed;
    }

    fn add(self: &unique, key: &const shared string, value: V) -> TrieOutcome: {
        return .insert(key, value, WEIGHT_DEFAULT);
    }

    fn insert_all(self: &unique, entries: &const shared vector{pair{string, V}}) -> int: {
        var added: int = 0;
        for entry: &const in entries: {
            if .insert(entry.first, entry.second, WEIGHT_DEFAULT) == TrieOutcome::Inserted: {
                added += 1;
            }
        }
        return added;
    }

    

    
    fn find_node(self: &const shared, key: &const shared string) -> int: {
        if .root == TRIE_NIL: {
            return TRIE_NIL;
        }
        var current = .root;
        var offset: int = 0;
        var guard: int = 0;
        while offset < key.size() && guard < TRIE_MAX_DEPTH: {
            guard += 1;
            let child = .nodes[current].child_for(key.at(offset));
            if child == TRIE_NIL: {
                return TRIE_NIL;
            }
            var remainder = key.substr(offset, key.size() - offset);
            let shared_len = common_prefix_length(remainder, .nodes[child].label);
            destroy remainder;
            if shared_len != .nodes[child].label.size(): {
                return TRIE_NIL;
            }
            current = child;
            offset += shared_len;
        }
        return current;
    }

    
    
    fn find_prefix_node(self: &const shared, prefix: &const shared string) -> int: {
        if .root == TRIE_NIL: {
            return TRIE_NIL;
        }
        var current = .root;
        var offset: int = 0;
        var guard: int = 0;
        while offset < prefix.size() && guard < TRIE_MAX_DEPTH: {
            guard += 1;
            let child = .nodes[current].child_for(prefix.at(offset));
            if child == TRIE_NIL: {
                return TRIE_NIL;
            }
            var remainder = prefix.substr(offset, prefix.size() - offset);
            let shared_len = common_prefix_length(remainder, .nodes[child].label);
            let label_len = .nodes[child].label.size();
            let rest_len = remainder.size();
            destroy remainder;
            if shared_len == rest_len: {
                
                return child;
            }
            if shared_len != label_len: {
                return TRIE_NIL;
            }
            current = child;
            offset += shared_len;
        }
        return current;
    }

    fn contains(self: &const shared, key: &const shared string) -> bool: {
        let node = .find_node(key);
        if node == TRIE_NIL: {
            return false;
        }
        return .nodes[node].terminal;
    }

    fn at(self: &shared, key: &const shared string) -> &shared[self] V: {
        let node = .find_node(key);
        if node == TRIE_NIL: {
            return .missing;
        }
        return .nodes[node].payload;
    }

    
    fn path_of(self: &const shared, node: int) -> string: {
        var parts = vector{string}();
        var current = node;
        var guard: int = 0;
        while current != TRIE_NIL && current != .root && guard < TRIE_MAX_DEPTH: {
            parts.push_back(.nodes[current].label);
            current = .nodes[current].parent;
            guard += 1;
        }
        var out = string();
        var index = parts.size() - 1;
        while index >= 0: {
            out.append(parts[index]);
            index -= 1;
        }
        destroy parts;
        return out;
    }

    
    fn collect_under(self: &const shared, node: int,
                     base: &const shared string) -> vector{pair{string, V}}: {
        var out = vector{pair{string, V}}();
        if node == TRIE_NIL: {
            return out;
        }
        var stack = vector{pair{int, string}}();
        stack.push_back(pair{int, string}(first: node, second: base));
        while stack.size() > 0: {
            let frame = stack.back();
            let here = frame.first;
            var path = frame.second;
            stack.pop_back();

            if .nodes[here].terminal: {
                out.push_back(pair{string, V}(first: path, second: .nodes[here].payload));
            }
            var edges = .nodes[here].edges();
            for edge: &const in edges: {
                var child_path = concat(path, .nodes[edge.second].label);
                stack.push_back(pair{int, string}(first: edge.second, second: child_path));
                destroy child_path;
            }
            destroy edges;
            destroy path;
        }
        destroy stack;
        return out;
    }

    fn keys_with_prefix(self: &const shared,
                        prefix: &const shared string) -> vector{pair{string, V}}: {
        let node = .find_prefix_node(prefix);
        if node == TRIE_NIL: {
            return vector{pair{string, V}}();
        }
        var base = .path_of(node);
        var out = .collect_under(node, base);
        destroy base;
        return out;
    }

    fn to_pairs(self: &const shared) -> vector{pair{string, V}}: {
        var base = string();
        var out = .collect_under(.root, base);
        destroy base;
        return out;
    }

    
    fn longest_matching_prefix(self: &const shared,
                               text: &const shared string) -> pair{string, int}: {
        var best = string();
        var best_node: int = -1;
        if .root == TRIE_NIL: {
            return pair{string, int}(first: best, second: best_node);
        }
        var current = .root;
        var offset: int = 0;
        var guard: int = 0;
        while offset < text.size() && guard < TRIE_MAX_DEPTH: {
            guard += 1;
            let child = .nodes[current].child_for(text.at(offset));
            if child == TRIE_NIL: {
                return pair{string, int}(first: best, second: best_node);
            }
            var remainder = text.substr(offset, text.size() - offset);
            let shared_len = common_prefix_length(remainder, .nodes[child].label);
            destroy remainder;
            if shared_len != .nodes[child].label.size(): {
                return pair{string, int}(first: best, second: best_node);
            }
            current = child;
            offset += shared_len;
            if .nodes[current].terminal: {
                best.clear();
                best.append(text.substr(0, offset));
                best_node = current;
            }
        }
        return pair{string, int}(first: best, second: best_node);
    }

    

    
    fn erase(self: &unique, key: &const shared string) -> bool: {
        let node = .find_node(key);
        if node == TRIE_NIL: {
            return false;
        }
        if !.nodes[node].terminal: {
            return false;
        }
        .nodes[node].terminal = false;
        .nodes[node].weight = 0;
        .count -= 1;

        var current = node;
        var guard: int = 0;
        while current != TRIE_NIL && current != .root && guard < TRIE_MAX_DEPTH: {
            guard += 1;
            if .nodes[current].is_leaf() && !.nodes[current].terminal: {
                let parent = .nodes[current].parent;
                discard .nodes[parent].detach(.nodes[current].label.at(0));
                .release_node(current);
                current = parent;
            } else: {
                discard .merge_edge(current);
                current = TRIE_NIL;
            }
        }
        if current != TRIE_NIL && current != .root: {
            discard .merge_edge(current);
        }
        return true;
    }

    fn clear(self: &unique): {
        for node: &unique in .nodes: {
            node.reset();
        }
        .nodes.clear();
        .root = TRIE_NIL;
        .free_list = TRIE_NIL;
        .free_count = 0;
        .count = 0;
        .splits = 0;
        .merges = 0;
    }

    

    
    
    
    
    fn check_validity(self: &const shared) -> bool: {
        assert .count >= 0;
        if .root == TRIE_NIL: {
            assert .count == 0;
            prove .count == 0;
            return true;
        }
        var stack = vector{int}();
        stack.push_back(.root);
        var terminals: int = 0;
        while stack.size() > 0: {
            let here = stack.back();
            stack.pop_back();
            if .nodes[here].terminal: {
                terminals += 1;
            }
            if here != .root: {
                assert .nodes[here].label.size() >= RADIX_MIN_LABEL;
                prove .nodes[here].label.size() >= RADIX_MIN_LABEL;
                assert !.nodes[here].mergeable();
            }
            var seen = set{char}();
            var edges = .nodes[here].edges();
            for edge: &const in edges: {
                assert seen.insert(edge.first);
                assert .nodes[edge.second].parent == here;
                assert .nodes[edge.second].label.at(0) == edge.first;
                stack.push_back(edge.second);
            }
            destroy edges;
            destroy seen;
        }
        destroy stack;
        assert terminals == .count;
        prove terminals == .count;
        return true;
    }

    nodes: vector{RadixNode{V, ALPHABET}};

    
    cache: map{string, vector{pair{string, int}}};

    root: int = -1;
    free_list: int = -1;
    free_count: int = 0;
    count: int = 0;
    splits: int = 0;
    merges: int = 0;
    missing: V;
}











template(V: type)
struct TernaryNode: {

    fn is_terminal(self: &const shared) -> bool: {
        return .terminal;
    }

    fn is_leaf(self: &const shared) -> bool: {
        if .low != TRIE_NIL: {
            return false;
        }
        if .equal != TRIE_NIL: {
            return false;
        }
        return .high == TRIE_NIL;
    }

    fn degree(self: &const shared) -> int: {
        var found: int = 0;
        if .low != TRIE_NIL: {
            found += 1;
        }
        if .equal != TRIE_NIL: {
            found += 1;
        }
        if .high != TRIE_NIL: {
            found += 1;
        }
        return found;
    }

    
    fn link_for(self: &const shared, c: char) -> TernaryLink: {
        if c < .split: {
            return TernaryLink::LowLink;
        }
        if c > .split: {
            return TernaryLink::HighLink;
        }
        return TernaryLink::EqualLink;
    }

    fn follow(self: &const shared, which: TernaryLink) -> int: {
        if which == TernaryLink::LowLink: {
            return .low;
        }
        if which == TernaryLink::HighLink: {
            return .high;
        }
        return .equal;
    }

    fn set_link(self: &unique, which: TernaryLink, node: int): {
        if which == TernaryLink::LowLink: {
            .low = node;
        } else: {
            if which == TernaryLink::HighLink: {
                .high = node;
            } else: {
                .equal = node;
            }
        }
    }

    fn reset(self: &unique): {
        .split = CHAR_NUL;
        .low = TRIE_NIL;
        .equal = TRIE_NIL;
        .high = TRIE_NIL;
        .terminal = false;
        .weight = 0;
        .live = false;
    }

    split: char = '\0';
    payload: V;
    weight: int = 0;
    low: int = -1;
    equal: int = -1;
    high: int = -1;
    depth: int = 0;
    terminal: bool = false;
    live: bool = false;
}






template(V: type)
struct TernaryTree: {

    fn size(self: &const shared) -> int: {
        return .count;
    }

    fn empty(self: &const shared) -> bool: {
        return .count == 0;
    }

    fn node_count(self: &const shared) -> int: {
        return .nodes.size();
    }

    fn node_at(self: &shared, index: int) -> &shared[self] TernaryNode{V}: {
        return .nodes[index];
    }

    fn allocate_node(self: &unique, c: char, depth: int) -> int: {
        .nodes.push_back(TernaryNode{V}());
        let fresh = .nodes.size() - 1;
        .nodes[fresh].split = c;
        .nodes[fresh].depth = depth;
        .nodes[fresh].live = true;
        return fresh;
    }

    

    
    
    
    fn insert(self: &unique, key: &const shared string, value: V, weight: int) -> TrieOutcome: {
        if key.size() == 0: {
            return TrieOutcome::Rejected;
        }
        if .root == TRIE_NIL: {
            .root = .allocate_node(key.at(0), 0);
        }

        var current = .root;
        var index: int = 0;
        var guard: int = 0;
        while guard < TRIE_MAX_DEPTH * 4: {
            guard += 1;
            let c = key.at(index);
            let which = .nodes[current].link_for(c);

            if which == TernaryLink::EqualLink: {
                if index + 1 == key.size(): {
                    let was = .nodes[current].terminal;
                    .nodes[current].terminal = true;
                    .nodes[current].payload = value;
                    .nodes[current].weight = weight;
                    if was: {
                        return TrieOutcome::Replaced;
                    }
                    .count += 1;
                    return TrieOutcome::Inserted;
                }
                if .nodes[current].equal == TRIE_NIL: {
                    let fresh = .allocate_node(key.at(index + 1),
                                               .nodes[current].depth + 1);
                    .nodes[current].equal = fresh;
                }
                current = .nodes[current].equal;
                index += 1;
            } else: {
                let next = .nodes[current].follow(which);
                if next == TRIE_NIL: {
                    let fresh = .allocate_node(c, .nodes[current].depth);
                    .nodes[current].set_link(which, fresh);
                    current = fresh;
                } else: {
                    current = next;
                }
            }
        }
        return TrieOutcome::Overflowed;
    }

    fn add(self: &unique, key: &const shared string, value: V) -> TrieOutcome: {
        return .insert(key, value, WEIGHT_DEFAULT);
    }

    fn insert_all(self: &unique, entries: &const shared vector{pair{string, V}}) -> int: {
        var added: int = 0;
        for entry: &const in entries: {
            if .insert(entry.first, entry.second, WEIGHT_DEFAULT) == TrieOutcome::Inserted: {
                added += 1;
            }
        }
        return added;
    }

    

    
    fn find_node(self: &const shared, key: &const shared string) -> int: {
        if .root == TRIE_NIL: {
            return TRIE_NIL;
        }
        if key.size() == 0: {
            return TRIE_NIL;
        }
        var current = .root;
        var index: int = 0;
        var guard: int = 0;
        while current != TRIE_NIL && guard < TRIE_MAX_DEPTH * 4: {
            guard += 1;
            let c = key.at(index);
            if c < .nodes[current].split: {
                current = .nodes[current].low;
            } else: {
                if c > .nodes[current].split: {
                    current = .nodes[current].high;
                } else: {
                    if index + 1 == key.size(): {
                        return current;
                    }
                    current = .nodes[current].equal;
                    index += 1;
                }
            }
        }
        return TRIE_NIL;
    }

    fn contains(self: &const shared, key: &const shared string) -> bool: {
        let node = .find_node(key);
        if node == TRIE_NIL: {
            return false;
        }
        return .nodes[node].terminal;
    }

    fn at(self: &shared, key: &const shared string) -> &shared[self] V: {
        let node = .find_node(key);
        if node == TRIE_NIL: {
            return .missing;
        }
        return .nodes[node].payload;
    }

    
    
    
    fn collect_under(self: &const shared, node: int,
                     prefix: &const shared string) -> vector{pair{string, V}}: {
        var out = vector{pair{string, V}}();
        if node == TRIE_NIL: {
            return out;
        }
        var stack = vector{pair{int, string}}();
        stack.push_back(pair{int, string}(first: node, second: prefix));
        while stack.size() > 0: {
            let frame = stack.back();
            let here = frame.first;
            var path = frame.second;
            stack.pop_back();

            if .nodes[here].high != TRIE_NIL: {
                stack.push_back(pair{int, string}(first: .nodes[here].high, second: path));
            }
            if .nodes[here].low != TRIE_NIL: {
                stack.push_back(pair{int, string}(first: .nodes[here].low, second: path));
            }

            var extended = push_char(path, .nodes[here].split);
            if .nodes[here].terminal: {
                out.push_back(pair{string, V}(first: extended,
                                              second: .nodes[here].payload));
            }
            if .nodes[here].equal != TRIE_NIL: {
                stack.push_back(pair{int, string}(first: .nodes[here].equal,
                                                  second: extended));
            }
            destroy extended;
            destroy path;
        }
        destroy stack;
        return out;
    }

    
    
    
    fn keys_with_prefix(self: &const shared,
                        prefix: &const shared string) -> vector{pair{string, V}}: {
        var out = vector{pair{string, V}}();
        let node = .find_node(prefix);
        if node == TRIE_NIL: {
            return out;
        }
        if .nodes[node].terminal: {
            out.push_back(pair{string, V}(first: prefix, second: .nodes[node].payload));
        }
        var deeper = .collect_under(.nodes[node].equal, prefix);
        for entry: &const in deeper: {
            out.push_back(entry);
        }
        destroy deeper;
        return out;
    }

    fn to_pairs(self: &const shared) -> vector{pair{string, V}}: {
        var base = string();
        var out = .collect_under(.root, base);
        destroy base;
        return out;
    }

    
    fn longest_matching_prefix(self: &const shared, text: &const shared string) -> string: {
        var best = string();
        if .root == TRIE_NIL: {
            return best;
        }
        var current = .root;
        var index: int = 0;
        var guard: int = 0;
        while current != TRIE_NIL && index < text.size() && guard < TRIE_MAX_DEPTH * 4: {
            guard += 1;
            let c = text.at(index);
            if c < .nodes[current].split: {
                current = .nodes[current].low;
            } else: {
                if c > .nodes[current].split: {
                    current = .nodes[current].high;
                } else: {
                    index += 1;
                    if .nodes[current].terminal: {
                        best.clear();
                        best.append(text.substr(0, index));
                    }
                    current = .nodes[current].equal;
                }
            }
        }
        return best;
    }

    

    
    
    
    fn erase(self: &unique, key: &const shared string) -> bool: {
        let node = .find_node(key);
        if node == TRIE_NIL: {
            return false;
        }
        if !.nodes[node].terminal: {
            return false;
        }
        .nodes[node].terminal = false;
        .nodes[node].weight = 0;
        .count -= 1;
        .pending_prune += 1;
        if .pending_prune >= 16: {
            discard .compact();
        }
        return true;
    }

    
    
    
    fn compact(self: &unique) -> int: {
        var entries = .to_pairs();
        let before = .nodes.size();
        .nodes.clear();
        .root = TRIE_NIL;
        .count = 0;
        .pending_prune = 0;

        var ordered = sort_pairs_by_key{V}(entries);
        .insert_balanced(ordered, 0, ordered.size() - 1);
        destroy ordered;
        destroy entries;
        return before - .nodes.size();
    }

    
    
    fn insert_balanced(self: &unique, entries: &const shared vector{pair{string, V}},
                       low: int, high: int): {
        if low > high: {
            return;
        }
        var stack = vector{pair{int, int}}();
        stack.push_back(pair{int, int}(first: low, second: high));
        while stack.size() > 0: {
            let frame = stack.back();
            stack.pop_back();
            let begin = frame.first;
            let end = frame.second;
            if begin > end: {
                discard frame;
            } else: {
                let middle = begin + (end - begin) / 2;
                discard .insert(entries[middle].first, entries[middle].second,
                                WEIGHT_DEFAULT);
                stack.push_back(pair{int, int}(first: begin, second: middle - 1));
                stack.push_back(pair{int, int}(first: middle + 1, second: end));
            }
        }
        destroy stack;
    }

    fn clear(self: &unique): {
        for node: &unique in .nodes: {
            node.reset();
        }
        .nodes.clear();
        .root = TRIE_NIL;
        .count = 0;
        .pending_prune = 0;
    }

    

    
    
    
    fn check_validity(self: &const shared) -> bool: {
        assert .count >= 0;
        if .root == TRIE_NIL: {
            assert .count == 0;
            prove .count == 0;
            return true;
        }
        var stack = vector{int}();
        stack.push_back(.root);
        var terminals: int = 0;
        while stack.size() > 0: {
            let here = stack.back();
            stack.pop_back();
            if .nodes[here].terminal: {
                terminals += 1;
            }
            if .nodes[here].low != TRIE_NIL: {
                assert .nodes[.nodes[here].low].split < .nodes[here].split;
                prove .nodes[.nodes[here].low].split < .nodes[here].split;
                stack.push_back(.nodes[here].low);
            }
            if .nodes[here].high != TRIE_NIL: {
                assert .nodes[.nodes[here].high].split > .nodes[here].split;
                prove .nodes[.nodes[here].high].split > .nodes[here].split;
                stack.push_back(.nodes[here].high);
            }
            if .nodes[here].equal != TRIE_NIL: {
                stack.push_back(.nodes[here].equal);
            }
        }
        destroy stack;
        assert terminals == .count;
        prove terminals == .count;
        return true;
    }

    nodes: vector{TernaryNode{V}};
    root: int = -1;
    count: int = 0;
    pending_prune: int = 0;
    missing: V;
}










template(V: type)
struct TopK: {

    fn size(self: &const shared) -> int: {
        return .entries.size();
    }

    fn empty(self: &const shared) -> bool: {
        return .entries.size() == 0;
    }

    fn full(self: &const shared) -> bool: {
        return .entries.size() >= .capacity;
    }

    fn configure(self: &unique, k: int): {
        var bounded = k;
        if bounded < 1: {
            bounded = 1;
        }
        if bounded > MAX_TOP_K: {
            bounded = MAX_TOP_K;
        }
        .capacity = bounded;
        .entries.reserve(bounded);
    }

    
    
    
    fn cutoff(self: &const shared) -> int: {
        if .entries.size() < .capacity: {
            return -2147483647;
        }
        return .entries[.entries.size() - 1].score;
    }

    
    fn admits(self: &const shared, score: int) -> bool: {
        if .entries.size() < .capacity: {
            return true;
        }
        return score > .cutoff();
    }

    
    
    fn offer(self: &unique, candidate: &const shared Completion{V}) -> bool: {
        .considered += 1;
        if !.admits(candidate.score): {
            .rejected += 1;
            return false;
        }

        var position = .entries.size();
        var index: int = 0;
        while index < .entries.size(): {
            if candidate.better_than(.entries[index]): {
                position = index;
                index = .entries.size();
            } else: {
                index += 1;
            }
        }

        .entries.insert(position, candidate);
        if .entries.size() > .capacity: {
            .entries.pop_back();
            .evicted += 1;
        }
        .accepted += 1;
        return true;
    }

    
    fn ranked(self: &const shared) -> vector{Completion{V}}: {
        var out = vector{Completion{V}}();
        for entry: &const in .entries: {
            out.push_back(entry);
        }
        return out;
    }

    
    
    fn as_scored_keys(self: &const shared) -> vector{pair{string, int}}: {
        var out = vector{pair{string, int}}();
        for entry: &const in .entries: {
            out.push_back(pair{string, int}(first: entry.key, second: entry.score));
        }
        return out;
    }

    fn clear(self: &unique): {
        .entries.clear();
        .considered = 0;
        .accepted = 0;
        .rejected = 0;
        .evicted = 0;
    }

    
    entries: vector{Completion{V}};

    capacity: int = 8;
    considered: int = 0;
    accepted: int = 0;
    rejected: int = 0;
    evicted: int = 0;
}










struct EditRow: {

    fn width(self: &const shared) -> int: {
        return .cells.size();
    }

    fn last(self: &const shared) -> int: {
        return .cells[.cells.size() - 1];
    }

    
    
    fn best(self: &const shared) -> int: {
        var lowest = TRIE_MAX_KEY_LENGTH;
        for cell: &const in .cells: {
            if cell < lowest: {
                lowest = cell;
            }
        }
        return lowest;
    }

    fn exceeds(self: &const shared, budget: int) -> bool: {
        return .best() > budget;
    }

    fn describe(self: &const shared) -> string: {
        var text = string();
        text.append("row depth=");
        text.append(to_string(.depth));
        text.append(" best=");
        text.append(to_string(.best()));
        return text;
    }

    cells: vector{int};
    node: int = -1;
    depth: int = 0;
    edge: char = '\0';
}





template(V: type, ALPHABET: int)
struct FuzzyMatcher: {

    fn configure(self: &unique, budget: int): {
        var bounded = budget;
        if bounded < 0: {
            bounded = 0;
        }
        if bounded > MAX_EDIT_BUDGET: {
            bounded = MAX_EDIT_BUDGET;
        }
        .budget = bounded;
    }

    
    
    fn seed_row(self: &const shared, pattern: &const shared string) -> EditRow: {
        var row = EditRow();
        var index: int = 0;
        while index <= pattern.size(): {
            row.cells.push_back(index);
            index += 1;
        }
        row.depth = 0;
        row.edge = CHAR_NUL;
        return row;
    }

    
    
    fn step_row(self: &const shared, previous: &const shared EditRow, c: char,
                pattern: &const shared string) -> EditRow: {
        var row = EditRow();
        row.depth = previous.depth + 1;
        row.edge = c;
        row.cells.push_back(previous.cells[0] + 1);

        var index: int = 1;
        while index <= pattern.size(): {
            let deletion = row.cells[index - 1] + 1;
            let insertion = previous.cells[index] + 1;
            var substitution = previous.cells[index - 1];
            if pattern.at(index - 1) != c: {
                substitution += 1;
            }

            var best = deletion;
            if insertion < best: {
                best = insertion;
            }
            if substitution < best: {
                best = substitution;
            }
            row.cells.push_back(best);
            index += 1;
        }
        .rows_built += 1;
        return row;
    }

    
    
    
    
    fn search(self: &unique, index: &const shared Trie{V, ALPHABET},
              pattern: &const shared string) -> vector{Completion{V}}: {
        var out = vector{Completion{V}}();
        .rows_built = 0;
        .nodes_visited = 0;
        .subtrees_pruned = 0;
        if index.size() == 0: {
            return out;
        }

        var stack = vector{pair{EditRow, string}}();
        var root_row = .seed_row(pattern);
        root_row.node = index.root_index();
        var empty_path = string();
        stack.push_back(pair{EditRow, string}(first: root_row, second: empty_path));
        destroy root_row;
        destroy empty_path;

        while stack.size() > 0: {
            let frame = stack.back();
            var row = frame.first;
            var path = frame.second;
            stack.pop_back();
            .nodes_visited += 1;

            let here = row.node;
            let distance = row.last();
            if distance <= .budget && index.node_at(here).is_terminal(): {
                var found = Completion{V}();
                found.key.append(path);
                found.value = index.node_at(here).payload;
                found.weight = index.node_at(here).weight;
                found.edits = distance;
                found.node = here;
                if distance == 0: {
                    found.kind = MatchKind::ExactMatch;
                } else: {
                    found.kind = MatchKind::FuzzyMatch;
                }
                found.score = fuzzy_score(found.weight, distance, path.size(),
                                          pattern.size());
                out.push_back(found);
                destroy found;
            }

            var edges = index.node_at(here).edges();
            for edge: &const in edges: {
                var child_row = .step_row(row, edge.first, pattern);
                child_row.node = edge.second;
                if child_row.exceeds(.budget): {
                    .subtrees_pruned += 1;
                } else: {
                    var child_path = push_char(path, edge.first);
                    stack.push_back(pair{EditRow, string}(first: child_row,
                                                          second: child_path));
                    destroy child_path;
                }
                destroy child_row;
            }
            destroy edges;
            destroy row;
            destroy path;
        }
        destroy stack;
        return out;
    }

    
    fn search_top(self: &unique, index: &const shared Trie{V, ALPHABET},
                  pattern: &const shared string, k: int) -> vector{Completion{V}}: {
        var picker = TopK{V}();
        picker.configure(k);
        var candidates = .search(index, pattern);
        for candidate: &const in candidates: {
            discard picker.offer(candidate);
        }
        destroy candidates;
        var out = picker.ranked();
        destroy picker;
        return out;
    }

    
    budget: int = 2;
    rows_built: int = 0;
    nodes_visited: int = 0;
    subtrees_pruned: int = 0;
}





struct QueryRecord: {

    fn describe(self: &const shared) -> string: {
        var text = string();
        text.append(.text);
        text.append(" hits=");
        text.append(to_string(.hits));
        text.append(" weight=");
        text.append(to_string(.weight));
        return text;
    }

    
    
    fn reinforce(self: &unique, amount: int): {
        .hits += 1;
        var gain = amount;
        if .hits > 8: {
            gain = amount / 2;
        }
        if .hits > 64: {
            gain = amount / 4;
        }
        .weight += gain;
    }

    text: string;
    hits: int = 0;
    weight: int = 0;
    last_seen: int = 0;
}













template(V: type, ALPHABET: int)
struct Autocomplete: {

    fn size(self: &const shared) -> int: {
        return .index.size();
    }

    fn empty(self: &const shared) -> bool: {
        return .index.empty();
    }

    fn alphabet_width(self: &const shared) -> int: {
        return ALPHABET;
    }

    
    
    fn trie(self: &shared) -> &shared[self] Trie{V, ALPHABET}: {
        return .index;
    }

    fn radix(self: &shared) -> &shared[self] RadixTree{V, ALPHABET}: {
        return .mirror;
    }

    

    
    fn learn(self: &unique, key: &const shared string, value: V, weight: int) -> TrieOutcome: {
        var folded = normalize_key{ALPHABET}(key);
        if folded.first.size() == 0: {
            destroy folded;
            return TrieOutcome::Rejected;
        }
        let outcome = .index.insert(folded.first, value, weight);
        discard .mirror.insert(folded.first, value, weight);
        .dropped_characters += folded.second;
        .invalidate(folded.first);
        destroy folded;
        return outcome;
    }

    fn learn_default(self: &unique, key: &const shared string, value: V) -> TrieOutcome: {
        return .learn(key, value, WEIGHT_DEFAULT);
    }

    
    fn learn_all(self: &unique,
                 entries: &const shared vector{pair{string, pair{V, int}}}) -> int: {
        var added: int = 0;
        for entry: &const in entries: {
            if .learn(entry.first, entry.second.first,
                      entry.second.second) == TrieOutcome::Inserted: {
                added += 1;
            }
        }
        return added;
    }

    
    
    fn record_selection(self: &unique, key: &const shared string) -> bool: {
        var folded = normalize_key{ALPHABET}(key);
        if !.history.contains(folded.first): {
            var record = QueryRecord();
            record.text.append(folded.first);
            record.weight = WEIGHT_DEFAULT;
            discard .history.insert(folded.first, record);
            destroy record;
        }
        .history.at(folded.first).reinforce(WEIGHT_DEFAULT / 4);
        .history.at(folded.first).last_seen = .clock;
        .clock += 1;

        let bumped = .index.bump(folded.first, WEIGHT_DEFAULT / 4);
        .invalidate(folded.first);
        destroy folded;
        return bumped;
    }

    
    
    
    fn add_alias(self: &unique, alias: &const shared string,
                 canonical: &const shared string): {
        if !.synonyms.contains(alias): {
            var bucket = vector{string}();
            discard .synonyms.insert(alias, bucket);
            destroy bucket;
        }
        .synonyms.at(alias).push_back(canonical);
    }

    fn remove(self: &unique, key: &const shared string) -> bool: {
        var folded = normalize_key{ALPHABET}(key);
        let gone = .index.erase(folded.first);
        discard .mirror.erase(folded.first);
        discard .history.erase(folded.first);
        .invalidate(folded.first);
        destroy folded;
        return gone;
    }

    

    
    
    fn invalidate(self: &unique, key: &const shared string): {
        var doomed = vector{string}();
        for entry: &const in .cache: {
            if starts_with(key, entry.first) || starts_with(entry.first, key): {
                doomed.push_back(entry.first);
            }
        }
        for prefix: &const in doomed: {
            discard .cache.erase(prefix);
        }
        destroy doomed;
        .invalidations += 1;
    }

    fn clear_cache(self: &unique): {
        .cache.clear();
        .cache_hits = 0;
        .cache_misses = 0;
    }

    

    
    
    
    
    
    fn score_for(self: &const shared, key: &const shared string,
                 prefix: &const shared string, weight: int) -> int: {
        var score = weight;
        let extra = key.size() - prefix.size();
        score -= extra * SCORE_LENGTH_PENALTY;
        if extra == 0: {
            score += SCORE_EXACT_BONUS;
        }
        if .history.contains(key): {
            score += .history.at(key).weight / 2;
        }
        if score < WEIGHT_FLOOR: {
            score = WEIGHT_FLOOR;
        }
        return score;
    }

    

    
    
    
    
    
    fn suggest(self: &unique, prefix: &const shared string, k: int) -> vector{Completion{V}}: {
        var folded = normalize_key{ALPHABET}(prefix);
        var picker = TopK{V}();
        picker.configure(k);

        let start = .index.find_node(folded.first);
        if start == TRIE_NIL: {
            .misses += 1;
            var empty_result = picker.ranked();
            destroy picker;
            destroy folded;
            return empty_result;
        }

        var stack = vector{pair{int, string}}();
        stack.push_back(pair{int, string}(first: start, second: folded.first));
        var visited: int = 0;
        var pruned: int = 0;

        while stack.size() > 0: {
            let frame = stack.back();
            let here = frame.first;
            var path = frame.second;
            stack.pop_back();
            visited += 1;

            if .index.node_at(here).is_terminal(): {
                var found = Completion{V}();
                found.key.append(path);
                found.value = .index.node_at(here).payload;
                found.weight = .index.node_at(here).weight;
                found.node = here;
                found.edits = 0;
                if path.size() == folded.first.size(): {
                    found.kind = MatchKind::ExactMatch;
                } else: {
                    found.kind = MatchKind::PrefixMatch;
                }
                found.score = .score_for(found.key, folded.first, found.weight);
                discard picker.offer(found);
                destroy found;
            }

            var edges = .index.node_at(here).edges();
            for edge: &const in edges: {
                
                let ceiling = .index.node_at(edge.second).subtree_weight;
                if picker.admits(ceiling): {
                    var child_path = push_char(path, edge.first);
                    stack.push_back(pair{int, string}(first: edge.second,
                                                      second: child_path));
                    destroy child_path;
                } else: {
                    pruned += 1;
                }
            }
            destroy edges;
            destroy path;
        }
        destroy stack;

        .nodes_visited += visited;
        .subtrees_pruned += pruned;
        .queries += 1;

        
        
        var scored = picker.as_scored_keys();
        discard .cache.insert(folded.first, scored);
        destroy scored;

        var out = picker.ranked();
        destroy picker;
        destroy folded;
        return out;
    }

    fn suggest_default(self: &unique, prefix: &const shared string) -> vector{Completion{V}}: {
        return .suggest(prefix, DEFAULT_TOP_K);
    }

    
    
    fn suggest_cached(self: &unique, prefix: &const shared string,
                      k: int) -> vector{pair{string, int}}: {
        var folded = normalize_key{ALPHABET}(prefix);
        if .cache.contains(folded.first): {
            .cache_hits += 1;
            var hit = vector{pair{string, int}}();
            for entry: &const in .cache.at(folded.first): {
                hit.push_back(entry);
            }
            destroy folded;
            return hit;
        }
        .cache_misses += 1;
        var fresh = .suggest(folded.first, k);
        var out = vector{pair{string, int}}();
        for entry: &const in fresh: {
            out.push_back(pair{string, int}(first: entry.key, second: entry.score));
        }
        destroy fresh;
        destroy folded;
        return out;
    }

    
    
    fn suggest_fuzzy(self: &unique, prefix: &const shared string, k: int,
                     budget: int) -> vector{Completion{V}}: {
        var folded = normalize_key{ALPHABET}(prefix);
        var matcher = FuzzyMatcher{V, ALPHABET}();
        matcher.configure(budget);
        var out = matcher.search_top(.index, folded.first, k);
        .fuzzy_queries += 1;
        .nodes_visited += matcher.nodes_visited;
        .subtrees_pruned += matcher.subtrees_pruned;
        destroy matcher;
        destroy folded;
        return out;
    }

    
    
    fn suggest_or_correct(self: &unique, prefix: &const shared string,
                          k: int) -> vector{Completion{V}}: {
        var exact = .suggest(prefix, k);
        if exact.size() >= k: {
            return exact;
        }
        var corrected = .suggest_fuzzy(prefix, k, DEFAULT_EDIT_BUDGET);
        var seen = set{string}();
        var out = vector{Completion{V}}();
        for entry: &const in exact: {
            discard seen.insert(entry.key);
            out.push_back(entry);
        }
        for entry: &const in corrected: {
            if !seen.contains(entry.key): {
                discard seen.insert(entry.key);
                out.push_back(entry);
            }
        }
        destroy seen;
        destroy corrected;
        destroy exact;
        return out;
    }

    
    
    fn suggest_with_aliases(self: &unique, prefix: &const shared string,
                            k: int) -> map{string, vector{pair{string, int}}}: {
        var out = map{string, vector{pair{string, int}}}();
        var direct = .suggest_cached(prefix, k);
        discard out.insert(prefix, direct);
        destroy direct;

        if .synonyms.contains(prefix): {
            for alias: &const in .synonyms.at(prefix): {
                var expansion = .suggest_cached(alias, k);
                discard out.insert(alias, expansion);
                destroy expansion;
            }
        }
        return out;
    }

    
    
    fn inline_completion(self: &const shared, prefix: &const shared string) -> string: {
        return .index.extend_unambiguously(prefix);
    }

    
    
    fn longest_term_in(self: &const shared, text: &const shared string) -> string: {
        var found = .mirror.longest_matching_prefix(text);
        var out = string();
        out.append(found.first);
        destroy found;
        return out;
    }

    
    
    
    fn segment(self: &const shared, text: &const shared string) -> vector{pair{string, int}}: {
        var out = vector{pair{string, int}}();
        var cursor: int = 0;
        var guard: int = 0;
        while cursor < text.size() && guard < TRIE_MAX_KEY_LENGTH: {
            guard += 1;
            var tail = text.substr(cursor, text.size() - cursor);
            var term = .longest_term_in(tail);
            if term.size() == 0: {
                cursor += 1;
            } else: {
                out.push_back(pair{string, int}(first: term, second: cursor));
                cursor += term.size();
            }
            destroy term;
            destroy tail;
        }
        return out;
    }

    

    
    fn age(self: &unique) -> int: {
        discard .index.decay();
        let evicted = .index.evict_below(WEIGHT_FLOOR + 1);
        .clear_cache();
        return evicted;
    }

    fn clear(self: &unique): {
        .index.clear();
        .mirror.clear();
        .history.clear();
        .synonyms.clear();
        .cache.clear();
        .queries = 0;
        .fuzzy_queries = 0;
        .misses = 0;
        .nodes_visited = 0;
        .subtrees_pruned = 0;
        .invalidations = 0;
        .dropped_characters = 0;
        .clock = 0;
    }

    fn describe(self: &const shared) -> string: {
        var text = string();
        text.append("autocomplete terms=");
        text.append(to_string(.index.size()));
        text.append(" nodes=");
        text.append(to_string(.index.node_count()));
        text.append(" queries=");
        text.append(to_string(.queries));
        text.append(" pruned=");
        text.append(to_string(.subtrees_pruned));
        text.append(" cache=");
        text.append(to_string(.cache_hits));
        text.append("/");
        text.append(to_string(.cache_hits + .cache_misses));
        return text;
    }

    
    index: Trie{V, ALPHABET};

    
    mirror: RadixTree{V, ALPHABET};

    
    history: map{string, QueryRecord};

    
    synonyms: map{string, vector{string}};

    
    cache: map{string, vector{pair{string, int}}};

    queries: int = 0;
    fuzzy_queries: int = 0;
    misses: int = 0;
    cache_hits: int = 0;
    cache_misses: int = 0;
    nodes_visited: int = 0;
    subtrees_pruned: int = 0;
    invalidations: int = 0;
    dropped_characters: int = 0;
    clock: int = 0;
}








struct FlatRecord: {

    fn is_leaf(self: &const shared) -> bool: {
        return .child_count == 0;
    }

    fn describe(self: &const shared) -> string: {
        var text = string();
        text.append("record parent=");
        text.append(to_string(.parent));
        text.append(" edge=");
        text.push_back(.edge);
        text.append(" children=");
        text.append(to_string(.child_count));
        return text;
    }

    parent: int = -1;
    edge: char = '\0';
    depth: int = 0;
    weight: int = 0;
    child_count: int = 0;
    payload_slot: int = -1;
    tag: SerialTag = SerialTag::TagBranch;
}







template(V: type, ALPHABET: int)
struct FlatTrie: {

    fn size(self: &const shared) -> int: {
        return .records.size();
    }

    fn empty(self: &const shared) -> bool: {
        return .records.size() == 0;
    }

    fn key_count(self: &const shared) -> int: {
        return .payloads.size();
    }

    fn alphabet_width(self: &const shared) -> int: {
        return ALPHABET;
    }

    
    
    fn header_valid(self: &const shared) -> bool: {
        if .version != 1: {
            return false;
        }
        if .alphabet != ALPHABET: {
            return false;
        }
        return .records.size() >= .payloads.size();
    }

    
    fn key_of(self: &const shared, index: int) -> string: {
        var reversed = vector{char}();
        var current = index;
        var guard: int = 0;
        while current > 0 && guard < TRIE_MAX_DEPTH: {
            reversed.push_back(.records[current].edge);
            current = .records[current].parent;
            guard += 1;
        }
        var out = string();
        var cursor = reversed.size() - 1;
        while cursor >= 0: {
            out.push_back(reversed[cursor]);
            cursor -= 1;
        }
        destroy reversed;
        return out;
    }

    
    
    fn entries(self: &const shared) -> vector{pair{string, V}}: {
        var out = vector{pair{string, V}}();
        for slot: &const in .payloads: {
            var key = .key_of(slot.first);
            out.push_back(pair{string, V}(first: key, second: slot.second));
            destroy key;
        }
        return out;
    }

    fn describe(self: &const shared) -> string: {
        var text = string();
        text.append("flat records=");
        text.append(to_string(.records.size()));
        text.append(" payloads=");
        text.append(to_string(.payloads.size()));
        text.append(" alphabet=");
        text.append(to_string(.alphabet));
        return text;
    }

    fn clear(self: &unique): {
        .records.clear();
        .payloads.clear();
        .edge_table.clear();
        .version = 1;
        .alphabet = ALPHABET;
    }

    
    records: vector{FlatRecord};

    
    payloads: vector{pair{int, V}};

    
    
    
    edge_table: map{int, vector{pair{char, int}}};

    version: int = 1;
    alphabet: int = 0;
}






template(V: type, ALPHABET: int)
fn serialize_trie(source: &const shared Trie{V, ALPHABET}) -> FlatTrie{V, ALPHABET}: {
    var flat = FlatTrie{V, ALPHABET}();
    flat.version = 1;
    flat.alphabet = ALPHABET;
    if source.size() == 0: {
        return flat;
    }

    var mapping = map{int, int}();
    var frontier = vector{int}();
    frontier.push_back(source.root_index());
    discard mapping.insert(source.root_index(), 0);

    var root_record = FlatRecord();
    root_record.parent = TRIE_NIL;
    root_record.edge = CHAR_NUL;
    root_record.depth = 0;
    root_record.tag = SerialTag::TagBranch;
    flat.records.push_back(root_record);
    destroy root_record;

    var cursor: int = 0;
    while cursor < frontier.size(): {
        let here = frontier[cursor];
        let record_index = mapping.at(here);
        cursor += 1;

        if source.node_at(here).is_terminal(): {
            flat.records[record_index].tag = SerialTag::TagLeaf;
            flat.records[record_index].weight = source.node_at(here).weight;
            flat.records[record_index].payload_slot = flat.payloads.size();
            flat.payloads.push_back(pair{int, V}(first: record_index,
                                                 second: source.node_at(here).payload));
        }

        var edges = source.node_at(here).edges();
        flat.records[record_index].child_count = edges.size();

        var listing = vector{pair{char, int}}();
        for edge: &const in edges: {
            var child_record = FlatRecord();
            child_record.parent = record_index;
            child_record.edge = edge.first;
            child_record.depth = flat.records[record_index].depth + 1;
            child_record.tag = SerialTag::TagEdge;
            flat.records.push_back(child_record);
            let child_index = flat.records.size() - 1;
            destroy child_record;

            discard mapping.insert(edge.second, child_index);
            frontier.push_back(edge.second);
            listing.push_back(pair{char, int}(first: edge.first, second: child_index));
        }
        if listing.size() > 0: {
            discard flat.edge_table.insert(record_index, listing);
        }
        destroy listing;
        destroy edges;
    }

    destroy frontier;
    destroy mapping;
    return flat;
}





template(V: type, ALPHABET: int)
fn deserialize_trie(flat: &const shared FlatTrie{V, ALPHABET},
                    target: &unique Trie{V, ALPHABET}) -> bool: {
    target.clear();
    if !flat.header_valid(): {
        return false;
    }
    if flat.empty(): {
        return true;
    }

    var entries = flat.entries();
    var index: int = 0;
    while index < entries.size(): {
        let record_index = flat.payloads[index].first;
        let weight = flat.records[record_index].weight;
        discard target.insert(entries[index].first, entries[index].second, weight);
        index += 1;
    }
    destroy entries;
    target.rebuild_aggregates();
    return true;
}


template(V: type, ALPHABET: int)
fn round_trip_ok(source: &const shared Trie{V, ALPHABET}) -> bool: {
    var flat = serialize_trie{V, ALPHABET}(source);
    var rebuilt = Trie{V, ALPHABET}();
    if !deserialize_trie{V, ALPHABET}(flat, rebuilt): {
        destroy flat;
        destroy rebuilt;
        return false;
    }
    let same = rebuilt.size() == source.size();
    assert same;
    prove rebuilt.size() == source.size();
    destroy flat;
    destroy rebuilt;
    return same;
}








template(V: type, ALPHABET: int)
struct TrieStatistics: {

    
    
    fn average_depth(self: &const shared) -> int: {
        if .terminals == 0: {
            return 0;
        }
        return .depth_total * 100 / .terminals;
    }

    
    fn average_fanout(self: &const shared) -> int: {
        let branches = .nodes - .leaves;
        if branches == 0: {
            return 0;
        }
        return .fanout_total * 100 / branches;
    }

    fn leaf_percent(self: &const shared) -> int: {
        if .nodes == 0: {
            return 0;
        }
        return .leaves * 100 / .nodes;
    }

    
    
    fn nodes_per_key(self: &const shared) -> int: {
        if .terminals == 0: {
            return 0;
        }
        return .nodes * 100 / .terminals;
    }

    
    
    fn compression_percent(self: &const shared) -> int: {
        if .nodes == 0: {
            return 0;
        }
        return (.nodes - .compressed_nodes) * 100 / .nodes;
    }

    
    
    fn balanced(self: &const shared) -> bool: {
        if .terminals == 0: {
            return true;
        }
        return .max_depth * 100 <= .average_depth() * 2 + 100;
    }

    
    fn at_depth(self: &const shared, depth: int) -> int: {
        for bucket: &const in .depth_histogram: {
            if bucket.first == depth: {
                return bucket.second;
            }
        }
        return 0;
    }

    
    fn fanout_bucket(self: &const shared, slot: int) -> int: {
        for bucket: &const in .fanout_histogram: {
            if bucket.first == slot: {
                return bucket.second;
            }
        }
        return 0;
    }

    fn record_depth(self: &unique, depth: int): {
        var index: int = 0;
        while index < .depth_histogram.size(): {
            if .depth_histogram[index].first == depth: {
                .depth_histogram[index].second += 1;
                return;
            }
            index += 1;
        }
        .depth_histogram.push_back(pair{int, int}(first: depth, second: 1));
    }

    fn record_fanout(self: &unique, fanout: int): {
        var slot = fanout;
        if slot >= FANOUT_BUCKETS: {
            slot = FANOUT_BUCKETS - 1;
        }
        var index: int = 0;
        while index < .fanout_histogram.size(): {
            if .fanout_histogram[index].first == slot: {
                .fanout_histogram[index].second += 1;
                return;
            }
            index += 1;
        }
        .fanout_histogram.push_back(pair{int, int}(first: slot, second: 1));
    }

    fn describe(self: &const shared) -> string: {
        var text = string();
        text.append("nodes=");
        text.append(to_string(.nodes));
        text.append(" keys=");
        text.append(to_string(.terminals));
        text.append(" leaves=");
        text.append(to_string(.leaves));
        text.append(" maxdepth=");
        text.append(to_string(.max_depth));
        text.append(" avgdepth=");
        text.append(to_string(.average_depth()));
        text.append(" avgfanout=");
        text.append(to_string(.average_fanout()));
        text.append(" nodesperkey=");
        text.append(to_string(.nodes_per_key()));
        return text;
    }

    
    depth_histogram: vector{pair{int, int}};

    
    fanout_histogram: vector{pair{int, int}};

    
    initial_counts: map{char, int};

    
    
    length_groups: map{int, vector{string}};

    
    samples: vector{pair{string, int}};

    nodes: int = 0;
    terminals: int = 0;
    leaves: int = 0;
    branches: int = 0;
    overflow_nodes: int = 0;
    compressed_nodes: int = 0;
    max_depth: int = 0;
    depth_total: int = 0;
    fanout_total: int = 0;
    max_fanout: int = 0;
    weight_total: int = 0;
    key_length_total: int = 0;
}


template(V: type, ALPHABET: int)
fn collect_statistics(index: &const shared Trie{V, ALPHABET}) -> TrieStatistics{V, ALPHABET}: {
    var stats = TrieStatistics{V, ALPHABET}();
    if index.size() == 0: {
        return stats;
    }

    var levels = index.level_order();
    var depth: int = 0;
    while depth < levels.size(): {
        for node: &const in levels[depth]: {
            stats.nodes += 1;
            stats.record_depth(depth);

            let fanout = index.node_at(node).degree();
            stats.fanout_total += fanout;
            stats.record_fanout(fanout);
            if fanout > stats.max_fanout: {
                stats.max_fanout = fanout;
            }
            if fanout == 0: {
                stats.leaves += 1;
            } else: {
                stats.branches += 1;
            }
            if index.node_at(node).sparse_degree() > 0: {
                stats.overflow_nodes += 1;
            }
            if index.node_at(node).is_terminal(): {
                stats.terminals += 1;
                stats.depth_total += depth;
                stats.weight_total += index.node_at(node).weight;
                if depth > stats.max_depth: {
                    stats.max_depth = depth;
                }
            }
        }
        depth += 1;
    }
    destroy levels;

    
    var entries = index.to_pairs();
    for entry: &const in entries: {
        stats.key_length_total += entry.first.size();

        if entry.first.size() > 0: {
            let initial = entry.first.at(0);
            if !stats.initial_counts.contains(initial): {
                discard stats.initial_counts.insert(initial, 0);
            }
            stats.initial_counts.at(initial) += 1;
        }

        let length = entry.first.size();
        if !stats.length_groups.contains(length): {
            var bucket = vector{string}();
            discard stats.length_groups.insert(length, bucket);
            destroy bucket;
        }
        if stats.length_groups.at(length).size() < TRIE_SAMPLE_LIMIT: {
            stats.length_groups.at(length).push_back(entry.first);
        }

        if stats.samples.size() < TRIE_SAMPLE_LIMIT: {
            stats.samples.push_back(pair{string, int}(first: entry.first,
                                                      second: index.weight_of(entry.first)));
        }
    }
    destroy entries;
    return stats;
}



template(V: type, ALPHABET: int)
fn collect_statistics_paired(index: &const shared Trie{V, ALPHABET},
                             mirror: &const shared RadixTree{V, ALPHABET})
        -> TrieStatistics{V, ALPHABET}: {
    var stats = collect_statistics{V, ALPHABET}(index);
    stats.compressed_nodes = mirror.node_count();
    return stats;
}






fn fuzzy_score(weight: int, edits: int, key_length: int, pattern_length: int) -> int: {
    var score = weight;
    score -= edits * SCORE_EDIT_PENALTY;
    let spread = abs(key_length - pattern_length);
    score -= spread * SCORE_LENGTH_PENALTY;
    if edits == 0: {
        score += SCORE_EXACT_BONUS;
    }
    if score < WEIGHT_FLOOR: {
        score = WEIGHT_FLOOR;
    }
    return score;
}



fn edit_distance(a: &const shared string, b: &const shared string) -> int: {
    var previous = vector{int}();
    var index: int = 0;
    while index <= b.size(): {
        previous.push_back(index);
        index += 1;
    }

    var row: int = 1;
    while row <= a.size(): {
        var current = vector{int}();
        current.push_back(row);
        var column: int = 1;
        while column <= b.size(): {
            let deletion = current[column - 1] + 1;
            let insertion = previous[column] + 1;
            var substitution = previous[column - 1];
            if a.at(row - 1) != b.at(column - 1): {
                substitution += 1;
            }
            var best = deletion;
            if insertion < best: {
                best = insertion;
            }
            if substitution < best: {
                best = substitution;
            }
            current.push_back(best);
            column += 1;
        }
        previous.clear();
        for cell: &const in current: {
            previous.push_back(cell);
        }
        destroy current;
        row += 1;
    }

    let answer = previous[b.size()];
    destroy previous;
    return answer;
}




template(V: type)
fn sort_pairs_by_key(entries: &const shared vector{pair{string, V}}) -> vector{pair{string, V}}: {
    var out = vector{pair{string, V}}();
    for entry: &const in entries: {
        var position = out.size();
        var index: int = 0;
        while index < out.size(): {
            if compare_strings(entry.first, out[index].first) < 0: {
                position = index;
                index = out.size();
            } else: {
                index += 1;
            }
        }
        out.insert(position, entry);
    }
    return out;
}


template(V: type)
fn sort_completions(entries: &const shared vector{Completion{V}}) -> vector{Completion{V}}: {
    var out = vector{Completion{V}}();
    for entry: &const in entries: {
        var position = out.size();
        var index: int = 0;
        while index < out.size(): {
            if entry.better_than(out[index]): {
                position = index;
                index = out.size();
            } else: {
                index += 1;
            }
        }
        out.insert(position, entry);
    }
    return out;
}



template(V: type)
fn dedupe_completions(entries: &const shared vector{Completion{V}}) -> vector{Completion{V}}: {
    var out = vector{Completion{V}}();
    var seen = set{string}();
    for entry: &const in entries: {
        if seen.contains(entry.key): {
            discard entry;
        } else: {
            discard seen.insert(entry.key);
            out.push_back(entry);
        }
    }
    destroy seen;
    return out;
}



template(V: type)
fn take_top_k(entries: &const shared vector{Completion{V}}, k: int) -> vector{Completion{V}}: {
    var picker = TopK{V}();
    picker.configure(k);
    for entry: &const in entries: {
        discard picker.offer(entry);
    }
    var out = picker.ranked();
    destroy picker;
    return out;
}


fn common_prefix_of_all(keys: &const shared vector{string}) -> string: {
    var out = string();
    if keys.size() == 0: {
        return out;
    }
    out.append(keys[0]);
    var index: int = 1;
    while index < keys.size(): {
        let shared_len = common_prefix_length(out, keys[index]);
        var trimmed = out.substr(0, shared_len);
        out.clear();
        out.append(trimmed);
        destroy trimmed;
        if out.size() == 0: {
            return out;
        }
        index += 1;
    }
    return out;
}


template(V: type, ALPHABET: int)
fn trie_from_words(words: &const shared vector{string}, value: V) -> Trie{V, ALPHABET}: {
    var index = Trie{V, ALPHABET}();
    index.reserve(TRIE_INITIAL_CAPACITY);
    for word: &const in words: {
        var folded = normalize_key{ALPHABET}(word);
        discard index.insert(folded.first, value, WEIGHT_DEFAULT);
        destroy folded;
    }
    return index;
}




template(V: type, ALPHABET: int)
fn trie_from_text(text: &const shared string, value: V) -> Trie{V, ALPHABET}: {
    var counts = map{string, int}();
    var words = tokenize(text);
    for word: &const in words: {
        if !counts.contains(word): {
            discard counts.insert(word, 0);
        }
        counts.at(word) += 1;
    }
    destroy words;

    var index = Trie{V, ALPHABET}();
    index.reserve(TRIE_INITIAL_CAPACITY);
    for entry: &const in counts: {
        discard index.insert(entry.first, value, entry.second * WEIGHT_SCALE);
    }
    destroy counts;
    index.rebuild_aggregates();
    return index;
}



template(V: type, ALPHABET: int)
fn merge_tries(target: &unique Trie{V, ALPHABET},
               source: &const shared Trie{V, ALPHABET}) -> int: {
    var entries = source.weighted_with_prefix(string());
    var added: int = 0;
    for entry: &const in entries: {
        let existing = target.weight_of(entry.first);
        if existing >= entry.second.second: {
            discard entry;
        } else: {
            if target.insert(entry.first, entry.second.first,
                             entry.second.second) == TrieOutcome::Inserted: {
                added += 1;
            }
        }
    }
    destroy entries;
    target.rebuild_aggregates();
    return added;
}


template(V: type, ALPHABET: int)
fn intersect_tries(left: &const shared Trie{V, ALPHABET},
                   right: &const shared Trie{V, ALPHABET}) -> vector{pair{string, V}}: {
    var out = vector{pair{string, V}}();
    var entries = left.to_pairs();
    for entry: &const in entries: {
        if right.contains(entry.first): {
            out.push_back(entry);
        }
    }
    destroy entries;
    return out;
}


template(V: type, ALPHABET: int)
fn tries_equal(left: &const shared Trie{V, ALPHABET},
               right: &const shared Trie{V, ALPHABET}) -> bool: {
    if left.size() != right.size(): {
        return false;
    }
    var a = left.to_pairs();
    var b = right.to_pairs();
    var same: bool = true;
    var index: int = 0;
    while index < a.size(): {
        if compare_strings(a[index].first, b[index].first) != 0: {
            same = false;
            index = a.size();
        } else: {
            index += 1;
        }
    }
    destroy a;
    destroy b;
    return same;
}



template(V: type, ALPHABET: int)
fn mirrors_agree(index: &const shared Trie{V, ALPHABET},
                 mirror: &const shared RadixTree{V, ALPHABET}) -> bool: {
    if index.size() != mirror.size(): {
        return false;
    }
    var entries = index.to_pairs();
    var agreed: bool = true;
    for entry: &const in entries: {
        if !mirror.contains(entry.first): {
            agreed = false;
        }
    }
    assert agreed;
    prove index.size() == mirror.size();
    destroy entries;
    return agreed;
}


template(V: type, ALPHABET: int)
fn ternary_agrees(index: &const shared Trie{V, ALPHABET},
                  ternary: &const shared TernaryTree{V}) -> bool: {
    if index.size() != ternary.size(): {
        return false;
    }
    var entries = index.to_pairs();
    var agreed: bool = true;
    for entry: &const in entries: {
        if !ternary.contains(entry.first): {
            agreed = false;
        }
    }
    destroy entries;
    return agreed;
}


template(V: type, ALPHABET: int)
fn describe_index(index: &const shared Trie{V, ALPHABET}) -> string: {
    var stats = collect_statistics{V, ALPHABET}(index);
    var text = stats.describe();
    text.append(" alphabet=");
    text.append(to_string(ALPHABET));
    text.append(" balanced=");
    if stats.balanced(): {
        text.append("yes");
    } else: {
        text.append("no");
    }
    destroy stats;
    return text;
}


template(V: type)
fn render_completions(entries: &const shared vector{Completion{V}}) -> vector{string}: {
    var out = vector{string}();
    var rank: int = 1;
    for entry: &const in entries: {
        var line = string();
        line.append(to_string(rank));
        line.append(". ");
        line.append(entry.describe());
        out.push_back(line);
        destroy line;
        rank += 1;
    }
    return out;
}






fn demo_vocabulary() -> vector{string}: {
    var words = vector{string}();
    words.push_back("auto");
    words.push_back("autocomplete");
    words.push_back("autocorrect");
    words.push_back("automatic");
    words.push_back("automaton");
    words.push_back("automobile");
    words.push_back("autonomy");
    words.push_back("bank");
    words.push_back("banker");
    words.push_back("banking");
    words.push_back("bankrupt");
    words.push_back("banner");
    words.push_back("banquet");
    words.push_back("prefix");
    words.push_back("prefixed");
    words.push_back("prefixes");
    words.push_back("preface");
    words.push_back("prefer");
    words.push_back("preference");
    words.push_back("present");
    words.push_back("presenter");
    words.push_back("pressure");
    words.push_back("trie");
    words.push_back("tries");
    words.push_back("trigger");
    words.push_back("trigonometry");
    words.push_back("trim");
    words.push_back("trimmed");
    words.push_back("trivial");
    words.push_back("trivia");
    return words;
}



fn demo_weights() -> map{string, int}: {
    var weights = map{string, int}();
    discard weights.insert("auto", 9000);
    discard weights.insert("autocomplete", 7500);
    discard weights.insert("automatic", 6000);
    discard weights.insert("bank", 8800);
    discard weights.insert("banking", 5200);
    discard weights.insert("prefix", 7100);
    discard weights.insert("present", 6400);
    discard weights.insert("trie", 9500);
    discard weights.insert("trigger", 4300);
    discard weights.insert("trivial", 3900);
    return weights;
}



fn demo_trie_autocomplete(): {
    var words = demo_vocabulary();
    var weights = demo_weights();

    

    var index = Trie{int, 26}();
    index.reserve(TRIE_INITIAL_CAPACITY);
    var rank: int = 0;
    for word: &const in words: {
        var weight = WEIGHT_DEFAULT;
        if weights.contains(word): {
            weight = weights.at(word);
        }
        discard index.insert(word, rank, weight);
        rank += 1;
    }
    index.rebuild_aggregates();
    println(describe_index{int, 26}(index));

    if !index.check_validity(): {
        panic("trie invariants violated after bulk insert");
    }

    
    assert index.contains("automaton");
    assert index.contains_prefix("auto");
    assert !index.contains("automat");
    println(to_string(index.weight_of("trie")));

    
    var extended = index.extend_unambiguously("auto");
    println(extended);
    destroy extended;

    
    var longest = index.longest_matching_prefix("automobiles");
    println(longest.first);
    destroy longest;

    
    var raw = index.keys_with_prefix("ban", 0);
    for entry: &const in raw: {
        println(entry.first);
    }
    destroy raw;

    
    var grouped = index.group_by_initial();
    println(to_string(grouped.size()));
    for bucket: &const in grouped: {
        println(to_string(bucket.second.size()));
    }
    destroy grouped;

    

    let before_nodes = index.node_count();
    assert index.erase("trigonometry");
    let after_nodes = index.node_count();
    assert after_nodes < before_nodes;
    prove after_nodes <= before_nodes;
    println(to_string(before_nodes - after_nodes));

    
    let dropped = index.erase_prefix("pre");
    println(to_string(dropped));
    if !index.check_validity(): {
        panic("trie invariants violated after prefix erase");
    }

    

    var compressed = RadixTree{int, 26}();
    var surviving = index.to_pairs();
    discard compressed.insert_all(surviving);
    destroy surviving;

    if !compressed.check_validity(): {
        panic("radix invariants violated after bulk insert");
    }
    if !mirrors_agree{int, 26}(index, compressed): {
        panic("radix mirror disagrees with the trie");
    }
    println(to_string(index.node_count()));
    println(to_string(compressed.node_count()));

    
    
    discard compressed.add("bankruptcy", 900);
    assert compressed.contains("bankrupt");
    assert compressed.contains("bankruptcy");
    assert compressed.erase("bankruptcy");
    assert compressed.contains("bankrupt");
    if !compressed.check_validity(): {
        panic("radix invariants violated after split and merge");
    }
    println(to_string(compressed.splits));
    println(to_string(compressed.merges));

    
    var matched = compressed.longest_matching_prefix("bankers");
    println(matched.first);
    destroy matched;

    

    var ternary = TernaryTree{int}();
    var again = index.to_pairs();
    discard ternary.insert_all(again);
    destroy again;

    if !ternary.check_validity(): {
        panic("ternary invariants violated after bulk insert");
    }
    if !ternary_agrees{int, 26}(index, ternary): {
        panic("ternary tree disagrees with the trie");
    }

    var ternary_hits = ternary.keys_with_prefix("tri");
    for entry: &const in ternary_hits: {
        println(entry.first);
    }
    destroy ternary_hits;

    var ternary_longest = ternary.longest_matching_prefix("triggered");
    println(ternary_longest);
    destroy ternary_longest;

    
    var index_of_erase: int = 0;
    while index_of_erase < words.size(): {
        if index_of_erase % 3 == 0: {
            discard ternary.erase(words[index_of_erase]);
        }
        index_of_erase += 1;
    }
    println(to_string(ternary.compact()));
    if !ternary.check_validity(): {
        panic("ternary invariants violated after compaction");
    }

    

    var engine = Autocomplete{string, 26}();
    for word: &const in words: {
        var weight = WEIGHT_DEFAULT;
        if weights.contains(word): {
            weight = weights.at(word);
        }
        var payload = string();
        payload.append(word);
        discard engine.learn(word, payload, weight);
        destroy payload;
    }

    engine.add_alias("auto", "automatic");
    engine.add_alias("auto", "autocomplete");
    discard engine.record_selection("autocomplete");
    discard engine.record_selection("autocomplete");
    discard engine.record_selection("trie");

    var ranked = engine.suggest("auto", DEFAULT_TOP_K);
    var lines = render_completions{string}(ranked);
    for line: &const in lines: {
        println(line);
    }
    destroy lines;
    destroy ranked;

    
    var first_pass = engine.suggest_cached("ban", 4);
    var second_pass = engine.suggest_cached("ban", 4);
    assert first_pass.size() == second_pass.size();
    prove first_pass.size() == second_pass.size();
    destroy first_pass;
    destroy second_pass;
    println(engine.describe());

    
    var expanded = engine.suggest_with_aliases("auto", 3);
    for entry: &const in expanded: {
        println(entry.first);
        println(to_string(entry.second.size()));
    }
    destroy expanded;

    
    var inline_text = engine.inline_completion("banq");
    println(inline_text);
    destroy inline_text;

    
    var segments = engine.segment("autotrieprefix");
    for segment: &const in segments: {
        println(segment.first);
        println(to_string(segment.second));
    }
    destroy segments;

    

    var matcher = FuzzyMatcher{string, 26}();
    matcher.configure(DEFAULT_EDIT_BUDGET);
    var fuzzy = matcher.search_top(engine.trie(), "automatik", 5);
    for entry: &const in fuzzy: {
        println(entry.describe());
        
        assert entry.edits == edit_distance(entry.key, "automatik");
        prove entry.edits <= DEFAULT_EDIT_BUDGET;
    }
    println(to_string(matcher.nodes_visited));
    println(to_string(matcher.subtrees_pruned));
    destroy fuzzy;
    destroy matcher;

    
    var corrected = engine.suggest_or_correct("bnk", 4);
    var corrected_lines = render_completions{string}(corrected);
    for line: &const in corrected_lines: {
        println(line);
    }
    destroy corrected_lines;
    destroy corrected;

    

    var flat = serialize_trie{int, 26}(index);
    println(flat.describe());
    assert flat.header_valid();

    var replayed = Trie{int, 26}();
    if !deserialize_trie{int, 26}(flat, replayed): {
        panic("failed to replay the serialised trie");
    }
    if !tries_equal{int, 26}(index, replayed): {
        panic("serialisation round trip lost keys");
    }
    assert round_trip_ok{int, 26}(index);
    println(to_string(replayed.size()));

    
    var recovered = flat.entries();
    println(to_string(recovered.size()));
    destroy recovered;
    destroy flat;

    

    var stats = collect_statistics_paired{int, 26}(index, compressed);
    println(stats.describe());
    println(to_string(stats.compression_percent()));
    println(to_string(stats.leaf_percent()));
    println(to_string(stats.max_fanout));
    for bucket: &const in stats.depth_histogram: {
        println(to_string(bucket.first));
        println(to_string(bucket.second));
    }
    for bucket: &const in stats.fanout_histogram: {
        println(to_string(bucket.second));
    }
    for sample: &const in stats.samples: {
        println(sample.first);
        println(to_string(sample.second));
    }
    for group: &const in stats.length_groups: {
        println(to_string(group.first));
        println(to_string(group.second.size()));
    }
    destroy stats;

    

    
    
    var wide = trie_from_words{int, 128}(words, 0);
    discard wide.add("read-only", 1);
    discard wide.add("read_write", 2);
    discard wide.add("read.me", 3);
    wide.rebuild_aggregates();
    println(describe_index{int, 128}(wide));
    assert wide.contains("read-only");
    assert wide.contains_prefix("read");

    var wide_hits = wide.keys_with_prefix("read", 0);
    println(to_string(wide_hits.size()));
    destroy wide_hits;

    
    println(to_string(merge_tries{int, 128}(wide, index)));
    if !wide.check_validity(): {
        panic("wide trie invariants violated after merge");
    }

    
    var shared_keys = intersect_tries{int, 128}(wide, wide);
    println(to_string(shared_keys.size()));
    destroy shared_keys;

    

    var document = string();
    document.append("the trie indexes the text; ");
    document.append("the text indexes the trie.\n");
    document.append("prefix queries over the trie beat scanning the text.");
    var from_text = trie_from_text{int, 26}(document, 0);
    println(describe_index{int, 26}(from_text));

    var vocabulary = from_text.to_pairs();
    var just_keys = vector{string}();
    for entry: &const in vocabulary: {
        just_keys.push_back(entry.first);
    }
    var shared_prefix = common_prefix_of_all(just_keys);
    println(to_string(shared_prefix.size()));
    destroy shared_prefix;
    destroy just_keys;
    destroy vocabulary;

    
    println(to_string(engine.age()));
    println(engine.describe());

    destroy from_text;
    destroy document;
    destroy wide;
    destroy replayed;
    destroy engine;
    destroy ternary;
    destroy compressed;
    destroy index;
    destroy weights;
    destroy words;
}

}













namespace unicode: {






static CODE_POINT_MAX: int = 1114111;          
static CODE_POINT_COUNT: int = 1114112;        
static BMP_MAX: int = 65535;                   
static PLANE_SIZE: int = 65536;                
static PLANE_COUNT: int = 17;
static REPLACEMENT: int = 65533;               
static MAX_ASCII: int = 127;                   
static MAX_LATIN1: int = 255;                  

static SURROGATE_FIRST: int = 55296;           
static SURROGATE_LAST: int = 57343;            
static HIGH_SURROGATE_FIRST: int = 55296;      
static HIGH_SURROGATE_LAST: int = 56319;       
static LOW_SURROGATE_FIRST: int = 56320;       
static LOW_SURROGATE_LAST: int = 57343;        
static SURROGATE_BLOCK_SIZE: int = 1024;       
static SURROGATE_BASE: int = 65536;            



static SURROGATE_BIAS: int = 65536;            
static SURROGATE_MASK: int = 1023;             
static SURROGATE_SHIFT: int = 10;









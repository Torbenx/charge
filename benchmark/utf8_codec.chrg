// A Unicode text library: UTF-8 encoding and decoding with full validation,
// UTF-16 and UTF-32 conversion, code point classification, case mapping,
// grapheme cluster segmentation, a canonical normalisation sketch, display
// width calculation and byte order mark handling.
//
// Every numeric constant is written in plain decimal because the charge lexer
// only accepts that notation. Where a value is conventionally written in
// hexadecimal the hexadecimal spelling follows in a comment, so the tables
// below can still be checked against the Unicode data files by eye.
//
// The library is deliberately table driven: classification, decomposition and
// width are all expressed as explicit range entries pushed into vectors at
// start up, and the hot paths are bit manipulations over those tables.
namespace unicode: {

// --- Scalar bounds -------------------------------------------------------
//
// The Unicode code space is 0 .. 10FFFF with the surrogate block carved out of
// the middle of the basic multilingual plane.

static CODE_POINT_MAX: int = 1114111;          // 0x10FFFF
static CODE_POINT_COUNT: int = 1114112;        // 0x110000
static BMP_MAX: int = 65535;                   // 0xFFFF
static PLANE_SIZE: int = 65536;                // 0x10000
static PLANE_COUNT: int = 17;
static REPLACEMENT: int = 65533;               // 0xFFFD
static MAX_ASCII: int = 127;                   // 0x7F
static MAX_LATIN1: int = 255;                  // 0xFF

static SURROGATE_FIRST: int = 55296;           // 0xD800
static SURROGATE_LAST: int = 57343;            // 0xDFFF
static HIGH_SURROGATE_FIRST: int = 55296;      // 0xD800
static HIGH_SURROGATE_LAST: int = 56319;       // 0xDBFF
static LOW_SURROGATE_FIRST: int = 56320;       // 0xDC00
static LOW_SURROGATE_LAST: int = 57343;        // 0xDFFF
static SURROGATE_BLOCK_SIZE: int = 1024;       // 0x400
static SURROGATE_BASE: int = 65536;            // 0x10000

// The two-word form of a supplementary code point subtracts this bias before
// splitting the remainder into ten high bits and ten low bits.
static SURROGATE_BIAS: int = 65536;            // 0x10000
static SURROGATE_MASK: int = 1023;             // 0x3FF
static SURROGATE_SHIFT: int = 10;

// --- UTF-8 bit layout ----------------------------------------------------
//
//   0xxxxxxx                                one byte,    7 payload bits
//   110xxxxx 10xxxxxx                       two bytes,  11 payload bits
//   1110xxxx 10xxxxxx 10xxxxxx              three bytes,16 payload bits
//   11110xxx 10xxxxxx 10xxxxxx 10xxxxxx     four bytes, 21 payload bits

static UTF8_MAX_LENGTH: int = 4;
static UTF8_ONE_MAX: int = 127;                // 0x7F
static UTF8_TWO_MAX: int = 2047;               // 0x7FF
static UTF8_THREE_MAX: int = 65535;            // 0xFFFF
static UTF8_FOUR_MAX: int = 1114111;           // 0x10FFFF

static CONT_MARK: int = 128;                   // 0x80
static CONT_MASK: int = 192;                   // 0xC0
static CONT_PAYLOAD_MASK: int = 63;            // 0x3F
static CONT_BITS: int = 6;

static LEAD_TWO_MARK: int = 192;               // 0xC0
static LEAD_TWO_MASK: int = 224;               // 0xE0
static LEAD_TWO_PAYLOAD: int = 31;             // 0x1F

static LEAD_THREE_MARK: int = 224;             // 0xE0
static LEAD_THREE_MASK: int = 240;             // 0xF0
static LEAD_THREE_PAYLOAD: int = 15;           // 0x0F

static LEAD_FOUR_MARK: int = 240;              // 0xF0
static LEAD_FOUR_MASK: int = 248;              // 0xF8
static LEAD_FOUR_PAYLOAD: int = 7;             // 0x07

static ASCII_MASK: int = 128;                  // 0x80
static BYTE_MASK: int = 255;                   // 0xFF
static NIBBLE_MASK: int = 15;                  // 0x0F
static WORD_MASK: int = 65535;                 // 0xFFFF
static DWORD_MASK: int = 4294967295;           // 0xFFFFFFFF
static QWORD_MASK: int = 18446744073709551615; // 0xFFFFFFFFFFFFFFFF

// A whole machine word of bytes at a time: these constants let the fast ASCII
// scan test eight bytes with two operations.
static HIGH_BIT_EACH_BYTE: int = 9259542123273814144;   // 0x8080808080808080
static LOW_BIT_EACH_BYTE: int = 72340172838076673;      // 0x0101010101010101
static SEVEN_BITS_EACH_BYTE: int = 9187201950435737471; // 0x7F7F7F7F7F7F7F7F

// --- Byte order marks ----------------------------------------------------

static BOM_CODE_POINT: int = 65279;            // 0xFEFF
static BOM_SWAPPED: int = 65534;               // 0xFFFE, never a valid scalar
static BOM_UTF8_LENGTH: int = 3;
static BOM_UTF16_LENGTH: int = 2;
static BOM_UTF32_LENGTH: int = 4;

static BOM_UTF8_BYTE_0: int = 239;             // 0xEF
static BOM_UTF8_BYTE_1: int = 187;             // 0xBB
static BOM_UTF8_BYTE_2: int = 191;             // 0xBF

static BOM_UTF16_BE_BYTE_0: int = 254;         // 0xFE
static BOM_UTF16_BE_BYTE_1: int = 255;         // 0xFF
static BOM_UTF16_LE_BYTE_0: int = 255;         // 0xFF
static BOM_UTF16_LE_BYTE_1: int = 254;         // 0xFE

// --- Named characters ----------------------------------------------------
//
// The scanners compare raw characters constantly, so each one gets a name.
// The escaped apostrophe character literal is not spelled here; the library
// keeps it as a one character string instead.

static CHAR_NUL: char = '\0';
static CHAR_TAB: char = '\t';
static CHAR_NEWLINE: char = '\n';
static CHAR_RETURN: char = '\r';
static CHAR_SPACE: char = ' ';
static CHAR_QUOTE: char = '"';
static CHAR_BACKSLASH: char = '\\';
static CHAR_SLASH: char = '/';
static CHAR_MINUS: char = '-';
static CHAR_PLUS: char = '+';
static CHAR_DOT: char = '.';
static CHAR_COMMA: char = ',';
static CHAR_COLON: char = ':';
static CHAR_SEMICOLON: char = ';';
static CHAR_UNDERSCORE: char = '_';
static CHAR_QUESTION: char = '?';
static CHAR_BANG: char = '!';
static CHAR_STAR: char = '*';
static CHAR_PERCENT: char = '%';
static CHAR_AMPERSAND: char = '&';
static CHAR_AT: char = '@';
static CHAR_HASH: char = '#';
static CHAR_DOLLAR: char = '$';
static CHAR_CARET: char = '^';
static CHAR_TILDE: char = '~';
static CHAR_PIPE: char = '|';
static CHAR_EQUALS: char = '=';
static CHAR_LESS: char = '<';
static CHAR_GREATER: char = '>';
static CHAR_LPAREN: char = '(';
static CHAR_RPAREN: char = ')';
static CHAR_LBRACKET: char = '[';
static CHAR_RBRACKET: char = ']';
static CHAR_LBRACE: char = '{';
static CHAR_RBRACE: char = '}';
static CHAR_BACKTICK: char = '`';

static CHAR_ZERO: char = '0';
static CHAR_ONE: char = '1';
static CHAR_SEVEN: char = '7';
static CHAR_NINE: char = '9';
static CHAR_LOWER_A: char = 'a';
static CHAR_LOWER_F: char = 'f';
static CHAR_LOWER_X: char = 'x';
static CHAR_LOWER_Z: char = 'z';
static CHAR_UPPER_A: char = 'A';
static CHAR_UPPER_F: char = 'F';
static CHAR_UPPER_X: char = 'X';
static CHAR_UPPER_Z: char = 'Z';

// The single quote and a few other awkward spellings live as strings.
static APOSTROPHE: string = "'";
static TEXT_EMPTY: string = "";
static TEXT_SPACE: string = " ";
static TEXT_NEWLINE: string = "\n";
static TEXT_TAB: string = "\t";
static TEXT_ELLIPSIS: string = "...";
static TEXT_REPLACEMENT: string = "<U+FFFD>";
static TEXT_PREFIX: string = "U+";

// --- Error and status codes ----------------------------------------------

// Every way a byte sequence can fail to be UTF-8. The decoder reports the
// most specific code it can, because "invalid UTF-8" alone is useless in a
// diagnostic.
enum DecodeError: {
    None;
    TruncatedSequence;          // ran out of bytes mid sequence
    UnexpectedContinuation;     // a 10xxxxxx byte where a lead was expected
    InvalidLeadByte;            // 0xC0, 0xC1, 0xF5 .. 0xFF
    MissingContinuation;        // a lead byte followed by a non continuation
    OverlongEncoding;           // a scalar spelled with more bytes than needed
    SurrogateCodePoint;         // D800 .. DFFF encoded directly, CESU-8 style
    CodePointTooLarge;          // beyond 10FFFF
    UnpairedHighSurrogate;
    UnpairedLowSurrogate;
    BufferTooSmall;
    EmptyInput;
}

// The decoder is a small deterministic automaton. Accept is the only state in
// which a code point may be handed to the caller.
enum DecodeState: {
    Accept = 0;
    Reject = 1;
    NeedOne = 2;
    NeedTwo = 3;
    NeedThree = 4;
    NeedTwoOfThreeLow;          // three byte form, lead was 0xE0
    NeedTwoOfThreeHigh;         // three byte form, lead was 0xED
    NeedThreeOfFourLow;         // four byte form, lead was 0xF0
    NeedThreeOfFourHigh;        // four byte form, lead was 0xF4
}

// What a lead byte says about the sequence that follows it.
enum ByteClass: {
    Ascii;
    Continuation;
    LeadTwo;
    LeadThree;
    LeadThreeLowBound;
    LeadThreeSurrogate;
    LeadFour;
    LeadFourLowBound;
    LeadFourHighBound;
    Illegal;
}

// Result of sniffing the first few bytes of a stream.
enum Encoding: {
    Unknown;
    Utf8;
    Utf8WithBom;
    Utf16Big;
    Utf16Little;
    Utf32Big;
    Utf32Little;
    Ascii;
}

// General category, collapsed to the groups this library actually needs.
enum Category: {
    Unassigned;
    UppercaseLetter;
    LowercaseLetter;
    TitlecaseLetter;
    ModifierLetter;
    OtherLetter;
    NonspacingMark;
    SpacingMark;
    EnclosingMark;
    DecimalNumber;
    LetterNumber;
    OtherNumber;
    ConnectorPunctuation;
    DashPunctuation;
    OpenPunctuation;
    ClosePunctuation;
    InitialPunctuation;
    FinalPunctuation;
    OtherPunctuation;
    MathSymbol;
    CurrencySymbol;
    ModifierSymbol;
    OtherSymbol;
    SpaceSeparator;
    LineSeparator;
    ParagraphSeparator;
    Control;
    Format;
    Surrogate;
    PrivateUse;
}

// Grapheme cluster break property, the subset needed for the extended rules.
enum GraphemeBreak: {
    Other;
    ControlBreak;
    CarriageReturn;
    LineFeed;
    Extend;
    ZeroWidthJoiner;
    RegionalIndicator;
    Prepend;
    SpacingMarkBreak;
    HangulL;
    HangulV;
    HangulT;
    HangulLV;
    HangulLVT;
    ExtendedPictographic;
}

// Word break property, again reduced to what the word iterator uses.
enum WordBreak: {
    Any;
    CarriageReturnWord;
    LineFeedWord;
    NewlineWord;
    ExtendWord;
    ZeroWidthJoinerWord;
    RegionalWord;
    FormatWord;
    Katakana;
    HebrewLetter;
    ALetter;
    SingleQuoteWord;
    DoubleQuoteWord;
    MidNumLet;
    MidLetter;
    MidNum;
    Numeric;
    ExtendNumLet;
    WhiteSpaceWord;
}

// East Asian width, which drives the terminal column count.
enum WidthClass: {
    Neutral;
    Narrow;
    HalfWidth;
    Wide;
    FullWidth;
    Ambiguous;
    ZeroWidth;
}

// Canonical combining class buckets. The real property is an integer from 0 to
// 240; only the values that appear in the small table below are named.
enum CombiningClass: {
    NotReordered = 0;
    Overlay = 1;
    Nukta = 7;
    KanaVoicing = 8;
    Virama = 9;
    AttachedBelow = 202;
    AttachedAbove = 214;
    AttachedAboveRight = 216;
    BelowLeft = 218;
    Below = 220;
    BelowRight = 222;
    Left = 224;
    Right = 226;
    AboveLeft = 228;
    Above = 230;
    AboveRight = 232;
    DoubleBelow = 233;
    DoubleAbove = 234;
    IotaSubscript = 240;
}

// Which normal form a transformation targets.
enum NormalForm: {
    None;
    Nfd;
    Nfc;
    Nfkd;
    Nfkc;
}

// Endianness of a 16 or 32 bit code unit stream.
enum ByteOrder: {
    Big;
    Little;
    Native;
}

// --- Core value types ----------------------------------------------------

// A decoded scalar together with how many bytes it consumed. A length of zero
// always means the error field is set.
struct Decoded: {

    fn ok(self: &const shared) -> bool: {
        return .error == DecodeError::None;
    }

    fn failed(self: &const shared) -> bool: {
        return .error != DecodeError::None;
    }

    fn is_ascii(self: &const shared) -> bool: {
        return .value >= 0 && .value <= MAX_ASCII;
    }

    fn is_bmp(self: &const shared) -> bool: {
        return .value >= 0 && .value <= BMP_MAX;
    }

    fn needs_surrogate_pair(self: &const shared) -> bool: {
        return .value > BMP_MAX && .value <= CODE_POINT_MAX;
    }

    value: int = 0;
    length: int = 0;
    error: DecodeError = DecodeError::None;
}

// The four byte staging buffer an encoder writes into. Keeping the bytes in a
// struct rather than a vector avoids an allocation for the common case.
struct Encoded: {

    fn at(self: &const shared, index: int) -> int: {
        if index == 0: {
            return .byte0;
        }
        if index == 1: {
            return .byte1;
        }
        if index == 2: {
            return .byte2;
        }
        if index == 3: {
            return .byte3;
        }
        return 0;
    }

    fn set(self: &unique, index: int, value: int): {
        let masked = value & BYTE_MASK;
        if index == 0: {
            .byte0 = masked;
        } else: {
            if index == 1: {
                .byte1 = masked;
            } else: {
                if index == 2: {
                    .byte2 = masked;
                } else: {
                    .byte3 = masked;
                }
            }
        }
    }

    // Pack the sequence into one integer, most significant byte first. Handy
    // for table driven tests and for hashing short sequences.
    fn packed(self: &const shared) -> int: {
        var out: int = 0;
        for i in range(0, .length): {
            out = (out << 8) | (.at(i) & BYTE_MASK);
        }
        return out;
    }

    fn ok(self: &const shared) -> bool: {
        return .error == DecodeError::None && .length > 0;
    }

    byte0: int = 0;
    byte1: int = 0;
    byte2: int = 0;
    byte3: int = 0;
    length: int = 0;
    error: DecodeError = DecodeError::None;
}

// A byte offset paired with the line and column it lands on, so that a codec
// error can be reported the way a compiler would report it.
struct Position: {

    fn advance_byte(self: &unique, value: int): {
        .offset += 1;
        if value == 10: {
            .line += 1;
            .column = 1;
        } else: {
            if (value & CONT_MASK) != CONT_MARK: {
                .column += 1;
            }
        }
    }

    fn advance_scalar(self: &unique, scalar: int, length: int): {
        .offset += length;
        if scalar == 10: {
            .line += 1;
            .column = 1;
        } else: {
            .column += 1;
        }
    }

    fn describe(self: &const shared) -> string: {
        var out: string = "line ";
        out.append(to_string(.line));
        out.append(", column ");
        out.append(to_string(.column));
        out.append(" (byte ");
        out.append(to_string(.offset));
        out.append(")");
        return out;
    }

    offset: int = 0;
    line: int = 1;
    column: int = 1;
}

// A half open range of code points carrying one property value. Every table in
// this file is a vector of one of the range structs below.
struct CategoryRange: {
    first: int = 0;
    last: int = 0;
    category: Category = Category::Unassigned;
}

struct WidthRange: {
    first: int = 0;
    last: int = 0;
    width: WidthClass = WidthClass::Neutral;
}

struct BreakRange: {
    first: int = 0;
    last: int = 0;
    property: GraphemeBreak = GraphemeBreak::Other;
}

struct WordRange: {
    first: int = 0;
    last: int = 0;
    property: WordBreak = WordBreak::Any;
}

struct CombiningRange: {
    first: int = 0;
    last: int = 0;
    combining: int = 0;
}

// One row of the case mapping table. A delta of zero with a target of minus
// one means "no mapping"; special casing lives in a separate table because a
// single code point can expand to three.
struct CaseRow: {
    first: int = 0;
    last: int = 0;
    step: int = 1;
    lower_delta: int = 0;
    upper_delta: int = 0;
    title_delta: int = 0;
}

// A code point whose case mapping is longer than one code point.
struct SpecialCaseRow: {
    source: int = 0;
    upper0: int = 0;
    upper1: int = 0;
    upper2: int = 0;
    lower0: int = 0;
    lower1: int = 0;
    lower2: int = 0;
    note: string;
}

// One canonical decomposition: source expands to first plus second. A second
// of zero marks a singleton decomposition.
struct DecompositionRow: {
    source: int = 0;
    first: int = 0;
    second: int = 0;
    compatibility: bool = false;
    note: string;
}

// The result of one grapheme, word or code point step over a buffer.
struct Step: {
    begin: int = 0;
    end: int = 0;
    valid: bool = true;
}

// --- Raw byte predicates -------------------------------------------------
//
// These are the primitives every other layer is built from. They are written
// as masked comparisons rather than range tests because that is what the
// generated code should look like.

fn is_ascii_byte(b: int) => (b & ASCII_MASK) == 0;

fn is_continuation_byte(b: int) => (b & CONT_MASK) == CONT_MARK;

fn is_lead_two(b: int) => (b & LEAD_TWO_MASK) == LEAD_TWO_MARK;

fn is_lead_three(b: int) => (b & LEAD_THREE_MASK) == LEAD_THREE_MARK;

fn is_lead_four(b: int) => (b & LEAD_FOUR_MASK) == LEAD_FOUR_MARK;

// 0xC0 and 0xC1 can only ever begin an overlong two byte form, and anything
// from 0xF5 up would decode past 0x10FFFF. Both are rejected at the lead byte
// so the decoder never has to build the scalar first.
fn is_illegal_byte(b: int) -> bool: {
    if b == 192 || b == 193: {                 // 0xC0, 0xC1
        return true;
    }
    if b >= 245 && b <= 255: {                 // 0xF5 .. 0xFF
        return true;
    }
    return b < 0 || b > BYTE_MASK;
}

fn continuation_payload(b: int) => b & CONT_PAYLOAD_MASK;

fn make_continuation(payload: int) => CONT_MARK | (payload & CONT_PAYLOAD_MASK);

// How many bytes the sequence starting with this lead byte occupies. Zero
// means the byte cannot start a sequence at all.
fn sequence_length(lead: int) -> int: {
    if (lead & ASCII_MASK) == 0: {
        return 1;
    }
    if (lead & CONT_MASK) == CONT_MARK: {
        return 0;
    }
    if (lead & LEAD_TWO_MASK) == LEAD_TWO_MARK: {
        return 2;
    }
    if (lead & LEAD_THREE_MASK) == LEAD_THREE_MARK: {
        return 3;
    }
    if (lead & LEAD_FOUR_MASK) == LEAD_FOUR_MARK: {
        return 4;
    }
    return 0;
}

// The payload bits carried by a lead byte, once its marker prefix is stripped.
fn lead_payload(lead: int, length: int) -> int: {
    if length == 1: {
        return lead & MAX_ASCII;
    }
    if length == 2: {
        return lead & LEAD_TWO_PAYLOAD;
    }
    if length == 3: {
        return lead & LEAD_THREE_PAYLOAD;
    }
    if length == 4: {
        return lead & LEAD_FOUR_PAYLOAD;
    }
    return 0;
}

// Classify a lead byte into the buckets the state machine switches on. The
// four boundary classes exist because 0xE0, 0xED, 0xF0 and 0xF4 each constrain
// the range of their first continuation byte.
fn classify_byte(b: int) -> ByteClass: {
    if b >= 0 && b <= 127: {                   // 0x00 .. 0x7F
        return ByteClass::Ascii;
    }
    if b >= 128 && b <= 191: {                 // 0x80 .. 0xBF
        return ByteClass::Continuation;
    }
    if b >= 192 && b <= 193: {                 // 0xC0 .. 0xC1
        return ByteClass::Illegal;
    }
    if b >= 194 && b <= 223: {                 // 0xC2 .. 0xDF
        return ByteClass::LeadTwo;
    }
    if b == 224: {                             // 0xE0
        return ByteClass::LeadThreeLowBound;
    }
    if b >= 225 && b <= 236: {                 // 0xE1 .. 0xEC
        return ByteClass::LeadThree;
    }
    if b == 237: {                             // 0xED
        return ByteClass::LeadThreeSurrogate;
    }
    if b >= 238 && b <= 239: {                 // 0xEE .. 0xEF
        return ByteClass::LeadThree;
    }
    if b == 240: {                             // 0xF0
        return ByteClass::LeadFourLowBound;
    }
    if b >= 241 && b <= 243: {                 // 0xF1 .. 0xF3
        return ByteClass::LeadFour;
    }
    if b == 244: {                             // 0xF4
        return ByteClass::LeadFourHighBound;
    }
    return ByteClass::Illegal;
}

// The legal range of the first continuation byte, given the lead class. Both
// bounds are inclusive.
fn continuation_low_bound(class: ByteClass) -> int: {
    if class == ByteClass::LeadThreeLowBound: {
        return 160;                            // 0xA0, blocks overlong 3 byte
    }
    if class == ByteClass::LeadFourLowBound: {
        return 144;                            // 0x90, blocks overlong 4 byte
    }
    return 128;                                // 0x80
}

fn continuation_high_bound(class: ByteClass) -> int: {
    if class == ByteClass::LeadThreeSurrogate: {
        return 159;                            // 0x9F, blocks D800 .. DFFF
    }
    if class == ByteClass::LeadFourHighBound: {
        return 143;                            // 0x8F, blocks above 0x10FFFF
    }
    return 191;                                // 0xBF
}

// --- Encoding ------------------------------------------------------------

// How many bytes this scalar needs in UTF-8. Returns zero for values that must
// not be encoded at all: surrogates and anything past the code space.
fn encoded_length(scalar: int) -> int: {
    if scalar < 0: {
        return 0;
    }
    if scalar <= UTF8_ONE_MAX: {
        return 1;
    }
    if scalar <= UTF8_TWO_MAX: {
        return 2;
    }
    if scalar >= SURROGATE_FIRST && scalar <= SURROGATE_LAST: {
        return 0;
    }
    if scalar <= UTF8_THREE_MAX: {
        return 3;
    }
    if scalar <= UTF8_FOUR_MAX: {
        return 4;
    }
    return 0;
}

// The same question asked of UTF-16: one code unit, or a surrogate pair.
fn utf16_length(scalar: int) -> int: {
    if scalar < 0 || scalar > CODE_POINT_MAX: {
        return 0;
    }
    if scalar >= SURROGATE_FIRST && scalar <= SURROGATE_LAST: {
        return 0;
    }
    if scalar <= BMP_MAX: {
        return 1;
    }
    return 2;
}

fn is_valid_scalar(scalar: int) -> bool: {
    if scalar < 0 || scalar > CODE_POINT_MAX: {
        return false;
    }
    return scalar < SURROGATE_FIRST || scalar > SURROGATE_LAST;
}

fn is_surrogate(scalar: int) => scalar >= SURROGATE_FIRST && scalar <= SURROGATE_LAST;

fn is_high_surrogate(scalar: int) => scalar >= HIGH_SURROGATE_FIRST && scalar <= HIGH_SURROGATE_LAST;

fn is_low_surrogate(scalar: int) => scalar >= LOW_SURROGATE_FIRST && scalar <= LOW_SURROGATE_LAST;

// A noncharacter is a valid scalar that no interchange format should carry.
// The block at FDD0 .. FDEF plus the last two of every plane.
fn is_noncharacter(scalar: int) -> bool: {
    if scalar >= 64976 && scalar <= 65007: {   // 0xFDD0 .. 0xFDEF
        return true;
    }
    let low = scalar & WORD_MASK;
    return low == 65534 || low == 65535;       // 0xFFFE, 0xFFFF
}

// Encode one scalar into the staging buffer. Every branch writes the marker
// bits and the payload bits separately so the layout stays readable.
fn encode(scalar: int) -> Encoded: {
    var out: Encoded;
    if scalar < 0: {
        out.error = DecodeError::CodePointTooLarge;
        return out;
    }
    if scalar > CODE_POINT_MAX: {
        out.error = DecodeError::CodePointTooLarge;
        return out;
    }
    if scalar >= SURROGATE_FIRST && scalar <= SURROGATE_LAST: {
        out.error = DecodeError::SurrogateCodePoint;
        return out;
    }
    if scalar <= UTF8_ONE_MAX: {
        out.byte0 = scalar & MAX_ASCII;
        out.length = 1;
        return out;
    }
    if scalar <= UTF8_TWO_MAX: {
        out.byte0 = LEAD_TWO_MARK | ((scalar >> 6) & LEAD_TWO_PAYLOAD);
        out.byte1 = CONT_MARK | (scalar & CONT_PAYLOAD_MASK);
        out.length = 2;
        return out;
    }
    if scalar <= UTF8_THREE_MAX: {
        out.byte0 = LEAD_THREE_MARK | ((scalar >> 12) & LEAD_THREE_PAYLOAD);
        out.byte1 = CONT_MARK | ((scalar >> 6) & CONT_PAYLOAD_MASK);
        out.byte2 = CONT_MARK | (scalar & CONT_PAYLOAD_MASK);
        out.length = 3;
        return out;
    }
    out.byte0 = LEAD_FOUR_MARK | ((scalar >> 18) & LEAD_FOUR_PAYLOAD);
    out.byte1 = CONT_MARK | ((scalar >> 12) & CONT_PAYLOAD_MASK);
    out.byte2 = CONT_MARK | ((scalar >> 6) & CONT_PAYLOAD_MASK);
    out.byte3 = CONT_MARK | (scalar & CONT_PAYLOAD_MASK);
    out.length = 4;
    return out;
}

// Append one scalar to a byte vector, substituting the replacement character
// when the scalar is not encodable. Returns the number of bytes written.
fn encode_into(sink: &unique vector{int}, scalar: int) -> int: {
    var packet = encode(scalar);
    if packet.error != DecodeError::None: {
        packet = encode(REPLACEMENT);
    }
    for i in range(0, packet.length): {
        sink.push_back(packet.at(i));
    }
    return packet.length;
}

// Encode a whole vector of scalars. Invalid scalars become U+FFFD rather than
// aborting the whole run, which is what a text pipeline usually wants.
fn encode_all(scalars: &const shared vector{int}) -> vector{int}: {
    var out: vector{int};
    out.reserve(scalars.size() * 2);
    for scalar: &const in scalars: {
        discard encode_into(out, scalar);
    }
    return out;
}

// The lossless variant: the first bad scalar stops the run and is reported.
fn encode_strict(scalars: &const shared vector{int}, sink: &unique vector{int}) -> Decoded: {
    var report: Decoded;
    var index: int = 0;
    for scalar: &const in scalars: {
        let packet = encode(scalar);
        if packet.error != DecodeError::None: {
            report.error = packet.error;
            report.value = scalar;
            report.length = index;
            return report;
        }
        for i in range(0, packet.length): {
            sink.push_back(packet.at(i));
        }
        index += 1;
    }
    report.length = index;
    return report;
}

// --- Decoding ------------------------------------------------------------

// The smallest scalar that a sequence of the given length is allowed to carry.
// A decoded value below this bound means the encoder padded the sequence, and
// the whole point of the overlong check is that such padding is a security
// hole rather than a harmless variation.
fn minimum_for_length(length: int) -> int: {
    if length == 1: {
        return 0;
    }
    if length == 2: {
        return 128;                            // 0x80
    }
    if length == 3: {
        return 2048;                           // 0x800
    }
    if length == 4: {
        return 65536;                          // 0x10000
    }
    return CODE_POINT_MAX + 1;
}

fn maximum_for_length(length: int) -> int: {
    if length == 1: {
        return UTF8_ONE_MAX;
    }
    if length == 2: {
        return UTF8_TWO_MAX;
    }
    if length == 3: {
        return UTF8_THREE_MAX;
    }
    if length == 4: {
        return UTF8_FOUR_MAX;
    }
    return -1;
}

// Decode one sequence beginning at offset. This is the reference decoder: the
// state machine further down must agree with it byte for byte.
fn decode_at(bytes: &const shared vector{int}, offset: int) -> Decoded: {
    var out: Decoded;
    if offset < 0 || offset >= bytes.size(): {
        out.error = DecodeError::EmptyInput;
        return out;
    }

    let lead = bytes.at(offset) & BYTE_MASK;

    // The overwhelmingly common case, kept first and kept short.
    if (lead & ASCII_MASK) == 0: {
        out.value = lead;
        out.length = 1;
        return out;
    }

    if (lead & CONT_MASK) == CONT_MARK: {
        out.error = DecodeError::UnexpectedContinuation;
        out.length = 1;
        return out;
    }

    if is_illegal_byte(lead): {
        out.error = DecodeError::InvalidLeadByte;
        out.length = 1;
        return out;
    }

    let length = sequence_length(lead);
    if length == 0: {
        out.error = DecodeError::InvalidLeadByte;
        out.length = 1;
        return out;
    }

    if offset + length > bytes.size(): {
        out.error = DecodeError::TruncatedSequence;
        out.length = bytes.size() - offset;
        return out;
    }

    var scalar = lead_payload(lead, length);
    var consumed: int = 1;
    while consumed < length: {
        let next = bytes.at(offset + consumed) & BYTE_MASK;
        if (next & CONT_MASK) != CONT_MARK: {
            out.error = DecodeError::MissingContinuation;
            out.length = consumed;
            return out;
        }
        scalar = (scalar << CONT_BITS) | (next & CONT_PAYLOAD_MASK);
        consumed += 1;
    }

    if scalar < minimum_for_length(length): {
        out.error = DecodeError::OverlongEncoding;
        out.value = scalar;
        out.length = length;
        return out;
    }

    if scalar >= SURROGATE_FIRST && scalar <= SURROGATE_LAST: {
        out.error = DecodeError::SurrogateCodePoint;
        out.value = scalar;
        out.length = length;
        return out;
    }

    if scalar > CODE_POINT_MAX: {
        out.error = DecodeError::CodePointTooLarge;
        out.value = scalar;
        out.length = length;
        return out;
    }

    out.value = scalar;
    out.length = length;
    return out;
}

// Decode the whole buffer, replacing every ill formed subsequence with a
// single U+FFFD. The maximal subpart rule says one replacement per maximal
// prefix of a valid sequence, which is what the length field of the failed
// result gives us.
fn decode_all_lossy(bytes: &const shared vector{int}) -> vector{int}: {
    var out: vector{int};
    var offset: int = 0;
    while offset < bytes.size(): {
        let step = decode_at(bytes, offset);
        if step.error == DecodeError::None: {
            out.push_back(step.value);
            offset += step.length;
        } else: {
            out.push_back(REPLACEMENT);
            if step.length > 0: {
                offset += step.length;
            } else: {
                offset += 1;
            }
        }
    }
    return out;
}

// The strict variant stops at the first defect and reports where it was.
fn decode_all_strict(bytes: &const shared vector{int}, sink: &unique vector{int}) -> Decoded: {
    var report: Decoded;
    var offset: int = 0;
    while offset < bytes.size(): {
        let step = decode_at(bytes, offset);
        if step.error != DecodeError::None: {
            report.error = step.error;
            report.value = step.value;
            report.length = offset;
            return report;
        }
        sink.push_back(step.value);
        offset += step.length;
    }
    report.length = offset;
    return report;
}

// Validate without materialising any scalars. This is the function a network
// layer calls on every inbound frame, so it avoids the vector entirely.
fn validate(bytes: &const shared vector{int}) -> Decoded: {
    var report: Decoded;
    var offset: int = 0;
    let size = bytes.size();
    while offset < size: {
        let lead = bytes.at(offset) & BYTE_MASK;
        if (lead & ASCII_MASK) == 0: {
            offset += 1;
        } else: {
            let step = decode_at(bytes, offset);
            if step.error != DecodeError::None: {
                report.error = step.error;
                report.value = step.value;
                report.length = offset;
                return report;
            }
            offset += step.length;
        }
    }
    report.length = offset;
    return report;
}

fn is_valid_utf8(bytes: &const shared vector{int}) -> bool: {
    let report = validate(bytes);
    return report.error == DecodeError::None;
}

// Count scalars without decoding them: every byte that is not a continuation
// byte starts exactly one scalar. Only correct on a validated buffer, which is
// why the assertion is here.
fn count_scalars(bytes: &const shared vector{int}) -> int: {
    assert bytes.size() >= 0;
    var count: int = 0;
    for b: &const in bytes: {
        if (b & CONT_MASK) != CONT_MARK: {
            count += 1;
        }
    }
    return count;
}

// Walk backwards to the start of the sequence containing this offset. At most
// three steps, because no sequence is longer than four bytes.
fn sequence_start(bytes: &const shared vector{int}, offset: int) -> int: {
    var index = offset;
    var steps: int = 0;
    while index > 0 && steps < UTF8_MAX_LENGTH: {
        let b = bytes.at(index) & BYTE_MASK;
        if (b & CONT_MASK) != CONT_MARK: {
            return index;
        }
        index -= 1;
        steps += 1;
    }
    return index;
}

fn is_boundary(bytes: &const shared vector{int}, offset: int) -> bool: {
    if offset <= 0 || offset >= bytes.size(): {
        return true;
    }
    return (bytes.at(offset) & CONT_MASK) != CONT_MARK;
}

// --- The decoder state machine -------------------------------------------
//
// A byte at a time decoder for stream input, where a sequence may be split
// across two reads. The automaton is the classic nine state one: each step
// folds six payload bits into the accumulator and moves to the next state.
struct StreamDecoder: {

    fn reset(self: &unique): {
        .state = DecodeState::Accept;
        .accumulator = 0;
        .remaining = 0;
        .lower_bound = CONT_MARK;
        .upper_bound = 191;                    // 0xBF
        .consumed = 0;
        .error = DecodeError::None;
    }

    fn idle(self: &const shared) -> bool: {
        return .state == DecodeState::Accept && .remaining == 0;
    }

    fn failed(self: &const shared) -> bool: {
        return .state == DecodeState::Reject;
    }

    // Begin a new sequence. Sets the accumulator to the lead payload and the
    // continuation bounds implied by the lead class.
    fn begin(self: &unique, lead: int) -> bool: {
        let class = classify_byte(lead);
        .lower_bound = continuation_low_bound(class);
        .upper_bound = continuation_high_bound(class);

        if class == ByteClass::Ascii: {
            .accumulator = lead & MAX_ASCII;
            .remaining = 0;
            .state = DecodeState::Accept;
            return true;
        }
        if class == ByteClass::Continuation: {
            .error = DecodeError::UnexpectedContinuation;
            .state = DecodeState::Reject;
            return false;
        }
        if class == ByteClass::Illegal: {
            .error = DecodeError::InvalidLeadByte;
            .state = DecodeState::Reject;
            return false;
        }
        if class == ByteClass::LeadTwo: {
            .accumulator = lead & LEAD_TWO_PAYLOAD;
            .remaining = 1;
            .state = DecodeState::NeedOne;
            return true;
        }
        if class == ByteClass::LeadThreeLowBound: {
            .accumulator = lead & LEAD_THREE_PAYLOAD;
            .remaining = 2;
            .state = DecodeState::NeedTwoOfThreeLow;
            return true;
        }
        if class == ByteClass::LeadThreeSurrogate: {
            .accumulator = lead & LEAD_THREE_PAYLOAD;
            .remaining = 2;
            .state = DecodeState::NeedTwoOfThreeHigh;
            return true;
        }
        if class == ByteClass::LeadThree: {
            .accumulator = lead & LEAD_THREE_PAYLOAD;
            .remaining = 2;
            .state = DecodeState::NeedTwo;
            return true;
        }
        if class == ByteClass::LeadFourLowBound: {
            .accumulator = lead & LEAD_FOUR_PAYLOAD;
            .remaining = 3;
            .state = DecodeState::NeedThreeOfFourLow;
            return true;
        }
        if class == ByteClass::LeadFourHighBound: {
            .accumulator = lead & LEAD_FOUR_PAYLOAD;
            .remaining = 3;
            .state = DecodeState::NeedThreeOfFourHigh;
            return true;
        }
        .accumulator = lead & LEAD_FOUR_PAYLOAD;
        .remaining = 3;
        .state = DecodeState::NeedThree;
        return true;
    }

    // Feed one byte. Returns true when a complete scalar is now available in
    // the accumulator; false means either "need more" or "rejected", which the
    // caller separates by asking failed().
    fn feed(self: &unique, raw: int) -> bool: {
        let b = raw & BYTE_MASK;
        .consumed += 1;

        if .remaining == 0: {
            .error = DecodeError::None;
            if .begin(b) == false: {
                return false;
            }
            return .remaining == 0;
        }

        if b < .lower_bound || b > .upper_bound: {
            // The bound violation tells us exactly which rule was broken.
            if .lower_bound > CONT_MARK: {
                .error = DecodeError::OverlongEncoding;
            } else: {
                if .upper_bound < 191: {
                    .error = DecodeError::SurrogateCodePoint;
                } else: {
                    .error = DecodeError::MissingContinuation;
                }
            }
            if (b & CONT_MASK) != CONT_MARK: {
                .error = DecodeError::MissingContinuation;
            }
            .state = DecodeState::Reject;
            .remaining = 0;
            return false;
        }

        .accumulator = (.accumulator << CONT_BITS) | (b & CONT_PAYLOAD_MASK);
        .remaining -= 1;

        // After the first continuation byte the bounds relax back to the full
        // 0x80 .. 0xBF window.
        .lower_bound = CONT_MARK;
        .upper_bound = 191;                    // 0xBF

        if .remaining == 0: {
            .state = DecodeState::Accept;
            return true;
        }
        if .remaining == 1: {
            .state = DecodeState::NeedOne;
        } else: {
            .state = DecodeState::NeedTwo;
        }
        return false;
    }

    fn value(self: &const shared) -> int: {
        return .accumulator;
    }

    // Called at end of input: a sequence still in progress is a truncation.
    fn finish(self: &unique) -> DecodeError: {
        if .remaining > 0: {
            .error = DecodeError::TruncatedSequence;
            .state = DecodeState::Reject;
            .remaining = 0;
        }
        return .error;
    }

    state: DecodeState = DecodeState::Accept;
    accumulator: int = 0;
    remaining: int = 0;
    lower_bound: int = 128;                    // 0x80
    upper_bound: int = 191;                    // 0xBF
    consumed: int = 0;
    error: DecodeError = DecodeError::None;
}

// Drive the state machine over a whole buffer. Used by the test suite to check
// that the streaming decoder and the reference decoder never disagree.
fn decode_streaming(bytes: &const shared vector{int}) -> vector{int}: {
    var out: vector{int};
    var machine: StreamDecoder;
    machine.reset();
    for b: &const in bytes: {
        if machine.feed(b): {
            out.push_back(machine.value());
        } else: {
            if machine.failed(): {
                out.push_back(REPLACEMENT);
                machine.reset();
            }
        }
    }
    if machine.finish() != DecodeError::None: {
        out.push_back(REPLACEMENT);
    }
    return out;
}

// --- UTF-16 --------------------------------------------------------------
//
// A supplementary scalar is stored as a pair: subtract 0x10000, then take the
// top ten bits into 0xD800 .. 0xDBFF and the bottom ten into 0xDC00 .. 0xDFFF.

fn high_surrogate_of(scalar: int) -> int: {
    let biased = scalar - SURROGATE_BIAS;
    return HIGH_SURROGATE_FIRST | ((biased >> SURROGATE_SHIFT) & SURROGATE_MASK);
}

fn low_surrogate_of(scalar: int) -> int: {
    let biased = scalar - SURROGATE_BIAS;
    return LOW_SURROGATE_FIRST | (biased & SURROGATE_MASK);
}

fn combine_surrogates(high: int, low: int) -> int: {
    let high_bits = (high - HIGH_SURROGATE_FIRST) & SURROGATE_MASK;
    let low_bits = (low - LOW_SURROGATE_FIRST) & SURROGATE_MASK;
    return SURROGATE_BIAS + (high_bits << SURROGATE_SHIFT) + low_bits;
}

// Encode one scalar into a UTF-16 code unit vector. Returns the number of code
// units appended, or zero when the scalar is not encodable.
fn utf16_encode_into(sink: &unique vector{int}, scalar: int) -> int: {
    if is_valid_scalar(scalar) == false: {
        sink.push_back(REPLACEMENT);
        return 1;
    }
    if scalar <= BMP_MAX: {
        sink.push_back(scalar & WORD_MASK);
        return 1;
    }
    sink.push_back(high_surrogate_of(scalar));
    sink.push_back(low_surrogate_of(scalar));
    return 2;
}

fn utf16_encode(scalars: &const shared vector{int}) -> vector{int}: {
    var out: vector{int};
    out.reserve(scalars.size() + scalars.size() / 4);
    for scalar: &const in scalars: {
        discard utf16_encode_into(out, scalar);
    }
    return out;
}

// Decode one scalar from a UTF-16 code unit sequence. Unpaired surrogates are
// reported rather than silently passed through, which is the difference
// between UTF-16 and the looser WTF-16 that filesystems use.
fn utf16_decode_at(units: &const shared vector{int}, offset: int) -> Decoded: {
    var out: Decoded;
    if offset < 0 || offset >= units.size(): {
        out.error = DecodeError::EmptyInput;
        return out;
    }
    let unit = units.at(offset) & WORD_MASK;

    if unit < SURROGATE_FIRST || unit > SURROGATE_LAST: {
        out.value = unit;
        out.length = 1;
        return out;
    }
    if unit >= LOW_SURROGATE_FIRST: {
        out.error = DecodeError::UnpairedLowSurrogate;
        out.value = unit;
        out.length = 1;
        return out;
    }
    if offset + 1 >= units.size(): {
        out.error = DecodeError::UnpairedHighSurrogate;
        out.value = unit;
        out.length = 1;
        return out;
    }
    let trail = units.at(offset + 1) & WORD_MASK;
    if trail < LOW_SURROGATE_FIRST || trail > LOW_SURROGATE_LAST: {
        out.error = DecodeError::UnpairedHighSurrogate;
        out.value = unit;
        out.length = 1;
        return out;
    }
    out.value = combine_surrogates(unit, trail);
    out.length = 2;
    return out;
}

fn utf16_decode(units: &const shared vector{int}) -> vector{int}: {
    var out: vector{int};
    var offset: int = 0;
    while offset < units.size(): {
        let step = utf16_decode_at(units, offset);
        if step.error == DecodeError::None: {
            out.push_back(step.value);
        } else: {
            out.push_back(REPLACEMENT);
        }
        offset += step.length;
        if step.length == 0: {
            offset += 1;
        }
    }
    return out;
}

// Direct UTF-8 to UTF-16 transcoding, without building the intermediate
// scalar vector. This is the path a Windows API shim takes.
fn utf8_to_utf16(bytes: &const shared vector{int}) -> vector{int}: {
    var out: vector{int};
    var offset: int = 0;
    while offset < bytes.size(): {
        let step = decode_at(bytes, offset);
        if step.error == DecodeError::None: {
            discard utf16_encode_into(out, step.value);
            offset += step.length;
        } else: {
            out.push_back(REPLACEMENT);
            if step.length > 0: {
                offset += step.length;
            } else: {
                offset += 1;
            }
        }
    }
    return out;
}

fn utf16_to_utf8(units: &const shared vector{int}) -> vector{int}: {
    var out: vector{int};
    var offset: int = 0;
    while offset < units.size(): {
        let step = utf16_decode_at(units, offset);
        if step.error == DecodeError::None: {
            discard encode_into(out, step.value);
        } else: {
            discard encode_into(out, REPLACEMENT);
        }
        if step.length > 0: {
            offset += step.length;
        } else: {
            offset += 1;
        }
    }
    return out;
}

// How many UTF-16 code units a UTF-8 buffer will need. Every four byte
// sequence becomes a pair, everything else becomes a single unit.
fn utf16_units_needed(bytes: &const shared vector{int}) -> int: {
    var units: int = 0;
    for b: &const in bytes: {
        if (b & CONT_MASK) != CONT_MARK: {
            units += 1;
        }
        if (b & LEAD_FOUR_MASK) == LEAD_FOUR_MARK: {
            units += 1;
        }
    }
    return units;
}

// --- UTF-32 --------------------------------------------------------------

fn utf32_encode(scalars: &const shared vector{int}) -> vector{int}: {
    var out: vector{int};
    for scalar: &const in scalars: {
        if is_valid_scalar(scalar): {
            out.push_back(scalar);
        } else: {
            out.push_back(REPLACEMENT);
        }
    }
    return out;
}

fn utf32_decode(units: &const shared vector{int}) -> vector{int}: {
    var out: vector{int};
    for unit: &const in units: {
        if is_valid_scalar(unit): {
            out.push_back(unit);
        } else: {
            out.push_back(REPLACEMENT);
        }
    }
    return out;
}

fn utf32_validate(units: &const shared vector{int}) -> Decoded: {
    var report: Decoded;
    var index: int = 0;
    for unit: &const in units: {
        if unit < 0 || unit > CODE_POINT_MAX: {
            report.error = DecodeError::CodePointTooLarge;
            report.value = unit;
            report.length = index;
            return report;
        }
        if unit >= SURROGATE_FIRST && unit <= SURROGATE_LAST: {
            report.error = DecodeError::SurrogateCodePoint;
            report.value = unit;
            report.length = index;
            return report;
        }
        index += 1;
    }
    report.length = index;
    return report;
}

fn utf8_to_utf32(bytes: &const shared vector{int}) -> vector{int}: {
    return decode_all_lossy(bytes);
}

fn utf32_to_utf8(units: &const shared vector{int}) -> vector{int}: {
    var out: vector{int};
    for unit: &const in units: {
        discard encode_into(out, unit);
    }
    return out;
}

// --- Byte order ----------------------------------------------------------

fn swap16(unit: int) -> int: {
    let low = (unit & BYTE_MASK) << 8;
    let high = (unit >> 8) & BYTE_MASK;
    return (low | high) & WORD_MASK;
}

fn swap32(unit: int) -> int: {
    let b0 = (unit & BYTE_MASK) << 24;
    let b1 = ((unit >> 8) & BYTE_MASK) << 16;
    let b2 = ((unit >> 16) & BYTE_MASK) << 8;
    let b3 = (unit >> 24) & BYTE_MASK;
    return (b0 | b1 | b2 | b3) & DWORD_MASK;
}

fn read16(bytes: &const shared vector{int}, offset: int, order: ByteOrder) -> int: {
    let first = bytes.at(offset) & BYTE_MASK;
    let second = bytes.at(offset + 1) & BYTE_MASK;
    if order == ByteOrder::Big: {
        return (first << 8) | second;
    }
    return (second << 8) | first;
}

fn read32(bytes: &const shared vector{int}, offset: int, order: ByteOrder) -> int: {
    let b0 = bytes.at(offset) & BYTE_MASK;
    let b1 = bytes.at(offset + 1) & BYTE_MASK;
    let b2 = bytes.at(offset + 2) & BYTE_MASK;
    let b3 = bytes.at(offset + 3) & BYTE_MASK;
    if order == ByteOrder::Big: {
        return (b0 << 24) | (b1 << 16) | (b2 << 8) | b3;
    }
    return (b3 << 24) | (b2 << 16) | (b1 << 8) | b0;
}

fn write16(sink: &unique vector{int}, unit: int, order: ByteOrder): {
    if order == ByteOrder::Big: {
        sink.push_back((unit >> 8) & BYTE_MASK);
        sink.push_back(unit & BYTE_MASK);
    } else: {
        sink.push_back(unit & BYTE_MASK);
        sink.push_back((unit >> 8) & BYTE_MASK);
    }
}

fn write32(sink: &unique vector{int}, unit: int, order: ByteOrder): {
    if order == ByteOrder::Big: {
        sink.push_back((unit >> 24) & BYTE_MASK);
        sink.push_back((unit >> 16) & BYTE_MASK);
        sink.push_back((unit >> 8) & BYTE_MASK);
        sink.push_back(unit & BYTE_MASK);
    } else: {
        sink.push_back(unit & BYTE_MASK);
        sink.push_back((unit >> 8) & BYTE_MASK);
        sink.push_back((unit >> 16) & BYTE_MASK);
        sink.push_back((unit >> 24) & BYTE_MASK);
    }
}

// --- Byte order marks ----------------------------------------------------

fn has_utf8_bom(bytes: &const shared vector{int}) -> bool: {
    if bytes.size() < BOM_UTF8_LENGTH: {
        return false;
    }
    if (bytes.at(0) & BYTE_MASK) != BOM_UTF8_BYTE_0: {
        return false;
    }
    if (bytes.at(1) & BYTE_MASK) != BOM_UTF8_BYTE_1: {
        return false;
    }
    return (bytes.at(2) & BYTE_MASK) == BOM_UTF8_BYTE_2;
}

fn has_utf16_be_bom(bytes: &const shared vector{int}) -> bool: {
    if bytes.size() < BOM_UTF16_LENGTH: {
        return false;
    }
    let first = bytes.at(0) & BYTE_MASK;
    let second = bytes.at(1) & BYTE_MASK;
    return first == BOM_UTF16_BE_BYTE_0 && second == BOM_UTF16_BE_BYTE_1;
}

fn has_utf16_le_bom(bytes: &const shared vector{int}) -> bool: {
    if bytes.size() < BOM_UTF16_LENGTH: {
        return false;
    }
    let first = bytes.at(0) & BYTE_MASK;
    let second = bytes.at(1) & BYTE_MASK;
    return first == BOM_UTF16_LE_BYTE_0 && second == BOM_UTF16_LE_BYTE_1;
}

// The 32 bit marks have to be tested before the 16 bit ones, because a UTF-32
// little endian mark begins with the same two bytes as a UTF-16 little endian
// mark and would otherwise be misread.
fn has_utf32_be_bom(bytes: &const shared vector{int}) -> bool: {
    if bytes.size() < BOM_UTF32_LENGTH: {
        return false;
    }
    if (bytes.at(0) & BYTE_MASK) != 0: {
        return false;
    }
    if (bytes.at(1) & BYTE_MASK) != 0: {
        return false;
    }
    if (bytes.at(2) & BYTE_MASK) != 254: {     // 0xFE
        return false;
    }
    return (bytes.at(3) & BYTE_MASK) == 255;   // 0xFF
}

fn has_utf32_le_bom(bytes: &const shared vector{int}) -> bool: {
    if bytes.size() < BOM_UTF32_LENGTH: {
        return false;
    }
    if (bytes.at(0) & BYTE_MASK) != 255: {     // 0xFF
        return false;
    }
    if (bytes.at(1) & BYTE_MASK) != 254: {     // 0xFE
        return false;
    }
    if (bytes.at(2) & BYTE_MASK) != 0: {
        return false;
    }
    return (bytes.at(3) & BYTE_MASK) == 0;
}

fn bom_length(encoding: Encoding) -> int: {
    if encoding == Encoding::Utf8WithBom: {
        return BOM_UTF8_LENGTH;
    }
    if encoding == Encoding::Utf16Big || encoding == Encoding::Utf16Little: {
        return BOM_UTF16_LENGTH;
    }
    if encoding == Encoding::Utf32Big || encoding == Encoding::Utf32Little: {
        return BOM_UTF32_LENGTH;
    }
    return 0;
}

// Sniff the encoding of a buffer. Marks first, then the zero byte pattern that
// a 16 or 32 bit stream of mostly ASCII text produces, then a validity test.
fn detect_encoding(bytes: &const shared vector{int}) -> Encoding: {
    if bytes.empty(): {
        return Encoding::Unknown;
    }
    if has_utf32_be_bom(bytes): {
        return Encoding::Utf32Big;
    }
    if has_utf32_le_bom(bytes): {
        return Encoding::Utf32Little;
    }
    if has_utf8_bom(bytes): {
        return Encoding::Utf8WithBom;
    }
    if has_utf16_be_bom(bytes): {
        return Encoding::Utf16Big;
    }
    if has_utf16_le_bom(bytes): {
        return Encoding::Utf16Little;
    }

    // No mark. Count zero bytes at even and odd positions; ASCII text encoded
    // as UTF-16 leaves a zero in every other slot and the side it lands on
    // gives the byte order away.
    var even_zeros: int = 0;
    var odd_zeros: int = 0;
    var high_bytes: int = 0;
    let limit = min(bytes.size(), 512);
    for i in range(0, limit): {
        let b = bytes.at(i) & BYTE_MASK;
        if b == 0: {
            if (i & 1) == 0: {
                even_zeros += 1;
            } else: {
                odd_zeros += 1;
            }
        }
        if (b & ASCII_MASK) != 0: {
            high_bytes += 1;
        }
    }

    if even_zeros > limit / 4 && odd_zeros == 0: {
        return Encoding::Utf16Big;
    }
    if odd_zeros > limit / 4 && even_zeros == 0: {
        return Encoding::Utf16Little;
    }
    if high_bytes == 0: {
        return Encoding::Ascii;
    }
    if is_valid_utf8(bytes): {
        return Encoding::Utf8;
    }
    return Encoding::Unknown;
}

// Strip a leading mark, if any, and report what was stripped.
fn strip_bom(bytes: &unique vector{int}) -> Encoding: {
    let encoding = detect_encoding(bytes);
    let length = bom_length(encoding);
    for i in range(0, length): {
        bytes.erase(0);
    }
    return encoding;
}

fn prepend_utf8_bom(bytes: &unique vector{int}): {
    bytes.insert(0, BOM_UTF8_BYTE_2);
    bytes.insert(0, BOM_UTF8_BYTE_1);
    bytes.insert(0, BOM_UTF8_BYTE_0);
}

fn encoding_name(encoding: Encoding) -> string: {
    if encoding == Encoding::Utf8: {
        return "UTF-8";
    }
    if encoding == Encoding::Utf8WithBom: {
        return "UTF-8 with byte order mark";
    }
    if encoding == Encoding::Utf16Big: {
        return "UTF-16 big endian";
    }
    if encoding == Encoding::Utf16Little: {
        return "UTF-16 little endian";
    }
    if encoding == Encoding::Utf32Big: {
        return "UTF-32 big endian";
    }
    if encoding == Encoding::Utf32Little: {
        return "UTF-32 little endian";
    }
    if encoding == Encoding::Ascii: {
        return "US-ASCII";
    }
    return "unknown";
}

// --- ASCII classification bitset -----------------------------------------
//
// The first 128 code points are classified with a bit per property rather than
// with a table lookup, because the whole set fits in one integer per
// character and the compiler can fold the tests.

static FLAG_LETTER: int = 1;                   // bit 0
static FLAG_UPPER: int = 2;                    // bit 1
static FLAG_LOWER: int = 4;                    // bit 2
static FLAG_DIGIT: int = 8;                    // bit 3
static FLAG_HEX_DIGIT: int = 16;               // bit 4
static FLAG_WHITESPACE: int = 32;              // bit 5
static FLAG_CONTROL: int = 64;                 // bit 6
static FLAG_PUNCTUATION: int = 128;            // bit 7
static FLAG_SYMBOL: int = 256;                 // bit 8
static FLAG_PRINTABLE: int = 512;              // bit 9
static FLAG_GRAPHIC: int = 1024;               // bit 10
static FLAG_BLANK: int = 2048;                 // bit 11
static FLAG_WORD: int = 4096;                  // bit 12
static FLAG_IDENTIFIER_START: int = 8192;      // bit 13
static FLAG_IDENTIFIER_PART: int = 16384;      // bit 14
static FLAG_COMBINING: int = 32768;            // bit 15
static FLAG_LINE_BREAK: int = 65536;           // bit 16
static FLAG_QUOTE: int = 131072;               // bit 17
static FLAG_BRACKET: int = 262144;             // bit 18
static FLAG_SIGN: int = 524288;                // bit 19

// Common combinations, precomputed so the predicates below stay one line.
static MASK_ALPHANUMERIC: int = 9;             // LETTER | DIGIT
static MASK_UPPER_LETTER: int = 11267;         // LETTER | UPPER | PRINTABLE | ...
static MASK_LOWER_LETTER: int = 5;             // LETTER | LOWER
static MASK_SPACE_LIKE: int = 2080;            // WHITESPACE | BLANK
static MASK_IDENTIFIER: int = 24576;           // START | PART
static MASK_TEXTUAL: int = 1545;               // LETTER | DIGIT | GRAPHIC | PRINTABLE
static MASK_ANY_PUNCT: int = 393344;           // PUNCTUATION | SYMBOL | BRACKET

// The classification of one ASCII character, as a bit union. Written out as a
// chain of range tests over character literals so that the source reads like
// the table it represents.
fn ascii_flags(c: char) -> int: {
    if c >= 'a' && c <= 'z': {
        return FLAG_LETTER | FLAG_LOWER | FLAG_PRINTABLE | FLAG_GRAPHIC | FLAG_WORD | FLAG_IDENTIFIER_START | FLAG_IDENTIFIER_PART;
    }
    if c >= 'A' && c <= 'Z': {
        return FLAG_LETTER | FLAG_UPPER | FLAG_PRINTABLE | FLAG_GRAPHIC | FLAG_WORD | FLAG_IDENTIFIER_START | FLAG_IDENTIFIER_PART;
    }
    if c >= '0' && c <= '9': {
        return FLAG_DIGIT | FLAG_HEX_DIGIT | FLAG_PRINTABLE | FLAG_GRAPHIC | FLAG_WORD | FLAG_IDENTIFIER_PART;
    }
    if c == ' ': {
        return FLAG_WHITESPACE | FLAG_BLANK | FLAG_PRINTABLE;
    }
    if c == '\t': {
        return FLAG_WHITESPACE | FLAG_BLANK | FLAG_CONTROL;
    }
    if c == '\n': {
        return FLAG_WHITESPACE | FLAG_CONTROL | FLAG_LINE_BREAK;
    }
    if c == '\r': {
        return FLAG_WHITESPACE | FLAG_CONTROL | FLAG_LINE_BREAK;
    }
    if c == '\f': {
        return FLAG_WHITESPACE | FLAG_CONTROL | FLAG_LINE_BREAK;
    }
    if c == '\v': {
        return FLAG_WHITESPACE | FLAG_CONTROL | FLAG_LINE_BREAK;
    }
    if c == '_': {
        return FLAG_PUNCTUATION | FLAG_PRINTABLE | FLAG_GRAPHIC | FLAG_WORD | FLAG_IDENTIFIER_START | FLAG_IDENTIFIER_PART;
    }
    if c == '"': {
        return FLAG_PUNCTUATION | FLAG_QUOTE | FLAG_PRINTABLE | FLAG_GRAPHIC;
    }
    if c == '(' || c == ')': {
        return FLAG_PUNCTUATION | FLAG_BRACKET | FLAG_PRINTABLE | FLAG_GRAPHIC;
    }
    if c == '[' || c == ']': {
        return FLAG_PUNCTUATION | FLAG_BRACKET | FLAG_PRINTABLE | FLAG_GRAPHIC;
    }
    if c == '{' || c == '}': {
        return FLAG_PUNCTUATION | FLAG_BRACKET | FLAG_PRINTABLE | FLAG_GRAPHIC;
    }
    if c == '+' || c == '-': {
        return FLAG_SYMBOL | FLAG_SIGN | FLAG_PRINTABLE | FLAG_GRAPHIC;
    }
    if c == '<' || c == '>' || c == '=': {
        return FLAG_SYMBOL | FLAG_PRINTABLE | FLAG_GRAPHIC;
    }
    if c == '|' || c == '~' || c == '^': {
        return FLAG_SYMBOL | FLAG_PRINTABLE | FLAG_GRAPHIC;
    }
    if c == '$': {
        return FLAG_SYMBOL | FLAG_PRINTABLE | FLAG_GRAPHIC | FLAG_IDENTIFIER_START | FLAG_IDENTIFIER_PART;
    }
    if c == '`': {
        return FLAG_SYMBOL | FLAG_QUOTE | FLAG_PRINTABLE | FLAG_GRAPHIC;
    }
    if c == '!' || c == '?' || c == '.' || c == ',': {
        return FLAG_PUNCTUATION | FLAG_PRINTABLE | FLAG_GRAPHIC;
    }
    if c == ':' || c == ';': {
        return FLAG_PUNCTUATION | FLAG_PRINTABLE | FLAG_GRAPHIC;
    }
    if c == '*' || c == '/' || c == '%' || c == '&' || c == '#' || c == '@': {
        return FLAG_PUNCTUATION | FLAG_PRINTABLE | FLAG_GRAPHIC;
    }
    if c == '\0': {
        return FLAG_CONTROL;
    }
    if int(c) < 32: {
        return FLAG_CONTROL;
    }
    if int(c) == 127: {
        return FLAG_CONTROL;
    }
    return FLAG_PRINTABLE;
}

// Hexadecimal digits pick up their own bit on top of whatever else they carry.
fn hex_flags(c: char) -> int: {
    let base = ascii_flags(c);
    if c >= 'a' && c <= 'f': {
        return base | FLAG_HEX_DIGIT;
    }
    if c >= 'A' && c <= 'F': {
        return base | FLAG_HEX_DIGIT;
    }
    return base;
}

fn has_flag(flags: int, wanted: int) => (flags & wanted) != 0;

fn has_all_flags(flags: int, wanted: int) => (flags & wanted) == wanted;

fn ascii_is_letter(c: char) => (ascii_flags(c) & FLAG_LETTER) != 0;

fn ascii_is_digit(c: char) => c >= '0' && c <= '9';

fn ascii_is_hex(c: char) => (hex_flags(c) & FLAG_HEX_DIGIT) != 0;

fn ascii_is_space(c: char) => (ascii_flags(c) & FLAG_WHITESPACE) != 0;

fn ascii_is_control(c: char) => (ascii_flags(c) & FLAG_CONTROL) != 0;

fn ascii_is_punct(c: char) => (ascii_flags(c) & MASK_ANY_PUNCT) != 0;

fn ascii_is_identifier_start(c: char) => (ascii_flags(c) & FLAG_IDENTIFIER_START) != 0;

fn ascii_is_identifier_part(c: char) => (ascii_flags(c) & FLAG_IDENTIFIER_PART) != 0;

fn ascii_digit_value(c: char) -> int: {
    if c >= '0' && c <= '9': {
        return int(c) - int('0');
    }
    return -1;
}

fn ascii_hex_value(c: char) -> int: {
    if c >= '0' && c <= '9': {
        return int(c) - int('0');
    }
    if c >= 'a' && c <= 'f': {
        return int(c) - int('a') + 10;
    }
    if c >= 'A' && c <= 'F': {
        return int(c) - int('A') + 10;
    }
    return -1;
}

fn hex_digit_char(value: int) -> char: {
    if value == 0: { return '0'; }
    if value == 1: { return '1'; }
    if value == 2: { return '2'; }
    if value == 3: { return '3'; }
    if value == 4: { return '4'; }
    if value == 5: { return '5'; }
    if value == 6: { return '6'; }
    if value == 7: { return '7'; }
    if value == 8: { return '8'; }
    if value == 9: { return '9'; }
    if value == 10: { return 'A'; }
    if value == 11: { return 'B'; }
    if value == 12: { return 'C'; }
    if value == 13: { return 'D'; }
    if value == 14: { return 'E'; }
    if value == 15: { return 'F'; }
    return '?';
}

// Format a scalar the way the Unicode standard does: U+0041, U+1F600.
fn format_code_point(scalar: int) -> string: {
    var out: string = "U+";
    var digits: int = 4;
    if scalar > 65535: {                       // 0xFFFF
        digits = 6;
    }
    if scalar > 16777215: {                    // 0xFFFFFF
        digits = 8;
    }
    var shift = (digits - 1) * 4;
    while shift >= 0: {
        let nibble = (scalar >> shift) & NIBBLE_MASK;
        out.push_back(hex_digit_char(nibble));
        shift -= 4;
    }
    return out;
}

// --- General category table ----------------------------------------------
//
// A sorted, non overlapping list of half open ranges. It is deliberately a
// coarse sample of the real UnicodeData table: the blocks that a text editor
// touches most, plus enough of the supplementary planes to exercise the four
// byte decode path. Ranges are stored inclusive on both ends.
fn category_table() -> vector{CategoryRange}: {
    var rows: vector{CategoryRange};

    // C0 controls and basic Latin.
    rows.push_back(CategoryRange(first: 0, last: 31, category: Category::Control));                    // 0x0000 .. 0x001F
    rows.push_back(CategoryRange(first: 32, last: 32, category: Category::SpaceSeparator));            // space
    rows.push_back(CategoryRange(first: 33, last: 35, category: Category::OtherPunctuation));          // ! " #
    rows.push_back(CategoryRange(first: 36, last: 36, category: Category::CurrencySymbol));            // $
    rows.push_back(CategoryRange(first: 37, last: 39, category: Category::OtherPunctuation));          // % & apostrophe
    rows.push_back(CategoryRange(first: 40, last: 40, category: Category::OpenPunctuation));           // (
    rows.push_back(CategoryRange(first: 41, last: 41, category: Category::ClosePunctuation));          // )
    rows.push_back(CategoryRange(first: 42, last: 42, category: Category::OtherPunctuation));          // *
    rows.push_back(CategoryRange(first: 43, last: 43, category: Category::MathSymbol));                // +
    rows.push_back(CategoryRange(first: 44, last: 44, category: Category::OtherPunctuation));          // ,
    rows.push_back(CategoryRange(first: 45, last: 45, category: Category::DashPunctuation));           // -
    rows.push_back(CategoryRange(first: 46, last: 47, category: Category::OtherPunctuation));          // . /
    rows.push_back(CategoryRange(first: 48, last: 57, category: Category::DecimalNumber));             // 0 .. 9
    rows.push_back(CategoryRange(first: 58, last: 59, category: Category::OtherPunctuation));          // : ;
    rows.push_back(CategoryRange(first: 60, last: 62, category: Category::MathSymbol));                // < = >
    rows.push_back(CategoryRange(first: 63, last: 64, category: Category::OtherPunctuation));          // ? @
    rows.push_back(CategoryRange(first: 65, last: 90, category: Category::UppercaseLetter));           // A .. Z
    rows.push_back(CategoryRange(first: 91, last: 91, category: Category::OpenPunctuation));           // [
    rows.push_back(CategoryRange(first: 92, last: 92, category: Category::OtherPunctuation));          // backslash
    rows.push_back(CategoryRange(first: 93, last: 93, category: Category::ClosePunctuation));          // ]
    rows.push_back(CategoryRange(first: 94, last: 94, category: Category::ModifierSymbol));            // ^
    rows.push_back(CategoryRange(first: 95, last: 95, category: Category::ConnectorPunctuation));      // _
    rows.push_back(CategoryRange(first: 96, last: 96, category: Category::ModifierSymbol));            // backtick
    rows.push_back(CategoryRange(first: 97, last: 122, category: Category::LowercaseLetter));          // a .. z
    rows.push_back(CategoryRange(first: 123, last: 123, category: Category::OpenPunctuation));         // {
    rows.push_back(CategoryRange(first: 124, last: 124, category: Category::MathSymbol));              // |
    rows.push_back(CategoryRange(first: 125, last: 125, category: Category::ClosePunctuation));        // }
    rows.push_back(CategoryRange(first: 126, last: 126, category: Category::MathSymbol));              // ~
    rows.push_back(CategoryRange(first: 127, last: 159, category: Category::Control));                 // DEL and C1

    // Latin-1 supplement.
    rows.push_back(CategoryRange(first: 160, last: 160, category: Category::SpaceSeparator));          // 0x00A0 no break space
    rows.push_back(CategoryRange(first: 161, last: 161, category: Category::OtherPunctuation));        // 0x00A1
    rows.push_back(CategoryRange(first: 162, last: 165, category: Category::CurrencySymbol));          // 0x00A2 .. 0x00A5
    rows.push_back(CategoryRange(first: 166, last: 166, category: Category::OtherSymbol));             // 0x00A6
    rows.push_back(CategoryRange(first: 167, last: 167, category: Category::OtherPunctuation));        // 0x00A7
    rows.push_back(CategoryRange(first: 168, last: 168, category: Category::ModifierSymbol));          // 0x00A8
    rows.push_back(CategoryRange(first: 169, last: 169, category: Category::OtherSymbol));             // 0x00A9
    rows.push_back(CategoryRange(first: 170, last: 170, category: Category::OtherLetter));             // 0x00AA
    rows.push_back(CategoryRange(first: 171, last: 171, category: Category::InitialPunctuation));      // 0x00AB
    rows.push_back(CategoryRange(first: 172, last: 172, category: Category::MathSymbol));              // 0x00AC
    rows.push_back(CategoryRange(first: 173, last: 173, category: Category::Format));                  // 0x00AD soft hyphen
    rows.push_back(CategoryRange(first: 174, last: 174, category: Category::OtherSymbol));             // 0x00AE
    rows.push_back(CategoryRange(first: 175, last: 175, category: Category::ModifierSymbol));          // 0x00AF
    rows.push_back(CategoryRange(first: 176, last: 176, category: Category::OtherSymbol));             // 0x00B0 degree
    rows.push_back(CategoryRange(first: 177, last: 177, category: Category::MathSymbol));              // 0x00B1
    rows.push_back(CategoryRange(first: 178, last: 179, category: Category::OtherNumber));             // 0x00B2 .. 0x00B3
    rows.push_back(CategoryRange(first: 180, last: 180, category: Category::ModifierSymbol));          // 0x00B4
    rows.push_back(CategoryRange(first: 181, last: 181, category: Category::LowercaseLetter));         // 0x00B5 micro
    rows.push_back(CategoryRange(first: 182, last: 183, category: Category::OtherPunctuation));        // 0x00B6 .. 0x00B7
    rows.push_back(CategoryRange(first: 184, last: 184, category: Category::ModifierSymbol));          // 0x00B8
    rows.push_back(CategoryRange(first: 185, last: 185, category: Category::OtherNumber));             // 0x00B9
    rows.push_back(CategoryRange(first: 186, last: 186, category: Category::OtherLetter));             // 0x00BA
    rows.push_back(CategoryRange(first: 187, last: 187, category: Category::FinalPunctuation));        // 0x00BB
    rows.push_back(CategoryRange(first: 188, last: 190, category: Category::OtherNumber));             // 0x00BC .. 0x00BE
    rows.push_back(CategoryRange(first: 191, last: 191, category: Category::OtherPunctuation));        // 0x00BF
    rows.push_back(CategoryRange(first: 192, last: 214, category: Category::UppercaseLetter));         // 0x00C0 .. 0x00D6
    rows.push_back(CategoryRange(first: 215, last: 215, category: Category::MathSymbol));              // 0x00D7 multiply
    rows.push_back(CategoryRange(first: 216, last: 222, category: Category::UppercaseLetter));         // 0x00D8 .. 0x00DE
    rows.push_back(CategoryRange(first: 223, last: 246, category: Category::LowercaseLetter));         // 0x00DF .. 0x00F6
    rows.push_back(CategoryRange(first: 247, last: 247, category: Category::MathSymbol));              // 0x00F7 divide
    rows.push_back(CategoryRange(first: 248, last: 255, category: Category::LowercaseLetter));         // 0x00F8 .. 0x00FF

    // Latin extended, collapsed: the alternating upper and lower runs are far
    // too long to spell out, so the whole block is marked as letters and the
    // case table below carries the finer detail.
    rows.push_back(CategoryRange(first: 256, last: 383, category: Category::OtherLetter));             // 0x0100 .. 0x017F
    rows.push_back(CategoryRange(first: 384, last: 591, category: Category::OtherLetter));             // 0x0180 .. 0x024F
    rows.push_back(CategoryRange(first: 592, last: 687, category: Category::LowercaseLetter));         // IPA extensions
    rows.push_back(CategoryRange(first: 688, last: 767, category: Category::ModifierLetter));          // spacing modifiers
    rows.push_back(CategoryRange(first: 768, last: 879, category: Category::NonspacingMark));          // combining diacriticals

    // Greek and Coptic.
    rows.push_back(CategoryRange(first: 880, last: 883, category: Category::OtherLetter));             // 0x0370 .. 0x0373
    rows.push_back(CategoryRange(first: 884, last: 885, category: Category::ModifierLetter));          // 0x0374 .. 0x0375
    rows.push_back(CategoryRange(first: 890, last: 890, category: Category::ModifierLetter));          // 0x037A
    rows.push_back(CategoryRange(first: 891, last: 893, category: Category::LowercaseLetter));         // 0x037B .. 0x037D
    rows.push_back(CategoryRange(first: 894, last: 894, category: Category::OtherPunctuation));        // 0x037E
    rows.push_back(CategoryRange(first: 902, last: 902, category: Category::UppercaseLetter));         // 0x0386
    rows.push_back(CategoryRange(first: 903, last: 903, category: Category::OtherPunctuation));        // 0x0387
    rows.push_back(CategoryRange(first: 904, last: 929, category: Category::UppercaseLetter));         // 0x0388 .. 0x03A1
    rows.push_back(CategoryRange(first: 931, last: 939, category: Category::UppercaseLetter));         // 0x03A3 .. 0x03AB
    rows.push_back(CategoryRange(first: 940, last: 974, category: Category::LowercaseLetter));         // 0x03AC .. 0x03CE
    rows.push_back(CategoryRange(first: 975, last: 1023, category: Category::OtherLetter));            // 0x03CF .. 0x03FF

    // Cyrillic.
    rows.push_back(CategoryRange(first: 1024, last: 1071, category: Category::UppercaseLetter));       // 0x0400 .. 0x042F
    rows.push_back(CategoryRange(first: 1072, last: 1119, category: Category::LowercaseLetter));       // 0x0430 .. 0x045F
    rows.push_back(CategoryRange(first: 1120, last: 1279, category: Category::OtherLetter));           // 0x0460 .. 0x04FF
    rows.push_back(CategoryRange(first: 1280, last: 1327, category: Category::OtherLetter));           // 0x0500 .. 0x052F

    // Hebrew and Arabic.
    rows.push_back(CategoryRange(first: 1425, last: 1469, category: Category::NonspacingMark));        // 0x0591 .. 0x05BD
    rows.push_back(CategoryRange(first: 1471, last: 1471, category: Category::NonspacingMark));        // 0x05BF
    rows.push_back(CategoryRange(first: 1473, last: 1474, category: Category::NonspacingMark));        // 0x05C1 .. 0x05C2
    rows.push_back(CategoryRange(first: 1488, last: 1514, category: Category::OtherLetter));           // 0x05D0 .. 0x05EA
    rows.push_back(CategoryRange(first: 1536, last: 1541, category: Category::Format));                // 0x0600 .. 0x0605
    rows.push_back(CategoryRange(first: 1542, last: 1544, category: Category::MathSymbol));            // 0x0606 .. 0x0608
    rows.push_back(CategoryRange(first: 1548, last: 1549, category: Category::OtherPunctuation));      // 0x060C .. 0x060D
    rows.push_back(CategoryRange(first: 1552, last: 1562, category: Category::NonspacingMark));        // 0x0610 .. 0x061A
    rows.push_back(CategoryRange(first: 1569, last: 1610, category: Category::OtherLetter));           // 0x0621 .. 0x064A
    rows.push_back(CategoryRange(first: 1611, last: 1631, category: Category::NonspacingMark));        // 0x064B .. 0x065F
    rows.push_back(CategoryRange(first: 1632, last: 1641, category: Category::DecimalNumber));         // 0x0660 .. 0x0669
    rows.push_back(CategoryRange(first: 1642, last: 1645, category: Category::OtherPunctuation));      // 0x066A .. 0x066D

    // Devanagari, enough of it to exercise the spacing mark rules.
    rows.push_back(CategoryRange(first: 2304, last: 2306, category: Category::NonspacingMark));        // 0x0900 .. 0x0902
    rows.push_back(CategoryRange(first: 2307, last: 2307, category: Category::SpacingMark));           // 0x0903
    rows.push_back(CategoryRange(first: 2308, last: 2361, category: Category::OtherLetter));           // 0x0904 .. 0x0939
    rows.push_back(CategoryRange(first: 2362, last: 2362, category: Category::NonspacingMark));        // 0x093A
    rows.push_back(CategoryRange(first: 2363, last: 2363, category: Category::SpacingMark));           // 0x093B
    rows.push_back(CategoryRange(first: 2364, last: 2364, category: Category::NonspacingMark));        // 0x093C nukta
    rows.push_back(CategoryRange(first: 2366, last: 2368, category: Category::SpacingMark));           // 0x093E .. 0x0940
    rows.push_back(CategoryRange(first: 2369, last: 2376, category: Category::NonspacingMark));        // 0x0941 .. 0x0948
    rows.push_back(CategoryRange(first: 2377, last: 2380, category: Category::SpacingMark));           // 0x0949 .. 0x094C
    rows.push_back(CategoryRange(first: 2381, last: 2381, category: Category::NonspacingMark));        // 0x094D virama
    rows.push_back(CategoryRange(first: 2406, last: 2415, category: Category::DecimalNumber));         // 0x0966 .. 0x096F

    // Thai, which is the classic zero width mark test case.
    rows.push_back(CategoryRange(first: 3585, last: 3632, category: Category::OtherLetter));           // 0x0E01 .. 0x0E30
    rows.push_back(CategoryRange(first: 3633, last: 3633, category: Category::NonspacingMark));        // 0x0E31
    rows.push_back(CategoryRange(first: 3634, last: 3635, category: Category::OtherLetter));           // 0x0E32 .. 0x0E33
    rows.push_back(CategoryRange(first: 3636, last: 3642, category: Category::NonspacingMark));        // 0x0E34 .. 0x0E3A
    rows.push_back(CategoryRange(first: 3648, last: 3653, category: Category::OtherLetter));           // 0x0E40 .. 0x0E45
    rows.push_back(CategoryRange(first: 3654, last: 3654, category: Category::ModifierLetter));        // 0x0E46
    rows.push_back(CategoryRange(first: 3655, last: 3662, category: Category::NonspacingMark));        // 0x0E47 .. 0x0E4E
    rows.push_back(CategoryRange(first: 3664, last: 3673, category: Category::DecimalNumber));         // 0x0E50 .. 0x0E59

    // Hangul jamo, split by the L, V and T groups the composition rules need.
    rows.push_back(CategoryRange(first: 4352, last: 4447, category: Category::OtherLetter));           // 0x1100 .. 0x115F leading
    rows.push_back(CategoryRange(first: 4448, last: 4519, category: Category::OtherLetter));           // 0x1160 .. 0x11A7 vowel
    rows.push_back(CategoryRange(first: 4520, last: 4607, category: Category::OtherLetter));           // 0x11A8 .. 0x11FF trailing

    // General punctuation and the invisible formatting characters.
    rows.push_back(CategoryRange(first: 8192, last: 8202, category: Category::SpaceSeparator));        // 0x2000 .. 0x200A
    rows.push_back(CategoryRange(first: 8203, last: 8207, category: Category::Format));                // 0x200B .. 0x200F
    rows.push_back(CategoryRange(first: 8208, last: 8213, category: Category::DashPunctuation));       // 0x2010 .. 0x2015
    rows.push_back(CategoryRange(first: 8214, last: 8215, category: Category::OtherPunctuation));      // 0x2016 .. 0x2017
    rows.push_back(CategoryRange(first: 8216, last: 8216, category: Category::InitialPunctuation));    // 0x2018
    rows.push_back(CategoryRange(first: 8217, last: 8217, category: Category::FinalPunctuation));      // 0x2019
    rows.push_back(CategoryRange(first: 8220, last: 8220, category: Category::InitialPunctuation));    // 0x201C
    rows.push_back(CategoryRange(first: 8221, last: 8221, category: Category::FinalPunctuation));      // 0x201D
    rows.push_back(CategoryRange(first: 8224, last: 8231, category: Category::OtherPunctuation));      // 0x2020 .. 0x2027
    rows.push_back(CategoryRange(first: 8232, last: 8232, category: Category::LineSeparator));         // 0x2028
    rows.push_back(CategoryRange(first: 8233, last: 8233, category: Category::ParagraphSeparator));    // 0x2029
    rows.push_back(CategoryRange(first: 8234, last: 8238, category: Category::Format));                // 0x202A .. 0x202E
    rows.push_back(CategoryRange(first: 8239, last: 8239, category: Category::SpaceSeparator));        // 0x202F
    rows.push_back(CategoryRange(first: 8240, last: 8248, category: Category::OtherPunctuation));      // 0x2030 .. 0x2038
    rows.push_back(CategoryRange(first: 8287, last: 8287, category: Category::SpaceSeparator));        // 0x205F
    rows.push_back(CategoryRange(first: 8288, last: 8303, category: Category::Format));                // 0x2060 .. 0x206F
    rows.push_back(CategoryRange(first: 8352, last: 8399, category: Category::CurrencySymbol));        // 0x20A0 .. 0x20CF
    rows.push_back(CategoryRange(first: 8400, last: 8432, category: Category::NonspacingMark));        // 0x20D0 .. 0x20F0

    // Letterlike symbols, arrows and mathematical operators.
    rows.push_back(CategoryRange(first: 8448, last: 8527, category: Category::OtherSymbol));           // 0x2100 .. 0x214F
    rows.push_back(CategoryRange(first: 8528, last: 8585, category: Category::OtherNumber));           // 0x2150 .. 0x2189
    rows.push_back(CategoryRange(first: 8592, last: 8703, category: Category::MathSymbol));            // 0x2190 .. 0x21FF
    rows.push_back(CategoryRange(first: 8704, last: 8959, category: Category::MathSymbol));            // 0x2200 .. 0x22FF
    rows.push_back(CategoryRange(first: 9312, last: 9371, category: Category::OtherNumber));           // 0x2460 .. 0x249B
    rows.push_back(CategoryRange(first: 9472, last: 9599, category: Category::OtherSymbol));           // 0x2500 .. 0x257F box drawing
    rows.push_back(CategoryRange(first: 9600, last: 9631, category: Category::OtherSymbol));           // 0x2580 .. 0x259F blocks
    rows.push_back(CategoryRange(first: 9632, last: 9727, category: Category::OtherSymbol));           // 0x25A0 .. 0x25FF shapes
    rows.push_back(CategoryRange(first: 9728, last: 9983, category: Category::OtherSymbol));           // 0x2600 .. 0x26FF misc
    rows.push_back(CategoryRange(first: 9984, last: 10175, category: Category::OtherSymbol));          // 0x2700 .. 0x27BF dingbats

    // CJK.
    rows.push_back(CategoryRange(first: 11904, last: 12031, category: Category::OtherSymbol));         // 0x2E80 .. 0x2EFF radicals
    rows.push_back(CategoryRange(first: 12288, last: 12288, category: Category::SpaceSeparator));      // 0x3000 ideographic space
    rows.push_back(CategoryRange(first: 12289, last: 12291, category: Category::OtherPunctuation));    // 0x3001 .. 0x3003
    rows.push_back(CategoryRange(first: 12296, last: 12296, category: Category::OpenPunctuation));     // 0x3008
    rows.push_back(CategoryRange(first: 12297, last: 12297, category: Category::ClosePunctuation));    // 0x3009
    rows.push_back(CategoryRange(first: 12352, last: 12447, category: Category::OtherLetter));         // 0x3040 .. 0x309F hiragana
    rows.push_back(CategoryRange(first: 12448, last: 12543, category: Category::OtherLetter));         // 0x30A0 .. 0x30FF katakana
    rows.push_back(CategoryRange(first: 13312, last: 19903, category: Category::OtherLetter));         // 0x3400 .. 0x4DBF ext A
    rows.push_back(CategoryRange(first: 19968, last: 40959, category: Category::OtherLetter));         // 0x4E00 .. 0x9FFF unified
    rows.push_back(CategoryRange(first: 44032, last: 55203, category: Category::OtherLetter));         // 0xAC00 .. 0xD7A3 hangul

    // Surrogates and private use, present so that a lookup never falls through
    // to Unassigned for a code point that is merely unusable.
    rows.push_back(CategoryRange(first: 55296, last: 57343, category: Category::Surrogate));           // 0xD800 .. 0xDFFF
    rows.push_back(CategoryRange(first: 57344, last: 63743, category: Category::PrivateUse));          // 0xE000 .. 0xF8FF

    // Compatibility forms and the specials block.
    rows.push_back(CategoryRange(first: 64256, last: 64262, category: Category::LowercaseLetter));     // 0xFB00 .. 0xFB06 ligatures
    rows.push_back(CategoryRange(first: 65024, last: 65039, category: Category::NonspacingMark));      // 0xFE00 .. 0xFE0F variation
    rows.push_back(CategoryRange(first: 65056, last: 65071, category: Category::NonspacingMark));      // 0xFE20 .. 0xFE2F half marks
    rows.push_back(CategoryRange(first: 65279, last: 65279, category: Category::Format));              // 0xFEFF byte order mark
    rows.push_back(CategoryRange(first: 65281, last: 65374, category: Category::OtherPunctuation));    // 0xFF01 .. 0xFF5E full width
    rows.push_back(CategoryRange(first: 65529, last: 65531, category: Category::Format));              // 0xFFF9 .. 0xFFFB

    // Supplementary planes: the four byte decode path.
    rows.push_back(CategoryRange(first: 65536, last: 65663, category: Category::OtherLetter));         // 0x10000 linear B
    rows.push_back(CategoryRange(first: 66560, last: 66599, category: Category::UppercaseLetter));     // 0x10400 deseret upper
    rows.push_back(CategoryRange(first: 66600, last: 66639, category: Category::LowercaseLetter));     // 0x10428 deseret lower
    rows.push_back(CategoryRange(first: 119808, last: 119892, category: Category::UppercaseLetter));   // 0x1D400 math bold
    rows.push_back(CategoryRange(first: 127462, last: 127487, category: Category::OtherSymbol));       // 0x1F1E6 regional
    rows.push_back(CategoryRange(first: 127744, last: 128511, category: Category::OtherSymbol));       // 0x1F300 .. 0x1F5FF
    rows.push_back(CategoryRange(first: 128512, last: 128591, category: Category::OtherSymbol));       // 0x1F600 .. 0x1F64F
    rows.push_back(CategoryRange(first: 129280, last: 129535, category: Category::OtherSymbol));       // 0x1F980 .. 0x1FA7F
    rows.push_back(CategoryRange(first: 131072, last: 173791, category: Category::OtherLetter));       // 0x20000 ext B
    rows.push_back(CategoryRange(first: 983040, last: 1048573, category: Category::PrivateUse));       // 0xF0000 plane 15
    rows.push_back(CategoryRange(first: 1048576, last: 1114109, category: Category::PrivateUse));      // 0x100000 plane 16

    return rows;
}

// Binary search over a sorted range table. The tables are built once and never
// mutated, so the invariant the search relies on is easy to state.
fn find_category(rows: &const shared vector{CategoryRange}, scalar: int) -> Category: {
    var low: int = 0;
    var high = rows.size() - 1;
    while low <= high: {
        let middle = low + ((high - low) >> 1);
        let row: &const = rows.at(middle);
        if scalar < row.first: {
            high = middle - 1;
        } else: {
            if scalar > row.last: {
                low = middle + 1;
            } else: {
                return row.category;
            }
        }
    }
    return Category::Unassigned;
}

// --- Category predicates -------------------------------------------------

fn is_letter_category(category: Category) -> bool: {
    if category == Category::UppercaseLetter: {
        return true;
    }
    if category == Category::LowercaseLetter: {
        return true;
    }
    if category == Category::TitlecaseLetter: {
        return true;
    }
    if category == Category::ModifierLetter: {
        return true;
    }
    return category == Category::OtherLetter;
}

fn is_mark_category(category: Category) -> bool: {
    if category == Category::NonspacingMark: {
        return true;
    }
    if category == Category::SpacingMark: {
        return true;
    }
    return category == Category::EnclosingMark;
}

fn is_number_category(category: Category) -> bool: {
    if category == Category::DecimalNumber: {
        return true;
    }
    if category == Category::LetterNumber: {
        return true;
    }
    return category == Category::OtherNumber;
}

fn is_punctuation_category(category: Category) -> bool: {
    if category == Category::ConnectorPunctuation: {
        return true;
    }
    if category == Category::DashPunctuation: {
        return true;
    }
    if category == Category::OpenPunctuation: {
        return true;
    }
    if category == Category::ClosePunctuation: {
        return true;
    }
    if category == Category::InitialPunctuation: {
        return true;
    }
    if category == Category::FinalPunctuation: {
        return true;
    }
    return category == Category::OtherPunctuation;
}

fn is_symbol_category(category: Category) -> bool: {
    if category == Category::MathSymbol: {
        return true;
    }
    if category == Category::CurrencySymbol: {
        return true;
    }
    if category == Category::ModifierSymbol: {
        return true;
    }
    return category == Category::OtherSymbol;
}

fn is_separator_category(category: Category) -> bool: {
    if category == Category::SpaceSeparator: {
        return true;
    }
    if category == Category::LineSeparator: {
        return true;
    }
    return category == Category::ParagraphSeparator;
}

fn category_name(category: Category) -> string: {
    if category == Category::UppercaseLetter: { return "Lu"; }
    if category == Category::LowercaseLetter: { return "Ll"; }
    if category == Category::TitlecaseLetter: { return "Lt"; }
    if category == Category::ModifierLetter: { return "Lm"; }
    if category == Category::OtherLetter: { return "Lo"; }
    if category == Category::NonspacingMark: { return "Mn"; }
    if category == Category::SpacingMark: { return "Mc"; }
    if category == Category::EnclosingMark: { return "Me"; }
    if category == Category::DecimalNumber: { return "Nd"; }
    if category == Category::LetterNumber: { return "Nl"; }
    if category == Category::OtherNumber: { return "No"; }
    if category == Category::ConnectorPunctuation: { return "Pc"; }
    if category == Category::DashPunctuation: { return "Pd"; }
    if category == Category::OpenPunctuation: { return "Ps"; }
    if category == Category::ClosePunctuation: { return "Pe"; }
    if category == Category::InitialPunctuation: { return "Pi"; }
    if category == Category::FinalPunctuation: { return "Pf"; }
    if category == Category::OtherPunctuation: { return "Po"; }
    if category == Category::MathSymbol: { return "Sm"; }
    if category == Category::CurrencySymbol: { return "Sc"; }
    if category == Category::ModifierSymbol: { return "Sk"; }
    if category == Category::OtherSymbol: { return "So"; }
    if category == Category::SpaceSeparator: { return "Zs"; }
    if category == Category::LineSeparator: { return "Zl"; }
    if category == Category::ParagraphSeparator: { return "Zp"; }
    if category == Category::Control: { return "Cc"; }
    if category == Category::Format: { return "Cf"; }
    if category == Category::Surrogate: { return "Cs"; }
    if category == Category::PrivateUse: { return "Co"; }
    return "Cn";
}

// --- Whitespace and combining tables -------------------------------------

// Every code point with White_Space=Yes. Short enough to spell out in full.
fn whitespace_table() -> vector{CategoryRange}: {
    var rows: vector{CategoryRange};
    rows.push_back(CategoryRange(first: 9, last: 13, category: Category::Control));                    // tab .. carriage return
    rows.push_back(CategoryRange(first: 32, last: 32, category: Category::SpaceSeparator));            // space
    rows.push_back(CategoryRange(first: 133, last: 133, category: Category::Control));                 // 0x0085 next line
    rows.push_back(CategoryRange(first: 160, last: 160, category: Category::SpaceSeparator));          // 0x00A0
    rows.push_back(CategoryRange(first: 5760, last: 5760, category: Category::SpaceSeparator));        // 0x1680 ogham
    rows.push_back(CategoryRange(first: 8192, last: 8202, category: Category::SpaceSeparator));        // 0x2000 .. 0x200A
    rows.push_back(CategoryRange(first: 8232, last: 8232, category: Category::LineSeparator));         // 0x2028
    rows.push_back(CategoryRange(first: 8233, last: 8233, category: Category::ParagraphSeparator));    // 0x2029
    rows.push_back(CategoryRange(first: 8239, last: 8239, category: Category::SpaceSeparator));        // 0x202F narrow
    rows.push_back(CategoryRange(first: 8287, last: 8287, category: Category::SpaceSeparator));        // 0x205F medium math
    rows.push_back(CategoryRange(first: 12288, last: 12288, category: Category::SpaceSeparator));      // 0x3000 ideographic
    return rows;
}

// Canonical combining classes for the marks this library composes. The value
// is the raw property number, not the enumeration, because the reordering
// algorithm compares magnitudes.
fn combining_table() -> vector{CombiningRange}: {
    var rows: vector{CombiningRange};
    rows.push_back(CombiningRange(first: 768, last: 788, combining: 230));      // 0x0300 .. 0x0314 above
    rows.push_back(CombiningRange(first: 789, last: 789, combining: 232));      // 0x0315 above right
    rows.push_back(CombiningRange(first: 790, last: 793, combining: 220));      // 0x0316 .. 0x0319 below
    rows.push_back(CombiningRange(first: 794, last: 795, combining: 232));      // 0x031A .. 0x031B
    rows.push_back(CombiningRange(first: 796, last: 803, combining: 220));      // 0x031C .. 0x0323
    rows.push_back(CombiningRange(first: 804, last: 806, combining: 220));      // 0x0324 .. 0x0326
    rows.push_back(CombiningRange(first: 807, last: 808, combining: 202));      // 0x0327 .. 0x0328 attached below
    rows.push_back(CombiningRange(first: 809, last: 819, combining: 220));      // 0x0329 .. 0x0333
    rows.push_back(CombiningRange(first: 820, last: 824, combining: 1));        // 0x0334 .. 0x0338 overlay
    rows.push_back(CombiningRange(first: 825, last: 828, combining: 220));      // 0x0339 .. 0x033C
    rows.push_back(CombiningRange(first: 829, last: 836, combining: 230));      // 0x033D .. 0x0344
    rows.push_back(CombiningRange(first: 837, last: 837, combining: 240));      // 0x0345 iota subscript
    rows.push_back(CombiningRange(first: 838, last: 841, combining: 230));      // 0x0346 .. 0x0349
    rows.push_back(CombiningRange(first: 842, last: 844, combining: 230));      // 0x034A .. 0x034C
    rows.push_back(CombiningRange(first: 845, last: 846, combining: 220));      // 0x034D .. 0x034E
    rows.push_back(CombiningRange(first: 848, last: 855, combining: 230));      // 0x0350 .. 0x0357
    rows.push_back(CombiningRange(first: 856, last: 859, combining: 230));      // 0x0358 .. 0x035B
    rows.push_back(CombiningRange(first: 860, last: 860, combining: 233));      // 0x035C double below
    rows.push_back(CombiningRange(first: 861, last: 862, combining: 234));      // 0x035D .. 0x035E double above
    rows.push_back(CombiningRange(first: 863, last: 863, combining: 233));      // 0x035F
    rows.push_back(CombiningRange(first: 864, last: 865, combining: 234));      // 0x0360 .. 0x0361
    rows.push_back(CombiningRange(first: 866, last: 866, combining: 233));      // 0x0362
    rows.push_back(CombiningRange(first: 867, last: 879, combining: 230));      // 0x0363 .. 0x036F
    rows.push_back(CombiningRange(first: 1425, last: 1425, combining: 220));    // 0x0591 hebrew
    rows.push_back(CombiningRange(first: 1426, last: 1426, combining: 230));    // 0x0592
    rows.push_back(CombiningRange(first: 1443, last: 1444, combining: 220));    // 0x05A3 .. 0x05A4
    rows.push_back(CombiningRange(first: 1456, last: 1465, combining: 10));     // 0x05B0 .. 0x05B9 points
    rows.push_back(CombiningRange(first: 1471, last: 1471, combining: 23));     // 0x05BF
    rows.push_back(CombiningRange(first: 1473, last: 1474, combining: 24));     // 0x05C1 .. 0x05C2
    rows.push_back(CombiningRange(first: 1611, last: 1621, combining: 230));    // 0x064B .. 0x0655 arabic
    rows.push_back(CombiningRange(first: 1648, last: 1648, combining: 230));    // 0x0670
    rows.push_back(CombiningRange(first: 2364, last: 2364, combining: 7));      // 0x093C nukta
    rows.push_back(CombiningRange(first: 2381, last: 2381, combining: 9));      // 0x094D virama
    rows.push_back(CombiningRange(first: 3633, last: 3633, combining: 0));      // 0x0E31 thai
    rows.push_back(CombiningRange(first: 3636, last: 3642, combining: 0));      // 0x0E34 .. 0x0E3A
    rows.push_back(CombiningRange(first: 12330, last: 12331, combining: 218));  // 0x302A .. 0x302B
    rows.push_back(CombiningRange(first: 12332, last: 12333, combining: 228));  // 0x302C .. 0x302D
    rows.push_back(CombiningRange(first: 12441, last: 12442, combining: 8));    // 0x3099 .. 0x309A kana voicing
    return rows;
}

fn find_combining(rows: &const shared vector{CombiningRange}, scalar: int) -> int: {
    var low: int = 0;
    var high = rows.size() - 1;
    while low <= high: {
        let middle = low + ((high - low) >> 1);
        let row: &const = rows.at(middle);
        if scalar < row.first: {
            high = middle - 1;
        } else: {
            if scalar > row.last: {
                low = middle + 1;
            } else: {
                return row.combining;
            }
        }
    }
    return 0;
}

// --- The shared property database ----------------------------------------
//
// One instance holds every table. Building the tables costs a few hundred
// vector pushes, so the caller is expected to build it once and pass a
// reference around.
struct Properties: {

    fn build(self: &unique): {
        .categories = category_table();
        .whitespace = whitespace_table();
        .combining = combining_table();
        .widths = width_table();
        .breaks = grapheme_break_table();
        .words = word_break_table();
        .cases = case_table();
        .specials = special_case_table();
        .decompositions = decomposition_table();
        .ready = true;
    }

    fn category_of(self: &const shared, scalar: int) -> Category: {
        if scalar >= 0 && scalar <= MAX_ASCII: {
            return ascii_category(scalar);
        }
        return find_category(.categories, scalar);
    }

    fn combining_of(self: &const shared, scalar: int) -> int: {
        if scalar <= MAX_ASCII: {
            return 0;
        }
        return find_combining(.combining, scalar);
    }

    fn is_letter(self: &const shared, scalar: int) -> bool: {
        return is_letter_category(.category_of(scalar));
    }

    fn is_digit(self: &const shared, scalar: int) -> bool: {
        return .category_of(scalar) == Category::DecimalNumber;
    }

    fn is_number(self: &const shared, scalar: int) -> bool: {
        return is_number_category(.category_of(scalar));
    }

    fn is_mark(self: &const shared, scalar: int) -> bool: {
        return is_mark_category(.category_of(scalar));
    }

    fn is_punctuation(self: &const shared, scalar: int) -> bool: {
        return is_punctuation_category(.category_of(scalar));
    }

    fn is_symbol(self: &const shared, scalar: int) -> bool: {
        return is_symbol_category(.category_of(scalar));
    }

    fn is_control(self: &const shared, scalar: int) -> bool: {
        if scalar < 32: {
            return true;
        }
        if scalar >= 127 && scalar <= 159: {   // 0x7F .. 0x9F
            return true;
        }
        return .category_of(scalar) == Category::Control;
    }

    fn is_format(self: &const shared, scalar: int) -> bool: {
        return .category_of(scalar) == Category::Format;
    }

    fn is_whitespace(self: &const shared, scalar: int) -> bool: {
        if scalar >= 9 && scalar <= 13: {
            return true;
        }
        if scalar == 32: {
            return true;
        }
        return find_category(.whitespace, scalar) != Category::Unassigned;
    }

    fn is_combining(self: &const shared, scalar: int) -> bool: {
        return .combining_of(scalar) != 0 || .is_mark(scalar);
    }

    fn is_printable(self: &const shared, scalar: int) -> bool: {
        if .is_control(scalar): {
            return false;
        }
        if .is_format(scalar): {
            return false;
        }
        let category = .category_of(scalar);
        if category == Category::Surrogate: {
            return false;
        }
        return category != Category::Unassigned;
    }

    // A code point that may begin an identifier under the default rules: a
    // letter, a letter number, or the connector underscore.
    fn is_identifier_start(self: &const shared, scalar: int) -> bool: {
        if scalar == 95: {                     // underscore
            return true;
        }
        let category = .category_of(scalar);
        if category == Category::LetterNumber: {
            return true;
        }
        return is_letter_category(category);
    }

    fn is_identifier_part(self: &const shared, scalar: int) -> bool: {
        if .is_identifier_start(scalar): {
            return true;
        }
        let category = .category_of(scalar);
        if category == Category::NonspacingMark: {
            return true;
        }
        if category == Category::SpacingMark: {
            return true;
        }
        if category == Category::DecimalNumber: {
            return true;
        }
        if category == Category::ConnectorPunctuation: {
            return true;
        }
        return category == Category::Format;
    }

    categories: vector{CategoryRange};
    whitespace: vector{CategoryRange};
    combining: vector{CombiningRange};
    widths: vector{WidthRange};
    breaks: vector{BreakRange};
    words: vector{WordRange};
    cases: vector{CaseRow};
    specials: vector{SpecialCaseRow};
    decompositions: vector{DecompositionRow};
    ready: bool = false;
}

// ASCII is answered without touching the range table at all.
fn ascii_category(scalar: int) -> Category: {
    let c = char(scalar);
    if c >= 'A' && c <= 'Z': {
        return Category::UppercaseLetter;
    }
    if c >= 'a' && c <= 'z': {
        return Category::LowercaseLetter;
    }
    if c >= '0' && c <= '9': {
        return Category::DecimalNumber;
    }
    if c == ' ': {
        return Category::SpaceSeparator;
    }
    if scalar < 32 || scalar == 127: {
        return Category::Control;
    }
    if c == '$': {
        return Category::CurrencySymbol;
    }
    if c == '+' || c == '<' || c == '=' || c == '>' || c == '|' || c == '~': {
        return Category::MathSymbol;
    }
    if c == '^' || c == '`': {
        return Category::ModifierSymbol;
    }
    if c == '-': {
        return Category::DashPunctuation;
    }
    if c == '_': {
        return Category::ConnectorPunctuation;
    }
    if c == '(' || c == '[' || c == '{': {
        return Category::OpenPunctuation;
    }
    if c == ')' || c == ']' || c == '}': {
        return Category::ClosePunctuation;
    }
    return Category::OtherPunctuation;
}

// --- Case mapping --------------------------------------------------------
//
// Most case mappings are a constant delta over a run of code points, and many
// of those runs alternate upper and lower on consecutive code points. A row
// therefore carries a step: step one covers a solid run, step two covers the
// alternating Latin Extended-A pattern where each uppercase letter is
// immediately followed by its lowercase partner.
fn case_table() -> vector{CaseRow}: {
    var rows: vector{CaseRow};

    // Basic Latin.
    rows.push_back(CaseRow(first: 65, last: 90, step: 1, lower_delta: 32, upper_delta: 0, title_delta: 0));       // A .. Z
    rows.push_back(CaseRow(first: 97, last: 122, step: 1, lower_delta: 0, upper_delta: -32, title_delta: -32));   // a .. z

    // Latin-1 supplement. The multiply and divide signs sit inside the runs
    // and are excluded by splitting each run in two.
    rows.push_back(CaseRow(first: 192, last: 214, step: 1, lower_delta: 32, upper_delta: 0, title_delta: 0));     // 0x00C0 .. 0x00D6
    rows.push_back(CaseRow(first: 216, last: 222, step: 1, lower_delta: 32, upper_delta: 0, title_delta: 0));     // 0x00D8 .. 0x00DE
    rows.push_back(CaseRow(first: 224, last: 246, step: 1, lower_delta: 0, upper_delta: -32, title_delta: -32));  // 0x00E0 .. 0x00F6
    rows.push_back(CaseRow(first: 248, last: 254, step: 1, lower_delta: 0, upper_delta: -32, title_delta: -32));  // 0x00F8 .. 0x00FE
    rows.push_back(CaseRow(first: 255, last: 255, step: 1, lower_delta: 0, upper_delta: -121, title_delta: -121));// 0x00FF y diaeresis

    // Latin Extended-A: alternating pairs, so a step of two with the uppercase
    // rows starting on the even code points.
    rows.push_back(CaseRow(first: 256, last: 302, step: 2, lower_delta: 1, upper_delta: 0, title_delta: 0));      // 0x0100 .. 0x012E
    rows.push_back(CaseRow(first: 257, last: 303, step: 2, lower_delta: 0, upper_delta: -1, title_delta: -1));    // 0x0101 .. 0x012F
    rows.push_back(CaseRow(first: 306, last: 310, step: 2, lower_delta: 1, upper_delta: 0, title_delta: 0));      // 0x0132 .. 0x0136
    rows.push_back(CaseRow(first: 307, last: 311, step: 2, lower_delta: 0, upper_delta: -1, title_delta: -1));    // 0x0133 .. 0x0137
    rows.push_back(CaseRow(first: 313, last: 327, step: 2, lower_delta: 1, upper_delta: 0, title_delta: 0));      // 0x0139 .. 0x0147
    rows.push_back(CaseRow(first: 314, last: 328, step: 2, lower_delta: 0, upper_delta: -1, title_delta: -1));    // 0x013A .. 0x0148
    rows.push_back(CaseRow(first: 330, last: 374, step: 2, lower_delta: 1, upper_delta: 0, title_delta: 0));      // 0x014A .. 0x0176
    rows.push_back(CaseRow(first: 331, last: 375, step: 2, lower_delta: 0, upper_delta: -1, title_delta: -1));    // 0x014B .. 0x0177
    rows.push_back(CaseRow(first: 376, last: 376, step: 1, lower_delta: -121, upper_delta: 0, title_delta: 0));   // 0x0178
    rows.push_back(CaseRow(first: 377, last: 381, step: 2, lower_delta: 1, upper_delta: 0, title_delta: 0));      // 0x0179 .. 0x017D
    rows.push_back(CaseRow(first: 378, last: 382, step: 2, lower_delta: 0, upper_delta: -1, title_delta: -1));    // 0x017A .. 0x017E
    rows.push_back(CaseRow(first: 383, last: 383, step: 1, lower_delta: 0, upper_delta: -268, title_delta: -268));// 0x017F long s

    // A handful of Latin Extended-B rows with the title case column actually
    // different from the upper case column.
    rows.push_back(CaseRow(first: 452, last: 452, step: 1, lower_delta: 2, upper_delta: 0, title_delta: 1));      // 0x01C4 DZ
    rows.push_back(CaseRow(first: 453, last: 453, step: 1, lower_delta: 1, upper_delta: -1, title_delta: 0));     // 0x01C5 Dz
    rows.push_back(CaseRow(first: 454, last: 454, step: 1, lower_delta: 0, upper_delta: -2, title_delta: -1));    // 0x01C6 dz
    rows.push_back(CaseRow(first: 455, last: 455, step: 1, lower_delta: 2, upper_delta: 0, title_delta: 1));      // 0x01C7 LJ
    rows.push_back(CaseRow(first: 456, last: 456, step: 1, lower_delta: 1, upper_delta: -1, title_delta: 0));     // 0x01C8 Lj
    rows.push_back(CaseRow(first: 457, last: 457, step: 1, lower_delta: 0, upper_delta: -2, title_delta: -1));    // 0x01C9 lj
    rows.push_back(CaseRow(first: 458, last: 458, step: 1, lower_delta: 2, upper_delta: 0, title_delta: 1));      // 0x01CA NJ
    rows.push_back(CaseRow(first: 459, last: 459, step: 1, lower_delta: 1, upper_delta: -1, title_delta: 0));     // 0x01CB Nj
    rows.push_back(CaseRow(first: 460, last: 460, step: 1, lower_delta: 0, upper_delta: -2, title_delta: -1));    // 0x01CC nj

    // Greek.
    rows.push_back(CaseRow(first: 902, last: 902, step: 1, lower_delta: 38, upper_delta: 0, title_delta: 0));     // 0x0386
    rows.push_back(CaseRow(first: 904, last: 906, step: 1, lower_delta: 37, upper_delta: 0, title_delta: 0));     // 0x0388 .. 0x038A
    rows.push_back(CaseRow(first: 908, last: 908, step: 1, lower_delta: 64, upper_delta: 0, title_delta: 0));     // 0x038C
    rows.push_back(CaseRow(first: 910, last: 911, step: 1, lower_delta: 63, upper_delta: 0, title_delta: 0));     // 0x038E .. 0x038F
    rows.push_back(CaseRow(first: 913, last: 929, step: 1, lower_delta: 32, upper_delta: 0, title_delta: 0));     // 0x0391 .. 0x03A1
    rows.push_back(CaseRow(first: 931, last: 939, step: 1, lower_delta: 32, upper_delta: 0, title_delta: 0));     // 0x03A3 .. 0x03AB
    rows.push_back(CaseRow(first: 945, last: 961, step: 1, lower_delta: 0, upper_delta: -32, title_delta: -32));  // 0x03B1 .. 0x03C1
    rows.push_back(CaseRow(first: 962, last: 962, step: 1, lower_delta: 0, upper_delta: -31, title_delta: -31));  // 0x03C2 final sigma
    rows.push_back(CaseRow(first: 963, last: 971, step: 1, lower_delta: 0, upper_delta: -32, title_delta: -32));  // 0x03C3 .. 0x03CB

    // Cyrillic: one solid run of 32 plus the shifted archaic block.
    rows.push_back(CaseRow(first: 1024, last: 1039, step: 1, lower_delta: 80, upper_delta: 0, title_delta: 0));   // 0x0400 .. 0x040F
    rows.push_back(CaseRow(first: 1040, last: 1071, step: 1, lower_delta: 32, upper_delta: 0, title_delta: 0));   // 0x0410 .. 0x042F
    rows.push_back(CaseRow(first: 1072, last: 1103, step: 1, lower_delta: 0, upper_delta: -32, title_delta: -32));// 0x0430 .. 0x044F
    rows.push_back(CaseRow(first: 1104, last: 1119, step: 1, lower_delta: 0, upper_delta: -80, title_delta: -80));// 0x0450 .. 0x045F
    rows.push_back(CaseRow(first: 1120, last: 1152, step: 2, lower_delta: 1, upper_delta: 0, title_delta: 0));    // 0x0460 .. 0x0480
    rows.push_back(CaseRow(first: 1121, last: 1153, step: 2, lower_delta: 0, upper_delta: -1, title_delta: -1));  // 0x0461 .. 0x0481

    // Armenian and Georgian.
    rows.push_back(CaseRow(first: 1329, last: 1366, step: 1, lower_delta: 48, upper_delta: 0, title_delta: 0));   // 0x0531 .. 0x0556
    rows.push_back(CaseRow(first: 1377, last: 1414, step: 1, lower_delta: 0, upper_delta: -48, title_delta: -48));// 0x0561 .. 0x0586
    rows.push_back(CaseRow(first: 4256, last: 4293, step: 1, lower_delta: 7264, upper_delta: 0, title_delta: 0)); // 0x10A0 .. 0x10C5

    // Halfwidth and fullwidth Latin.
    rows.push_back(CaseRow(first: 65313, last: 65338, step: 1, lower_delta: 32, upper_delta: 0, title_delta: 0)); // 0xFF21 .. 0xFF3A
    rows.push_back(CaseRow(first: 65345, last: 65370, step: 1, lower_delta: 0, upper_delta: -32, title_delta: -32)); // 0xFF41 .. 0xFF5A

    // Supplementary plane: Deseret, which is the standard test that a case
    // mapper does not silently truncate to sixteen bits.
    rows.push_back(CaseRow(first: 66560, last: 66599, step: 1, lower_delta: 40, upper_delta: 0, title_delta: 0)); // 0x10400 .. 0x10427
    rows.push_back(CaseRow(first: 66600, last: 66639, step: 1, lower_delta: 0, upper_delta: -40, title_delta: -40)); // 0x10428 .. 0x1044F

    return rows;
}

// Mappings that are not one to one. The German sharp s uppercases to two
// letters, the ligatures expand, and the Greek iota subscript forms grow a
// letter when they are uppercased.
fn special_case_table() -> vector{SpecialCaseRow}: {
    var rows: vector{SpecialCaseRow};
    rows.push_back(SpecialCaseRow(source: 223, upper0: 83, upper1: 83, upper2: 0, lower0: 223, lower1: 0, lower2: 0, note: "sharp s becomes SS"));            // 0x00DF
    rows.push_back(SpecialCaseRow(source: 305, upper0: 73, upper1: 0, upper2: 0, lower0: 305, lower1: 0, lower2: 0, note: "dotless i uppercases to I"));      // 0x0131
    rows.push_back(SpecialCaseRow(source: 329, upper0: 700, upper1: 78, upper2: 0, lower0: 329, lower1: 0, lower2: 0, note: "n preceded by apostrophe"));     // 0x0149
    rows.push_back(SpecialCaseRow(source: 496, upper0: 74, upper1: 780, upper2: 0, lower0: 496, lower1: 0, lower2: 0, note: "j with caron"));                 // 0x01F0
    rows.push_back(SpecialCaseRow(source: 912, upper0: 921, upper1: 776, upper2: 769, lower0: 912, lower1: 0, lower2: 0, note: "iota with dialytika tonos")); // 0x0390
    rows.push_back(SpecialCaseRow(source: 944, upper0: 933, upper1: 776, upper2: 769, lower0: 944, lower1: 0, lower2: 0, note: "upsilon dialytika tonos"));   // 0x03B0
    rows.push_back(SpecialCaseRow(source: 64256, upper0: 70, upper1: 70, upper2: 0, lower0: 64256, lower1: 0, lower2: 0, note: "ligature ff"));               // 0xFB00
    rows.push_back(SpecialCaseRow(source: 64257, upper0: 70, upper1: 73, upper2: 0, lower0: 64257, lower1: 0, lower2: 0, note: "ligature fi"));               // 0xFB01
    rows.push_back(SpecialCaseRow(source: 64258, upper0: 70, upper1: 76, upper2: 0, lower0: 64258, lower1: 0, lower2: 0, note: "ligature fl"));               // 0xFB02
    rows.push_back(SpecialCaseRow(source: 64259, upper0: 70, upper1: 70, upper2: 73, lower0: 64259, lower1: 0, lower2: 0, note: "ligature ffi"));             // 0xFB03
    rows.push_back(SpecialCaseRow(source: 64260, upper0: 70, upper1: 70, upper2: 76, lower0: 64260, lower1: 0, lower2: 0, note: "ligature ffl"));             // 0xFB04
    rows.push_back(SpecialCaseRow(source: 64261, upper0: 83, upper1: 84, upper2: 0, lower0: 64261, lower1: 0, lower2: 0, note: "ligature long s t"));         // 0xFB05
    rows.push_back(SpecialCaseRow(source: 64262, upper0: 83, upper1: 84, upper2: 0, lower0: 64262, lower1: 0, lower2: 0, note: "ligature st"));               // 0xFB06
    return rows;
}

fn find_case_row(rows: &const shared vector{CaseRow}, scalar: int) -> int: {
    var index: int = 0;
    for row: &const in rows: {
        if scalar >= row.first && scalar <= row.last: {
            if row.step == 1: {
                return index;
            }
            // A stepped row only covers every other code point, so the offset
            // from the start of the row has to be a multiple of the step.
            if ((scalar - row.first) % row.step) == 0: {
                return index;
            }
        }
        index += 1;
    }
    return -1;
}

fn find_special_case(rows: &const shared vector{SpecialCaseRow}, scalar: int) -> int: {
    var index: int = 0;
    for row: &const in rows: {
        if row.source == scalar: {
            return index;
        }
        index += 1;
    }
    return -1;
}

fn to_lower_scalar(props: &const shared Properties, scalar: int) -> int: {
    if scalar >= int('A') && scalar <= int('Z'): {
        return scalar + 32;
    }
    if scalar <= MAX_ASCII: {
        return scalar;
    }
    let index = find_case_row(props.cases, scalar);
    if index < 0: {
        return scalar;
    }
    let row: &const = props.cases.at(index);
    return scalar + row.lower_delta;
}

fn to_upper_scalar(props: &const shared Properties, scalar: int) -> int: {
    if scalar >= int('a') && scalar <= int('z'): {
        return scalar - 32;
    }
    if scalar <= MAX_ASCII: {
        return scalar;
    }
    let index = find_case_row(props.cases, scalar);
    if index < 0: {
        return scalar;
    }
    let row: &const = props.cases.at(index);
    return scalar + row.upper_delta;
}

fn to_title_scalar(props: &const shared Properties, scalar: int) -> int: {
    if scalar >= int('a') && scalar <= int('z'): {
        return scalar - 32;
    }
    if scalar <= MAX_ASCII: {
        return scalar;
    }
    let index = find_case_row(props.cases, scalar);
    if index < 0: {
        return scalar;
    }
    let row: &const = props.cases.at(index);
    return scalar + row.title_delta;
}

// Case folding for caseless comparison. Simple folding only: it maps to lower
// case with the handful of exceptions that would otherwise compare unequal.
fn fold_scalar(props: &const shared Properties, scalar: int) -> int: {
    if scalar == 304: {                        // 0x0130 capital I with dot
        return int('i');
    }
    if scalar == 305: {                        // 0x0131 dotless i
        return int('i');
    }
    if scalar == 383: {                        // 0x017F long s
        return int('s');
    }
    if scalar == 962: {                        // 0x03C2 final sigma
        return 963;                            // 0x03C3
    }
    if scalar == 976: {                        // 0x03D0 beta symbol
        return 946;                            // 0x03B2
    }
    if scalar == 977: {                        // 0x03D1 theta symbol
        return 952;                            // 0x03B8
    }
    if scalar == 981: {                        // 0x03D5 phi symbol
        return 966;                            // 0x03C6
    }
    if scalar == 982: {                        // 0x03D6 pi symbol
        return 960;                            // 0x03C0
    }
    if scalar == 8486: {                       // 0x2126 ohm sign
        return 969;                            // 0x03C9
    }
    if scalar == 8490: {                       // 0x212A kelvin sign
        return int('k');
    }
    if scalar == 8491: {                       // 0x212B angstrom sign
        return 229;                            // 0x00E5
    }
    return to_lower_scalar(props, scalar);
}

// Uppercase one scalar, expanding it when the special case table says so.
// Returns how many scalars were appended.
fn upper_expand(props: &const shared Properties, scalar: int, sink: &unique vector{int}) -> int: {
    let index = find_special_case(props.specials, scalar);
    if index < 0: {
        sink.push_back(to_upper_scalar(props, scalar));
        return 1;
    }
    let row: &const = props.specials.at(index);
    sink.push_back(row.upper0);
    if row.upper1 == 0: {
        return 1;
    }
    sink.push_back(row.upper1);
    if row.upper2 == 0: {
        return 2;
    }
    sink.push_back(row.upper2);
    return 3;
}

fn lower_expand(props: &const shared Properties, scalar: int, sink: &unique vector{int}) -> int: {
    let index = find_special_case(props.specials, scalar);
    if index < 0: {
        sink.push_back(to_lower_scalar(props, scalar));
        return 1;
    }
    let row: &const = props.specials.at(index);
    sink.push_back(row.lower0);
    if row.lower1 == 0: {
        return 1;
    }
    sink.push_back(row.lower1);
    if row.lower2 == 0: {
        return 2;
    }
    sink.push_back(row.lower2);
    return 3;
}

fn to_upper(props: &const shared Properties, scalars: &const shared vector{int}) -> vector{int}: {
    var out: vector{int};
    out.reserve(scalars.size());
    for scalar: &const in scalars: {
        discard upper_expand(props, scalar, out);
    }
    return out;
}

fn to_lower(props: &const shared Properties, scalars: &const shared vector{int}) -> vector{int}: {
    var out: vector{int};
    out.reserve(scalars.size());
    for scalar: &const in scalars: {
        discard lower_expand(props, scalar, out);
    }
    return out;
}

// Title case a run: the first cased scalar of every word is titled and the
// rest are lowered. Word boundaries here are the simple ones, which is all a
// display routine needs.
fn to_title(props: &const shared Properties, scalars: &const shared vector{int}) -> vector{int}: {
    var out: vector{int};
    var at_word_start: bool = true;
    for scalar: &const in scalars: {
        if props.is_letter(scalar): {
            if at_word_start: {
                out.push_back(to_title_scalar(props, scalar));
            } else: {
                out.push_back(to_lower_scalar(props, scalar));
            }
            at_word_start = false;
        } else: {
            out.push_back(scalar);
            if props.is_whitespace(scalar) || props.is_punctuation(scalar): {
                at_word_start = true;
            }
        }
    }
    return out;
}

fn case_fold(props: &const shared Properties, scalars: &const shared vector{int}) -> vector{int}: {
    var out: vector{int};
    for scalar: &const in scalars: {
        out.push_back(fold_scalar(props, scalar));
    }
    return out;
}

// Compare two scalar runs ignoring case. Returns a negative number, zero or a
// positive number in the usual way.
fn compare_folded(props: &const shared Properties, left: &const shared vector{int}, right: &const shared vector{int}) -> int: {
    let limit = min(left.size(), right.size());
    for i in range(0, limit): {
        let a = fold_scalar(props, left.at(i));
        let b = fold_scalar(props, right.at(i));
        if a < b: {
            return -1;
        }
        if a > b: {
            return 1;
        }
    }
    if left.size() < right.size(): {
        return -1;
    }
    if left.size() > right.size(): {
        return 1;
    }
    return 0;
}

// --- Grapheme cluster segmentation ---------------------------------------
//
// Hangul syllables are composed algorithmically rather than by table: the
// block at 0xAC00 holds L * 21 * 28 + V * 28 + T for every combination, so the
// LV and LVT distinction falls out of one modulo.

static HANGUL_SYLLABLE_FIRST: int = 44032;     // 0xAC00
static HANGUL_SYLLABLE_LAST: int = 55203;      // 0xD7A3
static HANGUL_SYLLABLE_COUNT: int = 11172;
static HANGUL_L_FIRST: int = 4352;             // 0x1100
static HANGUL_L_COUNT: int = 19;
static HANGUL_V_FIRST: int = 4449;             // 0x1161
static HANGUL_V_COUNT: int = 21;
static HANGUL_T_FIRST: int = 4519;             // 0x11A7
static HANGUL_T_COUNT: int = 28;
static HANGUL_NV_COUNT: int = 588;             // V_COUNT * T_COUNT

static ZERO_WIDTH_JOINER: int = 8205;          // 0x200D
static ZERO_WIDTH_NON_JOINER: int = 8204;      // 0x200C
static COMBINING_ENCLOSING_KEYCAP: int = 8419; // 0x20E3
static REGIONAL_INDICATOR_FIRST: int = 127462; // 0x1F1E6
static REGIONAL_INDICATOR_LAST: int = 127487;  // 0x1F1FF
static VARIATION_SELECTOR_FIRST: int = 65024;  // 0xFE00
static VARIATION_SELECTOR_LAST: int = 65039;   // 0xFE0F

fn is_hangul_syllable(scalar: int) => scalar >= HANGUL_SYLLABLE_FIRST && scalar <= HANGUL_SYLLABLE_LAST;

fn hangul_is_lv(scalar: int) -> bool: {
    if is_hangul_syllable(scalar) == false: {
        return false;
    }
    return ((scalar - HANGUL_SYLLABLE_FIRST) % HANGUL_T_COUNT) == 0;
}

fn hangul_is_lvt(scalar: int) -> bool: {
    if is_hangul_syllable(scalar) == false: {
        return false;
    }
    return ((scalar - HANGUL_SYLLABLE_FIRST) % HANGUL_T_COUNT) != 0;
}

// Grapheme cluster break property table. Everything not listed is Other.
fn grapheme_break_table() -> vector{BreakRange}: {
    var rows: vector{BreakRange};
    rows.push_back(BreakRange(first: 0, last: 9, property: GraphemeBreak::ControlBreak));                 // 0x00 .. 0x09
    rows.push_back(BreakRange(first: 10, last: 10, property: GraphemeBreak::LineFeed));                   // line feed
    rows.push_back(BreakRange(first: 11, last: 12, property: GraphemeBreak::ControlBreak));               // 0x0B .. 0x0C
    rows.push_back(BreakRange(first: 13, last: 13, property: GraphemeBreak::CarriageReturn));             // carriage return
    rows.push_back(BreakRange(first: 14, last: 31, property: GraphemeBreak::ControlBreak));               // 0x0E .. 0x1F
    rows.push_back(BreakRange(first: 127, last: 159, property: GraphemeBreak::ControlBreak));             // 0x7F .. 0x9F
    rows.push_back(BreakRange(first: 173, last: 173, property: GraphemeBreak::ControlBreak));             // 0x00AD soft hyphen
    rows.push_back(BreakRange(first: 768, last: 879, property: GraphemeBreak::Extend));                   // 0x0300 .. 0x036F
    rows.push_back(BreakRange(first: 1155, last: 1161, property: GraphemeBreak::Extend));                 // 0x0483 .. 0x0489
    rows.push_back(BreakRange(first: 1425, last: 1469, property: GraphemeBreak::Extend));                 // 0x0591 .. 0x05BD
    rows.push_back(BreakRange(first: 1471, last: 1471, property: GraphemeBreak::Extend));                 // 0x05BF
    rows.push_back(BreakRange(first: 1473, last: 1474, property: GraphemeBreak::Extend));                 // 0x05C1 .. 0x05C2
    rows.push_back(BreakRange(first: 1552, last: 1562, property: GraphemeBreak::Extend));                 // 0x0610 .. 0x061A
    rows.push_back(BreakRange(first: 1611, last: 1631, property: GraphemeBreak::Extend));                 // 0x064B .. 0x065F
    rows.push_back(BreakRange(first: 1648, last: 1648, property: GraphemeBreak::Extend));                 // 0x0670
    rows.push_back(BreakRange(first: 2304, last: 2306, property: GraphemeBreak::Extend));                 // 0x0900 .. 0x0902
    rows.push_back(BreakRange(first: 2307, last: 2307, property: GraphemeBreak::SpacingMarkBreak));       // 0x0903
    rows.push_back(BreakRange(first: 2362, last: 2362, property: GraphemeBreak::Extend));                 // 0x093A
    rows.push_back(BreakRange(first: 2363, last: 2363, property: GraphemeBreak::SpacingMarkBreak));       // 0x093B
    rows.push_back(BreakRange(first: 2364, last: 2364, property: GraphemeBreak::Extend));                 // 0x093C
    rows.push_back(BreakRange(first: 2366, last: 2368, property: GraphemeBreak::SpacingMarkBreak));       // 0x093E .. 0x0940
    rows.push_back(BreakRange(first: 2369, last: 2376, property: GraphemeBreak::Extend));                 // 0x0941 .. 0x0948
    rows.push_back(BreakRange(first: 2377, last: 2380, property: GraphemeBreak::SpacingMarkBreak));       // 0x0949 .. 0x094C
    rows.push_back(BreakRange(first: 2381, last: 2381, property: GraphemeBreak::Extend));                 // 0x094D
    rows.push_back(BreakRange(first: 3633, last: 3633, property: GraphemeBreak::Extend));                 // 0x0E31
    rows.push_back(BreakRange(first: 3636, last: 3642, property: GraphemeBreak::Extend));                 // 0x0E34 .. 0x0E3A
    rows.push_back(BreakRange(first: 3655, last: 3662, property: GraphemeBreak::Extend));                 // 0x0E47 .. 0x0E4E
    rows.push_back(BreakRange(first: 4352, last: 4447, property: GraphemeBreak::HangulL));                // 0x1100 .. 0x115F
    rows.push_back(BreakRange(first: 4448, last: 4519, property: GraphemeBreak::HangulV));                // 0x1160 .. 0x11A7
    rows.push_back(BreakRange(first: 4520, last: 4607, property: GraphemeBreak::HangulT));                // 0x11A8 .. 0x11FF
    rows.push_back(BreakRange(first: 6068, last: 6069, property: GraphemeBreak::Prepend));                // 0x17B4 .. 0x17B5
    rows.push_back(BreakRange(first: 8203, last: 8203, property: GraphemeBreak::ControlBreak));           // 0x200B
    rows.push_back(BreakRange(first: 8204, last: 8204, property: GraphemeBreak::Extend));                 // 0x200C
    rows.push_back(BreakRange(first: 8205, last: 8205, property: GraphemeBreak::ZeroWidthJoiner));        // 0x200D
    rows.push_back(BreakRange(first: 8206, last: 8207, property: GraphemeBreak::ControlBreak));           // 0x200E .. 0x200F
    rows.push_back(BreakRange(first: 8232, last: 8233, property: GraphemeBreak::ControlBreak));           // 0x2028 .. 0x2029
    rows.push_back(BreakRange(first: 8234, last: 8238, property: GraphemeBreak::ControlBreak));           // 0x202A .. 0x202E
    rows.push_back(BreakRange(first: 8288, last: 8303, property: GraphemeBreak::ControlBreak));           // 0x2060 .. 0x206F
    rows.push_back(BreakRange(first: 8400, last: 8432, property: GraphemeBreak::Extend));                 // 0x20D0 .. 0x20F0
    rows.push_back(BreakRange(first: 9757, last: 9757, property: GraphemeBreak::ExtendedPictographic));   // 0x261D
    rows.push_back(BreakRange(first: 9977, last: 9977, property: GraphemeBreak::ExtendedPictographic));   // 0x26F9
    rows.push_back(BreakRange(first: 12330, last: 12335, property: GraphemeBreak::Extend));               // 0x302A .. 0x302F
    rows.push_back(BreakRange(first: 12441, last: 12442, property: GraphemeBreak::Extend));               // 0x3099 .. 0x309A
    rows.push_back(BreakRange(first: 65024, last: 65039, property: GraphemeBreak::Extend));               // 0xFE00 .. 0xFE0F
    rows.push_back(BreakRange(first: 65056, last: 65071, property: GraphemeBreak::Extend));               // 0xFE20 .. 0xFE2F
    rows.push_back(BreakRange(first: 65279, last: 65279, property: GraphemeBreak::ControlBreak));         // 0xFEFF
    rows.push_back(BreakRange(first: 65529, last: 65531, property: GraphemeBreak::ControlBreak));         // 0xFFF9 .. 0xFFFB
    rows.push_back(BreakRange(first: 127462, last: 127487, property: GraphemeBreak::RegionalIndicator));  // 0x1F1E6 .. 0x1F1FF
    rows.push_back(BreakRange(first: 127744, last: 128511, property: GraphemeBreak::ExtendedPictographic)); // 0x1F300 .. 0x1F5FF
    rows.push_back(BreakRange(first: 128512, last: 128591, property: GraphemeBreak::ExtendedPictographic)); // 0x1F600 .. 0x1F64F
    rows.push_back(BreakRange(first: 128640, last: 128767, property: GraphemeBreak::ExtendedPictographic)); // 0x1F680 .. 0x1F6FF
    rows.push_back(BreakRange(first: 129280, last: 129535, property: GraphemeBreak::ExtendedPictographic)); // 0x1F980 .. 0x1FA7F
    rows.push_back(BreakRange(first: 917504, last: 921599, property: GraphemeBreak::Extend));             // 0xE0000 .. 0xE0FFF tags
    return rows;
}

fn find_break(rows: &const shared vector{BreakRange}, scalar: int) -> GraphemeBreak: {
    var low: int = 0;
    var high = rows.size() - 1;
    while low <= high: {
        let middle = low + ((high - low) >> 1);
        let row: &const = rows.at(middle);
        if scalar < row.first: {
            high = middle - 1;
        } else: {
            if scalar > row.last: {
                low = middle + 1;
            } else: {
                return row.property;
            }
        }
    }
    return GraphemeBreak::Other;
}

// The Hangul syllable block is not in the table because it is computed.
fn grapheme_property(props: &const shared Properties, scalar: int) -> GraphemeBreak: {
    if is_hangul_syllable(scalar): {
        if hangul_is_lv(scalar): {
            return GraphemeBreak::HangulLV;
        }
        return GraphemeBreak::HangulLVT;
    }
    return find_break(props.breaks, scalar);
}

// The state a cluster walker carries between code points, which is what makes
// the regional indicator and emoji sequence rules expressible.
struct BreakState: {

    fn reset(self: &unique): {
        .previous = GraphemeBreak::Other;
        .regional_run = 0;
        .in_emoji_sequence = false;
        .started = false;
    }

    previous: GraphemeBreak = GraphemeBreak::Other;
    regional_run: int = 0;
    in_emoji_sequence: bool = false;
    started: bool = false;
}

// Decide whether a cluster boundary falls between two code points. The rules
// are applied in the order the standard gives them, and the numbering in the
// comments matches the standard so the two can be diffed.
fn breaks_between(props: &const shared Properties, state: &unique BreakState, before: int, after: int) -> bool: {
    let left = grapheme_property(props, before);
    let right = grapheme_property(props, after);

    // GB3: do not break inside a carriage return line feed pair.
    if left == GraphemeBreak::CarriageReturn && right == GraphemeBreak::LineFeed: {
        state.regional_run = 0;
        return false;
    }

    // GB4: break after any control, carriage return or line feed.
    if left == GraphemeBreak::ControlBreak: {
        state.regional_run = 0;
        return true;
    }
    if left == GraphemeBreak::CarriageReturn: {
        state.regional_run = 0;
        return true;
    }
    if left == GraphemeBreak::LineFeed: {
        state.regional_run = 0;
        return true;
    }

    // GB5: break before any control, carriage return or line feed.
    if right == GraphemeBreak::ControlBreak: {
        state.regional_run = 0;
        return true;
    }
    if right == GraphemeBreak::CarriageReturn: {
        state.regional_run = 0;
        return true;
    }
    if right == GraphemeBreak::LineFeed: {
        state.regional_run = 0;
        return true;
    }

    // GB6, GB7, GB8: do not break inside a Hangul syllable sequence.
    if left == GraphemeBreak::HangulL: {
        if right == GraphemeBreak::HangulL: {
            return false;
        }
        if right == GraphemeBreak::HangulV: {
            return false;
        }
        if right == GraphemeBreak::HangulLV: {
            return false;
        }
        if right == GraphemeBreak::HangulLVT: {
            return false;
        }
    }
    if left == GraphemeBreak::HangulLV || left == GraphemeBreak::HangulV: {
        if right == GraphemeBreak::HangulV: {
            return false;
        }
        if right == GraphemeBreak::HangulT: {
            return false;
        }
    }
    if left == GraphemeBreak::HangulLVT || left == GraphemeBreak::HangulT: {
        if right == GraphemeBreak::HangulT: {
            return false;
        }
    }

    // GB9: do not break before extending characters or the joiner.
    if right == GraphemeBreak::Extend: {
        return false;
    }
    if right == GraphemeBreak::ZeroWidthJoiner: {
        state.in_emoji_sequence = left == GraphemeBreak::ExtendedPictographic;
        return false;
    }

    // GB9a: do not break before a spacing mark.
    if right == GraphemeBreak::SpacingMarkBreak: {
        return false;
    }

    // GB9b: do not break after a prepending character.
    if left == GraphemeBreak::Prepend: {
        return false;
    }

    // GB11: do not break within an emoji joiner sequence.
    if left == GraphemeBreak::ZeroWidthJoiner: {
        if right == GraphemeBreak::ExtendedPictographic: {
            if state.in_emoji_sequence: {
                state.in_emoji_sequence = false;
                return false;
            }
        }
    }

    // GB12 and GB13: break between a pair of regional indicators, but not in
    // the middle of one flag.
    if left == GraphemeBreak::RegionalIndicator && right == GraphemeBreak::RegionalIndicator: {
        state.regional_run += 1;
        if (state.regional_run % 2) == 1: {
            return false;
        }
        state.regional_run = 0;
        return true;
    }
    state.regional_run = 0;

    // GB999: otherwise break everywhere.
    return true;
}

// Split a scalar run into clusters, each described by a half open index range.
fn grapheme_steps(props: &const shared Properties, scalars: &const shared vector{int}) -> vector{Step}: {
    var out: vector{Step};
    if scalars.empty(): {
        return out;
    }
    var state: BreakState;
    state.reset();
    var begin: int = 0;
    var index: int = 1;
    while index < scalars.size(): {
        let before = scalars.at(index - 1);
        let after = scalars.at(index);
        if breaks_between(props, state, before, after): {
            out.push_back(Step(begin: begin, end: index, valid: true));
            begin = index;
        }
        index += 1;
    }
    out.push_back(Step(begin: begin, end: scalars.size(), valid: true));
    return out;
}

fn count_graphemes(props: &const shared Properties, scalars: &const shared vector{int}) -> int: {
    if scalars.empty(): {
        return 0;
    }
    var state: BreakState;
    state.reset();
    var count: int = 1;
    var index: int = 1;
    while index < scalars.size(): {
        if breaks_between(props, state, scalars.at(index - 1), scalars.at(index)): {
            count += 1;
        }
        index += 1;
    }
    return count;
}

// The index just past the cluster that starts at from.
fn next_grapheme(props: &const shared Properties, scalars: &const shared vector{int}, from: int) -> int: {
    if from >= scalars.size(): {
        return scalars.size();
    }
    var state: BreakState;
    state.reset();
    var index = from + 1;
    while index < scalars.size(): {
        if breaks_between(props, state, scalars.at(index - 1), scalars.at(index)): {
            return index;
        }
        index += 1;
    }
    return scalars.size();
}

// Walking backwards is harder because the rules are not symmetric; the honest
// implementation rescans from the start of a bounded window.
fn previous_grapheme(props: &const shared Properties, scalars: &const shared vector{int}, from: int) -> int: {
    if from <= 0: {
        return 0;
    }
    var window = from - 64;
    if window < 0: {
        window = 0;
    }
    var candidate = window;
    var cursor = window;
    while cursor < from: {
        let step = next_grapheme(props, scalars, cursor);
        if step >= from: {
            return cursor;
        }
        candidate = cursor;
        cursor = step;
    }
    return candidate;
}

// --- Word segmentation ---------------------------------------------------

fn word_break_table() -> vector{WordRange}: {
    var rows: vector{WordRange};
    rows.push_back(WordRange(first: 9, last: 9, property: WordBreak::WhiteSpaceWord));                // tab
    rows.push_back(WordRange(first: 10, last: 10, property: WordBreak::LineFeedWord));                // line feed
    rows.push_back(WordRange(first: 11, last: 12, property: WordBreak::NewlineWord));                 // 0x0B .. 0x0C
    rows.push_back(WordRange(first: 13, last: 13, property: WordBreak::CarriageReturnWord));          // carriage return
    rows.push_back(WordRange(first: 32, last: 32, property: WordBreak::WhiteSpaceWord));              // space
    rows.push_back(WordRange(first: 34, last: 34, property: WordBreak::DoubleQuoteWord));             // 0x0022
    rows.push_back(WordRange(first: 39, last: 39, property: WordBreak::SingleQuoteWord));             // 0x0027 apostrophe
    rows.push_back(WordRange(first: 44, last: 44, property: WordBreak::MidNum));                      // comma
    rows.push_back(WordRange(first: 46, last: 46, property: WordBreak::MidNumLet));                   // full stop
    rows.push_back(WordRange(first: 48, last: 57, property: WordBreak::Numeric));                     // 0 .. 9
    rows.push_back(WordRange(first: 58, last: 58, property: WordBreak::MidLetter));                   // colon
    rows.push_back(WordRange(first: 59, last: 59, property: WordBreak::MidNum));                      // semicolon
    rows.push_back(WordRange(first: 65, last: 90, property: WordBreak::ALetter));                     // A .. Z
    rows.push_back(WordRange(first: 95, last: 95, property: WordBreak::ExtendNumLet));                // underscore
    rows.push_back(WordRange(first: 97, last: 122, property: WordBreak::ALetter));                    // a .. z
    rows.push_back(WordRange(first: 133, last: 133, property: WordBreak::NewlineWord));               // 0x0085
    rows.push_back(WordRange(first: 160, last: 160, property: WordBreak::WhiteSpaceWord));            // 0x00A0
    rows.push_back(WordRange(first: 173, last: 173, property: WordBreak::FormatWord));                // 0x00AD
    rows.push_back(WordRange(first: 183, last: 183, property: WordBreak::MidLetter));                 // 0x00B7 middle dot
    rows.push_back(WordRange(first: 192, last: 214, property: WordBreak::ALetter));                   // 0x00C0 .. 0x00D6
    rows.push_back(WordRange(first: 216, last: 246, property: WordBreak::ALetter));                   // 0x00D8 .. 0x00F6
    rows.push_back(WordRange(first: 248, last: 591, property: WordBreak::ALetter));                   // 0x00F8 .. 0x024F
    rows.push_back(WordRange(first: 768, last: 879, property: WordBreak::ExtendWord));                // 0x0300 .. 0x036F
    rows.push_back(WordRange(first: 894, last: 894, property: WordBreak::MidNum));                    // 0x037E greek semicolon
    rows.push_back(WordRange(first: 902, last: 1023, property: WordBreak::ALetter));                  // greek
    rows.push_back(WordRange(first: 1024, last: 1327, property: WordBreak::ALetter));                 // cyrillic
    rows.push_back(WordRange(first: 1425, last: 1474, property: WordBreak::ExtendWord));              // hebrew marks
    rows.push_back(WordRange(first: 1488, last: 1514, property: WordBreak::HebrewLetter));            // 0x05D0 .. 0x05EA
    rows.push_back(WordRange(first: 1536, last: 1541, property: WordBreak::FormatWord));              // 0x0600 .. 0x0605
    rows.push_back(WordRange(first: 1548, last: 1548, property: WordBreak::MidNum));                  // 0x060C
    rows.push_back(WordRange(first: 1569, last: 1610, property: WordBreak::ALetter));                 // arabic letters
    rows.push_back(WordRange(first: 1611, last: 1631, property: WordBreak::ExtendWord));              // arabic marks
    rows.push_back(WordRange(first: 1632, last: 1641, property: WordBreak::Numeric));                 // arabic digits
    rows.push_back(WordRange(first: 2304, last: 2381, property: WordBreak::ALetter));                 // devanagari
    rows.push_back(WordRange(first: 2406, last: 2415, property: WordBreak::Numeric));                 // devanagari digits
    rows.push_back(WordRange(first: 8192, last: 8202, property: WordBreak::WhiteSpaceWord));          // 0x2000 .. 0x200A
    rows.push_back(WordRange(first: 8203, last: 8203, property: WordBreak::FormatWord));              // 0x200B
    rows.push_back(WordRange(first: 8204, last: 8204, property: WordBreak::ExtendWord));              // 0x200C
    rows.push_back(WordRange(first: 8205, last: 8205, property: WordBreak::ZeroWidthJoinerWord));     // 0x200D
    rows.push_back(WordRange(first: 8206, last: 8207, property: WordBreak::FormatWord));              // 0x200E .. 0x200F
    rows.push_back(WordRange(first: 8216, last: 8217, property: WordBreak::MidNumLet));               // 0x2018 .. 0x2019
    rows.push_back(WordRange(first: 8228, last: 8228, property: WordBreak::MidNumLet));               // 0x2024
    rows.push_back(WordRange(first: 8232, last: 8233, property: WordBreak::NewlineWord));             // 0x2028 .. 0x2029
    rows.push_back(WordRange(first: 8255, last: 8256, property: WordBreak::ExtendNumLet));            // 0x203F .. 0x2040
    rows.push_back(WordRange(first: 8287, last: 8287, property: WordBreak::WhiteSpaceWord));          // 0x205F
    rows.push_back(WordRange(first: 8288, last: 8303, property: WordBreak::FormatWord));              // 0x2060 .. 0x206F
    rows.push_back(WordRange(first: 8400, last: 8432, property: WordBreak::ExtendWord));              // 0x20D0 .. 0x20F0
    rows.push_back(WordRange(first: 12288, last: 12288, property: WordBreak::WhiteSpaceWord));        // 0x3000
    rows.push_back(WordRange(first: 12441, last: 12442, property: WordBreak::ExtendWord));            // 0x3099 .. 0x309A
    rows.push_back(WordRange(first: 12448, last: 12543, property: WordBreak::Katakana));              // 0x30A0 .. 0x30FF
    rows.push_back(WordRange(first: 65024, last: 65039, property: WordBreak::ExtendWord));            // 0xFE00 .. 0xFE0F
    rows.push_back(WordRange(first: 65075, last: 65076, property: WordBreak::ExtendNumLet));          // 0xFE33 .. 0xFE34
    rows.push_back(WordRange(first: 65279, last: 65279, property: WordBreak::FormatWord));            // 0xFEFF
    rows.push_back(WordRange(first: 65296, last: 65305, property: WordBreak::Numeric));               // 0xFF10 .. 0xFF19
    rows.push_back(WordRange(first: 65313, last: 65338, property: WordBreak::ALetter));               // 0xFF21 .. 0xFF3A
    rows.push_back(WordRange(first: 65345, last: 65370, property: WordBreak::ALetter));               // 0xFF41 .. 0xFF5A
    rows.push_back(WordRange(first: 127462, last: 127487, property: WordBreak::RegionalWord));        // 0x1F1E6 .. 0x1F1FF
    return rows;
}

fn find_word_property(rows: &const shared vector{WordRange}, scalar: int) -> WordBreak: {
    var low: int = 0;
    var high = rows.size() - 1;
    while low <= high: {
        let middle = low + ((high - low) >> 1);
        let row: &const = rows.at(middle);
        if scalar < row.first: {
            high = middle - 1;
        } else: {
            if scalar > row.last: {
                low = middle + 1;
            } else: {
                return row.property;
            }
        }
    }
    return WordBreak::Any;
}

fn word_property(props: &const shared Properties, scalar: int) -> WordBreak: {
    return find_word_property(props.words, scalar);
}

fn is_word_letter(property: WordBreak) -> bool: {
    if property == WordBreak::ALetter: {
        return true;
    }
    return property == WordBreak::HebrewLetter;
}

fn is_mid_letter(property: WordBreak) -> bool: {
    if property == WordBreak::MidLetter: {
        return true;
    }
    if property == WordBreak::MidNumLet: {
        return true;
    }
    return property == WordBreak::SingleQuoteWord;
}

fn is_mid_number(property: WordBreak) -> bool: {
    if property == WordBreak::MidNum: {
        return true;
    }
    return property == WordBreak::MidNumLet;
}

fn is_ignorable_word_property(property: WordBreak) -> bool: {
    if property == WordBreak::ExtendWord: {
        return true;
    }
    if property == WordBreak::FormatWord: {
        return true;
    }
    return property == WordBreak::ZeroWidthJoinerWord;
}

// Word boundary test with one code point of lookahead on each side, which is
// what rules WB6, WB7, WB11 and WB12 need in order to keep a mid letter glued
// to the letters around it.
fn word_breaks_between(props: &const shared Properties, before2: int, before: int, after: int, after2: int) -> bool: {
    let left = word_property(props, before);
    let right = word_property(props, after);
    let far_left = word_property(props, before2);
    let far_right = word_property(props, after2);

    // WB3: do not break inside a carriage return line feed pair.
    if left == WordBreak::CarriageReturnWord && right == WordBreak::LineFeedWord: {
        return false;
    }
    // WB3a and WB3b: break before and after newlines.
    if left == WordBreak::NewlineWord || left == WordBreak::CarriageReturnWord || left == WordBreak::LineFeedWord: {
        return true;
    }
    if right == WordBreak::NewlineWord || right == WordBreak::CarriageReturnWord || right == WordBreak::LineFeedWord: {
        return true;
    }
    // WB4: ignore format and extend characters entirely.
    if is_ignorable_word_property(right): {
        return false;
    }
    // WB5: do not break between letters.
    if is_word_letter(left) && is_word_letter(right): {
        return false;
    }
    // WB6 and WB7: a mid letter between two letters does not break.
    if is_word_letter(left) && is_mid_letter(right) && is_word_letter(far_right): {
        return false;
    }
    if is_mid_letter(left) && is_word_letter(right) && is_word_letter(far_left): {
        return false;
    }
    // WB7a, WB7b and WB7c: the Hebrew apostrophe and quotation rules.
    if left == WordBreak::HebrewLetter && right == WordBreak::SingleQuoteWord: {
        return false;
    }
    if left == WordBreak::HebrewLetter && right == WordBreak::DoubleQuoteWord && far_right == WordBreak::HebrewLetter: {
        return false;
    }
    if left == WordBreak::DoubleQuoteWord && right == WordBreak::HebrewLetter && far_left == WordBreak::HebrewLetter: {
        return false;
    }
    // WB8 to WB10: digits and letters cling together.
    if left == WordBreak::Numeric && right == WordBreak::Numeric: {
        return false;
    }
    if is_word_letter(left) && right == WordBreak::Numeric: {
        return false;
    }
    if left == WordBreak::Numeric && is_word_letter(right): {
        return false;
    }
    // WB11 and WB12: a mid number between two digits does not break.
    if left == WordBreak::Numeric && is_mid_number(right) && far_right == WordBreak::Numeric: {
        return false;
    }
    if is_mid_number(left) && right == WordBreak::Numeric && far_left == WordBreak::Numeric: {
        return false;
    }
    // WB13: katakana runs together.
    if left == WordBreak::Katakana && right == WordBreak::Katakana: {
        return false;
    }
    // WB13a and WB13b: the connector punctuation rules.
    if left == WordBreak::ExtendNumLet: {
        if is_word_letter(right) || right == WordBreak::Numeric || right == WordBreak::Katakana: {
            return false;
        }
        if right == WordBreak::ExtendNumLet: {
            return false;
        }
    }
    if right == WordBreak::ExtendNumLet: {
        if is_word_letter(left) || left == WordBreak::Numeric || left == WordBreak::Katakana: {
            return false;
        }
    }
    // WB15 and WB16: a flag is two regional indicators.
    if left == WordBreak::RegionalWord && right == WordBreak::RegionalWord: {
        return false;
    }
    // WB999: otherwise break.
    return true;
}

fn peek_scalar(scalars: &const shared vector{int}, index: int) -> int: {
    if index < 0 || index >= scalars.size(): {
        return 0;
    }
    return scalars.at(index);
}

fn word_steps(props: &const shared Properties, scalars: &const shared vector{int}) -> vector{Step}: {
    var out: vector{Step};
    if scalars.empty(): {
        return out;
    }
    var begin: int = 0;
    var index: int = 1;
    while index < scalars.size(): {
        let before2 = peek_scalar(scalars, index - 2);
        let before = peek_scalar(scalars, index - 1);
        let after = peek_scalar(scalars, index);
        let after2 = peek_scalar(scalars, index + 1);
        if word_breaks_between(props, before2, before, after, after2): {
            out.push_back(Step(begin: begin, end: index, valid: true));
            begin = index;
        }
        index += 1;
    }
    out.push_back(Step(begin: begin, end: scalars.size(), valid: true));
    return out;
}

// Only the runs that contain at least one letter or digit, which is what a
// word count or a spell checker wants.
fn word_steps_filtered(props: &const shared Properties, scalars: &const shared vector{int}) -> vector{Step}: {
    var out: vector{Step};
    let candidates = word_steps(props, scalars);
    for step: &const in candidates: {
        var interesting: bool = false;
        for i in range(step.begin, step.end): {
            let scalar = scalars.at(i);
            if props.is_letter(scalar) || props.is_number(scalar): {
                interesting = true;
            }
        }
        if interesting: {
            out.push_back(Step(begin: step.begin, end: step.end, valid: true));
        }
    }
    return out;
}

fn count_words(props: &const shared Properties, scalars: &const shared vector{int}) -> int: {
    let steps = word_steps_filtered(props, scalars);
    return steps.size();
}

// --- Normalisation sketch ------------------------------------------------
//
// A working but deliberately small implementation of canonical decomposition
// and recomposition. The table below is a sample of UnicodeData column six:
// enough Latin, Greek and Cyrillic to normalise European text, plus a few
// compatibility entries so the NFKD path has something to do.
fn decomposition_table() -> vector{DecompositionRow}: {
    var rows: vector{DecompositionRow};


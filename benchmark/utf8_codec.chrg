    rows.push_back(WidthRange(first: 174, last: 174, width: WidthClass::Ambiguous));          // 0x00AE
    rows.push_back(WidthRange(first: 176, last: 180, width: WidthClass::Ambiguous));          // 0x00B0 .. 0x00B4
    rows.push_back(WidthRange(first: 182, last: 186, width: WidthClass::Ambiguous));          // 0x00B6 .. 0x00BA
    rows.push_back(WidthRange(first: 188, last: 191, width: WidthClass::Ambiguous));          // 0x00BC .. 0x00BF
    rows.push_back(WidthRange(first: 198, last: 198, width: WidthClass::Ambiguous));          // 0x00C6
    rows.push_back(WidthRange(first: 208, last: 208, width: WidthClass::Ambiguous));          // 0x00D0

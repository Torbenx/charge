    rows.push_back(WidthRange(first: 57344, last: 63743, width: WidthClass::Ambiguous));      // private use

    // Wide: the East Asian blocks proper.
    rows.push_back(WidthRange(first: 4352, last: 4447, width: WidthClass::Wide));             // 0x1100 .. 0x115F jamo
    rows.push_back(WidthRange(first: 8986, last: 8987, width: WidthClass::Wide));             // 0x231A .. 0x231B watch
    rows.push_back(WidthRange(first: 9193, last: 9196, width: WidthClass::Wide));             // 0x23E9 .. 0x23EC

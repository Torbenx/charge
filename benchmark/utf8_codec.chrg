    rows.push_back(WidthRange(first: 9800, last: 9811, width: WidthClass::Wide));             // 0x2648 .. 0x2653 zodiac
    rows.push_back(WidthRange(first: 11904, last: 12019, width: WidthClass::Wide));           // 0x2E80 .. 0x2EF3 radicals
    rows.push_back(WidthRange(first: 12032, last: 12245, width: WidthClass::Wide));           // 0x2F00 .. 0x2FD5 kangxi

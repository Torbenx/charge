    return rows;
}

fn find_decomposition(rows: &const shared vector{DecompositionRow}, scalar: int) -> int: {
    var index: int = 0;
    for row: &const in rows: {
        if row.source == scalar: {
            return index;
        }
        index += 1;
    }
    return -1;
}

// The reverse lookup used by recomposition: given a starter and a following
// mark, is there a single code point that spells the pair?
fn find_composition(rows: &const shared vector{DecompositionRow}, starter: int, mark: int) -> int: {
    for row: &const in rows: {
        if row.compatibility: {
            // Compatibility decompositions never recompose.
            discard row;
        } else: {
            if row.first == starter && row.second == mark: {
                return row.source;
            }
        }
    }
    return -1;
}

// Hangul syllables decompose arithmetically rather than by table.
fn hangul_decompose(scalar: int, sink: &unique vector{int}) -> bool: {
    if is_hangul_syllable(scalar) == false: {
        return false;
    }
    let index = scalar - HANGUL_SYLLABLE_FIRST;
    let lead = HANGUL_L_FIRST + index / HANGUL_NV_COUNT;
    let vowel = HANGUL_V_FIRST + (index % HANGUL_NV_COUNT) / HANGUL_T_COUNT;
    let trail = HANGUL_T_FIRST + index % HANGUL_T_COUNT;
    sink.push_back(lead);
    sink.push_back(vowel);
    if (index % HANGUL_T_COUNT) != 0: {
        sink.push_back(trail);
    }
    return true;
}

fn hangul_compose(first: int, second: int) -> int: {
    // L plus V forms an LV syllable.
    if first >= HANGUL_L_FIRST && first < HANGUL_L_FIRST + HANGUL_L_COUNT: {
        if second >= HANGUL_V_FIRST && second < HANGUL_V_FIRST + HANGUL_V_COUNT: {
            let lead = first - HANGUL_L_FIRST;
            let vowel = second - HANGUL_V_FIRST;
            return HANGUL_SYLLABLE_FIRST + (lead * HANGUL_V_COUNT + vowel) * HANGUL_T_COUNT;
        }
    }
    // LV plus T forms an LVT syllable.
    if is_hangul_syllable(first): {
        if ((first - HANGUL_SYLLABLE_FIRST) % HANGUL_T_COUNT) == 0: {
            if second > HANGUL_T_FIRST && second < HANGUL_T_FIRST + HANGUL_T_COUNT: {
                return first + (second - HANGUL_T_FIRST);
            }
        }
    }
    return -1;
}

// Recursively expand one scalar. The recursion is bounded because every
// decomposition strictly reduces the code point of the starter.
fn decompose_scalar(props: &const shared Properties, scalar: int, compatibility: bool, sink: &unique vector{int}, depth: int): {
    if depth > 8: {
        sink.push_back(scalar);
        return;
    }
    if hangul_decompose(scalar, sink): {
        return;
    }
    let index = find_decomposition(props.decompositions, scalar);
    if index < 0: {
        sink.push_back(scalar);
        return;
    }
    let row: &const = props.decompositions.at(index);
    if row.compatibility && compatibility == false: {
        sink.push_back(scalar);
        return;
    }
    if row.first == scalar: {
        // A self referential row would loop forever; treat it as a leaf.
        sink.push_back(scalar);
        return;
    }
    decompose_scalar(props, row.first, compatibility, sink, depth + 1);
    if row.second != 0: {
        decompose_scalar(props, row.second, compatibility, sink, depth + 1);
    }
}

// Canonical ordering: a stable insertion sort over each run of non starters,
// keyed on the combining class.
fn canonical_order(props: &const shared Properties, scalars: &unique vector{int}): {
    var index: int = 1;
    while index < scalars.size(): {
        let current = scalars.at(index);
        let current_class = props.combining_of(current);
        if current_class == 0: {
            index += 1;
        } else: {
            var probe = index;
            var moved: bool = false;
            while probe > 0: {
                let previous = scalars.at(probe - 1);
                let previous_class = props.combining_of(previous);
                if previous_class == 0: {
                    probe = 0;
                } else: {
                    if previous_class > current_class: {
                        swap(scalars.at(probe - 1), scalars.at(probe));
                        probe -= 1;
                        moved = true;
                    } else: {
                        probe = 0;
                    }
                }
            }
            if moved: {
                assert index > 0;
            }
            index += 1;
        }
    }
}

fn decompose(props: &const shared Properties, scalars: &const shared vector{int}, compatibility: bool) -> vector{int}: {
    var out: vector{int};
    out.reserve(scalars.size() * 2);
    for scalar: &const in scalars: {
        decompose_scalar(props, scalar, compatibility, out, 0);
    }
    canonical_order(props, out);
    return out;
}

// Recomposition, the second half of NFC. Walk the decomposed run keeping the
// index of the last starter; whenever a mark can be composed onto it, replace
// the starter and drop the mark.
fn compose(props: &const shared Properties, scalars: &const shared vector{int}) -> vector{int}: {
    var out: vector{int};
    if scalars.empty(): {
        return out;
    }

    var starter_index: int = -1;
    var last_class: int = -1;

    for scalar: &const in scalars: {
        let current_class = props.combining_of(scalar);

        if starter_index >= 0: {
            let blocked = last_class >= current_class && last_class > 0;
            if blocked == false: {
                let starter = out.at(starter_index);
                var composed = hangul_compose(starter, scalar);
                if composed < 0: {
                    composed = find_composition(props.decompositions, starter, scalar);
                }
                if composed >= 0: {
                    out.at(starter_index) = composed;
                    // The mark is absorbed, so the class of the previous
                    // character is unchanged.
                    continue;
                }
            }
        }

        if current_class == 0: {
            starter_index = out.size();
            last_class = 0;
        } else: {
            last_class = current_class;
        }
        out.push_back(scalar);
    }
    return out;
}

fn normalize(props: &const shared Properties, scalars: &const shared vector{int}, form: NormalForm) -> vector{int}: {
    if form == NormalForm::None: {
        return utf32_encode(scalars);
    }
    if form == NormalForm::Nfd: {
        return decompose(props, scalars, false);
    }
    if form == NormalForm::Nfkd: {
        return decompose(props, scalars, true);
    }
    if form == NormalForm::Nfc: {
        let expanded = decompose(props, scalars, false);
        return compose(props, expanded);
    }
    let expanded = decompose(props, scalars, true);
    return compose(props, expanded);
}

// A quick check that answers yes, no or maybe without doing the work. Only the
// definite answers are useful; maybe means the caller has to normalise.
fn is_normalized_quick(props: &const shared Properties, scalars: &const shared vector{int}, form: NormalForm) -> int: {
    var last_class: int = 0;
    for scalar: &const in scalars: {
        let current_class = props.combining_of(scalar);
        if last_class > current_class && current_class != 0: {
            return 0;                          // definitely not normalised
        }
        if find_decomposition(props.decompositions, scalar) >= 0: {
            if form == NormalForm::Nfd || form == NormalForm::Nfkd: {
                return 0;
            }
            return 2;                          // maybe
        }
        last_class = current_class;
    }
    return 1;                                  // definitely normalised
}

// Compare two runs under canonical equivalence.
fn canonically_equal(props: &const shared Properties, left: &const shared vector{int}, right: &const shared vector{int}) -> bool: {
    let a = decompose(props, left, false);
    let b = decompose(props, right, false);
    if a.size() != b.size(): {
        return false;
    }
    for i in range(0, a.size()): {
        if a.at(i) != b.at(i): {
            return false;
        }
    }
    return true;
}

// --- Display width -------------------------------------------------------
//
// Terminal column counting. Combining marks take no columns, East Asian wide
// and fullwidth characters take two, and the ambiguous class takes one or two
// depending on a locale flag the caller supplies.

static WIDTH_ZERO: int = 0;
static WIDTH_NARROW: int = 1;
static WIDTH_WIDE: int = 2;
static WIDTH_CONTROL_ESCAPE: int = 4;          // <U+0007> style rendering

fn width_table() -> vector{WidthRange}: {
    var rows: vector{WidthRange};

    // Zero width: the marks and the invisible formatting characters.
    rows.push_back(WidthRange(first: 768, last: 879, width: WidthClass::ZeroWidth));          // 0x0300 .. 0x036F
    rows.push_back(WidthRange(first: 1155, last: 1161, width: WidthClass::ZeroWidth));        // 0x0483 .. 0x0489
    rows.push_back(WidthRange(first: 1425, last: 1469, width: WidthClass::ZeroWidth));        // 0x0591 .. 0x05BD
    rows.push_back(WidthRange(first: 1611, last: 1631, width: WidthClass::ZeroWidth));        // 0x064B .. 0x065F
    rows.push_back(WidthRange(first: 2304, last: 2306, width: WidthClass::ZeroWidth));        // 0x0900 .. 0x0902
    rows.push_back(WidthRange(first: 2364, last: 2364, width: WidthClass::ZeroWidth));        // 0x093C
    rows.push_back(WidthRange(first: 2369, last: 2376, width: WidthClass::ZeroWidth));        // 0x0941 .. 0x0948
    rows.push_back(WidthRange(first: 2381, last: 2381, width: WidthClass::ZeroWidth));        // 0x094D
    rows.push_back(WidthRange(first: 3633, last: 3633, width: WidthClass::ZeroWidth));        // 0x0E31
    rows.push_back(WidthRange(first: 3636, last: 3642, width: WidthClass::ZeroWidth));        // 0x0E34 .. 0x0E3A
    rows.push_back(WidthRange(first: 3655, last: 3662, width: WidthClass::ZeroWidth));        // 0x0E47 .. 0x0E4E
    rows.push_back(WidthRange(first: 8203, last: 8207, width: WidthClass::ZeroWidth));        // 0x200B .. 0x200F
    rows.push_back(WidthRange(first: 8234, last: 8238, width: WidthClass::ZeroWidth));        // 0x202A .. 0x202E
    rows.push_back(WidthRange(first: 8288, last: 8303, width: WidthClass::ZeroWidth));        // 0x2060 .. 0x206F
    rows.push_back(WidthRange(first: 8400, last: 8432, width: WidthClass::ZeroWidth));        // 0x20D0 .. 0x20F0
    rows.push_back(WidthRange(first: 65024, last: 65039, width: WidthClass::ZeroWidth));      // 0xFE00 .. 0xFE0F
    rows.push_back(WidthRange(first: 65056, last: 65071, width: WidthClass::ZeroWidth));      // 0xFE20 .. 0xFE2F
    rows.push_back(WidthRange(first: 65279, last: 65279, width: WidthClass::ZeroWidth));      // 0xFEFF
    rows.push_back(WidthRange(first: 917504, last: 921599, width: WidthClass::ZeroWidth));    // 0xE0000 .. 0xE0FFF

    // Ambiguous: one column in a Western font, two in an East Asian one.
    rows.push_back(WidthRange(first: 161, last: 161, width: WidthClass::Ambiguous));          // 0x00A1
    rows.push_back(WidthRange(first: 164, last: 164, width: WidthClass::Ambiguous));          // 0x00A4

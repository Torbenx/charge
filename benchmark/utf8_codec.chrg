    rows.push_back(WidthRange(first: 8220, last: 8221, width: WidthClass::Ambiguous));        // 0x201C .. 0x201D
    rows.push_back(WidthRange(first: 8224, last: 8226, width: WidthClass::Ambiguous));        // 0x2020 .. 0x2022
    rows.push_back(WidthRange(first: 8230, last: 8230, width: WidthClass::Ambiguous));        // 0x2026
    rows.push_back(WidthRange(first: 8240, last: 8240, width: WidthClass::Ambiguous));        // 0x2030
    rows.push_back(WidthRange(first: 8592, last: 8601, width: WidthClass::Ambiguous));        // 0x2190 .. 0x2199
    rows.push_back(WidthRange(first: 9312, last: 9449, width: WidthClass::Ambiguous));        // 0x2460 .. 0x24E9

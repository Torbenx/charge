    rows.push_back(WidthRange(first: 222, last: 225, width: WidthClass::Ambiguous));          // 0x00DE .. 0x00E1
    rows.push_back(WidthRange(first: 230, last: 230, width: WidthClass::Ambiguous));          // 0x00E6
    rows.push_back(WidthRange(first: 232, last: 234, width: WidthClass::Ambiguous));          // 0x00E8 .. 0x00EA
    rows.push_back(WidthRange(first: 236, last: 237, width: WidthClass::Ambiguous));          // 0x00EC .. 0x00ED
    rows.push_back(WidthRange(first: 240, last: 240, width: WidthClass::Ambiguous));          // 0x00F0
    rows.push_back(WidthRange(first: 242, last: 243, width: WidthClass::Ambiguous));          // 0x00F2 .. 0x00F3
    rows.push_back(WidthRange(first: 247, last: 250, width: WidthClass::Ambiguous));          // 0x00F7 .. 0x00FA

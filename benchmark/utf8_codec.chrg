    rows.push_back(WidthRange(first: 12288, last: 12351, width: WidthClass::FullWidth));      // 0x3000 .. 0x303F cjk punctuation
    rows.push_back(WidthRange(first: 12352, last: 12447, width: WidthClass::Wide));           // 0x3040 .. 0x309F hiragana
    rows.push_back(WidthRange(first: 12448, last: 12543, width: WidthClass::Wide));           // 0x30A0 .. 0x30FF katakana
    rows.push_back(WidthRange(first: 12544, last: 12591, width: WidthClass::Wide));           // 0x3100 .. 0x312F bopomofo
    rows.push_back(WidthRange(first: 12592, last: 12687, width: WidthClass::Wide));           // 0x3130 .. 0x318F hangul compat
    rows.push_back(WidthRange(first: 12688, last: 12771, width: WidthClass::Wide));           // 0x3190 .. 0x31A3
    rows.push_back(WidthRange(first: 12800, last: 13054, width: WidthClass::Wide));           // 0x3200 .. 0x32FE enclosed
    rows.push_back(WidthRange(first: 13056, last: 19903, width: WidthClass::Wide));           // 0x3300 .. 0x4DBF
    rows.push_back(WidthRange(first: 19968, last: 40959, width: WidthClass::Wide));           // 0x4E00 .. 0x9FFF unified
    rows.push_back(WidthRange(first: 40960, last: 42127, width: WidthClass::Wide));           // 0xA000 .. 0xA4CF yi
    rows.push_back(WidthRange(first: 44032, last: 55203, width: WidthClass::Wide));           // 0xAC00 .. 0xD7A3 hangul
    rows.push_back(WidthRange(first: 63744, last: 64255, width: WidthClass::Wide));           // 0xF900 .. 0xFAFF compat
    rows.push_back(WidthRange(first: 65040, last: 65049, width: WidthClass::Wide));           // 0xFE10 .. 0xFE19 vertical
    rows.push_back(WidthRange(first: 65072, last: 65131, width: WidthClass::Wide));           // 0xFE30 .. 0xFE6B
    rows.push_back(WidthRange(first: 65281, last: 65376, width: WidthClass::FullWidth));      // 0xFF01 .. 0xFF60
    rows.push_back(WidthRange(first: 65377, last: 65439, width: WidthClass::HalfWidth));      // 0xFF61 .. 0xFF9F halfwidth kana
    rows.push_back(WidthRange(first: 65504, last: 65510, width: WidthClass::FullWidth));      // 0xFFE0 .. 0xFFE6
    rows.push_back(WidthRange(first: 94176, last: 94180, width: WidthClass::Wide));           // 0x16FE0 .. 0x16FE4
    rows.push_back(WidthRange(first: 119552, last: 119638, width: WidthClass::Wide));         // 0x1D300 .. 0x1D356
    rows.push_back(WidthRange(first: 126980, last: 126980, width: WidthClass::Wide));         // 0x1F004 mahjong
    rows.push_back(WidthRange(first: 127183, last: 127183, width: WidthClass::Wide));         // 0x1F0CF
    rows.push_back(WidthRange(first: 127374, last: 127374, width: WidthClass::Wide));         // 0x1F18E
    rows.push_back(WidthRange(first: 127462, last: 127487, width: WidthClass::Wide));         // 0x1F1E6 regional
    rows.push_back(WidthRange(first: 127744, last: 128591, width: WidthClass::Wide));         // 0x1F300 .. 0x1F64F emoji
    rows.push_back(WidthRange(first: 128640, last: 128767, width: WidthClass::Wide));         // 0x1F680 .. 0x1F6FF transport
    rows.push_back(WidthRange(first: 129280, last: 129535, width: WidthClass::Wide));         // 0x1F980 .. 0x1FA7F
    rows.push_back(WidthRange(first: 131072, last: 196605, width: WidthClass::Wide));         // 0x20000 .. 0x2FFFD
    rows.push_back(WidthRange(first: 196608, last: 262141, width: WidthClass::Wide));         // 0x30000 .. 0x3FFFD

    return rows;
}

fn find_width_class(rows: &const shared vector{WidthRange}, scalar: int) -> WidthClass: {
    var low: int = 0;
    var high = rows.size() - 1;
    while low <= high: {
        let middle = low + ((high - low) >> 1);
        let row: &const = rows.at(middle);
        if scalar < row.first: {
            high = middle - 1;
        } else: {
            if scalar > row.last: {
                low = middle + 1;
            } else: {
                return row.width;
            }
        }
    }
    return WidthClass::Neutral;
}

// The caller decides how the ambiguous class renders; a terminal running in a
// CJK locale wants two columns, everything else wants one.
struct WidthOptions: {
    ambiguous_is_wide: bool = false;
    control_is_escape: bool = true;
    tab_stop: int = 8;
    count_emoji_sequence_once: bool = true;
}

fn scalar_width(props: &const shared Properties, scalar: int, options: &const shared WidthOptions) -> int: {
    if scalar == 0: {
        return 0;
    }
    if scalar == 9: {
        return options.tab_stop;
    }
    if props.is_control(scalar): {
        if options.control_is_escape: {
            return WIDTH_CONTROL_ESCAPE;
        }
        return 0;
    }
    if scalar <= MAX_ASCII: {
        return WIDTH_NARROW;
    }
    let width = find_width_class(props.widths, scalar);
    if width == WidthClass::ZeroWidth: {
        return WIDTH_ZERO;
    }
    if width == WidthClass::Wide || width == WidthClass::FullWidth: {
        return WIDTH_WIDE;
    }
    if width == WidthClass::Ambiguous: {
        if options.ambiguous_is_wide: {
            return WIDTH_WIDE;
        }
        return WIDTH_NARROW;
    }
    if props.is_mark(scalar): {
        return WIDTH_ZERO;
    }
    if props.is_format(scalar): {
        return WIDTH_ZERO;
    }
    return WIDTH_NARROW;
}

// A whole cluster occupies the width of its widest member, not the sum: a base
// letter plus three accents is still one column.
fn cluster_width(props: &const shared Properties, scalars: &const shared vector{int}, step: &const shared Step, options: &const shared WidthOptions) -> int: {
    var widest: int = 0;
    for i in range(step.begin, step.end): {
        let width = scalar_width(props, scalars.at(i), options);
        if width > widest: {
            widest = width;
        }
    }
    return widest;
}

fn text_width(props: &const shared Properties, scalars: &const shared vector{int}, options: &const shared WidthOptions) -> int: {
    var total: int = 0;
    let clusters = grapheme_steps(props, scalars);
    for step: &const in clusters: {
        total += cluster_width(props, scalars, step, options);
    }
    return total;
}

// Truncate to a column budget, cutting only at cluster boundaries so that no
// accent is ever separated from its base.
fn truncate_to_width(props: &const shared Properties, scalars: &const shared vector{int}, budget: int, options: &const shared WidthOptions) -> vector{int}: {
    var out: vector{int};
    var used: int = 0;
    let clusters = grapheme_steps(props, scalars);
    for step: &const in clusters: {
        let width = cluster_width(props, scalars, step, options);
        if used + width > budget: {
            return out;
        }
        for i in range(step.begin, step.end): {
            out.push_back(scalars.at(i));
        }
        used += width;
    }
    return out;
}

// Pad on the right to a fixed column count, which is what a table formatter
// needs once the strings stop being ASCII.
fn pad_to_width(props: &const shared Properties, scalars: &const shared vector{int}, target: int, options: &const shared WidthOptions) -> vector{int}: {
    var out = utf32_encode(scalars);
    var used = text_width(props, scalars, options);
    while used < target: {
        out.push_back(32);                     // space
        used += 1;
    }
    return out;
}

fn width_class_name(width: WidthClass) -> string: {
    if width == WidthClass::Narrow: { return "Na"; }
    if width == WidthClass::Wide: { return "W"; }
    if width == WidthClass::FullWidth: { return "F"; }
    if width == WidthClass::HalfWidth: { return "H"; }
    if width == WidthClass::Ambiguous: { return "A"; }
    if width == WidthClass::ZeroWidth: { return "Z"; }
    return "N";
}

// --- Iteration helpers ---------------------------------------------------
//
// Three cursors over the same byte buffer, at three levels of granularity.
// Each one is a plain struct with a next() that returns false at the end,
// because that is the shape the rest of the codebase expects of an iterator.

// A cursor over the code points of a UTF-8 byte buffer.
struct CodePointIterator: {

    fn reset(self: &unique): {
        .offset = 0;
        .current = 0;
        .current_length = 0;
        .error = DecodeError::None;
        .position = Position();
    }

    fn done(self: &const shared) -> bool: {
        return .offset >= .bytes.size();
    }

    fn next(self: &unique) -> bool: {
        if .offset >= .bytes.size(): {
            .current = 0;
            .current_length = 0;
            return false;
        }
        let step = decode_at(.bytes, .offset);
        .error = step.error;
        if step.error == DecodeError::None: {
            .current = step.value;
            .current_length = step.length;
        } else: {
            .current = REPLACEMENT;
            .current_length = 1;
            if step.length > 0: {
                .current_length = step.length;
            }
        }
        .position.advance_scalar(.current, .current_length);
        .offset += .current_length;
        return true;
    }

    // Look at the next scalar without consuming it.
    fn peek(self: &const shared) -> int: {
        if .offset >= .bytes.size(): {
            return -1;
        }
        let step = decode_at(.bytes, .offset);
        if step.error != DecodeError::None: {
            return REPLACEMENT;
        }
        return step.value;
    }

    // Step back over the previous scalar. Uses the continuation byte test
    // rather than remembering the last length, so it works after a seek.
    fn previous(self: &unique) -> bool: {
        if .offset <= 0: {
            return false;
        }
        var index = .offset - 1;
        var steps: int = 0;
        while index > 0 && steps < UTF8_MAX_LENGTH: {
            if (.bytes.at(index) & CONT_MASK) != CONT_MARK: {
                .offset = index;
                let step = decode_at(.bytes, index);
                .current = step.value;
                .current_length = step.length;
                return true;
            }
            index -= 1;
            steps += 1;
        }
        .offset = 0;
        return true;
    }

    fn seek(self: &unique, byte_offset: int): {
        .offset = sequence_start(.bytes, byte_offset);
    }

    fn collect(self: &unique) -> vector{int}: {
        var out: vector{int};
        while .next(): {
            out.push_back(.current);
        }
        return out;
    }

    bytes: vector{int};
    offset: int = 0;
    current: int = 0;
    current_length: int = 0;
    error: DecodeError = DecodeError::None;
    position: Position;
}

// A cursor over grapheme clusters, built on top of a decoded scalar run
// because the break rules need lookahead that a byte cursor cannot give.
struct GraphemeIterator: {

    fn reset(self: &unique): {
        .offset = 0;
        .begin = 0;
        .end = 0;
        .state.reset();
    }

    fn done(self: &const shared) -> bool: {
        return .offset >= .scalars.size();
    }

    fn next(self: &unique, props: &const shared Properties) -> bool: {
        if .offset >= .scalars.size(): {
            .begin = .offset;
            .end = .offset;
            return false;
        }
        .begin = .offset;
        var index = .offset + 1;
        while index < .scalars.size(): {
            if breaks_between(props, .state, .scalars.at(index - 1), .scalars.at(index)): {
                .end = index;
                .offset = index;
                return true;
            }
            index += 1;
        }
        .end = .scalars.size();
        .offset = .end;
        return true;
    }

    fn current(self: &const shared) -> vector{int}: {
        var out: vector{int};
        for i in range(.begin, .end): {
            out.push_back(.scalars.at(i));
        }
        return out;
    }

    fn current_length(self: &const shared) -> int: {
        return .end - .begin;
    }

    // The base character of the current cluster, that is the first scalar that
    // is not a mark.
    fn base(self: &const shared, props: &const shared Properties) -> int: {
        for i in range(.begin, .end): {
            let scalar = .scalars.at(i);
            if props.is_mark(scalar) == false: {
                return scalar;
            }
        }
        if .end > .begin: {
            return .scalars.at(.begin);
        }
        return 0;
    }

    scalars: vector{int};
    offset: int = 0;
    begin: int = 0;
    end: int = 0;
    state: BreakState;
}

// A cursor over words, which skips the runs that hold no letters or digits.
struct WordIterator: {

    fn reset(self: &unique): {
        .offset = 0;
        .begin = 0;
        .end = 0;
    }

    fn next(self: &unique, props: &const shared Properties) -> bool: {
        while .offset < .scalars.size(): {
            .begin = .offset;
            var index = .offset + 1;
            var found: bool = false;
            while index < .scalars.size(): {
                let before2 = peek_scalar(.scalars, index - 2);
                let before = peek_scalar(.scalars, index - 1);
                let after = peek_scalar(.scalars, index);
                let after2 = peek_scalar(.scalars, index + 1);
                if word_breaks_between(props, before2, before, after, after2): {
                    .end = index;
                    found = true;
                    index = .scalars.size();
                } else: {
                    index += 1;
                }
            }
            if found == false: {
                .end = .scalars.size();
            }
            .offset = .end;

            var interesting: bool = false;
            for i in range(.begin, .end): {
                let scalar = .scalars.at(i);
                if props.is_letter(scalar) || props.is_number(scalar): {
                    interesting = true;
                }
            }
            if interesting: {
                return true;
            }
        }
        return false;
    }

    fn current(self: &const shared) -> vector{int}: {
        var out: vector{int};
        for i in range(.begin, .end): {
            out.push_back(.scalars.at(i));
        }
        return out;
    }

    scalars: vector{int};
    offset: int = 0;
    begin: int = 0;
    end: int = 0;
}

// --- Text buffer ---------------------------------------------------------
//
// The convenience layer: a byte buffer that knows its own encoding and can
// hand out any of the three iterators.
struct Text: {

    fn load(self: &unique, bytes: vector{int}): {
        .bytes = move(bytes);
        .encoding = strip_bom(.bytes);
        .valid = is_valid_utf8(.bytes);
    }

    fn byte_length(self: &const shared) -> int: {
        return .bytes.size();
    }

    fn scalar_length(self: &const shared) -> int: {
        return count_scalars(.bytes);
    }

    fn scalars(self: &const shared) -> vector{int}: {
        return decode_all_lossy(.bytes);
    }

    fn cluster_length(self: &const shared, props: &const shared Properties) -> int: {
        let run = .scalars();
        return count_graphemes(props, run);
    }

    fn width(self: &const shared, props: &const shared Properties) -> int: {
        let run = .scalars();
        var options: WidthOptions;
        return text_width(props, run, options);
    }

    fn code_points(self: &const shared) -> CodePointIterator: {
        var iterator: CodePointIterator;
        iterator.bytes = utf32_encode(.bytes);
        iterator.reset();
        return iterator;
    }

    fn clusters(self: &const shared) -> GraphemeIterator: {
        var iterator: GraphemeIterator;
        iterator.scalars = .scalars();
        iterator.reset();
        return iterator;
    }

    fn words(self: &const shared) -> WordIterator: {
        var iterator: WordIterator;
        iterator.scalars = .scalars();
        iterator.reset();
        return iterator;
    }

    fn append_scalar(self: &unique, scalar: int): {
        discard encode_into(.bytes, scalar);
    }

    fn append_text(self: &unique, other: &const shared Text): {
        for b: &const in other.bytes: {
            .bytes.push_back(b);
        }
    }

    fn clear(self: &unique): {
        .bytes.clear();
        .encoding = Encoding::Utf8;
        .valid = true;
    }

    bytes: vector{int};
    encoding: Encoding = Encoding::Utf8;
    valid: bool = true;
}

// --- Escaping ------------------------------------------------------------

// Render a scalar the way a source file would spell it, so that a diagnostic
// can quote unprintable text safely.
fn escape_scalar(props: &const shared Properties, scalar: int) -> string: {
    if scalar == 10: {
        return "\\n";
    }
    if scalar == 13: {
        return "\\r";
    }
    if scalar == 9: {
        return "\\t";
    }
    if scalar == 0: {
        return "\\0";
    }
    if scalar == 92: {
        return "\\\\";
    }
    if scalar == 34: {
        return "\\\"";
    }
    if props.is_printable(scalar): {
        var out: string = "";
        out.push_back(char(scalar));
        return out;
    }
    var out: string = "\\u{";
    out.append(format_code_point(scalar));
    out.append("}");
    return out;
}

fn escape_text(props: &const shared Properties, scalars: &const shared vector{int}) -> string: {
    var out: string = "";
    for scalar: &const in scalars: {
        out.append(escape_scalar(props, scalar));
    }
    return out;
}

// Describe one scalar for a diagnostic: the code point, its category and its
// width class. This is the function a debugger calls on a selection.
fn describe_scalar(props: &const shared Properties, scalar: int) -> string: {
    var out = format_code_point(scalar);
    out.append(" category ");
    out.append(category_name(props.category_of(scalar)));
    out.append(" width ");
    out.append(width_class_name(find_width_class(props.widths, scalar)));
    out.append(" combining ");
    out.append(to_string(props.combining_of(scalar)));
    let length = encoded_length(scalar);
    out.append(" utf8 bytes ");
    out.append(to_string(length));
    if is_noncharacter(scalar): {
        out.append(" (noncharacter)");
    }
    if is_surrogate(scalar): {
        out.append(" (surrogate)");
    }
    return out;
}

fn error_text(code: DecodeError) -> string: {
    if code == DecodeError::None: {
        return "no error";
    }
    if code == DecodeError::TruncatedSequence: {
        return "input ended in the middle of a UTF-8 sequence";
    }
    if code == DecodeError::UnexpectedContinuation: {
        return "continuation byte where a lead byte was expected";
    }
    if code == DecodeError::InvalidLeadByte: {
        return "byte cannot begin a UTF-8 sequence";
    }
    if code == DecodeError::MissingContinuation: {
        return "lead byte was not followed by a continuation byte";
    }
    if code == DecodeError::OverlongEncoding: {
        return "code point encoded with more bytes than necessary";
    }
    if code == DecodeError::SurrogateCodePoint: {
        return "surrogate code point encoded directly";
    }
    if code == DecodeError::CodePointTooLarge: {
        return "code point above the Unicode maximum";
    }
    if code == DecodeError::UnpairedHighSurrogate: {
        return "high surrogate without a following low surrogate";
    }
    if code == DecodeError::UnpairedLowSurrogate: {
        return "low surrogate without a preceding high surrogate";
    }
    if code == DecodeError::BufferTooSmall: {
        return "output buffer is too small";
    }
    return "input was empty";
}

// --- Round trip checks ---------------------------------------------------
//
// The properties the test suite proves. They are written as functions rather
// than as tests so that the prover can see the same statements the tests do.

fn check_round_trip(scalar: int) -> bool: {
    if is_valid_scalar(scalar) == false: {
        return true;
    }
    let packet = encode(scalar);
    if packet.length != encoded_length(scalar): {
        return false;
    }
    var buffer: vector{int};
    for i in range(0, packet.length): {
        buffer.push_back(packet.at(i));
    }
    let back = decode_at(buffer, 0);
    prove back.length == packet.length;
    return back.value == scalar && back.error == DecodeError::None;
}

fn check_utf16_round_trip(scalar: int) -> bool: {
    if is_valid_scalar(scalar) == false: {
        return true;
    }
    var units: vector{int};
    let count = utf16_encode_into(units, scalar);
    if count != utf16_length(scalar): {
        return false;
    }
    let back = utf16_decode_at(units, 0);
    return back.value == scalar && back.error == DecodeError::None;
}

// Overlong forms must be rejected. The classic attack spells a slash as two
// bytes, 0xC0 0xAF, and hopes the path check runs before the decoder does.
fn check_overlong_rejected() -> bool: {
    var buffer: vector{int};
    buffer.push_back(192);                     // 0xC0
    buffer.push_back(175);                     // 0xAF
    let step = decode_at(buffer, 0);
    if step.error == DecodeError::None: {
        return false;
    }
    return step.error == DecodeError::InvalidLeadByte || step.error == DecodeError::OverlongEncoding;
}

fn check_surrogate_rejected() -> bool: {
    var buffer: vector{int};
    buffer.push_back(237);                     // 0xED
    buffer.push_back(160);                     // 0xA0
    buffer.push_back(128);                     // 0x80
    let step = decode_at(buffer, 0);
    return step.error == DecodeError::SurrogateCodePoint;
}

fn check_truncation_reported() -> bool: {
    var buffer: vector{int};
    buffer.push_back(240);                     // 0xF0
    buffer.push_back(159);                     // 0x9F
    buffer.push_back(152);                     // 0x98
    let step = decode_at(buffer, 0);
    return step.error == DecodeError::TruncatedSequence;
}

fn check_too_large_rejected() -> bool: {
    var buffer: vector{int};
    buffer.push_back(244);                     // 0xF4
    buffer.push_back(144);                     // 0x90
    buffer.push_back(128);                     // 0x80
    buffer.push_back(128);                     // 0x80
    let step = decode_at(buffer, 0);
    if step.error == DecodeError::None: {
        return false;
    }
    return step.error == DecodeError::CodePointTooLarge || step.error == DecodeError::MissingContinuation;
}

// Walk a sample of the code space and confirm the two decoders agree.
fn check_decoders_agree(first: int, last: int) -> bool: {
    var scalar = first;
    while scalar <= last: {
        if is_valid_scalar(scalar): {
            let packet = encode(scalar);
            var buffer: vector{int};
            for i in range(0, packet.length): {
                buffer.push_back(packet.at(i));
            }
            let reference = decode_all_lossy(buffer);
            let streamed = decode_streaming(buffer);
            if reference.size() != streamed.size(): {
                return false;
            }
            for i in range(0, reference.size()): {
                if reference.at(i) != streamed.at(i): {
                    return false;
                }
            }
        }
        scalar += 1;
    }
    return true;
}

fn self_test() -> int: {
    var failures: int = 0;
    var props: Properties;
    props.build();

    if check_overlong_rejected() == false: {
        failures += 1;
        println("overlong sequence was accepted");
    }
    if check_surrogate_rejected() == false: {
        failures += 1;
        println("surrogate sequence was accepted");
    }
    if check_truncation_reported() == false: {
        failures += 1;
        println("truncated sequence was not reported");
    }
    if check_too_large_rejected() == false: {
        failures += 1;
        println("out of range code point was accepted");
    }
    if check_decoders_agree(0, 2047) == false: {
        failures += 1;
        println("streaming decoder disagrees with the reference decoder");
    }

    for scalar in range(0, 1024): {
        if check_round_trip(scalar) == false: {
            failures += 1;
        }
        if check_utf16_round_trip(scalar) == false: {
            failures += 1;
        }
    }

    // A short smoke test over the property tables.
    if props.is_letter(int('a')) == false: {
        failures += 1;
    }
    if props.is_digit(int('7')) == false: {
        failures += 1;
    }
    if props.is_whitespace(int(' ')) == false: {
        failures += 1;
    }
    if props.is_punctuation(int('.')) == false: {
        failures += 1;
    }
    if props.is_control(int('\n')) == false: {
        failures += 1;
    }
    if props.is_combining(769) == false: {     // 0x0301 combining acute
        failures += 1;
    }
    if to_upper_scalar(props, int('a')) != int('A'): {
        failures += 1;
    }
    if to_lower_scalar(props, int('Z')) != int('z'): {
        failures += 1;
    }

    // e with an acute accent must compose and decompose cleanly.
    var composed: vector{int};
    composed.push_back(233);                   // 0x00E9
    let expanded = decompose(props, composed, false);
    if expanded.size() != 2: {
        failures += 1;
    }
    let recomposed = compose(props, expanded);
    if recomposed.size() != 1: {
        failures += 1;
    }

    println("unicode self test finished with ");
    println(to_string(failures));
    return failures;
}

}

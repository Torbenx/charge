// Arbitrary-precision signed integers.
//
// A BigInt is a sign flag plus a little-endian vector of limbs. Limb zero is
// the least significant. Every limb holds LIMB_BITS bits, so a limb value is
// always in the half-open range [0, LIMB_BASE). Products of two limbs plus a
// carry stay inside the machine word, which is what lets the inner loops be
// written as single long expressions instead of a ladder of temporaries.
namespace bignum: {

// --- Representation constants --------------------------------------------

// Bits per limb. Chosen so that LIMB_BASE * LIMB_BASE plus two carries still
// fits comfortably in a 64 bit accumulator.
static LIMB_BITS: int = 30;

// 2^30. Written in decimal because the lexer only accepts decimal literals.
static LIMB_BASE: int = 1073741824;

// 2^30 - 1, the mask that reduces an accumulator down to one limb.
static LIMB_MASK: int = 1073741823;

// Half of LIMB_BASE, used by the rounding helpers.
static LIMB_HALF: int = 536870912;

// Decimal conversion works nine digits at a time: 10^9 < 2^30 is false, so we
// use eight digits per chunk to keep the chunk strictly below LIMB_BASE.
static DECIMAL_DIGITS_PER_CHUNK: int = 8;

// 10^8, the base of one decimal chunk.
static DECIMAL_CHUNK_BASE: int = 100000000;

// Below this limb count schoolbook multiplication beats Karatsuba because the
// recursion bookkeeping dominates the limb products.
static KARATSUBA_THRESHOLD: int = 24;

// Guard so that a runaway division loop reports instead of spinning forever.
static DIVISION_ITERATION_LIMIT: int = 100000;

// ASCII code points, spelled in decimal.
static CHAR_ZERO: int = 48;      // '0'
static CHAR_NINE: int = 57;      // '9'
static CHAR_MINUS: int = 45;     // '-'
static CHAR_PLUS: int = 43;      // '+'
static CHAR_UNDERSCORE: int = 95; // '_'

// Instrumentation: how many limb multiplications the library has performed.
static var limb_product_count: int = 0;

// --- Small enums ----------------------------------------------------------

// Three-way comparison result, returned by compare and compare_magnitude.
enum Ordering: {
    Less;
    Equal;
    Greater = 2;
}

// Sign of a normalised BigInt. Zero is always stored with negative == false.
enum Sign: {
    Negative;
    Zero;
    Positive = 2;
}

// How parse_decimal failed, if it did.
enum ParseStatus: {
    Ok;
    EmptyInput;
    BadDigit;
    Overflow = 3;
}

// --- The number itself ----------------------------------------------------

struct BigInt: {

    // --- Basic queries ----------------------------------------------------

    // A normalised BigInt has no leading zero limbs, so an empty limb vector
    // is the unique representation of zero.
    fn is_zero(self: &const shared) -> bool: {
        return .limbs.size() == 0;
    }

    fn limb_count(self: &const shared) -> int: {
        return .limbs.size();
    }

    // Reading past the top of the number yields zero, which removes almost
    // every length check from the arithmetic loops below.
    fn limb_at(self: &const shared, index: int) -> int: {
        if index < 0 || index >= .limbs.size(): {
            return 0;
        }
        return .limbs[index];
    }

    fn sign(self: &const shared) -> Sign: {
        if .limbs.size() == 0: {
            return Sign::Zero;
        }
        if .negative: {
            return Sign::Negative;
        }
        return Sign::Positive;
    }

    fn is_negative(self: &const shared) -> bool: {
        return .negative && .limbs.size() > 0;
    }

    fn is_positive(self: &const shared) -> bool: {
        return !.negative && .limbs.size() > 0;
    }

    fn is_even(self: &const shared) -> bool: {
        return .limbs.size() == 0 || (.limbs[0] & 1) == 0;
    }

    fn is_odd(self: &const shared) -> bool: {
        return .limbs.size() > 0 && (.limbs[0] & 1) == 1;
    }

    // True when the value fits in a single limb, sign ignored.
    fn fits_in_limb(self: &const shared) -> bool: {
        return .limbs.size() <= 1;
    }

    // --- Mutation helpers -------------------------------------------------

    // Grow the limb vector with zeros until it can address `index`.
    fn ensure_limb(self: &unique, index: int): {
        while .limbs.size() <= index: {
            .limbs.push_back(0);
        }
    }

    fn set_limb(self: &unique, index: int, value: int): {
        .ensure_limb(index);
        .limbs[index] = value & LIMB_MASK;
    }

    // Drop leading zero limbs and collapse the sign of zero. Every public
    // operation ends with a call to this so the representation stays unique.
    fn normalise(self: &unique): {
        while .limbs.size() > 0 && .limbs[.limbs.size() - 1] == 0: {
            .limbs.pop_back();
        }
        if .limbs.size() == 0: {
            .negative = false;
        }
    }

    fn set_zero(self: &unique): {
        .limbs.clear();
        .negative = false;
    }

    // Load a machine integer, splitting it across as many limbs as needed.
    fn assign_small(self: &unique, value: int): {
        .limbs.clear();
        .negative = value < 0;
        var magnitude = abs(value);
        while magnitude > 0: {
            .limbs.push_back(magnitude & LIMB_MASK);
            magnitude = magnitude >> LIMB_BITS;
        }
        .normalise();
    }

    fn clone(self: &const shared) -> BigInt: {
        var out = BigInt();
        out.negative = .negative;
        for limb: &const in .limbs: {
            out.limbs.push_back(limb);
        }
        return out;
    }

    // In-place sign flip. Zero is left alone so the invariant holds.
    fn negate(self: &unique): {
        if .limbs.size() > 0: {
            .negative = !.negative;
        }
    }

    fn absolute(self: &const shared) -> BigInt: {
        var out = .clone();
        out.negative = false;
        return out;
    }

    // --- Bit level access -------------------------------------------------

    // Number of significant bits, zero for zero.
    fn bit_length(self: &const shared) -> int: {
        if .limbs.size() == 0: {
            return 0;
        }
        var top = .limbs[.limbs.size() - 1];
        var bits: int = 0;
        while top > 0: {
            bits += 1;
            top = top >> 1;
        }
        return (.limbs.size() - 1) * LIMB_BITS + bits;
    }

    fn get_bit(self: &const shared, position: int) -> int: {
        if position < 0: {
            return 0;
        }
        return (.limb_at(position / LIMB_BITS) >> (position % LIMB_BITS)) & 1;
    }

    fn set_bit(self: &unique, position: int): {
        let index = position / LIMB_BITS;
        .ensure_limb(index);
        .limbs[index] = .limbs[index] | (1 << (position % LIMB_BITS));
    }

    fn clear_bit(self: &unique, position: int): {
        let index = position / LIMB_BITS;
        if index < .limbs.size(): {
            .limbs[index] = .limbs[index] & (LIMB_MASK ^ (1 << (position % LIMB_BITS)));
            .normalise();
        }
    }

    // Count of set bits across the whole magnitude.
    fn population_count(self: &const shared) -> int: {
        var total: int = 0;
        for limb: &const in .limbs: {
            var word = limb;
            while word > 0: {
                total += word & 1;
                word = word >> 1;
            }
        }
        return total;
    }

    // Index of the lowest set bit, or -1 for zero. Used by binary GCD.
    fn lowest_set_bit(self: &const shared) -> int: {
        var index: int = 0;
        while index < .limbs.size(): {
            if .limbs[index] != 0: {
                var word = .limbs[index];
                var offset: int = 0;
                while (word & 1) == 0: {
                    word = word >> 1;
                    offset += 1;
                }
                return index * LIMB_BITS + offset;
            }
            index += 1;
        }
        return -1;
    }

    // --- Comparison -------------------------------------------------------

    // Compare magnitudes only. Longer normalised number wins immediately;
    // otherwise scan from the top limb down.
    fn compare_magnitude(self: &const shared, other: &const shared BigInt) -> Ordering: {
        if .limbs.size() != other.limbs.size(): {
            if .limbs.size() < other.limbs.size(): {
                return Ordering::Less;
            }
            return Ordering::Greater;
        }
        var index = .limbs.size() - 1;
        while index >= 0: {
            if .limbs[index] != other.limbs[index]: {
                if .limbs[index] < other.limbs[index]: {
                    return Ordering::Less;
                }
                return Ordering::Greater;
            }
            index -= 1;
        }
        return Ordering::Equal;
    }

    // Full signed comparison built on top of the magnitude comparison.
    fn compare(self: &const shared, other: &const shared BigInt) -> Ordering: {
        if .is_negative() && !other.is_negative(): {
            return Ordering::Less;
        }
        if !.is_negative() && other.is_negative(): {
            return Ordering::Greater;
        }
        let magnitude = .compare_magnitude(other);
        if !.is_negative(): {
            return magnitude;
        }
        if magnitude == Ordering::Less: {
            return Ordering::Greater;
        }
        if magnitude == Ordering::Greater: {
            return Ordering::Less;
        }
        return Ordering::Equal;
    }

    fn equals(self: &const shared, other: &const shared BigInt) -> bool: {
        return .compare(other) == Ordering::Equal;
    }

    fn less_than(self: &const shared, other: &const shared BigInt) -> bool: {
        return .compare(other) == Ordering::Less;
    }

    // Compare against a machine integer without allocating a temporary when
    // the value obviously does not fit in one limb.
    fn compare_small(self: &const shared, value: int) -> Ordering: {
        var scratch = BigInt();
        scratch.assign_small(value);
        return .compare(scratch);
    }

    limbs: vector{int};
    negative: bool = false;
}

// --- Construction helpers -------------------------------------------------

// The canonical zero.
fn make_zero() -> BigInt: {
    var out = BigInt();
    out.negative = false;
    return out;
}

fn make_one() -> BigInt: {
    var out = BigInt();
    out.limbs.push_back(1);
    return out;
}

fn make_from_int(value: int) -> BigInt: {
    var out = BigInt();
    out.assign_small(value);
    return out;
}

// Build directly from limbs that are already reduced. Used by the division
// and Karatsuba routines, which produce normalised limbs by construction.
fn make_from_limbs(source: &const shared vector{int}, negative: bool) -> BigInt: {
    var out = BigInt();
    out.negative = negative;
    for limb: &const in source: {
        out.limbs.push_back(limb & LIMB_MASK);
    }
    out.normalise();
    return out;
}

// --- Magnitude addition ---------------------------------------------------

// |a| + |b|, ignoring both signs.
//
// The carry chain is written as one expression per limb: the accumulator is
// the previous carry plus both limbs, and the same accumulator feeds both the
// stored limb and the next carry.
fn add_magnitude(a: &const shared BigInt, b: &const shared BigInt) -> BigInt: {
    var out = BigInt();
    let length = max(a.limb_count(), b.limb_count());
    var carry: int = 0;
    var index: int = 0;
    while index < length: {
        let total = carry + a.limb_at(index) + b.limb_at(index);
        out.limbs.push_back(total & LIMB_MASK);
        carry = total >> LIMB_BITS;
        index += 1;
    }
    if carry > 0: {
        out.limbs.push_back(carry & LIMB_MASK);
    }
    out.normalise();
    return out;
}

// |a| - |b|, and the caller must guarantee |a| >= |b|.
//
// The borrow is folded into the same accumulator as the difference: adding
// LIMB_BASE before subtracting keeps the intermediate non-negative, and the
// resulting quotient by LIMB_BASE is one exactly when no borrow was needed.
fn sub_magnitude(a: &const shared BigInt, b: &const shared BigInt) -> BigInt: {
    var out = BigInt();
    var borrow: int = 0;
    var index: int = 0;
    while index < a.limb_count(): {
        let difference = a.limb_at(index) - b.limb_at(index) - borrow + LIMB_BASE;
        out.limbs.push_back(difference & LIMB_MASK);
        borrow = 1 - (difference >> LIMB_BITS);
        index += 1;
    }
    out.normalise();
    return out;
}

// |a| + small, where small is a non-negative machine integer below LIMB_BASE.
fn add_small_magnitude(a: &const shared BigInt, small: int) -> BigInt: {
    var out = a.absolute();
    var carry = small;
    var index: int = 0;
    while carry > 0: {
        out.ensure_limb(index);
        let total = out.limbs[index] + (carry & LIMB_MASK);
        out.limbs[index] = total & LIMB_MASK;
        carry = (carry >> LIMB_BITS) + (total >> LIMB_BITS);
        index += 1;
    }
    out.normalise();
    return out;
}

// --- Signed addition and subtraction --------------------------------------

// Signed addition. Same signs add magnitudes and keep the sign; mixed signs
// subtract the smaller magnitude from the larger and inherit its sign.
fn add(a: &const shared BigInt, b: &const shared BigInt) -> BigInt: {
    if a.is_negative() == b.is_negative(): {
        var out = add_magnitude(a, b);
        out.negative = a.is_negative() && out.limbs.size() > 0;
        return out;
    }
    let ordering = a.compare_magnitude(b);
    if ordering == Ordering::Equal: {
        return make_zero();
    }
    if ordering == Ordering::Greater: {
        var out = sub_magnitude(a, b);
        out.negative = a.is_negative() && out.limbs.size() > 0;
        return out;
    }
    var out = sub_magnitude(b, a);
    out.negative = b.is_negative() && out.limbs.size() > 0;
    return out;
}

// Signed subtraction expressed as addition of the negation, but without
// materialising the negated operand twice.
fn subtract(a: &const shared BigInt, b: &const shared BigInt) -> BigInt: {
    var flipped = b.clone();
    flipped.negate();
    let out = add(a, flipped);
    destroy flipped;
    return out;
}

fn negated(a: &const shared BigInt) -> BigInt: {
    var out = a.clone();
    out.negate();
    return out;
}

// a + small without building a BigInt for the small operand when the signs
// already agree.
fn add_small(a: &const shared BigInt, small: int) -> BigInt: {
    if small == 0: {
        return a.clone();
    }
    if a.is_negative() == (small < 0): {
        var out = add_small_magnitude(a, abs(small));
        out.negative = a.is_negative() || small < 0;
        out.normalise();
        return out;
    }
    let other = make_from_int(small);
    return add(a, other);
}

// --- Schoolbook multiplication --------------------------------------------

// The classic O(n*m) algorithm. The inner accumulator carries the running
// carry, the fresh limb product and the partial result already sitting in the
// destination, all in one expression -- this is the shape the whole file is
// built around.
fn schoolbook_multiply(a: &const shared BigInt, b: &const shared BigInt) -> BigInt: {
    var result = BigInt();
    if a.is_zero() || b.is_zero(): {
        return result;
    }
    result.limbs.resize(a.limb_count() + b.limb_count());
    var i: int = 0;
    while i < a.limb_count(): {
        var carry: int = 0;
        var j: int = 0;
        while j < b.limb_count(): {
            let total = carry + a.limbs[i] * b.limbs[j] + result.limbs[i + j];
            result.limbs[i + j] = total & LIMB_MASK;
            carry = total >> LIMB_BITS;
            limb_product_count += 1;
            j += 1;
        }
        // Flush the carry out through the remaining high limbs. The loop body
        // is again a single accumulate-mask-shift expression triple.
        var k = i + b.limb_count();
        while carry > 0: {
            let total = carry + result.limbs[k];
            result.limbs[k] = total & LIMB_MASK;
            carry = total >> LIMB_BITS;
            k += 1;
        }
        i += 1;
    }
    result.negative = a.is_negative() != b.is_negative();
    result.normalise();
    return result;
}

// Multiply by a single limb-sized value. The magnitude only; the caller
// applies the sign.
fn multiply_small(a: &const shared BigInt, small: int) -> BigInt: {
    var result = BigInt();
    if a.is_zero() || small == 0: {
        return result;
    }
    let magnitude = abs(small);
    var carry: int = 0;
    var index: int = 0;
    while index < a.limb_count(): {
        let total = carry + a.limbs[index] * (magnitude & LIMB_MASK);
        result.limbs.push_back(total & LIMB_MASK);
        carry = total >> LIMB_BITS;
        index += 1;
    }
    while carry > 0: {
        result.limbs.push_back(carry & LIMB_MASK);
        carry = carry >> LIMB_BITS;
    }
    result.negative = a.is_negative() != (small < 0);
    result.normalise();
    return result;
}

// Square via the schoolbook route, exploiting symmetry: every off-diagonal
// product appears twice, so it is computed once and doubled inside the same
// accumulator expression.
fn square(a: &const shared BigInt) -> BigInt: {
    var result = BigInt();
    if a.is_zero(): {
        return result;
    }
    result.limbs.resize(a.limb_count() * 2 + 1);
    var i: int = 0;
    while i < a.limb_count(): {
        let diagonal = result.limbs[i + i] + a.limbs[i] * a.limbs[i];
        result.limbs[i + i] = diagonal & LIMB_MASK;
        var carry = diagonal >> LIMB_BITS;
        var j = i + 1;
        while j < a.limb_count(): {
            let total = carry + result.limbs[i + j] + a.limbs[i] * a.limbs[j] * 2;
            result.limbs[i + j] = total & LIMB_MASK;
            carry = total >> LIMB_BITS;
            limb_product_count += 1;
            j += 1;
        }
        var k = i + a.limb_count();
        while carry > 0: {
            let total = carry + result.limbs[k];
            result.limbs[k] = total & LIMB_MASK;
            carry = total >> LIMB_BITS;
            k += 1;
        }
        i += 1;
    }
    result.negative = false;
    result.normalise();
    return result;
}

// --- Limb and bit shifts --------------------------------------------------

// Shift the magnitude up by whole limbs, i.e. multiply by LIMB_BASE^count.
fn shift_left_limbs(a: &const shared BigInt, count: int) -> BigInt: {
    var out = BigInt();
    if a.is_zero() || count < 0: {
        return out;
    }
    for i in range(0, count): {
        out.limbs.push_back(0);
    }
    for limb: &const in a.limbs: {
        out.limbs.push_back(limb);
    }
    out.negative = a.is_negative();
    out.normalise();
    return out;
}

// Shift the magnitude down by whole limbs, discarding the low ones. This is
// floor division towards zero on the magnitude, not an arithmetic shift.
fn shift_right_limbs(a: &const shared BigInt, count: int) -> BigInt: {
    var out = BigInt();
    var index = count;
    while index < a.limb_count(): {
        out.limbs.push_back(a.limbs[index]);
        index += 1;
    }
    out.negative = a.is_negative();
    out.normalise();
    return out;
}

// General left shift by an arbitrary bit count. The whole-limb part is a
// prefix of zeros; the residual bit part folds the tail of the previous limb
// into the head of the current one inside a single expression.
fn shift_left(a: &const shared BigInt, bits: int) -> BigInt: {
    if bits <= 0 || a.is_zero(): {
        return a.clone();
    }
    let whole = bits / LIMB_BITS;
    let partial = bits % LIMB_BITS;
    var out = BigInt();
    for i in range(0, whole): {
        out.limbs.push_back(0);
    }
    if partial == 0: {
        for limb: &const in a.limbs: {
            out.limbs.push_back(limb);
        }
    } else: {
        var carry: int = 0;
        var index: int = 0;
        while index < a.limb_count(): {
            let total = ((a.limbs[index] << partial) & LIMB_MASK) | carry;
            out.limbs.push_back(total & LIMB_MASK);
            carry = (a.limbs[index] >> (LIMB_BITS - partial)) & LIMB_MASK;
            index += 1;
        }
        if carry > 0: {
            out.limbs.push_back(carry);
        }
    }
    out.negative = a.is_negative();
    out.normalise();
    return out;
}

// General right shift by an arbitrary bit count, truncating towards zero on
// the magnitude. The recombination reads one limb above the current index so
// the whole limb is assembled in one expression.
fn shift_right(a: &const shared BigInt, bits: int) -> BigInt: {
    if bits <= 0 || a.is_zero(): {
        return a.clone();
    }
    let whole = bits / LIMB_BITS;
    let partial = bits % LIMB_BITS;
    var out = BigInt();
    if whole >= a.limb_count(): {
        return out;
    }
    var index = whole;
    while index < a.limb_count(): {
        if partial == 0: {
            out.limbs.push_back(a.limbs[index]);
        } else: {
            let assembled = (a.limbs[index] >> partial)
                | ((a.limb_at(index + 1) << (LIMB_BITS - partial)) & LIMB_MASK);
            out.limbs.push_back(assembled & LIMB_MASK);
        }
        index += 1;
    }
    out.negative = a.is_negative();
    out.normalise();
    return out;
}

// --- Bitwise operations ---------------------------------------------------
//
// These operate on the magnitudes only and take the sign from a simple rule
// per operator. Two's complement over an unbounded magnitude would need a
// sign-extension pass that this library deliberately does not implement.

fn bitwise_and(a: &const shared BigInt, b: &const shared BigInt) -> BigInt: {
    var out = BigInt();
    let length = min(a.limb_count(), b.limb_count());
    var index: int = 0;
    while index < length: {
        out.limbs.push_back(a.limbs[index] & b.limbs[index]);
        index += 1;
    }
    out.negative = a.is_negative() && b.is_negative();
    out.normalise();
    return out;
}

fn bitwise_or(a: &const shared BigInt, b: &const shared BigInt) -> BigInt: {
    var out = BigInt();
    let length = max(a.limb_count(), b.limb_count());
    var index: int = 0;
    while index < length: {
        out.limbs.push_back(a.limb_at(index) | b.limb_at(index));
        index += 1;
    }
    out.negative = a.is_negative() || b.is_negative();
    out.normalise();
    return out;
}

fn bitwise_xor(a: &const shared BigInt, b: &const shared BigInt) -> BigInt: {
    var out = BigInt();
    let length = max(a.limb_count(), b.limb_count());
    var index: int = 0;
    while index < length: {
        out.limbs.push_back(a.limb_at(index) ^ b.limb_at(index));
        index += 1;
    }
    out.negative = a.is_negative() != b.is_negative();
    out.normalise();
    return out;
}

// Complement within a fixed width, since an unbounded complement is not
// representable. Bits above `width` are simply dropped.
fn bitwise_not_width(a: &const shared BigInt, width: int) -> BigInt: {
    var out = BigInt();
    let limbs_needed = (width + LIMB_BITS - 1) / LIMB_BITS;
    var index: int = 0;
    while index < limbs_needed: {
        out.limbs.push_back((~a.limb_at(index)) & LIMB_MASK);
        index += 1;
    }
    let overhang = width % LIMB_BITS;
    if overhang != 0 && out.limbs.size() > 0: {
        let top = out.limbs.size() - 1;
        out.limbs[top] = out.limbs[top] & ((1 << overhang) - 1);
    }
    out.negative = false;
    out.normalise();
    return out;
}

// --- Karatsuba multiplication ---------------------------------------------

// Take the low `count` limbs of a magnitude.
fn low_part(a: &const shared BigInt, count: int) -> BigInt: {
    var out = BigInt();
    var index: int = 0;
    while index < count && index < a.limb_count(): {
        out.limbs.push_back(a.limbs[index]);
        index += 1;
    }
    out.negative = false;
    out.normalise();
    return out;
}

// Take everything from limb `count` upwards.
fn high_part(a: &const shared BigInt, count: int) -> BigInt: {
    var out = BigInt();
    var index = count;
    while index < a.limb_count(): {
        out.limbs.push_back(a.limbs[index]);
        index += 1;
    }
    out.negative = false;
    out.normalise();
    return out;
}

// Karatsuba: with a = a1*B^k + a0 and b = b1*B^k + b0,
//
//     a*b = a1*b1*B^(2k) + ((a1+a0)*(b1+b0) - a1*b1 - a0*b0)*B^k + a0*b0
//
// so three half-width products replace four. The recombination below is
// written as one long chained expression to match the formula shape.
fn karatsuba_multiply(a: &const shared BigInt, b: &const shared BigInt) -> BigInt: {
    if a.is_zero() || b.is_zero(): {
        return make_zero();
    }
    if a.limb_count() < KARATSUBA_THRESHOLD || b.limb_count() < KARATSUBA_THRESHOLD: {
        return schoolbook_multiply(a, b);
    }

    let split = max(a.limb_count(), b.limb_count()) / 2;
    let a_low = low_part(a, split);
    let a_high = high_part(a, split);
    let b_low = low_part(b, split);
    let b_high = high_part(b, split);

    let high_product = karatsuba_multiply(a_high, b_high);
    let low_product = karatsuba_multiply(a_low, b_low);
    let cross_sum_a = add_magnitude(a_low, a_high);
    let cross_sum_b = add_magnitude(b_low, b_high);
    let cross_raw = karatsuba_multiply(cross_sum_a, cross_sum_b);
    let middle = subtract(subtract(cross_raw, high_product), low_product);

    // result = high << 2k  +  middle << k  +  low, in a single chain.
    var result = add(add(shift_left_limbs(high_product, split + split),
        shift_left_limbs(middle, split)), low_product);
    result.negative = a.is_negative() != b.is_negative() && !result.is_zero();
    result.normalise();
    return result;
}

// Public multiply entry point: dispatch on operand width.
fn multiply(a: &const shared BigInt, b: &const shared BigInt) -> BigInt: {
    if a.is_zero() || b.is_zero(): {
        return make_zero();
    }
    if a.limb_count() == 1 && b.limb_count() == 1: {
        // Both fit in one limb, so the product fits in two and can be built
        // without any loop at all.
        var out = BigInt();
        let total = a.limbs[0] * b.limbs[0];
        out.limbs.push_back(total & LIMB_MASK);
        out.limbs.push_back(total >> LIMB_BITS);
        out.negative = a.is_negative() != b.is_negative();
        out.normalise();
        return out;
    }
    if a.limb_count() + b.limb_count() < KARATSUBA_THRESHOLD * 2: {
        return schoolbook_multiply(a, b);
    }
    return karatsuba_multiply(a, b);
}

// --- Division -------------------------------------------------------------

// Quotient and remainder together, so callers that need both pay once.
struct DivisionResult: {
    quotient: BigInt;
    remainder: BigInt;
    exact: bool = false;
}

// Divide the magnitude by a single limb value, returning the quotient and
// leaving the remainder in the out parameter slot of the result struct.
//
// The running remainder is folded into the numerator of the next limb, so the
// whole step is one expression: (rest * BASE + limb) / divisor.
fn divide_small(a: &const shared BigInt, divisor: int) -> DivisionResult: {
    var out = DivisionResult();
    if divisor == 0: {
        panic("bignum: division by zero");
        return out;
    }
    let magnitude = abs(divisor);
    out.quotient.limbs.resize(a.limb_count());
    var rest: int = 0;
    var index = a.limb_count() - 1;
    while index >= 0: {
        let numerator = rest * LIMB_BASE + a.limbs[index];
        out.quotient.limbs[index] = (numerator / magnitude) & LIMB_MASK;
        rest = numerator % magnitude;
        index -= 1;
    }
    out.quotient.negative = a.is_negative() != (divisor < 0);
    out.quotient.normalise();
    out.remainder.assign_small(rest);
    out.remainder.negative = a.is_negative() && rest != 0;
    out.remainder.normalise();
    out.exact = rest == 0;
    return out;
}

// Estimate one quotient limb from the top two limbs of the running remainder
// and the top limb of the divisor. The estimate is at most two too large,
// which the correction loop in long_divide fixes up.
fn estimate_quotient_limb(rest: &const shared BigInt, divisor: &const shared BigInt, offset: int) -> int: {
    let top = divisor.limbs[divisor.limb_count() - 1];
    let high = rest.limb_at(offset + divisor.limb_count());
    let low = rest.limb_at(offset + divisor.limb_count() - 1);
    var guess = (high * LIMB_BASE + low) / top;
    if guess > LIMB_MASK: {
        guess = LIMB_MASK;
    }
    if guess < 0: {
        guess = 0;
    }
    return guess;
}

// Knuth-style long division on normalised operands.
//
// At each step the divisor is shifted up by `offset` limbs, a quotient limb is
// estimated, the shifted product is subtracted, and the estimate is corrected
// downwards while the subtraction would have gone negative.
fn long_divide(a: &const shared BigInt, b: &const shared BigInt) -> DivisionResult: {
    var out = DivisionResult();
    if b.is_zero(): {
        panic("bignum: division by zero");
        return out;
    }
    let dividend = a.absolute();
    let divisor = b.absolute();
    if dividend.compare_magnitude(divisor) == Ordering::Less: {
        out.quotient = make_zero();
        out.remainder = a.clone();
        out.exact = a.is_zero();
        return out;
    }
    if divisor.limb_count() == 1: {
        var small = divide_small(dividend, divisor.limbs[0]);
        small.quotient.negative = a.is_negative() != b.is_negative() && !small.quotient.is_zero();
        small.remainder.negative = a.is_negative() && !small.remainder.is_zero();
        small.quotient.normalise();
        small.remainder.normalise();
        return small;
    }

    var rest = dividend.clone();
    let steps = dividend.limb_count() - divisor.limb_count();
    out.quotient.limbs.resize(steps + 1);
    var offset = steps;
    var guard: int = 0;
    while offset >= 0: {
        var guess = estimate_quotient_limb(rest, divisor, offset);
        var trial = shift_left_limbs(multiply_small(divisor, guess), offset);
        // Walk the estimate down until the trial product fits. At most two
        // iterations are needed for a properly normalised divisor.
        while trial.compare_magnitude(rest) == Ordering::Greater && guess > 0: {
            guess -= 1;
            trial = shift_left_limbs(multiply_small(divisor, guess), offset);
            guard += 1;
            if guard > DIVISION_ITERATION_LIMIT: {
                panic("bignum: division failed to converge");
                return out;
            }
        }
        // And walk it up again in the rare case the estimate was too small.
        var next_trial = shift_left_limbs(multiply_small(divisor, guess + 1), offset);
        while next_trial.compare_magnitude(rest) != Ordering::Greater: {
            guess += 1;
            trial = next_trial;
            next_trial = shift_left_limbs(multiply_small(divisor, guess + 1), offset);
            guard += 1;
            if guard > DIVISION_ITERATION_LIMIT: {
                panic("bignum: division failed to converge");
                return out;
            }
        }
        rest = sub_magnitude(rest, trial);
        out.quotient.limbs[offset] = guess & LIMB_MASK;
        destroy trial;
        offset -= 1;
    }

    out.quotient.negative = a.is_negative() != b.is_negative();
    out.quotient.normalise();
    out.remainder = rest;
    out.remainder.negative = a.is_negative() && !rest.is_zero();
    out.remainder.normalise();
    out.exact = out.remainder.is_zero();
    return out;
}

fn divide(a: &const shared BigInt, b: &const shared BigInt) -> BigInt: {
    let result = long_divide(a, b);
    return result.quotient;
}

fn remainder(a: &const shared BigInt, b: &const shared BigInt) -> BigInt: {
    let result = long_divide(a, b);
    return result.remainder;
}

// Mathematical modulus: always in [0, |b|), unlike remainder which follows
// the sign of the dividend.
fn modulus(a: &const shared BigInt, b: &const shared BigInt) -> BigInt: {
    var rest = remainder(a, b);
    if rest.is_negative(): {
        let magnitude = b.absolute();
        rest = add(rest, magnitude);
    }
    rest.normalise();
    return rest;
}

fn divides_evenly(a: &const shared BigInt, b: &const shared BigInt) -> bool: {
    return long_divide(a, b).exact;
}

// --- Modular arithmetic ---------------------------------------------------

fn mod_add(a: &const shared BigInt, b: &const shared BigInt, m: &const shared BigInt) -> BigInt: {
    return modulus(add(a, b), m);
}

fn mod_sub(a: &const shared BigInt, b: &const shared BigInt, m: &const shared BigInt) -> BigInt: {
    return modulus(subtract(a, b), m);
}

fn mod_mul(a: &const shared BigInt, b: &const shared BigInt, m: &const shared BigInt) -> BigInt: {
    return modulus(multiply(a, b), m);
}

// Square-and-multiply, scanning the exponent from the least significant bit
// upwards and keeping the running base reduced at every step.
fn mod_pow(base: &const shared BigInt, exponent: &const shared BigInt, m: &const shared BigInt) -> BigInt: {
    if m.is_zero(): {
        panic("bignum: modulus must be non-zero");
        return make_zero();
    }
    var result = make_one();
    var running = modulus(base, m);
    let bits = exponent.bit_length();
    var index: int = 0;
    while index < bits: {
        if exponent.get_bit(index) == 1: {
            result = modulus(multiply(result, running), m);
        }
        running = modulus(square(running), m);
        index += 1;
    }
    result.normalise();
    return result;
}

// Plain exponentiation with a machine-integer exponent.
fn power(base: &const shared BigInt, exponent: int) -> BigInt: {
    if exponent < 0: {
        panic("bignum: negative exponent");
        return make_zero();
    }
    var result = make_one();
    var running = base.clone();
    var rest = exponent;
    while rest > 0: {
        if (rest & 1) == 1: {
            result = multiply(result, running);
        }
        running = square(running);
        rest = rest >> 1;
    }
    return result;
}

// --- Greatest common divisor ----------------------------------------------

// Euclid on magnitudes. Simple and correct; the binary variant below is the
// one that is actually fast for large inputs.
fn gcd_euclid(a: &const shared BigInt, b: &const shared BigInt) -> BigInt: {
    var x = a.absolute();
    var y = b.absolute();
    while !y.is_zero(): {
        let rest = remainder(x, y);
        x = y;
        y = rest;
    }
    x.normalise();
    return x;
}

// Binary (Stein) GCD: strip common factors of two, then repeatedly subtract
// the smaller from the larger and re-strip.
fn gcd(a: &const shared BigInt, b: &const shared BigInt) -> BigInt: {
    var x = a.absolute();
    var y = b.absolute();
    if x.is_zero(): {
        return y;
    }
    if y.is_zero(): {
        return x;
    }
    let common = min(x.lowest_set_bit(), y.lowest_set_bit());
    x = shift_right(x, x.lowest_set_bit());
    y = shift_right(y, y.lowest_set_bit());
    while !y.is_zero(): {
        if x.compare_magnitude(y) == Ordering::Greater: {
            swap(x, y);
        }
        y = sub_magnitude(y, x);
        if !y.is_zero(): {
            y = shift_right(y, y.lowest_set_bit());
        }
    }
    return shift_left(x, common);
}

fn lcm(a: &const shared BigInt, b: &const shared BigInt) -> BigInt: {
    if a.is_zero() || b.is_zero(): {
        return make_zero();
    }
    let divisor = gcd(a, b);
    return divide(multiply(a, b).absolute(), divisor);
}

// --- Operator implementations ---------------------------------------------
//
// The named routines above are the real implementation; these impls only give
// them infix spelling, so that a call site can be one long algebraic
// expression such as `(a * b + c) / d` instead of a stack of nested calls.
// Every operand is a shared const reference and every result is freshly
// normalised, so no operator ever aliases its inputs.

// Sum of two signed numbers.
fn impl (a + b)(l: &const shared BigInt, r: &const shared BigInt) -> BigInt: {
    return add(l, r);
}

// Difference, defined as l + (-r) but computed without materialising -r twice.
fn impl (a - b)(l: &const shared BigInt, r: &const shared BigInt) -> BigInt: {
    return subtract(l, r);
}

// Product, dispatching between the one-limb path, schoolbook and Karatsuba.
fn impl (a * b)(l: &const shared BigInt, r: &const shared BigInt) -> BigInt: {
    return multiply(l, r);
}

// Truncating division: the quotient rounds towards zero, so
// (-7) / 2 == -3 and the identity l == (l / r) * r + l % r holds.
fn impl (a / b)(l: &const shared BigInt, r: &const shared BigInt) -> BigInt: {
    return divide(l, r);
}

// Remainder, which follows the sign of the dividend. Use modulus() when a
// non-negative residue is wanted instead.
fn impl (a % b)(l: &const shared BigInt, r: &const shared BigInt) -> BigInt: {
    return remainder(l, r);
}

// --- Comparison operators -------------------------------------------------
//
// All six route through the single three-way compare so that the sign rules
// live in exactly one place.

fn impl (a < b)(l: &const shared BigInt, r: &const shared BigInt) -> bool: {
    return l.compare(r) == Ordering::Less;
}

fn impl (a <= b)(l: &const shared BigInt, r: &const shared BigInt) -> bool: {
    return l.compare(r) != Ordering::Greater;
}

fn impl (a > b)(l: &const shared BigInt, r: &const shared BigInt) -> bool: {
    return l.compare(r) == Ordering::Greater;
}

fn impl (a >= b)(l: &const shared BigInt, r: &const shared BigInt) -> bool: {
    return l.compare(r) != Ordering::Less;
}

fn impl (a == b)(l: &const shared BigInt, r: &const shared BigInt) -> bool: {
    return l.compare(r) == Ordering::Equal;
}

fn impl (a != b)(l: &const shared BigInt, r: &const shared BigInt) -> bool: {
    return l.compare(r) != Ordering::Equal;
}

// --- Unary operators ------------------------------------------------------

// Unary minus. Zero is its own negation, which negate() already guarantees.
fn impl (-a)(l: &const shared BigInt) -> BigInt: {
    return negated(l);
}

// --- Character tables -----------------------------------------------------
//
// The lexer only accepts decimal literals, so every code point above is a
// decimal constant. Digit rendering goes through these two tables rather than
// arithmetic on character codes, which turns the upper/lower case choice into
// a table swap instead of a branch in the inner loop.

static DIGIT_TABLE_LOWER: string = "0123456789abcdefghijklmnopqrstuvwxyz";
static DIGIT_TABLE_UPPER: string = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ";

// The largest radix the tables can render, and the shape of one hex digit.
static MAX_RADIX: int = 36;
static BITS_PER_NIBBLE: int = 4;
static NIBBLE_MASK: int = 15;

// Reinterpret a character as its code point. Written as a named function so
// that the conversion is visible at every call site rather than implicit.
fn code_of(c: char) -> int: {
    return c;
}

// 10^count, for count in [0, 9]. Small enough to stay inside one limb, which
// is exactly why DECIMAL_DIGITS_PER_CHUNK is eight rather than nine.
fn power_of_ten(count: int) -> int: {
    var result: int = 1;
    var index: int = 0;
    while index < count: {
        result = result * 10;
        index += 1;
    }
    return result;
}

// Value of a decimal digit character, or -1 when it is not a digit at all.
fn decimal_digit_value(code: int) -> int: {
    if code < CHAR_ZERO || code > CHAR_NINE: {
        return -1;
    }
    return code - CHAR_ZERO;
}

// Character for a digit value in [0, MAX_RADIX).
fn digit_char(value: int, upper: bool) -> char: {
    if upper: {
        return DIGIT_TABLE_UPPER.at(value);
    }
    return DIGIT_TABLE_LOWER.at(value);
}

// --- Decimal parsing ------------------------------------------------------

// What parse_decimal produces: the value, why it stopped, and how far it got.
// The caller can use consumed to point an error message at the offending
// character without re-scanning the input.
struct ParseResult: {
    value: BigInt;
    status: ParseStatus = ParseStatus::Ok;
    consumed: int = 0;
    negative: bool = false;
}

// Parse a signed decimal string.
//
// Digits are accumulated eight at a time into a machine integer, and each
// full chunk is folded into the running value with one multiply-and-add:
// value = value * 10^8 + chunk. That is one BigInt operation per eight
// characters instead of one per character, which is the whole reason for the
// chunked representation. Underscores are accepted as digit separators inside
// the digit run even though the language's own lexer rejects them.
fn parse_decimal(text: &const shared string) -> ParseResult: {
    var out = ParseResult();
    if text.size() == 0: {
        out.status = ParseStatus::EmptyInput;
        return out;
    }

    var index: int = 0;
    let first = code_of(text.at(0));
    if first == CHAR_MINUS || first == CHAR_PLUS: {
        out.negative = first == CHAR_MINUS;
        index = 1;
    }
    if index >= text.size(): {
        out.status = ParseStatus::EmptyInput;
        return out;
    }

    var value = make_zero();
    var chunk: int = 0;
    var chunk_digits: int = 0;
    var seen_digit = false;
    while index < text.size(): {
        let code = code_of(text.at(index));
        if code == CHAR_UNDERSCORE: {
            // A separator is only meaningful between digits, never leading.
            if !seen_digit: {
                out.status = ParseStatus::BadDigit;
                out.consumed = index;
                return out;
            }
            index += 1;
            continue;
        }
        let digit = decimal_digit_value(code);
        if digit < 0: {
            out.status = ParseStatus::BadDigit;
            out.consumed = index;
            return out;
        }
        seen_digit = true;
        chunk = chunk * 10 + digit;
        chunk_digits += 1;
        if chunk_digits == DECIMAL_DIGITS_PER_CHUNK: {
            value = add_small(multiply_small(value, DECIMAL_CHUNK_BASE), chunk);
            chunk = 0;
            chunk_digits = 0;
        }
        index += 1;
    }

    if !seen_digit: {
        out.status = ParseStatus::EmptyInput;
        out.consumed = index;
        return out;
    }
    // Fold the short tail chunk in with the matching power of ten.
    if chunk_digits > 0: {
        value = add_small(multiply_small(value, power_of_ten(chunk_digits)), chunk);
    }

    value.negative = out.negative && !value.is_zero();
    value.normalise();
    out.value = value;
    out.consumed = index;
    out.status = ParseStatus::Ok;
    return out;
}

// Convenience wrapper for callers that do not care why a parse failed.
fn from_decimal_string(text: &const shared string) -> BigInt: {
    let parsed = parse_decimal(text);
    if parsed.status != ParseStatus::Ok: {
        panic("bignum: malformed decimal literal");
        return make_zero();
    }
    return parsed.value;
}

// --- Digit emission -------------------------------------------------------

// Append `value` in decimal, left-padded with zeros to `width` characters.
// A width of zero means "no padding", which is what the most significant
// chunk of a number wants; every following chunk is padded to the full chunk
// width so that internal zeros survive.
fn append_padded_decimal(target: &unique string, value: int, width: int): {
    var digits = vector{int}();
    var rest = abs(value);
    if rest == 0: {
        digits.push_back(0);
    }
    while rest > 0: {
        digits.push_back(rest % 10);
        rest = rest / 10;
    }
    while digits.size() < width: {
        digits.push_back(0);
    }
    var index = digits.size() - 1;
    while index >= 0: {
        target.push_back(digit_char(digits[index], false));
        index -= 1;
    }
}

// --- Decimal formatting ---------------------------------------------------

// Render a BigInt in base ten.
//
// The magnitude is peeled apart eight decimal digits at a time by repeated
// division by 10^8. The chunks come out least significant first, so they are
// emitted in reverse; only the top chunk is unpadded.
fn to_decimal_string(a: &const shared BigInt) -> string: {
    var out = string();
    if a.is_zero(): {
        out.push_back('0');
        return out;
    }

    var chunks = vector{int}();
    var rest = a.absolute();
    var guard: int = 0;
    while !rest.is_zero(): {
        let step = divide_small(rest, DECIMAL_CHUNK_BASE);
        // The chunk base is below LIMB_BASE, so the remainder is one limb.
        chunks.push_back(step.remainder.limb_at(0));
        rest = step.quotient;
        guard += 1;
        if guard > DIVISION_ITERATION_LIMIT: {
            panic("bignum: decimal conversion failed to terminate");
            return out;
        }
    }

    if a.is_negative(): {
        out.push_back('-');
    }
    var index = chunks.size() - 1;
    append_padded_decimal(out, chunks[index], 0);
    index -= 1;
    while index >= 0: {
        append_padded_decimal(out, chunks[index], DECIMAL_DIGITS_PER_CHUNK);
        index -= 1;
    }
    return out;
}

// --- Hexadecimal formatting -----------------------------------------------

// Render the magnitude in base sixteen, most significant nibble first.
//
// Rather than dividing, each nibble is assembled out of four bit queries in a
// single expression; get_bit returns zero past the top of the number, so the
// highest partial nibble needs no special case.
fn to_hex_string(a: &const shared BigInt, upper: bool) -> string: {
    var out = string();
    if a.is_zero(): {
        out.push_back('0');
        return out;
    }
    if a.is_negative(): {
        out.push_back('-');
    }
    // Round the bit length up to a whole nibble and start at its low bit.
    var position = ((a.bit_length() + BITS_PER_NIBBLE - 1) / BITS_PER_NIBBLE)
        * BITS_PER_NIBBLE - BITS_PER_NIBBLE;
    while position >= 0: {
        let nibble = (a.get_bit(position + 3) << 3) | (a.get_bit(position + 2) << 2)
            | (a.get_bit(position + 1) << 1) | a.get_bit(position);
        out.push_back(digit_char(nibble & NIBBLE_MASK, upper));
        position -= BITS_PER_NIBBLE;
    }
    return out;
}

// --- Binary formatting ----------------------------------------------------

// Render the magnitude in base two, most significant bit first. When `group`
// is positive an underscore is inserted every `group` bits, counting from the
// bottom, so that 2^12 - 1 with a group of four reads 1111_1111_1111.
fn to_binary_string(a: &const shared BigInt, group: int) -> string: {
    var out = string();
    if a.is_zero(): {
        out.push_back('0');
        return out;
    }
    if a.is_negative(): {
        out.push_back('-');
    }
    var position = a.bit_length() - 1;
    while position >= 0: {
        out.push_back(digit_char(a.get_bit(position) & 1, false));
        if group > 0 && position > 0 && position % group == 0: {
            out.push_back('_');
        }
        position -= 1;
    }
    return out;
}

// --- Extended Euclid ------------------------------------------------------

// The triple produced by extended_gcd: the greatest common divisor together
// with the Bezout coefficients that reconstruct it, so that
// divisor == x * a + y * b holds for the original inputs.
struct ExtendedGcd: {
    divisor: BigInt;
    x: BigInt;
    y: BigInt;
}

// Iterative extended Euclid.
//
// Two coefficient rows are carried alongside the remainder row and every step
// applies the same quotient to all three. Written with the infix operators
// above, each update is one expression mirroring the textbook recurrence
// r' = r_prev - q * r rather than nested calls into divide and multiply.
fn extended_gcd(a: &const shared BigInt, b: &const shared BigInt) -> ExtendedGcd: {
    var out = ExtendedGcd();
    var old_rest = a.clone();
    var rest = b.clone();
    var old_x = make_one();
    var x = make_zero();
    var old_y = make_zero();
    var y = make_one();
    var guard: int = 0;
    while !rest.is_zero(): {
        let quotient = old_rest / rest;
        let next_rest = old_rest - quotient * rest;
        let next_x = old_x - quotient * x;
        let next_y = old_y - quotient * y;
        old_rest = rest;
        rest = next_rest;
        old_x = x;
        x = next_x;
        old_y = y;
        y = next_y;
        guard += 1;
        if guard > DIVISION_ITERATION_LIMIT: {
            panic("bignum: extended gcd failed to converge");
            return out;
        }
    }
    out.divisor = old_rest;
    out.x = old_x;
    out.y = old_y;
    return out;
}

// Modular inverse of a modulo m, or a panic when the two are not coprime.
// The Bezout coefficient x already satisfies x * a == 1 (mod m); it only has
// to be pulled back into [0, m).
fn mod_inverse(a: &const shared BigInt, m: &const shared BigInt) -> BigInt: {
    if m.is_zero(): {
        panic("bignum: modulus must be non-zero");
        return make_zero();
    }
    let reduced = modulus(a, m);
    let bezout = extended_gcd(reduced, m.absolute());
    if bezout.divisor != make_one(): {
        panic("bignum: value is not invertible modulo m");
        return make_zero();
    }
    let inverse = modulus(bezout.x, m.absolute());
    assert inverse.is_negative() == false;
    return inverse;
}

// --- Integer square root --------------------------------------------------

// Newton iteration for floor(sqrt(a)).
//
// The seed is 2^(ceil(bits/2)), which is at least the true root, and the step
// next = (guess + a / guess) / 2 decreases monotonically from there, so the
// first non-decreasing step is the fixed point. The correction loop absorbs
// the one-off overshoot integer truncation can leave behind.
fn isqrt(a: &const shared BigInt) -> BigInt: {
    if a.is_negative(): {
        panic("bignum: square root of a negative number");
        return make_zero();
    }
    if a.is_zero() || a.compare_small(1) == Ordering::Equal: {
        return a.clone();
    }

    var guess = shift_left(make_one(), a.bit_length() / 2 + 1);
    var guard: int = 0;
    loop: {
        let next = (guess + a / guess) >> 1;
        if next >= guess: {
            break;
        }
        guess = next;
        guard += 1;
        if guard > DIVISION_ITERATION_LIMIT: {
            panic("bignum: square root failed to converge");
            break;
        }
    }
    // Truncation can leave the estimate one too high; never more than one.
    while guess * guess > a: {
        guess = guess - make_one();
    }
    prove guess * guess <= a;
    return guess;
}

fn is_perfect_square(a: &const shared BigInt) -> bool: {
    if a.is_negative(): {
        return false;
    }
    let root = isqrt(a);
    return root * root == a;
}

// --- Factorials and binomials ---------------------------------------------

// n! by straight accumulation. Each factor fits in a limb for any n that is
// remotely computable, so the whole product runs through multiply_small.
fn factorial(n: int) -> BigInt: {
    if n < 0: {
        panic("bignum: factorial of a negative number");
        return make_zero();
    }
    var result = make_one();
    var index: int = 2;
    while index <= n: {
        result = multiply_small(result, index);
        index += 1;
    }
    return result;
}

// Binomial coefficient by the multiplicative formula
//
//     C(n, k) = product over i in [1, k] of (n - k + i) / i
//
// which stays exact at every step because the partial product of the first i
// factors is always divisible by i!. Multiplying up and dividing back down in
// one expression keeps the running value as small as the result allows.
fn binomial(n: int, k: int) -> BigInt: {
    if k < 0 || k > n: {
        return make_zero();
    }
    let chosen = min(k, n - k);
    var result = make_one();
    var index: int = 1;
    while index <= chosen: {
        result = divide_small(multiply_small(result, n - chosen + index), index).quotient;
        index += 1;
    }
    result.normalise();
    return result;
}

}

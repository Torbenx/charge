    rows.push_back(DecompositionRow(source: 8217, first: 39, second: 0, compatibility: true, note: "right quote"));      /* 0x2019*/
    rows.push_back(DecompositionRow(source: 8220, first: 34, second: 0, compatibility: true, note: "left double quote"));/* 0x201C*/
    rows.push_back(DecompositionRow(source: 8221, first: 34, second: 0, compatibility: true, note: "right double quote")); /* 0x201D*/
    rows.push_back(DecompositionRow(source: 8230, first: 46, second: 0, compatibility: true, note: "ellipsis"));         /* 0x2026*/
    rows.push_back(DecompositionRow(source: 64256, first: 102, second: 102, compatibility: true, note: "ligature ff"));  /* 0xFB00*/
    rows.push_back(DecompositionRow(source: 64257, first: 102, second: 105, compatibility: true, note: "ligature fi"));  /* 0xFB01*/
    rows.push_back(DecompositionRow(source: 64258, first: 102, second: 108, compatibility: true, note: "ligature fl"));  /* 0xFB02*/

    return rows;
}

fn find_decomposition(rows: &const shared vector{DecompositionRow}, scalar: int) -> int: {
    var index: int = 0;
    for row: &const in rows: {
        if row.source == scalar: {
            return index;
        }
        index += 1;
    }
    return -1;
}

/* The reverse lookup used by recomposition: given a starter and a following*/
/* mark, is there a single code point that spells the pair?*/
fn find_composition(rows: &const shared vector{DecompositionRow}, starter: int, mark: int) -> int: {
    for row: &const in rows: {
        if row.compatibility: {
            /* Compatibility decompositions never recompose.*/
            discard row;
        } else: {
            if row.first == starter && row.second == mark: {
                return row.source;
            }
        }
    }
    return -1;
}

/* Hangul syllables decompose arithmetically rather than by table.*/
fn hangul_decompose(scalar: int, sink: &unique vector{int}) -> bool: {
    if is_hangul_syllable(scalar) == false: {
        return false;
    }
    let index = scalar - HANGUL_SYLLABLE_FIRST;
    let lead = HANGUL_L_FIRST + index / HANGUL_NV_COUNT;
    let vowel = HANGUL_V_FIRST + (index % HANGUL_NV_COUNT) / HANGUL_T_COUNT;
    let trail = HANGUL_T_FIRST + index % HANGUL_T_COUNT;
    sink.push_back(lead);
    sink.push_back(vowel);
    if (index % HANGUL_T_COUNT) != 0: {
        sink.push_back(trail);
    }
    return true;
}

fn hangul_compose(first: int, second: int) -> int: {
    /* L plus V forms an LV syllable.*/
    if first >= HANGUL_L_FIRST && first < HANGUL_L_FIRST + HANGUL_L_COUNT: {
        if second >= HANGUL_V_FIRST && second < HANGUL_V_FIRST + HANGUL_V_COUNT: {
            let lead = first - HANGUL_L_FIRST;
            let vowel = second - HANGUL_V_FIRST;
            return HANGUL_SYLLABLE_FIRST + (lead * HANGUL_V_COUNT + vowel) * HANGUL_T_COUNT;
        }
    }
    /* LV plus T forms an LVT syllable.*/
    if is_hangul_syllable(first): {
        if ((first - HANGUL_SYLLABLE_FIRST) % HANGUL_T_COUNT) == 0: {
            if second > HANGUL_T_FIRST && second < HANGUL_T_FIRST + HANGUL_T_COUNT: {
                return first + (second - HANGUL_T_FIRST);
            }
        }
    }
    return -1;
}

/* Recursively expand one scalar. The recursion is bounded because every*/
/* decomposition strictly reduces the code point of the starter.*/
fn decompose_scalar(props: &const shared Properties, scalar: int, compatibility: bool, sink: &unique vector{int}, depth: int): {
    if depth > 8: {
        sink.push_back(scalar);
        return;
    }
    if hangul_decompose(scalar, sink): {
        return;
    }
    let index = find_decomposition(props.decompositions, scalar);
    if index < 0: {
        sink.push_back(scalar);
        return;
    }
    let row: &const = props.decompositions.at(index);
    if row.compatibility && compatibility == false: {
        sink.push_back(scalar);
        return;
    }
    if row.first == scalar: {
        /* A self referential row would loop forever; treat it as a leaf.*/
        sink.push_back(scalar);
        return;
    }
    decompose_scalar(props, row.first, compatibility, sink, depth + 1);
    if row.second != 0: {
        decompose_scalar(props, row.second, compatibility, sink, depth + 1);
    }
}

/* Canonical ordering: a stable insertion sort over each run of non starters,*/
/* keyed on the combining class.*/
fn canonical_order(props: &const shared Properties, scalars: &unique vector{int}): {
    var index: int = 1;
    while index < scalars.size(): {
        let current = scalars.at(index);
        let current_class = props.combining_of(current);
        if current_class == 0: {
            index += 1;
        } else: {
            var probe = index;
            var moved: bool = false;
            while probe > 0: {
                let previous = scalars.at(probe - 1);
                let previous_class = props.combining_of(previous);
                if previous_class == 0: {
                    probe = 0;
                } else: {
                    if previous_class > current_class: {
                        swap(scalars.at(probe - 1), scalars.at(probe));
                        probe -= 1;
                        moved = true;
                    } else: {
                        probe = 0;
                    }
                }
            }
            if moved: {
                assert index > 0;
            }
            index += 1;
        }
    }
}

fn decompose(props: &const shared Properties, scalars: &const shared vector{int}, compatibility: bool) -> vector{int}: {
    var out: vector{int};
    out.reserve(scalars.size() * 2);
    for scalar: &const in scalars: {
        decompose_scalar(props, scalar, compatibility, out, 0);
    }
    canonical_order(props, out);
    return out;
}

/* Recomposition, the second half of NFC. Walk the decomposed run keeping the*/
/* index of the last starter; whenever a mark can be composed onto it, replace*/
/* the starter and drop the mark.*/
fn compose(props: &const shared Properties, scalars: &const shared vector{int}) -> vector{int}: {
    var out: vector{int};
    if scalars.empty(): {
        return out;
    }

    var starter_index: int = -1;
    var last_class: int = -1;

    for scalar: &const in scalars: {
        let current_class = props.combining_of(scalar);

        if starter_index >= 0: {
            let blocked = last_class >= current_class && last_class > 0;
            if blocked == false: {
                let starter = out.at(starter_index);
                var composed = hangul_compose(starter, scalar);
                if composed < 0: {
                    composed = find_composition(props.decompositions, starter, scalar);
                }
                if composed >= 0: {
                    out.at(starter_index) = composed;
                    /* The mark is absorbed, so the class of the previous*/
                    /* character is unchanged.*/
                    continue;
                }
            }
        }

        if current_class == 0: {
            starter_index = out.size();
            last_class = 0;
        } else: {
            last_class = current_class;
        }
        out.push_back(scalar);
    }
    return out;
}

fn normalize(props: &const shared Properties, scalars: &const shared vector{int}, form: NormalForm) -> vector{int}: {
    if form == NormalForm::None: {
        return utf32_encode(scalars);
    }
    if form == NormalForm::Nfd: {
        return decompose(props, scalars, false);
    }
    if form == NormalForm::Nfkd: {
        return decompose(props, scalars, true);
    }
    if form == NormalForm::Nfc: {
        let expanded = decompose(props, scalars, false);
        return compose(props, expanded);
    }
    let expanded = decompose(props, scalars, true);
    return compose(props, expanded);
}

/* A quick check that answers yes, no or maybe without doing the work. Only the*/
/* definite answers are useful; maybe means the caller has to normalise.*/
fn is_normalized_quick(props: &const shared Properties, scalars: &const shared vector{int}, form: NormalForm) -> int: {
    var last_class: int = 0;
    for scalar: &const in scalars: {
        let current_class = props.combining_of(scalar);
        if last_class > current_class && current_class != 0: {
            return 0;                          /* definitely not normalised*/
        }
        if find_decomposition(props.decompositions, scalar) >= 0: {
            if form == NormalForm::Nfd || form == NormalForm::Nfkd: {
                return 0;
            }
            return 2;                          /* maybe*/
        }
        last_class = current_class;
    }
    return 1;                                  /* definitely normalised*/
}

/* Compare two runs under canonical equivalence.*/
fn canonically_equal(props: &const shared Properties, left: &const shared vector{int}, right: &const shared vector{int}) -> bool: {
    let a = decompose(props, left, false);
    let b = decompose(props, right, false);
    if a.size() != b.size(): {
        return false;
    }
    for i in range(0, a.size()): {
        if a.at(i) != b.at(i): {
            return false;
        }
    }
    return true;
}

/* --- Display width -------------------------------------------------------*/
/**/
/* Terminal column counting. Combining marks take no columns, East Asian wide*/
/* and fullwidth characters take two, and the ambiguous class takes one or two*/
/* depending on a locale flag the caller supplies.*/

static WIDTH_ZERO: int = 0;
static WIDTH_NARROW: int = 1;
static WIDTH_WIDE: int = 2;
static WIDTH_CONTROL_ESCAPE: int = 4;          /* <U+0007> style rendering*/

fn width_table() -> vector{WidthRange}: {
    var rows: vector{WidthRange};

    /* Zero width: the marks and the invisible formatting characters.*/
    rows.push_back(WidthRange(first: 768, last: 879, width: WidthClass::ZeroWidth));          /* 0x0300 .. 0x036F*/
    rows.push_back(WidthRange(first: 1155, last: 1161, width: WidthClass::ZeroWidth));        /* 0x0483 .. 0x0489*/
    rows.push_back(WidthRange(first: 1425, last: 1469, width: WidthClass::ZeroWidth));        /* 0x0591 .. 0x05BD*/
    rows.push_back(WidthRange(first: 1611, last: 1631, width: WidthClass::ZeroWidth));        /* 0x064B .. 0x065F*/
    rows.push_back(WidthRange(first: 2304, last: 2306, width: WidthClass::ZeroWidth));        /* 0x0900 .. 0x0902*/
    rows.push_back(WidthRange(first: 2364, last: 2364, width: WidthClass::ZeroWidth));        /* 0x093C*/
    rows.push_back(WidthRange(first: 2369, last: 2376, width: WidthClass::ZeroWidth));        /* 0x0941 .. 0x0948*/
    rows.push_back(WidthRange(first: 2381, last: 2381, width: WidthClass::ZeroWidth));        /* 0x094D*/
    rows.push_back(WidthRange(first: 3633, last: 3633, width: WidthClass::ZeroWidth));        /* 0x0E31*/
    rows.push_back(WidthRange(first: 3636, last: 3642, width: WidthClass::ZeroWidth));        /* 0x0E34 .. 0x0E3A*/
    rows.push_back(WidthRange(first: 3655, last: 3662, width: WidthClass::ZeroWidth));        /* 0x0E47 .. 0x0E4E*/
    rows.push_back(WidthRange(first: 8203, last: 8207, width: WidthClass::ZeroWidth));        /* 0x200B .. 0x200F*/
    rows.push_back(WidthRange(first: 8234, last: 8238, width: WidthClass::ZeroWidth));        /* 0x202A .. 0x202E*/
    rows.push_back(WidthRange(first: 8288, last: 8303, width: WidthClass::ZeroWidth));        /* 0x2060 .. 0x206F*/
    rows.push_back(WidthRange(first: 8400, last: 8432, width: WidthClass::ZeroWidth));        /* 0x20D0 .. 0x20F0*/
    rows.push_back(WidthRange(first: 65024, last: 65039, width: WidthClass::ZeroWidth));      /* 0xFE00 .. 0xFE0F*/
    rows.push_back(WidthRange(first: 65056, last: 65071, width: WidthClass::ZeroWidth));      /* 0xFE20 .. 0xFE2F*/
    rows.push_back(WidthRange(first: 65279, last: 65279, width: WidthClass::ZeroWidth));      /* 0xFEFF*/
    rows.push_back(WidthRange(first: 917504, last: 921599, width: WidthClass::ZeroWidth));    /* 0xE0000 .. 0xE0FFF*/

    /* Ambiguous: one column in a Western font, two in an East Asian one.*/
    rows.push_back(WidthRange(first: 161, last: 161, width: WidthClass::Ambiguous));          /* 0x00A1*/
    rows.push_back(WidthRange(first: 164, last: 164, width: WidthClass::Ambiguous));          /* 0x00A4*/
    rows.push_back(WidthRange(first: 167, last: 168, width: WidthClass::Ambiguous));          /* 0x00A7 .. 0x00A8*/
    rows.push_back(WidthRange(first: 170, last: 170, width: WidthClass::Ambiguous));          /* 0x00AA*/
    rows.push_back(WidthRange(first: 174, last: 174, width: WidthClass::Ambiguous));          /* 0x00AE*/
    rows.push_back(WidthRange(first: 176, last: 180, width: WidthClass::Ambiguous));          /* 0x00B0 .. 0x00B4*/
    rows.push_back(WidthRange(first: 182, last: 186, width: WidthClass::Ambiguous));          /* 0x00B6 .. 0x00BA*/
    rows.push_back(WidthRange(first: 188, last: 191, width: WidthClass::Ambiguous));          /* 0x00BC .. 0x00BF*/
    rows.push_back(WidthRange(first: 198, last: 198, width: WidthClass::Ambiguous));          /* 0x00C6*/
    rows.push_back(WidthRange(first: 208, last: 208, width: WidthClass::Ambiguous));          /* 0x00D0*/
    rows.push_back(WidthRange(first: 215, last: 216, width: WidthClass::Ambiguous));          /* 0x00D7 .. 0x00D8*/
    rows.push_back(WidthRange(first: 222, last: 225, width: WidthClass::Ambiguous));          /* 0x00DE .. 0x00E1*/
    rows.push_back(WidthRange(first: 230, last: 230, width: WidthClass::Ambiguous));          /* 0x00E6*/
    rows.push_back(WidthRange(first: 232, last: 234, width: WidthClass::Ambiguous));          /* 0x00E8 .. 0x00EA*/
    rows.push_back(WidthRange(first: 236, last: 237, width: WidthClass::Ambiguous));          /* 0x00EC .. 0x00ED*/
    rows.push_back(WidthRange(first: 240, last: 240, width: WidthClass::Ambiguous));          /* 0x00F0*/
    rows.push_back(WidthRange(first: 242, last: 243, width: WidthClass::Ambiguous));          /* 0x00F2 .. 0x00F3*/
    rows.push_back(WidthRange(first: 247, last: 250, width: WidthClass::Ambiguous));          /* 0x00F7 .. 0x00FA*/
    rows.push_back(WidthRange(first: 252, last: 252, width: WidthClass::Ambiguous));          /* 0x00FC*/
    rows.push_back(WidthRange(first: 254, last: 254, width: WidthClass::Ambiguous));          /* 0x00FE*/
    rows.push_back(WidthRange(first: 8208, last: 8208, width: WidthClass::Ambiguous));        /* 0x2010*/
    rows.push_back(WidthRange(first: 8211, last: 8214, width: WidthClass::Ambiguous));        /* 0x2013 .. 0x2016*/
    rows.push_back(WidthRange(first: 8216, last: 8217, width: WidthClass::Ambiguous));        /* 0x2018 .. 0x2019*/
    rows.push_back(WidthRange(first: 8220, last: 8221, width: WidthClass::Ambiguous));        /* 0x201C .. 0x201D*/
    rows.push_back(WidthRange(first: 8224, last: 8226, width: WidthClass::Ambiguous));        /* 0x2020 .. 0x2022*/
    rows.push_back(WidthRange(first: 8230, last: 8230, width: WidthClass::Ambiguous));        /* 0x2026*/
    rows.push_back(WidthRange(first: 8240, last: 8240, width: WidthClass::Ambiguous));        /* 0x2030*/
    rows.push_back(WidthRange(first: 8592, last: 8601, width: WidthClass::Ambiguous));        /* 0x2190 .. 0x2199*/
    rows.push_back(WidthRange(first: 9312, last: 9449, width: WidthClass::Ambiguous));        /* 0x2460 .. 0x24E9*/
    rows.push_back(WidthRange(first: 9472, last: 9727, width: WidthClass::Ambiguous));        /* 0x2500 .. 0x25FF*/
    rows.push_back(WidthRange(first: 9757, last: 9757, width: WidthClass::Ambiguous));        /* 0x261D*/
    rows.push_back(WidthRange(first: 57344, last: 63743, width: WidthClass::Ambiguous));      /* private use*/

    /* Wide: the East Asian blocks proper.*/
    rows.push_back(WidthRange(first: 4352, last: 4447, width: WidthClass::Wide));             /* 0x1100 .. 0x115F jamo*/
    rows.push_back(WidthRange(first: 8986, last: 8987, width: WidthClass::Wide));             /* 0x231A .. 0x231B watch*/
    rows.push_back(WidthRange(first: 9193, last: 9196, width: WidthClass::Wide));             /* 0x23E9 .. 0x23EC*/
    rows.push_back(WidthRange(first: 9725, last: 9726, width: WidthClass::Wide));             /* 0x25FD .. 0x25FE*/
    rows.push_back(WidthRange(first: 9800, last: 9811, width: WidthClass::Wide));             /* 0x2648 .. 0x2653 zodiac*/
    rows.push_back(WidthRange(first: 11904, last: 12019, width: WidthClass::Wide));           /* 0x2E80 .. 0x2EF3 radicals*/
    rows.push_back(WidthRange(first: 12032, last: 12245, width: WidthClass::Wide));           /* 0x2F00 .. 0x2FD5 kangxi*/
    rows.push_back(WidthRange(first: 12272, last: 12287, width: WidthClass::Wide));           /* 0x2FF0 .. 0x2FFF ideographic*/
    rows.push_back(WidthRange(first: 12288, last: 12351, width: WidthClass::FullWidth));      /* 0x3000 .. 0x303F cjk punctuation*/
    rows.push_back(WidthRange(first: 12352, last: 12447, width: WidthClass::Wide));           /* 0x3040 .. 0x309F hiragana*/
    rows.push_back(WidthRange(first: 12448, last: 12543, width: WidthClass::Wide));           /* 0x30A0 .. 0x30FF katakana*/
    rows.push_back(WidthRange(first: 12544, last: 12591, width: WidthClass::Wide));           /* 0x3100 .. 0x312F bopomofo*/
    rows.push_back(WidthRange(first: 12592, last: 12687, width: WidthClass::Wide));           /* 0x3130 .. 0x318F hangul compat*/
    rows.push_back(WidthRange(first: 12688, last: 12771, width: WidthClass::Wide));           /* 0x3190 .. 0x31A3*/
    rows.push_back(WidthRange(first: 12800, last: 13054, width: WidthClass::Wide));           /* 0x3200 .. 0x32FE enclosed*/
    rows.push_back(WidthRange(first: 13056, last: 19903, width: WidthClass::Wide));           /* 0x3300 .. 0x4DBF*/
    rows.push_back(WidthRange(first: 19968, last: 40959, width: WidthClass::Wide));           /* 0x4E00 .. 0x9FFF unified*/
    rows.push_back(WidthRange(first: 40960, last: 42127, width: WidthClass::Wide));           /* 0xA000 .. 0xA4CF yi*/
    rows.push_back(WidthRange(first: 44032, last: 55203, width: WidthClass::Wide));           /* 0xAC00 .. 0xD7A3 hangul*/
    rows.push_back(WidthRange(first: 63744, last: 64255, width: WidthClass::Wide));           /* 0xF900 .. 0xFAFF compat*/
    rows.push_back(WidthRange(first: 65040, last: 65049, width: WidthClass::Wide));           /* 0xFE10 .. 0xFE19 vertical*/
    rows.push_back(WidthRange(first: 65072, last: 65131, width: WidthClass::Wide));           /* 0xFE30 .. 0xFE6B*/
    rows.push_back(WidthRange(first: 65281, last: 65376, width: WidthClass::FullWidth));      /* 0xFF01 .. 0xFF60*/
    rows.push_back(WidthRange(first: 65377, last: 65439, width: WidthClass::HalfWidth));      /* 0xFF61 .. 0xFF9F halfwidth kana*/
    rows.push_back(WidthRange(first: 65504, last: 65510, width: WidthClass::FullWidth));      /* 0xFFE0 .. 0xFFE6*/
    rows.push_back(WidthRange(first: 94176, last: 94180, width: WidthClass::Wide));           /* 0x16FE0 .. 0x16FE4*/
    rows.push_back(WidthRange(first: 119552, last: 119638, width: WidthClass::Wide));         /* 0x1D300 .. 0x1D356*/
    rows.push_back(WidthRange(first: 126980, last: 126980, width: WidthClass::Wide));         /* 0x1F004 mahjong*/
    rows.push_back(WidthRange(first: 127183, last: 127183, width: WidthClass::Wide));         /* 0x1F0CF*/
    rows.push_back(WidthRange(first: 127374, last: 127374, width: WidthClass::Wide));         /* 0x1F18E*/
    rows.push_back(WidthRange(first: 127462, last: 127487, width: WidthClass::Wide));         /* 0x1F1E6 regional*/
    rows.push_back(WidthRange(first: 127744, last: 128591, width: WidthClass::Wide));         /* 0x1F300 .. 0x1F64F emoji*/
    rows.push_back(WidthRange(first: 128640, last: 128767, width: WidthClass::Wide));         /* 0x1F680 .. 0x1F6FF transport*/
    rows.push_back(WidthRange(first: 129280, last: 129535, width: WidthClass::Wide));         /* 0x1F980 .. 0x1FA7F*/
    rows.push_back(WidthRange(first: 131072, last: 196605, width: WidthClass::Wide));         /* 0x20000 .. 0x2FFFD*/
    rows.push_back(WidthRange(first: 196608, last: 262141, width: WidthClass::Wide));         /* 0x30000 .. 0x3FFFD*/

    return rows;
}

fn find_width_class(rows: &const shared vector{WidthRange}, scalar: int) -> WidthClass: {
    var low: int = 0;
    var high = rows.size() - 1;
    while low <= high: {
        let middle = low + ((high - low) >> 1);
        let row: &const = rows.at(middle);
        if scalar < row.first: {
            high = middle - 1;
        } else: {
            if scalar > row.last: {
                low = middle + 1;
            } else: {
                return row.width;
            }
        }
    }
    return WidthClass::Neutral;
}

/* The caller decides how the ambiguous class renders; a terminal running in a*/
/* CJK locale wants two columns, everything else wants one.*/
struct WidthOptions: {
    ambiguous_is_wide: bool = false;
    control_is_escape: bool = true;
    tab_stop: int = 8;
    count_emoji_sequence_once: bool = true;
}

fn scalar_width(props: &const shared Properties, scalar: int, options: &const shared WidthOptions) -> int: {
    if scalar == 0: {
        return 0;
    }
    if scalar == 9: {
        return options.tab_stop;
    }
    if props.is_control(scalar): {
        if options.control_is_escape: {
            return WIDTH_CONTROL_ESCAPE;
        }
        return 0;
    }
    if scalar <= MAX_ASCII: {
        return WIDTH_NARROW;
    }
    let width = find_width_class(props.widths, scalar);
    if width == WidthClass::ZeroWidth: {
        return WIDTH_ZERO;
    }
    if width == WidthClass::Wide || width == WidthClass::FullWidth: {
        return WIDTH_WIDE;
    }
    if width == WidthClass::Ambiguous: {
        if options.ambiguous_is_wide: {
            return WIDTH_WIDE;
        }
        return WIDTH_NARROW;
    }
    if props.is_mark(scalar): {
        return WIDTH_ZERO;
    }
    if props.is_format(scalar): {
        return WIDTH_ZERO;
    }
    return WIDTH_NARROW;
}

/* A whole cluster occupies the width of its widest member, not the sum: a base*/
/* letter plus three accents is still one column.*/
fn cluster_width(props: &const shared Properties, scalars: &const shared vector{int}, step: &const shared Step, options: &const shared WidthOptions) -> int: {
    var widest: int = 0;
    for i in range(step.begin, step.end): {
        let width = scalar_width(props, scalars.at(i), options);
        if width > widest: {
            widest = width;
        }
    }
    return widest;
}

fn text_width(props: &const shared Properties, scalars: &const shared vector{int}, options: &const shared WidthOptions) -> int: {
    var total: int = 0;
    let clusters = grapheme_steps(props, scalars);
    for step: &const in clusters: {
        total += cluster_width(props, scalars, step, options);
    }
    return total;
}

/* Truncate to a column budget, cutting only at cluster boundaries so that no*/
/* accent is ever separated from its base.*/
fn truncate_to_width(props: &const shared Properties, scalars: &const shared vector{int}, budget: int, options: &const shared WidthOptions) -> vector{int}: {
    var out: vector{int};
    var used: int = 0;
    let clusters = grapheme_steps(props, scalars);
    for step: &const in clusters: {
        let width = cluster_width(props, scalars, step, options);
        if used + width > budget: {
            return out;
        }
        for i in range(step.begin, step.end): {
            out.push_back(scalars.at(i));
        }
        used += width;
    }
    return out;
}

/* Pad on the right to a fixed column count, which is what a table formatter*/
/* needs once the strings stop being ASCII.*/
fn pad_to_width(props: &const shared Properties, scalars: &const shared vector{int}, target: int, options: &const shared WidthOptions) -> vector{int}: {
    var out = utf32_encode(scalars);
    var used = text_width(props, scalars, options);
    while used < target: {
        out.push_back(32);                     /* space*/
        used += 1;
    }
    return out;
}

fn width_class_name(width: WidthClass) -> string: {
    if width == WidthClass::Narrow: { return "Na"; }
    if width == WidthClass::Wide: { return "W"; }
    if width == WidthClass::FullWidth: { return "F"; }
    if width == WidthClass::HalfWidth: { return "H"; }
    if width == WidthClass::Ambiguous: { return "A"; }
    if width == WidthClass::ZeroWidth: { return "Z"; }
    return "N";
}

/* --- Iteration helpers ---------------------------------------------------*/
/**/
/* Three cursors over the same byte buffer, at three levels of granularity.*/
/* Each one is a plain struct with a next() that returns false at the end,*/
/* because that is the shape the rest of the codebase expects of an iterator.*/

/* A cursor over the code points of a UTF-8 byte buffer.*/
struct CodePointIterator: {

    fn reset(self: &unique): {
        .offset = 0;
        .current = 0;
        .current_length = 0;
        .error = DecodeError::None;
        .position = Position();
    }

    fn done(self: &const shared) -> bool: {
        return .offset >= .bytes.size();
    }

    fn next(self: &unique) -> bool: {
        if .offset >= .bytes.size(): {
            .current = 0;
            .current_length = 0;
            return false;
        }
        let step = decode_at(.bytes, .offset);
        .error = step.error;
        if step.error == DecodeError::None: {
            .current = step.value;
            .current_length = step.length;
        } else: {
            .current = REPLACEMENT;
            .current_length = 1;
            if step.length > 0: {
                .current_length = step.length;
            }
        }
        .position.advance_scalar(.current, .current_length);
        .offset += .current_length;
        return true;
    }

    /* Look at the next scalar without consuming it.*/
    fn peek(self: &const shared) -> int: {
        if .offset >= .bytes.size(): {
            return -1;
        }
        let step = decode_at(.bytes, .offset);
        if step.error != DecodeError::None: {
            return REPLACEMENT;
        }
        return step.value;
    }

    /* Step back over the previous scalar. Uses the continuation byte test*/
    /* rather than remembering the last length, so it works after a seek.*/
    fn previous(self: &unique) -> bool: {
        if .offset <= 0: {
            return false;
        }
        var index = .offset - 1;
        var steps: int = 0;
        while index > 0 && steps < UTF8_MAX_LENGTH: {
            if (.bytes.at(index) & CONT_MASK) != CONT_MARK: {
                .offset = index;
                let step = decode_at(.bytes, index);
                .current = step.value;
                .current_length = step.length;
                return true;
            }
            index -= 1;
            steps += 1;
        }
        .offset = 0;
        return true;
    }

    fn seek(self: &unique, byte_offset: int): {
        .offset = sequence_start(.bytes, byte_offset);
    }

    fn collect(self: &unique) -> vector{int}: {
        var out: vector{int};
        while .next(): {
            out.push_back(.current);
        }
        return out;
    }

    bytes: vector{int};
    offset: int = 0;
    current: int = 0;
    current_length: int = 0;
    error: DecodeError = DecodeError::None;
    position: Position;
}

/* A cursor over grapheme clusters, built on top of a decoded scalar run*/
/* because the break rules need lookahead that a byte cursor cannot give.*/
struct GraphemeIterator: {

    fn reset(self: &unique): {
        .offset = 0;
        .begin = 0;
        .end = 0;
        .state.reset();
    }

    fn done(self: &const shared) -> bool: {
        return .offset >= .scalars.size();
    }

    fn next(self: &unique, props: &const shared Properties) -> bool: {
        if .offset >= .scalars.size(): {
            .begin = .offset;
            .end = .offset;
            return false;
        }
        .begin = .offset;
        var index = .offset + 1;
        while index < .scalars.size(): {
            if breaks_between(props, .state, .scalars.at(index - 1), .scalars.at(index)): {
                .end = index;
                .offset = index;
                return true;
            }
            index += 1;
        }
        .end = .scalars.size();
        .offset = .end;
        return true;
    }

    fn current(self: &const shared) -> vector{int}: {
        var out: vector{int};
        for i in range(.begin, .end): {
            out.push_back(.scalars.at(i));
        }
        return out;
    }

    fn current_length(self: &const shared) -> int: {
        return .end - .begin;
    }

    /* The base character of the current cluster, that is the first scalar that*/
    /* is not a mark.*/
    fn base(self: &const shared, props: &const shared Properties) -> int: {
        for i in range(.begin, .end): {
            let scalar = .scalars.at(i);
            if props.is_mark(scalar) == false: {
                return scalar;
            }
        }
        if .end > .begin: {
            return .scalars.at(.begin);
        }
        return 0;
    }

    scalars: vector{int};
    offset: int = 0;
    begin: int = 0;
    end: int = 0;
    state: BreakState;
}

/* A cursor over words, which skips the runs that hold no letters or digits.*/
struct WordIterator: {

    fn reset(self: &unique): {
        .offset = 0;
        .begin = 0;
        .end = 0;
    }

    fn next(self: &unique, props: &const shared Properties) -> bool: {
        while .offset < .scalars.size(): {
            .begin = .offset;
            var index = .offset + 1;
            var found: bool = false;
            while index < .scalars.size(): {
                let before2 = peek_scalar(.scalars, index - 2);
                let before = peek_scalar(.scalars, index - 1);
                let after = peek_scalar(.scalars, index);
                let after2 = peek_scalar(.scalars, index + 1);
                if word_breaks_between(props, before2, before, after, after2): {
                    .end = index;
                    found = true;
                    index = .scalars.size();
                } else: {
                    index += 1;
                }
            }
            if found == false: {
                .end = .scalars.size();
            }
            .offset = .end;

            var interesting: bool = false;
            for i in range(.begin, .end): {
                let scalar = .scalars.at(i);
                if props.is_letter(scalar) || props.is_number(scalar): {
                    interesting = true;
                }
            }
            if interesting: {
                return true;
            }
        }
        return false;
    }

    fn current(self: &const shared) -> vector{int}: {
        var out: vector{int};
        for i in range(.begin, .end): {
            out.push_back(.scalars.at(i));
        }
        return out;
    }

    scalars: vector{int};
    offset: int = 0;
    begin: int = 0;
    end: int = 0;
}

/* --- Text buffer ---------------------------------------------------------*/
/**/
/* The convenience layer: a byte buffer that knows its own encoding and can*/
/* hand out any of the three iterators.*/
struct Text: {

    fn load(self: &unique, bytes: vector{int}): {
        .bytes = move(bytes);
        .encoding = strip_bom(.bytes);
        .valid = is_valid_utf8(.bytes);
    }

    fn byte_length(self: &const shared) -> int: {
        return .bytes.size();
    }

    fn scalar_length(self: &const shared) -> int: {
        return count_scalars(.bytes);
    }

    fn scalars(self: &const shared) -> vector{int}: {
        return decode_all_lossy(.bytes);
    }

    fn cluster_length(self: &const shared, props: &const shared Properties) -> int: {
        let run = .scalars();
        return count_graphemes(props, run);
    }

    fn width(self: &const shared, props: &const shared Properties) -> int: {
        let run = .scalars();
        var options: WidthOptions;
        return text_width(props, run, options);
    }

    fn code_points(self: &const shared) -> CodePointIterator: {
        var iterator: CodePointIterator;
        iterator.bytes = utf32_encode(.bytes);
        iterator.reset();
        return iterator;
    }

    fn clusters(self: &const shared) -> GraphemeIterator: {
        var iterator: GraphemeIterator;
        iterator.scalars = .scalars();
        iterator.reset();
        return iterator;
    }

    fn words(self: &const shared) -> WordIterator: {
        var iterator: WordIterator;
        iterator.scalars = .scalars();
        iterator.reset();
        return iterator;
    }

    fn append_scalar(self: &unique, scalar: int): {
        discard encode_into(.bytes, scalar);
    }

    fn append_text(self: &unique, other: &const shared Text): {
        for b: &const in other.bytes: {
            .bytes.push_back(b);
        }
    }

    fn clear(self: &unique): {
        .bytes.clear();
        .encoding = Encoding::Utf8;
        .valid = true;
    }

    bytes: vector{int};
    encoding: Encoding = Encoding::Utf8;
    valid: bool = true;
}

/* --- Escaping ------------------------------------------------------------*/

/* Render a scalar the way a source file would spell it, so that a diagnostic*/
/* can quote unprintable text safely.*/
fn escape_scalar(props: &const shared Properties, scalar: int) -> string: {
    if scalar == 10: {
        return "\\n";
    }
    if scalar == 13: {
        return "\\r";
    }
    if scalar == 9: {
        return "\\t";
    }
    if scalar == 0: {
        return "\\0";
    }
    if scalar == 92: {
        return "\\\\";
    }
    if scalar == 34: {
        return "\\\"";
    }
    if props.is_printable(scalar): {
        var out: string = "";
        out.push_back(char(scalar));
        return out;
    }
    var out: string = "\\u{";
    out.append(format_code_point(scalar));
    out.append("}");
    return out;
}

fn escape_text(props: &const shared Properties, scalars: &const shared vector{int}) -> string: {
    var out: string = "";
    for scalar: &const in scalars: {
        out.append(escape_scalar(props, scalar));
    }
    return out;
}

/* Describe one scalar for a diagnostic: the code point, its category and its*/
/* width class. This is the function a debugger calls on a selection.*/
fn describe_scalar(props: &const shared Properties, scalar: int) -> string: {
    var out = format_code_point(scalar);
    out.append(" category ");
    out.append(category_name(props.category_of(scalar)));
    out.append(" width ");
    out.append(width_class_name(find_width_class(props.widths, scalar)));
    out.append(" combining ");
    out.append(to_string(props.combining_of(scalar)));
    let length = encoded_length(scalar);
    out.append(" utf8 bytes ");
    out.append(to_string(length));
    if is_noncharacter(scalar): {
        out.append(" (noncharacter)");
    }
    if is_surrogate(scalar): {
        out.append(" (surrogate)");
    }
    return out;
}

fn error_text(code: DecodeError) -> string: {
    if code == DecodeError::None: {
        return "no error";
    }
    if code == DecodeError::TruncatedSequence: {
        return "input ended in the middle of a UTF-8 sequence";
    }
    if code == DecodeError::UnexpectedContinuation: {
        return "continuation byte where a lead byte was expected";
    }
    if code == DecodeError::InvalidLeadByte: {
        return "byte cannot begin a UTF-8 sequence";
    }
    if code == DecodeError::MissingContinuation: {
        return "lead byte was not followed by a continuation byte";
    }
    if code == DecodeError::OverlongEncoding: {
        return "code point encoded with more bytes than necessary";
    }
    if code == DecodeError::SurrogateCodePoint: {
        return "surrogate code point encoded directly";
    }
    if code == DecodeError::CodePointTooLarge: {
        return "code point above the Unicode maximum";
    }
    if code == DecodeError::UnpairedHighSurrogate: {
        return "high surrogate without a following low surrogate";
    }
    if code == DecodeError::UnpairedLowSurrogate: {
        return "low surrogate without a preceding high surrogate";
    }
    if code == DecodeError::BufferTooSmall: {
        return "output buffer is too small";
    }
    return "input was empty";
}

/* --- Round trip checks ---------------------------------------------------*/
/**/
/* The properties the test suite proves. They are written as functions rather*/
/* than as tests so that the prover can see the same statements the tests do.*/

fn check_round_trip(scalar: int) -> bool: {
    if is_valid_scalar(scalar) == false: {
        return true;
    }
    let packet = encode(scalar);
    if packet.length != encoded_length(scalar): {
        return false;
    }
    var buffer: vector{int};
    for i in range(0, packet.length): {
        buffer.push_back(packet.at(i));
    }
    let back = decode_at(buffer, 0);
    prove back.length == packet.length;
    return back.value == scalar && back.error == DecodeError::None;
}

fn check_utf16_round_trip(scalar: int) -> bool: {
    if is_valid_scalar(scalar) == false: {
        return true;
    }
    var units: vector{int};
    let count = utf16_encode_into(units, scalar);
    if count != utf16_length(scalar): {
        return false;
    }
    let back = utf16_decode_at(units, 0);
    return back.value == scalar && back.error == DecodeError::None;
}

/* Overlong forms must be rejected. The classic attack spells a slash as two*/
/* bytes, 0xC0 0xAF, and hopes the path check runs before the decoder does.*/
fn check_overlong_rejected() -> bool: {
    var buffer: vector{int};
    buffer.push_back(192);                     /* 0xC0*/
    buffer.push_back(175);                     /* 0xAF*/
    let step = decode_at(buffer, 0);
    if step.error == DecodeError::None: {
        return false;
    }
    return step.error == DecodeError::InvalidLeadByte || step.error == DecodeError::OverlongEncoding;
}

fn check_surrogate_rejected() -> bool: {
    var buffer: vector{int};
    buffer.push_back(237);                     /* 0xED*/
    buffer.push_back(160);                     /* 0xA0*/
    buffer.push_back(128);                     /* 0x80*/
    let step = decode_at(buffer, 0);
    return step.error == DecodeError::SurrogateCodePoint;
}

fn check_truncation_reported() -> bool: {
    var buffer: vector{int};
    buffer.push_back(240);                     /* 0xF0*/
    buffer.push_back(159);                     /* 0x9F*/
    buffer.push_back(152);                     /* 0x98*/
    let step = decode_at(buffer, 0);
    return step.error == DecodeError::TruncatedSequence;
}

fn check_too_large_rejected() -> bool: {
    var buffer: vector{int};
    buffer.push_back(244);                     /* 0xF4*/
    buffer.push_back(144);                     /* 0x90*/
    buffer.push_back(128);                     /* 0x80*/
    buffer.push_back(128);                     /* 0x80*/
    let step = decode_at(buffer, 0);
    if step.error == DecodeError::None: {
        return false;
    }
    return step.error == DecodeError::CodePointTooLarge || step.error == DecodeError::MissingContinuation;
}

/* Walk a sample of the code space and confirm the two decoders agree.*/
fn check_decoders_agree(first: int, last: int) -> bool: {
    var scalar = first;
    while scalar <= last: {
        if is_valid_scalar(scalar): {
            let packet = encode(scalar);
            var buffer: vector{int};
            for i in range(0, packet.length): {
                buffer.push_back(packet.at(i));
            }
            let reference = decode_all_lossy(buffer);
            let streamed = decode_streaming(buffer);
            if reference.size() != streamed.size(): {
                return false;
            }
            for i in range(0, reference.size()): {
                if reference.at(i) != streamed.at(i): {
                    return false;
                }
            }
        }
        scalar += 1;
    }
    return true;
}

fn self_test() -> int: {
    var failures: int = 0;
    var props: Properties;
    props.build();

    if check_overlong_rejected() == false: {
        failures += 1;
        println("overlong sequence was accepted");
    }
    if check_surrogate_rejected() == false: {
        failures += 1;
        println("surrogate sequence was accepted");
    }
    if check_truncation_reported() == false: {
        failures += 1;
        println("truncated sequence was not reported");
    }
    if check_too_large_rejected() == false: {
        failures += 1;
        println("out of range code point was accepted");
    }
    if check_decoders_agree(0, 2047) == false: {
        failures += 1;
        println("streaming decoder disagrees with the reference decoder");
    }

    for scalar in range(0, 1024): {
        if check_round_trip(scalar) == false: {
            failures += 1;
        }
        if check_utf16_round_trip(scalar) == false: {
            failures += 1;
        }
    }

    /* A short smoke test over the property tables.*/
    if props.is_letter(int('a')) == false: {
        failures += 1;
    }
    if props.is_digit(int('7')) == false: {
        failures += 1;
    }
    if props.is_whitespace(int(' ')) == false: {
        failures += 1;
    }
    if props.is_punctuation(int('.')) == false: {
        failures += 1;
    }
    if props.is_control(int('\n')) == false: {
        failures += 1;
    }
    if props.is_combining(769) == false: {     /* 0x0301 combining acute*/
        failures += 1;
    }
    if to_upper_scalar(props, int('a')) != int('A'): {
        failures += 1;
    }
    if to_lower_scalar(props, int('Z')) != int('z'): {
        failures += 1;
    }

    /* e with an acute accent must compose and decompose cleanly.*/
    var composed: vector{int};
    composed.push_back(233);                   /* 0x00E9*/
    let expanded = decompose(props, composed, false);
    if expanded.size() != 2: {
        failures += 1;
    }
    let recomposed = compose(props, expanded);
    if recomposed.size() != 1: {
        failures += 1;
    }

    println("unicode self test finished with ");
    println(to_string(failures));
    return failures;
}

}

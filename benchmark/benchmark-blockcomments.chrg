    set_pst_rank(PST_MG.at(5), 5, -9, 24, 2, -16, -20, 6, 22, -22);
    set_pst_rank(PST_MG.at(5), 6, 29, -1, -20, -7, -8, -4, -38, -29);
    set_pst_rank(PST_MG.at(5), 7, -65, 23, 16, -15, -56, -34, 2, 13);
}


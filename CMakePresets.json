{
  "version": 3,
  "configurePresets": [
    {
      "name": "variables-gnu",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O2 -g -DNDEBUG",
        "CMAKE_C_FLAGS_RELWITHDEBINFO": "-O2 -g -DNDEBUG",
        "CHARGE_GNU_X86_VERSION": "v2"
      }
    },
    {
      "name": "variables-msvc",
      "hidden": true,
      "binaryDir": "${sourceDir}/build",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": {
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "/O2 /Ob2 /Z7 /DNDEBUG",
        "CMAKE_C_FLAGS_RELWITHDEBINFO": "/O2 /Ob2 /Z7 /DNDEBUG",
        "CHARGE_GNU_X86_VERSION": "v2"
      }
    },
    {
      "name": "clang",
      "displayName": "Build with the default Clang version in your environment",
      "inherits": ["variables-gnu"],
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "gcc",
      "displayName": "Build with the default GCC version in your environment",
      "inherits": ["variables-gnu"],
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "default",
      "displayName": "Let CMake select the compiler or provide your own",
      "inherits": ["variables-gnu"]
    },
    {
      "name": "clang-cl",
      "displayName": "Build with clang-cl, must be configured in a VS Developer Command Prompt",
      "inherits": ["variables-msvc"],
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl",
        "CMAKE_LINKER": "lld-link"
      }
    },
    {
      "name": "vs2026-clang-cl",
      "displayName": "Generate a Visual Studio 2026 project. ONLY USE IF YOU NEED A .sln FILE!",
      "inherits": ["variables-msvc"],
      "generator": "Visual Studio 18 2026",
      "toolset": "ClangCL",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "RelWithDebInfo"
      }
    }
  ]
}

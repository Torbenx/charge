// parser-test

// expect-expected-parameter-name
test1: (+a: type) { }

// expect-parameter-modifier-not-allowed
template(let T: type)
test2: () { }

// expect-invalid-parameter-modifier
test3: (invalid a: type) { }

// expect-unexpected-after-parameter
test4: (a ;) { }

// expect-expected-semicolon
test5: () => a

test6: () {
    /> expect-expected-semicolon </ a
    /> expect-expected-semicolon </ return a
    /> expect-expected-semicolon </ let a = b
    /> expect-expected-semicolon </ a += b
}
test7: () {
    /> expect-expected-semicolon </ [a a];
}

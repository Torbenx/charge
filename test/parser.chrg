// parser-test

fn ftest() {

//; primary expressions
/> expect-node IdentifierExpr </ a;
/> expect-node IdentifierExpr; expect-unresolved Parameterize; expect-node EmptyNode </ a<>;
/> expect-node ParenthesizedExpr; expect-node EmptyNode </ ();
/> expect-node CompoundExpr; expect-node IdentifierExpr; expect-node ExpressionStmt; expect-node EmptyNode; expect-node ExpressionStmt </ [a];

//; postfix expressions
/> expect-node IdentifierExpr; expect-node MemberAccessExpr </ a.b;
/> expect-node IdentifierExpr; expect-node StaticAccessExpr </ a::b;
/> expect-node IdentifierExpr; expect-node MemberAccessExpr; expect-unresolved Parameterize; expect-node EmptyNode </ a.b<>;
/> expect-node IdentifierExpr; expect-node StaticAccessExpr; expect-unresolved Parameterize; expect-node EmptyNode </ a::b<>;
/> expect-node IdentifierExpr; expect-node CallExpr; expect-node EmptyNode </ a();
/> expect-node IdentifierExpr; expect-node IndexExpr; expect-node EmptyNode </ a[];
/> expect-node IdentifierExpr; expect-node PostIncrementExpr </ a++;
/> expect-node IdentifierExpr; expect-node PostDecrementExpr </ a--;

//; unary expressions
/> expect-node IdentifierExpr; expect-node ConstraintExpr </ ?a;
/> expect-node IdentifierExpr; expect-node LogicalNotExpr </ !a;
/> expect-node IdentifierExpr; expect-node BitwiseNotExpr </ ~a;
/> expect-node IdentifierExpr; expect-node PreIncrementExpr </ ++a;
/> expect-node IdentifierExpr; expect-node PreDecrementExpr </ --a;
/> expect-node IdentifierExpr; expect-node PlusExpr </ +a;
/> expect-node IdentifierExpr; expect-node NegateExpr </ -a;
/> expect-node IdentifierExpr; expect-node DereferenceExpr </ *a;

//; binary expressions
/> expect-node IdentifierExpr; expect-node AdditionExpr; expect-node IdentifierExpr </ a + b;
/> expect-node IdentifierExpr; expect-node SubtractionExpr; expect-node IdentifierExpr </ a - b;
/> expect-node IdentifierExpr; expect-node MultiplyExpr; expect-node IdentifierExpr </ a * b;
/> expect-node IdentifierExpr; expect-node BitwiseAndExpr; expect-node IdentifierExpr </ a & b;
/> expect-node IdentifierExpr; expect-node BitwiseXorExpr; expect-node IdentifierExpr </ a ^ b;
/> expect-node IdentifierExpr; expect-node BitwiseOrExpr; expect-node IdentifierExpr </ a | b;
/> expect-node IdentifierExpr; expect-node DivideExpr; expect-node IdentifierExpr </ a / b;
/> expect-node IdentifierExpr; expect-node RemainderExpr; expect-node IdentifierExpr </ a % b;
/> expect-node IdentifierExpr; expect-node ShiftLeftExpr; expect-node IdentifierExpr </ a << b;
/> expect-node IdentifierExpr; expect-node ShiftRightExpr; expect-node IdentifierExpr </ a >> b;
/> expect-node IdentifierExpr; expect-node CompareNotEqualExpr; expect-node IdentifierExpr </ a != b;
/> expect-node IdentifierExpr; expect-node CompareEqualExpr; expect-node IdentifierExpr </ a == b;
/> expect-node IdentifierExpr; expect-unresolved CompareLessExpr; expect-node IdentifierExpr </ a < b;
/> expect-node IdentifierExpr; expect-node CompareLessEqualExpr; expect-node IdentifierExpr </ a <= b;
/> expect-node IdentifierExpr; expect-node CompareGreaterExpr; expect-node IdentifierExpr </ a > b;
/> expect-node IdentifierExpr; expect-node CompareGreaterEqualExpr; expect-node IdentifierExpr </ a >= b;
/> expect-node IdentifierExpr; expect-node LogicalAndExpr; expect-node IdentifierExpr </ a && b;
/> expect-node IdentifierExpr; expect-node LogicalOrExpr; expect-node IdentifierExpr </ a || b;

//; conditional expressions
/> expect-node IdentifierExpr; expect-node IfExpr; expect-node IdentifierExpr </ if a => b;
/> expect-node IdentifierExpr; expect-node CommaElseExpr; expect-node IdentifierExpr </ a, else => b;

//; update statements
/> expect-node IdentifierExpr; expect-node AssignStmt; expect-node IdentifierExpr </ a = b;
/> expect-node IdentifierExpr; expect-node AdditionUpdateStmt; expect-node IdentifierExpr </ a += b;
/> expect-node IdentifierExpr; expect-node SubtractionUpdateStmt; expect-node IdentifierExpr </ a -= b;
/> expect-node IdentifierExpr; expect-node MultiplyUpdateStmt; expect-node IdentifierExpr </ a *= b;
/> expect-node IdentifierExpr; expect-node DivideUpdateStmt; expect-node IdentifierExpr </ a /= b;
/> expect-node IdentifierExpr; expect-node RemainderUpdateStmt; expect-node IdentifierExpr </ a %= b;
/> expect-node IdentifierExpr; expect-node BitwiseAndUpdateStmt; expect-node IdentifierExpr </ a &= b;
/> expect-node IdentifierExpr; expect-node BitwiseXorUpdateStmt; expect-node IdentifierExpr </ a ^= b;
/> expect-node IdentifierExpr; expect-node BitwiseOrUpdateStmt; expect-node IdentifierExpr </ a |= b;
/> expect-node IdentifierExpr; expect-node ShiftLeftUpdateStmt; expect-node IdentifierExpr </ a <<= b;
/> expect-node IdentifierExpr; expect-node ShiftRightUpdateStmt; expect-node IdentifierExpr </ a >>= b;
/> expect-node IdentifierExpr; expect-node LogicalAndUpdateStmt; expect-node IdentifierExpr </ a &&= b;
/> expect-node IdentifierExpr; expect-node LogicalOrUpdateStmt; expect-node IdentifierExpr </ a ||= b;

//; other statements
/> expect-node IdentifierExpr; expect-node IfStmt; expect-node IdentifierExpr; expect-node ExpressionStmt </ if a: b;
/> expect-node IdentifierExpr; expect-node IfStmt; expect-node CompoundStmt </ if a { }
/> expect-node IdentifierExpr; expect-node IfStmt; expect-node CompoundStmt; expect-node IdentifierExpr; expect-node ExpressionStmt </ if a { b; }
/> expect-identifier condition; expect-node IfExpr; expect-identifier if_true; expect-node ExpressionStmt </ if condition => if_true;
/> expect-node EmptyReturnStmt </ return;
/> expect-node IdentifierExpr; expect-node ReturnStmt </ return a;
/> expect-node LetStmt; expect-decl BlockLetVariable name=a1 </ let a1;
/> expect-node LetStmt; expect-decl BlockVarVariable name=a2 </ var a2;
/> expect-node LetStmt; expect-identifier type; expect-node EmptyNode; expect-identifier init; expect-node EmptyNode </ let a3: type = init;

//; test precedence
// expect-identifier a; expect-node LogicalOrExpr;
// expect-identifier b; expect-node LogicalAndExpr;
// expect-identifier c; expect-node CompareGreaterEqualExpr; expect-identifier e
// expect-node CompareEqualExpr; expect-identifier d
a || b && c >= e == d;

// expect-identifier a; expect-node AdditionExpr; expect-identifier b; expect-node AdditionExpr; expect-identifier c
a + b + c;

a * b + c >> d > e == f;

//; test arguments
// expect-identifier a
// expect-node CallExpr
// expect-identifier b; expect-node DesignateArgument
// expect-identifier c
// expect-node EmptyNode
a(p = b, c);

//; test trailing comma
// expect-node ParenthesizedExpr; expect-node IdentifierExpr; expect-node IdentifierExpr; expect-node EmptyNode
(a, b,);

//; test comma-else in arguments
// expect-node ParenthesizedExpr;
// expect-node IdentifierExpr; expect-node CommaElseExpr; expect-node IdentifierExpr
// expect-node IdentifierExpr; expect-node EmptyNode
(a, else => b, c);

//; test reemitLastToken with newline and comment tokens in between
//; the cases where reemitLastToken is used are
//;  - to check for 'word =' in an argument list
//;  - to check for ', else'
// expect-node ParenthesizedExpr; expect-node IdentifierExpr; expect-node EmptyNode
(a, /></);
// expect-node ParenthesizedExpr; expect-node IdentifierExpr; expect-node EmptyNode
(a,
);
// expect-node ParenthesizedExpr; expect-node IdentifierExpr; expect-node EmptyNode
(a/></);
// expect-node ParenthesizedExpr; expect-node IdentifierExpr; expect-node EmptyNode
(a
);

//; test source position after reemitLastToken
// expect-node ParenthesizedExpr packed-range-begin-column=1
// expect-node IdentifierExpr    packed-range-begin-column=3
// expect-node EmptyNode         packed-range-begin-column=5
( a );
// expect-node ParenthesizedExpr packed-range-begin-column=1
// expect-node IdentifierExpr    packed-range-begin-column=3
// expect-node EmptyNode         packed-range-begin-column=1
( a //
);

a(foo = -b + z, bar = c);
a<b.c<i, j, k>, c> + d;

} // expect-decl Function

/> expect-decl Function </ fn test1() { }
/> expect-decl LetParameter; expect-decl Function </ fn test2(a) { }

// expect-decl LetParameter name=a
// expect-decl VarParameter name=b
// expect-decl InOutParameter name=c
// expect-decl OutParameter name=d
// expect-decl Function name=test3
fn test3(let a, var b, inout c, out d) { }

// expect-identifier param_type; expect-node EmptyNode
// expect-identifier param_init; expect-node EmptyNode
// expect-decl LetParameter
// expect-identifier return_type; expect-node EmptyNode
// expect-identifier body_expr; expect-node EmptyNode
// expect-decl Function
fn test4(param_name: param_type = param_init) -> return_type => body_expr;

// expect-decl LetParameter name=T
// expect-decl LetParameter name=a
// expect-decl Function name=test5
template(T: type)
fn test5(a: T) { }

// expect-decl Namespace name=Namespace
// expect-decl StructType name=Foo
// expect-decl LetParameter name=a
// expect-decl Function name=foo
// expect-decl ObjectType name=Bar
// expect-decl LetParameter name=b
// expect-decl Function name=bar
// expect-decl StaticLetVariable name=x
namespace Namespace {
    struct Foo {
        fn foo(a) { }
    }
    object Bar {
        fn bar(b) { }
    }
    static x;
}

// expect-identifier type; expect-node EmptyNode
// expect-identifier init; expect-node EmptyNode
// expect-decl StaticLetVariable name=name
static name: type = init;

/> expect-decl StaticLetVariable </ static let a;
/> expect-decl StaticVarVariable </ static var b;

// expect-decl StructType; expect-decl HasMember name=bar
struct Foo2 { has Bar as bar; }
// expect-decl StructType; expect-decl HasMember; expect-decl Function name=test
struct Foo3 { has Bar as bar { fn test() { } } }

// expect-decl LetParameter; expect-decl StructType; expect-decl StaticLetVariable
template(T: type)
struct Foo4 { static x; }


fn testParameterizeVsLess() {
    // expect-node IdentifierExpr; expect-unresolved CompareLessExpr; expect-node IdentifierExpr
    // expect-unresolved Parameterize; expect-node IdentifierExpr; expect-node EmptyNode
    // expect-node AdditionExpr; expect-node IdentifierExpr; expect-node ExpressionStmt
    a < b < c > + d; //; a < b<c> + d

    // expect-node IdentifierExpr; expect-unresolved CompareLessExpr; expect-node IdentifierExpr
    // expect-node CompareLessEqualExpr; expect-node IdentifierExpr
    // expect-node CompareGreaterExpr; expect-node IdentifierExpr; expect-node ExpressionStmt
    a < b <= c > d;

    // expect-node IdentifierExpr; expect-unresolved CompareLessExpr; expect-node IdentifierExpr
    // expect-node LogicalAndExpr; expect-node IdentifierExpr
    // expect-node CompareGreaterExpr; expect-node IdentifierExpr; expect-node ExpressionStmt
    a < b && c > d;
}